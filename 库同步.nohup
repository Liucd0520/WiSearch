{'工单编号': '20250226019679', '工号': '4569', '工单生成时间': datetime.datetime(2025, 2, 26, 13, 53, 31), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其生育2胎，其原本的居住证信息在租赁房，后续改租至农村用房，没有房产证，市民携带租赁合同至社保中心咨询，被告知该房屋不能做租赁登记。诉求：希望管理部门协助告知该如何为2胎办理居住证。', '工单类别': '一般', '处理描述': '梅陇镇社区事务受理服务中心于2025年2月27日接单，于2月27日16时30分进行先行联系诉求人，于2025年3月5日10时10分进行核实并现场处置，经查询，诉求人房主不能提供房产证，不能办理租赁备案。诉求人如需办理居住证，可带好未成年人户口本出生证与监护人的租赁合同到窗口办理。已经将处置结果告知诉求人，该问题已经实际解决。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证办理', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1740548681-2635392', '工单类型': '咨询类', '新一级分类': '公共安全类', '新二级分类': '公安事务', '新三级分类': '人口管理', '新四级分类': '居住证管理', '新五级分类': '居住登记', '诉求地址_省份': None}
