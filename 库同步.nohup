{'工单编号': '20250419003506', '工号': '2861', '工单生成时间': datetime.datetime(2025, 4, 19, 9, 19, 21), '诉求地址': '浦东新区中铁世博云', '诉求区域': '浦东新区', '内容描述': '市民反映：上述地址中铁世博云境工地每日6:00之前施工，噪音扰民（详见附件）。诉求：请管理部门核实制止扰民行为。', '工单类别': '一般', '处理描述': '接报后，上钢街道五违办于当日先行联系，并立即到现场进行查处。经查，投诉人反映世博云境工地施工噪音扰民的事项。处置人员至现场查看并约谈了施工负责人，其表示会严格遵守文明施工各项规定开展工作，优化工作流程，尽量减少对周边居民的影响。经了解，上钢新村街道已牵头召开施工方与居民的沟通协调会，后续还会继续跟进协调。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '夜间施工许可', '新四级分类': '夜间施工行为', '新五级分类': '夜间施工投诉', '诉求地址_省份': None}
