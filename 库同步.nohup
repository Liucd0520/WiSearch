{'工单编号': '20250425032048', '工号': '4018', '工单生成时间': datetime.datetime(2025, 4, 25, 16, 39, 2), '诉求地址': '青浦区徐民东路（维景酒店）', '诉求区域': '青浦区', '内容描述': '市民来电反映:上述酒店对面写字楼违规搭建脚手架，白天施工噪音扰民，诉求：望有关部门协调让其暂停施工（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '【此工单诉求内容属实】徐泾镇城运中心于2025年04月26日接单，于2025年04月26日14：07分首次通过电话先行联系诉求人，告知诉求已收悉，正在我单位办理。办理情况：接件后，西虹桥公司工作人员联系该工地负责人，责令其办理装修报备和施工许可证后才能进行施工，该工地未经允许私自搭建脚手架，执法部门已上门对其进行处罚。目前已停止施工，待备案手续通过后再进行复工。关于诉求人诉求噪音，经与诉求人电话联系，其表示暂无噪音了。该问题已解释说明。经办人：陈景林', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': '青浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1745569982-2833746', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '建筑施工噪声', '诉求地址_省份': None}
