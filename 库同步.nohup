{'工单编号': '20250516006807', '工号': '2045', '工单生成时间': datetime.datetime(2025, 5, 16, 10, 36, 3), '诉求地址': '宝山区罗店镇美房苑', '诉求区域': '宝山区', '内容描述': '市民反映：美房苑消防监控室没有按照消防法要求，配备值班人员，应当24小时每班配备2人，且要有消防设施操作证，已经多年多次向罗店物业反映，没有解决。诉求：请管理部门加强管理。', '工单类别': '一般', '处理描述': '经核实，美房苑小区值班人员配备，物业严格按规定配备监控室值班人员，不存在配备不足问题。经了解，投诉人实际居住罗秀苑小区，在美房苑无房产登记；曾于2024年3月入职罗店物业，11月因个人原因离职，现因有犯罪记录不符合公司聘用条件，再次求职未获通过。该人员因入职诉求未达成，近期多次针对罗店物业管辖小区发起投诉，反馈内容不实，实际目的为要求返岗。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '宝山区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '住房保障', '新三级分类': '住宅物业服务管理', '新四级分类': '物业安保', '新五级分类': '公共区域巡逻', '诉求地址_省份': None}
