{'工单编号': '20250519006070', '工号': '3127', '工单生成时间': datetime.datetime(2025, 5, 19, 9, 41, 26), '诉求地址': '金山区板桥东路1200弄', '诉求区域': '金山区', '内容描述': '市民来电反映:上述小区在道路施工，整条路封掉，没有提前告知亦未设立警示标志，导致小区严重拥堵，诉求：希望管理部门核实给予合理解释并加强管理。', '工单类别': '一般', '处理描述': '先行联系时间：2025年05月19日 10时22分 核实认定情况：经现场核实物业对该路段上下沉的窨井进行维修，施工现场进行了部分隔离，没有对整条路进行封路。 处置过程和结果：接到此工单后，居委会联系物业了解情况，并到现场进行核实物业对该路段上下沉的窨井进行维修，施工现场进行了局部围挡，没有对整条路进行封路。因该路段窨井下沉严重进行统一维修，施工区域进行局部围挡，道路留出一部分可以进行通行，在早高峰时间段可能通行较慢，对此居委会要求物业加强管理，确保该路段车辆能够通行。现已施工完毕恢复正常。 答复市民反馈情况：多次去电诉求人拒接。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': '金山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1747618681-862491', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '城乡建设', '新三级分类': '工程管理', '新四级分类': '施工管理', '新五级分类': '施工占道', '诉求地址_省份': None}
