{'工单编号': '20250422048915', '工号': '4968', '工单生成时间': datetime.datetime(2025, 4, 22, 22, 18, 4), '诉求地址': '奉贤区东方美谷大道6333号', '诉求区域': '奉贤区', '内容描述': '市民来电反映:上述地址上海商学院（奉贤校区），该学校男生没有独立澡堂，每天晚上22:00澡堂就关闭了。且该澡堂的管理员根本不核查澡堂内是否还有人在洗漱，就直接拉闸，导致里面的同学被冷水浇一身，且该管理员阿姨也不管里面是否有人，是否穿衣，直接进入澡堂进行清扫。市民对此不认可，市民表示即对同学的身体可能造成伤害，又侵犯了同学们的个人隐私。诉求：请管理部门核实并延长澡堂的关闭时间，并对澡堂工作人员的行为进行整改。', '工单类别': '一般', '处理描述': '同意办结。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '学校管理', '四级分类': '校园设施', '主办单位': '市教育委员会', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1745330824-2240916', '工单类型': '投诉举报类', '新一级分类': '科教文卫类', '新二级分类': '教育', '新三级分类': '学校管理', '新四级分类': '校园设施', '新五级分类': '后勤服务', '诉求地址_省份': None}
