{'工单编号': '20250524005136', '工号': '3274', '工单生成时间': datetime.datetime(2025, 5, 24, 10, 0, 28), '诉求地址': '杨浦区黑山路8弄1号', '诉求区域': '杨浦区', '内容描述': '市民来电反映:杨浦区黑山路8弄1号6楼以下有居民家里周未装修施工，具体哪一户不知，噪音严重影响市民休息，诉求：请核实，要求对方周未禁止有噪音的施 。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派长海路街道处理。据长海路街道回复：先行联系：未联，始终未接 事实认定：部分属实 诉求认定：合理合法 处置过程及回访：接单后于2025年5月26日居委会、物业工作人员开展排查，经逐户走访核实，现已确认装修住户。物业、居委人员已依据《中华人民共和国环境噪声污染防治法》及本地物业管理规定，对其进行政策宣导与劝导，明确告知周末及法定节假日禁止开展产生噪音的装修作业。该住户已承诺调整施工时间，杜绝类似情况发生。后续，居委将联合物业加强日常巡查监管。 处置人员：黑山居委，65347245', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1748051788-2438973', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '室内装修噪声', '诉求地址_省份': None}
