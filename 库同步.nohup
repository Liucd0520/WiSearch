{'工单编号': '20250210029304', '工号': '1686', '工单生成时间': datetime.datetime(2025, 2, 10, 16, 56, 9), '诉求地址': '七宝镇七莘路1728弄廖花汀花园', '诉求区域': '闵行区', '内容描述': '市民来电反映:业委会不公布公共收益账户和维修基金账户银行流水、停车位管理制度以及制定依据、还有公共车位分配情况，包括商铺门口60个车位，找过居委，居委说不公布他们也没办法，诉求：投诉居委业委要求督促公布信息。', '工单类别': '一般', '处理描述': '七宝镇社会工作办于2月11日与来电人先行联系，并对诉求信息进行确认。经现场查看，小区按规定公布公共收益、维修资金账目，停车管理规约在物业管理处上墙，相关材料可向业委会、物业查询。不存在不公布的情况。经核实，商铺外场地小部分为小区红线内，其余大多为政府待征地，为确保该处管理有序，2017年镇相关部门协调后，由第三方进行出资改造后，管理停车场。该停车场目前可停150辆左右，其中有60个车位由小区业主停放，按小区内标准收费每月150元。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '业委会', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1739177499-803075', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '住房保障', '新三级分类': '小区综合治理', '新四级分类': '业委会和业主大会', '新五级分类': '小区公共收益', '诉求地址_省份': None}
