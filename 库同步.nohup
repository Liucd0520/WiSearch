{'工单编号': '20250106035274', '工号': '3621', '工单生成时间': datetime.datetime(2025, 1, 6, 16, 26, 56), '诉求地址': '浦东新区碧云路338弄碧云尊邸70号', '诉求区域': '浦东新区', '内容描述': '（正在搭建，小区）市民反映：小区70号目前正违规在露台上搭建房间，多次沟通后不理会，还违规开挖地下室，抬高地下室。诉求：请相关部门尽快拆除正在搭建的露台房间。', '工单类别': '一般', '处理描述': '您好，花木街道城管中队接单后，执法人员会同物业工作人员至现场检查，现场正在装修施工，在该别墅三楼东北侧露台用用砖块等材质搭建了一间房间，在西侧北露台用玻璃、铝合金等材质搭建了一间阳光房，执法人员现场开具并送达《责令停止建设、限期拆除决定书》（沪（浦）花办责停限拆决字【2025】第084201号），要求业主自行拆除，在5天整改期限结束后仍未拆除的，将继续依法依规推进强制拆除程序。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '城管执法', '新三级分类': '违建执法', '新四级分类': '违法建筑', '新五级分类': '新增违法建筑', '诉求地址_省份': None}
