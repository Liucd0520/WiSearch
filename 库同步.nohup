{'工单编号': '20250514001519', '工号': '4477', '工单生成时间': datetime.datetime(2025, 5, 14, 8, 8, 2), '诉求地址': '普陀区志丹路160弄28号403室', '诉求区域': '普陀区', '内容描述': '市民来电反映:上述地址居民家中装修将建筑垃圾都堆放在楼道内，把消防通道都堵住了，向物业反映了仍然不清理，存在安全隐患。诉求：要求尽快清理建筑垃圾。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '甘泉路街道5月14日接单并先联。城运中心接单后核实情况，确认情况属实。 1、城运中心于5月14日接单并先联。 2、经核实，志丹路170弄28号403室确有在进行装修，施工方将建筑垃圾堆放在楼道内。物业与业主进行了沟通协调，施工方于5月17日将楼道的建筑垃圾清运完毕。 3、城运中心要求物业跟进情况，加强巡逻，保持楼道卫生。 5月19日回复。 经办人：王璐 联系电话：18217786771', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '垃圾清理', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1747181110-602859', '工单类型': '求助类', '新一级分类': '住房和城乡建设类', '新二级分类': '住房保障', '新三级分类': '小区综合治理', '新四级分类': '不文明行为', '新五级分类': '楼道堆物', '诉求地址_省份': None}
