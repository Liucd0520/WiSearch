{'工单编号': '20250102023310', '工号': '3358', '工单生成时间': datetime.datetime(2025, 1, 2, 14, 0, 20), '诉求地址': '嘉定区曹安公路4086号', '诉求区域': '嘉定区', '内容描述': '（已搭建，民房）市民来电反映:上述地址原本有一处老式三层楼房近期加盖到了7-8层，影响附近采光。市民认为是违章建筑。诉求：希望管理部门能查证处置。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '嘉定区安亭镇：接热线后，经联西村核实，该处房屋于2015年前加盖，安亭镇城管中队调查，该处于2015年开始翻建，现场查看，企业已作房屋安全检测及消防检测，目前无安全隐患，属于历史存量违建，安亭镇城管中队下一步拟按照市区存量违建要求统一逐步整治。后续联西村加强巡查，配合安亭镇城管中队做好整治工作。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1735797246-2301240', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '城管执法', '新三级分类': '违建执法', '新四级分类': '违法建筑', '新五级分类': '存量违法建筑', '诉求地址_省份': None}
