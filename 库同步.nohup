{'工单编号': '20250228037464', '工号': '4012', '工单生成时间': datetime.datetime(2025, 2, 28, 19, 28, 52), '诉求地址': '松江区滨亭路216弄1-4号 九里亭街道社区卫生服务中心', '诉求区域': '松江区', '内容描述': '【表扬】市民来电咨询:市民为涞寅路106弄26号202室的居民，其家中老人患有糖尿病，其家庭医生为上述医院的“李燕”医生，其表示自从老人住院回家后，该医生就把老人的糖尿病控制的很好，且对老人很热情，态度也很好，服务也非常周到，故特此来电表扬上述家庭医生。诉求：请管理部门核实处理。', '工单类别': '一般', '处理描述': '表扬九里亭社区医生医术精湛态度好 处理情况说明 20250228037464 12320卫生热线办公室： 松江区卫健委热线办于3月3日接到12320卫生热线转送单，关于表扬九里亭社区医生医术精湛态度好的情况。接单当日我委热线办9:13联系市民核实信息。 市民表扬九里亭街道社区卫生服务中心（以下简称中心）医生医术精湛态度好。九里亭街道社区卫生服务中心党政办公室负责人联系市民，家庭医生李燕身为一名党员，同时作为奥园社区服务站团队长，不仅具备扎实的专业知识，还在日常工作中不断锤炼自己的业务技能，发挥着党员干部应有的带头作用。未来，中心也将继续秉承“以患者为中心”的服务理念，擦亮“十里春风...', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '表扬承办部门', '四级分类': '表扬感谢', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1740741730-2166614', '工单类型': '其他类', '新一级分类': '科教文卫类', '新二级分类': '卫生', '新三级分类': '医疗机构与服务', '新四级分类': '医护人员', '新五级分类': '服务态度', '诉求地址_省份': None}
