{'工单编号': '20250310013549', '工号': '1650', '工单生成时间': datetime.datetime(2025, 3, 10, 11, 26, 3), '诉求地址': '静安区彭浦镇老年食堂', '诉求区域': '静安区', '内容描述': '市民来电反映:彭浦镇开了老年食堂，市民发现食堂，今天的菜和昨天相同，怀疑是昨天的菜，担心食品安全问题，诉求：希望管理部门加强管理。（需回复）', '工单类别': '一般', '处理描述': '【彭浦镇】不属实。2025年3月11日8:50联系诉求人王先生，王先生告知永和路社区食堂每日为其母亲送餐上门，其母亲告知食堂周日和周一送的同样的菜，怀疑是剩菜。经与永和路社区长者核实情况，王先生母亲是永和路食堂重点关爱的服务对象，食堂对老人的喜好进行了备注，老人家不吃鸡肉、鱼肉、海鲜。由于周日套餐有黄焖鸡腿，食堂为老人把鸡腿更换为咕咾肉。周一根据菜单是水晶咕咾肉和花菜肉片，老人怀疑咕咾肉是剩菜。永和路食堂已向老人进行了解释。经与诉求人解释以上情况，告知永和路社区食堂每日菜单经彭浦播报公示，每日菜均为新鲜现制，绝非剩菜。诉求人不接受解释。经办人：严蓓，联系电话：56659950。', '客户类型': '个人', '一级分类': '安全监管类', '二级分类': '食品药品安全', '三级分类': '安全管理', '四级分类': '食品安全', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1741576834-135285', '工单类型': '投诉举报类', '新一级分类': '社会管理类', '新二级分类': '市场监管', '新三级分类': '企业监管', '新四级分类': '食品安全监管', '新五级分类': '食品质量', '诉求地址_省份': None}
