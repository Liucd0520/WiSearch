{'工单编号': '20250113017490', '工号': '1697', '工单生成时间': datetime.datetime(2025, 1, 13, 12, 32, 23), '诉求地址': '浦东新区大团镇龙树村', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:其在自己场地上搭了一个阳光棚，被人举报，邻居家违章是多年前搭的，告知其不拆，询问是否有这个规定，新搭建的要拆，老的可以不拆，其拆除违章，是否有补偿。（需要回复）', '工单类别': '一般', '处理描述': '申请结案。接单后，大团镇龙树村第一时间派工作人员去现场查看，经查，发现诉求人所讲的阳光棚搭在自家场地上，面积8一9平方，用于停放电动车，村里见议为认真贯彻落实巜浦东新区电动车安全治理攻坚行动工作方案》要求，暂拆。关于邻居家多年前搭建的属于剩量违章，目前拆除违章从2024年1月起已无补偿。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1736742340-2175556', '工单类型': '咨询类', '新一级分类': '住房和城乡建设类', '新二级分类': '城管执法', '新三级分类': '违建执法', '新四级分类': '违法建筑', '新五级分类': '新增违法建筑', '诉求地址_省份': None}
