{'工单编号': '20250114000149', '工号': 'zzpd1', '工单生成时间': datetime.datetime(2025, 1, 14, 1, 0, 3), '诉求地址': '自由贸易试验区加太路39号3幢1层16室', '诉求区域': '本市', '内容描述': '【商家地址/名称:未提供,时间:2025/01/1400:43:00,涉及金额:8259元】1月11日上午10点20分在拼多多下单一台vivo品牌手机，并完成付款8259元，平台软件内显示2天内发货，并与商家进行确认48小时内发货。1月13日上午10点20分仍未发货（超过48小时），当天与客服沟通一天仍未发货，目前仍处于未发货状态，并且不知道什么时间发货，商品发货时间与实际描述不符。根据《消费者权益保护法》55条经营者提供商品或者服务有欺诈行为的，应当按照消费者的要求增加赔偿其受到的损失，增加赔偿的金额为消费者购买商品的价款或者接受服务的费用的三倍。要求商家完成发货并按法规要求进行3倍赔偿。', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': '社会管理类', '新二级分类': '市场监管', '新三级分类': '消费维权', '新四级分类': '消费纠纷', '新五级分类': '售后服务纠纷', '诉求地址_省份': None}
