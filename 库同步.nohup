{'工单编号': '20250502002160', '工号': '4425', '工单生成时间': datetime.datetime(2025, 5, 2, 8, 57, 55), '诉求地址': '浦东新区藿香路238弄19号20号26号27号', '诉求区域': '浦东新区', '内容描述': '市民来电反映:5月2日上述地址小区内部5点40左右有人连按10多声汽车喇叭，把周边居民惊醒，家里的老人和孩子也受到影响。且6点多的时候又再次出现按喇叭噪音扰民情况。故此市民来电投诉。诉求：请管理部门查看监控对该按喇叭噪音扰民人员进行批评教育。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '接单后，张江房办联系汤臣四期小区了解具体情况，东湖物业告知，小区监控是无声监控，视频中只有图像，无法放出声音，未发现制造喇叭噪音车辆的车牌号。物业持续做好小区车辆管理和定期巡逻，对于无故按喇叭制造噪音的车辆，如现场发现即制止。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1746147105-2753268', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '其他噪声', '诉求地址_省份': None}
