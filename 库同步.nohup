{'工单编号': '20250424029890', '工号': '3809', '工单生成时间': datetime.datetime(2025, 4, 24, 15, 34, 51), '诉求地址': '浦东新区浦东潍坊八村建筑垃圾箱房', '诉求区域': '浦东新区', '内容描述': '市民反映：浦东潍坊八村建筑垃圾厢房管理不善，建筑垃圾严重影响了道路。这扇门天天不关，尘土飞扬，还有拾荒人员拆废品。历年其也反映这个问题，但总是得不到彻底解决，天天和垃圾作伴，作为斜对门的居民实在太糟心。诉求：要求加强建筑垃圾厢房管理。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '您好，潍坊八村居委会4月24日接单，根据居民反映的情况随后居委立即联系居民了解具体情况，物业反馈因清运单位原因建筑垃圾前几日没有及时清运，4月26日已清运完毕。建筑垃圾厢房门也会加强管理。感谢您对潍坊八村居委的理解和支持。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '垃圾清理', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': '住房和城乡建设类', '新二级分类': '住房保障', '新三级分类': '住宅物业服务管理', '新四级分类': '物业保洁', '新五级分类': '垃圾厢房保洁', '诉求地址_省份': None}
