{'工单编号': '20250613026030', '工号': '2151', '工单生成时间': datetime.datetime(2025, 6, 13, 19, 15, 47), '诉求地址': '宝山区罗店镇潘泾路1999弄', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述小区居民经常闻到化学品的异味，早上7点左右和17点左右路过宝翼制罐厂时有明显的味道，之前向环保部门反映过，但没有解决问题，诉求：请管理部门核实整治（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '上海宝翼制罐有限公司主要从事铝制易拉罐的加工生产，主要生产工艺：冲杯-拉伸-修边-清洗-烘干-彩印-烘干-光检-产品。企业生产为24小时连续生产，2025年6月至检查时生产平稳连续。 企业产品均为食品级，无毒性、刺激性。 企业喷涂过程中产生的含挥发性有机物废气经一套废气处理设施处理后排放，处理工艺为：沸石转轮浓缩加RTO处理后排放，水处理过程中产生的异味收集后经一套废气处理设施处理后有组织排放，处理工艺为：碱喷淋加活性碳吸附。...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '废气污染', '主办单位': '市生态环境局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1749812970-3081453', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '空气污染', '新五级分类': '工业废气', '诉求地址_省份': None}
