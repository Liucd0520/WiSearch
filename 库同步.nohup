{'工单编号': '20250323009760', '工号': '3427', '工单生成时间': datetime.datetime(2025, 3, 23, 11, 54, 12), '诉求地址': '徐汇区广元西路303号楼下商户', '诉求区域': '徐汇区', '内容描述': '市民来电反映:市民表示上述地址楼下商铺周末时间进行装修，严重影响居民正常作息，诉求：希望管理部门核实后落实制止周末噪音扰民（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '徐家汇街道城运中心3月24日收到反映商铺装修的工单，由于市民未留联系电话，无法先行联系，工单派至管理办主办处理。徐家汇城管中队于3月24日收到该投诉，市民反映的广元西路303商铺装修，经查为报建项目，周末可以正常装修，考虑到该处楼上为居民楼，中队约谈了该处负责人，要求施工时做好降噪措施，其表示会进行整改，周末尽量调整为不产生噪音的施工项目，法定节假日不进行施工，减少对楼上居民的影响。投诉人为匿名，故无法电话联系。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '徐汇区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1742701858-926256', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '室内装修噪声', '诉求地址_省份': None}
