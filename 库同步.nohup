{'工单编号': '20250325035264', '工号': '3873', '工单生成时间': datetime.datetime(2025, 3, 25, 16, 55, 56), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电反映:单位在1月份时向浦东税务局提出企业员工退社保费事项，现在给其反馈是“该人员已退休无法办理退社保费事宜”，但是其申请退社保时间段在2024年3月份至2024年8月份。税务部门给其反馈是社保部门审核不通过，必须通过线上提交申请，无法线下递交申请。其咨询人社部门，对方告知其需要通过线上递交，线上递交由机器人先审核，判断到该人员已退休，直接审核不通过。员工姓名：杭薇，身份证：310225196402220021。诉求：希望管理部门协助其完成社保费退费。', '工单类别': '一般', '处理描述': '2025年4月15日电话联系市民。告知其，可向税务部门申请社会保险费退费业务，社保部门将持续跟踪数据推送情况，并告知机关事业单位退休人员退休后多缴纳社会保险费的退费规定。', '客户类型': '企业', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '其他', '四级分类': '其他', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1742892464-2494950', '工单类型': '求助类', '新一级分类': '经济综合类', '新二级分类': '税务', '新三级分类': '税收政策', '新四级分类': '社保费与非税收入', '新五级分类': '社会保险费', '诉求地址_省份': None}
