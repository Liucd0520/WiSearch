{'工单编号': '20250217018975', '工号': '1791', '工单生成时间': datetime.datetime(2025, 2, 17, 13, 26, 41), '诉求地址': '杨浦区武东路9号', '诉求区域': '杨浦区', '内容描述': '市民来电反映:2月13日，市民到上述地址五角场街道社区卫生服务中心看病，当时要在胳膊上安装一个智能化监测血糖的仪器，是一名姓王的老护士为其安装的。市民表示王护士工作不认真，上班时间用手机抢红包，安装仪器时，把市民的胳膊上扎的都是血。诉求：投诉王护士服务态度。', '工单类别': '一般', '处理描述': '接单后，我中心十分重视，2月17日、2月18日护理部主任致电陈女士，了解情况后2月20日当面向陈女士作了解释，表示中心将做好护士的职业技能培训工作，加强服务意识，就当日情况致歉，陈女士表示理解并接受。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '服务态度', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1739769474-2754571', '工单类型': '投诉举报类', '新一级分类': '科教文卫类', '新二级分类': '卫生', '新三级分类': '医疗机构与服务', '新四级分类': '医护人员', '新五级分类': '服务态度', '诉求地址_省份': None}
