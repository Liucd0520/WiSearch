{'工单编号': '20250402000346', '工号': '2693', '工单生成时间': datetime.datetime(2025, 4, 2, 5, 11, 20), '诉求地址': '嘉定区秋竹路801弄', '诉求区域': '嘉定区', '内容描述': '市民来电反映:市民在4月2日5:00在上述小区内闻到小区外传来的化工生产的臭味，市民表示臭味非常大，但不清楚来源，诉求：希望管理部门核实来源并处理。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '嘉定区生态环境局：菊园新区环保办工作人员4月2日、3日多次现场查看，未发现异味源，且周边无大型工业排放废气企业。经多方核实，发现露天焚烧痕迹。4月3日10：27联系答复。菊园中队：4月14日与投诉人先行联系了解情况。4月15日嘉定区城管局菊园中队执法队员对社区周边的监控视频进行调阅，未发现有焚烧情况，同时对周边荒地进行巡查，同样未发现乱焚烧痕迹。4月15日电话回复投诉人，投诉人表示知晓。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '空气污染', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1743541634-2626645', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '空气污染', '新五级分类': '恶臭、异味', '诉求地址_省份': None}
