{'工单编号': '20250408034585', '工号': '4608', '工单生成时间': datetime.datetime(2025, 4, 8, 16, 46, 26), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:孩子的学籍在黄浦区公办小学，将要小升初，计划去浦东的民办学校就读初中，其有房屋预售合同，是否可以作为补充材料，还是必须做人户分离以租赁合同备案的形式操作，请管理部门告知相关政策。', '工单类别': '一般', '处理描述': '市民您好：您反映的情况浦东新区教育局已收悉。2025年浦东新区义务教育阶段学校招生入学操作细则，小学阶段入学，办理居住地登记入学手续的截止日期为4月27日。市民房产未在4月27日前交付，则预售合同不作为入学登记的依据，市民需按照人户分离以租赁合同备案的形式操作。先联与答复为统一录音。另外双呼的录音无法下载。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '入学入托', '四级分类': '入学政策', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1744101440-3031341', '工单类型': '咨询类', '新一级分类': '科教文卫类', '新二级分类': '教育', '新三级分类': '入学入园', '新四级分类': '入学管理', '新五级分类': '招生政策', '诉求地址_省份': None}
