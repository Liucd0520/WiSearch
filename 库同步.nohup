{'工单编号': '20250419006468', '工号': 'zzpd1', '工单生成时间': datetime.datetime(2025, 4, 19, 10, 20), '诉求地址': '12号线龙漕路地铁站靠近全家的安检口', '诉求区域': '徐汇区', '内容描述': '【线路名称12号线龙漕路站】4.18日上午10点二十几分，我像往常一样背了一个抽拉双肩包过安检，里面只有一个办公电脑，安检员（工号尾号9737或9373，记不太清了，是地铁内全家超市旁边的安检口的安检员）对于主动打开书包，能够直接看到包内只有一个电脑的情况下，仍然拦住乘客，强行要求上机安检，违反了地铁轨道交通“对于主动开包的乘客可以放行”的通告。且该安检员存在针对情况，对于同样开包、想直接通过的其他乘客都予以了直接放行，只针对了我一人要求我强行上机安检，我想请问这是符合规定的吗？以及谁需要上机安检是仅凭这个安检员的个人意愿吗？？她想针对谁就针对谁？？以上情况全部属实，请相关站点核实后给到...', '工单类别': '一般', '处理描述': '已确认', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '地铁客运', '四级分类': '线路时间', '主办单位': '申通集团', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': '交通运输类', '新二级分类': '道路运输', '新三级分类': '轨道交通', '新四级分类': '地铁建设', '新五级分类': '建设规划', '诉求地址_省份': None}
