{'工单编号': '20250306030228', '工号': '4049', '工单生成时间': datetime.datetime(2025, 3, 6, 16, 39, 41), '诉求地址': '虹口区江湾街道奎照路320弄', '诉求区域': '虹口区', '内容描述': '市民来电反映:2024年上述小区内树枝已全部修剪，唯独17号101室前的三棵香樟树未处理，现树枝过于茂盛，造成市民长期无阳光，多次联系物业表示“无名额，无法修剪”。诉求：请尽快修剪树枝。', '工单类别': '一般', '处理描述': '江湾镇街道于3月7日接单。街道城运中心于3月7日15时46分电话首联市民。经了解，奎照路320弄17号的三棵树木已于2024年11月进行过修剪。经现场查看，投诉人反映的三颗大树离楼栋有一定距离，中间隔着一条步道，并未紧贴楼栋外墙。投诉人所述唯独17号101室前的三棵香樟树未处理与事实不符，故申请不属实。目前物业暂无修剪计划。工作人员于3月12日，与投诉人联系，按上述内容答复。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '绿地绿化', '四级分类': '移植修剪', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1741249844-800735', '工单类型': '求助类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '绿化', '新四级分类': '行道树', '新五级分类': '遮挡干扰', '诉求地址_省份': None}
