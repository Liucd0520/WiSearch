{'工单编号': '20250103000187', '工号': '4018', '工单生成时间': datetime.datetime(2025, 1, 3, 1, 23, 51), '诉求地址': '杨浦区中原路158弄', '诉求区域': '杨浦区', '内容描述': '市民来电反映:1月3日1:20上述地址附近有道路施工，噪音扰民。诉求：望有关部门协调让其避免噪音扰民（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派区建管委进行处理。据区建管委回复：先行联系：未联。事实认定：部分属实，诉求认定：合理合法。处置过程及回访：经现场核实，该处为中原路道路整治工程施工范围，针对反映人所述工程施工存在夜间施工，杨浦区市政中心根据交警批复意见给予夜间施工备案，为了保证白天道路通畅，只能错高峰或夜间施工摊铺，我委已督促尽快完成施工，减少影响，现已完工。 处置人员：陈东平（65708875）', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1735838470-2900062', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '公路、高架施工噪声', '诉求地址_省份': None}
