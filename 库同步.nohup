{'工单编号': '20250310043814', '工号': '1958', '工单生成时间': datetime.datetime(2025, 3, 10, 20, 43, 9), '诉求地址': '黄浦区瞿溪路897号507室', '诉求区域': '黄浦区', '内容描述': '市民来电反映:上述地址有群租，不到20个平方米住了10个人，市民表示该层楼基本都是这样的，诉求：希望管理部门核实查处。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '不属实，五里桥街道于2025年3月11日接单，先行联系未接未能告知其诉求受理情况，街道平安办积极协调街道城建中心开展上门查看工作，确认瞿溪路897号全幢为郎轩公寓。经查上述企业营业范围包括住宿服务，同时该地址为沿街楼宇，并非居民区，根据相关规定不属于群租。综上未发现群租情况，无需查处。多次致电未接听短信告知来电人将处置情况告。经办人：成晨？？', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '群租现象', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1741610391-865388', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '城管执法', '新三级分类': '房屋违规使用执法', '新四级分类': '房屋违法租赁（群租）', '新五级分类': '房屋违法租赁（群租）', '诉求地址_省份': None}
