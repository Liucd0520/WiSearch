{'工单编号': '20250102002968', '工号': '3990', '工单生成时间': datetime.datetime(2025, 1, 2, 9, 9, 12), '诉求地址': '宝山区宝山10路', '诉求区域': '宝山区', '内容描述': '市民来电反映:12月31日22:07其在龙镇路德都路站等宝山10路要坐到蕰川路古莲路，站牌显示下班车22:30到，后分别跳到22:49，22:59，23:02都没有车来。诉求：投诉调度。', '工单类别': '一般', '处理描述': '于1月7日17:00分左右与市民联系。市民表示在德都路龙镇路等车，当时站牌显示宝山10路下班车22:30到达该站点，之后又等车等了很久站牌时间也一直在往后变化一直等到23:02分都没有等到宝山10路进站。经我委协调，车队负责人向该市民表示了歉意，通过沟通解释后，该市民对车队负责人的解释内容表示了认可。同时车队负责人还表示会加强因交通管制导致的路阻做出合理的预案以避免此类情况再次发生。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '公交巴士', '四级分类': '线路设置', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1735779673-400837', '工单类型': '投诉举报类', '新一级分类': '交通运输类', '新二级分类': '道路运输', '新三级分类': '地面公交', '新四级分类': '营运管理', '新五级分类': '车间距大', '诉求地址_省份': None}
