{'工单编号': '20250115009120', '工号': '4386', '工单生成时间': datetime.datetime(2025, 1, 15, 10, 30, 51), '诉求地址': '金山区枫泾镇兴新路强兴路', '诉求区域': '金山区', '内容描述': '市民来电反映:上述地址兴新路近几个月有道路施工，投诉施工扬尘严重，希望能洒水作业或使用设备吸尘。诉求：请管理部门核实后解决扬尘扰民问题。', '工单类别': '一般', '处理描述': '先行联系时间：2015年1月15日 15时48分 核实认定情况：兴新路强兴路由于电力排管施工，电力施工单位扬尘控制措施不到位，导致社会车辆经过该路段出现扬尘现象。 处置过程和结果：针对电力排管单位施工导致扬尘现象，由道路总包单位对现场进行清扫，派洒水车进行冲洗，同时过程持续对现场的文明施工进行维护。 答复市民反馈情况：诉求人对现场问题处置结果满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': '金山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1736907953-212084', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '城乡建设', '新三级分类': '工程管理', '新四级分类': '施工管理', '新五级分类': '施工扬尘', '诉求地址_省份': None}
