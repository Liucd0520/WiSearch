{'工单编号': '20250130002992', '工号': '3990', '工单生成时间': datetime.datetime(2025, 1, 30, 11, 42, 4), '诉求地址': '宝山区顾村镇康联路58弄胡欣苑', '诉求区域': '宝山区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，康联路58弄胡欣苑9号1月30日11点30分左右有人在电梯内吸烟，违反上海禁烟条例，多次投诉无果。诉求：要求加大执法力度。最近办结的工单编号：20241129033996，工单内容：市民反映：居民电梯内经常有人吸烟，影响居民健康，前面已经投诉过，物业口头告知根本没有效果，希望对违反禁烟条例的人进行处罚。诉求：要求加强控烟。（市民要求无需回复）】', '工单类别': '一般', '处理描述': '顾村物业、城管中队具体处理情况：经了解，物业前期已在在楼道电梯轿厢内张贴了禁止吸烟的告知。此次物业在接单后，通过电梯监控查看了解到当天在11点33分的时候有一个年轻男子在电梯内抽烟，物业工作人员通过监控视屏查到吸烟者，工作人与立即上门与该男子进行了沟通，告知其电梯内禁止吸烟，以免给楼内居民生活环境造成影响。该居民也表示会予以改正。上述情况已告知来电市民。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '禁烟控烟', '四级分类': '禁烟控烟', '主办单位': '宝山区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': '科教文卫类', '新二级分类': '卫生', '新三级分类': '公共卫生监管', '新四级分类': '公共场所卫生监督', '新五级分类': '公共场所吸烟', '诉求地址_省份': None}
