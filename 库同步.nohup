{'工单编号': '20250227004437', '工号': '4555', '工单生成时间': datetime.datetime(2025, 2, 27, 9, 31, 28), '诉求地址': '奉贤区华苑路132号南新新村小区30号', '诉求区域': '奉贤区', '内容描述': '市民来电反映:2024年2月，由于上述地址小区的电梯已经工作10多年了，经常出现故障，所以当时市民缴纳了5000元的电梯重新安装的费用，但是至今，该电梯没有更换新的设备。诉求：请管理部门核实，尽快安排更换电梯，或者告知目前的进展情况。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '南桥镇于2025年2月27日接单，于2025-02-27 09:35:51首次通过电话先行联系来电人，告知其问题已经收悉，正在南桥镇进行办理。2月27日16时，由南桥镇工作人员，对来电人所反映的情况进行核实。上述地址更换电梯案件，经三位一体协商，定于3月中旬正式开工。已经将处置结果告知来电人，经办人：范仙玲。', '客户类型': '个人', '一级分类': '安全监管类', '二级分类': '质量技术监督', '三级分类': '特种设备监察', '四级分类': '安全监察', '主办单位': '奉贤区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1740619525-665023', '工单类型': '求助类', '新一级分类': '社会管理类', '新二级分类': '市场监管', '新三级分类': '企业监管', '新四级分类': '特种设备监管', '新五级分类': '电梯', '诉求地址_省份': None}
