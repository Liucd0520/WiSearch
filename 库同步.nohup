{'工单编号': '20250124027661', '工号': 'zzpd1', '工单生成时间': datetime.datetime(2025, 1, 24, 16, 50, 17), '诉求地址': '延安西路近虹桥路口', '诉求区域': '长宁区', '内容描述': '【发生时间:2025/01/2107:30:00,持续时间:未提供】路口红绿灯停车抛物，道路无人清扫。加强行车抛物处罚；加强道路、花坛垃圾清理。明确管理方，消除管理真空地带。', '工单类别': '一般', '处理描述': '接到投诉后，公司立即安排人员现场核实情况，经现场核实，诉求人反映的是快车道及绿化带上存在抛物垃圾，目前公司已安排人员将垃圾清理，还请诉求人放心，公司十分重视，已要求要求道路工人在日常保洁的同时多关注快车道及边上绿化带环境卫生状况，发现垃圾及时处置清理，之前带来的不便还请诉求人谅解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '环境垃圾', '主办单位': '市绿化和市容管理局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '环卫', '新四级分类': '道路管理', '新五级分类': '道路污染', '诉求地址_省份': None}
