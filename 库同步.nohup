{'工单编号': '20250429042215', '工号': '4623', '工单生成时间': datetime.datetime(2025, 4, 29, 20, 57, 16), '诉求地址': '徐汇区龙漕路田东路', '诉求区域': '徐汇区', '内容描述': '市民来电反映:上述地址龙漕路上道路施工噪音扰民，诉求：请管理部门整治。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '一、因市民信息保密，故无法先行联系。二、经核实，该处为徐汇区龙漕路（漕溪路-龙吴路）架空线入地信息排管工程，施工证照齐全，交警批复施工时间为25年4月22日-25年6月10日，且开工前已与街道进行过沟通协商，并于施工路段张贴安民公示。目前该段道路正在进行架空线入地作业施工，考虑到对交通的影响，部分施工只允许夜间进行，现已要求施工单位尽早完成大噪音机械施工。后期将加强对现场的文明施工管理，做好降噪措施，减少噪音扰民。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '徐汇区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1745931200-788325', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '其他道路施工噪声', '诉求地址_省份': None}
