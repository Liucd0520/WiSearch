{'工单编号': '20250505021986', '工号': '4240', '工单生成时间': datetime.datetime(2025, 5, 5, 18, 45, 54), '诉求地址': '长宁区金钟路968号', '诉求区域': '长宁区', '内容描述': '市民来电反映:市民通过携程平台（上海携程国际旅行社有限公司）购买演唱会的门票，捆绑了酒店入驻服务。当是下单时显示订单非实名制，市民近期生病无法前往，申请退款被携程拒绝。为减少损失希望将酒店更改入住人，又被拒绝。订单编号：1128135873627610，诉求：请管理部门介入，或者协助退款，或者更改酒店的入住人，减少市民的损失。', '工单类别': '一般', '处理描述': '此单经核实，市民通过武汉携程国际旅行社有限公司下单订购，该公司注册在武汉，未与上海携程发生合同关系，按照《旅游投诉处理办法》第9条第3款，不属于旅游投诉处理机构职责范围或管辖范围的，不予受理。建议客人致电当地有关部门进行咨询。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '旅游', '三级分类': '服务质量', '四级分类': '旅行社服务', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1746441639-2111622', '工单类型': '求助类', '新一级分类': '科教文卫类', '新二级分类': '旅游', '新三级分类': '旅游市场', '新四级分类': '旅行社', '新五级分类': '服务质量', '诉求地址_省份': None}
