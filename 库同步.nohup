{'工单编号': '20250515002183', '工号': '4049', '工单生成时间': datetime.datetime(2025, 5, 15, 8, 34, 33), '诉求地址': '普陀区长寿路街道江宁路1251弄3号14D', '诉求区域': '普陀区', '内容描述': '市民来电反映:江宁路1251弄3号14D，三房两厅的房型现被放置了三个上下铺，且厨房间也被用于出租，居住了6人，诉求：请有关部门尽快取缔群租。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '长寿街道于5月15日接单，来电人未留电话无法联系。经房管部门核查反映的江宁路1251弄3号14D群租情况属实。2025年5月22日，由社区平安办牵头联合派出所、综合行政执法队、城运中心房管条线、属地居委及物业公司等部门对该房屋开展联合整治，屋内已完成自行整改，未见高低床和隔间情况，目前群租整治工作已完毕，后续将督促居委及物业加强小区出入口管理及日常巡查，做好整治后的固守工作。附件已上传。丁豪62765808-8405', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '群租现象', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1747269003-212436', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '城管执法', '新三级分类': '房屋违规使用执法', '新四级分类': '房屋违法租赁（群租）', '新五级分类': '房屋违法租赁（群租）', '诉求地址_省份': None}
