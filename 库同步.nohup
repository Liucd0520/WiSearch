{'工单编号': '20250524030502', '工号': '3790', '工单生成时间': datetime.datetime(2025, 5, 24, 20, 49, 42), '诉求地址': '黄浦区陆家浜路', '诉求区域': '黄浦区', '内容描述': '市民来电反映: 上述地址，靠近中福花苑小区这里5月24日，21点还在做道路施工。噪音市民。诉求：要求晚上停止施工。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '我单位2025年05月26日，因市民信息保密，无法先行联系。由我单位市政所对来电人所反映的情况进行核实，经查，该处为陆家浜路架空线工程，施工证照齐全，针对噪音扰民问题，已责成施工单位针对噪音问题采取降噪措施，合理安排工程时间，控制高分贝施工机械作业时间，减少扰民情况发生。因市民信息保密，无法回复。经办人：陈晶锋', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1748090510-404562', '工单类型': '求助类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '其他道路施工噪声', '诉求地址_省份': None}
