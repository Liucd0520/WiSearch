{'工单编号': '20250609038428', '工号': 'zzpd1', '工单生成时间': datetime.datetime(2025, 6, 9, 20, 40, 19), '诉求地址': '金虹桥国际中心', '诉求区域': '长宁区', '内容描述': '【商家地址/名称:未提供,时间:2025年06月08日20:36,涉及金额:1439.7】2025年1月在拼多多平台购买的马桶，实际物品与产品详情网页介绍不符。购买详情页面显示店铺是十年企业店铺，马桶是日本一线品牌，且已拼销量100万+，页面承诺全国联保专业客服。实际购买后保质期内即出现质量问题，无法使用。经查询，店铺为个人店铺，且申请页面显示为个人零星小额交易(年交易额累计不超过10万元）与拼多多页面展示的已拼单100万+和十年企业店铺不符合。产品也不是日本一线品牌，拼多多平台审核不严，涉嫌销售虚假宣传和假冒伪劣产品。要求拼多多平台全额退款。', '工单类别': '一般', '处理描述': '对于您反馈的情况，被投诉人表示您的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。投诉人还可以通过仲裁，司法等其他途径维护权益。特此告知。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '商品质量', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': '社会管理类', '新二级分类': '市场监管', '新三级分类': '企业监管', '新四级分类': '产品质量监管', '新五级分类': '生产销售问题产品', '诉求地址_省份': None}
