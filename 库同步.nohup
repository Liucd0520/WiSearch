{'工单编号': '20250606037334', '工号': '4234', '工单生成时间': datetime.datetime(2025, 6, 6, 20, 36), '诉求地址': '奉贤区聚秀路贤浦路', '诉求区域': '奉贤区', '内容描述': '市民来电反映:6月6日20:30，上述路口有10来个无证设摊，卖食品的，堵塞道路，市民表示之前城管来处理过，现在又开始摆摊了，诉求：请管理部门核实取缔无证设摊。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '区城管执法局于2025年6月7日接单，诉求人为匿名举报无法先行联系。经调查，大居城管中队安排队员于诉求时间段赶至诉求地点聚秀路贤浦路，发现小吃烧烤乱设摊，已经劝离，6月12日，大居中队开展夜间整治行动，对该处乱设摊进行行政处罚，立案号：当2515140124号。由于乱设摊有流动性，队员将继续加强该区域的巡查频次，发现乱设摊问题及时处置。（照片见附件）办理人：唐敏，朱凯飞 18116480856', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '奉贤区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1749213043-2062', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '市容', '新四级分类': '市容市貌', '新五级分类': '无序设摊', '诉求地址_省份': None}
