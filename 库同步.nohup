{'工单编号': '20250521000743', '工号': '4218', '工单生成时间': datetime.datetime(2025, 5, 21, 5, 50, 49), '诉求地址': '浦东新区金葵路1329-1333号', '诉求区域': '浦东新区', '内容描述': '的实施电子每天晚上门口摆了很多桌子，好多人在门口喝酒，影响小孩休息，诉求：希望管理部门加强管理，整治跨门营业。', '工单类别': '一般', '处理描述': '接单后，金桥镇综合行政执法队执法队员于2025年5月21日前往浦东新区金葵路1329-1333号现场查看，经查，现场发现跨门经营现象，执法人员根据现场情况对跨门行为进行警告及处罚，序列号：202512000441，当场处罚决定书编号：当2508124849号。同时，执法队员已督促店家规范经营。于2025年5月21日19:20、20:27、21:44至现场复查，未发现跨门经营。后续我中队将加强对该区域的监管和巡查。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '跨门经营', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '市容', '新四级分类': '市容市貌', '新五级分类': '跨门经营', '诉求地址_省份': None}
