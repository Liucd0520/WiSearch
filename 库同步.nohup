       -0.02220154, -0.02876282], shape=(1024,))}
{'工单编号': '20250120039191', '工号': '4436', '工单生成时间': datetime.datetime(2025, 1, 20, 18, 31, 42), '诉求地址': '长宁区江苏路街道，', '诉求区域': '长宁区', '内容描述': '市民来电咨询:自己是以上街道居民，对于节日70周岁老人都会发放礼品比如长寿面，但是自己的街道从来没有发放过，自己的亲戚是新泾镇街道的，同为长宁区，他们到了节日都会有相应的礼品慰问，最近还有一个老人意外险，无忧险，针对老人以外受伤会有额外的医疗费报销，自己的街道都没有。诉求，请核实给予合理解释和告知。', '工单类别': '一般', '处理描述': '江苏路街道于2025年1月21日接到市民通过“12345”热线反映的诉求，1月21日10:01首次通过电话与诉求人取得先行联系，告知其诉求已收悉。经长新居委会受理并核实，诉求人与其父亲户籍皆在长宁路491弄长新小区，属于江苏路街道管辖。长宁区关于老年人的关爱福利是由各个街镇自行规定相关政策的，江苏路街道目前的政策是只有年满80周岁的本地户籍居民才能享受老年人关爱福利，街道服务办相关工作人员已跟诉求人电话解释该政策，诉求人父亲目前是73岁周岁，所以未能享受老年人关爱福利。关于诉求人提及的老人意外险、无忧险，居委会已电话告知其本地居民年满60周岁就可享受“银发无忧”政策，其父亲也享受该政策，...', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '其他', '四级分类': '其他', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1737368624-2502673', '工单类型': '咨询类', '新一级分类': '社会管理类', '新二级分类': '民政', '新三级分类': '养老服务', '新四级分类': '助老优待', '新五级分类': '政策咨询', '诉求地址_省份': None}
