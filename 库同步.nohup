{'工单编号': '20250213000352', '工号': '4937', '工单生成时间': datetime.datetime(2025, 2, 13, 6, 48, 46), '诉求地址': '浦东新区东建新村', '诉求区域': '浦东新区', '内容描述': '市民来电反映:投诉垃圾清运车早上6点施工扰民，管理部门告知6点清运合理合规，市民非常不满。其拨打生态环境局综合协调中心热线20316790，对方工作人员告知告知其联系12345反馈，派单至承办单位后会进行处理。诉求：希望承办部门核实，适当延后垃圾清运时间。', '工单类别': '一般', '处理描述': '经生态环境局废管中心核实，该小区当前早6点后作业时间已符合行业规范。作业时间受交通路况及作业进度等多重因素制约，为保证广大市民拥有干净整洁的小区环境，不宜推迟作业时间；生活垃圾清运为机械化作业，无法人工干预降噪。中心已要求作业单位浦发环境在作业过程中尽可能压缩作业时间，尽量减少对市民的影响。废管中心于2025年2月13日15：16、2月14日9：44、16：31先行联系市民，均无人接听。废管中心于2025年2月17日14:49、2月18日09:48、13:54回访市民，均无人接听。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '垃圾清理', '主办单位': '市绿化和市容管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1739399348-2574128', '工单类型': '求助类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '环卫', '新四级分类': '环卫作业规范', '新五级分类': '清运作业扰民', '诉求地址_省份': None}
