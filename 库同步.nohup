{'工单编号': '20250201009263', '工号': '4107', '工单生成时间': datetime.datetime(2025, 2, 1, 18, 12, 57), '诉求地址': '长宁区市场监督管理局', '诉求区域': '长宁区', '内容描述': '市民来电反映:多次向长宁区市场监督管理局反映拼多多的消费问题 ，一直未处理，诉求：投诉长宁区市场监督管理局。（需回复）', '工单类别': '一般', '处理描述': '长宁区市场局于2025年2月5日接单，于2月5日9点20分通过电话先行联系并答复诉求人。告知其问题已收悉，正在我单位进行办理。由我单位网监所对诉求人所反映情况进行核实。经核实，我单位依法依规对市民的投诉举报问题进行处理，不存在处理不当的问题。我单位依法对市民的投诉进行处理，针对市民投诉的问题，拼多多平台表示无法满足市民提出的诉求，故我单位依据《市场监督管理投诉举报处理暂行办法》对该投诉终止调解。相关举报事项中，未查实到被举报人存在违反市场监管部门相关法律法规的行为。后续我局工作人员于2月5日13点34分向诉求人告知上述核实情况，诉求人已知悉。经办单位：网监所。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1738404026-2236759', '工单类型': '投诉举报类', '新一级分类': '党政机关类', '新二级分类': '党风政风', '新三级分类': '作风问题', '新四级分类': '不作为', '新五级分类': '不作为', '诉求地址_省份': None}
