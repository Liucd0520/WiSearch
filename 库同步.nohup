{'工单编号': '20250520373292', '工号': '1984', '工单生成时间': datetime.datetime(2025, 5, 20, 0, 45, 10), '诉求地址': '静安区海宁路上，圣和静安公馆北面', '诉求区域': '静安区', '内容描述': '市民来电反映：静安区海宁路上，圣和静安公馆北面，几乎每天晚上都有车辆在此处，夜间产生噪音扰民，市民不清楚是施工还是卸货，诉求：对于此处噪音来源进行核实，对于噪音扰民进行查处（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '【建管委】市民反映关于静安区海宁路山西北路交叉口处噪音扰民的相关事宜，要求查处，接报后已将该问题反馈给北横项目部。据北横项目部反馈，接到工单后，北横项目部于2025年5月25日16:25致电市民。根据市民反映情况，了解到海宁路圣和静安公馆北侧夜间施工扰民。经了解是夜间摊铺沥青路面所致，我部严格按照夜施要求，合理安排工作计划，缩短工作时间。6月3日电话联系反映人。其表示认可。事实认定：部属实、诉求认定：其他。经办人、负责人： 孙彪13584194509', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '其他噪声', '诉求地址_省份': None}
