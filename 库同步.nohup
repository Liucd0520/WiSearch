{'工单编号': '20250111010153', '工号': '2339', '工单生成时间': datetime.datetime(2025, 1, 11, 11, 33, 36), '诉求地址': '青浦区朱家角复兴路88弄4支弄151号', '诉求区域': '青浦区', '内容描述': '{正在搭建、别墅区}市民来电反映:上述地址存在违章建筑，在露台上搭阳光房，面积在60平方左右，材质：铝合金，诉求：请管理部门核实尽快拆除违法建筑。', '工单类别': '一般', '处理描述': '【此工单诉求内容部分属实】【在建违建】朱家角城运中心于2025年1月11日接单，于1月11日13:08分先行联系市民告知其问题已收悉，由我单位处理。办理情况：经朱家角拆违办核实，市民反映的朱家角镇复兴路88弄4支弄151号确实正在搭建铝合金材质的阳光房，拆违办已现场发放整改告知单。目前该违章建筑已拆除（附照片）。该问题实际解决。经办人：张荣', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': '青浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1736566207-2818147', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '城管执法', '新三级分类': '违建执法', '新四级分类': '违法建筑', '新五级分类': '新增违法建筑', '诉求地址_省份': None}
