{'工单编号': '20250607007773', '工号': 'zzpd1', '工单生成时间': datetime.datetime(2025, 6, 7, 11, 30, 5), '诉求地址': '四号线鲁班路3号口进站口', '诉求区域': '黄浦区', '内容描述': '【线路名称四号线鲁班路】今天中午11点，从家门口鲁班路四号线3号口进站，背了小双肩包，包里放了两把雨伞，其余没有任何东西，过安检时我全部拉开双肩包拉链，给安检一女的人员看，还说了就两把伞，还特地拉开了大口给她看！她却说，这包还有里面夹层…我因为赶时间所以也就不说了！随后我后面一个老太拿了几个包，那女的安检员看着她跟着我进了拉卡处逃票，这老太拿着几个大包就可以不过安检么？我包全程拉开，她还要看夹层？老太逃票不过安检却这么放过了？是啥情况？我也很无语！如图老太，身上背着包，手里都拎着几个包，就想问下你们安检的标准是什么？允许老太拿着几个包可以不安检？地铁可以跟着年轻人一起进站熟视无睹不买票？...', '工单类别': '一般', '处理描述': '已确认', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '地铁客运', '四级分类': '线路时间', '主办单位': '申通集团', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': '交通运输类', '新二级分类': '道路运输', '新三级分类': '轨道交通', '新四级分类': '地铁建设', '新五级分类': '建设规划', '诉求地址_省份': None}
