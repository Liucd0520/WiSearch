{'工单编号': '20250218021676', '工号': '3183', '工单生成时间': datetime.datetime(2025, 2, 18, 14, 17, 11), '诉求地址': '闵行区中铁十四局集团有限公司上海机场联络线2标项目部', '诉求区域': '闵行区', '内容描述': '市民反映：闵行区中铁十四局集团有限公司上海机场联络线2标项目部，项目公司已经搬走了，近日每天都有挖掘机施工，每天早上7：00就开始施工钻了，十分扰民，噪音声音非常大，严重影响周边居民休息，且工人中午吃完饭就回来继续施工钻，根本不给周边居民午休的时间。诉求：要求按照上海市施工时间标准执行施工，不要全天都在施工。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '七宝镇规建办（重大项目条线）于03月04日与来电人先行联系，并对诉求信息进行确认，告知诉求人：经核实，中铁十四局集团有限公司上海机场联络线2标项目部，该项目部临时用地属地为七宝镇联明村范围内，因项目施工结束及用地时限到期，联明村令其拆除项目部，恢复原有土地状态。就市民所反映的其在破土阶段产生的噪声，该阶段已结束，预计在本周将完成场坪回土工作，感谢您的理解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '闵行区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '公路、高架施工噪声', '诉求地址_省份': None}
