{'工单编号': '20250513035414', '工号': '4034', '工单生成时间': datetime.datetime(2025, 5, 13, 17, 17, 44), '诉求地址': '黄浦区黄家路216号', '诉求区域': '黄浦区', '内容描述': '市民来电反映:其户籍在上述地址，去领取低保的时候被街道工作人员告知被取消了，姓名：朱锡根，身份证：310102194908220054，诉求：请管理部门核实，告知低保被取消的原因。', '工单类别': '一般', '处理描述': '不属实。我街道于5月13日接单，于5月13日首次通过电话先行联系来电人，告知其问题已经收悉，正在我街道进行办理。经查，低保每月发放1595元，特困每月发放2075元，根据相关政策规定，两者补贴不能同时享受，按照救助补贴求高的原则，根据来电人实际情况，该居民在2021年12月份就由低保补贴转为特困补贴，其领取补贴至今，不存在来电人反映我街道工作人员告知低保被取消的情况，且我街道受理服务中心在5月12日上午接待过来电人，告知其享受补贴的情况，来电人反映与事实不符。经了解，来电人为朱锡根，因想要同时享受低保和特困补助无相关政策依据，故来电恶意投诉，其诉求过高。该问题已经解释说明，经办人：金一鸣', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '生活保障', '四级分类': '最低生活保障', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1747127241-591350', '工单类型': '求助类', '新一级分类': '社会管理类', '新二级分类': '民政', '新三级分类': '社会救助', '新四级分类': '最低生活保障', '新五级分类': '最低生活保障', '诉求地址_省份': None}
