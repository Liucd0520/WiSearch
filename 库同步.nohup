{'工单编号': '20250307030974', '工号': '4536', '工单生成时间': datetime.datetime(2025, 3, 7, 16, 43, 1), '诉求地址': '浦东新区航头镇航昌路上 汇仁馨苑小区门口', '诉求区域': '浦东新区', '内容描述': '市民来电反映:诉求地址有无证设摊问题，经营时间：5:00-19:00，市民表示没有城管来的话，对方就一直摆摊，该处一直无人管理。诉求：请管理部门核实情况，要求取缔。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '接单后，航头城管中队执法人员到现场查看。经查，该处航昌路上汇仁馨苑小区门口附近确有占道设摊现象，主要涉及本地老人自产自销和外来人员卖蔬菜水果。执法人员对于该处乱设摊进行教育劝离，当事人已自行整改离开。今后执法人员会加强对该处的巡查力度，做到及时发现及时处理。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1741336754-989068', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '市容', '新四级分类': '市容市貌', '新五级分类': '无序设摊', '诉求地址_省份': None}
