{'工单编号': '20250424002939', '工号': '2560', '工单生成时间': datetime.datetime(2025, 4, 24, 8, 46, 1), '诉求地址': '松江区新桥镇明中路1800弄22号201', '诉求区域': '松江区', '内容描述': '市民来电反映:松江区新桥镇明中路1800弄22号201，目前装修噪音扰民，分贝达到90左右，诉求：尽快处理扰民问题。（市民要求信息保密 需要回复）', '工单类别': '一般', '处理描述': '经松江区12345市民服务热线接单后派单至新桥镇人民政府。市民反映情况部分属实。新桥镇城运中心于4月24日先行联系，确认工单内容。居委会与物业公司上门与装修公司沟通协调，建筑公司保证在节假日不装修，工作日装修在小区规定的装修时间。居委会和物业会持续关注后续是否有装修继续扰民。2025年4月27日已电话答复市民，其表示认可。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1745455372-2497621', '工单类型': '求助类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '室内装修噪声', '诉求地址_省份': None}
