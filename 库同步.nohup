{'工单编号': '20250122004176', '工号': 'zzpd1', '工单生成时间': datetime.datetime(2025, 1, 22, 9, 20, 24), '诉求地址': '杨高南路成山路南向北路口', '诉求区域': '浦东新区', '内容描述': '【时间:2025/01/2208:32:00,涉事车辆号牌黑色特斯拉等几辆车】杨高南路成山路南向北左转路口，1月22日早上08:32到08:33左右，看到好几辆车直接实线变道从直行道切入左转车道，几乎每天都有，没看到有人管。诉求：1.路口左转道实线画的不合理，需要改成虚线。经常能看到从左边开始2号左转车道空着，但是后面很多人排队，路面利用率很低，也会导致很多车实线变道插进去2.在调整实线之前，加强路面管理，针对实线变道的车辆现场处理，减少此类行为，避免因为实线变道原因导致车祸发生', '工单类别': '一般', '处理描述': '尊敬的市民您好！该处标线已根据交警部门要求设置，请驾驶员按照标志标线指引安全驾驶。感谢您对浦东城市管理工作的理解和支持，处置单位：上海浦东工程建设管理有限公司。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': '公共安全类', '新二级分类': '公安事务', '新三级分类': '交警业务', '新四级分类': '交通管理', '新五级分类': '交通秩序', '诉求地址_省份': None}
