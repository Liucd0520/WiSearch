{'工单编号': '20250113001602', '工号': '3819', '工单生成时间': datetime.datetime(2025, 1, 13, 8, 27, 28), '诉求地址': '浦东新区高行镇政府', '诉求区域': '浦东新区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，其认为教育部门不顾进才森兰试验中学红头文件规划的的要求，私自将不属于森兰仁恒雅苑相关小区的学校，划给了森兰雅苑不合理。诉求：建议重新规划学区。最近办结的工单编号：20241219041982，工单内容：市民咨询：按照2018年浦东新区规划（红头文件），进才森兰试验中学高杰校区，是为了解决G片区居民孩子初中就读问题，批复建立的学校，然而高行镇政府副镇长顾建飞一手主导更改了区政府的规划，将新建学校授权教育局划分给了森兰H片区。近几个月来，浦东新区各级别领导都先后被查出受贿徇私舞弊等严重政治经济问题（详见附件）。诉求：请管理部门核实告知初中规划的相关信...', '工单类别': '一般', '处理描述': '市民您好：浦东教育局已收悉您反映的情况。严格按照规划服务范围划定新开办配套学校招生区域。招生地段一经划定，保持稳定。教育部门将依法保障适龄儿童接受义务教育的权利。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '入学入托', '四级分类': '入学政策', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': '科教文卫类', '新二级分类': '教育', '新三级分类': '入学入园', '新四级分类': '入学管理', '新五级分类': '学区划分', '诉求地址_省份': None}
