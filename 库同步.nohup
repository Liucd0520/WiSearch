{'工单编号': '20250515036508', '工号': '4523', '工单生成时间': datetime.datetime(2025, 5, 15, 18, 17, 22), '诉求地址': '浦东新区天健萃园北面公园', '诉求区域': '浦东新区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，小公园至开放以来电线外露，灯缺失。目前滑滑梯损坏，导致小朋友脚卡在里面，存在安全隐患。（详见附件）原诉求不变。最近办结的工单编号：20250421001131，工单内容：重新交办，要求：答复要点与实际情况不符，回复称20天内会交涉通电，但1个月过去还是没有通电（详见附件）。诉求：要求夜间开启公园灯，并告知具体通电时间。】', '工单类别': '一般', '处理描述': '上海城投兴港投资建设有限公司接单后于5月16日联系市民，经现场核实，此处电线未通电，现对外漏电线已用绝缘胶带包裹，滑梯已换新。通电问题已与市民解释该公园电力公司排线需开挖道路，现与政府部门沟通开挖道路事宜，待协商好后进行施工。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': '住房和城乡建设类', '新二级分类': '住房保障', '新三级分类': '住宅物业服务管理', '新四级分类': '物业安保', '新五级分类': '公共区域巡逻', '诉求地址_省份': None}
