{'工单编号': '20250511011755', '工号': '3819', '工单生成时间': datetime.datetime(2025, 5, 11, 13, 2, 48), '诉求地址': '浦东新区夏栎路10号401室', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址飞机噪音非常严重，房间内分贝高达6-70。诉求：投诉飞机噪音问题。', '工单类别': '一般', '处理描述': '您好!感谢您致电12345反映机场航空噪声问题,现回复如下：您所居住的区域距离浦东机场有10公里以上，一般航班在经过该区域时飞行高度较高（700米以上），但不排除有部分航班因需要临时降低飞行高度的可能。目前民航部门已经实施的飞行减噪措施是在确保符合安全运行标准的前提下，督促飞行员在1500英尺的飞行高度以下飞行器不加大马力。通过上述措施，尽可能降低噪音对周边居民的影响,谢谢您的理解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1746939549-668945', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '交通噪声', '诉求地址_省份': None}
