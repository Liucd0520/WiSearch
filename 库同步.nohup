{'工单编号': '20250227022356', '工号': '2612', '工单生成时间': datetime.datetime(2025, 2, 27, 14, 45, 15), '诉求地址': '杨浦区纪念路8号上海财大科技园', '诉求区域': '杨浦区', '内容描述': '市民来电反映:2024年12月左右市民在上述地址上海多陀体育发展有限公司悟空体育续费羽毛球培训课（非一对一），支付7000元左右，不清楚是否签订合同，学员姓名刘雨辰，现教练通知关门了，全市只剩静安区一个网点可以上课，距离太远，剩余30节课，诉求：希望管理部门核实，尽快给予解决方案（需回复）。', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，涉及健身培训和体育培训的，根据市培训市场综合治理工作联席会议办公室相关文件及市体育局关于做好体育培训市场治理工作的通知精神，明确对该事项投诉调解的法定职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1740638302-476185', '工单类型': '求助类', '新一级分类': '科教文卫类', '新二级分类': '教育', '新三级分类': '校外教育培训', '新四级分类': '体育类培训', '新五级分类': '收退费管理', '诉求地址_省份': None}
