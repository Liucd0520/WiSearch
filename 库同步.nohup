{'工单编号': '20250206026710', '工号': '4209', '工单生成时间': datetime.datetime(2025, 2, 6, 16, 53, 27), '诉求地址': '金山区山阳镇万盛金邸东区地下车库', '诉求区域': '金山区', '内容描述': '市民反映：上述小区地下车库把原先的日光灯换成了一个一个的节能灯之后照明亮度下降很多，开车视线很差，其表示设置感应装置有车和人来了提高灯的亮度没车来自动降低亮度会更好，灯也可以换成长条的节能灯，诉求：希望改善照明问题。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '核实认定情况：经物业核实：上述小区地库部分灯泡存在照明不足的现象。 处置过程和结果：目前物业公司已对地库灯泡进行排摸，针对亮度明显不足的灯泡进行更换，目前已完成更换工作。城建中心要求物业公司加强日常巡逻，在接到业主报修后，快速处置。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '金山区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': '住房和城乡建设类', '新二级分类': '住房保障', '新三级分类': '住宅物业服务管理', '新四级分类': '物业维修保养', '新五级分类': '共用设施', '诉求地址_省份': None}
