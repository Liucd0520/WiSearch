{'工单编号': '20250513009038', '工号': '4669', '工单生成时间': datetime.datetime(2025, 5, 13, 10, 23, 46), '诉求地址': '宝山区罗泾镇泾恩路京东物流', '诉求区域': '宝山区', '内容描述': '市民建议：中午可以有人摆地摊卖饭，无城管管理。晚上其作为司机就得饿肚子，好不容易等个摆地摊的来，刚吃一半饭城管就来了，摆地摊的走了 饭吃一半就要端走边走边吃，没有人性化了，现在都国家都允许摆地摊，此事情发生五月十二日21:00多了城管来了。半夜去哪吃饭都是农村，食堂关门，离镇上好几公里。诉求：建议上述地址晚上允许摆地摊。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '执法队员至该处巡查发现该处确有乱设摊现象，已教育劝阻，目前该处暂无疏导点计划，该处设摊行为违反了《上海市市容环境卫生管理条例》规定，中队将对该处加大执法巡查力度。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '宝山区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '市容', '新四级分类': '市容市貌', '新五级分类': '无序设摊', '诉求地址_省份': None}
