{'工单编号': '20250520016384', '工号': '1773', '工单生成时间': datetime.datetime(2025, 5, 20, 11, 49, 40), '诉求地址': '闵行区浦江镇联民村浦锦南路近联跃西路口近100米', '诉求区域': '闵行区', '内容描述': '市民来电咨询:闵行区浦江镇联民村浦锦南路近联跃西路口近100米设置了3个收费栏杆，其是每月都付费的，但有不愿付款的车辆就停在收费栏杆口处，导致早上有严重堵车情况，其想知道该安装栏杆收费行为是否得到审批，望管理部门尽快给予回复。', '工单类别': '一般', '处理描述': '联民村于5月20日与市民先行联系，并对诉求信息进行确认。按照相关规定，占用村宅村民共有道路或其他场地用于停放汽车的车位，其资产属于村民共有。对村民共有场地设置停车位(泊位），应由村民代表大会确定。我村现实施的停车收费方案，由村民代表大会表决，且到会村民代表全部同意通过，属于合法有效，可按规定进行收费。关于出口道闸早高峰如有车流量拥堵现象，连疆公司会打开进口道闸，方便车辆出行，或联系村委会，村委工作人员会到现场及时疏通路面交通。联民村于5月20日将解决情况答复市民，市民表示满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '公共停车场', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1747712512-2837663', '工单类型': '咨询类', '新一级分类': '交通运输类', '新二级分类': '道路运输', '新三级分类': '停车管理', '新四级分类': '场库管理', '新五级分类': '场库管理', '诉求地址_省份': None}
