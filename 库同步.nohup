{'工单编号': '20250515010517', '工号': '2883', '工单生成时间': datetime.datetime(2025, 5, 15, 10, 36, 28), '诉求地址': '杨浦区临青路430号', '诉求区域': '杨浦区', '内容描述': '市民反映：2024年2月29日购买了东方启明星的篮球课，之前的课没上完，所以新买的还没开始使用，后因小朋友不喜欢打篮球，想把课程退掉。2024年11月就和老师沟通，表示已经在走程序，结果到了现在还没有完成退费。诉求：要求退款。', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，涉及健身培训和体育培训的，根据市培训市场综合治理工作联席会议办公室相关文件及市体育局关于做好体育培训市场治理工作的通知精神，明确对该事项投诉调解的法定职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': '科教文卫类', '新二级分类': '教育', '新三级分类': '校外教育培训', '新四级分类': '体育类培训', '新五级分类': '收退费管理', '诉求地址_省份': None}
