{'工单编号': '20250611010500', '工号': '3639', '工单生成时间': datetime.datetime(2025, 6, 11, 11, 34, 18), '诉求地址': '普陀区税务局', '诉求区域': '普陀区', '内容描述': '市民来电反映:普陀区税局工作人员5月21日下午来电号码：52809339，男性工作人员，工号不清楚，不了解事实的情况，随意回复，与代开一同恶意拖到盘注销，导致不能发票红冲。诉求；望管理部门核实，投诉男性工作人员不作为。', '工单类别': '一般', '处理描述': '原2024年10月开具的租房发票是按照当时投诉人提供的材料开具的，发票信息和投诉人当时提供的材料信息一致无误。自该投诉人举报以来，前期回复时已了解实际情况并已向投诉人解释情况，其原申请开具发票信息与原提供材料信息一致，无错误开具情况。了解到纳税人反馈其原提供合同有误后，一直积极为其处理；但由于代开点关闭，申请运维处理需要等待。目前已提交运维申请，尝试通过运维处理解决。经办人：朱晓文，52809339-235，联系时间：06-11 11:06。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1749612308-2310833', '工单类型': '投诉举报类', '新一级分类': '党政机关类', '新二级分类': '党风政风', '新三级分类': '作风问题', '新四级分类': '不作为', '新五级分类': '不作为', '诉求地址_省份': None}
