{'工单编号': '20250306021354', '工号': '1973', '工单生成时间': datetime.datetime(2025, 3, 6, 14, 14, 41), '诉求地址': '虹口区海伦路300号店铺门口', '诉求区域': '虹口区', '内容描述': '市民来电反映:虹口区海伦路300号店铺门口放置灯箱光污染影响周边居民休息，诉求：希望管理部门协调关掉灯箱 信息保密无需回复', '工单类别': '一般', '处理描述': '接件后，嘉兴路街道综合行政执法队即派队员赴海伦路300号查看，店铺门前确放置灯箱。鉴于灯箱灯光影响周边居民休息，执法队员上门与店铺经营者耐心普法教育，根据相关法律规定设置户外广告设施的亮灯时间和亮度不应妨碍居民正常生活，经宣教沟通，经营者表示同意配合整改。同时执法队员要求商铺门前灯箱，晚上21时前关闭，尽量减少对附近居民夜间休息的影响。经复查，目前该灯箱已搬离。因诉求人未留联系方式，无法与其核实及反馈。（详见附件）', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '光污染', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1741241474-2568034', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '市容', '新四级分类': '景观', '新五级分类': '景观照明管理', '诉求地址_省份': None}
