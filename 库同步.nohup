{'工单编号': '20250510001938', '工号': '4786', '工单生成时间': datetime.datetime(2025, 5, 10, 8, 32, 52), '诉求地址': '金山区板桥东路888弄', '诉求区域': '金山区', '内容描述': '市民来电反映:上述地址小区的物业，业主停车不留业主的住址信息，导致车辆被堵住，电话联系不上，人找不到，故来电投诉物业，停车管理不善。诉求：望核实整顿。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '核实认定情况：经过在小区内的巡逻情况和物业公司的核实后，此情况属实。 处置过程和结果：接到此工单后，蓝色收获居委会工作人员立即和物业公司核实此情况，经过核实，此情况属实。和物业经理和保安队长交代后，在下次对保安的培训时，会着重强调外来车辆登记车牌、联系方式后才可入内。在日常的巡检当中，也会对路边随意停放的车辆进行核查，保障业主车辆顺利通行、保障消防通道时刻畅通。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '物业管理不善', '主办单位': '金山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1746836955-402656', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '住房保障', '新三级分类': '小区综合治理', '新四级分类': '停车管理', '新五级分类': '停车位使用分配', '诉求地址_省份': None}
