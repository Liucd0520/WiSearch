{'工单编号': '20250228001946', '工号': '4524', '工单生成时间': datetime.datetime(2025, 2, 28, 8, 30, 51), '诉求地址': '奉贤区川南奉公路与成大路路口', '诉求区域': '奉贤区', '内容描述': '市民反映：上述地址20:00多一直到次日凌晨2:00多有20几家无证经营者占道经营，严重影响居民生活和出行，其多次反应城管，没有人处理。诉求：请管理部门取缔无证设摊。', '工单类别': '一般', '处理描述': '经核实，该案件不属实。奉城镇于2025年2月28日接单，于2月28日下午首次通过电话先行联系来电人，告知其问题已经收悉，正在奉城镇城管中队进行办理，但未接听。2月28日下午，由奉城镇城管中队对来电人所反映的情况进行核实，并进行了现场处置（奉城镇综合行政执法中队接报后于2025年2月28日下午安排人员前往上述地点巡查，但现场未发现乱设摊情况。后续，我中队将继续开展夜间乱设摊整治行动，加强上述地点的巡查处置工作。），已经将处置结果告知来电人，该问题已经解释说明，但未接听。经办人：奉城分队，联系电话：57521880。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '奉贤区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '市容', '新四级分类': '市容市貌', '新五级分类': '无序设摊', '诉求地址_省份': None}
