{'工单编号': '20250108001502', '工号': '3324', '工单生成时间': datetime.datetime(2025, 1, 8, 8, 13, 39), '诉求地址': '青浦区赵巷镇和瑞西苑', '诉求区域': '青浦区', '内容描述': '市民咨询：小区是否有满足特定条件，减免物业费政策。诉求：请核实告知。', '工单类别': '一般', '处理描述': '赵巷镇城运中心于2025年01月09日接单。于2025年1月9日9时30分首次通过电话先行联系诉求人未果后用短信告知诉求已知悉，正在我单位办理。办理情况为：2025年1月9日由赵巷镇城建中心对诉求人反映的情况进行了核实，确认崧泽华城和瑞西苑小区是否有满足特定条件减免物业费的问题事项。办理情况为：接报后，城建中心工作人员联系小区经理了解到，上海市无相关物业费减免的政策，根据中华人民共和国民法典第九百四十四条，业主应当按照合同约定向物业服务人支付物业费。于2025年1月9日将处置结果告知来电人，诉求人对此处理结果表示满意。该问题已经实际解决。经办人:金小英。（大居分中心）', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '物业管理收费', '主办单位': '青浦区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': '住房和城乡建设类', '新二级分类': '住房保障', '新三级分类': '住宅物业服务管理', '新四级分类': '物业收费', '新五级分类': '物业费', '诉求地址_省份': None}
