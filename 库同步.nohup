{'工单编号': '20250530004310', '工号': '3273', '工单生成时间': datetime.datetime(2025, 5, 30, 9, 21, 54), '诉求地址': '闵行区江桦路669弄', '诉求区域': '闵行区', '内容描述': '【重新交办，要求：前件答复市民要点与实际不符，小区西北角变电站东侧乱堆杂物，西侧堆放建筑垃圾当天未清理，导致扬尘，市民告知小区是有建筑垃圾厢房的，诉求：请管理部门核实，要求禁止在此堆物和建筑垃圾。最近办结的工单编号：20250512047322，工单内容：市民来电反映:江桦路669弄小区的建筑垃圾没有做到当天清运，诉求：要求当天堆放当天清运。（市民要求信息保密，无需回复）】', '工单类别': '一般', '处理描述': '缦云华庭居委筹备组于6月5日对诉求信息进行确认。经现场查看，未发现建筑垃圾超高堆放及清运不及时等情况，同时询问第三方清运公司，表示建筑垃圾做到每日清理（满一车就清理），同时现场会在建筑垃圾清运时进行喷淋工作减少扬尘的出现。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '环境垃圾', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1748567762-328789', '工单类型': '投诉举报类', '新一级分类': '住房和城乡建设类', '新二级分类': '绿化市容', '新三级分类': '环卫', '新四级分类': '垃圾管理', '新五级分类': '建筑装修垃圾', '诉求地址_省份': None}
