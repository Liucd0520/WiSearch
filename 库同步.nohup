{'工单编号': '20250509043719', '工号': '3831', '工单生成时间': datetime.datetime(2025, 5, 9, 22, 18, 37), '诉求地址': '普陀区中山北路白兰路', '诉求区域': '普陀区', '内容描述': '市民来电反映:普陀区中山北路白兰路，该处中山北路地面道路在施工 ，最近22:00之后都在施工，2025年5月9日噪音特别大，影响市民休息，诉求：要求尽快整改，不要夜间噪音扰民 （市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '普陀区架空线入地指挥部于5月12日接单，由于反映人未提供联系方式，故以书面告知。根据《上海发布[2024年上海市重大工程清单公布]的通知》文件精神，全市架空线入地工程属于市重大工程。该处正在实施中山北路架空线入地工程中电力排管施工，对于给居民造成影响表示抱歉。为配合交通，市交警只允许在夜间施工，已办理夜间施工许可证。区指挥部已督促后续施工单位尽量做好文明施工管理，督促其将噪音较大的工序避开居民休息时间实施，做好降噪措施，并督促施工单位加快进度。 经办人：沈朱杰52564588，附夜间施工证。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1746800021-2493968', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '夜间施工许可', '新四级分类': '夜间施工行为', '新五级分类': '夜间施工投诉', '诉求地址_省份': None}
