{'工单编号': '20250420023557', '工号': '4478', '工单生成时间': datetime.datetime(2025, 4, 20, 17, 51, 56), '诉求地址': '静安区广延路350弄', '诉求区域': '静安区', '内容描述': '市民来电反映:上述地址小区在做美丽家园，周末施工敲打声音很大，严重扰民。诉求：请管理部门核实并协调周末不要施工。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '【房管局】经核：上述小区正在进行“美丽家园”改造项目。来电人所述施工行为，施工单位并未违规。施工时间及作业方式均符合相关管理规范要求。现鉴于市民反映情况，我局已督促现场管理部门合理安排施工时间并采取降噪措施，对于有较大噪音生成的相关作业适当延后或错峰实施，双休日和节假日尽量不采取有较大噪音的作业施工，尽最大程度上保障居民的正常休息。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1745142511-607764', '工单类型': '投诉举报类', '新一级分类': '环境与资源类', '新二级分类': '生态环境', '新三级分类': '环境污染', '新四级分类': '噪音污染', '新五级分类': '其他噪声', '诉求地址_省份': None}
