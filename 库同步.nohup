{'工单编号': '20250430030743', '工号': '1905', '工单生成时间': datetime.datetime(2025, 4, 30, 16, 41, 39), '诉求地址': '浦东新区德州路300弄5号到13号', '诉求区域': '浦东新区', '内容描述': '市民反映：高勇亮队长到任后各种不公平事件频繁发生，高队长同事对唐懿斌执法态度差，威胁残疾人破坏绿化拿走钻头等，不调查记录仪，反而问投诉人要证据，对5号到13号天井后区域为绿化地带称消防通道，通道上违建无视，对所有敲除承重墙的违法人员一律不开门回复，诉求：建议更换有能力的队长。', '工单类别': '一般', '处理描述': '接报后，城管上钢中队立即派执法队员到现场进行查处。经查，投诉人反映“高勇亮队长到任后各种不公平事件频繁发生，高队长同事对唐懿斌执法态度差，威胁残疾人破坏绿化拿走钻头等，不调查记录仪，反而问投诉人要证据”的事项，反映情况与事实不符，执法队员唐懿斌到现场查处投诉人即当事人破坏其居住地德州路300弄13号101室天井围墙的行为，并对其立案查处，案件序列号：202523000312，并无投诉人所述“执法态度差，威胁残疾人破坏绿化拿走钻头等”的情况；投诉人大量投诉小区内敲除承重墙的事项，执法队员均进行核实和跟进，存在有居民不配合不开门的情况，并非投诉人称“对所有敲除承重墙的违法人员一律不开门回复”...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '城管执法', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': '住房和城乡建设类', '新二级分类': '城管执法', '新三级分类': '违建执法', '新四级分类': '违法建筑', '新五级分类': '政策咨询及工作建议', '诉求地址_省份': None}
