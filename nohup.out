024年1月份短时间产生了10元钱的流量费。关联手机号。13621901778。诉求：要求市民的剩余流量结转到1月份，免除新产生的10元钱流量费。', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': '上海移动通信公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704080160-268882', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101005892, '工号': 2890, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 42, 51), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其是消费者，通过拼多多平台买窗帘，可以转接拼多多专席。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704080433-3083747', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101005932, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 46, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其看病扣的都是其医保账户钱，没有扣统筹钱。  ', '工单类别': '一般', '处理描述': '转接医保老师答复成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704080608-269025', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101006002, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 46, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其在“支付宝”APP上借了一笔钱，备用金用完之后，到合伙人自动还款，总保额和那个扣款金额不一样。', '工单类别': '一般', '处理描述': '根据《关于第三方支付公司的监管部门》答复，归档。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704080641-3083813', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101006092, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 49, 34), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None