类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007612, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 12, 17), '诉求地址': '松江区', '诉求区域': '松江区', '内容描述': '市民来电反映:其是松江区车墩镇长溇村815号居民，使用的是长城宽带，宽带号码：18656372347，市民称宽带于2023年12月30日出现故障，市民报修，现在维修师傅称外部线路损坏，要市民自己支付费用维修，市民不认可，其表示其购买的是宽带服务，设备线路应该由长城宽带负责，为何要其支付费用，故来电投诉，诉求：要求长城宽带尽快把其的宽带维修好，市民拒绝支付费用。（需回复）', '工单类别': '一般', '处理描述': '用户网络已处理', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '故障报修', '主办单位': '上海长城宽带公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704085627-270474', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007792, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 13, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704085971-526729', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007742, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 15, 42), '诉求地址': '徐汇区老沪闵路1055弄31号101室', '诉求区域': '徐汇区', '内容描述': '市民来电反映:其为上述地址居民，小区内自己家里种了十几年的树，现在小区改造就肆意破坏树木，对于业主也没有任何说法，现在物业电话也打不通，诉求：希望管理部门协调尽快处理给予合理说法。', '工单类别': '一般', '处理描述': '凌云街道舒乐居委收到市民反映事项后，凌云街道舒乐居委于1月2日9时15分先行联系市民，告知诉求已收到，请市民保持通讯畅通。1月12日19时38分舒乐居委通过物业了解到，居民种植在外面的树木已帮助居民移栽至规定区域，并与工程队沟通，工程队答应双休日施工减少噪音。并向物业和业委会告知对待居民要保持和善的态度，避免矛盾升级。舒乐居委于1月04日15时12分答复市民，对此市民表示认可', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '徐汇区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704085838-526682', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007702, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 16, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:1月1日其乘坐12:26发车的405路公交车，从曲阳路玉田路终点站到杨浦区合生汇，一个来伊份的购物袋落在车上，诉求：请管理部门核实，协助找回丢失的物品，将物品放在405路曲阳路玉田路终点站调度室，其可以自己去取。（需回复）', '工单类别': '次紧急', '处理描述': '经核实，情况属实。联系到市民时，市民表示已寻回失物。市民对于本次回复市民未评价。2024-01-03（16:38）用座机联系反映人：55786071', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '物品遗失', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704085747-3085356', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007902, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 19, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704086249-526809', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007912, '工号': 4260, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 20, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:有副眼镜遗失在咖啡店里，咨询咖啡店联系电话，希望帮忙找回。', '工单类别': '一般', '处理描述': '非受理范围，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704086181-526793', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007652, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 24, 2), '诉求地址': '浦东新区唐龙路1169号洛克西希公寓', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民是上述地址公寓的住户，该公寓的电费是物业收缴的，可按照1.2元一度电计算，询问电力局被告知按照合同上签署的价格交纳，可是市民签署的合同中没有电价价格情况，故来电。现诉求：望管理部门查实，协调处理该物业乱收费情况（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '唐镇市场所接报后，经核实，反映事项仍在调查处理中，因市民热线工单办结时限已到，予以阶段性办结，已告知投诉人，待最终办结后再予以告知。其表示未评价。（因录音设备故障，无法提供，已报备。）', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704085638-526606', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007982, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 24, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:如何办理准生证。', '工单类别': '一般', '处理描述': '根据《如何办理准生证？》解答，归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704086561-270795', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008062, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 25, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:韵达快递公司（浙江-江苏）', '工单类别': '一般', '处理描述': '建议向当地进行申诉。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704086659-526941', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007922, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 28, 44), '诉求地址': '本市 虹桥高铁站', '诉求区域': '本市', '内容描述': '市民来电反映:反映出租车（车牌号沪HW1519）拒载。市民一行人四人在虹桥高铁站拦车，因人没有凑齐，调度员让市民往前走，正好这部车在旁边中间，因为市民一行人有人晕车，市民向调度员提出安排油车。正好这部车也是油车。但上车后司机怀疑市民故意挑车，而且可能得知市民的目的地不远，就发脾气下车并把车钥匙拔掉了。市民要求投诉该车拒载，拨打96822发现这部车并不是大众车。市民可以提供该车的收款码信息。诉求：请管理部门核实该车的营运资格，对车辆拒载的行为进行处理。', '工单类别': '一般', '处理描述': '经核实，情况属实，有责投诉，该事件执法四大队已介入处理，并给予该驾驶员开具处罚单，公司与1月2日15：48、1月3日13：37、1月4日11：14拨打乘客电话均未接听，无法进行进一步沟通，现报总队备案。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704086331-2303370', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008102, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 29, 52), '诉求地址': '盒马奥莱闵行浦江店', '诉求区域': '本市', '内容描述': '市民来电补充信息。市民补充信息内容：专员和其联系，表示补偿市民20元券，但对于市民提出的为何取消订单的问题避而不谈，并直接挂机。【最近派发的工单编号：20231230021808，工单内容：市民来电反映:12月30号17:37其通过上述购买东西，价格：23.73元，订单号：4032840061306129017，用13636385561号码订的。网上显示送达时间是18:00—19:00。但工作人员擅自取消其订单。其和盒马联系沟通，但未处理此事。市民诉求:希望管理协调盒马给予擅自取消其订单的合理解释。并告知盒马取消订单，什么情况下，是选择的“其他”选项（需回复）。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231230021808，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704086813-526989', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008022, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 30, 54), '诉求地址': '黄浦区社区医院', '诉求区域': '黄浦区', '内容描述': '市民来电反映:其是重残人员，到社区医院就诊时，直接通过医院机器进行民政结算，但是这个设备机器一直坏，不能结算，诉求：请管理部门核实要求尽快维护直接对接结算。', '工单类别': '一般', '处理描述': '经与黄浦区各社卫办公室沟通得知，经排查医院结算设备运行正常，可能是民政信息接口问题导致无法进行民政结算，建议市民向民政反映该问题。黄浦区卫健委 张中玮', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '卫生信息', '四级分类': '社区卫生服务', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704086627-270825', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008192, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 33, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:把机动车停在龙华路2502号旁边了，现在要离开时发现车被锁在里面了，门关了无法打开，联系物业表示不清楚是属于哪里的。', '工单类别': '一般', '处理描述': '建议市民联系派出所，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704086908-2303548', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008282, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 37, 56), '诉求地址': '虹口区宝山路625号601室', '诉求区域': '虹口区', '内容描述': '市民来电反映:【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,市民称问题越来越严重，问题也没有解决，市民希望管理部门给到确切的处理时间。最近办结的工单编号:20231126004793，工单内容:【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,业委会有请业主签过字，但至今没有任何进展，其家的墙体发霉越来越严重。诉求：请核实并尽快落实维修。最近办结的工单编号:20230912010784，工单内容:重新交办,要求：按答复要点告知市民,市民表示答复要点不符，物业承诺的8月中维修，根本没有动作。诉求：原诉不变。最近办结的工单编号:，工单内容:重新交办，按答复市民要点...', '工单类别': '一般', '处理描述': '承办部门处理情况：经查：金宝小区宝山路625号由润美物业管理，中心联系小区业委会得知：为了修复宝山路625号墙面渗水问题，金宝小区业委会联合小区润美物业对该楼栋是否修复墙面于2023年11月16日-11月30日开展征询工作，业委会和物业工作人员上门对业主进行征询时，很多业主以自己家没有渗水的理由拒绝参与征询工作。故而参与的业主基数低于该楼栋业主的三分之二，根据《民法典》278条相关内容，征询工作失败。故而修复墙面的问题暂时停滞。然一些家中有渗水的业主已经被此情况困扰已久，中心工作人员于1月2日到达小区与业委会和物业进行了沟通，业委会和物业负责人表示：这段时间正在对那些不肯做征询的业主进行...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704087357-271088', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007882, '工号': 2820, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 38, 41), '诉求地址': '宝山区逸仙路安汾路交叉口北200米 悦樘公寓', '诉求区域': '宝山区', '内容描述': '市民来电反映:投诉上述地址的公寓，其没欠房租情况下私自断水断电，公寓整体管理混乱。诉求：投诉公寓管理不善。', '工单类别': '一般', '处理描述': '我办接单后于2日9点6联系市民，经联系市民表示目前上述情况已经恢复了。如市民对公寓管理不满也建议拿着双方签订的合同进行协商处理。已联系市民。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '物业管理不善', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704087199-2303642', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101007962, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 38, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:淘宝购买了一个一万毫安的充电宝，宣传为苹果授权生产销售的，实际根本没有一万毫安，商家说给市民补发一个 还是同样的情况，市民和平台反映，让市民先将一个充电宝退回去，询问如何处理。', '工单类别': '一般', '处理描述': '建议联系商家所在地，市民认可故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704087065-2303609', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008352, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 41, 7), '诉求地址': '浦东新区航头镇沉香路呈祥港路交界口', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址有一个公共停车场，大概有15个公共停车位。现在有一个停车位被人私装了地锁导致无法停车。诉求：请管理部门核实处理。', '工单类别': '一般', '处理描述': '接单后，我村工作人员现场确认，上述地址沉香路呈祥港路交界口 有一个公共停车场，有一个停车位被人私装了地锁，经核实，该停车场是方便沉香村本村16组村民家中无法停车而设立的便民停车场，因有个村民家正在建房，无法在家停车，所以自己装了一个地锁方便两辆车的临时停车，建房完成后，会自行处理掉；后续我村会做好监督工作，跟进此事；感谢市民对我们的理解和支持，谢谢！', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '公共停车场', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704087295-2303670', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008332, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 43, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:个人如何进行残疾评定 ', '工单类别': '一般', '处理描述': '根据《各区残联地址、电话联系表》告知市民，市民认可，故归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '残联', '三级分类': '残联', '四级分类': '残疾鉴定', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704087441-2303713', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008362, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 43, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其在公司摔了一下脚扭了，其查到工伤认定所需材料工伤认定申请表与用人单位存在劳动关系和医疗诊断证明，现市民询问医疗诊断证明是否就是ct报告和核磁共振报告。', '工单类别': '一般', '处理描述': '根据《工伤认定  》告知市民，市民认可，故归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '工伤', '四级分类': '工伤认定', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704087532-2303734', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008722, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 46, 10), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704087930-527322', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008302, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 46, 12), '诉求地址': '长宁区北渔路125弄21号201', '诉求区域': '长宁区', '内容描述': '市民来电反映:其是101住户，201卫生间、厨房间功能互换，马桶在漏水，导致101厨房间渗水，水很臭，且油烟管道被堵住，家里油烟排不出去。201厅里的承重墙敲了，市民家天花板有裂缝。诉求：201卫生间、厨房间功能互换，厅里的承重墙敲了，希望督促恢复原样', '工单类别': '一般', '处理描述': '新泾镇综合行政执法队于2024年1月2日接单。经中队事实认定为部分属实，诉求认定为诉求合理合法。1月2日10时30分首次通过电话先行联系来电人，告知其问题已收悉，正在我单位进行办理。1月5日上午，执法队员赴现场进行检查。经查，北渔路125弄21号201室于10余年前装修完毕，目前为房屋产权人自住，内部确实将卫生间与厨房互换了位置。执法队员于现场未能判断是否存在承重结构遭到损坏。执法队员已向房屋产权人开具《谈话（询问）通知书》，并于1月12日与当事人通过电话进行了沟通，当事人表示其近期有装修意愿，同意在装修过程中进行整改。关于漏水问题，执法队员已经与来电人进行沟通，安排于春节之后由物业上门...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '结构改建', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704087351-2303691', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008602, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 52, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:如何获取公积金冲还贷的流水。', '工单类别': '一般', '处理描述': '转接公积金专席,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704088176-2303945', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008632, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 55, 18), '诉求地址': '虹口区乍浦路北海宁路', '诉求区域': '虹口区', '内容描述': '市民来电反映:2024年1月1日13:52，上述路段有个剧组将北海宁路封掉了，导致上述路段拥堵严重，对方也没有任何报备的证明，市民不知道那个剧组，诉求：望管理部门核实并尽快予以整治。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '虹口交警一大队2024.1.2 16:00与诉求人取得联系，经核查，诉求人所述情况属实。胜利电影院向一大队报备过《酱园》剧组占道拍摄，持续三个月，但一大队未授权过剧组有权封路（责令过往车辆改道）。承办民警联系到剧组负责人，敦促其合法合规拍摄，不得越界。承办民警将办理结果告知诉求人，诉求人对承办民警的办理态度、效率、结果表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '排堵保畅', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704088208-271354', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008772, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 55, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民表示声音非常卡。', '工单类别': '一般', '处理描述': '建议市民重新拨打，市民挂断，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704088461-3086272', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008732, '工号': 4272, '工单生成时间': datetime.datetime(2024, 1, 1, 13, 56, 52), '诉求地址': '静安区', '诉求区域': '静安区', '内容描述': '市民来电咨询:噪音扰民管理部门电话，已告知可为市民反映，市民希望自行联系。', '工单类别': '一般', '处理描述': '根据《上海市城管执法系统联系方式》告知，市民认可，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704088358-3086231', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008782, '工号': 2820, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 0, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电补充信息，因2023年其多次反映滴滴问题事情反映到交通委在一年内没考虑到合规驾驶员的利益，诉求：投诉交通委不作为部分管理人员揽政。【最近派发的工单编号：20231214025600，工单内容：重新交办，答复要点不明确。市民表示至今为什么还在分批结算。诉求：电话解释如何处理的。工单内容：市民来电反映:滴滴平台对大量违规的网约车不做整治，仍然违规运营，向交通委反映，但是交通委根本没有处理，问题依然存在，故来电投诉交通委不作为】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231214025600，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704088598-3086315', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008952, '工号': 4080, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 2, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 其在拼多多购买了空调，订单号：231230-136954562080941，价格1840元。市民订购的空调型号是KFR-35GW，商家发货的型号是KFR-33GW，市民不认可。诉求：市民要求商家将发错的型号退回，按照订购的型号发货。（需回复）', '工单类别': '一般', '处理描述': '经拼多多平台协调，已为投诉人处理，投诉人已接受，双方协商达成一致。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704088613-3086318', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008872, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 5, 51), '诉求地址': '金山区枫泾镇', '诉求区域': '金山区', '内容描述': '市民来电咨询:其要换就医记录册，到了更换地点，发现对方关门，咨询如何处理。', '工单类别': '一般', '处理描述': '转接医保专席43781成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704088968-527632', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101008982, '工号': 1450, '工单生成时间': datetime.datetime(2024,