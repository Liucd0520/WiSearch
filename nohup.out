1632, '工号': 4292, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 33, 14), '诉求地址': '浦东新区创新中路2号线地铁站口', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其1月4日在上诉地址摆小吃摊，被城管没收，在执法过程中城管未跟市民清点物品，未签署任何通知书等，市民咨询执法依据也为给其答复。没收时将市民的家门钥匙也一并收走。诉求：希望管理核实处理暴力执法行为并尽快归还市民钥匙。', '工单类别': '一般', '处理描述': '唐镇城管中队接报后，经核实，投诉人为设摊人员，根据《上海市市容环境卫生管理条例》第二十一条第一款：单位和个人不得擅自占用道路、桥梁、人行天桥、地下通道及其他公共场所设摊经营、兜售物品以及堆放物品，影响市容环境卫生。我中队执法人员依法暂扣经营工具，执法过程中不存在暴力执法行为，且未没收过市民家门钥匙。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '城管执法', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704425092-2169236', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105011802, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 34, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其12月26日通过12123提交了一个机动车转籍申请，一直在审核中', '工单类别': '一般', '处理描述': '转接车管所成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704425303-131302', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105011652, '工号': 2890, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 34, 11), '诉求地址': '黄浦区复兴东路、光启南路、中华路、金坛路、巡道街、面筋弄', '诉求区域': '黄浦区', '内容描述': '【重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符，其观察了三周，依旧发现有人在乱贴小广告，比如在中华路、金坛路、巡道街、面筋弄，其刚刚撕掉很多小广告，管理部门治标不治本，不要糊弄市民，应该电话打过去，该查处的查处，该教育的要严肃教育。请管理部门彻底整治。最近办结的工单编号：20231215016188，工单内容:市民来电反映:上述道路区域的沿街墙面、立柱、灯柱、电表箱上，最近又开始被频繁贴小广告，由于量太大，志愿者和居民来不及撕，不堪其扰。诉求：请管理部门加大整治的频率（市民要求信息保密 无需回复）。】', '工单类别': '一般', '处理描述': '局投诉中心于1月5日接单，并已移送相关单位进行核实处理。接单后，我单位立即派工作人员对上述地区进行巡查，第一时间进行清除，并安排巡查人员周六周日值班清除。对于周五清除后周六周日又返潮的，我单位已将其信息转至东门街道管理办，由其综合执法队进行执法。因来电人未留联系方式，故无联系录音。经办人，肖嘉栋。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '市容市貌', '四级分类': '广告张贴', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704425118-131167', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105011812, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 36, 46), '诉求地址': '闵行区莘庄镇西环路同仁药业股份有限公司', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述公司进行装修，疑似在拆房子。近期一直07:00开始大型机械作业，声音为冲击钻地面的声音，非常大，作业时导致周边的房子都在颤抖，严重噪音扰民。诉求：请管理部门核实，让施工方不要那么早作业，尤其针对是大型机械作业，请在08:30之后开展。（市民需要信息保密，无需回复）\n', '工单类别': '一般', '处理描述': '接报后，经核实该处该处系我司闵行区莘北路 518 号地块拆除项目，我单位严格按照法定施工时间进行施工,施工时间为早上 8:00-下午 17:00,并已控制拆除噪音,关于扬尘控制,拆除过程中,已采取喷水降尘措施,并不间断喷淋,并且优化拆除工序,确保扬尘影响降到最低。目前房屋拆除工作已于 2024 年 1 月 10 日全部完成，因市民匿名，无法告知，特此回复。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '供水热线', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704425300-864935', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012062, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 37, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:1月1日发生事故，对方电瓶车喝酒直行，市民左转被对方撞了，交警判定市民权责，市民不认可。', '工单类别': '一般', '处理描述': '告知市民参照本市有关法律规定进行行政复议、行政诉讼，工单归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通事故', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704425563-865121', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012172, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 38, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:外省市户籍如何申请新能源车牌。', '工单类别': '一般', '处理描述': '根据《新能源汽车专用牌照申领“一件事”上线啦》解释，市民认可，归档。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '改革规划', '四级分类': '新能源汽车', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704425689-2169691', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012262, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 42, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:韵达快递公司（收件地湖州）', '工单类别': '一般', '处理描述': '建议向当地进行申诉。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704425989-2169915', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012462, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 43, 37), '诉求地址': '宝山区白荡河路201弄23号602室', '诉求区域': '宝山区', '内容描述': '市民来电反复催单。请管理部门尽快处理。【最近派发的工单编号：20240104011481，工单内容：市民来电反映: 其通过上海爱你住物业管理有限公司租赁上述房屋已经退租但是押金3600元未退，诉求：希望督促尽快退款（需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240104011481，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '租赁管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704425899-2169849', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012442, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 43, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:京东商城购买的商品不发货。', '工单类别': '一般', '处理描述': '当事人无法提供被诉公司信息，建议联系北京相关部门，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426074-2169973', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012552, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 46, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:是否是青岛市民热线。', '工单类别': '一般', '处理描述': '告知市民不是可加拨区号拨打，市民认可，故归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '机关事务管理', '三级分类': '机关事务管理', '四级分类': '机关事务信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426243-2170087', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012572, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 46, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426273-131988', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012092, '工号': 3662, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 48, 4), '诉求地址': '徐汇区', '诉求区域': '徐汇区', '内容描述': '市民来电咨询:市民上海医保，退休人员，现在去配药，告知需要自费600多元，不清楚是其医保余额是否没有了（已告知随申办三金账单），市民表示不清楚该如何查询医保明细，诉求：请管理部门核实后告知电脑端或者手机上如何查询医保明细记录，没有的话建议增加查询渠道。', '工单类别': '一般', '处理描述': '2024-01-05 16:26:23 先联市民，2024-01-12 08:54:13 联系市民，市民表示已查询到信息，此工单办结。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '医疗保险', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704425631-2951454', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105010262, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 48, 53), '诉求地址': '闵行区颛桥镇田园物业公司', '诉求区域': '闵行区', '内容描述': '市民来电反映:   上述物业说超过半个小时停车收10元，价格乱收费，也没有公章。诉求：请管理部门核实处理，整治不合规操作。\n\n', '工单类别': '一般', '处理描述': '田园物业于2024年1月8日与来电人联系，并对诉求信息进行确认。经现场查看，1月5日，来电人在贵都新村停车32分钟，门卫问其收取10元停车费，来电人与保安发生冲突，车辆堵门，人躺在地上，110和120都到现场。贵都新村小区门口张贴明显的临时停车收费标准，0.5小时-1小时收费10元，该收费标准由小区业委会制定，我公司是按照收费标准执行，不存在违规。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '乱收停车费', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426260-131980', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012412, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 50, 3), '诉求地址': '浦东新区周康路28号2501-7室', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址公司虚假宣传、做欺骗性的广告。宣传玩游戏可以赚钱，到一定额度可以提现，但实际根本无法提现。公司名称：上海日游网络科技有限公司。诉求：投诉该公司虚假宣传。（需回复）', '工单类别': '一般', '处理描述': '经查，举报所涉及的“公社斗地主”实际运营方为上海派宝互娱网络科技有限公司，注册地为嘉定区，非本局管辖范围，未发现上海日游网络科技有限公司存在违法行为，故不予立案。建议向当地市场监管部门反映。01月11日短信回复。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426019-865457', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012652, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 53, 29), '诉求地址': '静安区延安中路829号 达安广场', '诉求区域': '静安区', '内容描述': '市民来电反映:市民是延安中路829号达安广场小区的居民，通往小区的这条弄堂属于公共的弄堂，因为进入弄堂内可以通往达安广场、陈鹤琴小学、以东浩兰生、锦延大楼、东方海外大厦，为此在早高峰以及晚高峰，这条弄堂内车辆次序非常乱，因为有接送孩子上下学的，还有进出单位上下班的车辆，为此经常导致因进出车辆次序问题引发争吵，为此市民来电反映。诉求：希望南京西路街道牵头派人来处理该处弄堂内停车次序混乱的问题。', '工单类别': '一般', '处理描述': '【南京西路街道】留作参考；我街道于1月5日15点34分与市民进行先行联系，告知工单收悉，将派给职能部门进行核实处理。根据市民提出的建议，经了解，居委已经约请了派出所，城运中心，城管等相关部门现场勘察，对该路段停车进行合理调整，规划。下一步，居民区党总支将牵头派出所，城运中心，城管，达安广场，锦延大楼，陈鹤琴小学等多家单位共同协商最新治理方案，恢复该路段的安全稳定。我街道将上述处理情况已通过电话与市民进行说明，市民表示知晓。无其他情况说明。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '纠纷协调', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426338-2951931', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012782, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 54, 49), '诉求地址': '浦东新区宣桥镇南六公路99弄17支弄59号 （枫丹居委）', '诉求区域': '浦东新区', '内容描述': '市民来电反复催单，管理部门未进行回复，市民情绪激动，通话中扬言要出人命，安抚认可，诉求：望管理部门核实并尽快予以回复。工号2960于2024年1月5日11:54拨打22022580，工号373要求推送。【最近派发工单号：20231222030742，工单内容：市民来电反映:该处居委领导不作为，居委拆除了其家阳台违法搭建，但对该处69号北面，92号，65号与105号违法搭建都未管理拆除，市民怀疑居委与上述居民有关系，现诉求：望管理部门尽快查处给予处理答复。】', '工单类别': '一般', '处理描述': '11:57致电浦东新区人民政府对方老师知晓，已电子催单，此单归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426554-865826', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105013302, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 55, 9), '诉求地址': '无', '诉求区域': '本市', '内容描述': '已再次来电，20240105012794', '工单类别': '一般', '处理描述': '已再次来电，20240105012794', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426283-131991', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012902, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 56, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【重新交办，按照答复要点告知市民，市民表示答复要点与实际情况明显不符，不符的内容：市民有按照答复联系了62659352，但对方称还是无法退还押金，也没有告知什么时间能退还押金。市民诉求：希望管理部门核实让锦江出租车公司尽快退还押金。最近办结的工单编号: 20231218013179,工单内容:市民来电反映:其在锦江出租车公司开出租车，当时交了1万元押金，现在已经不做了，但公司一直不退押金。市民诉求：希望管理部门核实要求锦江出租车公司尽快退还1万元押金。】', '工单类别': '一般', '处理描述': '经核实反映情况不属实，根据锦江出租公司退工流程，审核流程还未结束。1月8日9日车队多次电话联系反映人，电话无人接听，故无法告知核实结果。如反映人需了解详情请电话联系锦江出租三车队主管王先生：021-62650252.', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426685-865922', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105013312, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 57, 13), '诉求地址': '浦东新区凌兆路500弄11号602室', '诉求区域': '浦东新区', '内容描述': '市民反映：其是凌兆路500弄的业主，最近购买了一台新能源车，想知道后期需要安装个人充电桩的话需要向物业提交哪些材料。诉求：请管理部门告知相关信息。', '工单类别': '一般', '处理描述': '您好，经东明路街道建管中心核实，根据《上海市居民小区电动汽车充电设施建设管理办法》第三章第八条之规定，居民在建设安装自建桩前，应当书面告知物业服务企业。自建桩建设在全体业主共有停车位上（有效租赁期一年（含）以上）的，须经业主大会或者业主大会授权的业委会同意确认后实施。感谢您对我们工作的理解和支持！', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '改革规划', '四级分类': '新能源汽车', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105013032, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 57, 34), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:登记证书丢失，要办理沪C转大牌，询问如何处理。', '工单类别': '一般', '处理描述': '根据“ 办理机动车（需进交易市场）辖区内转让手续 ”告知市民，市民认可，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426881-2170516', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105013122, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 57, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:在上海工作的，缴纳社保的那个记录如何查询。', '工单类别': '一般', '处理描述': '转接人力成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426976-2952359', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105012882, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 5, 12, 0, 11), '诉求地址': '闵行区华漕镇靠近朱建路芳乐路（南山前湾拾缦）', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述房屋还未交房，市民发现阳台和客厅中间的墙与原来的图纸不符。图纸上不是钢筋混凝土，但实际造成了钢筋混凝土结构，等于是无法改动了。诉求：希望管理部门帮助，督促发开上整改。', '工单类别': '一般', '处理描述': '1月5日我单位收到信访人反映的问题，经核实，该部位为钢筋混凝土构件，非未按图施工问题，已电话告知信访人，信访人反映合同中图纸与实际不一致，已告知其通过工商部门或司法途径解决。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426659-132241', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105013252, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 5, 12, 2, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704427149-132574', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105013142, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 5, 12, 2, 33), '诉求地址': '浦东新区高桥镇西星村高沙滩16号（市民认可）', '诉求区域': '浦东新区', '内容描述': '市民来电反映:在高桥邮局订的报纸没有送到，诉求：尽快配送', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '邮件邮递', '主办单位': '邮政公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704426995-2952377', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105013362, '工号': 3802, '工单生成时间': datetime.datetime(2024, 1, 5, 12, 3, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704427351-2952596', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None