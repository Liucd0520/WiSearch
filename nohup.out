e, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106006752, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 6, 10, 57, 3), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多上买到了问题产品。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704509717-202424', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106006312, '工号': 4330, '工单生成时间': datetime.datetime(2024, 1, 6, 10, 58, 10), '诉求地址': '松江区洞泾镇城隆路百尧村路路口', '诉求区域': '松江区', '内容描述': '市民来电反映:上述地址为施工地，2024年1月6日05点就开始施工，噪音扰民，市民表示该工地属于无证施工，并且已投诉，城管到后有停工，城管走后又开始施工了。诉求：请管理部门核实是否是有证施工，如有证请降低施工噪音，尽量避开休息日施工；如无证请查出。（市民要求信息保密 需回复)\n', '工单类别': '一般', '处理描述': '经洞泾镇分管领导签批同意，市民诉求部分属实。洞泾镇洞泾镇城市网格化综合管理中心于2024年1月8日先行联系市民，并对工单问题描述进行确认。来电人表示其反应的问题时效性已过，不用处理了。先联时也给到其城管电话：57673470，有问题来电人可直接拨打城管电话，及时反映及时处理。故直接做归档处理，不用后续再跟进。2024年1月9日电话答复市民，其表示满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704509095-202042', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106006862, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 6, 10, 58, 33), '诉求地址': '嘉定区鹤旋路42弄13号万达金街二楼小乔·Hair Salon江桥万达店', '诉求区域': '嘉定区', '内容描述': '市民反映：2023年3月在该店办理储值卡并充500元，中途用完又储值500元。2024年1月因居住地变更，与店家沟通将卡内剩余金额退还。店家表示若退卡则以往所有消费不可享受优惠，剩余的400元只能退还200元。其反问，若此时卡内只有100是否还需倒贴100退卡，商家表示是的，都是这样的。办卡、续卡时无店员告知相关规定；店内仔细环视亦无相关内容张贴，只有醒目的“办会员享优惠”。（详见附件）诉求:请管理部门协调全额退还储值卡内余额。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '双方已协商解决，投诉办结。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市市场监管局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007032, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 5, 14), '诉求地址': '杨浦区', '诉求区域': '杨浦区', '内容描述': '市民来电咨询:无房证明如何开具。', '工单类别': '一般', '处理描述': '根据《关于全市实施不动产统一登记有关事项的通告》,《不动产登记常见问题解答》告知市民，此单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '房屋产权', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704509842-2243005', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007252, '工号': 2940, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 9, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者需要转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704510452-2243366', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007192, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 9, 51), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其已经和孩子组建医保共济账户，第二个孩子加入医保共济如何办理。', '工单类别': '一般', '处理描述': '转接医保成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '医疗保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704510380-2243318', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007332, '工号': 3440, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 12, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:实习车从浦东到浦西走哪条路比较好。', '工单类别': '一般', '处理描述': '无相关信息，市民知晓，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '限流限行', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704510551-2243446', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007542, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 12, 39), '诉求地址': '浦东新区杨高中路758号', '诉求区域': '浦东新区', '内容描述': '【重新交办，要求：前件办结报告不明确，之前举报的该处违建，立案号:沪浦城管立字2020 030076号。该处违建严重遮挡居民楼的采光，举报多年，但浦东新区政府一直未执行拆除决定，也不清楚何时拆除。诉求：希望管理部门尽快拆除，并告知具体期限。最近办结的工单编号：20231122008861，工单内容：重新交办，要求：答复要点与实际情况不符。浦东新区处理的（沪浦金办立字2023第030078号）案件，按时间推算行政复议已经结束，但是至今没有执行处理决定，该地址的违建依然在使用，举报半年还没拆掉。诉求：请尽快拆违。】', '工单类别': '一般', '处理描述': '金杨城管中队立即派人查询并核实了相关立案记录，经核实，苏先生海鲜鱼庄饭店违章搭建于2023年5月4日立案：沪（浦）金办立字【2023】 第030078号进行立案调查，之后也已向其开具责令限期拆除违法建筑决定书，目前交由金杨新村街道人民政府进行强拆，金杨新村街道五违环境整治办到达现场勘察后，判定该处不满足强拆要求，已上报新区五违环境整治办，纳入缓拆点位', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007212, '工号': 3262, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 12, 58), '诉求地址': '浦东新区祝桥镇千汇路张唐港', '诉求区域': '浦东新区', '内容描述': '市民来电反映:1月16日11:00左右其路过上述地址上述河道边，看到河道内有床垫，有几个孩子坐在床垫上玩，有安全隐患，现在孩子已经上岸了。2：其也经常看到有人在河道边钓鱼。诉求：请管理部门核实并要求加强管理尽快把河道上的床垫清理掉并制止人员在河道内钓鱼（信息保密，无需回复）', '工单类别': '一般', '处理描述': '诉求人涉及河道为张唐港，河道编码pd18xz1。经河道养护作业，已将漂浮垃圾清理，暂未发现河道边有人钓鱼情况，后续落实河道养护及属地村委加强巡查监管。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '水务', '三级分类': '河道流域管理', '四级分类': '水上漂浮物', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704510410-3024844', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007352, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 12, 58), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电咨询:自己外省市户口能在上海灵活缴费吗，外省市社保能转到上海吗。', '工单类别': '一般', '处理描述': '告知市民可以灵活缴费，也可以转到上海市民认可。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704510581-2243463', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007402, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 14, 7), '诉求地址': '闵行区浦连路439弄大门', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述地址小区新陈的保安在工作时间2024年1月6日11:10左右玩手机，没有进行工作和管理，市民对此不满，故来电投诉。诉求：希望管理部门核实处理，要求管理部门开除该保安。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '浦江镇房管所于1月8日对诉求信息进行确认。经现场查看，我所已联系物业公司加强员工培训，做好本职工作，同时是否开除保安为物业企业内部行为，我所已将情况进行上报。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704510661-3025010', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007222, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 15, 29), '诉求地址': '嘉定区春荣路800弄润渡家苑', '诉求区域': '嘉定区', '内容描述': '市民来电反映:其在上述校区有固定车位，且在2023年9月正常支付固定车位一年的租金，市民告知虽然不常停车，但是停车费从来没有欠缴过，1月6日发现物业自私将其固定车位租给了其他业主，且将该固定车位的车牌号做了修改，市民不认可，就联系物业，物业没有给到任何的解释。诉求：请管理部们督促物业给到解释并向市民进行道歉，还有将原本属于市民的车位归还市民，还有将属于市民的车位车牌号予以标清楚。', '工单类别': '一般', '处理描述': '嘉定区安亭镇：接热线后，2024年1月6日13:40先行联系。经博园社区、安亭镇房管所联系安禾好物业核实，因重新划分的车位号与旧车位号不一致，导致登记信息错误。目前已更正，编号以地标为主。后续，物业进一步加强小区停车管理工作。1月9日物业经理电话联系诉求人致歉。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '物业管理不善', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704510417-2243341', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007502, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 19, 21), '诉求地址': '长宁区拼多多', '诉求区域': '长宁区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，商家称发货了，但其确实没有收到，但钱已经被平台扣除了。请管理部门尽快处理。（需回复）【最近派发的工单编号：20240105026065，工单内容：市民来电反映:其在拼多多2年前的购物订单221101198338169730047，至今没有收到，多次联系商家未果，希望管理部门给予帮助（需回复）】', '工单类别': '一般', '处理描述': '转接成功,市民反复催单，已电子催单工单编号：20240105026065，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704510854-3025113', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106005542, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 20, 39), '诉求地址': '浦东新区惠南镇川南奉公路勤奋路', '诉求区域': '浦东新区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，市民反馈之前建筑工地答应12月份发放疫情补贴，但是直到现在只发放了部分，还有十几个人没有发放，平均每人补贴5180元，请管理部门再次催促发放。最近办结的工单编号：20230223010012，工单内容：市民来电反映:22年疫情包括市民在内十几人被封控在上述工地，工地总包：上海七建，项目名称 红光村动迁房，市民称没有劳动合同但签了安全教育书，且当时公司也明确说了有补贴，并登记了名字，市民签字并按手印了，但是现在公司项目经理（吴yue）说没有，但市民看到很多其他工友都拿到了，现诉求：请核实尽快落实疫情补贴发放。\n', '工单类别': '一般', '处理描述': '接到信访后我站立即与信访人和施工单位项目负责人联系，经协调，施工单位承诺在1月底前完成疫情补助款的支付。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '疾控防疫', '四级分类': '其他', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704510942-936724', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007692, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 21, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其车被他人车辆挡住因对方没有预留电话想知道如何挪车。', '工单类别': '一般', '处理描述': '根据“12123APP“一键挪车”功能的相关使用方法？”告知挪车渠道，工单归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '排堵保畅', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704511155-936849', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007742, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 22, 3), '诉求地址': '浦东新区航头镇沪南公路5298号（子莘租赁公司）', '诉求区域': '浦东新区', '内容描述': '市民来电咨询处理进度。【最近派发的工单编号：20240106005003，工单内容：市民来电反映:其在上述租赁公司租赁了网约车，支付了3000元押金。现在不租车租赁公司不给其退押金。诉求：希望管理部门帮其协调退费（需回复）】', '工单类别': '一般', '处理描述': '已告知管理部门正在处理中，建议市民耐心等待，市民认可故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704511161-203259', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007512, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 23, 30), '诉求地址': '闵行区银都路3118弄2村30号对面', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述地址有人占据停车位，在停车位上种葡萄架，导致无法停车。诉求：希望管理部门核实，加强管理，制止该行为', '工单类别': '一般', '处理描述': '银都苑第一居委会于1月8日与来电人先行联系，并对诉求信息进行确认。经核实，物业工作人员已于1月9日将上述地址上的花盆清理完毕，但停车位上未种葡萄架。银都苑第一居委会于1月21日将解决情况答复来电人。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704511117-203232', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106007892, '工号': 4100, '工单生