上邮说其倒闭，那么具体投资邮票的事谁来接手。【最近派发的工单编号：20231220006656，工单内容：市民来电咨询:市民来电咨询:上述地址邮币卡交易中心，11月26日发公告，从11月30日后停止交易，市民不满，诉求：请管理部门核实，要求给予合理解释为何突然停止交易。市民指定要求市金融局给市民处理，和市民解释无效。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231220006656，故归档。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704678030-330296', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108005712, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 56, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704678865-540238', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108005772, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 56, 44), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多上买到了问题产品。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704678920-540289', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108005632, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 56, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:企业要做社保缴费，下载了社保费管理客户端，登入密码市民不知道是什么，有按规定输入了编码后还是不对，诉求：要求告知如何解决密码登入。', '工单类别': '一般', '处理描述': '经核实，该事项属实。 已于2024年1月9日10时联系该来电企业，告知其社保费管理客户端密码登录的操作指南。来电人表示已知晓且该问题已解决。 回复时间：2024年1月9日；问题情况：已解决；纳税人表示：满意 承办单位：杨浦区税务局（第十七税务所）', '客户类型': '企业', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '其他', '四级分类': '其他', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704678751-330979', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108005792, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 57, 15), '诉求地址': '