None, '新五级分类': None}, {'工单编号': 20240101005212, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 13, 31), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要转拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704078722-524494', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101005262, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 15, 22), '诉求地址': '闵行区', '诉求区域': '闵行区', '内容描述': '市民来电反映:车主。闵行区老沪闵路附近需要挪车，找不到车主。', '工单类别': '一般', '处理描述': '转接闵行交警成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704078747-268378', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101005272, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 17, 59), '诉求地址': '黄浦区瑞金二路瑞金医院', '诉求区域': '黄浦区', '内容描述': '市民来电反映:1月1日其到上述医院探望病人被拒，表示任何人员都不能探望，市民对此不满。诉求：请管理部门核实，要求对此情况给予合理解释。', '工单类别': '一般', '处理描述': '市民反映的问题给予如下答复：根据上级部门工作要求： 严格病房探视管理。住院部设置通道核验，是为了保证住院部的安全及病房住院病人的休养环境，避免闲杂人员在住院部往来出入，市民出示陪护证就可以进出院内，关于医院的陪护管理制度，希望市民理解并配合。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '其他', '四级分类': '其他', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704078912-268440', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101005252, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 18, 47), '诉求地址': '浦东新区方竹路423弄', '诉求区域': '浦东新区', '内容描述': '市民来电反映:充电桩电表以前的部分，物业说是开发商架构的，由物业维护，需要多收业主的停车费，诉求：望管理部门核实并尽快告知是否合理。', '工单类别': '一般', '处理描述': '居委接到热线后第一时间联系物业，物业反馈关于停车收费，前期物业服务合同上是350元/月，对新能源车目前定的租价为250元/月，符合合同内容收费。新能源车多收100元物业表示主要涉及：1、充电桩从总配电室到居民私人充电桩附近的小配电间，其中包含的建设线缆、桥架、开孔穿孔走线等成本费用。2、为方便居民充电，充电桩车采用固定停放车位与普通油车非固定停放不同。3、物业服务上：涉及到被其他车辆占用车位后 联系物业人员，由值班的物业人员及时去联系劝离。以及充电站设备引起跳闸和维修时的断闸合闸服务、保险丝或电源开关的免费工价调换服务等。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '物业管理收费', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704078950-268452', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101005342, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 19, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:728路公交车电话。', '工单类别': '一般', '处理描述': '告知65420790，认可，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '公交巴士', '四级分类': '线路咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704079068-524600', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101005482, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 23, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704079327-524689', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101005402, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 24, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民重复来电反复催单，要求尽快处理答复。【最近派发的工单编号：20231230009326，工单内容：市民来电反映:其有一个快递从上海到贵州毕节，京东：JDX022280936243，12月25日寄出，京东快递表示超出地址不配送需要加运费，现在委托第三方寄送但是现在一直放在驿站2、3天了。诉求：要求尽快针对运费问题进行处理。(要求回复)】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231230009326，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704079366-2301219', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101005492, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 1, 11, 28, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其2021年7月25日在拼多多上购买了一张流量卡，现当时的商家又给其开了2张流量卡，但市民并未授权，市民称商家盗用其个人信息开卡。', '工单类别': '一般', '处理描述': '建议市民报案，工单归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分