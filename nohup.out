 3692, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 43, 55), '诉求地址': '浦东新区青桐路18弄24号402室', '诉求区域': '浦东新区', '内容描述': '市民来电反映:每天下午15：30 -17:00左右上诉地址居民楼有老师给小朋友补课。影响居民楼正常生活秩序。诉求：要求取缔居民楼补课要求搬到外面商业性的场所。（市民要求信息保密需要回复）', '工单类别': '一般', '处理描述': '尊敬的市民，您好！您反馈的问题张江镇社发办已核实。经青桐路18弄小区属地居委会与物业多次上门核实，并未发现有在所属居民楼补课的相关情况。后续我们将继续予以关注与跟进。感谢您对我们工作的理解和支持！', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704180688-2638129', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102025362, '工号': 3940, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 44, 1), '诉求地址': '浦东新区龙阳路百安居', '诉求区域': '浦东新区', '内容描述': '【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,其表示市民要求主管部门电话回复，但是两次投诉均未得到电话回复，且其诉求是需要尽快需要上述企业给予复工，不是其个人员工的问题。诉求：原诉求不变，需要电话回复。最近办结的工单编号:20231218013291，工单内容:重复交办，要求：答复要点与实际情况不符，其没有得到过回复，合同内承诺的也没施工，诉求：希望管理部门尽快督促恢复装修施工。最近办结的工单编号：工单内容：市民来电反映:9月14日在与上述公司了装修合同，装修地址：浦东新区乳山三村348号304室，期间很多费用市民都是直接给百安居负责市民装修的师傅，现在对方已经联系不上，...', '工单类别': '一般', '处理描述': '1月4日，已通知企业对业主自定项目之外不影响工序的其他合同内项目尽快施工完成。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704181176-601948', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102025492, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 44, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:新版社保卡开通社保功能 ', '工单类别': '一般', '处理描述': '转接成功，工号0283，归档 ', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704181313-2426366', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102024672, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 45, 15), '诉求地址': '宝山区纬地路88弄95号1102室（阳光水岸家园）', '诉求区域': '宝山区', '内容描述': '【投诉】市民来电反映:上述地址市民之前反映的保安问题。之前有大厂镇的房办来电，对于保安队长的问题，就表示市民签署过协议，物业就可以进出，该人服务态度恶劣。目前又有居委会，业委会，物业等人员再次来市民家中。市民表示如再发生此类问题就自焚。市民不愿告知其目前自己的具体地址（上述地址为前发生事件地址）。诉求：希望管理部门核实后对于房办工作人员进行处理，并要求再次处理随意进入市民房屋问题（15:41工号3852拨打了22022580，工号508受理）', '工单类别': '一般', '处理描述': '我办就之前处理情况：物业公司规范着装，入户巡查主动亮明身份，与业主做好良性沟通，端正服务态度，再次告知市民，市民表示不愿再配合物业装修巡查事宜，我办告知其作为业主，应该遵守小区的管理规定。市民情绪激动，表示不接受，并表示不要我办再来沟通。我办于2024年1月11日联系市民。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '服务态度', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704180485-2425545', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102025472, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 45, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:家庭共济医保缴费未扣费。', '工单类别': '一般', '处理描述': '转接医保成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704181396-2638819', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102025562, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 46, 19), '诉求地址': '浦东新区苗圃路公利医院', '诉求区域': '浦东新区', '内容描述': '市民来电反映: 上述医院儿科门诊和发热门诊，都要求患者抽血，抽血都要去急诊抽。三楼的门诊窗口人很少，却不让抽血，市民表示现在等着抽血的人非常多，孩子都发着烧。诉求：请管理部门给予解决方案，要求尽快加派人手，加开窗口。', '工单类别': '一般', '处理描述': '已经与患者沟通，解释三楼门诊检验科可以为孩子采集静脉血，当患者需要采集手指血时必须在急诊采集，該患者表示理解，双方达成谅解。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '排队挂号', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704181384-2638806', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102025032, '工号': 3022, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 46, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其要签署一份建筑合同，是否有规定一定要通过专户给农民工打钱。', '工单类别': '一般', '处理描述': '根据《保障农民工工资支付条例》解答，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704180808-601574', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类':