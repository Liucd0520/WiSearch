名': None, '服务类型': '综合服务', '通话编号': '1704170032-337065', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015112, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 36, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多。', '工单类别': '一般', '处理描述': '系统问题，无法转接，地方进行回拨。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170030-337063', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015222, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 39, 15), '诉求地址': '黄浦区北京东路与浙江中路交界口', '诉求区域': '黄浦区', '内容描述': '市民来电反映:2023年12月31日16:00多在黄浦区凤阳路与黄河路交界罗森便利店门口遗忘了平板电脑，品牌：苹果的，随后当天17:00多送到交警处，诉求：告知平板在哪里，到哪里去取。', '工单类别': '一般', '处理描述': '市公安局黄浦公安分局交警支队于2024年1月3日14时38分与来电人取得了联系并予以了答复。具体答复内容：当事交管系交警支队三大队二中队方凌晨（HP2278），当时他在路口执勤时收到路人上交的苹果平板电脑后，并于1月3日上午交还给失主刘先生了。刘先生表示感谢之情，并对工单的回复满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170137-2628928', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015062, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 39, 25), '诉求地址': '浦东新区临港', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:市民的孩子在杭州，转入上海上幼儿园。问条件。', '工单类别': '一般', '处理描述': '根据《 《关于来沪人员随迁子女就读本市各级各类学校实施意见》解读 》,《 2023年浦东新区适龄幼儿入园工作政策问答 》,告知，归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '入学入托', '四级分类': '办理转学', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704169832-336958', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102014982, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 39, 48), '诉求地址': '静安区寿阳路88号上海工建一建', '诉求区域': '静安区', '内容描述': '市民来电反复催单。市民诉求：望相关部门核实尽快处理。（市民要求需要回复）【最近派发的工单编号:20231221004033，工单内容:【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确，没有相关单位与市民联系协商拖欠工资问题。诉求：希望管理部门核实尽快处理发放工资。工单内容:【重新交办，前件办结报告与事实不符，要求，已告知市民答复要点，市民表示市民表示还有一部分没有过给，也没有告知时间。诉求：希望管理部门核实尽快处理发放工资。（需回复）工单内容:市民来电反映:上述建筑工地拖欠其2023年2月-5月的工资，金额：5万，与上海民祥劳务公司签了劳动合同，分包公司是苏州市太仓市良普板材...', '工单类别': '一般', '处理描述': '望相关部门核实尽快处理谢谢。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '建筑工程欠薪', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170065-2370889', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015142, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 40, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民的父亲去世，继承遗产需要出具公证并且全部继承人到场。但是市民的奶奶90岁了，恐怕不能接受市民父亲去世的消息。询问这种情况如何解决。', '工单类别': '一般', '处理描述': '转接法律专席成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '公证服务', '四级分类': '继承权公证', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704169998-592670', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015482, '工号': 3262, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 41, 17), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:需要转接拼多多，个人消费者', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170369-2629082', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015172, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 41, 19), '诉求地址': '闵行区', '诉求区域': '闵行区', '内容描述': '市民来电反映:其是企业，疫情时候是保供单位，当时的被保供方一直欠钱不给', '工单类别': '一般', '处理描述': '建议法律维权，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170093-592721', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015692, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 41, 44), '诉求地址': '静安区汶水路地铁站两侧', '诉求区域': '静安区', '内容描述': '市民反映：共享单车绵延数百米，从灵石路到汶水路地铁站，行人无法使用人行道。诉求：希望管理部门及时清运。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '【大宁路街道】我中心于2024年1月2日接单，因诉求人匿名投诉，无法做先行联系；接报后，街道城运中心及时协调社区管理办公室核实情况。经反馈，汶水路地铁周边沿线由于人流量较大导致共享单车需求较大，街道日常安排第三方市容服务队工作人员进行驻守巡查，维护街面非机动车停车秩序；街道定期约谈哈罗、青桔、美团等共享单车运营商，督促运营企业严格落实主体责任，做好路面管控和调度工作，目前街道再次联系单车企业，要求其早晚高峰及时清运过度投放的共享单车，同时在划定区域内实施日常运维和投放，确保行人通行安全。因诉求人匿名投诉，管理部门无法答复诉求人。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '共享单车', '主办单位': '静安区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015422, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 42, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多，是个人消费者。', '工单类别': '一般', '处理描述': '转接拼多多绿色渠道服务热线成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170460-2371126', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015102, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 43, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多平台165元左右的运费，一直没有退款，市民向拼多多反映，没有办法支持运费，要看条件的，付款显示七天无理由包运费退货，市民有截图作为凭证，有很多笔订单。诉求：请管理部门协调退款。（需回复）', '工单类别': '一般', '处理描述': '归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704169921-2628797', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015512, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 45, 51), '诉求地址': '黄浦区九江路128号', '诉求区域': '黄浦区', '内容描述': '市民来电咨询:上述地址医疗事务部门电话。', '工单类别': '一般', '处理描述': '根据《上海市黄浦区政务服务中心》告知，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '机关事务管理', '三级分类': '机关事务管理', '四级分类': '机关事务信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170563-2629192', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015492, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 45, 58), '诉求地址': '金山区', '诉求区域': '金山区', '内容描述': '市民来电咨询:自来水收费标准有没有变动，自来水排污费是不是有。', '工单类别': '一般', '处理描述': '1月2日12时金山区水务局与市民先行联系。1.2007年，据全市统一部署，区物价局发文《关于本区全面开征排水设施使用费的通知》（金价〔2007〕11号）。因考虑本区农村居民收入水平较低，实际并未开征。2020年，国家发改委下发《关于完善长江经济带污水处理收费机制有关政策的指导意见》（发改价格〔2020〕561号）要求，“已建成污水处理设施，未开征污水处理费的县城和建制镇，原则上应于2020年底前开征”。...', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '供水', '三级分类': '供水计费', '四级分类': '水费量高', '主办单位': '市水务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170519-2629172', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015522, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 46, 36), '诉求地址': '浦东新区板泉路2101弄2号202室', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址市民目前家里放出来的水都是黄色，水管里都是泥浆水。有向物业报修，但是物业一直没有处理。诉求：希望管理部门核实，并尽快安排人员处理，恢复正常水质。', '工单类别': '次紧急', '处理描述': '接报后，我司于1日内先行联系，现场放水后水质正常，经家中水龙头取样检测水质浊度0.355NTU,余氯0.63mg/L，水质恢复正常，就给市民造成的不便表示歉意，供水热线1月8日回访市民表示满意', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '供水', '三级分类': '自来水水质', '四级分类': '水中杂质', '主办单位': '供水热线', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170576-2629203', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015712, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 49, 17), '诉求地址': '杨浦区爱国路338弄15号102室', '诉求区域': '杨浦区', '内容描述': '市民反映：爱国路338弄龙光天境，该盘于2023年12月25日取证，12月25日下午开始交付业主。然而当业主交付后，室内远未达到入住交付标准，房修停摆，地暖等各种调试不及时安排，导致业主无法入住，存在室内部分墙体歪斜等质量问题。诉求：希望管理部门核查该项目的交付手续及材料是否齐全并符合要求，并督促开发商及时整改。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '接单后，经我中心核实，关于信访人反映的4幢15号楼102室地暖调试不及时、室内部分墙体歪斜问题，经查，建设单位已与信访人联系，相关问题已完成整改维修。 我中心工作人员于2024年1月19日10：28电话联系信访人，告知其处理情况，信访人表示认可。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '工程质量', '主办单位': '市住房城乡建设管理委', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013372, '工号': 4322, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 50, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:在飞猪平台购买上航机票，因故需要退票，联系飞猪平台，平台告知只是代收机票，具体需咨询上海航空公司', '工单类别': '一般', '处理描述': '转接上航东航绿色渠道服务热线专席成功,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '航空客运', '四级分类': '飞机票务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170720-337477', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015672, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 51, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:虹桥火车站的青泸线，分成两个线路公交车，变成的一条889线路没有之前的顺畅，北翟路非常拥堵。诉求：请管理部门恢复公交线路。（需回复）', '工单类别': '一般', '处理描述': '众兴客运于2024-01-05 15:47 联系到反映人，解释说明众兴客运根据公交最新线网优化调整将青泸线拆分为青浦32路及889路。反映人表示建议恢复原天山西路走向，众兴客运表示已收到反映人的建议，已上报至营运相关负责人及上级单位知悉，感谢反映人的建议。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '公交巴士', '四级分类': '线路设置', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704170883-337577', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015882, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 55, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是外省市参保人员要到本市看病想知道如何办理异地就医备案。', '工单类别': '一般', '处理描述': '根据“不予受理来电的处理流程”告知，市民认可，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '医疗保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704171166-2629580', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102015842, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 56, 34), '诉求地址': '松江区叶榭镇强恕小区', '诉求区域': '松江区', '内容描述': '市民来电反映:小区停车费原先是4-24小时收5元，现在翻一倍了，诉求：要求恢复原样。\n、\n', '工单类别': '一般', '处理描述': '松江区12345市民服务热线接单后派叶榭镇，经分管领导签批同意，市民建议不予采纳。接市民工单后，叶榭镇12345热线平台于1月2日与市民取得先行联系，对工单问题描述进行确认。经民兴物业反馈，民兴物业按照《松江区物业管理区域内车位收费管理办法》的相关规定标准为依据，对小区停车费用进行调整（见附件），符合收费标准。市民要求恢复原价的建议不予采纳。于1月12日已电话告知市民，其表示认可。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704171128-2371559', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016002, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 57, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:投诉美发店店员服务态度问题', '工单类别': '一般', '处理描述': '企业内部管理问题不予受理，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704171325-337837', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016012, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 0, 37), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:其孩子在外高桥读幼儿园大班上半学期之后想让孩子到临港的幼儿园读下半学期，现其听说下半学期不能转想知道是否属实。诉求：希望管理部门核实告知。（需回复）', '工单类别': '一般', '处理描述': '市民您好：浦东新区教育局，浦东新区幼儿园转学服务告示（2024年寒假）幼儿园小班第一学期不予区内转学，大班第二学期不予转学。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '入学入托', '四级分类': '办理转学', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704171324-593424', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016152, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 5, 13), '诉求地址': '浦东新区季景路333弄', '诉求区域': '浦东新区', '内容描述': '市民来电反映:自己住上述小区，2023年12月31日自己的车停在小区地下车库车位上被剐蹭，但目前该位置没有摄像头导致无法找到肇事者，认为物业有责任（自己从来没有拖欠过物业费），诉求：要求物业做出自己车辆被剐蹭的赔偿', '工单类别': '一般', '处理描述': '高桥镇阳明居委接到工单后，经核实，上海互襄物业管理有限公司告知，2023年12月31日诉求人投诉，说自己车在库里里被刮蹭，物业第一时间跟业主去车库进行了一个现场的查看，并协助业主对该区域的监控进行了调取，由于摄像头较远，能见度较低，时间较长，对所经过的车辆是否刮蹭无法辨别。经和业主协调，与2024年1月6日业主同意报警自行处理。感谢您对高桥镇阳明居委会工作的信任和支持，祝您生活愉快！（约谈回复无录音）', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704171552-2371835', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016632, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 6, 47), '诉求地址': '杨浦区江浦社区 83 街坊', '诉求区域': '杨浦区', '内容描述': '市民建议：近日，江浦社区83街坊蒋家浜九年一贯制学校项目规划设计方案正式对外公示。现在规定的反馈意见期内，就该校的选址问题，向您提出正式的书面意见反馈。问题及意见此次公示的江浦社区83街坊蒋家浜九年一贯制学校，选址距离北横通道杨树浦港废气排风塔不足200米。该风塔承担北横通道东段隧道西起海宁路热河路、东至周家嘴路双阳路，全长 6.88km隧道自西向东方向80%的废气排放，无法保证住建部对空气洁净度的要求，也无法满足上海市教委的环境适宜、远离污染源和不利于学生学习和身心健康的要求，不符合住建部和上海市教委的相关标准和要求。诉求：建议蒋家浜九年一贯制学校另行选址建设。', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派区规划资源局进行处理。据区规划资源局回复：先行联系：接单后我局工作人员电话联系来电人。情况核实：经核实，来电人反映时该项目设计方案处于公示阶段。来电人建议留作参考。我局工作人员已于1月10日致电来电人，告知来电人已记录其反馈意见，将于公示反馈意见收集截止后根据反馈情况进行统一答复。 处置过程及回访：经核实，来电人反映时该项目设计方案处于公示阶段。我局工作人员已于1月10日致电来电人，告知来电人已记录其反馈意见，将于公示反馈意见收集截止后根据反馈情况进行统一答复。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '学校管理', '四级分类': '校园设施', '主办单位': '杨浦区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016132, '工号': 3692, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 6, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704171865-2630044', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016352, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 7, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要投诉在长白山的一家民宿。', '工单类别': '一般', '处理描述': '建议向酒店所在地反映，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '旅游', '三级分类': '服务质量', '四级分类': '酒店质量', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704171847-2630032', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016332, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 9, 31), '诉求地址': '黄浦区人民广场西藏南路南京大排档', '诉求区域': '黄浦区', '内容描述': '市民来电反映:在上述地址的餐饮店有市民在室内抽烟，该商家有规定不能抽烟，服务员上前劝阻该市民仍然还是继续抽烟。诉求：请管理部门核实整治。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '您好，您对南京大排档的举报我局对当事人进行现场检查，查见当事人经营场所多处显眼位置张贴有禁烟标志，事发时当事人员工亦有劝阻，无法认定当事人存在相关违法行为，我局决定不予立案。[黄浦区市场监管局]', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '禁烟控烟', '四级分类': '禁烟控烟', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704171815-338152', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016542, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 9, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:咨询公司缴纳社保问题', '工单类别': '一般', '处理描述': '转接人社成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704172049-2630202', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016692, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 11, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:社保卡申领状态', '工单类别': '一般', '处理描述': '转接社保卡成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704172193-2372272', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016872, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 12, 5), '诉求地址': '浦东新区浦东南路595弄', '诉求区域': '浦东新区', '内容描述': '市民咨询：19号线选线已经公示了快一年了，环评也已经批复（详见附件）。作为19号线沿线居民，有以下两个问题：1、从19号线的选线公示文件来看，19号线浦东南路站的站体进入了三航小区。三航小区靠浦东南路的第一排是否会被市政征收。2、如果涉及征收，2024年是否会启动。诉求：请核实告知。', '工单类别': '一般', '处理描述': '尊敬的张先生: 您好。您咨询:19号线选线已经公示了快一年了，环评也已经批复《详见附件。作为19号线沿线居民，有以下两个问题:1、从19号线的选线公示文件来看，19号线浦东南路站的站体进入了三航小区。三航小区靠浦东南路的第一排是否会被市政征收。2、如果涉及征收，2024年是否会启动。 我司已经收悉。对于您的咨询，我司高度重视，现答复如下： 轨交19号线已立项，规划设计方案及用地范围未定，尚未具备启动征收前置条件，目前申通建设集团正在相关手续，待最终确定方案及规划设计方案后，按方案尽快启动征收程序。 感谢您的来电，祝您生活愉快。上海浦东新区交通投资发展有限公司。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '征收管理', '四级分类': '拆迁安置', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016922, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 16, 41), '诉求地址': '杨浦区控江路1700号1705室、1905室', '诉求区域': '杨浦区', '内容描述': '市民来电补充信息。市民补充信息内容为其告知每次回复都是同一拨人，现要投诉管理部门不作为，要求上级部门处理，尽快处理【最近派发的工单编号：20231230017648，工单内容：【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,其表示自己多次投诉反映，其表示走廊和卫生间墙体之间是有落水管，所以不存在现场墙体没有外移的情况，同时现场房屋已经出现了渗水和地砖碎裂的情况，其反映的问题实际都是交给了街道固定的几个人处理，而对方实际处理是存在问题的。诉求：希望管理部门核实并对现场居民墙体外移的情况予以处理。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231230017648，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '结构改建', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704172445-338631', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016732, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 16, 43), '诉求地址': '静安区芷江西路393弄5号', '诉求区域': '静安区', '内容描述': '市民来电反映:1月2日10:00多突然微信手机，无法上网，无法打电话，其71周岁，电信说其欠费没有缴费，手机号码：13331860786，现在已经恢复了，其已经到营业部付了钱，已经复机了，诉求：要求政府对电信加大监管，做法不对。', '工单类别': '一般', '处理描述': '通过', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '服务质量', '主办单位': '中国电信上海分公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704172260-594037', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016962, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 16, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:如何查询医保共济的缴费情况。', '工单类别': '一般', '处理描述': '转接医保，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704172490-338673', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102016982, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 19, 3), '诉求地址': '奉贤区', '诉求区域': '奉贤区', '内容描述': '市民来电咨询:自己要在上海奉贤区注册公司，通过随申办注册时，提交了公司名称后提示大数据不予通过，想要了解如何才能注册成功公司', '工单类别': '一般', '处理描述': '2024.0104 14：15 多次拨打电话，电话无人接听，后转接语音信箱。您好，您咨询的开办企业问题，请使用360浏览器，登陆一网通“上海企业登记在线”网站→点击"开办"→选择“我没有名称备案号，且经营范围不涉及前置审批事项”→账号登录（实名注册登录）→填写名称→填写登记信息（登记机关、地址、股东、经营范围、注册资本等）→填写就业参保信息（若不想填，请勾选“本次不需要办理就业参保”） →填写公章预约 →填写办税人员 →填写银行预约开→提交开办。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704172537-2372592', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102017022, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 21, 15), '诉求地址': '宝山区菊联路589弄', '诉求区域': '宝山区', '内容描述': '市民来电咨询:上述地址小区门口其要求加设斑马线，管理部门告知小区门口左边和右边都已经有斑马线了，按照国家规定100米以内不能再加设斑马线，随后商量把停车位给拿掉，诉求：请管理部门告知何时来操作此事。', '工单类别': '一般', '处理描述': '宝山分局交警支队勤务路设大队于2024年1月3日15时07分与来电市民先行联系，了解情况。2024年1月4日10时与来电市民再次取得联系，答复告知其：为确保菊联路589弄小区出入口进出车辆通行安全，支队已协调相关养护单将小区出入口西侧第一个停车位取消。同时建议小区居委协调相关部门在出入口增设凸面镜和其他安全设施，消除驾驶员视线盲区、提醒来往车辆。市民对答复表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通设施', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704172615-2372648', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102017032, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 21, 19), '诉求地址': '徐汇区复兴中路1295弄9号2楼（没有几零几室)', '诉求区域': '徐汇区', '内容描述': '市民来电反映:其拨打962121反映卫生间漏水问题，是洗手间内淋浴房进水阀门口漏水，漏水时间是2024年1月2日早上，物业来看过，表示不修，让其自己找人修，其不认可，要求核查处理，尽快维修进水阀门口漏水的问题。（需回复）', '工单类别': '一般', '处理描述': '居民自改淋浴房，自排水管，居民自修', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704172618-594306', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102017172, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 21, 31), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:请管理部门告知网络预约出租汽车到三年要续办是办理成功，是否需要到线下拿取证件。（需回复）', '工单类别': '一般', '处理描述': '2024/1/2 13:46 联系反映人，告知相关延续工作。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704172723-594383', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 2024