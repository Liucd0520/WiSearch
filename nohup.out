e, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105001642, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 38, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要开通激活社保卡。市民姓名：孙志文，身份证：310108198310091047。（市民要求回复）', '工单类别': '次紧急', '处理描述': '8:39致电社保卡专席，工号276知晓，此单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704414782-2114778', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105001782, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 43, 43), '诉求地址': '闵行区浦江镇盐铁塘路435弄2号楼1703室', '诉求区域': '闵行区', '内容描述': '市民来电反映:  最近要交水费，突然发现水费翻倍了，威立雅自来水告知，说不确定是否是水表有问题，要市民把水表送去检测，但是检测费用由市民承担，市民表示家里抽水马桶等用水的器具，最近都没有发现漏水情况。 市民不认可检测费用由市民承担。 诉求：要求水表的检测费用由自来水公司承担。', '工单类别': '一般', '处理描述': '接报后，我司于1日内先行联系市民，经放水排气后恢复正常，水费问题也与市民协商达成一致，就给市民造成的不便表示歉意，供水热线1月17日回访市民表示满意', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '供水', '三级分类': '其他', '四级分类': '其他', '主办单位': '供水热线', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704415139-856539', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002012, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 48, 19), '诉求地址': '浦东新区海洋路860弄', '诉求区域': '浦东新区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240104007195，工单内容：【重新交办，要求：市民表示目前物业还是不给其缴纳停车费，现在把其车子扣了不让出小区，对此市民再次来电希望房管办尽快处理，要求物业给其缴纳停车费。诉求：市民要求物业尽快让其缴纳停车费， 请管理部门核实尽快处理此问题。（信息保密，需回复）最近办结的工单编号：工单内容：其因没交物业费，被物业告知如不交物业费，市民不可以将其机动车开出小区，诉求：希望管理部门告知，物业的行为是否合规。如不合规，请进行处理。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240104007195，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704415547-2896926', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002002, '工号': 4272, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 51, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:困难家庭标准及申请', '工单类别': '一般', '处理描述': '根据《《上海市城乡居民最低生活保障申请家庭经济状况认定标准》政策解读》告知，是吗认可，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '生活保障', '四级分类': '社区帮困补助', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704415485-856665', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002582, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 53, 36), '诉求地址': '长宁区宣化路113弄', '诉求区域': '长宁区', '内容描述': '市民补充信息：长宁区宣化路113弄小区精品小区改造，把雨棚弄坏了。请管理部门尽快给予解决。市民要求信息保密，需要回复。【最近派发的工单编号：20240103005210，工单内容：其这边为沿街商铺（诉求地址）。旁边小区（长宁区宣化路113弄）有进行改造施工，搭脚手架施工时将其店铺的雨棚弄坏了，当时施工方有答应完工后会重新做，但是现在施工方撤离了，只将雨棚黏了一下，下雨天会漏水。诉求：希望管理部门核实，其要求给重新做雨棚。（需回复）】', '工单类别': '一般', '处理描述': '我处会将您补充的信息及时转送，请您耐心等待，专此简复 ', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002192, '工号': 4310, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 53, 54), '诉求地址': '静安区江场一路与万荣一路交叉路口', '诉求区域': '静安区', '内容描述': '市民来电反映:静安区江场一路与万荣一路交叉路口，持续有2个星期有大量建筑垃圾和生活垃圾。诉求：请有关部门派人去处理掉垃圾。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '【大宁路街道】街道城运中心1月8日接单后，于当天先行联系诉求人；接报后，街道城运中心及时协调物管中心核实处置。经核实，现场为无主垃圾，已协调环卫清理干净。故市民反映情况部分属实，诉求合理合法。 我中心人员1月17日再次联系诉求人，告知其办结情况，并做回访，诉求人表示已知晓，评价满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '垃圾清理', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704415682-2897003', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002252, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 54, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:新版社保卡激活。', '工单类别': '一般', '处理描述': '转接社保卡成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704415997-856891', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002362, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 55, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416082-856944', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002812, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 56, 59), '诉求地址': '长宁区新泾七村', '诉求区域': '长宁区', '内容描述': '市民反映：1月4日下午，拨打房管局卡片预留的电话，一直打不通。诉求：投诉房管局不作。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '由于来电人要求信息保密无需回复，现我局回复如下，由于来电人未留下有效信息，无法查询到哪位信访人，我局预留的电话可有效打通。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '市房屋管理局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002262, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 58, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2023年12月22日向市场监管反映，上海通用汽车销售有限公司涉嫌虚假广告，市民接到市场监管答复被告知不予立案双方调解未达成一致，市民表示反映的并不是调解而是该公司在市民购车过程中是否存在违法行为，市场监管根本没有正面回答。诉求：希望管理部门核实，并给到市民正面答复', '工单类别': '一般', '处理描述': '由于此工单未提交任何材料，消费者已通过全国12315平台再次反映，并提交证据材料，现无证据证明通用公司有违法行为不予立案。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704415941-2897140', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002512, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 59, 43), '诉求地址': '徐汇区虹桥路693弄19号408室', '诉求区域': '徐汇区', '内容描述': '市民来电反映:上述地址有群租现象。该户一室户入住8-9个人，里面上下铺，非常拥挤。诉求：请管理部门核实，对群租进行取缔。（市民需要信息保密，需回复）\n', '工单类别': '一般', '处理描述': '徐家汇街道城运中心01月05日收到反映群租的工单，于13点47分先行联系市民，工单派至平安办处理。平安办工作人员于1月5日会同居委、物业一同前往现场核实，经查，该处确有群租，工作组开具《督促整改告知书》，要求立即整改，逾期未整改的将进行集中整治。1月9日工作人员再次前往现场核实，经查，该户房型为一房一厅，面积约30平米，有一张高低铺住两人，超标床铺和地铺已清理搬离，已自行整改完毕。工作组人员要求租客及负责人严格遵守《上海市住房租赁条例》的相关规定，严格控制居住人数严禁群租返潮，同时注意生活秩序，避免噪音扰民等不文明现象。后续，街道、居委、物业将不定期抽查房屋租赁情况，防止返潮。平安办工作...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '群租现象', '主办单位': '徐汇区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416164-77788', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002432, '工号': 3802, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 59, 44), '诉求地址': '青浦区', '诉求区域': '青浦区', '内容描述': '市民来电咨询:青浦区白鹤镇鹤祥路600弄22号所属居委会信息。', '工单类别': '一般', '处理描述': '白鹤镇城运中心于2024年1月5日接单，于2024年1月5日09:12分首次通过电话先行联系诉求人，告知诉求已收悉，正在我单位办理。办理情况为：经核实，鹤祥路600弄小区由白鹤物业公司负责日常维护，所属村委会：朱浦村村委会，地址：鹤吉路158号，村居热线：59740200。已将处置结果告知来电人，该问题已实际解决。经办人：朱成龙', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '社区家政', '四级分类': '社区服务网点', '主办单位': '青浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416132-77775', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002752, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 2, 21), '诉求地址': '松江区广富林路1518弄273号', '诉求区域': '松江区', '内容描述': '市民来电反复催单。【最近派发的工单编号：20240101001587，工单内容：市民来电反映：上述地址居民12月初和12月底两次破坏该处绿化，树高：10米，树干粗：80公分，联系居委、物业处理未果。诉求：希望督促整治制止此行为。（市民要求信息保密，需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240101001587，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '绿地绿化', '四级分类': '占绿毁绿', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416378-2897380', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002662, '工号': 4310, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 4, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:虹口区银行门口违停。', '工单类别': '一般', '处理描述': '转接虹口交警支队成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416360-2897367', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002922, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 7, 1), '诉求地址': '静安区中兴路897弄', '诉求区域': '静安区', '内容描述': '市民来电咨询:中兴路897弄的动迁征收单位是哪一家。诉求：请管理部门核实告知。', '工单类别': '一般', '处理描述': '【凯成公司】经核实，被拆迁地址为中兴路897弄48号，属轨道交通M8线中兴路车站基地，市民可去浙江北路191号咨询调档事宜。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '征收管理', '四级分类': '拆迁安置', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416753-857338', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002972, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 8, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416820-78231', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003182, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 11, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417030-2116041', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003112, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 14), '诉求地址': '浦东新区国展路绿谷项A10地块', '诉求区域': '浦东新区', '内容描述': '市民来电反映:2021年在上述地址工地干活，至今还有4、5个人的工资没有结清，金额大概10万元左右。诉求：请管理部门协助讨要工资。', '工单类别': '一般', '处理描述': '1月8日我单位收到王先生反映的关于欠薪的问题，我单位与其联系，询问了具体情况。1月8日我单位联系项目单位要求尽快核实诉求人的欠薪请款个，经核实，诉求人反映情况属实，经协调双方协商一致，约定2月9日前支付工资。1月24日与王先生沟通，对处置结果表示满意，我单位已告知若到期未支付，可以直接至小木桥路683号信访接待室进行反映。此工单即将到期故将进行阶段性回复。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '建筑工程欠薪', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416935-2115971', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003202, '工号': 4302, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 15, 20), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:社保卡临挂解除', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417062-2897878', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003342, '工号': 2820, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 16, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其上海医保无法使用来电查询状态', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417229-2116204', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002992, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 16, 39), '诉求地址': '嘉定区嘉定工业区裕民路福海路 南苑公园', '诉求区域': '嘉定区', '内容描述': '市民来电咨询:上述地址公园是一个健身公园，里面有健身器材和跑道，之前居民建议公园划出一块区域，添加儿童的游乐设施被拒绝了，近期其发现公园开辟了一块萌宠区域，孩子们只能玩萌宠的设施，诉求：请管理部门核实，要求告知为什么可以设置萌宠区域，希望增设游乐设施。（需回复）', '工单类别': '一般', '处理描述': '嘉定工业区：2024年1月5日9:26分先行联系。经了解，为提升公园休闲活动功能，嘉定工业区根据文明养宠实践点要求，在海裕广场打造文明实践养宠点，安装宠物休闲活动设施，设备。同时，在该点位设有使用功能和安全范围的“温馨提示”，所有宠物必须由主人全程陪同下方可使用。关于南苑公园增设儿童智慧健身设施问题，工业区已计划打造增设智慧体育公园，其中包括儿童娱乐设施。2024年1月9日12:37分回访知晓。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '动植园林', '四级分类': '公园设施', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416844-2115912', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003512, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 18, 50), '诉求地址': '宝山区吴淞街道资产管理公司门前', '诉求区域': '宝山区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。每天23:00直至5:00，每隔半小时左右就会有推车来回拉货的声音，半夜声音非常响，戴着耳塞都能清晰听到。要求更换运输方式，或者集中某个小时内运完货物。市民表示上传的视频截图为12月18日2：44，有完整视频为证。诉求：希望管理部门核实转送相关照片至承办部门。（相关工单编号：20231226002166）（市民要求信息保密，需回复）', '工单类别': '一般', '处理描述': '我处会将您补充的信息及时转送，请您耐心等待，专此简复', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': None, '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003442, '工号': 2820, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 19, 11), '诉求地址': '嘉定区', '诉求区域': '嘉定区', '内容描述': '市民来电咨询:其车辆被追尾对方全责，询问能否找对方要拖车费报销', '工单类别': '一般', '处理描述': '根据法律专席忙线，告知市民《12348上海市公共法律服务热线 》认可，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '普法宣传', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417339-2116284', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003582, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 19, 15), '诉求地址': '静安区万春街63弄', '诉求区域': '静安区', '内容描述': '市民来电反映:上述地址小区内停车非常难。诉求：希望管理部门核实解决小区内停车难的问题。', '工单类别': '一般', '处理描述': '【曹家渡街道】市民反映情况属实；小区外的马路现为市政道路，不能停车。街道、居委已通过协调相关部门拟定了缓解停车矛盾的初步方案，拟开放周边道路优先居民进行错峰停车，在方案正式落地前，街道也会与职能部门相互配合，争取尽快解决该处停车难问题。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417225-857658', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003572, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 19, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:电子印章怎么开通。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '经济信息化', '三级分类': '法人一证通', '四级分类': '法人一证通', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417494-2116416', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003672, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 22, 4), '诉求地址': '长宁区娄山关路533号2902-2913室上海寻梦信息技术有限公司', '诉求区域': '长宁区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231230006191，工单内容：市民来电反映:拼多多购物，富安娜被子，550元，订单号：231219-441696951213949，市民表示该被子是假货，要求管理部门电话回复结果。诉求：请管理部门核实协调假一赔十、举报拼多多。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231230006191，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417575-857918', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003362, '工号': 3802, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 23, 30), '诉求地址': '奉贤区', '诉求区域': '奉贤区', '内容描述': '市民来电反映:2023年1月5日(星期四)在奉贤区海湾镇社区事务受理服务中心给孩子办理医保，其孩子目前是在校学生，市民给窗口提交了学校提供的证明是上海工商外国语职业学院继续教育学校在读证明，上面写着本校未给该生办理居民医保，窗口表示该格式无法办理，正确格式是学校未全校统一办理居民医保，学校老师表示一直用的这个格式，市民觉得是医保部门在为难其，诉求：要求医保部门按照学校给的证明给其办理医保。', '工单类别': '一般', '处理描述': '2024年1月5日熊先生来我们海湾镇社区事务受理服务中心窗口为其孩子办理居民医保，其孩子目前是在校学生，给窗口提交了学校提供的证明是上海工商外国语职业学院继续教育学校在读证明，上面写着本校未给该生办理居民医保，故未办理成功。经过多方沟通后，2024年1月12日14点45分通知熊先生来为其孩子登记2024年居民医保，后续等待缴费。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417196-2897978', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003742, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 24, 31), '诉求地址': '浦东新区千祥村356号快递千祥营业部', '诉求区域': '浦东新区', '内容描述': '市民补充信息：浦东新区千祥村356号快递千祥营业部消防不符合相关规定。1，有没有消防设施，器材或者消防安全标志的配置，设置不符合国家标准，行业标准，或者是否保持完好有效。配置的消防器材符不符合要求和相关规定，均需要照片证明。2，安全通道符不符合相关要求。联合举报人: 殷书一，13402013575...', '工单类别': '一般', '处理描述': '我处会将您补充的信息及时转送，请您耐心等待，专此简复 ', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '消防管理', '四级分类': '消防隐患', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105002872, '工号': 4310, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 25), '诉求地址': '闵行区华漕镇纪翟路与北青公路交叉 ', '诉求区域': '闵行区', '内容描述': '市民来电反映:每天早上7:30到9点闵行区华漕镇纪翟路与北青公路交口都会有环卫车来洒水，会把有带脏水溅到市民车上。诉求：建议环卫所改下洒水车经过 这路口的时间。（需回复）', '工单类别': '一般', '处理描述': '华漕镇城建中心承办单位于2024年1月5日接单。于 1月5 日10.30 时进行先行联系。于2023年 1月8日9.00时进行核实现场处置华漕镇现阶段正处于南虹桥开发过程中周边待建工地较多土方车频繁出入工地，土方车行驶过程中洒落渣土导致周边道路扬尘污染严重，根据上述情况环卫公司针对几条主要扬尘道路每天7.30前完成第一次洒水，中间间隔2小时9.30开始进行二次洒水，避开早高峰时段。增派保洁人员加强道路巡查发现洒落渣土及时清理，减少扬尘污染。该问题已实际解决。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '其他', '四级分类': '其他', '主办单位': '市绿化和市容管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704416802-2115883', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003712, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 25, 1), '诉求地址': '奉贤区奉城镇西横路', '诉求区域': '奉贤区', '内容描述': '市民来电反映:长宴村和洪东村交界处的奉城镇西横路（市民确定是市政道路）上面的树长得太茂盛了。诉求：请管理部门核实修剪大树。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '奉城镇于2024年1月10日接单，由于反映人未留下具体联系方式故无法先行联系。1月16日上午，由奉城镇城建中心工程部，对来电人所反映的情况进行核实，市民反映的西横路树木茂盛已有养护单位修剪完成。该问题已经实际解决。经办人工程部，联系电话57522138。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '绿地绿化', '四级分类': '移植修剪', '主办单位': '奉贤区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417631-857959', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003862, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 25, 55), '诉求地址': '美团', '诉求区域': '本市', '内容描述': '市民来电反映:美团恶意差评问题。     ', '工单类别': '一般', '处理描述': '转接美团专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417792-2898439', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105003882, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 28, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其带着孩子到新华医院挂号看病，但是使用医保还是要自费的，询问是怎么回事。 ', '工单类别': '一般', '处理描述': '根据《参加城乡居民基本医疗保险的人员，门诊急诊的医疗待遇如何享受？》告知，市民认可，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704417793-2898442', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105004272, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 31, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 社保卡是上海银行的卡，咨询是否可以变更成别的银行。', '工单类别': '一般', '处理描述': '转接社保卡成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704418210-858438', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105004062, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 35, 15), '诉求地址': '杨浦区场监督管理局', '诉求区域': '杨浦区', '内容描述': '市民来电咨询:杨浦区市场监督管理局电话', '工单类别': '一般', '处理描述': '根据《市市场监督管理局及各区市场监管局联系方式》告知', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704418252-79304', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105004502, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 36, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，市民表示其是婚庆公司的，快递内的东西是6日需要使用的，至今没有收到。市民表示每次寄中通都要投诉才能处理。请管理部门尽快处理。【最近派发的工单编号：20240103031727，工单内容：重新交办，要求：已按答复要点告知。市民称前件答复要点与实际情况明显不符，市民称其中通快件1月1日送到妈妈驿站，并没有派送上门，市民非常不满，诉求：市民要求管理部门核实并尽快送货上门。工单内容:市民来电反映:12月19日市民收到短信说中通快递因为人员紧缺，要到12月25日才能送达，市民是上海收件方，快递单号：7853791124720,78533...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240103031727，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704418032-2898622', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105004362, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 5, 9, 37, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其去市信访办信访被拦，称其未预约。', '工单类别': '一般', '处理描述': '根据《市民走访预约常见问题》告知市民，工单归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '信访', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704418305-79342', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None,