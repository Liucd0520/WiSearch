': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108029462, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 8, 17, 7, 47), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电咨询:自己和一个期刊合作发布自己的论文，但是现在怀疑被诈骗了，对方叫国际市场，贸易促进会下面的好像，市民问了编辑部被告知已经停刊，但是自己去网上查，有显示在刊，市民询问新闻出版局电话咨询。', '工单类别': '一般', '处理描述': '查询未见该刊信息，告知市民电话市民认可。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '新闻出版', '三级分类': '刊物市场监管', '四级分类': '报刊印刷发行', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704704405-398369', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108029522, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 8, 17, 8, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:1其机动车号牌由于事故污损需要更换。诉求：咨询需要去哪里办，带什么材料。', '工单类别': '一般', '处理描述': '市公安局车辆管理所综合科张逸凡于2024年01月09日13时13分来电市民桂明联系，告知来电人由于为单位车辆，需先办理面签业务后，由面签人员通过随申办APP预约补领机动车号牌业务，再携带营业执照原件、委托书、代办人身份证明原件、损坏的机动车号牌，前往办理。工号：17。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704704501-2441505', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108029732, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 8, 17, 9, 34), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704704856-607667', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108029602, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 8, 17, 12, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:居住证注销', '工单类别': '一般', '处理描述': '转接社保卡成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704705046-2441804', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 202