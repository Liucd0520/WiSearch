, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105019202, '工号': 4302, '工单生成时间': datetime.datetime(2024, 1, 5, 14, 22, 18), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电表示撤销工单，撤销原因取消投诉。【最近派发的工单编号：20240105018770，工单内容：市民参加了拼多多的活动，活动名称：砍一砍，市民找了很多人给其助力，但没有得到相应的奖赏，市民觉得拼多多欺骗消费者，市民表示其不方便提供账号信息，诉求：请管理部门核实并查处。（市民要求信息保密 需回复）】（市民要求信息保密 需回复）（市民要求信息保密 无需回复）（市民要求信息保密 需回复）（市民要求信息保密 无需回复）（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '市民撤销工单，工单编号：20240105018770，已告知市民因承办单位已受理可以和承办单位沟通。故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704435054-871388', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105019862, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 5, 14, 24, 3), '诉求地址': '静安区威海路888弄5号102室', '诉求区域': '静安区', '内容描述': '【投诉】市民来电反映:静安区威海路888弄5号102室居民存在敲承重墙的行为，反映到街道城管平安办，核实确实敲了承重墙 ，但是至今未整改好，投诉街道城管平安办不作为，诉求：要求督促尽快整改，恢复承重墙。（需回复） \n', '工单类别': '一般', '处理描述': '【南京西路街道】情况不属实；诉求其他；我街道于1月5日15点56分与市民进行先行联系，告知工单收悉，将派给职能部门进行核实处理。经现场检查，威海路888弄5号102室在装修时涉嫌拆除厨房与卧室之间的墙体，原南京西路街道城管执法中队遂予立案调查。后经上海勘察设计研究院（集团）有限公司房屋质量检测站对该处墙体进行检测，认定被拆除的墙体为承重墙体。据此，静安区城管执法局于2020年11月30日向当事人制发《承重结构被损的房屋告知书》及《责令恢复原状决定书》。2021年6月10日，经执法人员复查，当事人已恢复承重结构，并由上海浦东房屋质量检测站对恢复后的墙体进行检测和出具已恢复认定报告（见附件）...', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704435186-2958096', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105019742, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 5, 14, 24, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:病假在家，快2年了，单位不和市民签劳动合同了，是否可以找工会出面帮其协调。', '工单类别': '一般', '处理描述': '转接未接通，市民表示算了，归档。', '客户类型': '个人', '一级分类': '社会团体类', '二级分类': '总工会', '三级分类': '总工会', '四级分类': '工会工作', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704435620-2176740', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105019372, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 5, 14, 26, 35), '诉求地址': '嘉定区双丁路889号（瑞金医院北院）', '诉求区域': '嘉定区', '内容描述': '市民来电反映:其家人2023年12月27日19:00左右通过救护车从其他医院转院到瑞金医院北院就医，检查报告出来后抢救室姓魏的医生询问是否要进抢救室，由于在其他医院抢救室治疗过，患者和市民询问医生后续该如何治疗，但该医生没有对患者任何了解救治，只是在发脾气的说要进抢救室就治疗，不进就签字。市民诉求：投诉该医生态度恶劣，对患者任何了解救治。', '工单类别': '一般', '处理描述': '致电市民，向市民了解情况，解释沟通，对市民不愉快就医经历表示歉意，感谢市民的我院医疗服务及医疗质量的关心。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '服务态度', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704435234-871538', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105020082, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 5, 14, 29, 41), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '【为企服务】市民来电反映:其在浦东新区设立分公司，在一网通办上看到可以领证，但没有收到通知短信，想确认是否可以去窗口领证。', '工单类别': '一般', '处理描述': '转接浦东新区市场监管局成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704435964-2958821', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105020062, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 5, 14, 30, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:从银川运到上海的书籍顺丰快递查询', '工单类别': '一般', '处理描述': '转接顺丰成功,归档', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704435909-917665', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105020232, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 5, 14, 30, 29), '诉求地址': '杨浦区', '诉求区域': '杨浦区', '内容描述': '市民来电咨询:应届本科毕业生租房和就业补贴如何申请。诉求：请管理部门核实并告知。', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派区人社局进行处理。据区人社局回复：先行联系：接单后，1月5日15时41分，区人社局工作人员电话联系来电人，告知其本次反映的工单收到。 情况核实：经核实，来电人咨询内容有政策信息。 处置过程及回访：区就促（人才）中心工作人员于1月10日09时02分与来电人取得联系，为其详细介绍租房补贴政策详情，同时告知就业补贴方面的咨询电话。来电人已知晓。'