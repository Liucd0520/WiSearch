号': 20240101016382, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 1, 20, 12, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:1月1日收到中国移动短信告知欠费100多元，网站查询多加了5G优惠包30元，10086办了退订后告知会将扣除的钱返还账户，与中国移动沟通告知是12月29日代理销售订阅的，市民认为捆绑业务不合理，绑定手机号：15000975021。诉求：请管理部门核实协调退订捆绑业务并从此不再为其办理捆绑业务。', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': '上海移动通信公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704110493-277577', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101016422, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 1, 20, 21, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704111573-277816', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101016612, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 1, 20, 26, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其于2024年1月1日在20:03通过“高德地图”中的“曹操出行”平台叫了一辆网约车，车牌号“沪AFL8596”，上车点为“明日新苑”小区，下单后2分钟的时间司机就打电话催其赶快过来，还说这边没有停车位不给停车，但其上车点处是没有黄实线的，其回复司机说已经在过来的路上了，让其再等待几分钟，司机答复说等不了还不肯按市民说的去取消订单，随后该笔订单司机转派给其他司机了，且还绕了一圈回来在上车点处对着市民开窗户进行辱骂。诉求：请管理部门核实处理上述网约车司机辱骂市民的问题。', '工单类别': '一般', '处理描述': '【核实内容】：乘客提供车牌未注册曹操司机；【处理方案】：2024-01-03 10:17:48/13:34:18/16:41:03未接，多次联系失败，烦请协助确认有效订单信息，便于进一步核实处理，谢谢', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704111443-277785', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101016772, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 1, 20, 31, 43), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民在拼多多平台上购买了暖水袋，订单号：231224-194710138332211，金额8.45元，当时购买的时候看到上述有个塞子，但收到货后发现没有塞子，故申请退货退款，并先行垫付了运费8.7元，目前商品金额退还给其了，但是运费一直不退。诉求：请管理部门核实处理，协助市民退还8.7元的运费。', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704112003-277894', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101016882, '工号': 4272, '工单生成时间': datetime.datetime(2024, 1, 1, 20, 34, 17), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多专席', '工单类别': '一般', '处理描述': '转接过程中市民断线。归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704112354-3093297', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101016652, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 1, 20, 35, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:外省市身份证如何在上海换证', '工单类别': '一般', '处理描述': '根据《 外省市来沪人员申领、换领、补领居民身份证，申领临时居民身份证《窗口服务告知单》 》', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '身份证管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704112301-2311051', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101016712, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 1, 20, 39, 5), '诉求地址': '杨浦区江湾城路99号9栋（抖音商城）（上海格物致品网络科技有限公司', '诉求区域': '杨浦区', '内容描述': '市民来电反映:该处平台有许多卖字画与瓷器直播间宣传售卖的几百元商品承诺是真货，有紫光防伪，证书，有政府惠民补贴，可以向大拍卖行高价售卖，有些承诺回收，市民质疑是虚假宣传，具体哪些直播间市民未提供，现诉求：望管理部门尽快查处整治。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '经查，未发现抖音电商平台存在举报的违法行为，我局决定不予立案；根据《市场监督管理投诉举报处理暂行办法》第二十七条第二款，建议向商家所在地市场监管部门反映。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '广告监督', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704111867-2310972', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101016922, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 1, 20, 40, 32), '诉求地址': 