: None, '服务类型': '综合服务', '通话编号': '1704761813-2495300', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109002632, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 0, 55), '诉求地址': '闵行区江川街道东三居委鹤庆高层', '诉求区域': '闵行区', '内容描述': '市民反映：业委会全是上班职工，接待日放在每个月第二个星期六，小区里老人多无法理解。诉求：要求把具体日期标明清楚，并公布业委会主任联系电话。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '江川路街道自治办于1月10日与来电人先行联系并核实情况，办理情况是经了解，为了方便小区居民反映问题，鹤庆高层小区业委会业委会成员将每月第二个周六定为业主接待日，2024年每月排班表已经在小区内公示。业委会主任联系电话属于个人隐私，无需公开。自治办于1月15日将办结情况向来电人进行答复解释。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '业委会', '主办单位': '闵行区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109002692, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 3, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，账号异常，同意转接拼多多绿色通道。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704762098-661086', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109002702, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 5), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:查询孩子的医保十分正常缴纳，来电求助', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704762169-661133', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109002752, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 5, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704762252-661192', '工单类型': '求助类', '新一级分类': N