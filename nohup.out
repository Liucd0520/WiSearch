, '服务类型': '综合服务', '通话编号': '1704290312-2559974', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103036922, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 6, 55), '诉求地址': '浦东新区灵山路701弄27号1801室', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址居民家22:00以后还在装修，用电钻钻墙，严重噪音扰民，影响周围居民休息。诉求：请管理部门核实尽快彻底制止。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '经洋泾街道桃二居委核实了解，居委已于1月4日上午去27号1801室进行核实，1801为出租户，近日有新的租客入住，核实情况是1月3日晚上在家组装家具，非装修，居委提醒租客不要在夜间组装家具或发出噪音影响邻里休息，租客表示知晓并会注意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704290678-2560027', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103036942, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 8, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:在咸鱼出售购物卡，对方未付款，但把账号密码给了对方之后没有回应了。', '工单类别': '一般', '处理描述': '告知无法受理，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704290791-733356', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103036902, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 9, 10), '诉求地址': '嘉定区苏民学校', '诉求区域': '嘉定区', '内容描述': '市民来电反映:其孩子目前在普陀区就读初中，由于在嘉定区购买房屋，查询到最近的学校是民办苏民学校。市民诉求：希望管理部门告知如何办理转学以及该学校学费是什么标准。', '工单类别': '一般', '处理描述': '嘉定区教育局：2024年1月8日10点区教育局工作人员与诉求人联系沟通，了解情况，告知转学相关政策信息。后续苏民学校多次电话联系均未接通。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '入学入托', '四级分类': '办理转学', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704290729-477962', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103036972, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 12, 16), '诉求地址': '闵行区元江路翔泰苑', '诉求区域': '闵行区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，告知市民办结答复，不认可，表示小区东门与北门情况是一样的，同样没有保安，但东门却是开放的，不应区别对待。诉求：希望管理部门核实要求正常开放。最近办结的工单编号:20231205029580工单内容：市民来电反映:上述小区元江路有一个仅供行人通行的小门，21:30以后就锁起来了。其一般下班较晚晚，22：00回来，就得绕到大门进小区，要绕很多路。诉求：希望这扇门23:00以后锁，或者是不要锁，因为这扇门本身是有门禁的。（需回复）\n】', '工单类别': '一般', '处理描述': '翔泰苑居委于1月4日与来电人先行联系，并对诉求信息进行确认。经现场查看，小区北门为消防通道，现开放时间为5：00-22:00，经四位一体讨论决定，春节后北门开放时间将延迟至23点。翔泰苑居委于1月19日将解决情况答复来电人。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704290768-2560041', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103036992, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 19, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民儿子2024年城乡居民医保没有缴费，来电咨询如何补交。', '工单类别': '一般', '处理描述': '根据《城乡居民医保缴费热点问答（2024年度）》告知市民，工单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704291273-2772347', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103036872, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 20, 40), '诉求地址': '虹口区东余杭路靠近商丘路', '诉求区域': '虹口区', '内容描述': '市民来电反映:其 使用13310000311 在2024年1月2日21:56拨打了110，反映上述地址有施工噪音扰民，110表示其立即反映，会有回复，要求保持手机号畅通。 但是在市民拨通第二次110之前，其未给予回复。诉求：投诉公安未及时给予其回复，需要解释。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '市公安局虹口分局派出所于2024年1月4日11时22分许与诉求人取得电联。经查，诉求人实际拨打110是1月3日，并非1月2日。1月3日，我所接到关于诉求人的2起110警情，第1起110为21:56,反映施工噪音扰民，我所综合指挥室于21：58分签收，民警于22：08分拨打诉求人电话，其未接听。第2起为22：08分，我所综合指挥室于22：15签收，民警于22：18分拨通诉求人电话，告知诉求人工地有夜间施工许可证以及解决途径。诉求人表示知晓。综上，诉求人反映情况不属实。其2次110，我所民警均已合规处置。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '慢作为', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704291101-733388', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037022, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 23, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:敬老卡遗失如何补办。', '工单类别': '一般', '处理描述': '根据《 老年综合津贴工作实操问答 》告知，市民知晓，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '养老保障', '四级分类': '老年津贴', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704291571-733424', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037142, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 34, 17), '诉求地址': '静安区新疆路乌镇路', '诉求区域': '静安区', '内容描述': '市民来电补充信息。市民补充信息内容为1月3日22:30左右静安区新疆路乌镇路又在进行施工，噪音严重扰民，要求管理部门尽快处理。【最近派发的工单编号：20231217019487，工单内容：市民来电反映:2023年12月17日22:19静安区新疆路乌镇路在施工，产生噪音扰民，分贝非常高，诉求：请管理部门协调夜间最好不要施工，起码要降低分贝。（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231217019487，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704292312-733472', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037122, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 37, 2), '诉求地址': '嘉定区金园一路金沙江西路', '诉求区域': '嘉定区', '内容描述': '市民来电反映:上述地址在进行嘉闵线施工，每天晚上在22:00多还在施工，已经一个多月了，噪音扰民严重。诉求：希望让其夜间不要施工。', '工单类别': '一般', '处理描述': '2024年1月18日18点32分已跟投诉人取得联系，告知投诉人项目于1月3日才开始施工，并未有噪音影响1个多月的情况，并且告知投诉人现阶段施工工艺和安全要求不得不进行24小时连续施工，项目部施工中已采取降噪设施，增加隔音棉和设置声屏障后，现场进行实测，白天和夜间都符合要求，后续合理安排施工工序，尽量减少对居民影响，居民表示理解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704292115-2772419', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037162, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 40, 2), '诉求地址': '嘉定区安亭镇曹安公路5588号资产财富广场北楼505', '诉求区域': '嘉定区', '内容描述': '【重新交办,要求：答复要点与实际情况不符，目前低频噪音情况没有任何改善，现在搬到了604，每天夜间不间断的出现噪音。诉求：希望尽快核实并整治。最近办结的工单编号:20231219034648，工单内容:市民来电反映:上述地址没人住开低频噪音扰民，21:50开始扰民，诉求：管理部门核实查处。】', '工单类别': '一般', '处理描述': '安亭镇：接热线后，1月4日先行联系。经上海国际汽车城世茂实业有限公司、安亭派出所核实，前期已现场查看，505室为一家公司的仓库，经联系该仓库负责人表示该处平时夜间不住人，房屋用来堆物的情况，不存在低频噪音扰民。经了解，诉求人周边邻居和物业均反映诉求人精神上可能有问题，多次电话联系诉求人都未接电话，协同辖区片警上门诉求人也不开门。后于1月4日联系到诉求人妻子（刘静13337726114），刘静表示诉求人确实存在精神疾病，家里人也在寻找诉求人。刘静目前在南京，表示会立即赶来陪诉求人或接走。1月7日刘静已赶到。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704292588-733490', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037172, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 41, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电补充信息。市民补充信息内容为现拼多多平台告知不支持对一赔三，只能退货退款，其不认可，希望管理部门核实处理。【最近派发的工单编号：20240102025175，工单内容：市民来电反映:12月25日市民通过拼多多上购买了一块江诗丹顿的手表，但是收到的是一块冠琴的手表，订单号：231225678711817243666，价格：397元，市民认为商家虚假宣传，与拼多多反映过无果。诉求：要求按照虚假宣传欺诈消费者处理，并进行退一赔三。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240102025175，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704292684-478115', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037182, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 43, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费问题，要求转接拼多多。', '工单类别': '一般', '处理描述': '已根据知识库“转接承办单位座席流程”告知市民，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704292895-478131', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037192, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 3, 22, 50, 55), '诉求地址': '静安区新闸路胶州路近常德路', '诉求区域': '静安区', '内容描述': '市民来电反复催单。催单原因：市民称1月2日晚上就从21:00施工到凌晨，连续两天夜间施工严重影响居民生活，请管理部门尽快处理。【最近派发的工单编号：20240103036292，工单内容：市民来电反映:上述地址道路施工，近期每天都从21:00左右开始一直发出产生巨大噪声的施工作业，要持续到次日4:00左右。严重噪音扰民影响周围居民正常休息。诉求：请管理部门核实尽快彻底制止噪音扰民，晚上停止施工。（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240103036292，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704292951-733520', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037252, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 3, 23, 0, 25), '诉求地址': '黄浦区西凌家宅路111弄2号1208室', '诉求区域': '黄浦区', '内容描述': '市民来电反映:上述地址居民家中夏天和冬天开空调的时候外机会产生巨大的噪音扰民，影响周围居民正常休息，要求居委出面协调更换空调外机，制止噪音扰民。诉求：请管理部门核实尽快处理。（需回复）', '工单类别': '一般', '处理描述': '我单位2024年1月4日接单并通过电话先行联系来电人，告知其问题已收悉正在我单位进行办理。我单位接单后与该处西二居委核实，来电人反映的1208室为自如出租房。经核实，居委已就该处空调外机噪音的问题与该处房东进行过协调，房东表示愿意更换，但是需要和自如中介人员协调更换成本，目前中介因考虑成本问题并未答应，居委也无法强制自如更换空调外机。物业也安排工作人员对该处空调外机进行核实，该处无强烈噪音且无安全隐患。1月16日我单位已告知来电人相关情况，并告知其如对自如中介不满可拨打自如的客服热线反映问题，其表示知晓。经办人：陈宇杰，同意结案。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704293736-2560340', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037602, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 3, 23, 6, 20), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704294341-2560384', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037612, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 3, 23, 11, 28), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704294650-2560405', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037392, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 3, 23, 23, 42), '诉求地址': '宝山区大华派出所', '诉求区域': '宝山区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，市民称管理部门没有给到相关市民报案的证明，也没有给到报案回执单，导致市民无法申请行政复议，市民认为管理部门有推诿的现象，故再次来电。诉求：希望管理部门核实，并尽快开具报案回执单。（需回复）最近办结的工单编号:20231215021917 工单内容：市民来电反映:今年5月23日市民去上述派出所报案，市民姓名：朱宏安。派出所为给其报案回执单，市民现在申请行政复议时需要报案回执单否则缺少材料无法申请行政复议。诉求：希望派出所出具报案回执单给其。】', '工单类别': '一般', '处理描述': '致电市民，按照12345市民服务热线"重复事项处理流程"：市民初次提交的事项已办结，且“答复市民要点”详细清晰，但市民仍表示不满的，告知其已有办理意见和结果的热线不再重复受理。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704294982-478258', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037422, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 3, 23, 34, 55), '诉求地址': '奉贤区南桥镇育秀东路百秀路', '诉求区域': '奉贤区', '内容描述': '市民来电反映:1月3日23:00多在上述地址，有一辆强生出租车在行驶时没有礼让电瓶车，并且司机辱骂市民，车牌尾号0762，故来电投诉。诉求：希望给予一个说法。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '1月4日，15：33 致电反映人，向客致歉，对驾加强辅导教育，客谅解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704295734-478287', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037432, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 3, 23, 37, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其2024年1月3日23:00左右在拼多多平台购买了瓷砖，金额2008元，订单号：240103-571285247443045。其下单后商家告知其购买的是残次品。现商家还未发货，其要求退款，联系不上平台客服，已发起退款申请。诉求：希望管理部门核实协调不要发货，直接退款。', '工单类别': '一般', '处理描述': '经拼多多平台协调，已为投诉人处理，投诉人已接受，双方协商达成一致。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704295885-478294', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103037442, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 3, 23, 43, 41), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【投诉】市民投诉：市民之前来电，市民话还没有说完话务员就挂断了电话，市民要求投诉。前工单：20240103037422', '工单类别': '一般', '处理描述': '已按照投诉处理流程进行核实处理。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '投诉批评', '四级分类': '业务熟练', '主办单位': '12345热线处理', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704296051-2818235', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000092, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 4, 0, 43, 56), '诉求地址': '虹口区中山北一路121号B6幢2004室', '诉求区域': '虹口区', '内容描述': '市民反复催单。【最近派发的工单编号：20231219000233，工单内容：市民来电反映:得物平台（上海识装信息科技有限公司）上购买了进口的牛奶粉，拿到手发现生产日期极为容易涂抹，市民摸了一下就消除了，怀疑未按规定进行标注。订单号：110140375743010123，金额：40元左右。市民联系平台介入处理，平台以审核没有问题为由拒绝市民要求300元补偿的诉求。市民告知其保留了相关证据视频。诉求：要求管理部门介入调查此处是否违规，对此事进行投诉并需要500元赔偿。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231219000233，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704299680-2818351', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000142, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 4, 1, 41, 7), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:要求转接法律援助。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '法律援助', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704303569-2560691', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000172, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 4, 2, 14, 36), '诉求地址': '宝山区泰和路475号1-2厂房   大圣蛋业分拣仓', '诉求区域': '宝山区', '内容描述': '补充信息：市民举报：宝山区泰和路475号1-2厂房1、门口贴了禁烟标识但还有人在抽烟。2、库房内有易燃的纸箱和泡沫。3、没有任何灭火器。要求行政管理部门进行行政处罚，罚款30万元。（市民要求信息保密 需回复）【最近派发的工单编号：20240104000165，工单内容：市民来电反映:上述地址没有灭火器，存在消防隐患，故来电投诉。诉求：希望管理部门核实，依法进行查处，做出行政处罚罚款。（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240104000165，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '消防管理', '四级分类': '消防隐患', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704305382-733855', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000192, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 4, 3, 38, 43), '诉求地址': '徐汇区汇成四村54号104室 ', '诉求区域': '徐汇区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231222000482，工单内容：重新交办,要求：按答复要点告知市民,市民表示答复要点与实际情况明显不符,该处的确为居民住宅，故存在不合法经营的情况，其仅有每周五14:00左右起向外挂牌营业，且是外省市人员，其他时间段不在经营，市民表示其反映的情况完全属实。诉求：原诉求不变。】', '工单类别': '一般', '处理描述': '当班组长1348接听，市民反复催单，已电子催单工单编号：20231222000482，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '无照经营', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704310396-2818548', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000222, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 4, 3, 38, 49), '诉求地址': '青浦区沙埭浜路（青安路-浦仓路）', '诉求区域': '青浦区', '内容描述': '市民来电反映:上述地址道路施工在马路上铺了一块铁板，每天夜间车辆开过噪音扰民严重。诉求：希望核实并整改。', '工单类别': '一般', '处理描述': '【此工单诉求内容属实】青发集团于2024年1月4日接单，并于2024年1月4日14时17分首次通过电话先行联系诉求人，告知其问题已经收悉，正在我单位进行办理。 2024年1月5日，由青发集团城建公司对诉求人所反映的情况进行核实。办理情况：经核实，该道路为电力排管施工，路上铺了铁板噪音扰民严重，现已经将铁板撤除（附件照片）。已通过电话将办结情况告知来电人，诉求人对此表示满意，问题已实际解决办结。经办人：高文骏。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '青浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704310409-2560806', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000272, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 4, 3, 48, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '疑难人员来电泛泛而谈', '工单类别': '一般', '处理描述': '疑难人员来电泛泛而谈', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704311144-2818566', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000702, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 4, 6, 24, 54), '诉求地址': '无', '诉求区域': '本市', '内容描述': '夜间施工噪音。', '工单类别': '一般', '处理描述': '即时信息，未告知具体地址等信息。 ', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704299939-733778', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000322, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 4, 6, 34, 37), '诉求地址': '浦东新区居家桥路 金杨六街坊', '诉求区域': '浦东新区', '内容描述': '市民来电反映:近期每天6:00左右开始就有人在居家桥路靠近金杨六街坊小区的草坪上用机器除草，产生巨大的噪音扰民，严重影响周围居民正常休息。诉求：请管理部门核实尽快彻底制止噪音扰民。（需回复）', '工单类别': '一般', '处理描述': '1月4日10时，管理小区的陆家嘴双乐物业与诉求人联系后表示，经过物业与小区业委会和附近道路养护单位金桥市政核实，最近一个月内并没有对草坪进行过机械除草，不存在每天早上6点就有除草剂噪音扰民的情况。1月16日17时05分，17时30分，17时58分与诉求人联系，始终无人接听，故未评价。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704321096-478675', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000392, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 4, 6, 35, 48), '诉求地址': '长宁区', '诉求区域': '长宁区', '内容描述': '市民来电补充信息。市民补充信息内容为要求对纵容包庇拼多多平台的行为从重处罚，希望管理部门核实处理。【最近派发的工单编号：20240102037465，工单内容：【投诉】市民来电反映:在拼多多购买东西被骗，长宁区市场监督管理局告知平台没有责任。认为管理部门存在纵容包庇拼多多平台的行为，诉求：投诉承办部门长宁区市场监督管理局。要求尽快处理回复。关联工单编号：20231216034346。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240102037465，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '诉求未解决', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704321099-2560956', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000482, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 4, 6, 55, 57), '诉求地址': '宝山区虎林路99弄36号101', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述地址居民，在1楼的公共楼道装了监控和防盗门，把供电和有线电视都封在里面，还在楼梯装了一排柜子，每天家中还飞线充电充电瓶车。诉求：希望核实并整治。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '张庙街道于2023年1月4日接到区12345热线派发的工单，经了解，情况如下：2024年1月8号张庙街道综合行政执法队执法人员现场复查：虎林路99弄36号1楼101室门口违法搭建的存量防盗门以及顶部玻璃都已拆除，当事人表示不再搭建。由于无联系方式，无法将上述情况告知来电人。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704322327-478706', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000502, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 4, 7, 4, 7), '诉求地址': '徐汇区枫林路街道斜土路1899弄小区3号楼', '诉求区域': '徐汇区', '内容描述': '市民补充信息，电梯公司1月4日在小区内出了施工通知，市民表示应该为居委会或业委会出通知，希望管理部门尽快处理。【最近派发的工单编号：20240103018335，工单内容：市民来电反映:其要投诉斌菱公司经理吴爱兵，该公司就是上述地址小区加装电梯的公司，市民告知3号楼绝大多数业主不同意的情况下该公司直接强行开始安装电梯，对很多居住的居民造成了恐慌。诉求：请管理部门核实该公司是否未经业主同意强行安装电梯做出投诉。（信息保密需要回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240103018335，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704322831-2561026', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000722, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 4, 7, 12, 19), '诉求地址': '无', '诉求区域': '本市', '内容描述': '泛泛而谈', '工单类别': '一般', '处理描述': '泛泛而谈', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704322181-2818751', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000542, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 4, 7, 13, 10), '诉求地址': '普陀区潮州路538号', '诉求区域': '普陀区', '内容描述': '市民来电补充信息。市民补充信息内容为市民整夜无法入睡，存在重大安全隐患，要求管理部门尽快处理。【最近派发的工单编号：20231231012308，工单内容：市民来电反映:潮州路538号小区地下室内违法经营废品收回站，举报后经管理部门整治已停业，市民告知现在死灰复燃，近期要准备恢复开业，诉求：要求取缔（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231231012308，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704323418-2561060', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104000732, '工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 4, 7, 40, 37), '诉求地址': '徐汇区3号线龙漕路站龙吴路位置', '诉求区域': '徐汇区', '内容描述': '市民来电反映:1月4日早上7:00左右，发现上述地址的消防栓出现漏水情况，非机动车道有积水情况，市民表示有安全隐患，要求尽快维修处理。', '工单类别': '次紧急', '处理描述': '接报后，我司于1个工作日内先行联系市民，并派员至现场，经核实该处为管道冲洗工作，已与市民说明非消防漏水， 供水热线于1月5日回访市民表示满意。', '客户类型': '个人', '一级分类': '公安