: None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004212, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 35, 29), '诉求地址': '嘉定区曹安公路上海协通众晟汽车有限公司', '诉求区域': '嘉定区', '内容描述': '市民来电反映:市民在上述4S店2022年12月22日购买了大众ID4的新能源车，对方承诺1年内能够安装好充电桩，结果市民因为当时没有车位，联系对方需要延迟安装，最后也已经确定了12月18日安装，到现在还未安排上门安装，暂无4S店电话，只有大众的电话4008201111，打了16个电话也没有安装，故来电要求管理部门对此进行核实并督促4S店按照承诺尽快帮其安装充电桩', '工单类别': '一般', '处理描述': '事出有因', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '汽车维修', '四级分类': '4s店服务', '主办单位': '市经信委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245241-2697845', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103003782, '工号': 4300, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 36, 42), '诉求地址': '松江区城桂路城隆路交叉口', '诉求区域': '松江区', '内容描述': '市民来电反映:松江区城桂路城隆路交叉建设了私人垃圾场，该市民反映是这块地刚开始有栏杆但是有人人为的把铁栏杆剪断然后私自占用土地，现在伴随恶臭并影响周围环境，诉求：希望管理部门核实并取缔该私人垃圾场。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '松江区12345市民服务热线接单后派洞泾镇，经分管领导签批同意，市民诉求部分属实。洞泾镇整治办拆违办于2024年1月3日先行联系市民，并对工单问题描述进行确认。工作人员现场核实上述地址并非私人垃圾场，为一拾荒独居老人将拾荒的物品堆放在此处，已现场对其开展宣传教育，后续会拟定相关方案，做好环境整治工作。2024年1月15日电话答复来电人，来电人表示满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704244813-2697478', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004232, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 36, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:单位给员工缴的商业保险，市民在单位受伤。咨询：按规定材料是给保险公司还是工伤部门。', '工单类别': '一般', '处理描述': '转接人力资源专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '工伤保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245555-2440223', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004672, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 37, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245724-2440367', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004042, '工号': 3660, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 37, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:家里渗水，是楼上管道之前漏的，现在楼上对方不承认，物业和居委都调解过。', '工单类别': '一般', '处理描述': '诉讼。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '律师服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245265-405223', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004132, '工号': 4080, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 37, 54), '诉求地址': '静安区沪太路631弄11号208室', '诉求区域': '静安区', '内容描述': '【投诉】市民来电反映:上述地址的居民的洗衣机放在5户居民合用的公共卫生间，影响其他居民的生活，多次和居委街道沟通无果。诉求：投诉居委会不作为，纵容他家对公共场所的占用。前工单编号：20231212026069（需回复）', '工单类别': '一般', '处理描述': '【共和新路街道】共和新路街道于2024年1月4日接单，并于当日15时00分先行联系居民。经核实处置如下：①、老旧厨卫合用住房居民在公共卫生间摆放洗衣机属普遍情况，经向社区结对法官、律师咨询，无相关法律法规政策做硬性规定，居委会无权根据诉求人诉求强行要求对方将洗衣机挪走。②、经现场多次走访，208室已将洗衣机排水管末端接在盆中，洗衣机未对其他居民使用卫生间造成影响、无水流向地面。208室居民称近期已很少使用洗衣机，并承诺会将洗衣机排水管接入下水道。其他居民也未表示洗衣机影响使用卫生间。③、居委会对此类邻里纠纷仅能进行劝解劝说和组织双方调解，由于诉求人与对方是同乡，先前因其他琐事引起关系不和...', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245162-405136', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004402, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 39, 58), '诉求地址': '浦东新区，上海鼎锋子龙投资管理合伙企业', '诉求区域': '浦东新区', '内容描述': '市民来电反映:2023年11月份递通过线上交了工商变更申请，无法进行签名，之后通过线下办理，由于线上没有撤销，线下办理不了，2023年12月8日和工商申请撤销线上申请，工作人员告知窗口会撤销的，现在撤销不了，直接通过一网通办重新申请，诉求：要求不要重新做实名认证。', '工单类别': '一般', '处理描述': '该企业已完成申请案', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245600-660939', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004772, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 40, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:让挪车，外省市号牌', '工单类别': '一般', '处理描述': '建议12123APP“一键挪车”', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245856-2698343', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004602, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 40, 30), '诉求地址': '闵行区莘庄镇房管所', '诉求区域': '闵行区', '内容描述': '【投诉】市民来电反映:通过12345向管理部门投诉物业，之后工单转到莘庄镇房管所处理，市民表示接到该部门一个男性工作人员回复，对方表示没有办法处理要市民自己去查上海物业管理条例，诉求：市民投诉该工作人员的专业度和办事态度问题。（市民要求回复，相关工单编号：20240101004102)', '工单类别': '一般', '处理描述': '莘庄镇房管所于2024年1月3日先行联系诉求人，现场核实并处置。经核实，因其车子停在小区内被剐蹭，工作人员遂联系其，并和物业积极沟通协调，要求物业和诉求人查看监控。但是由于该小区监控老旧早已坏了，监控暂时难以找到肇事者。故建议诉求人报警处理，告知其后续相关责任需要警方查证后来确定，同时物业也已承诺会积极配合协助警方处理。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '诉求未解决', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245641-405534', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005052, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 40, 49), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704246006-2440593', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004122, '工号': 4282, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 41, 23), '诉求地址': '黄浦区', '诉求区域': '黄浦区', '内容描述': '市民来电反映: 上海黄浦人民法院关于立案金融案件回款问题。法院要求市民提供建行银行卡信息。市民表示不方便办理该银行卡。故要投诉。告知其上级部门联系方式。', '工单类别': '一般', '处理描述': '根据《司法、政协系统联系地址电话》，告知市民，市民认可，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '法院系统', '三级分类': '法院受理', '四级分类': '诉讼立案', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245151-2697771', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004832, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 42, 30), '诉求地址': '嘉定区', '诉求区域': '嘉定区', '内容描述': '市民来电反映:其是一家企业，与上海讯兆通企业管理有限公司合作办理了几部电话业务，但是没有办理下来，但是这家通信公司已经收取了1万元定金，没有办理之后也没有给其办理退款，据了解这家公司是与电信公司合作的通信公司，电信公司现在也联系不上，诉求：希望管理部门协调查处退款。', '工单类别': '一般', '处理描述': '通过', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': '中国电信上海分公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245873-405723', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004752, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 42, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民在随申办提交职业技能补贴，职业技能：客服员三级，没有注意是否提交了银行卡号。一直下一步下一步到了最后一步。诉求：请管理部门告知，市民是否提交了银行卡号，或者没有提交的话告知提交银行卡的地方。市民信息：佟秀光、130225197902102524。', '工单类别': '一般', '处理描述': '2024-01-03 11:18:24 致电，关于您咨询的问题，经向经办机构核实后告知您，您申请职业技能提升补贴时已提交了银行卡信息，您表示知晓。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '网站使用', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704245831-2440446', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004732, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 43, 39), '诉求地址': '闵行区 闵行33路', '诉求区域': '闵行区', '内容描述': '市民来电咨询:其之前乘坐闵行33路公交车，包落在车上幸好有 闵行33路A车队（平阳车队）的工作人员为其找到了丢失的物品，特此来电对工号为02-07941的驾驶员、工号为02-07102的调度员表示感谢，诉求：请管理部门予以嘉奖。', '工单类别': '一般', '处理描述': '经车队核实：1.驾驶员确实捡到市民丢失的物品，并物归原主；2.车队会对该驾驶员做出相应的奖励。2024年1月3日13:15分与反映人联系沟通并解释说明，到反映人的感谢，对车队的回复表示认可。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '表扬承办部门', '四级分类': '表扬感谢', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245793-661092', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004922, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 45, 41), '诉求地址': '徐汇区漕宝路虹桥路', '诉求区域': '徐汇区', '内容描述': '市民来电反映:其今天1月3日早上9:31在上述公交车站乘坐93路公交车，市民坐在前面第三排位置，后在四平路漕宝路下车，市民将一个霸王茶姬的袋子遗失在车上，里面有水果和手机，市民没有记下车牌。诉求：希望管理部门核实并协助市民找回物品（需回复）', '工单类别': '次紧急', '处理描述': '2024年1月3日先行联系反映人，在规定时间内给予答复。1、反映人反映情况属实。2、经核实，驾驶员一程一检发现反映人遗忘物品交调度，经电话联系反映人称当天已在93路终点站桂平路江安路调度室领取物品。3、2024年1月4日11:32分由刘女士电话联系沟通，反映人知晓情况满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '物品遗失', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704245975-405812', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005082, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 48, 19), '诉求地址': '闵行区浦江镇恒南路659号', '诉求区域': '闵行区', '内容描述': '市民来电反映:其在上述地址租赁了房屋，现在物业要求支付停车费，300元一个月停车位，费用按照季度或者年交纳，提前退租，停车费用不退，其对交纳规则和费用有疑问，诉求：要求核实费用和收费规则是否有备案过。', '工单类别': '一般', '处理描述': '浦江镇房管所于1月3日与来电人先行联系，并对诉求信息进行确认。经现场查看，停车费的定价是根据物业合同规定内的标准核定的。根据物业服务合同第十二条关于停车位收费的相关规定地面及地下车位租赁费标准为400元/月，现在执行的标准为300元/月，年付3300元的标准，停车收费标准低于物业合同备案价格，收费的周期都是按照房屋租赁的最短周期（不低于一个月）进行收费的，根据租客的承租需求及付款需求进行选择签约的周期及支付方式（月付/季付/年付均可）租赁合同期内不涨价。且在租赁期限内，提前解除本协议的，按实际租赁周期计算，租赁周期不满一个月的按一个月计费。浦江镇房管所于1月22日将解决情况答复来电人，市...', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '乱收停车费', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704246141-661373', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004982, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 48, 39), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民之前买了一辆新能源车，现在卖了。咨询：按规定过段时间是否可以再买一辆新能源车。（已根据知识库告知个人用户申领专用牌照额度条件，市民提出具体问题，要求具体解答。）', '工单类别': '一般', '处理描述': '已于1月4日电话联系用户，经电话沟通用户咨询新能源汽车后是否可以重新申请新能源专用额度的问题。根据新的《上海市鼓励购买和使用新能源汽车实施办法》，本人名下无使用本市专用牌照额度注册登记的新能源汽车、无非营业性客车额度证明、无使用非营业性客车额度注册登记的机动车（不含摩托车）可以申请专用牌照额度。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '改革规划', '四级分类': '新能源汽车', '主办单位': '市经信委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704246078-405895', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005542, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 50, 7), '诉求地址': '徐汇区长桥二村', '诉求区域': '徐汇区', '内容描述': '市民反映：长新二动迁最近公示了动迁困难补助名单，但是在签约前街道人员答应市民是会给其补贴的，现在其去街道问补贴名单里为何没有其，街道的人称其现在不符合发放政策，不是补贴对象。诉求：要求给予补贴。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '长桥街道于1月3日11时22分先行联系市民，并于1月4日14：10致电市民答复：根据《上海市徐汇区国有土地征收补偿困难户、特殊户认定办法》，针对符合条件的居民进行补助。市民不满足上述内容，故无补助。市民对长桥街道的处置表示满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '征收管理', '四级分类': '拆迁安置', '主办单位': '徐汇区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005332, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 50, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:驾驶证转入和期满换证的问题', '工单类别': '一般', '处理描述': '告知信息，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '驾驶员审验', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704246411-661609', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103004962, '工号': 4260, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 52, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【投诉】市民来电反映:投诉12345前话务员4282  查询不到前工单且长时间不说话让市民等待时间过长。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '回拨市民，市民辱骂话务员，前工单已办结告知市民答复要点，市民未表示要重新办理。投诉话务员4282信息保密格式位保密需回复。归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '投诉批评', '四级分类': '问题解决', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704246344-406136', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005452, '工号': 4160, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 53, 7), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:一分所是否可以换证？', '工单类别': '一般', '处理描述': '根据《办理有效期满换证手续》告知，市民认可。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704246732-2699111', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005642, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 53, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704246668-661841', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005372, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 53, 58), '诉求地址': '杨浦区国年路160弄632号302室', '诉求区域': '杨浦区', '内容描述': '市民来电反映:该处地址居民上门敲门，表示漏水，需要其去查看，其已经告知过是房屋问题，但是对方还是来敲门，诉求：要求协调上述地址居民不要敲门。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派五角场街道进行处理。据五角场街道回复：先行联系：接单后，因反映人无联系方式故无法先行联系简告。情况核实：属实。处置过程及回访：因402租客一直不愿意配合，不肯开门解决楼下302被漏水原因，也不让物业维修工进门，造成楼漏水问题至今未解决。居委，物业，楼下多次联系她不愿意理睬，本着谁出租谁负责原则，我们多次联系了402的房东，402房东愿意积极处理漏水问题。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '纠纷协调', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704246448-661650', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005462, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 55, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:新能源车夫妻过户。', '工单类别': '一般', '处理描述': '根据知识库《新能源汽车相关问答合集》提供，市民认可，归档。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '改革规划', '四级分类': '新能源汽车', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704246589-406333', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005402, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 55, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其表示在12123上办理异地过户，市民在预约变更是要其填写车辆属于国产还是进口，市民认为其车辆是进口车辆，现被告知是国产车，让其重新排队预约，导致市民会错过取牌时间，咨询如何处理', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类'