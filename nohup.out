分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103006402, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 10, 15), '诉求地址': '浦东新区梅园新村派出所', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其身份证快要到期1月3日拨打上述地址派出所电话询问换证需要提供哪些材料，告知市民让其拨打户籍科电话，之后其又拨打了户籍科电话（号码:22046341、58783713），都是智能客服无人工客服接听。诉求:望管理部门核实，予以处理。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '【无联系方式，无法联系】上海市公安局浦东分局梅园新村派出所民警接工单后，我所民警根据市民反映的情况进行了核实，之前由于我所户籍咨询电话工作时间接听市民来电较多，会造成遇忙忙音的情况，造成市民的不方便，后我所开通语音功能，有人工专人接听，更有语音留言功能，方便工作人员及时回拨市民的漏接电话，故不能存在无人接听的情况。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704247409-2441880', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103006712, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 10, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:个人消费者要求转接拼多多客服。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704247701-2442152', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007012, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 10, 39), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704247749-2442204', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103006382, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 12, 3), '诉求地址': '闵行区浦江镇', '诉求区域': '闵行区', '内容描述': '市民来电反映:其因为劳动纠纷问题先找到了闵行区劳动检察大队，后被告知找上述区县乡镇社区中心的劳动仲裁窗口处理，市民来到了该窗口，接待的工作人员态度恶劣，在了解市民情况后直接称闵行区总队那边都处理不了，你来我这干嘛，你来找我麻烦吗，后还称女职工的育儿假是妇联的问题，不受法律保护，市民不认可，故来电投诉该存在服务态度问题的劳动仲裁窗口工作人员', '工单类别': '一般', '处理描述': '区人社局于2024年1月3日接单，并于当天下午15:23与市民首次电话沟通，经了解，其系诉求育儿假相关事宜，工作人员耐心解释和回答了其相关问题，市民表示了解了，先前系自己误解了劳动监察和街镇窗口工作人员，但自己还是产妇，希望工作人员对其态度好一点，本着有则改之无则加勉的原则，我局会加强对工作人员的管理监督工作，提升群众满意度。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '服务态度', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704247400-407034', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103006212, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 13, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704247883-662940', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103006362, '工号': 4080, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 13, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【投诉】市民来电反映:其在拼多多上购买了马膏没有说明书，故市民认为是三无产品。向管理部门投诉，管理部门没有联系过市民就将工单办结，市民不认可。诉求：投诉长宁区市场监督管理局不作为，纵容包庇拼多多平台售假行为。前工单编号：20230713012105。（需回复）', '工单类别': '一般', '处理描述': '经核实，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '诉求未解决', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704247377-2699729', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103006952, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 14, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:杨浦区劳动仲裁的电话', '工单类别': '一般', '处理描述': '告知信息，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '劳动争议', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704247917-662962', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007102, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 15, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704248024-663067', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007272, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 16, 7), '诉求地址': '普陀区管弄路251弄43号', '诉求区域': '普陀区', '内容描述': '市民反映：上述地址小区大修，最近几天施工扬尘强烈，影响居民的正常出入和生活。诉求：请管理部门加强施工规范，减小扬尘影响。', '工单类别': '一般', '处理描述': '西部集团下属上海中山物业有限公司在1月3日接到12345热线工单，工单号（2024普陀管字0152956），中山物业1月3日与来电人先行联系，其反映的情况与工单诉求基本一致。中山物业在1月3日对来电人的诉求进行了核实，确认部分属实。现根据相关规定对来电人诉求进行处理，情况如下：经了解，施工方已经在清运渣土和建筑垃圾，并一天两次对施工区域进行洒水，尽量减少扬尘对居民生活的影响。接单后已通知施工方适当增加洒水。多有不便敬请谅解。1月5日，上海中山物业联系人将上述情况告知来电人，来电人表示知晓。附件：录音、图片 联系电话：62242254联系人姓名：祁斌 上海中山物业有限公司2024年1月5日', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': '普陀区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103006912, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 16, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:2024年春节高速免费时间', '工单类别': '一般', '处理描述': '根据《交通运输部关于优化2024年春节假期收费公路免收小型客车通行费时段的通知》告知市民，市民认可，故归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': '高速收费', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704247890-407503', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007052, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 16, 54), '诉求地址': '金山区志诚路585弄22号', '诉求区域': '金山区', '内容描述': '市民来电反映:上述地址电梯坏无法正常使用，多次联系物业报修未果，对市民生活带来影响。诉求：要求管理部门尽快上门维修。', '工单类别': '次紧急', '处理描述': '先行联系时间：2024年01月05日 10时50分 核实认定情况：承办人于2024年1月5日致电市民了解情况，经核查22号楼两部电梯，西电梯处于层门调试状态，十分钟内将完成调试并正常运行，东电梯部分零件需更换。 处置过程和结果：承办人2024年1月5日联系物业及维保单位到场进行维修，东电梯部分零件需更换，将在周末尽快完成。 答复市民反馈情况：承办人于1月9日致电市民回访确认情况，经确认东电梯已于当天完成修理，周末正常使用，同意办结此件。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '