址：长宁区红宝石路533号B1层101室  乐选乒乓球，不是一对一的体育课程，大概还有6500元没用，已经倒闭了。卡号：18918581796，诉求：要求退费。', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，涉及健身培训和体育培训的，根据市培训市场综合治理工作联席会议办公室相关文件及市体育局关于做好体育培训市场治理工作的通知精神，明确对该事项投诉调解的法定职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704176530-342122', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021382, '工号': 2582, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 30, 45), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无明确诉求。', '工单类别': '一般', '处理描述': '无明确诉求。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704175221-2374848', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021162, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 30, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704176977-2634461', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102020982, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 31, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其为员工缴纳公积金，其员工是2023年12月份入职，其为其缴纳公积金，显示单位缴交期是2020年6月份。为何显示2020年6月份。', '工单类别': '一般', '处理描述': '14:31为其转接公积金专席，工号8934老师受理，转接成功,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704176803-597879', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021252, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 33, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:本市户籍，医保暂停，没有工作。如何缴纳医保。', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177080-342632', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021182, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 33, 39), '诉求地址': '浦东新区金丰路99号 机动车检测点', '诉求区域': '浦东新区', '内容描述': '市民来电反映:1月2日市民去上述地址办理摩托车的过户，从上午开始工作人员称系统账户没有续期导致无法办理，为此现场很多人等着，目前14:30了还没有告知何时可以解决，为此市民来电反映。诉求：要求帮忙核实何时可以解决。', '工单类别': '一般', '处理描述': '接工单后，上海市公安局浦东分局交警支队车管宣传大队于2024年1月3日10时28分与来电市民杨先生取得联系，进行先期沟通。 经查，2024年1月2日9时40分，轻便摩托车办理点民警使用PDA准备查验车辆时发现，系统提示账号有效期已到期，无法登录。故大队一方面迅速将PDA故障情况上报总队车管所，请求予以解决。另一方面，民警耐心的向办事群众解释该情况，对于不愿意等待的办事群众，留下了联系方式，待恢复后立即通知，后至1月3日早，PDA方才恢复正常。经办民警将上述情况再次向提问人进行解释，其表示已办结转移登记业务。...', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704176987-2634469', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021332, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 35, 13), '诉求地址': '上海五纷物联技术有限公司', '诉求区域': '本市', '内容描述': '市民来电反映:市民在云智充平台充值了费用，目前还剩余42元的费用，最近其充电桩在小区内拆除了。诉求：希望帮市民退款。', '工单类别': '一般', '处理描述': '您好，我局收到您对上海五纷物联技术有限公司的投诉，经调解，企业反馈已与您取得联系并完成退款，我局决定终止调解。若您仍有疑问可致电企业客服021-61916225或者通过微信小程序12315登记诉求。特此告知。[嘉定区市场监督管理局]', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177169-2634679', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021452, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 36, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多消费问题。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177272-598290', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021422, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 37, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其和其他人被老板骗了钱，现报警后警察告知是合同经济纠纷让其通过法院起诉，其想知道如何处理。', '工单类别': '一般', '处理描述': '根据“不予受理来电的处理流程”告知，市民认可，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177246-2634753', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021222, '工号': 4290, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 39, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。市民表示滴滴司机辱骂市民，市民与滴滴平台反映，平台不处理司机，客服人员提出赔偿市民50元，市民表示不认可。【最近派发的工单编号：20231227013935，工单内容：市民来电反映:其12月27日12:00分乘坐网约车（滴滴车牌号：沪AC99609，蔡师傅）黄兴公寓上车，惠民路800号下车，上车后向师傅反映能不能开一下窗透气，该司机语气不善的说窗户坏了无法打开。在下车的时候该司机还对市民进行辱骂、人身攻击，该司机还有反动言论。诉求：希望管理部门核实处理该司机服务问题，希望吊销其网约车资格证。（需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231227013935，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177045-598105', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102020922, '工号': 4402, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 39, 41), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映：范范而谈', '工单类别': '一般', '处理描述': '范范而谈，提醒三遍，市民主动挂机，故归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704173907-2631673', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021652, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 40, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民在本市缴纳公积金，购房使用商业贷款，是否能申请一次性提取公积金，归还贷款。', '工单类别': '一般', '处理描述': '为市民转接公积金专席，工号8917受理, 此单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177451-2377053', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021512, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 40, 34), '诉求地址': '闵行区七莘路莘谭路上海莘馆乒体育有限公司（乐旋乒乓）', '诉求区域': '闵行区', '内容描述': '市民来电反映:  市民帮孩子报名的上述地址培训机构的乒乓课程，付了7700元学费，还剩余30课时，有合同。现在该机构通知说突然关门了。诉求：要求帮其退费。', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，涉及健身培训和体育培训的，根据市培训市场综合治理工作联席会议办公室相关文件及市体育局关于做好体育培训市场治理工作的通知精神，明确对该事项投诉调解的法定职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177345-342876', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021532, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 40, 41), '诉求地址': '宝山区淞南镇逸仙路张华路', '诉求区域': '宝山区', '内容描述': '市民来电反映:宝山区淞南镇逸仙路张华路，路口有一个通道，往通道内20米左右的位置有路灯不亮，有安全隐患。诉求：希望管理部门核实，并尽快维修路灯。（需回复）', '工单类别': '次紧急', '处理描述': '淞南热线办1.2 16:50先行联系市民，1.4 9:53回复市民。建管中心回复-经核实，居民反映点位为华浜二村通往逸仙路人行步道，该出照明设备线路老化，导致照明登昏暗，已联系市政单位针对老化线路进行维修，确保居民通行安全。以上情况已告知市民。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '电力', '三级分类': '故障报修', '四级分类': '路灯供电', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177332-2634838', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102020552, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 41, 28), '诉求地址': '闵行区宝秀路永德菜场门口路边', '诉求区域': '闵行区', '内容描述': '市民来电反映:闵行区宝秀路永德菜场门口路边，非机动车乱停，诉求：希望管理部门核实制止。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '吴泾镇综合协调部于1月2日与来电人先行联系，并对诉求信息进行确认。经现场了解，该处有街面巡查员做引导，目前已将该处乱停放的非机动车做好停放归为，并做好长效管理。综合协调部部门于1月2日将办结情况向来电人进行答复解释。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '共享单车', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177530-2635042', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021772, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 41, 36), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多上买到了问题产品。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177586-2635088', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102021722, '工号': 3660, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 41, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:发生交通事故18321954192你能否免费代理我的案子？不能的话我就挂了？', '工单类别': '一般', '处理描述': '不能免费代理，只能咨询。可以挂断。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '律师服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177575-598574', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102020962, '工号': 3940, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 43, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其在一网通申请企业注销，但是其误操作了，网站上显示终止注销，但是执照已经寄送出去了，企业信用代码：91310112MACWEMDR8K。诉求：希望管理部门核实，告知解决方案。', '工单类别': '一般', '处理描述': '2024年1月4日，已书面回复，回复要点如下：您好，这里是闵行区市场监管局，您拨打市民热线咨询企业登记事宜，我部门作如下回复：上海睛泓畅视企业管理合伙企业（有限合伙）网上注销申请案已于2023-12-27退回修改，退回意见为：表格P1公司名称填报有误。您可以在“上海一网通办”-“上海企业登记在线”-“进度查询”中查看下一步操作。如有问题，可以咨询我部门咨询电话：021-33885338。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704177425-2634932', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102022252, '工号': 2582, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 43, 55), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无明确诉求。', '工单类别': '一般