 {'工单编号': 20240103007752, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 21, 11), '诉求地址': '长宁区', '诉求区域': '长宁区', '内容描述': '市民反映：公司在长宁有个消防部门的行政处罚，请消防部门指导如何在信用中国上进行信用修复。诉求：请管理部门指导如何操作。（市民要求无需回复）', '工单类别': '一般', '处理描述': '接到市民诉求后，消防部门立即查阅有关历史资料，对该单位的情况，向市民做了解答，指导市民完成具体操作。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '其他', '四级分类': '其他', '主办单位': '市消防救援总队', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007202, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 21, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其丈夫给个人打工被拖欠工资。', '工单类别': '一般', '处理描述': '建议咨询12348，工单归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704248171-2442635', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007332, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 21, 17), '诉求地址': '杨浦区', '诉求区域': '杨浦区', '内容描述': '市民来电咨询:其是南京市民，市民的工资卡被冻结，查到是杨浦刑侦要求冻结的。市民表示愿意积极配合警察调查处理单但一直没有人来联系市民，市民也不清楚杨浦刑侦的联系电话。诉求：希望管理部门能告诉市民杨浦行政的联系电话号码。', '工单类别': '一般', '处理描述': '刑侦总队于2024年1月8日10：59，与来电人取得联系并答复：经查询，市反诈中心没有对市民的银行卡采取保护性止付的数据，建议市民联系银行查询并有针对性处理。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '公安信息查询', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704248220-2442684', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007552, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 22, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:小孩的社保卡无法使用，现其要查询卡的状态。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704248412-407998', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103005652, '