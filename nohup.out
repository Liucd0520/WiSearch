客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '经营性停车场', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704161812-2363788', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102007522, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 28, 20), '诉求地址': '青浦区金泽镇西岑村431号', '诉求区域': '青浦区', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240102004169，工单内容：市民来电反映:上述地址这个地段里面都是社保人员，不是农民，户口本上都是非农户，动迁的房子是自己造的长期在此房子内生活，2023年3月到4月拆迁，按照人数来算，没有为市民加上24个平方，诉求：为市民加上24个平方请管理部门处理（需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240102004169，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '征收管理', '四级分类': '拆迁安置', '主办单位': '12345热线处理', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162291-2364295', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102007582, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 29, 8), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:医保金在上海交了12年，退休年龄到了，医保能否在上海享受。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162362-330695', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102007612, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 30, 8), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其要购买新房。市民咨询相关公积金需缴纳多久才能提取。', '工单类别': '一般', '处理描述': '转接公积金专席成功,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162361-2364378', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102007462, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 30, 35), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其网约车人证刚办理下来了，目前失业，也买了车，需要做网约车，询问车证是否可以办理，在线已经告知《 关于暂停受理网络预约出租汽车运输证相关业务的通告 》，其希望通过热线帮忙做特别申请，诉求：希望有关部门帮忙核实是否有特殊情况的通道。', '工单类别': '一般', '处理描述': '2024/1/2 14:32 发短信：您的建议和诉求已收悉。为维护合规驾驶员的合法权益，促进出租汽车行业健康发展，本市自7月22日零时起暂停受理网约车运输证新增业务。市道路运输主管部门将根据我市网约车行业运力规模，结合网约车合规情况，科学调控出租汽车运力。如恢复办理相关业务，将另行公布，请您予以关注。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162207-330529', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102007492, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 30, 49), '诉求地址': '青浦区朱家角人民医院（靠近珠溪路）', '诉求区域': '青浦区', '内容描述': '市民来电反映:1月2日8:30在上述地址排队约B超单（不清楚医生信息，但就一个医生），咨询怎么约B超单，该医生态度差直接让市民出去。诉求：请管理部门尽快查处医生态度差。', '工单类别': '一般', '处理描述': '经青浦区卫健委调查核实，医院于1月3日收到工单，9:54信访办工作人员先行联系市民了解情况。经调查核实，1月2日上午B超室医务人员均在为患者做检查，市民至B超室隔着检查帘子问心脏超声检查之事，因其行为干扰了医生的工作，该科室一名医生就对其说“出去”。8号医院门办、党办均就调查核实情况向市民解释，并致歉，市民不认可。9号15:28信访办再次联系市民予以道歉并解释：院方已就市民反映的情况与当事人进行批评谈话，要求其改进自己的工作作风和沟通方式。根据医院的规章制度，将对科室及该工作人员进行绩效扣分，同时取消该工作人员当年度所有奖励性资格。市民认可答复。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '服务态度', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162253-330579', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102007662, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 30, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民2023年12月22日在智行APP上购买了机票，订单号：27623573940，现在需要平台开具行程单，但联系公司却告知开具不了，市民不认可。诉求：希望协调帮市民开具。', '工单类别': '一般', '处理描述': '经核实，此单经营者已联系消费者沟通，行程单无法打印，可以提供电子发票，如需电子发票可以直接申请，消费者知晓，达成一致。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '旅游', '三级分类': '服务质量', '四级分类': '旅行社服务', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162388-2364407', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102007842, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 31, 34), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:公积金已经销户了，里面的钱怎么提取', '工单类别': '一般', '处理描述': '转接公积金成功,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162526-330886', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102007752, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 31, 57), '诉求地址': '嘉定区', '诉求区域': '嘉定区', '内容描述': '市民来电咨询:要从江苏昆山的幼儿园转学到嘉定安亭的民办幼儿园', '工单类别': '一般', '处理描述': '根据《嘉定区教育局》告知，认可归档。已发送短信', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '入学入托', '四级分类': '幼托管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162472-2364481', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008032, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 31, 57), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民补充信息：姓名卢进文。该垃圾站几百米范围内有数个大型小区、商场、学校，涉及数万人。该项目环评在大家均不知情下通过满意度调查（90%满意度），不知通过何种手段通过的，严重剥夺了周边居民的参与权。该选址位于交通拥堵路的康新公路边，严重影响居民和旅游群众的出行。对途经居民区车辆泄露的腐臭渣水无任何解决方案，该选址地点位于较大河流边几十米，一旦出现泄露，会严重影响周新场和南汇地区的粮食安全和群众生命安全，违反《浦东新区江南水乡古镇保护办法》通知第十三条第三点。【最近派发的工单编号：20240102006839，工单内容：新场生活垃圾中转站项目规划依据《上海市浦东新区新场镇16号线核心单元PD...', '工单类别': '一般', '处理描述': '我处会将您补充的信息及时转送，请您耐心等待，专此简复', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '卫生配套设施', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102007932, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 33, 2), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162639-2364657', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008082, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 34, 42), '诉求地址': '浦东新区航都路航圆路路口附近，航圆路上', '诉求区域': '浦东新区', '内容描述': '市民来电对办理结果不满，管理部门给其回电表示该处电箱被拉掉了但是并未告知后续安排故其