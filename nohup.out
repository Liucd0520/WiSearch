ne, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015562, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 49, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689271-594753', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015522, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 52, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民是外省市户籍且没有居住证，市民咨询如何在本市申办港澳通行证的签注.', '工单类别': '一般', '处理描述': '根据《外省市居民出入境证件及赴港澳台团队旅游签注“全国通办”（2019年4月1日起施行） 》告知市民，市民认可，归档.', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（出入境）', '三级分类': '签证签注', '四级分类': '签证签注', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689220-2428058', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015812, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 52, 33), '诉求地址': '青浦区徐灵路300号二联馨苑', '诉求区域': '青浦区', '内容描述': '市民反映：房屋自装修去物业办理房屋装修许可证。物业要求必须要有装修资质证书，否则不给办理房屋装修许可证。自装修不动承重墙是否必须要有装修资质证书。另外装修垃圾清运物业要求为建筑面积20元/平方。是否有相关政府收费指导文件。诉求：希望管理部门给予合理解释。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '【此工单内容部分属实】徐泾镇城运中心于2024年1月8日接单，于2024年1月8日首次通过电话先行联系诉求人，告知其问题已经收悉，正在我单位进行办理。2024年1月9日，由二联安居管理办工作人员，对诉求人反映的情况进行核实。办理情况：经核实，二联馨苑小区为动迁安置高层小区，为确保小区的安全及房屋整体完好，保护业主/住户的利益；根据《住宅室内装饰装修管理办法》和《上海市住宅物业管理规定》，制定业主装修手续办理流程，目前已将相关资料提交并经安居办审核通过，可到物业处领取装修许可证后方可进行装饰装修。装修垃圾可由业主自行搬运至建筑垃圾点位，也可委托（付费）物业进行搬运，建筑垃圾必须当天清远至建...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '物业管理不善', '主办单位': '青浦区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015482, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 52, 59), '诉求地址': '宝山区', '诉求区域': '宝山区', '内容描述': '市民来电咨询:市民家中有6口人，现在居住在宝山区，诉求：咨询申请本市经适房条件和具体申请流程', '工单类别': '一般', '处理描述': '经了解，居民户口在崇明区，户籍所在地住房建筑面积180平方米，另有他处住房30平方米，其配偶及小孩户口系宝山区大场镇，户籍所在地住房建筑面积60平方米，现欲申请经适房，咨询相关政策。《上海市共有产权保障住房准入标准和供应标准》的通知（沪房规范[2020]5号）第一条第（二）款：家庭人均建筑面积低于15平方米（含15平方米）。根据其描述的家庭情况，目前家庭人均建筑面积超过15平方米，不符合第十一批共产房申请准入标准。 已电话答复，告知相关情况。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '保障型住房', '四级分类': '经适房', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689164-594678', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015822, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 53, 47), '诉求地址': '嘉定区陇南路绥德路路口', '诉求区域': '嘉定区', '内容描述': '市民建议：陇南路绥德路路口从陇南路向绥德路左转车道早高峰很堵，1个红绿灯有时候只能转过去1部车，交警站着不作为不疏通拥堵，市民表示一个红绿灯应该留15秒给到左转车道。诉求：建议每天有交警指挥或者增加左转交通灯。', '工单类别': '一般', '处理描述': '2024年1月22日10时许，江桥派出所民警电话联系该市民，详细情况如下：经核实，市民反映的陇南路绥德路高峰时段存在多重因素叠加引起通行的情况。针对上述情况，江桥所加强勤务岗位设置和日常管理力度。下阶段，我所将继续开展高峰时段的疏导管理力度，并积极协调各方采取相应措施提升该区域的道路通行能力。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通设施', '主办单位': '市公安局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015622, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 54, 14), '诉求地址': '奉贤区化工产业园区彤程材料厂', '诉求区域': '奉贤区', '内容描述': '市民来电补充信息。市民补充信息内容：现其钱已经拿到了，不需要处理了【最近派发的工单编号：20231220025062，工单内容：市民来电反映:其在上述厂建设油路管道施工，市民表示属于建筑工程领域，有签过劳动合同，老板还拖欠3个工人（王建国，崔晓刚，包显伟）今年8月和9月的工资未支付，金额共5万多元。市民不清楚工程具体地址，好像是在普工路或目华路。老板公司地址在金山廊下镇乐农路228号3栋乐农文化创意产业园。公司名：上海芯如电子科技有限公司。诉求：希望管理部门帮其讨要欠薪。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231220025062，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '建筑工程欠薪', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689523-340328', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015782, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 55, 6), '诉求地址': '普陀区同普路1412号3楼城堡桌球', '诉求区域': '普陀区', '内容描述': '市民来电反映:2023年9月1日-12月底市民在上述门店上班，没有签过劳动合同，12月底离职后用人单位未给市民结算12月的工资，金额5600元左右。市民姓名：尹正考，身份证：5303811995032317916。诉求：希望管理部门帮其讨要欠薪。\n\n', '工单类别': '一般', '处理描述': '2024年1月8日16:55区人社局先行联系来电人了解情况，经协调处置，单位已支付来电人12月工资5600元。1月12日联系答复来电人，称工资收到，无异议。 经办人：何世久，联系方式：66101930 附录音。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '拖欠工资', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689301-2639351', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015832, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 56, 6), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多上买到了问题产品。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689678-2639591', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015732, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 56, 8), '诉求地址': '长宁区', '诉求区域': '长宁区', '内容描述': '市民来电咨询:因斗殴被拘留，期间能探望吗', '工单类别': '一般', '处理描述': '根据《长宁区 天山 公安派出所》告知市民，市民认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689549-594906', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015882, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 58, 7), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民需要转接拼多多专席.', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689775-2428413', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015852, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 8, 12, 58, 10), '诉求地址': '浦东新区罗山路', '诉求区域': '浦东新区', '内容描述': '市民来电咨询处理进度。【最近办结的工单编号：20231221027588 ，工单内容：市民来电反映:12月21日12:00左右其车辆行驶从罗山高架转到S20高速，往浦东机场方向，在转弯处最左边车道路面上有一块混凝土的石头，将其车胎压爆裂，当时已经报警定责，车牌号：沪AGL5093。诉求：请管理部门尽快核实协调赔偿。（需回复） 】', '工单类别': '一般', '处理描述': '按处理描述告知市民，市民认可，此单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': '路状路况', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689694-594985', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015702, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 0, 3), '诉求地址': '杨浦区三门路国权北路吉浦路段', '诉求区域': '杨浦区', '内容描述': '市民来电咨询: 上述地址的人行道一直在施工，不知道是什么工程，也没有施工铭牌，诉求：要求具体是什么工程，需要回复', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派区绿化市容局进行处理。据区绿化市容局回复：先行联系：1月9日 情况核实：属实 处置过程及回访：接反映情况后，我单位立即先行联系了反映人，反映人称上述地址人行道一直在施工，不知道是什么工程道路上也没有施工铭牌。经现场核实，现场放置了三处施工铭牌，第一处设置在逸仙路高架围墙，第二处设置在三门路政青路围墙，第三处设置在三门路淞沪路路口。反映人平时经过并未发现，故我们已在电话中对反映人解释了项目内容以及项目要求。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689495-594881', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016062, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 2, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:商家要求转接拼多多。', '工单类别': '一般', '处理描述': '根据知识库“  关于市民反映“拼多多”相关事项的处理口径 ”告知市民，市民认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704690023-595171', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015552, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 6, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689977-595149', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016242, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 7, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 通话中没有声音.', '工单类别': '一般', '处理描述': '通话中没有声音，归档.', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704690353-595386', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015922, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 7, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2021年11月左右四川北路88号威尔士健身门店办理一张健身卡，卡号WILLS806957，2022年12月左右又在淮海中路1010号门店办理一张会员卡，暂时无法提供卡号，都签订了合同，2023年9月申请退款，共计金额30万元左右，门店称已上报总公司，但总公司至今未退款，市民无法提供总公司地址，诉求：希望管理部门核实，尽快退款（需回复）。', '工单类别': '一般', '处理描述': '经与当事双方联系，确认投诉人在星荟中心门店办理了两张会籍卡共计73100元，目前，威康健身管理咨询（上海）有限公司已以证据不足为由拒绝了投诉人的全额退款申请。本机关将上述事项答复投诉人，建议投诉人寻求法律服务意见，收集证据，通过诉讼途径解决本纠纷。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704689801-595046', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016382, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 10, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，需要转接拼多多', '工单类别': '一般', '处理描述': '转接多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704690517-2428956', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016312, '工号': 4160, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 10, 55), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:线上选号不喜欢是否可以现场选号？', '工单类别': '一般', '处理描述': '根据《新购买的新能源车（机动车）注册登记提供哪些选号途径？》告知，市民认可。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704690510-2640134', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016612, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 18, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:在虹井路614号商场外的婴儿游泳馆（萌果）办了卡，还有五次600-800元余额，现在店关掉了，微信联系不上。诉求：请管理部门核实协调退款 或保证使用。', '工单类别': '一般', '处理描述': '对于婴幼儿游泳不属于体育领域范畴，根据国务院办公厅《关于促进3岁以下婴幼儿照护服务发展的指导意见》（国办发【2019】15号）以及附件《促进3岁以下婴幼儿照护服务发展工作部门职责分工》的规定，均无体育部门的职责分工，故婴幼儿游泳工单不属于文化执法的受理范围。建议市民：依据《消保法》相关规定，寻求消费者保护协会12315的帮助。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704690815-595730', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016632, '工号': 4160, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 19, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:公司名下车需联系方式怎么办理？', '工单类别': '一般', '处理描述': '根据《办理机动车所有人姓名/名称、身份证明名称/号码或住所地址变更手续》告知，市民认可。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704690988-341280', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016472, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 21, 52), '诉求地址': '浦东新区洪山路杨思路交叉口的新世界实验小学', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民来电补充信息。该学校今天又在用扩音设备搞活动产生噪音，请管理部门今天务必解决噪音扰民问题。【最近派发的工单编号：20240105005841，工单内容：市民来电反映:上述地址新世界实验小学近期有彩排，工作日早上9点有外置扩音设备产生噪音扰民。诉求：希望管理部门可以减轻音量避免噪音扰民（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240105005841，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '外置扩音装置', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704691134-595955', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016742, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 22, 13), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费问题，要求转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多专席,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704690961-595832', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016822, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 22, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其名下有一辆车，市民将车辆过户给别人，现别人将车辆开走，市民无法联系到该人员，导致车辆无法拿到，咨询是否可以办理退牌', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704691078-595917', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016672, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 22, 39), '诉求地址': '浦东新区瑞安路308号浦东交警六支队', '诉求区域': '浦东新区', '内容描述': '【重新交办,要求：市民认为答复不明确，其对事故认定没有任何异议，但是对11月15日发生的事故，知道12月28日才给完结，拖延了差不多45天其有疑问，同时针对交警对套牌车上路的处理结果不够明确，另外办案民警敷衍了事，违规操作都没有任何处理答复，市民被自己的车险公司追问事故后续结果，为此市民无法告知车险公司，投诉：针对套牌车上路的事情是否有解决，以及针对违规套牌上路如何处理的，以及诊断结论是要求明确回复。最近办结的工单编号:20231212002654，工单内容:【投诉】市民来电反映:11月15日市民和快递员发生交通事故，警察认定同等责任，快递员对事故认定有争议，目前车辆（沪DHQ823）一...', '工单类别': '一般', '处理描述': '上海市公安局浦东分局交警支队六大队民警于2024年1月9日12时47分与凤斌取得联系。针对提问人反映情况。经查提问人家属于2023年11月15日18时30分许在康新公路秀浦路处发生交通事故。六大队民警在18时51分接报后到场处置，因现场双方对责任认定有异议，民警遂扣留双方事故车辆并移事故组处理。11月16日事故双方至六大队进行事故处理，双方各自填写《道路交通事故当事人陈述材料》，并查看相关道路视频。11月17日下午15时许，双方再次来六大队进行调解但双方均对承办民警的解释说明不认可。民警根据双方要求开具《道路交通事故检验鉴定委托书》委托第三方对对方车辆进行检测。12月16日，鉴定中心出具...', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '办事效率', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704690867-595769', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016892, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 23, 31), '诉求地址': '宝山区盘古路 海尚明城', '诉求区域': '宝山区', '内容描述': '市民来电咨询:上述地址有一个幼儿园，想了解是否有开设托班的计划，希望管理部门核实告知', '工单类别': '一般', '处理描述': '已与来电市民联系，告知区教育局学前教育科咨询电话，具体事项可致电咨询，相关内容已告知市民，市民表示了解。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教