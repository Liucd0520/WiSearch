: '1704420012-860020', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105006532, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 15, 24), '诉求地址': '徐汇区东泉路188弄', '诉求区域': '徐汇区', '内容描述': '市民来电补充信息。市民补充信息内容为市民表示其有接到施工方的电话，但该问题不是施工方能处理的，而是政府管理方面的问题，故市民要政府部门尽快处理该问题并联系其。【最近派发的工单编号：20231230003035，工单内容：市民来电反映:上述地址小区11月开始进行上水管道整治，推倒了许多房子，导致扬尘十分之大，市民表示都无法开窗，影响了市民的生活，并表示停车也很不方便。诉求：希望管理部门核实并减少扬尘影响。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231230003035，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704420339-860306', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105007062, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 15, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接美团', '工单类别': '一般', '处理描述': '转接美团专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704420807-81535', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105006432, '工号': 4080, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 16, 29), '诉求地址': '普陀区中潭路100弄322号一层', '诉求区域': '普陀区', '内容描述': '市民来电反映: 2023年9月底，市民花费了22000元。定制了上述地址的上海尚铭居家居装饰有限责任公司的厨房和卧室柜子，该商家承诺1个月内完工，但至今没有完成。市民也联系不上负责人刘曼（15711639856）。给市民带来很大的困扰。诉求：请管理部门核实，要求必须在过年前完工，对市民的损失作一定的补偿。（需回复）', '工单类别': '一般', '处理描述': '经沟通，上海尚铭居家局装饰有限公司已经和消费者达成调解协议。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704420242-2164425', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105007272, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 17, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一