，告知其问题已经收悉，正在奉城镇城建中心进行办理。1月18日上午9.25时，由奉城镇城建中心房管科室，对来电人所反映的情况进行核实，并进行了现场处置（经核实：奉贤区塘外文化小区是集资房小区，小区已进行了奉贤区老旧小区综合改造项目，并已通过了验收。由于小区自身原因，在老旧小区综合改造项目时，划了四十二个停车位。属地居委对小区停车管理进行了征询，征询结果大多数业主同意（附征询汇总表和停车收费方案）。故反映人所反映人的问题属于述求过高。附照片。），已经将处置结果告知来电人，该问题诉求过高。经办人...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '奉贤区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704695055-599554', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108020562, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 8, 14, 28, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询处理进度。【最近派发的工单编号：20240102033393，工单内容：市民来电反映:在2023年8月在上海的公司离职就不交社保了，但一直有一笔4000的工资到账上，市民一直没收到过钱，现有新工作两个公司打钱而产生了一笔个人税需要交，上海这边的工资一直没有实际到账，市民反映之前在浦东新区临港新城第六人民医院（东院）食堂工作，诉求：请管理部门核实情况，取消不应产生的个人税。】', '工单类别': '一般', '处理描述': '已告知市民管理部门正在处理中，建议市民耐心等待，市民认可，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704695176-2689827', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108020472, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 8, 14, 28, 34), '诉求地址': '宝山区大场镇祁华路318号兄弟烧烤店', '诉求区域': '宝山区', '内容描述': '市民来电反映:市民来电反复催单。【最近派发的工单编号：20240106018759，工单内容：市民来电反映:上述地址烧烤店在营业时会产生油烟，油烟扰民，具体营业时间不清楚，现诉求：希望管理部门对该油烟扰民的情况核查处理。（需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240106018759，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '油烟扰民', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704695037-599534', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108019792, '工号': 3022, '工单生成时间': datetime.datetime(2024, 1, 8, 14, 28, 34), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【为企服务】市民来电咨询:要求转接闵行区工商专席，咨询企业注销问题。', '工单类别': '一般', '处理描述': '转接闵行区工商专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名