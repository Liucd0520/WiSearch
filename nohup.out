70, '工单生成时间': datetime.datetime(2024, 1, 3, 17, 38, 23), '诉求地址': '青浦区观云路258号盛青云驰苑', '诉求区域': '青浦区', '内容描述': '市民来电反映:上述地址没有按照合同规定，没有整改完就交房。开发商：青浦盛驰置业。绿化报备与实际面积不一致，也没有三书一证，也没有安装相应品牌的新风系统，也没有通水就交房。诉求：投诉开发商违规交房。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '此工单诉求内容不属实。1、市民反映绿化面积与报备不一致，经查该项目已取得【关于核发青浦区盈浦街道观云路北侧 21-04 地块项目【竣工规划资源验收合格证】的决定】（沪青规划资源验〔2023〕0125...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '其他', '四级分类': '其他', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704274270-728679', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103030772, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 3, 17, 41, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:外省市婴儿在沪如何申请疫苗接种，需带什么材料，以及四川新能源车如何转到本市。', '工单类别': '一般', '处理描述': '根据“ 新能源汽车专用牌照申领“一件事”问答合集 ”告知市民，市民认可，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '疾控防疫', '四级分类': '其他疫苗', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704274424-2509382', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103030982, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 3, 17, 42, 7), '诉求地址': '徐汇区宜山路700号C5栋汇富天下', '诉求区域': '徐汇区', '内容描述': '市民来电反映:起在上述地址公司中办理了pos机，可在市民未得到通知的情况下上涨了税率，市民不认可，故来电', '工单类别': '一般', '处理描述': '根据《全国金融行业咨询投诉电话》', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704274755-2767316', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103031072, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 3, 17, 44, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接“拼多多”。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704274897-2767394', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 202