型': '综合服务', '通话编号': '1704446642-2967693', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029482, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 28, 56), '诉求地址': '浦东新区金高路佳林路', '诉求区域': '浦东新区', '内容描述': '市民来电反映:对于上述地址路口的辅警执法方式不认可。', '工单类别': '一般', '处理描述': '根据,《上海市公安局对外服务窗口一览表》告知，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704446630-2231577', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029502, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 29, 3), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:法院电话打不通。', '工单类别': '一般', '处理描述': '根据《浦东新区人民法院》相关信息告知，市民认可。归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '法院系统', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704446641-925839', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029912, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 31, 24), '诉求地址': '杨浦区平凉路滨江百联店', '诉求区域': '杨浦区', '内容描述': '市民反映：瑞竑健身接手原一兆韦德，现原一兆韦德会员无法进入健身，瑞竑设立了预约制，每天限制时间、名额，严重违反消费者权益。诉求：请管理部门帮助维权。', '工单类别': '一般', '处理描述': '上述场所已停业歇业，根据《上海市单用途预付消费卡管理实施办法》第二十四条规定和《上海市区级文化综合执法机构单用途预付消费卡投诉调解流程》，我单位于2024年1月16日将该投诉移送至杨浦区体育局处理。我单位将在收到区体育局回函后告知投诉人。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029512, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 31, 36), '诉求地址': '浦东新区政务服务中心惠南分中心', '诉求区域': '浦东新区', '内容描述': '【表扬】市民来电咨询:其1月5日下午在上述地址办理提交建设项目竣工验收申请书的时，工作人员林佳萍，工号0198，工作认真细致，同时市民向她咨询了后续的事情需要提供什么证件时，该工作人员很耐心，很认真地帮市民从资料库里面找寻需要的材料，并且在有其他同事来找其办理其他事情的时候，对方会优先办理市民的事情，全程态度和蔼可亲，让市民感到很温暖，来电对该工作人员进行表扬。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '感谢市民对我们工作的认可和支持！浦东政务服务中心会继续为企业营造更好的营商环境而再接再厉！', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '表扬承办部门', '四级分类': '表扬感谢', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704446671-925861', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029622, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 31, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:居住证制卡进展。', '工单类别': '一般', '处理描述': '帮其转接社保卡专席，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704446987-2231724', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029732, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 32, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704447083-926033', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029472, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 33, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民重复来电反复催单，要求尽快处理答复。【最近派发的工单编号：20240104031848，工单内容：市民来电反映:其是上述地址的居民，邮政快递从不送货上门，单号：9857562452172，诉求：要求送货上门今后都是如此。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240104031848，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704446916-2967825', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029582, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 35, 20), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其小孩在本市读初三，现要进行一摸考试要求在1月8日把材料提交到学校，其居住证3月17日到期，现其因该特殊情况要提前办理居住证签注，已告知市民持证人应当在居住证签注期限届满之前的30日内，到本市任一社区事务受理服务中心办理签注手续，但市民对此不认可。诉求:望管理部门核实，协调提前让其办理签注手续。（需回复0', '工单类别': '一般', '处理描述': '同意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证办理', '主办单位': '市人口办', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704446904-925961', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029802, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 37, 49), '诉求地址': '闵行区莘松中学', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述地址学校九年级的语文老师陆胜存在违规开班情况，该老师私自在自己家中开始补习班，这是违规行为，故来电投诉（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '市民您好，您反映的诉求区教育局收悉并办理，办理情况是：经过与老师本人核实，确有几位亲朋好友的孩子在家里接受义务辅导，学校对老师的行为进行了批评教育，宣讲了有关法规和政策。感谢您的理解。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '学校管理', '四级分类': '教师素质', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704447240-2231829', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029872, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 40, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:单位，失业保险稳岗补贴的返还，2024年是否还有。', '工单类别': '一般', '处理描述': '2024-01-08 08:45:59致电，关于您咨询的问题。根据沪人社规（2018）20号《关于实施失业保险援企稳岗“护航行动”的通知》的规定告知， 五、其他 （二）本通知自2018年5月1日起实施，有效期至2020年12月31日。目前暂未收到2024年失业保险稳岗返还的通知。您表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704447427-2968056', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105030162, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 41, 12), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704446451-146640', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105030152, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 42, 3), '诉求地址': '杨浦区延吉东路125弄19号、18号', '诉求区域': '杨浦区', '内容描述': '市民反映：上述地址楼道口均有电瓶车飞线，还有杂物堆积，存在消防隐患，居委不作为。（详见附件）诉求：请管理部门整治飞线及堆放杂物问题。', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派长白新村街道进行处理。据长白新村街道回复：先行联系：接单后，我单位于1月5日先行联系来电人 。 情况核实：经核实，来电人反映的情况属实，已查看现场。来电人反映的问题，诉求合理合法 处置过程及回访：1月8日，街道平安办和居委会一同上门进行了劝阻和教育，对居民反映的飞线充电现象和堆物进行了整治，飞线充电行为已消除，电线已剪断，堆物已清理。下一步，平安办将督促居委会、物业加强管理，加强巡查，及时发现、消除安全隐患。我单位于1月18日电话告知市民处理结果，其表示知晓', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '杨浦区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029892, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 42, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:  留学生落户对于社保缴费的要求。', '工单类别': '一般', '处理描述': '根据《本市落实留学回国人员申办上海常住户口有哪些规定？》告知，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '就业创业', '四级分类': '人才引进', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704447456-147060', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029992, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 44, 4), '诉求地址': '浦东新区东靖路东沟北路东沟新村', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述小区在2023年上半年进行了管道改进，施工过程中破坏的绿化至今未恢复，另外物业将现有绿化铲除改建停车位。诉求：请管理部门核实，要求恢复绿化。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '市民您好：经高行镇房办核查，东沟三村小区绿化管理事宜，高熠物业已补种绿化，考虑到冬天绿植可能存活率低，若仍未长出或未存活，至春天天气好转再进行二次补种。高行镇房办要求高熠物业做好居民解释工作，加强小区绿化管理。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '绿地绿化', '四级分类': '占绿毁绿', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704447584-2231979', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105029982, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 5, 17, 44, 15), '诉求地址': '闵行区双柏路1688弄88号401', '诉求区域': '闵行区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，市民家中晾衣架至今未被修复，还说市民家晾衣架是违法的，诉求：尽快修复市民家中晾衣架。最近办结的工单编号：20221015005181，工单内容：市民来电反映:上述地址楼栋的外墙脱落砸坏了市民家中晾衣架，联系物业至今没有处理结果。市民表示担心有安全隐患。诉求：希望管理部门能尽快督促物业尽快进行处理。】', '工单类别': '一般', '处理描述': '