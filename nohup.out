e, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109007882, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 29, 17), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:本市户籍灵活就业退休年龄', '工单类别': '一般', '处理描述': '转接人力资源成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动人事制度', '四级分类': '退休离休', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767200-410933', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109007842, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 29, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其是网约车司机，和平台是合作关系，投诉平台对其罚款', '工单类别': '一般', '处理描述': '按照《  关于出租车营运管理相关事项的派单规则 》告诉市民超受理范围，建议咨询12348通过司法途径处理，市民认可归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767167-410901', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109007802, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 30, 21), '诉求地址': '嘉定区安亭镇方泰村村委会', '诉求区域': '嘉定区', '内容描述': '【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,对方拿着修缮房屋的手续却在做房屋翻造，为此市民认为对方就是在违法翻造房屋，另外市民也没有得到任何村委会的联系。诉求：要求拆除违规翻造的房屋。最近办结的工单编号:20231226006314，工单内容:【重新交办，要求：答复要点不明确，市民表示管理部门一直答非所问，1：749号是属于造房，并不是大修，没有相关的建房手续。2:：与村委会多次反映749号的地基移位了，但是村委会还是无视表示就是大修。诉求：请管理部门核实749号的建房资格有没有证，如果没有相关造房资格请尽快拆除，另外还需投诉方泰村村委会不作为的现象。最近办结的工单编号...', '工单类别': '一般', '处理描述': '嘉定区安亭镇：接热线后，2024年1月9日10:48:42先行联系。经安亭镇规土管理所、镇农业服务中心核实，方泰村749号危房修缮，由村委备案进行日常监管，不经过镇建房领导小组审批。经方泰村核实，该户为危房修缮，手续齐全。村委于2023年10月15日、24日、26日多次电话告知，且期间诉求人也曾多次至村委会询问，村委也都给予劝解与答复，不存在诉求人所述的没有得到任何村委会的联系。9月6日、11月23日邀请规土所、派出所、信访办等多个部门对双方进行调解，均无法统一协商结果。村委于2024年1月9日、10日、16日又进行多次调解。目前749号房屋因家庭矛盾暂停建造，待双方签署调解书后再进行建...', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '社区家政', '四级分类': '社区服务网点', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767118-665233', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109007922, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 30, 31), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:医保卡遗失，自费支付，咨询如何报销。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767233-665358', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109007632, '工号': 4260, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 30, 54), '诉求地址': '江苏省', '诉求区域': '江苏省', '内容描述': '市民来电咨询:其参保地是苏州，办理的苏州医保卡，2023年能使用该卡直接在上海就医报销，2024年却不行。市民咨询社区被告知要办理异地就医备案。市民咨询能否不办理该备案直接就医报销。', '工单类别': '一般', '处理描述': '转接江苏12345专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767027-2499711', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109008082, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 32, 43), '诉求地址': '虹口区海伦路88弄6号1602室', '诉求区域': '虹口区', '内容描述': '市民来电反映:上述地址房屋内存在群租现象，客厅被分割出租。诉求：请管理部门核实，依法处理。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '接单后，街道群租专班组于1月12日赶到海伦路88弄6号1602室，会同海伦居委干部一起对该房屋进行检查，经检查，该是三房二厅房屋，厅内有切割二间房屋，是属群租房。工作人员在房门上张贴限期整改《告知书》，并与二房东取得联系，要求在规定时间内限期整改，街道群租整治专班组也将在2月初进行检查，二房东表示同意并承诺将在2月初整改。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '群租现象', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767413-2756555', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109008022, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 33, 4), '诉求地址': '金山区枫泾镇新元村7组5078号', '诉求区域': '金山区', '内容描述': '市民来电反映:上述地址市民家中未装排污管粪便都在外面，对周围市民生活带来影响，市民多次联系有关部门和村委未果。诉求：要求管理部门协调处理解决。', '工单类别': '一般', '处理描述': '先行联系时间：2024年01月9日 10时38分 核实认定情况：经核实，2019年农污改造项目对新元7组5078号（诉求人户）纳管施工时，该户污水池纳管涉及到邻居家的自留地和竹林地。由于邻里矛盾导致该户不能纳管，村委会多次做调解工作但收效甚微。并非是承办单位和村委会不同意纳管，不愿意解决。 处置过程和结果：目前村委会继续进行相关协调工作，能早日做通隔壁邻居的思想工作。 答复市民反馈情况：已反馈诉求人，诉求人未评价。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '水务', '三级分类': '排水排污管理', '四级分类': '排水工程', '主办单位': '金山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767301-2756439', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109008032, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 34, 29), '诉求地址': '普陀区', '诉求区域': '普陀区', '内容描述': '【为企服务】市民来电反映:用电子营业执照登陆社保和公积金都无法登陆，显示“用户验证失败，请稍后再试”，想看一下是不是电子营业执照有问题。', '工单类别': '一般', '处理描述': '转接为企服务成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704767330-665453', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109008102, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 34, 35), '诉求地址': '嘉定区马陆镇育绿路育绿小区', '诉求区域': '嘉定区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240109004361，工单内容：市民来电反映:2024年1月9日早上9:30市民在上述地址通过曹操出行平台叫了网约车前往虹桥火车站，车牌：沪AG87015，市民只是让司机帮助市民搬一下行李箱放在车子后备厢，结果司机不断骂人，市民非常气愤，几分钟后市民无法忍受司机的态度要求停车下车，市民为了继续叫车还支付了15元车费。诉求：投诉司机骂人的态度问题，要求就此事给市民一个解决方案回复市民。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240109004361，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767402-411129', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109008312, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 35, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:货车司机，拉了一车韵达的货，但是韵达恶意扣钱。', '工单类别': '一般', '处理描述': '根据“  不予受理来电的处理流程”已告知市民，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767570-2500311', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109008172, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 36, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:机动车要解除抵押是否可以委托他人代为办理。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767519-2756669', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109008242, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 36, 25), '诉求地址': '松江区九亭镇', '诉求区域': '松江区', '内容描述': '市民来电咨询:单身申请廉租房以及丧偶加母亲两个人申请廉租房具体的政策，市民本市无房且无业，咨询具体如何申请需要什么材料有哪些房源。', '工单类别': '一般', '处理描述': '有政策信息，诉求合理。保障中心于2024年1月10日联系市民，并确认其咨询的问题。电话中已告知申请廉租房的基本条件，具体可去申请人户籍所在地的社区事务受理服务中心廉租房受理窗口咨询和申请。2024年1月10日答复市民，市民表示满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '保障型住房', '四级分类': '廉租房', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767538-2756691', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109008052, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 37, 16), '诉求地址': '黄浦区黄陂南路838弄3号B139-1单元上海茹品餐饮管理有限公司', '诉求区域': '黄浦区', '内容描述': '市民来电反复催单，请管理部门尽快处理并回电联系市民。【最近派发的工单编号：20240109006897，工单内容：重新交办，交办要求，已按答复市民要点答复市民，市民表示办结报告和实际情况不符，市民没收到回复，只有短信说办结了，要求评价，市民不认可，要求重新处理并联系市民。最近派发的工单编号:，工单内容:市民来电反映:其称上述地址企业已经线上办理了工商注销，线下办理的食品经营许可证注销，其表示证件齐全已经验收完毕完成食品经营许可证的注销，但是线上显示企业食品经营许可证未注销，联系工商的工作人员告知是系统原因无法操作，其表示企业在物业有缴纳押金，物业线上查询企业食品经营许可证没有注销拒绝退还...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240109006897，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704767341-2500063', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109008572, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 38, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '