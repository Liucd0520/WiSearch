分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101009422, '工号': 4260, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 28, 19), '诉求地址': '浦东新区大团镇董村三组508号', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址市民家中空气开关坏了几天了，找不到电工维修，市民家无法正常用电，诉求：请管理部门尽快派人进行修复。', '工单类别': '次紧急', '处理描述': '接单后，大团镇金石村村委会工作人员于1月2日9:02分先行联系诉求人，经了解，诉求人反映的上述情况，诉求人表示已自行解决，已处理完毕。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '电力', '三级分类': '故障报修', '四级分类': '独户停电', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704090077-2304615', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101009462, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 31, 14), '诉求地址': '本市拼多多', '诉求区域': '本市', '内容描述': '市民来电反复催单，请管理部门尽快处理。【最近派发的工单编号：20231222006642，工单内容：市民来电反映,11月26日在拼多多买的仁和生露补片吃了自己没反应了，订单编号：231126593672324570377，诉求：希望管理部门协助退款。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231222006642，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704090537-3086971', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101009552, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 33, 7), '诉求地址': '长宁区拼多多', '诉求区域': '长宁区', '内容描述': '市民来电反映:其是消费者，要求转接拼多多专席处理', '工单类别': '一般', '处理描述': '转接拼多多专席处理成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704090673-2304812', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101009542, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 41, 17), '诉求地址': '浦东新区龚华路（龚丰路-银峰路）', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述路段路边有划停车位，但还是有车辆在车位满的情况下在车位空隙处违章停车，导致拥堵严重，数量：20辆左右，时间段：7:00-8:30，17:00-22:00。市民诉求：希望管理部门对于该处违章停车现象进行整治，以及对于道路拥堵是否可以取消路边停车位。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '由于市民先生/女士无联系方式，上海市公安局浦东分局交警支队三大队民警无法与其取得联系，针对提问人反映的违停情况，大队属地中队已安排警力加强该路段道路交通日常秩序管理，要求中队岗位民警加大巡逻力度，巡逻过程中发现不按规定停放的车辆，对驾驶员在现场的及时批评教育并督促立即驶离，对驾驶员未在现场的车辆及时拍照通知车主进行挪移，对未按规定时间挪移的车辆进行处罚。另如要取消停车位，提问人可向镇政府反映，由镇政府向交警部门提交申请,交警部门不受理个人申请。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704090581-3086985', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101010082, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 41, 38), '诉求地址': '无', '诉求区域': '本市', '内容描述': '重复录音', '工单类别': '一般', '处理描述': '重复录音', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704091128-2305017', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101009812, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 42, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其在拼多多某商家处购买了几件衣服，现在申请退货退款被商家拒绝，市民想申请拼多多介入处理。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704091222-272383', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101010072, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 44, 58), '诉求地址': '嘉定区安礼路258弄 小区内步行街', '诉求区域': '嘉定区', '内容描述': '催单原因。市民反复催单。【最近派发的工单编号：20231225029790，工单内容：市民来电反映:上述小区内有一个步行街，但是有很多非机动车停放和通行，存在一定的安全隐患，市民希望管理部门可以加强监管，诉求：请核实处理。（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231225029790，工单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101009722, '工号': 4260, '工单生成时间': datetime.datetime(2024, 1, 1, 14, 46, 43), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:房产税相关减免政策。', '工单类别': '一般