05992, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 1, 44), '诉求地址': '徐汇区', '诉求区域': '徐汇区', '内容描述': '催单原因：市民补充信息其当时要求提供保修记录，但是对方百般拒绝，不清楚到底是什么依据不能提供，希望管理部门协调给予合理说法。【最近派发的工单编号：20240108009896，工单内容：市民来电反映:其是康健路25弄18号402，楼上漏水多年未解决，现在要走人民调解，需要962121提供历年保修的记录，962121说只能提供2年的，要所有记录必须公检法过来，市民不认可，这是查自己的报修记录，还没走诉讼，故来电投诉962121。（需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240108009896，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704765549-2754722', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109006122, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 3, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:大学生医保，生病住院自负费用能否再报销', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704765716-2754877', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109006332, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 5, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:消费者要求转接拼多多。\n', '工单类别': '一般', '处理描述': '转接多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704765838-664035', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109006162, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 9, 10, 5, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其之前失业领取失业金，现找到工作上班，但企业无法缴纳入其社保金，现咨询：如何办理。', '工单类别': '一般', '处理描述': '未查询到信息，转接人保局老师答复成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '养老保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704765722-663926', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109006152, '工号': 4240,