ime.datetime(2024, 1, 3, 15, 41, 7), '诉求地址': '青浦区赵巷镇沪青平公路松润路', '诉求区域': '青浦区', '内容描述': '【重新交办，要求：答复要点不明确，“建管所已向区级部门反映有关问题”后续如何处理，未告知。市民表示就十几个人没给，其余人都给了。诉求不变，尽快处理。最近办结的工单编号：20231201018321，工单内容：市民来电反映:其2022年在上述地址建筑工地工作，被封控2个月的补贴未发放，金额为每月2000多元，未签署劳动合同，涉及人数十几个。施工单位上海七建，建造公共卫生中心。诉求：希望管理部门核实补贴发放情况，尽快发放。\n】\n', '工单类别': '一般', '处理描述': '诉求人反映疫情补贴问题，青浦建管所多次联系总包单位建工七建，要求落实处理。施工单位表示，因为建设单位（政府投资）拒付，故总包单位也无法落实解决。建管所已向区级部门反映有关问题。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '建筑工程欠薪', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704267365-723775', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103023862, '工号': 3832, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 42, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其未成年于2023年9月至12月，使用其苹果账号，通过市民支付宝，共计充值5517.11元，市民表示已反馈至游戏公司当地的12315，管理部门回复需苹果公司的当地政府监管，市民称已向苹果公司提交未成年充值申请退款材料，苹果公司不退款，市民不认可。诉求：请管理部门协助市民退款。', '工单类别': '一般', '处理描述': '同意。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '文广影视', '三级分类': '文化产业管理', '四级分类': '游戏动漫', '主办单位': '市新闻出版局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704266297-722833', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103024872, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 42, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其的公司名下有一辆新能源汽车，现在公司名称变更了，行驶证也要一起变更，然后车管所告知必须去经信委操作，需要去经信委的E起充进行额度认证，然后经信委要求在二手车交易市场做一个关联，市民表示经信委的流程不合理，因为其并不是二手车的问题，虽然其也照做了。诉求：请管理部门督促经信委优化变更流程并要求合理解释。', '工单类别': '一般', '处理描述': '已于1月4日电话联系用户，经电话沟通用户咨询单位名称或证件号码变更如何申请新能源汽车专用牌照，单位用户名称变更的，如果不涉及证件号码变更，只需凭单位变更的相关资料，前往市公安局交警总队车辆管理所办理转移登记即可，具体需要哪些资料，建议咨询车辆管理所；如果证件号码也发生变化，变更手续视同二手新能源汽车转移登记，相关流程可查询《关于上海市鼓励购买和使用新能源汽车实施办法二手车相关操作流程的通知》。', '客户类型': '企业', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '改革规划', '四级分类': '新能源汽车', '主办单位': '市经信委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704267336-2761861', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025012, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 43, 29), '诉求地址': '闵行区罗秀路1362号', '诉求区域': '闵行区', '内容描述': '【为企服务】市民来电咨询:其企业使用上述地址注册企业，但在线申请多次被退还，称地址不符。', '工单类别': '一般', '处理描述': '转接为企服务专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704267493-2762021', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103024512, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 44, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【投诉】市民来电反映:没有收到管理部门的回复，反映的问题就直接被办结。诉求：投诉管理部门不作为，要求必须联系市民。（相关工单编号：20231212019474）', '工单类别': '一般', '处理描述': '相关投诉举报的处理符合法定程序，依据《市场监督管理投诉举报处理暂行办法》处理。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704266966-723406', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025032, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 46, 22), '诉求地址': '浦东新区周浦镇年家浜路40号（上海融悦典当有限公司）', '诉求区域': '浦东新区', '内容描述': '重新交办，要求：按答复要点告知市民，市民表示答复要点不明确。市民认为5000元违约金费用过高、不合理。诉求：望管理部门核实，要求告知此违约金收取是否合理、如合理要求出具明文规定文件。（需回复）【最近办结的工单编号：20231212024348，工单内容：市民来电反映:市民2023年5月30日上上述地址的典当行当了手链和项链，当时商家告知市民12月4日之前去拿，市民因为当时在外地，市民使用手机告知商家，市民随后12月8日电话商家表示要去店里拿回手链，后来市民临时有事没有去，商家消息通知市民告知如果不来就算为绝当，市民于12月9日将钱款汇给该商家，但是商家要收市民5000元的违约金，市民认为...', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市地方金融局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704267508-723906', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025442, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 46, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704267897-2762411', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025572, '工号': 3802, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 49, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704268032-2762540', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025482, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 50, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，平台拒绝处理推卸责任。市民要求管理部门告知一直不答复的原因。请管理部门尽快处理。【最近派发的工单编号：20231228017527，工单内容：【投诉】市民来电反映:投诉长宁区市场监督管理局不作为不给市民处理问题，市民表示自己询问过消保委的，平台就是有连带监督职责责任的，市民拨打12345转接市场监督管理部门专线也一直无人接听，要求继续进行投诉，市民表示自己是抑郁症患者因为长宁区迟迟不解决问题整晚整晚睡不着觉，造成身体出现问题都在借钱看病，要求上海市市场监督管理局亲自核实情况，不要再把工单下发到长宁区，要求市局亲自处理答复，要求...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231228017527，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704267936-2504657', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025722, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 51, 13), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704267936-2504657', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025492, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 52, 7), '诉求地址': '长宁区天山路市场监管所', '诉求区域': '长宁区', '内容描述': '市民来电反映:在12315上投诉拼多多虚假广告商业欺诈，转到了天山路市场监管所，天山路市场监管局答复已经向已经处理过了，不能重复受理，实际其根本没有向市场监管部门投诉过。诉求：请管理部门核实投诉天山路市场监管所不作为', '工单类别': '一般', '处理描述': '我局天山所于2024年1月4日接单，于1月9日14点42分与诉求人先行联系并答复。经核实，我局依法依规处理投诉举报件，不存在不作为的情形。关于诉求人提出的问题，我局工作人员已经与诉求人进行联系并解释说明。〔相关投诉不受理原因已向其告知〕。 经办单位：天山所。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704268134-724473', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026262, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 57, 6), '诉求地址': '无', '诉求区域': '本市', '内容描述': '重复来电', '工单类别': '一般', '处理描述': '重复来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704267372-468474', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025462, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 57, 26), '诉求地址': '宝山区高境二村居委会', '诉求区域': '宝山区', '内容描述': '市民来电反映:市民是残联人员，目前残疾证二级已认定。市民联系高境二村居委会询问残疾补助事宜，姓奚的工作人员得知市民是外地户口，态度恶劣。市民从2019年至今，高境二村的两任书记对市民都照顾有加，给市民补贴并发米发油。目前居委会换了一个书记，该奚同志告知，因换新书记所以不理旧事，外地户籍的残疾人没有补贴。市民认为受到了不公平的对待。诉求：要求管理部门核实，对该同志的服务态度进行处理，并请高境二村的居委书记考虑市民的残疾情况对市民采取照顾措施。', '工单类别': '一般', '处理描述': '我办接单后联系居委会，于3日16点11联系市民，居委会回复针对市民反应的情况，外地户籍的残疾人补助和补贴的问题，居委会方面目前已经帮助市民进行了解决，我办回访市民表示满意。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '服务态度', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704267913-724271', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026082, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 57, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704268560-724855', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025892, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 58, 17), '诉求地址': '嘉定区 清水路小学', '诉求区域': '嘉定区', '内容描述': '市民来电反映:其孩子在清水路小学上学，学校要求孩子上学必须穿全套校服，但是最近天气太冷，校裤又非常薄，希望学校考虑到学生的身体状况，放宽规定，让孩子可以穿自己的厚裤子上学。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '区教育局：学校根据校服管理制度，要求学生在校期间统一穿着校服。冬季，学校规定学生穿着冬装（冲锋衣外套及加绒长裤），家长可根据气温及孩子体质决定校服里面的穿搭，以确保保暖。进入寒冬，学校对穿着冬季校服灵活要求，也提示学生可以穿着自己的保暖服装。如果孩子身体情况特殊，家长可向班主任提出穿着自己厚裤子。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '其他', '四级分类': '其他', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704268394-2505090', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025262, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 0, 53), '诉求地址': '黄浦区马当路368号SOHO复兴广场C楼  行吟信息科技（上海）有限公司', '诉求区域': '黄浦区', '内容描述': '市民来电反映:12月22日，通过小红书购物，小红书客服一开始告知12月27日发货，并且页面上的宣传发货时间也是12月27日，但一直到2024年1月3日都没有发货，市民期间多次询问客服，也只是让消费者再等两天，结果平台于2024年1月2日发送短信，告知预售时间是1月22日，让市民继续等待，下单页面没有任何提示，多次联系客服也没有告知，订单编号：P718786330411266901，市民都有聊天记录，市民询问具体发货时间以及对于商家误导消费者发货时间的情况应该如何处罚售后，平台客服都说不知道，只是给市民发送了一个短信，没有和商家以及消费者沟通，诉求：要求明确告知对于商家误导消费者发货时间的...', '工单类别': '一般', '处理描述': '经核实，投诉人在小红书平台购物的第三方店铺（NOIR DESIR旗舰店；经营主体：上海趣帛服装设计中心；经营地址：上海市长宁区延安西路2299号07K30室）实际与行吟信息科技（武汉）有限公司签订入驻协议，其经营地址为：武汉东湖新技术开发区光谷三路777号A办公楼402-196号，不属于我局管辖。经调解并与平台方确认：投诉人已签收所购商品，平台考虑到商家发货超时可协调补偿其50元薯券，无法满足更高补偿诉求。依法终止调解，建议投诉人向店铺经营地或行吟信息科技（武汉）有限公司经营地市场监管部门反映。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704268179-2504893', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026192, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 1, 42), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704268689-2505355', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103025682, '工号': 4342, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 2, 46), '诉求地址': '松江区', '诉求区域': '松江区', '内容描述': '【为企服务】市民来电反映:一网通上，办理法人变更业务，资料都提交上去后发起一个流程，一直没收到回馈的信息，不知道下一步该怎么操做。', '工单类别': '一般', '处理描述': '转接松江区市场监管局成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704268649-2505320', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026452, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 3, 32), '诉求地址': '浦东新区浦东新区东方路818号西广场裙楼2楼上海虎啸保安服务集团有限公司', '诉求区域': '浦东新区', '内容描述': '补充信息。市民来电反映：已解决，不需要管理部门处理了。【最近派发的工单编号：20231217008929，工单内容：市民来电反映:上述地址保安公司存在使用没有保安证的保安上岗。用工地址：嘉定区裕民南路1777弄远香舫新苑、嘉定区南翔镇嘉美路268号云湖漫城、嘉定区柳湖路1188弄柳湖景庭、汇丰荷苑二期柳湖路481弄、嘉定区城固路55弄远香坊嘉苑、嘉定区汇景华庭二期嘉定唐公路99弄、嘉定区秋竹路1008弄秋竹坊、嘉定区徐行镇启悦路420号香格里花园、浦东新区浦城路786弄1-3号滨江兰庭、嘉定区嘉定环城路1560弄北水湾名邸、嘉定区皇庆路88弄日月光伯爵天地鼎固君庭、嘉定区望安路701号嘉...', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231217008929，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704268777-2763220', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026282, '工号': 2820, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 5, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其公公已经去世询问老年综合津贴属于哪个银行发放。', '工单类别': '一般', '处理描述': '根据津贴系统查询，告知市民，并提供《   常用电话号码一览表  》认可，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '养老保障', '四级分类': '老年津贴', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704268778-469695', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026652, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 7, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704269103-725336', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026302, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 7, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:于2023年12月28日已完成单位注册资本变更，为企业入职留学生办理落户使用。现新营业执照已获取，但落户系统内注册资本项目至今未变更，导致无法为员工办理落户。单位名称：蒲钛信息咨询（上海）有限公司。诉求：望管理部门核实，要求告知如何变更，或协助尽快变更。（需回复）', '工单类别': '一般', '处理描述': '市民的诉求属实，松江区人社局于2024年1月5日接单，1月8日10时45分，松江区人才服务中心致电市民，就其反映的诉求向市民进行了相关解释，市民表示该公司注册资金已变更但一网通办后台未更新，区人才中心工作人员表示手动变更注册资金需提交营业执照复印件至人才中心窗口，再由工作人员交由市人才中心处理。市民表示已知晓。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '外省市迁入', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704268776-2505432', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026622, '工号': 2820, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 7, 25), '诉求地址': '宝山区镇泰路388弄', '诉求区域': '宝山区', '内容描述': '市民来电要撤单。【最近派发的工单编号：20240103013328，工单内容：市民来电反映:物业目前正在小区内乱砍伐树木，修剪过度。诉求：请管理部门核实，尽快制止修剪过度行为。（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '告知市民“关于市民要求撤单的处理口径 ”认可，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704269109-2763519', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026682, '工号': 3662, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 8, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:外省市车辆转籍到上海，显示预受理成功，但是上海没有信息，要求转接车管所专席。', '工单类别': '一般', '处理描述': '转接车管所成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704269142-470020', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103026692, '工号': 2890, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 9, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:在拼多多平台上买了婴儿推车，等不了15个工作日的处理时