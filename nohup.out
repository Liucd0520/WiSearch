职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106009752, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 17, 11), '诉求地址': '本市淘票票', '诉求区域': '本市', '内容描述': '市民来电反映:市民在淘票票上购买了滑稽戏票，现在因为骨折无法去，市民提供了医疗证明，对方还是拒绝，让大麦网给市民回复，诉求：要求退票，需要回复， 订单号：3704721915214044420', '工单类别': '一般', '处理描述': '2024-1-6 13:02:40致电市民，市民表示付款给到大麦网，现因为自身原因要求大麦网全额退款。已告知市民北京大麦文化传媒发展有限公司（大麦网）为北京属地管理企业，其公司主体及上级主管部门都在北京，故如要投诉该企业，需要联系当地管理部门进行投诉。消费源头（付款方）在哪里，退款还是要找源头。市民表示已知晓并会联系当地主管部门进行维权。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '文广影视', '三级分类': '文化产业管理', '四级分类': '文化活动', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704514381-204889', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106009652, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 18, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:来电咨询长江大桥被封锁，如何第一时间得知解封时间。', '工单类别': '一般', '处理描述': '建议市民关注上海发布，市民认可，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': '路状路况', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704514134-204772', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106009902, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 18, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其是个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704514651-3027157', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106009912, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 21, 42), '诉求地址': '静安区延长中路451弄10号103室', '诉求区域': '静安区', '内容描述': '市民来电反映:2024年1月6日103室卫生间，地上都是污水，天花板也是有漏水的，装修刚半年，称是203漏水，203室不住人的，诉求：希望尽快维修。', '工单类别': '次紧急', '处理描述': '进华物业13564137981回复：203室将马桶管道进行改道，导致管道经常堵塞漏水至103室，物业多次上门疏通，203室不配合整改，且203室现在家中房屋空关，物业多次向居委求助反映，该203室户主均不接物业及居委电话，导致无法沟通协调处理，现物业已另想方案将2楼以上总管全部外接出去，问题已解决。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704514672-984204', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106010092, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 23, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要求转接拼多多专席。', '工单类别': '一般', '处理描述': '转接《拼多多专席》成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704514945-2245792', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106010062, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 24, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704514983-984357', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106010152, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 28, 52), '诉求地址': '本市  得物APP', '诉求区域': '本市', '内容描述': '市民来电反映: 市民在上述平台花费了1171元购买了一双圣诞定制版的NIKE鞋, 订单号:110140561791879157,市民试用后发现鞋面掉色和裂开,市民联系平台未解决，诉求: 希望管理部门核实协调平台为市民全额退款.(需回复) ', '工单类别': '一般', '处理描述': '2024年1月10日短信告知已受理。经调解双方达成一致，得物APP平台可补偿消费者200元现金。 2024年1月15日将上述情况电话告知消费者，消费者表示认可企业处理方案', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704515054-205218', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106009962, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 33, 18), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '重复来电：咨询处理进程。【最近办结的工单号：20231208030685，工单内容：【投诉】市民来电反映：其多次和我处反映抖音商城的消费问题，抖音商城也承认问题，但拒绝补偿，但承办市场监督官局并不作为，也没有进入调解，每次都是拖到最后一天回复其，称抖音说保证金已经都赔付了，无法给其赔付，让其报警，后续也让其把话说完直接挂断了电话，诉求：投诉承办部门不作为的问题进行处理，希望上级管理部门核实处理并尽快落实解决其的问题。（需回复）前工单编号：20231122006716\n', '工单类别': '一般', '处理描述': '已解释，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704514746-2245698', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106010282, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 37, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其于1月5日在“摩天轮”APP上购买了1月7日张惠妹的成都演唱会门票，订单号：24101020576，支付了1145多元，当时的票面价显示是680，但结果出来的票是380，其联系平台的客服询问能否改成680的票或者重新购买，但平台答复说不行，并称是随机做选择的，有可能出来是680的票，可有可能出来时380的票，市民对此不认可，表示购票时的界面上并未明确说明出票是随机的。诉求：请管理部门尽快核实处理，协助市民改成680的票或者退票退款。', '工单类别': '一般', '处理描述': '2024-1-10 17:29联系市民，经协调，已将市民投诉反馈给平台，平台回复:1/6 联系用户告知订单为选座购票，指定座位信息下单，不看票面。本场演出：2023年12月29日23:59时起停止退票。无法满足用户退票诉求。用户不认可挂断。故双方协商无果，根据《中华人民共和国消费者权益保护法》、《中华人民共和国民法典》合同编，向市场监督管理部门或消保委咨询投诉，市民表示知晓。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '文广影视', '三级分类': '文化产业管理', '四级分类': '文化活动', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704515287-205325', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106010262, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 40), '诉求地址': '崇明区前裕公路502号18栋210室上海禾滢信息科技有限公司', '诉求区域': '崇明区', '内容描述': '市民来电反映:在上述地址公司的好会挑平台上购买衣物，该衣物是假货，并存在质量问题。订单编号：20240101210939884，金额：138元。购买时间1月1日。诉求：请管理部门核实，协调一个合理的解决方案。', '工单类别': '一般', '处理描述': '由于双方无法达成调解协议，根据《市场监督管理投诉举报处理暂行办法》第二十一条第(五)项的规定，我局依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务