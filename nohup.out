e}, {'工单编号': 20240103028602, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 42, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其有一起交通违章，市民不认可，对违章有异议，其拨打12123的电话想了解一下如何申诉，但是12123这个电话一直打不通，其不认可，投诉12123电话无人接听，要求给其合理解释。（需回复）', '工单类别': '一般', '处理描述': '上海市公安局交警总队于2024年1月4日15时10分电话联系来电人，告知本市12123语音热线平台工作时间为工作日的上午9时至11时30分、下午13时30分至17时，因近期公安交管业务咨询量增加、市民集中咨询，热线平台座席接线员较少，造成热线平台出现占线情况无法接入人工服务。市民对一起电子监控拍摄的交通违法有异议，在交管12123APP上申诉后被驳回，告知可至线下交警支队违法审理窗口再次申辩。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704270863-471432', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103027872, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 44, 6), '诉求地址': '宝山区大华二路', '诉求区域': '宝山区', '内容描述': '市民来电咨询:包工头不给其工资的问题。', '工单类别': '一般', '处理描述': '已解释归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271028-2507411', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103028662, '工号': 4272, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 44, 7), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:希望查询其医保交了几个月', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271297-471750', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103027982, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 46, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是新办企业，使用电子营业执照登入一网通办平台，登入时，页面提示：证书未生效【2006】，咨询如何解决该问题。', '工单类别': '一般', '处理描述': '已通过短信告知市民，并告知其联系方式，若有问题可继续咨询。', '客户类型': '企业', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '办事流程', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704271404-2765383', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103028822, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 47, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:车辆夫妻变更后，车险保费上涨一倍，要求投诉保险公司。', '工单类别': '一般', '处理描述': '非受理范围，建议拨打12378热线，归档。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '金融', '四级分类': '保险监管', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271474-2765430', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103028442, '工号': 1110, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 48, 18), '诉求地址': '普陀区曹杨路903弄', '诉求区域': '普陀区', '内容描述': '【重新交办，要求：市民来电反映，答复要点与实际情况不符，当时就是不让进小区，直到最后也没让进，结果货物是一车车运出小区的。而且反映后也接到过电话，对方当时是说有些车放进去了就很久不出来，因此不让放进去。市民表示该小区的保安以前也有不让市民的外牌车进入的情况。故请管理部门再次核实处理。最近办结的工单编号:20231203015362，工单内容:市民来电反映:12月3日17:20搬家，物业保安不让车进小区，故来电投诉，请核实处理。】', '工单类别': '一般', '处理描述': '曹杨街道于01月04日接单，经查该工单已在工单号20231203015362答复来电人；事发当日搬家在小区门口搬家作业，堵塞小区出入主干道造成影响。所属社区保安并非不让其进入小区而是需要当事人移位不要堵住出入口，我处置部门已要求当事保安注意沟通态度避免发生争执。 责任人：吴琳 62095192', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271101-471592', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103028902, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 49, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231225018317，工单内容：市民来电反映:营业执照地址变更，从浦东新区至奉贤区，线上办理税务方面业务，仍显示营业执照地址为原地址，未推送相关信息，向相关部门反映，让其联系热线，催工商部门更新推送相关信息，公司名称：上海槿瑞祥咨询管理合伙企业（有限合伙），诉求：希望管理部门尽快核实并及时更新推送相关信息（需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231225018317，故归档。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271564-2507832', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103028972, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 50, 11), '诉求地址': '长宁区茅台路191号', '诉求区域': '长宁区', '内容描述': '市民来电反映:上述地址居民楼从9月份开始电梯施工，但是至1月3日都未完成施工，希望管理部门核实尽快完成施工投入使用', '工单类别': '一般', '处理描述': '天山街道于2024年1月4日接单，于1月4日17时先行联系来电人，告知其问题已收悉，正在我单位进行处理。由我单位科室对来电人所反映的情况进行核实，经核实，茅台路191号小区加装电梯施工已进入收尾阶段，施工单位于在1月15日报送特检院，特检院将于1月15—20日之间开展验收工作，1月20日出电子报告。待特检院出具报告后居民即可使用电梯。该问题已经解释说明，来电人满意。经办人：自治办', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271612-727290', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103029402, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 51, 13), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704270617-726570', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103028802, '工号': 4080, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 51, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 台办电话。', '工单类别': '一般', '处理描述': '根据《市台办联系方式 》告知，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '涉港澳台', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271423-727147', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103028882, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 52, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:于2023年4月28日通过“拼多多”网购一款酱香型白酒，订单号：230428610203156041455，金额：1031.97元。收货后未使用，于2023年12月底通过“抖音”了解此酒生产厂家并无生产许可证。已向平台反映，被告知自行找品牌方，平台方无法处理。暂未向12315反映。诉求：望管理部门核实，要求退货退款。（需回复）', '工单类别': '一般', '处理描述': '"经拼多多平台协调，已与投诉人协商处理，投诉人已接受，双方协商达成一致。 "', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271547-2507818', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103028782, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 53, 28), '诉求地址': '嘉定区慈竹路265弄', '诉求区域': '嘉定区', '内容描述': '市民来电补充信息。其问物业保安噪音问题解决了没有，物业经理金经理就辱骂其，态度非常恶劣，还要报警，其不认可，请管理部门督促居委会电话联系其处理该物业经理。【最近派发的工单编号：20231229034882，工单内容：市民来电反映:其是上述地址居民，其因隔壁邻居家家中空调噪音扰民要求物业金经理派人上门协调，但是物业不作为迟迟未派人员协调并且上门查看的保安随口就说了一句没声音，以及市民告知楼下点哦平车乱停放的问题多次反馈物业都存在不作为。诉求：请管理部门核实该物业是否存在不作为做出投诉。（需要回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231229034882，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271410-727135', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103029192, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 54, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接“拼多多”。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704271988-2508118', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103029622, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 57, 56), '诉求地址': '浦东新区严杨路', '诉求区域': '浦东新区', '内容描述': '市民反映：2024年1月3日16:45，经过上述地址发现人行道无法通行，整条路堆了修剪下来的绿植，行人只能走快车道，存在安全隐患。（详见附件）诉求：请管理部门尽快清理绿植。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '花木街道城建中心养护单位接单后立即核实，派人清理，作业人员在1月8日8:46分清理完成，感谢对我们工作的理解和支持。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': '道路安全', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103029642, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 58, 28), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综