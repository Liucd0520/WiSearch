CREATE TABLE database_info (
	id INTEGER NOT NULL AUTO_INCREMENT, 
	database_info_name VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL COMMENT '数据源名称', 
	status TINYINT NOT NULL COMMENT '数据库状态：0、停用；1、启用' DEFAULT '0', 
	database_type VARCHAR(100) NOT NULL COMMENT '数据库类型', 
	host VARCHAR(100) NOT NULL COMMENT '主机地址', 
	port INTEGER NOT NULL COMMENT '端口', 
	user_name VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL COMMENT '用户名', 
	database_name VARCHAR(100) NOT NULL COMMENT '数据库名', 
	driver VARCHAR(100) COMMENT '连接驱动', 
	password VARCHAR(100) COMMENT '密码', 
	pool_size INTEGER COMMENT '连接池大小', 
	max_overflow INTEGER, 
	pool_timeout INTEGER, 
	pool_recycle INTEGER, 
	pool_pre_ping INTEGER, 
	description VARCHAR(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci, 
	create_time TIMESTAMP NULL COMMENT '记录创建时间' DEFAULT CURRENT_TIMESTAMP, 
	update_time TIMESTAMP NULL COMMENT '最后更新时间' DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP, 
	selected_tables VARCHAR(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci, 
	is_semantic_analysis TINYINT COMMENT '启用语义搜索：0、否；1、是' DEFAULT '0', 
	primary_key_name VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '主键名称', 
	unstructrued_column VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '向量化字段列', 
	large_step VARCHAR(100), 
	small_step VARCHAR(100), 
	window_size VARCHAR(100), 
	min_samples VARCHAR(100), 
	max_samples VARCHAR(100), 
	target_table VARCHAR(100), 
	milvus_status INTEGER, 
	PRIMARY KEY (id)
)ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='数据库连接信息' COLLATE utf8mb4_0900_ai_ci

