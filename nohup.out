: None, '新五级分类': None}, {'工单编号': 20240106022952, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 7, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:1月6日17:30分通过饿了么叫餐，显示超时，商家名称：便依坊，商家表示不负责，只是通过饿了么平台反映的，其损失了1个多小时，金额：88元，已经退款了，订单号：不知道，用13501290105注册的，庞女士，店家在北京。诉求：要求饿了么总公司给到回复。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '您好！您对“饿了么”的投诉事项，因双方协商未能达成一致，“饿了么”拒绝进一步调解，根据《市场监督管理投诉举报处理暂行办法》第二十一条第一款第（三）项的规定，我局依法终止调解。建议依据《中华人民共和国消费者权益保护法》第三十九条的规定主张诉求。[普陀区市场监管局]', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704542508-2302558', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106022922, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 7, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704542461-2302543', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023122, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 13, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其是拼多多的个人消费者，要求转接拼多多客服。\n', '工单类别': '一般', '处理描述': '转接拼多多绿色渠道服务热线成功,归档。\n', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704543039-3084123', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023152, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 17, 53), '诉求地址': '宝山区红林路582号战狼海鲜烧烤龙虾店', '诉求区域': '宝山区', '内容描述': '市民来电反映:1月6日20：13分左右该处餐厅内有许多顾客抽烟扰民，其有照片，反映老板未制止，现诉求：望管理部门尽快查处整治。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '经现场核查，店铺内禁烟标识张贴到位，未发现抽烟行为，故目前证据不足以立案，且对经营者开展了控烟规定的普及教育。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '禁烟控烟', '四级分类': '禁烟控烟', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704543150-216513', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023132, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 18, 57), '诉求地址': '金山区', '诉求区域': '金山区', '内容描述': '市民来电反映:其孩子现在在金山区就读，其需要办理少儿住院基金亮证，是在金山区旗舰店办理，但是其孩子户籍在浦东新区。如何办理。', '工单类别': '一般', '处理描述': '根据《2023年少儿住院互助基金管理办公室在哪里？咨询电话是多少？》告知市民金山区  联系电话57970058，市民表示认可，此单归档。', '客户类型': '个人', '一级分类': '社会团体类', '二级分类': '其他', '三级分类': '其他社团', '四级分类': '红十字会', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704543104-216498', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023082, '工号': 3262, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 19, 10), '诉求地址': '长宁区 拼多多', '诉求区域': '长宁区', '内容描述': '市民来电反映:其在拼多多购买一双男式鞋子，金额：200多元，订单号：240102223331030402681，其是帮球队购买，快递物流显示商家要求退回，至今其没有收到快递，其联系商家，商家称不清楚何原因，其联系客服，客服称联系物流，让物流给其发货，结果现在物流信息显示退回，其认为客服在欺骗其，现在需要投诉拼多多客服，要求转接拼多多', '工单类别': '一般', '处理描述': '告知市民拼多多客服态度问题热线无法受理，转接专席忙线中，建议市民后续再来电帮其转接，并告知转接时间，市民认可，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704542895-2302659', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023242, '工号': 3662, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 20, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要求转接拼多多绿色通道。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704543505-995642', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023172, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 20, 27), '诉求地址': '浦东新区张杨路生命人寿大厦附近（近崂山路的）', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址的整段路，路灯坏了，一直在闪烁。诉求：请管理部门尽快维修。（信息保密 无需回复）', '工单类别': '次紧急', '处理描述': '尊敬的市民您好！该处路灯已修复完成。感谢您对浦东城市管理工作的理解和支持，处置单位：上海浦东工程建设管理有限公司。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '电力', '三级分类': '故障报修', '四级分类': '路灯供电', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704543195-2302750', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023512, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 22, 31), '诉求地址': '徐汇区天钥桥路903-4号(上海游泳馆地铁站2号口步行440米)', '诉求区域': '徐汇区', '内容描述': '市民反映：1月5日在上述地址的快客龙超市(天钥桥路店) 购买了一包蛋糕，查看包装之后发现不对，发现该产品已过期2天，商家明知不能售卖过期食品的情况下还售卖过期食品（详见附件）。诉求：要求商家按食品安全法第148条，退1赔10不足1000赔偿1000，并给予书面或电话回复。', '工单类别': '一般', '处理描述': '未查见涉嫌违法行为。', '客户类型': '个人', '一级分类': '安全监管类', '二级分类': '食品药品安全', '三级分类': '安全管理', '四级分类': '食品安全', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023322, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 28, 49), '诉求地址': '宝山区纬地路65号803室', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述地址的住户安装空调外机的位置不对，近期空调老化，该空调外机发出非常大的噪音，扰民严重，市民表示该处租户不是很配合处理，房东又联系不上，诉求：请管理部门尽快处理噪音问题。', '工单类别': '一般', '处理描述': '经了解，目前双方已进行沟通协调。已告知诉求人如后续有需要协助可联系居委、物业寻求帮助。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704543683-262184', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023732, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 32, 18), '诉求地址': '奉贤区奉城镇农贸新村1幢1号2楼', '诉求区域': '奉贤区', '内容描述': '市民反映：奉城镇农贸新村1幢1号2楼上海勤澄物业有限公司门口的机箱上有贴纸广告（详见附件），楼道内有公积金贷款广告。底楼楼道内电瓶车乱停放。诉求：投诉奉城镇房管中心周蕾监管不力。', '工单类别': '一般', '处理描述': '奉城镇于2024年1月8日接单，于1月8日上午首次通过电话先行联系来电人，告知其问题已经收悉，正在奉城镇城建中心进行办理。1月15日上午10.30时，由奉城镇城建中心房管科室，对来电人所反映的情况进行核实，并进行了现场处置（浩贤物业接到热线后已现场处置，现已清除，附照片。），已经将处置结果告知来电人，该问题已经实际解决。经办人房管中心, 联系电话57515613。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '物业管理不善', '主办单位': '奉贤区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023362, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 33, 5), '诉求地址': '虹口区新市北路1433号', '诉求区域': '虹口区', '内容描述': '市民来电反映:市民于2021年9月份带着坏了停掉的手表到”宝山区三门路501号华润万家1楼钟表店（靠近服务台边上）“去修，手表存在走走停停的情况，工作人员答复说他们这边修不了，可以帮其送到上述地址的总部去修，过了2个星期的时间工作人员联系市民让其过来取手表，说是里面一个零件坏了，收了其300元的维修费，其拿到手表戴了1个月不到的时候又出现了问题，且问题和之前一样走走停停的，其联系上述地址的张老板反映该问题，想要退回300元维修费，但对方一直不理睬其。诉求：请管理部门核实处理，协助市民退还300元的维修费。', '工单类别': '一般', '处理描述': '被诉单位表示投诉人反映不属实，拒绝调解，依程序规定做终止调解处理', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704543762-995710', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023392, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 33, 18), '诉求地址': '崇明区鼓浪屿路999弄50幢201号401室，和睦家苑', '诉求区域': '崇明区', '内容描述': '【要求，按答复要点告知市民，市民表示答复要点不明确，刚交付的新房这么快出现问题，只是按保修条列保修与开发商口头回复不清晰也不明确。希望开发商能够提供具体的保修承诺书，免得物业以后不负责任。诉求：请管理部门核实，协调一个更好的处理方案。最近派发的工单编号:20231228029444，工单内容:市民来电反映:上述地址未动迁后摇号所得新商品房，2023年7月份交房，装空调后发现两个卧室和客厅的强烈有裂痕。已通过物业找到开发商进行维修。诉求：市民要求对有裂痕的房屋后期使用如有维修问题给予妥善处理方案。】', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704543911-2302911', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023412, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 33, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704544129-3084366', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023492, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 36, 51), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其家人有个残疾人，目前生病住院了，询问住院除了享受本市正常的医保报销外，是否还有残疾人情况的额外医保报销。', '工单类别': '一般', '处理描述': '转接《医保专席》成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704544402-995839', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023572, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 38, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要求转接拼多多专席。', '工单类别': '一般', '处理描述': '转接《拼多多专席》成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704544604-995890', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023432, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 39, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其太太是外省市人员，在家带孩子。是否可以参加灵活就业人员参保。（需回复）', '工单类别': '一般', '处理描述': '2024-01-08 10:05:39 致电，关于您咨询的问题，根据《关于灵活就业人员参加本市职工基本养老、职工基本医疗保险有关问题的通知》沪人社规（2023）5号 第一条 本通知所称灵活就业人员是指年满16周岁且男性未满60周岁、女性未满55周岁，在本市劳动就业的自雇人员、无雇工个体工商户、未在用人单位参加基本养老、医疗保险的非全日制从业人员以及其他灵活就业人员。包括符合上述条件的本市户籍人员、外省市户籍人员、港澳台居民、获得在中国永久居留资格的外国人，以及以集体参保的方式，在本市农民专业合作社（联合社）和家庭农场从事农业劳动的从业人员，均可以在本市参保。您表示了解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '养老保险', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704544254-262310', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023582, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 6, 20, 40, 17), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704544681-262398', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106023692, '工号':