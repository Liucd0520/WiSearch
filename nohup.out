.datetime(2024, 1, 1, 9, 44, 32), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704073414-1001413', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101002502, '工号': 2562, '工单生成时间': datetime.datetime(2024, 1, 1, 9, 46, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:上海市民，护照掉了，咨询补办信息。', '工单类别': '一般', '处理描述': '根据,《2024年元旦假日期间出入境办证窗口接待安排》,《本市户籍居民及驻地在本市的现役军人办理出入境证件手续》知识库告知，认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（出入境）', '三级分类': '护照办理', '四级分类': '护照办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704073093-1001316', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101002842, '工号': 4272, '工单生成时间': datetime.datetime(2024, 1, 1, 9, 47, 58), '诉求地址': '浦东新区绿洲康城亲水湾', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址小区御秀路上小区门口，市民无法告知具体门牌号。有渣土堆放，好几天了无人清理。诉求：请管理部门核实清理（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '市民您好，您反应的情况绿洲康城第三居委已收悉，未告知具体门牌号无法核实，我居委管辖的两个小区均在康桥路上且无渣土堆放情况。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '倾倒渣土', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704073376-1001402', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101002922, '工号': 4272, '工单生成时间': datetime.datetime(2024, 1, 1, 9, 50, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:农商银行APP无法查询明细\n', '工单类别': '一般', '处理描述': '根据《不予受理来电的处理流程》告知，市民知晓，归档。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '金融', '四级分类': '银行监管', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704073670-266655', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101002792, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 1, 9, 53, 20), '诉求地址': '奉贤区', '诉求区域': '奉贤区', '内容描述': '市民来电咨询:其3月份在奉贤区的一家公司入职，3月份发生工伤事故，骨折，到奉贤区社保中心走流程，鉴定为10级伤残，补助金审核不通过，因为其3月份缴纳的社保是补缴的，其还想在单位继续工作，不愿意走仲裁流程，咨询还有什么其他方法可以获得伤残补助金。（需回复）', '工单类别': '一般', '处理描述': '2024-01-02 13:14:16致电，关于您咨询入职时发生事故，单位未按规定办理参保手续，后续补办参保手续补缴了社保，因鉴定为10级伤残，社保告知因单位补缴社保，一次性伤残补助金无法通过工伤基金支付，因您表示想继续在单位工作，不想申请劳动仲裁，想了解是否有其他方式可以获得补偿。告知，根据《上海市人力资源和社会保障局关于执行<上海市工伤保险实施办法>若干问题的意见》，第十二条...', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '工伤保险', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704073514-266613', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101002902, '工号': 2562, '工单生成时间': datetime.datetime(2024, 1, 1, 9, 55, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:2024年货车要申请通行证，咨询申请规定。', '工单类别': '一般', '处理描述': '如何办理本市货运车通行证？ 告知，并转接专席，认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704073900-266724', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101002822, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 1, 9, 55, 50), '诉求地址': '松江区泗泾镇新家园路30弄30号301室', '诉求区域': '松江区', '内容描述': '市民来电反映:上述小区在做外墙翻新的施工，目前施工工人在铲外墙，将居民安装的燃气排气管道给砸了，市民在使用时废气无法排出都排到市民家中，联系淋浴器售后发现由于废气管道被施工工人砸掉了，才出现使用热水器有阻滞，目前外墙翻新施工已进入尾声向物业反馈，物业也不解决（市民表示物业要换届选举了，目前小区很乱）诉求：望管理部门核实并且落实施工完成后家中热水器废气管道排放的安装问题。', '工单类别': '一般', '处理描述': '松江区12345市民服务热线接单后，派单至 泗泾镇。经分管领导签批同意，市民诉求部分属实。泗泾镇房管所于2024年1月2日先行联系市民，并对工单问题描述进行确认。镇房办与市民联系时，市民表示有让空调售后师傅上门检查热水器，检查下来无任何问题。但因为施工方此前有拆装这一动作，市民怀疑是施工方损坏家中热水器。后再次上门查看解释，市民表示已购买新热水器、不再追究该责任。2024年1月9日电话答复市民，市民表示满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704073338-2298947', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101003042, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 1, 9, 57, 50), '诉求地址': '徐汇区古宜路189号ETC中心', '诉求区域': '徐汇区', '内容描述': '市民来电咨询:古宜路189号ETC中心1月1日是否开门接待。', '工单类别': '一般', '处理描述': '根据知识库“ETC（沪通卡） 服务网点信息 ”告知市民，市民认可故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': 'ETC使用', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704074089-1001605', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101003112, '工号': 2562, '工单生成时间': datetime.datetime(2024, 1, 1, 9, 58, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:社保卡', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704074243-2299247', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101003232, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 1, 10, 3, 12), '诉求地址': '杨浦区佳木斯路315弄45号', '诉求区域': '杨浦区', '内容描述': '市民来电反映:市民是上述地址居民，反映45号楼停电，（所在小区是否停电不确定）。市民没有提前接到通知。诉求：请管理部门核实，对该楼突然停电没有沟通一事给市民一个说法，告知市民停电的原因并停到什么时候，并尽快恢复供电。', '工单类别': '次紧急', '处理描述': '(市区供电公司)市区15启东东鑫王艳峰，赶赴现场进行故障抢修，于01月01日10时36分到场核实，现场表箱表位全部有电正常，用户内部均用电正常，于01月01日10时45分告知客户现场情况（先前已有国网抢修工单编号：202401074536291，经查为调试站内电压设备。故障已于01月01日10时02分修复已处理完毕，现场已全部恢复供电），客户知晓。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '电力', '三级分类': '故障报修', '四级分类': '规模停电', '主办单位': '电力热线', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704074388-1001712', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101003252, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 1, 10, 5, 38), '诉求地址': '杨浦区宁国路杭州路', '诉求区域': '杨浦区', '内容描述': '市民来电反映:上述地址有无证设摊现象，设摊时间5:00-10:00还没结束，主要贩卖小吃，影响通行，诉求：希望管理部门协调取缔无证设摊现象。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派大桥街道进行处理。据大桥街道回复：先行联系：大桥街道工作人员于1月1日与来电人进行了电话简告。情况核实：经核实，来电人反映的情况属实，对于来电人反映的问题，诉求合理合法。 处置过程及回访：执法人员至现象发现该处存在乱设摊情况，并开具当场处罚决定书。处罚号为：当2407020036号 。中队将加强上述地址的巡逻频次，一旦发现违规现象及时整治。上述情况大桥街道工作人员于1月16日与来电人进行了电话回复，来电人未评价。目前，该市民诉求：解释说明。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '