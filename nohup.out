, 3, 24), '诉求地址': '浦东新区芳春路400号一栋三层上海卓迈汽车技术服务有限公司', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民来电反映:上述地址公司使用的CAD软件存在侵权行为，是盗版软件，软件属于其公司代理所有，其公司名称：欧特克中国软件研发有限公司，也是本市企业，诉求：请尽快核实查处。（市民要求信息保密 需回复）  ', '工单类别': '一般', '处理描述': '市民称：承办部门已联系，告知市民提交材料后处理，市民表示目前还未提交，建议尽快提交处理，市民认可。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '知识产权', '三级分类': '知识产权', '四级分类': '侵权行为', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704358726-69811', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104028732, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 4, 17, 5, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:自己一直是个人缴纳社保的，现在要停止缴纳，问是否可以网上办理，委托办理需要什么材料，市民身份证：310108198902271017', '工单类别': '一般', '处理描述': '2024-01-05 11:27:07 已先行联系市民，经沟通了解到市民李先生（310108198902271017）目前在南京参加灵活就业参保缴费，需要将南京的灵活就业参保办理退出登记手续，已告知市民，上述业务需要咨询南京当地的社保经办机构，已将上述情况告知市民，市民表示知晓。市民主要咨询外省市的灵活就业参保登记退出手续如何办理，非本市12345热线受理范围，建议工单退回12345。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704358699-2107120', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104028912, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 4, 17, 6, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704359075-69988', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104028982, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 4, 17, 11, 23), '诉求地址': '浦东新区拱北路313弄2支弄49-62号 上海市浦东新区博雅进修学校', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述培训机构收取学院的所有的费用都是到负责人牛玉海、和员工赵露个人账户的（微信公众号和支付宝账号）诉求：投诉上述机构偷税漏税。（需回复）', '工单类别': '一般', '处理描述': '根据“沪税电举[2024]01173”举报的情况，2024年1月8日15点07分与举报人...', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '税收管理', '四级分类': '偷税漏税', '主办单位': '市税