tetime(2024, 1, 8, 13, 36, 1), '诉求地址': '浦东新区合庆镇蔡路村北曹家宅54号', '诉求区域': '浦东新区', '内容描述': '市民来电要求撤单。【最近派发的工单编号：20240106003043，工单内容：市民来电咨询:浦东新区合庆镇蔡路村北曹家宅54号的农村宅基地使用证丢失了，村委要求登报申明，老人不知道要带什么材料去哪里登报才符合要求，诉求：需要明确该如何处理（需回复）】', '工单类别': '一般', '处理描述': '根据“关于市民要求撤单的处理口径”告知，市民认可，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '宅基地', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704690087-595208', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108017622, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 37, 20), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:自己通过随申办提交失业金申请，但提交不了', '工单类别': '一般', '处理描述': '转接人社局成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '失业保险', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704692083-2641315', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108015452, '工号': 4312, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 37, 42), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复。补充：市民称盒马工作人员有联系其称只能退会员费加优惠券补偿。市民表示不认可，其称按电子商务法第81条规定，商家擅自更改规定需处罚。诉求：请管理部门核实并要求处罚盒马，要求改回原本的规则，要求补偿。（需回复）【最近派发的工单编号：20231230019373，工单内容：市民来电反映:市民购买了盒子马APP的会员，市民账号：naihe127812，市民成为会员后可以享受每月31次免运费配送，每日无限次，但盒马在12月22日更改了规则，变成了每天限用一次免运费配送，但盒马没有发公告通知会员，也没有和会员协商过，市民觉得盒马欺骗消费者...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231230019373，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704691763-2641010', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108017362, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 38, 5), '诉求地址': '闵行区东川路1926号', '诉求区域': '闵行区', '内容描述': '市民来电反映:其1月7日联系了上述地址的（闵行社区便民维修服务中心）上门维修冰箱，电话33561256，34241527。1月8日发现冰箱并没有修好，联系对方也不予理睬。经市民自行调查，怀疑是李鬼维修公司。诉求：希望管理部门核实查处。', '工单类别': '一般', '处理描述': ' ', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '家电维修', '主办单位': '市商务委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704691849-596529', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108017572, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 38, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民是网约车司机，车牌号：沪AG20001，近期其车辆运输证要续证，由于在2022年封控期间保险没有续，告知其续证没有通过。诉求：希望协调帮市民办理。', '工单类别': '一般', '处理描述': '2024/1/8 14：25 联系反映人，告知无法申请延续。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692037-2641283', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108017552, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 38, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其身份证遗失后补办了新身份证想知道如果被他人捡到旧身份证是否还能使用。', '工单类别': '一般', '处理描述': '告知补办身份证后前身份证自动失效，市民认可，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '身份证管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692002-596678', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108017712, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 41, 1), '诉求地址': '普陀区大渡河路95弄非居民楼', '诉求区域': '普陀区', '内容描述': '市民来电反映:上述地址有一个楼栋每天24小时都在装修（三层楼高），噪音严重扰民，诉求：要求该楼栋严格按照装修时间进行装修，勿要继续扰民（信息保密无需回复）', '工单类别': '一般', '处理描述': '长风所在1月8号接单，诉求人无电话联系。经社区民警实地查看，上址小区27号房屋确实在进行施工装修，系上海市普陀区体育局委托上海文翰建设工程有限公司对坐落于该址的普陀区青少年运动员综合保障基地修缮工程。1月10日下午，民警分别电联项目经理、文明施工专管员、施工人员做出法律告知：1、根据国家及本市相关法规规定，必需按照规定时间8时至18时之间开展装修作业，违反将依法给予处罚；2、建议调整延后大噪音装修工程的工作时间段，特别是在双休日期间，减少对周围邻居的影响；3、服从物业管理，做好降噪工作及施工区域卫生。上述3人当场表示知晓，并答应会做好监管工作并转告施工工人。鉴于投诉人匿名且未留联系电话，...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692197-2641428', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018132, '工号': 1712, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 41, 21), '诉求地址': '本市舒适堡健身房莲花国际店', '诉求区域': '本市', '内容描述': '市民来电反映:其在舒适堡健身房办理健身房年卡，一张到在天山路店办理的到25年2月到期还有1000多一点的费用没有使用，卡号：007964F66天，还有一张莲花国际店办理，卡号：102696F84，到2034年5月11号到期，还有6000元的费用没有用完，有支付记录，有卡，电话：无法提供，现在店关门了无法使用，门店电话都打不通了诉求：管理部门核实协调退款。', '工单类别': '一般', '处理描述': '2024年1月10日先行投诉人，告知投诉人目前舒适堡健身房（莲花国际店）已闭门，在门店外设置会员信息登记室，进行会员信息登记。按照单用途预付费卡处置流程，《上海市单用途预付消费卡管理实施办法》第二十四条规定，区文旅局执法大队将通过函件方式将投诉转送至闵行区体育局，后续将由闵行区体育局进行处置。 如仍未解决，建议举报人走司法途径维权。投诉人表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018052, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 45, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拍拍贷投资的钱没有收回来。', '工单类别': '一般', '处理描述': '告知12363，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692570-597167', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108017772, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 46, 3), '诉求地址': '虹口区', '诉求区域': '虹口区', '内容描述': '市民来电咨询:企业数字证书过期，网上无法办理，显示超过15个月。', '工单类别': '一般', '处理描述': '为市民转接数字认证中心专席，转接成功，此单归档。', '客户类型': '企业', '一级分类': '经济综合类', '二级分类': '经济信息化', '三级分类': '法人一证通', '四级分类': '法人一证通', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704692254-596888', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018392, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 48, 50), '诉求地址': '长宁区江苏路502弄20支弄', '诉求区域': '长宁区', '内容描述': '市民反映相同事项。【最近办结的工单编号：20231217004857，工单内容：称上述地址隔壁40支弄小区在做美丽家园项目，现在接近完工，市民称路面铺设沥青后比市民小区高了8-10公分，市民称到了雨季会有内涝问题，其询问居委后被告知20支弄不会再做路面改造，诉求：希望管理部门核实处理，市民要求居委的上级部门处理，因为该工程为居委指导负责。】', '工单类别': '一般', '处理描述': '市民反映重复事项，工单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016292, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 49, 5), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:2024年1月8日12345电话联系其，其电话没有接到。', '工单类别': '一般', '处理描述': '手机保持畅通，会与其再次联系的，市民认可。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '12345热线', '四级分类': '信息咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692690-342742', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018222, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 49, 57), '诉求地址': '本市得物APP', '诉求区域': '本市', '内容描述': '市民来电反映:其在上述地址的APP购买了围巾，订单号：JS249216003363230554，支付了900多元，其表示不喜欢该围巾提出退款，东西已经寄过去了，但是现在得物不给退款。诉求：请管理部门协助退款。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '2024年1月11日短信告知已受理。经调解双方达成一致，得物APP平台反馈已为消费者退款。 2024年1月17日将上述情况电话告知消费者，消费者表示已收到退款。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692751-597313', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108016002, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 50, 31), '诉求地址': '浦东新区书院镇老芦公路895号（公寓住宅）', '诉求区域': '浦东新区', '内容描述': '市民来电反映: 其是居住在上述地址的业主，其表示该地址的用电必须要到物业进行充电缴费，如不交物业费物业会限制用电。诉求：请管理部门核实，市民要求正常用电。', '工单类别': '一般', '处理描述': '接单后，于1月21日与市民进行先行联系工作，进一步了解相关情况，告知了办理程序和期限。接市民反映，房办联系物业核实，商住楼水电是由物业代收代付的，购房合同中就已经明确告知。现业主电费处于欠费中，故导致不能正常用电。不存在市民所说不交物业费物业限制用电的情况出现。市民认可', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692611-2687299', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018272, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 50, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:抖音商城购买翡翠手镯，订单号：6924309545494386427，价格：9233元，但是一直未收到货，只收到空盒，诉求：要求尽快发货或者退款', '工单类别': '一般', '处理描述': '经核实，被诉企业抖音平台处理给与消费者商家补偿900元+300元优惠券方案，投诉人不认可，经沟通双方无法达成调解协议。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692825-2687496', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018662, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 51, 14), '诉求地址': '长宁区娄山关路533号2902-2913室', '诉求区域': '长宁区', '内容描述': '市民反映：2023年12月25日在拼多多购买一加ace2 pro手机一台，购买前拼多多并未在显眼位置提示购买该款手机后，无法购买小米14pro、sony xperia 1 v等手机，同时也并未在显眼位置告知用户限购的时间，侵犯了消费者的知情权。诉求：要求拼多多平台解除购买不同型号手机的限制。', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018422, '工号': 4382, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 53, 22), '诉求地址': '0', '诉求区域': '浦东新区', '内容描述': '市民来电反映：刚刚拨打12345已经打通了，诉求已再处理中，无需重复处理。', '工单类别': '一般', '处理描述': '重复来电归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704691602-2429760', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018122, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 53, 30), '诉求地址': '长宁区延安西路 江苏路派出所', '诉求区域': '长宁区', '内容描述': '市民来电反映:其13：45分在长宁区延安西路被交警执法，警号：024305，市民表示该警察言语恐吓威胁市民，态度非常差，故来电投诉，希望管理部门核实整治该警察', '工单类别': '一般', '处理描述': '2024年1月8日13时23分许，江苏路派出所民警李振中（警号：024305）在延安西路江苏路口执勤时，对在延安西路人行道内违规驾驶电动自行车的美团外卖员余明进行了处罚。余明接过处罚决定书后，自称没钱，随即将决定书随手扔在地上，欲骑车离开。民警看到后让余明捡起，其称不想要所以扔了，并有“你是警察不是土匪”等不当言论，双方因此发生争论。我所核查后发现，民警没有恐吓威胁市民，但存在未控制好情绪、未能保持理性平和执法态度的问题。分管领导已对当事民警李振中进行教育提醒。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '服务态度', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692839-2687508', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018382, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 56, 3), '诉求地址': '浦东新区南泉路1316号生鲜超市（没有店名）', '诉求区域': '浦东新区', '内容描述': '市民来电反映:每天6:00左右就开始卖肉剁肉，噪音严重扰民，此现象持续了1年多，多次向管理部门反映未果，市民表示该地是豫园集团违规租借的。诉求：希望管理部门协调尽快解决噪音问题。（需回复）', '工单类别': '一般', '处理描述': '【申请不属实件附件上传】塘桥街道塘桥居委表示：豫园集团并未违规租借房子，里面的商户也是以营业执照为准的正常经营行为，社区民警和社工均已上门核实，并在居民房屋进行分贝测试，测出来的分贝很低小于54分贝，平均值32分贝，也反映给城管部门，目前也无其他居民反应噪音扰民问题。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704692958-2687612', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018592, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 56, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:企业新员工缴纳社保问题', '工单类别': '一般', '处理描述': '转接人社专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704693166-343177', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018502, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 8, 13, 56, 37), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，市民表示浦东分局交警支队七大队当时跟市民说先找办事民警核实，但是至今未致电市民给到解释，诉求: 希望管理部门核实致电市民给到解释.最近办结的工单编号:20231228006711,工单内容：市民来电咨询:其发生交通事故，需要拷贝监控录像，交警表示不可以，咨询是否有这种政策规定。】', '工单类别': '一般', '处理描述': '上海市公安局浦东分局交警支队七大队民警于2024年01月09日09时28分、10时07分、14时37分与来电市民联系，市民均未接电话。具体答复内容：2023年11月16日21时10分左右，支队七大队民警许辉（警号062845）接案，至浦东新区观海路拱北路处置两机动车碰擦事故。民警到达现场后，询问事故双方驾驶员事发经过，因事故双方对责任不明确，故民警将该事故移交事故组做进一步处理。事故组民警徐雯杰（警号013107）受理，民警于2023年11月21日委托专业机构对事故双方车辆进行安全技术状况检验及车速鉴定。因现有条件，鉴定机构无法对提问人事故中的对方车辆（苏F0V53Y）事发时车速作出明确...', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通事故', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704693055-2431109', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018522, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 8, 14, 2, 35), '诉求地址': '奉贤区浦星公路9039号', '诉求区域': '奉贤区', '内容描述': '市民来电反映:其杭州智联运输有限公司工作人员，2023年7月31号9:33在G1503 77.2公里处发生了一起追尾交通事故，驾驶员当场死亡，事故发生后车辆被交警拖至上述地址停车场，即奉杰停车场有限公司的停车场，现市民和家属前往该处取车，被告知需要1万多元的停车费，车牌号：浙ATV380。诉求：希望管理部门核实，并对停车费问题给到答复', '工单类别': '一般', '处理描述': '上海市公安局奉贤分局交警支队事故大队于2024年1月9日13时55分与来电市民取得联系，具体答复内容：经核实，市民反映的车辆奉贤交警支队事审大队事故民警已在2023年9月月份开具了放车单，并告知市民如在开具放车单后不及时取车会产生相应停车费用，根据《道路交通事故处理程序规定》第五十八条规定，因扣留车辆发生的费用由作出决定的公安机关交通管理部门承担，但公安机关交通管理部门通知当事人领取，当事人逾期未领取产生的停车费由当事人自行承担。交警支队事审大队已帮助市民向停车场进行协调，在合理的范围内进行减免，经电话告知，市民还是无法接受减免后的金额。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '公共停车场', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704693068-2431122', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108019042, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 8, 14, 2, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704693611-598060', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108019122, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 8, 14, 4, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:解除挂失社保卡。', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704693737-2431730', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108018732, '工号': 4322, '工单生成时间': datetime.datetime(2024, 1, 8,