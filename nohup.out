 '新五级分类': None}, {'工单编号': 20240102018412, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 49, 2), '诉求地址': '奉贤区海湾派出所', '诉求区域': '奉贤区', '内容描述': '市民来电反映:其在12月1日道上述派出所报案，警察以个案不予受理，因为双方有合同，警察告知属于民事纠纷不予立案，来电要求督促派出所立案。', '工单类别': '一般', '处理描述': '告知市民无法受理，根据《上海市公安局对外服务窗口一览表》告知市民，建议向上一级公安分局反映，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '立案侦查', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704174155-2373955', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102018392, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其通过拼多多购买了四件商品，发现有质量问题。商家以各种理由为由不退款，联系了平台，平台也不处理。订单号：231206-499232327351550、231128-238755531831550、231209-257404448751550、231127-503222189751550。诉求：希望管理部门帮助尽快退款。', '工单类别': '一般', '处理描述': '经查，我局于2024-01-16与消费者解释沟通，消费者表示知悉了解，故此单投诉办结。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704174105-339962', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102018812, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 52, 46), '诉求地址': '黄浦区瞿溪路937弄13号2楼207', '诉求区域': '黄浦区', '内容描述': '市民来电反映:上述小区住户每天在2楼楼道堆物，还堆放自行车等，严重影响其他居民通行，诉求：希望管理部门能让该住户立即停止这种堆物行为', '工单类别': '一般', '处理描述': '我单位2024年1月2日接单，先行联系来电人，正在我单位处置。经核实，来电人所诉的堆物分别为205室堆放的自行车及207室堆放的堆物。我居委接到工单立即联系了物业共同上门，将205室的自行车进行了清理。但在与207室沟通要求清理时，207室业主情绪非常激动，拒不配合。我居委工作人员随后又再次上门宣传要求清理，也致电其儿子做思想工作，207室当时承诺会趁着周末将堆物自行处理掉。1月22日，我居委早上8点上门复查，发现堆物只清理一小部分，没有全部清理干净，现场向被投诉人指出，要求立即清理，但207室业主反悔不肯清理，并情绪非常激动，甚至想要出手打人。目前该处堆物不影响通行，无安全隐患。针对该...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704174502-595883', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102018842, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 53, 53), '诉求地址': '静安区 第十人民医院', '诉求区域': '静安区', '内容描述': '市民来电反映:上述地址门口路边都设置了黄线，故无法停车。其是出租车司机。市民表示上述情况存在不便，故来电反映', '工单类别': '一般', '处理描述': '通话中市民自行挂机，回拨市民，电话正在通话中，此单暂存。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通设施', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704174554-2632238', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102018732, '工号': 2940, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 55, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:建议期末考试考完就开始放寒假。如学生有特殊需求，尽力帮助学生解决困难和问题。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '同意办结。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '其他', '四级分类': '其他', '主办单位': '市教育委员会', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704174715-2374398', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102018632, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 55, 49), '诉求地址': '本市随申办小程序', '诉求区域': '本市', '内容描述': '市民来电咨询:忘记密码咨询怎么把随申办绑定的手机号改成另一个手机号（原号码：13012870522）。诉求：请管理部门尽快帮助市民更改随申办绑定的手机号、同时帮市民查询手机号绑定的随申办个人信息。', '工单类别': '一般', '处理描述': '9：48分联系市民，市民称无需处理了。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '网站使用', '主办单位': '上海市大数据中心', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704174345-2632074', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102019122, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 56, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:社保卡需要开通、激活', '工单类别': '一般', '处理描述': '转接社保卡成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704174857-2632479', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102017982, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 56, 57), '诉求地址': '静安区市场监管局', '诉求区域': '静安区', '内容描述': '市民来电反映:市民通过12345转3向消保委反映静安美容美发店。市民告知美容美发店已换了老板，原本的金额不能使用要求顾客充卡。顾客卡内金额660元。静安区12月25日回复市民“现在美容美发都这样”“明天给你回复”，但后续一直无回复。市民12315反映号码13917759756。诉求：投诉静安区市场监管局不作为。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '经核实，投诉人反映情况不属实，与投诉人联系询问具体被诉单位信息，投诉人无法明确告知，且其表示钱是现金支付，同时投诉人提供的被诉方信息属于普陀区，告知投诉人提供相应凭证后，我委再予以受理。（00468）', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704173692-339572', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102019282, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 58, 40), '诉求地址': '虹口区盒马门店', '诉求区域': '虹口区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。市民反映盒马乱收费问题。诉求：希望管理部门核实转送相关照片至承办部门。【相关工单编号：20240102019042】', '工单类别': '一般', '处理描述': '该举报件涉及群体性举报以及舆情事项，为疑难举报件，已请示上级部门指导，暂未收到处理指导意见的回复。该工单先行办结，在法定期限内另行告知举报人处理情况。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102019502, '工号': 1712, '工单生成时间': datetime.datetime(2024, 1, 2, 13, 59, 39), '诉求地址': '金山区廊下镇景乐路228号3栋', '诉求区域': '金山区', '内容描述': '市民来电反映:上海鼎立石代文化传媒有限公司（法人徐佳乐）倒卖10月周杰伦演唱会门票，之前也倒卖伍佰、陈奕迅的演唱会门票，诉求：管理部门核实处理此事。', '工单类别': '一般', '处理描述': '上海市公安局浦东分局北蔡派出所于2024年1月10日14时05分电话联系提问人，针对反映情况，我所民警到上址核查，御北路385号并无上海鼎立石代文化传媒有限公司，而是一家上海中齐建设工程发展有限公司。我所民警告知提问人，其可到属地派出所咨询相关情况。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '文广影视', '三级分类': '其他', '四级分类': '其他', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102019312, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 0, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其在12315反映的浴巾问题', '工单类别': '一般', '处理描述': '告知市民，无法查询12315的工单，市民挂机，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704175058-340803', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102019102, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 1, 18), '诉求地址': '浦东新区新金桥路1599号东方万国企业中心', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其是上述地址的物业公司的，该处因为修路将消防水表的盖子上铺设了地砖导致被封住无法打开。诉求：希望管理部门帮助联系施工方进行处理。（需回复）', '工单类别': '一般', '处理描述': '尊敬的市民您好！该处道板砖已打开，水表已正常运行。感谢您对浦东城市管理工作的理解和支持，处置单位：上海浦东工程建设管理有限公司。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704174962-2374621', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102019202, '工号': 3542, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 2, 15), '诉求地址': '普陀区沪太路延长西路（宜川四村25号304室）', '诉求区域': '普陀区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231219016025，工单内容：市民来电反映:2023年12月份购买了一个卡拉OK准备在家唱歌使用，但是其尝试连接长城宽带却不能正常使用连接，其的宽带是包含有WIFF的，其手机也能正常连接，其向长城咨询后被告知只能连接手机其余都不能连，其对此不认可，其想要更换宽带，要求管理部门核实后退剩余宽带费用。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231219016025，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704174957-340715', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102019082, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 2, 23), '诉求地址': '闵行区剑川路龙吴路', '诉求区域': '闵行区', '内容描述': '市民来电咨询:市民目前在一家医院挂盐水，目前三甲医院开具了挂盐水证明，想要到别的医院开药挂盐水，是否可以，是否有其他医院可以受理提供挂盐水业务。诉求：希望管理部门核实后回复市民。', '工单类别': '一般', '处理描述': '根据沪卫医政【1998】128号文件，外院开的如青霉素类、生物制剂、免疫制剂、血液制品等中心一律不挂的，还有中心没有的药，也不挂的。已去电跟李先生解释，李先生已知悉。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '其他', '四级分类': '其他', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704174805-2374486', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102019392, '工号': 3882, '工单生成时间': da