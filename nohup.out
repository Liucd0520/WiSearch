e, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109035612, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 9, 21, 39, 31), '诉求地址': '黄浦区复兴东路豆市街', '诉求区域': '黄浦区', '内容描述': '市民来电反映:市民表示上述地址有个建筑工地，每天晚上20:00多开始施工，一直施工到23:00多，且施工噪音很响，影响到周边居民的休息了。诉求：请管理部门核实处理夜间施工扰民的问题。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704807367-2570447', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109035632, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 9, 21, 41, 42), '诉求地址': '黄浦区河南南路北石皮弄', '诉求区域': '黄浦区', '内容描述': '市民来电反映:上述地址河南南路有道路施工，目前施工已经持续一个月时间，每天施工时间9:00-2:00。诉求：希望管理部门核实后让相关施工降低噪音，减少扰民。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '我单位2024年1月10日接单，于当日9：14时首次通过电话先行联系来电人，告知其问题已经收悉，1月17日，由我单位对来电人所反映的情况进行核实，并进行了处置。经查，该处为河南南路架空线工程，针对施工扰民问题，我部门将加强文明施工监管，同时督促施工单位做好降噪措施，控制高噪音施工机械作业时间，协调施工方加强叉车运输管理，减少对周边市民影响。已经将处置结果告知来电人，反映人表示认可。经办人：范佳辰', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704807497-1547', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109035682, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 9, 21, 46, 18), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其是拼多多的个人消费者，要求转接拼多多客服。\n', '工单类别': '一般', '处理描述': '已告知市民拼多多的在线客服工作时间是8:00-21:30，建议市民明日8:00来电，市民认可，归档。\n', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704807825-1584', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109035672, '工号': 1220, '工单生成时间': datetime.datetime(2024, 1, 9, 21, 51, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:  饿了么外卖骑手在沈阳放音响，噪音扰民。', '工单类别': '一般', '处理描述': '涉及骑手个人问题，建议向企业平台反映，市民知晓，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '外置扩音装置', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704807738-2826881', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109035702, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 9, 21, 55, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2023年12月30日5:00左右，通过滴滴平台打的专车，由曹操出行提供的，车牌号是沪AC33938，从浦东新区康桥镇康湾苑-虹桥火车站。市民表示，其上车就告知司机要到虹桥火车站的出发层，但是司机最终没将其送到出发层，导致其火车车次没赶上。市民多次联系滴滴出行和曹操出行平台，也都没有得到回复和解决。诉求：请管理部门查处并给出一个合理的解决方案。', '工单类别': '一般', '处理描述': '核实：技术回复 滴滴平台问题；处理：2024年1月11日13:48:03回电安抚致歉 告知平台已反馈滴滴后续由滴滴对接乘客；乘客认可', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704807957-2570522', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109036062, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 9, 22, 8, 23), '诉求地址': '无', '诉求区域': '本市', '内容描述': '泛泛而谈', '工单类别': '一般', '处理描述': '泛泛而谈', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704809198-2570703', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109036272, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 9, 22, 10, 13), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '更正：女士反映1/9日夜间施工，即时信息。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704809370-1738', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109035892, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 9, 22, 10, 18), '诉求地址': '普陀区真北路桃浦路', '诉求区域': '普陀区', '内容描述': '市民来电反映:其要投诉上述道路在2024年1月9日22:00以后还在噪音施工严重扰民。诉求：希望管理部门核实制止。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '经核实为燃气改造工程，已要求施工单位做好夜间文明施工防止噪音扰民。联系人：游金庆 52564588', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704809178-734734', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109035962, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 9, 22, 23, 55), '诉求地址': '普陀区梅岭北路道路施工', '诉求区域': '普陀区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门联系告知其22:00之后不会再使用重型设备，噪音分贝不会超过50，若还有该情况会要求施工方停工，但实际1月9日晚还是该情况，请管理部门尽快处理。【最近派发的工单编号：20240108036089，工单内容：市民来电反映:上述道路晚上一直施工不停工，使用大型噪音设备，诉求：管理部门核实，协调降低噪音】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240108036089，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704809758-1776', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109036072, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 9, 22, 30, 35), '诉求地址': '长宁区娄山关路533号2902-2913室，上海寻梦信息技术有限公司', '诉求区域': '长宁区', '内容描述': '市民来电反映:市民在拼多多上买物品，物品本身有质量问题。市民要退货退款。订单号：231211-004115700691169.诉求：希望管理部门核实后让拼多多给市民仅退款。', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704810351-734825', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109036082, '工号': 1220, '工单生成时间': datetime.datetime(2024, 1, 9, 22, 31, 11), '诉求地址': '浦东新区金桥路金藏路（往金群路海鹏路方向）', '诉求区域': '浦东新区', '内容描述': '市民来电反映: 1月9日22:20乘坐790路公交车，在浦东新区金桥路金藏路（往金群路海鹏路方向）下车，有一副眼镜遗落在后面的座位上，要求管理部门帮助找回失物。', '工单类别': '次紧急', '处理描述': '这位乘客您好！经核实：该情况属实。根据乘客提供的信息已帮助乘客找回遗失的物品。我们于2024-1-10 10：10分电话联系反映人，将我们的处理意见反馈给其，经过沟通后，其对我们的处理意见表示认可。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '公交巴士', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704810460-2827198', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109036122, '工号': 3802, '工单生成时间': datetime.datetime(2024, 1, 9, 22, 40, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映相同事项。【最近办结的工单编号：20240105024423，工单内容：【重新交办，要求：按答复要点告知市民，市民表示答复要点与实际不符。市民表示其并未受到管理部门发送的短信，并认为自己有上海劳动能力鉴定中心鉴定的完全丧劳，因未到50岁无法办理病退，询问能否特事特办，并表示家中老人需要其照顾，让其能维持生活。诉求：请管理部门核实能否给予市民特殊通道，让其办理网约车人证去开网约车维持生活。最近派发的工单编号:20231226020607，工单内容:市民来电反映:市民失业了5-6个月，有上海劳动能力鉴定中心鉴定的完全丧劳，因未到50岁无法办理病退，只能靠家里老人的退休金过日子，但...', '工单类别': '一般', '处理描述': '通话过程中电话中断，回拨无法接通，此单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704810888-2827229', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109036342, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 9, 23, 34, 33), '诉求地址': '浦东新区北蔡镇北艾路155弄6号102室', '诉求区域': '浦东新区', '内容描述': '市民来电对办理结果不满：社区民警张志华说好2023年11月13日联系其，说11月14日调解处理，其要求改日期11月15日，因为有事，后来张志华就没有下文了，要求其尽快联系处理解决问题。（需回复)【最近派发的工单编号:20240106000391，工单内容:重新交办,要求：答复要点与实际不符，派出所从未处理，要求尽快处理。】', '工单类别': '一般', '处理描述': '市民对办理结果不满，已电子催单工单编号：20240106000391，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704813676-2571039', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109036372, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 9, 23, 35, 20), '诉求地址': '杨浦区黄兴路2228号地上2层51号房屋 上海蟹榭餐饮有限公司', '诉求区域': '杨浦区', '内容描述': '市民来电反映:上述公司没有为其缴纳2022年8月的社保。诉求：希望管理部门为其督促补缴。（需回复）', '工单类别': '一般', '处理描述': '接到工单后，分中心咨询信访科根据《关于稽核与咨询信访工作衔接的规范》，对该事项进行登记后，于2024年1月16日移交内控稽核科。1月16日16:36分中心咨询信访科工作人员电话回复市民，告知相关办理情况。市民表示认可。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '其他', '四级分类': '其他', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704814173-2011', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109036952, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 10, 0, 9, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '疑难人员来电。', '工单类别': '一般', '处理描述': '市民自行挂机，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704816016-2078', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000032, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 10, 0, 16, 39), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:哈啰顺风车拒载，需要电话。', '工单类别': '一般', '处理描述': ' 根据“共享单车客服电话一览表 ”告知，市民认可，归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704816886-2571180', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000042, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 10, 0, 27, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:投诉出租车司机拒载，服务态度恶劣。市民于1月10日0:10左右在虹桥机场T2航站楼出租车上车点上车。在上车后市民告知了司机目的地，由于地点离机场较近，出租车司机拒载，而且过程中态度恶劣。市民有因此报警，警察说不管态度问题。车牌号：沪AAX5865。诉求：希望管理部门核实后对司机拒载，态度问题进行处理。', '工单类别': '一般', '处理描述': '归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704817351-2111', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000072, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 10, 0, 46, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:机场七线的情况，是否还有车辆。', '工单类别': '一般', '处理描述': ' 根据“机场线路起讫站信息表 ”告知，市民认可，归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704818680-2571224', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000082, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 10, 0, 56, 14), '诉求地址': '长宁区茅台路460弄茅台新苑与杜家庄小区之间的马路', '诉求区域': '长宁区', '内容描述': '【重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符，不符内容：上述地址目前夜间施工依旧在持续，噪音问题没有任何改进。诉求：希望管理部门核实后再次处理。最近办结的工单编号：20231223000282，工单内容：市民来电反映:12月23日上述地址马路一直修路修道5:00，噪音扰民，市民无法休息。诉求：希望管理部门给出解释为何要修到凌晨5:00。（市民要求信息保密 无需回复）（市民要求管理部门直接回复到 12345，市民会自行拨打12345咨询管理部门回复）】', '工单类别': '一般', '处理描述': '长宁区架空线整治指挥部于2024年1月10日接单，由于投诉人信息保密，故无法先行联系。1月10日由我单位对来电人所反映情况进行核实。经现场核实，茅台路正在进行架空线入地和合杆整治施工。该工程涉及管线繁多，施工工序复杂，因此施工周期较长。为保障道路正常通行，相关施工需在夜间进行，已经督促施工方，在夜间施工时把高噪音的施工提早开始，提早结束，之后进行较低噪音施工，同时做好文明施工，尽量减少对周边居民的影响。感谢您对市政建设工作的关心、理解和支持。 来电人未留联系方式。经办人：金逸辉', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704819056-2827617', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000102, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 10, 1, 22, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民在拼多多上买了香薰，物品到货后是破损的。市民因此申请了仅退款，和平台反映以后，平台和商家协商处理，平台给市民退款了。后续商家就不停的骚扰市民，目前也无法联系上平台。', '工单类别': '一般', '处理描述': '已解释，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704820578-735167', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000142, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 10, 1, 42, 7), '诉求地址': '长宁区茅台路300弄', '诉求区域': '长宁区', '内容描述': '市民来电反映:上述地址所在的茅台路上在道路夜间施工，每天21:00-4:00，噪音扰民严重。诉求：希望管理部门核实后让相关施工降低噪音，减少扰民。', '工单类别': '一般', '处理描述': '长宁区架空线整治指挥部于2024年1月11日接单，于1-11 17:29先行联系来电人，告知其问题已经收悉，正在我单位进行办理。1-11 17:39由我单位对来电人所反映情况进行核实经现场核实，该处正在进行架空线入地施工，已办理了夜间施工备案。架空线入地项目需要占用的道路路幅较宽，为保障白天道路正常通行，避免因占掘路施工引起拥堵不堪，相关施工需在夜间进行。已经督促施工方，在夜间施工时把高噪音的施工提早进行、提早结束，夜间施工注意文明施工，尽量减少对周边居民的影响。感谢您对市政建设工作的关心、理解和支持。。 来电人未评价。经办人： 曹佳骏', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704821961-2571287', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000222, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 10, 3, 12, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:东方航空和南方航空的电话。', '工单类别': '一般', '处理描述': '根据“常用电话号码一览表”告知，市民认可，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '航空客运', '四级分类': '飞机票务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704827363-2571347', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000252, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 10, 3, 52, 32), '诉求地址': '浦东新区南泉北路八佰伴东门口', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其是2024年1月10日0:20在上述诉求地址上车（出租车）的，扬招的，出租车公司：上海巾帼汽车服务有限公司，车牌号：沪ABN0852，之后绕了一圈又回到浦东新区南泉北路八佰伴东门口原地下车，下车时间是1月10日0:25左右，出租车公司联系不上，没有拿发票，其坐在后排，遗失了华为手机在车上，黑色的，诉求：要求尽快帮其找到此手机给其。（需回复）手机处于关机状态，其表示手机是有电的。遗失的手机号13802582202', '工单类别': '次紧急', '处理描述': '上海巾帼汽车服务有限公司，于2024年1月12日回复乘客，经过两天查询调查，司机处并未发现遗漏手机，已和乘客说明如有具体情况及时沟通谢谢', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '物品遗失', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704829284-735261', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000332, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 10, 5, 57, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映相同事项。【最近办结的工单编号：20230807019558，工单内容：市民来电反映:其通过抖音平台购买充电器，价格：11.9元，订单号：6918234710268253507。市民表示该充电器发烫，存在质量问题。导致其手机主板烧坏。其有华为质检报告。现市民诉求：希望管理部门查实并针对其手机主板进行更换（需回复）。】', '工单类别': '一般', '处理描述': '已解释，市民不认可认为赔偿金额过少，因答复清晰明确，工单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704836691-2571477', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000392, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 10, 6, 58, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:要求把该号码的信息上传到市政府。', '工单类别': '一般', '处理描述': '告知超出热线受理范围，市民自行挂机，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704840983-735389', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000562, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 10, 7, 31, 39), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其在绑定社保卡上的银行卡号时提示卡号不正确不存在想知道怎么回事（市民表示拿到卡后未办理过激活）。', '工单类别': '一般', '处理描述': '告知需激活后才能使用建议市民联系银行激活，市民认可，故归档。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '金融', '四级分类': '银行监管', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704842882-2828066', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000412, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 10, 7, 36, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民是企业的员工，投诉企业配送管理的问题.', '工单类别': '一般', '处理描述': '根据《不予受理来电的处理流程 》告知市民不在热线受理范围，建议市民与企业协商或通过诉讼解决，市民主动挂机，归档.', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704843193-2485', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000592, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 10, 7, 36, 30), '诉求地址': '静安区七浦路179号上海新七浦服装市场4楼119号', '诉求区域': '静安区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理解决。（需回复）【最近派发的工单编号：20240108020905，工单内容：市民来电反映:其之前在上述地址一家店里购买了衣服，现在出现大小问题，市民找到商家退却被告知不能退。金额：500元。诉求：请管路部门核实协调帮助维权。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240108020905，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704843197-2571691', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000572, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 10, 7, 39, 40), '诉求地址': '浦东新区金桥镇佳林路919弄7号301室', '诉求区域': '浦东新区', '内容描述': '市民来电反复催单，市民表示城管来电居然称没有违规，市民非常气愤，市民表示对方违反（住宅室内装饰装修管理办法的相关条例），改变了房屋主体结构，市民表示此类改动是要原设计单位批准的，对方根本未向房地产主管部门提出申请，且对方破坏了卫生间厨房间防水层。市民诉求：望相关部门核实尽快让能处理的部门处理。（市民要求需要回复）【最近派发的工单编号：20240110000324，工单内容：【重新交办：要求：答复要点与实际情况不符，市民表示二房东叫朱海东，业主叫杨军，现在在违规装修，将原来的雨水管道切掉换成细的管道，更改了房屋主体结构必须要有相应资质的机构审核通后才能装修的，现在未按规定审核属于违法的。诉...', '工单类别': '一般', '处理描述': '望相关部门核实尽快让能处理的部门处理谢谢。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '房屋结构破坏', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704842979-2828073', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000612, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 10, 7, 43, 28), '诉求地址': '黄浦区市场监管局', '诉求区域': '黄浦区', '内容描述': '【重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符，不符内容：目前壁挂炉的问题还没有解决。诉求：希望管理部门尽快再次处理解决问题。最近办结的工单编号：20240104019306，工单内容：市民来电反映:市民表示其人在长春。在2023年年底的时候拨打了上海的12315，反映了威能壁挂炉的问题，预留电话：15904407768。后收到短信，黄浦区市场监管局已经受理。市民表示一直没有得到后续的回复。诉求：希望黄浦区市场监管局尽快市民的问题。】', '工单类别': '一般', '处理描述': '经核实，全国12315平台已受理投诉（工单号1310101002023122766684015、1310101002023122739020477、1310101002024010397270495、1310101002024011039110809），威能（中国）供热制冷环境技术有限公司正与消费者进行沟通协商中。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704843577-2506', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000712, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 10, 7, 49, 57), '诉求地址': '长宁区镇宁路1号联华超市', '诉求区域': '长宁区', '内容描述': '【投诉】市民来电反映：其拨打12345反映之前反映购买假烟的问题要求再次反映，话务员态度生硬，称其问题管理部门已经给与了答复，不会再为其反映。诉求：请核实处理。关联工单编号：20240110000466。', '工单类别': '一般', '处理描述': '已按照投诉处理流程进行核实处理。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '投诉批评', '四级分类': '服务态度', '主办单位': '12345热线处理', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704842830-735463', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000702, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 10, 7, 51, 59), '诉求地址': '宝山区乾溪路100弄28号304室', '诉求区域': '宝山区', '内容描述': '市民来电反映: 上述地址居民于1月10日早上7:30开始装修噪音扰民，市民与该居民协商未果，诉求: 希望管理部门核实让该居民按规定时间内装修. （市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '宝山公安分局大场派出所于2024年1月10日14时11分与来电市民先行联系，了解情况。针对市民诉求，经调查核实，来电市民反映宝山区乾溪路100弄28号304室在装修，产生装修声扰民，故来电要求处理。对此，大场派出所民警于2024年1月11日10时30分至上址，民警已上门对304室装修人员进行宣传告知，要求遵守《上海市社会生活噪声污染防治办法》装修规定，必须在规定时间早8时至晚18时内装修，法定节假日不能装修，周末应当尽量避免开展冲击钻等声音较响的作业，避免干扰他人正常生活休息。304室装修人员表示知晓，会配合民警的工作，后期会避免装修声扰民。2024年1月22日13时30分与来电市民再次...', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704844063-735559', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000762, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 10, 7, 59, 25), '诉求地址': '普陀区远景路97弄', '诉求区域': '普陀区', '内容描述': '市民来电反映: 上述地址小区内于1月9日晚上24:00还存在施工噪音扰民的现象，市民不知道施工单位名称和施工种类,严重影响市民休息，诉求: 希望管理部门核实让施工单位不要夜间施工.（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '宜川街道1月10日接单，随即先行联系，不属实，1、中潭路36号的场地“半马苏河驿站·苏河1690党群服务中心项目”建设，10月4日施工已经开始（工作日早上8点至中午12点，下午2点至6点施工），预计1月底硬装完成。2、接到工单后，城管部门晚上8点到场察看，经现场噪音分贝对比，现场检测分贝在50分贝左右，不存在噪音扰民情况。3、市民反映周末施工扰民，经核实周末可以施工，施工均在规定时间段内进行，故不存在施工扰民情况。附照片1月22日回复市民，表示知晓。经办人：朱宇芳。责任人：许王丽。电话：56352632', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704844452-735601', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000862, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 2, 13), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民需要转接拼多多专席.', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704844857-735657', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000902, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 4, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多客服', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704845014-2828290', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000812, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 9, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其收到第一中级人民法院的短信。其致电该处，但电话无法接通，故市民来电求助。', '工单类别': '一般', '处理描述': '根据《 司法、政协系统联系地址电话 》告知市民，此单归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '法院系统', '三级分类': '法院受理', '四级分类': '诉讼立案', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704845022-735700', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000792, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 10, 49), '诉求地址': '青浦区赵巷尚优酒店', '诉求区域': '青浦区', '内容描述': '市民来电反映:合同纠纷的问题，市民是商家被人拖欠工程款，导致现在全家欠费，如果不解决就要到市政府去跳楼，目前市民人在上述地址（工号4132于2024年1月10日8:07拨打22022580报备，工号782表示已知晓），希望管理部门查实维稳', '工单类别': '一般', '处理描述': '工号4132于2024年1月10日8:07拨打22022580报备，工号782表示已知晓。公安报备类工单做归档处理。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704845257-2571926', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001392, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 12, 19), '诉求地址': '奉贤区奉城镇西门港新村一村33-35号', '诉求区域': '奉贤区', '内容描述': '市民反映：西门港新村一村33-35号门牌东北方向地面上有黄漆办证广告，墙面有出租广告，停车管理岗亭玻璃上有出租房屋广告（详见附件）。诉求：要求处理上述广告。', '工单类别': '一般', '处理描述': '奉城镇于2024年1月10日接单，于1月10日上午首次通过电话先行联系来电人，告知其问题已经收悉，正在奉城镇城建中心进行办理。1月10日下午12.45时，由奉城镇城建中心房管科室，对来电人所反映的情况进行核实，并进行了现场处置（勤澄物业接到热线后第一时间前往处置，现已清除。附照片。），已经将处置结果告知来电人，该问题已经实际解决。经办人房管中心, 联系电话57515613。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '市容市貌', '四级分类': '广告张贴', '主办单位': '奉贤区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000962, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 13, 30), '诉求地址': '浦东新区新浦路251弄 板泉路出入口', '诉求区域': '浦东新区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，市民表示违章停车现象依然存在。诉求：希望管理部门核实进行整治。最近办结的工单编号:20231025001459工单内容：市民来电反映:  此处在晚高峰时间段，有机动车违章停车在道路旁，导致进出该小区存在视线盲区，存在安全隐患，之前投诉得到整治过，但国庆后又死灰复燃。诉求：请管理部门核实，尽快派人整治此处违停。（需回复）】', '工单类别': '一般', '处理描述': '接工单以后，上海市公安局浦东分局交警支队五大队民警于2024年1月10日15时09分电话联系提问人，进行先期联系。...', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704845368-735756', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110000982, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 14, 44), '诉求地址': '崇明区横沙乡新北村4113号', '诉求区域': '崇明区', '内容描述': '市民补充信息，市民希望电信公司尽快联系市民,与电厂一起将电线杆移除.【最近派发的工单编号:20240108011682，工单内容：市民来电反映:崇明区横沙乡新北村4113号有电信公司的电线杆穿过家里，房子面临翻新，之前和电信公司联系，被告知没人人手，现在有人手了，诉求尽快实地核实，并安排移走电线杆。】', '工单类别': '一般', '处理描述': '已电子催单,工单编号：20240108011682，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '通信线路', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704845472-2828374', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001152, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 15, 18), '诉求地址': '青浦区金泽镇金姚村沪青平路元荡路西面北200米村口', '诉求区域': '青浦区', '内容描述': '市民建议：金姚村金杨居委（西面村）靠近元荡路沪青平公路北面，有一个村西片村的下口，离元荡路红绿灯过近，路口太小无明显提示，沪青平公路由北向西行驶的车辆不熟悉这边路不知道这边有路口的车不减速度很容易出事故，有时车辆跟车很近，拐弯到村里车打右转向灯，后面车辆以为前面红绿灯右转弯到元荡路，其经历很多次后面跟车太近，其一般在水闸路就开始打右转向灯了，后面跟车车辆误以为是前面红绿灯口右转弯，不知道转村里，村路口又非常的小（详见附件）。诉求：建议管理部门增加道路交通标志，解决现有的严重安全隐患。', '工单类别': '一般', '处理描述': '市公安局青浦分局交警支队勤务路设大队于2024年1月11日15时33分许与当事人取得联系，认真听取其诉求。告知其该处交通标志标志及信号灯设置合理，暂不建议进行调整。沪青平公路（漕盈路至金泽G50出口）将于2024年进行改扩建工程，届时大队将会同相关部门对沪青平公路沿线交叉口以及中央缺口进行统一规划调整。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通设施', '主办单位': '市公安局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001032, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 18, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民拍牌未审核通过，需要申请拍牌资格复议，由于本人不在上海且需要公证书，想了解在外地拿到公证书后寄到上海，委托朋友帮忙申请拍牌资格复议是否可以', '工单类别': '一般', '处理描述': '2024年1月10下午13点13分致电市民，经电话沟通，申请人由于“非上海户籍，居住证无效；社保及个税未满36个月”原因不通过参拍审核，现系咨询：提出异议复核需要携带的具体材料。告知来电人：若申请人对信息核实结果有异议的，可以自被告知结果之日起10个工作日内，携带符合要求的居住证、申请人本人身份证等相关材料至服务中心提出异议申请。市民表示已知悉。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '驾驶员审验', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704845456-735779', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001492, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 20, 30), '诉求地址': '浦东新区博山小区博山路12弄', '诉求区域': '浦东新区', '内容描述': '市民反映：博山小区标榜关门时间0:00-5:00，实际23:00已经关门。小门平时白天无人看守，晚上正门也随意进出。每天凌晨关闭小门没有任何意义，物业保安也并未按照规定时间关闭小门，只会给12弄高层居民带来不便（绕路通行）。诉求：24小时开放12弄小门。（市民要求信息保密，需回复）', '工单类别': '一般', '处理描述': '经洋泾街道博山居委核实了解，博山小区为了居民的安全，该边门历来管理的时间为 23: 00-次日 5:00。门上也贴有告示，居委也求物业严格按照这个时间进行边门管理，且边门离正门的距离非常近，不存在绕路情况，同时正门设有门岗，晚上并非随意进去。综上所述，市民反映情况与事实不符。1月19日上午10时、11时、15时联系均未接通。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001182, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 24, 17), '诉求地址': '杨浦区国年路25弄10号、11号', '诉求区域': '杨浦区', '内容描述': '市民来电反映:上述地址小区内的10号与11号的排污管道堵塞导致市民无法使用家中马桶，目前暂时有积水，诉求: 希望管理部门核实尽快安排工作人员疏通解决.(需回复) ', '工单类别': '次紧急', '处理描述': '1/10 9:03 电联反映人其表示物业已师傅已维修好。【1/10 9:08 电联畅荣物业18317177397已维修好】', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704845917-2828478', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001502, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 25, 40), '诉求地址': '崇明区陈家镇安振路88弄81号101室', '诉求区域': '崇明区', '内容描述': '市民建议：上海市现在只有崇明区办死亡证还需要跑三个地方，卫生室、村委会、镇医院，非常不方便，不人性化。之前在其他区帮亲戚办理，都只需要去镇医院就可以了。诉求：建议崇明区卫生健康委能予以改进。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '接单后，我委即展开核查。 经了解，本区已按市级部门要求，在家自然死亡的，在村卫生室出具相关证明材料后至社区医院开具死亡证即可，无需村委会开具相关证明，如有疑问，可致电区疾控中心59618725咨询。 来电人无需回复。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '死亡登记', '主办单位': '市卫生健康委', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001532, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 27, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': ' 市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240103028596，工单内容：市民来电反映：拼多多订单号231224-305497383843387购买的是三件套，商家只发了破烂的黑色的布料。丢掉的图已经发给拼多多客服，拼多多拒绝退款 152.9元。诉求：请管理部门核实尽快退款】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240103028596，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704846139-2572108', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001772, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 28, 3), '诉求地址': '浦东新区秀浦路2599号横沔派出所', '诉求区域': '浦东新区', '内容描述': '市民反映：2024年1月5日，电动车停在康新公路地铁站二号口，坐地铁去上海虹桥火车站，2024年1月9日回来后发生电动车失窃，报警录口供后未给予报警回执，亦未给予不予立案通知书。诉求：管理部门核实并予以合理解释。', '工单类别': '一般', '处理描述': '上海市公安局浦东分局横沔派出所民警于2024年1月22日09时20分与来电市民先生取得联系，经查，诉求人的电瓶车失窃案件我所已受理，承办民警也已调取了相关监控，但并无有效线索，案件暂无进展，并不存在诉求人反映的不给其回执单和不予立案的情况，诉求人实际系希望通过该工单对公安机关施压，帮其立刻追回损失。【康桥镇叠桥村】', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '立案侦查', '主办单位': '市公安局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001192, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 28, 20), '诉求地址': '杨浦区', '诉求区域': '杨浦区', '内容描述': '市民来电咨询:杨浦区哪里办理驾驶证换证。', '工单类别': '一般', '处理描述': '根据《各区机动车、驾驶证管理窗口受理时间、地点及联系方式》答复', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '驾驶员审验', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704846381-2828589', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001372, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 28, 54), '诉求地址': '闵行区朱行三村10-12号', '诉求区域': '闵行区', '内容描述': '市民来电咨询处理进度。按答复市民要点告知市民，答复市民要点清晰（明确）。【最近办结的工单编号：20231221006181，工单内容：市民来电反映:其是上述地址居民，小区围墙外靠近外环高速这里地面绿化带里的树木有6层楼这么高，3楼及以下的居民全天都照不到太阳，衣服都无法晾晒。找居委和物业帮忙联系相关部门修剪，但始终没有来修剪。诉求：希望管理部门协调尽快派人来修剪树木，保证这边3楼及以下居民的太阳照射】', '工单类别': '一般', '处理描述': '按答复要点告知市民，答复要点清晰、明确，市民知晓，此单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '绿地绿化', '四级分类': '移植修剪', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704846307-2572143', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110001572, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 33, 9), '诉求地址': '闵行区朱行三村边上的莘朱路南边', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述莘朱路南边有很多香樟树直接延伸到到朱行三村居民窗台上。诉求：请管理部门尽快修剪莘朱路南边的香樟树。', '工单类别': '一般', '处理描述': '梅陇镇农管中心于12月7日接单，于12月7日上午10：30分首次通过电话先行联系诉求人,告知其问题已经收悉，正在我单位进行办理，12月7日下午13：00根据来电人所反应情况进行现场核实，核实结果属实，并安排养护人员对树木进行修剪工作，现已完成修剪工作，12月13日上午10：00电话告知诉求人处理情况，该问题已实际解决，经办人：王洋。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '绿地绿化', '四级分类': '移植修剪', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704846307-2572143', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240110002042, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 10, 8, 34, 36), '诉求地址': '徐汇区中山南二路1007号', '诉求区域': '徐汇区', '内容描述': '市民反映：中煌大厦业委会部分委员不按业主公约，业主大会章程，违规使用业主委员会公章和业主大会公章。中标单位虚假陈述应标中标，造成严重不良影响，影响还在持续扩大中，业主还公布了一份违规事实录音，附件三要求监督函已有40多位业主自发签名（详见附件）。诉求：希望管理部门介入调查。', '工单类别': '一般', '处理描述': 