时间': datetime.datetime(2024, 1, 8, 9, 6, 49), '诉求地址': '宝山区宝钢十村16号', '诉求区域': '宝山区', '内容描述': '市民咨询：电力大用户密山幼儿园12月电费电量。诉求：请管理部门解答相关问题。', '工单类别': '一般', '处理描述': '经查，2024年1月8日15:00分，国网市北供电公司营销部电费账务组人员张炳昊电话联系客户，经与客户沟通，客户需要查询的一家企业户名为上海市宝山区密山幼儿园，故告知客户该企业2023年12月份电费为6618.05元，电量为10386度。客户表示满意。客户反映的查询“电力大用户密山幼儿园12月电费电量”已处理完毕。无其他负面影响。 ', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '电力', '三级分类': '用电计费', '四级分类': '缴费信息', '主办单位': '电力热线', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108002952, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 8, 16), '诉求地址': '闵行区虹桥火车站', '诉求区域': '闵行区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。市民反映市场物价问题。诉求：希望管理部门核实转送相关照片至承办部门。【相关工单编号：20240108002721】', '工单类别': '一般', '处理描述': '该咨询件所属举报件仍在调查中，已就咨询人提出问题进行《价格法》相关法律法规解答，并询问咨询人具体举报对象，咨询人仅答复为候车厅二楼厕所门口自动售卖机，并挂断电话。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '市场物价', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108002792, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 11, 33), '诉求地址': '长宁区娄山关路533号2902-2913室（拼多多）', '诉求区域': '长宁区', '内容描述': '催办单，市民来电反复催单。【最近派发的工单编号：20231224007568，工单内容：市民来电反映:其在拼多多平台上购买的商品大小尺寸不符，订单号：231214-117639792000019。但现在在退运费的问题上平台显示审核不通过。诉求：请管理部门核实并督促平台对此给予解释并退还运费。（市民要求市场监管局电话与其沟通，不要只发送一个链接让其填写相关信息）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231224007568，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704675916-2370550', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003212, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 13, 10), '诉求地址': '宝山区高境镇晨帆路泗塘河沿岸', '诉求区域': '宝山区', '内容描述': '【重新交办，要求：前件办结报告不明确，2023年反映希望在泗塘河沿岸安装椅子，管理部门承诺会安装，但至今未安装，诉求：希望管理部门尽快安装，并告知具体实施时间。最近办结的工单编号：20231207005160，工单内容：9月份反映过希望在沿河边步道边安放长椅，以便居民休息。高境镇街道回复在采购中，现在三个月过去了，还没安放，办事效率极低。诉求：希望管理部门尽快处理安放长椅问题。】', '工单类别': '一般', '处理描述': '我办接单后于8日10点先行联系市民，规生办回复：我镇规生办已在晨帆路及以北处各安装了长椅，以供市民休息。上述情况已告知。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '道路维护', '四级分类': '设备添置', '主办单位': '宝山区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003022, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 14, 24), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:企业缴纳社保的地址。', '工单类别': '一般', '处理描述': '转接人力成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '受理网点', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704676164-2370727', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003452, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 18, 32), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民反映：邮政快递送货上门只能送到楼下，不送上楼。市民未提供具体地址，请管理部门先行联系。诉求：希望管理部门核实整改。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003322, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 19, 56), '诉求地址': '徐汇区第六人民医院 ', '诉求区域': '徐汇区', '内容描述': '市民来电补充信息。市民补充信息内容为：市民表示第六人民医院接待办的工作人员给予市民答复告知该事件他们查不了也不属于他们管，让其自己去找对方，其表示不满意，希望卫健委加大监管力度，严查此事。（市民要求信息保密，需回复）【最近派发的工单编号：20231219034969，工单内容：市民来电反映:2023年10月28日有位名为吕鑫的人在上述地址进行伤情鉴定。市民称相关结果实际是虚假的，相关内容是莫须有的。市民诉求：请管理部门核实后对上述地址提供虚假伤情鉴定结果一事进行整治。（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231219034969，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704676467-538083', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003902, '工号': 1400, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 20, 59), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704676780-2371232', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003882, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 21, 34), '诉求地址': '浦东新区曹路镇民风小区', '诉求区域': '浦东新区', '内容描述': '市民反映：民风小区新买车辆业主排队等候车位，但收费按照临停每天5元计算，其认为不合理。诉求：希望管理部门核实并给予合理解释。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '市民您好，曹路镇曹路居委反馈：经核实了解，小区目前的停车收费标准是通过小区业主大会表决通过的，第一辆车排队等候车位的除了5元每天计算，还可以包年每年800元计算，停满8个月以一年计算，未停满物业则按照实际天数退款，您可前往办理。（先行联系录音与回复录音为同一录音）', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '乱收停车费', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003392, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 22, 6), '诉求地址': '奉贤区南奉公路龙华附属中医医院', '诉求区域': '奉贤区', '内容描述': '市民来电补充信息。市民补充信息内容为其表示有管理部门联系市民告知需要重新挂号的原因是因为由于不重新挂号会导致药品的积压，然后卫健委差下来会对医院进行扣分所以才这样的，市民不认可【最近派发的工单编号：20240102001662，工单内容：市民来电咨询:2024年1月2日至上述地址接种第二针狂犬病疫苗，被告知还需要挂号，对此市民不解，诉求：管理部门核实给予解释为何还需要挂号原因。（需要回复）】\n', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240102001662，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '排队挂号', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704676534-538144', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003552, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 23), '诉求地址': '崇明区崇明区陈家镇安通路999弄5号楼204-210', '诉求区域': '崇明区', '内容描述': '【重新交办，答复要点与事实不符合。市民来电反映:没有人联系市民处理解决，诉求不变。最近办结的工单编号：20231217008138，工单内容：市民来电反映:2023年10月14日在上述地址上海沁寻艺教科技有限公司报名学架子鼓，费用交了6380元，签过合同，上了7节课换老师了孩子不想学就要求退费，对方表示按照7380元算单价的，市民觉得价格算的不对，交了6380元48次课，认为上了7次课换老师相当没有学还浪费了时间，现诉求：请管理部门协调全额退款。】', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，对该事项投诉调解的法定职责如下：在行业分类上，文化艺术辅导属于教育大类，行业主管部门是教育部门，行政执法部门是市场监管部门。且根据《教育部等六部门关于加强校外培训机构预收费监管工作的通知》，由教育部、市场监管总局等六部门将学科类和非学科类校外培训机构预收费应全额纳入监管范围，包括通知发布前已收取但未完成培训服务的预收费资金。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。若涉嫌合同纠纷，可向法院起诉。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为...', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '培训市场', '四级分类': '市场监管', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704676754-2371213', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003772, '工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 24, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704676998-538523', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003732, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 24, 48), '诉求地址': '杨浦区松花江路1160弄', '诉求区域': '杨浦区', '内容描述': '市民来电反映:上述地址小区的东门上，经常有人在铁门上挂衣服晾晒。诉求：希望核实并制止。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派控江路街道进行处理。据控江路街道回复：先行联系：我单位接单后联系来电人进行了简告。 情况核实：经核实情况属实，诉求合理合法。 处置过程及回访：接到工单后，我单位到现场查看，情况属实，队员责令当事人自行整改，现已整改完毕。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704676960-329397', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108003492, '工号': 4342, '工单生成时间': datetime.datetime(2024, 1, 8, 9, 25, 13), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民在随申办办理居住证业务，改了地址信息，从内环改到了外环，但随申办上一直没有显示新的地址信息，车管所的地址也未更新，使市民无法申请外环的牌照。', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证', '主办单位': None, '是否匿名': None, '服务类型': '一网通办