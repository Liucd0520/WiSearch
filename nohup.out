 10, 28, 3), '诉求地址': '徐汇区龙腾大道龙启路', '诉求区域': '徐汇区', '内容描述': '市民来电表示撤销工单，撤销原因，撤销掉才给市民发工资。【最近派发的工单编号：20231229015979，工单内容：市民来电反映:之前在该处阿里巴巴的建筑工地干活，拖欠其6000多元工资，告知下个月才能给，其不认可，不清楚承建单位信息。诉求：请管理部门核实帮助本月内支付工资。】', '工单类别': '一般', '处理描述': '根据《  关于市民要求撤单的处理口径 》告知市民，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704248686-2701049', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007972, '工号': 3802, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 28, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704248808-2443317', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007902, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 29, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:本市各大网约车平台上有大量无双证的网约车。诉求：请管理部门核实，要求依法处理。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '市交通委执法总队已对您反映的情况作备案，并将依据《网络预约出租汽车经营服务管理暂行办法》、《上海市网络预约出租汽车经营服务管理若干规定》、《上海市出租汽车管理条例》、《上海市查处车辆非法客运办法》等相关法规，开展专项执法整治工作，加强对网约车平台的监管，继续保持对违规网约车和非法客运的高压整治态势，一经发现违法行为，将立即予以查处，感谢您对我们工作的理解和支持。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704248736-663792', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007872, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 3, 10, 30, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:妻子迁户口如何办理。', '工单类别': '一般', '处理描述': '根据,《闵行区古美路街道社区事务受理中心》,《闵行区古美派出所信息》,《市内户口迁移与立户窗口服务告知单（当场办理）》告知，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '市内户口迁移', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704248692-408269', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三