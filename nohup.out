'工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 23, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704701946-2696161', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108027062, '工号': 3022, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 24, 51), '诉求地址': '虹口区水电路与凉城路之间的广中路南面', '诉求区域': '虹口区', '内容描述': '【重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符，至今路面还是不平整，之前也来修复过，但是都是偷工减料的工作，也不用机器将路压平整。施工单位草草了事。诉求：望管理部门核实做好监督工作，彻底将路面修复平整。（需回复）最近办结的工单编号：20231224006959，工单内容：【重新交办，关联工单20231208026757】，市民短信回复：承办部门已联系，告知市民会后续维修，会进行上报，市民表示路面一直没有修复，故对此不满意，希望尽快维修不平整的路面。【最近办结工单：20231208026757，工单内容：【重新交办，要求：按答复市民要点告知市民，市民表示答...', '工单类别': '次紧急', '处理描述': '区建管委于2024年01月08日17时05分在网上工作平台接收编号为202401086785900155的工单，其内容描述为“反映水电路至凉城路之间的广中路非机动车高低不平，市民车辆已经损坏多次，望尽快处理”。接到工单后，区建管委工作人员于01月08日17时50分联系了李女士（市民），进一步了解该市民的诉求。经了解，该处为燃气管道改造工程和综合合杆整治工程范围，虹口区市政和水务管理中心已通知施工单位进行处理，针对非机动车不平事宜进行修复，由于已临近年关，将于年后工人返工后安排修复。电话联系市民，表示理解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': '道路养护', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704701558-396353', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108027612, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 25, 31), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:外省市社保转入本市如何办理。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '养老保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704702078-605941', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108028022, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 26, 16), '诉求地址': '浦东新区利津路185弄46号大门口', '诉求区域': '浦东新区', '内容描述': '市民反映：在物业不同意的情况下，上述地址46号楼有业主私自安装充电桩，占用了业主共用区域且存在用电安全隐患。诉求：要求整治。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '沪东新村街道莱阳新家园居委接到诉求后，立即对所述情况进行核实，经确认，该充电桩为2023年小区停车管理办法出台之前安装，此次为旧充电桩换新壳，无需物业另行敲章确认，且并没有安装在业主家用电表中，不存在用电安全隐患。诉求人未留联系方式无法联系，因此没有评价。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108027212, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 26, 31), '诉求地址': '长宁区长宁区娄山关路533号2902-2913室 上海寻梦信息技术有限公司', '诉求区域': '长宁区', '内容描述': '市民来电反映:其在拼多多买了羽绒服（订单号：231123142868499230352,费用：42.73元）现因质量问题想要退款或者换货平台都不处理故来电反映。诉求：希望管理部门为其协调退款或者换货。（需回复）', '工单类别': '一般', '处理描述': '经拼多多平台协调，已为投诉人处理，投诉人已接受，双方协商达成一致。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704701676-396443', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108027432, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 27, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 抖音商场，订单编号：6925109334555825562，买了一瓶茅台，价格：4500多元，鉴定下来是假酒。  诉求：要求假一罚四。', '工单类别': '一般', '处理描述': '经核实，被诉企业抖音平台联系消费者未接通，我局无法介入调解，终止调解；平台违法事实不成立，建议向商家实际经营地县级以上市场监管部门反馈。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704701870-2439635', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108027792, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 28, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:惠州和上海同时缴纳了医保，1月开始惠州停缴，只在上海缴纳医保，但目前处于等待期，要2月1日开始可以享受上海医保，咨询等待期自费看牙时候是否可以报销。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704702301-396960', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': N