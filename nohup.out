CREATE TABLE gjw (
	`编号` BIGINT, 
	`年份` BIGINT, 
	`区局` TEXT, 
	`姓名` TEXT, 
	`年龄` BIGINT, 
	`姓名拼音` TEXT, 
	`性别` TEXT, 
	`工作单位` TEXT, 
	`工种或工作头衔` TEXT, 
	`领域` TEXT, 
	`行业` TEXT, 
	`工匠介绍` TEXT
)ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE utf8mb4_0900_ai_ci

