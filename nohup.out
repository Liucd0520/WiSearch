': 2920, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 32, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询处理进度。【最近派发的工单编号：20240107020010，工单内容：市民来电反映:市民两个手机号：15021304261，14790690930.都被12348法律热线莫名其妙拉黑了，说市民咨询的行政类案件，说不属于法律问题。诉求：要求投诉。（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '已告知管理部门正在处理中，市民挂断电话，回拨不通，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '法律援助', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704781755-721725', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020262, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 32, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【表扬】市民来电咨询:表扬沈杜公路的交警，一名姓顾的交警，警号042544，1月6日19:45左右市民发生了交通事故，当时未记录车牌号，该交警认真负责当场帮市民看了很久的监控，隔日告诉市民找到了逃逸司机，诉求：表扬该交警认真负责。', '工单类别': '一般', '处理描述': '闵行分局交警支队六大队民警杨蔚青（警号：041570）于2024年1月15日09时15分与来电市民刘女士取得联系。其主要反映表扬沈杜公路的交警，一名姓顾的交警，警号042544，1月6日19:45左右市民发生了交通事故，当时未记录车牌号，该交警认真负责当场帮市民看了很久的监控，隔日告诉市民找到了逃逸司机。针对其反映情况，交警支队六大队在与诉求人电话联系中，感谢其对大队事故组民警工作的认可和理解。同时，大队对民警顾晓斌（警号：042544）进行了表扬，希望其今后工作中继续努力，发挥为民服务精神，树立良好形象。经沟通解释，市民表示理解。（该件无110警情）（解释说明）', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '表扬承办部门', '四级分类': '表扬感谢', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704781701-2556820', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020342, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 33, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其公司员工在上下班途中发生交通事故，询问认定工伤的相关问题。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '工伤', '四级分类': '工伤认定', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704781776-467513', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109019552, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 34, 19), '诉求地址': '本市上海皓念汽车租赁服务有限公司，地址不清楚', '诉求区域': '本市', '内容描述': '市民来电反映:其1月4日在哈啰出行上租了上述公司电车，代步使用，注册手机号17621512542。该公司没有营运资质，且将非营运车辆拿来营运，提供市民故障车，没有提供租车协议。平台规定电车电费每公里不高于3毛钱，但该商家却收费每公里4毛钱，市民申请新车，商家却提供2020年的车\n，诉求：需回电市民，给予合理解释', '工单类别': '一般', '处理描述': '沟通时间： 2024-01-20 11:26:24事实认定：不属实处理结果：致电用户已安抚致歉，考虑服务体验，补偿用户100元，认可结案。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704781003-721061', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020502, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 34, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:小朋友医保共济了但是没有扣费导致医保无法使用。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704781960-721911', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020522, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 38, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其在日上免税APP上购买了NARS流光美肌清透蜜粉底限量款，订单:RKN5P0、金额:308元，现产品有质量问题壳是花的且还掉漆，有向日上免税反映并上传了照片，告知不影响使用不予处理，市民表示公司名称为:日上免税上海有限公司，具体地址其不清楚。诉求:望管理部门核实，退货退款。（需回复）', '工单类别': '一般', '处理描述': '经查，商家已与消费者解释说明，商品并非工艺品，外壳生产过程中存在细微的注塑瑕疵并非质量问题，另根据消费者的交易快照显示，消费者购买的商品不支持七天无理由退货，非质量问题商家拒绝退货退款。经调解，双方无法达成一致，故终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704781968-467705', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020752, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 39, 19), '诉求地址': '闵行区虹桥镇', '诉求区域': '闵行区', '内容描述': '市民来电咨询:闵行区虹桥镇领取居住证的电话', '工单类别': '一般', '处理描述': '根据《闵行区虹桥镇社区事务受理服务中心》答复，市民认可，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '社区家政', '四级分类': '社区服务网点', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704782222-467919', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020532, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 40, 31), '诉求地址': '松江区茸盛路茸惠路 金地丰盛道', '诉求区域': '松江区', '内容描述': '市民来电反映:其是上述地址建造房屋的农民工，被拖欠工资人数10-20个人，被拖欠金额共计100多万元，没有签署过劳动合同，金地丰盛道项目曹经理电话为15205172064。诉求：请管理部门核实，协助讨薪。（需回复）', '工单类别': '一般', '处理描述': '经调查，项目部正在核实结算工资，等建设方工程款拨下来后，立即发放，具体发放时间由项目部决定。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '建筑工程欠薪', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704781970-2767970', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020832, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 42, 16), '诉求地址': '浙江省杭州', '诉求区域': '浙江省', '内容描述': '市民来电反映:未成年游戏充值，网易游戏公司注册地在浙江杭州', '工单类别': '一般', '处理描述': '转接浙江12345专席成功,归档', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '文广影视', '三级分类': '文化产业管理', '四级分类': '游戏动漫', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704782344-722258', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020772, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 42, 41), '诉求地址': '奉贤区青村镇朱店村', '诉求区域': '奉贤区', '内容描述': '市民来电咨询办理进度。【最近办结的工单编号：20231223012157，工单内容：市民来电反映:奉贤区青村镇朱店村，具体门牌号无法提供，所属业达建工，城建上海颐禾都市生态园项目工程，目前工地回收旧木材，全都是粉尘，诉求：查实处置项目工程回收及粉尘问题。（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '按答复要点告知，答复清晰明确，已解释归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704782295-722212', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020852, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 43, 22), '诉求地址': '杨浦区殷行路487号', '诉求区域': '杨浦区', '内容描述': '市民来电反映:杨浦区殷行路487号里面有暗室，做春卷皮，无证经营，诉求：希望管理部门取缔。（信息保密，无需回复）', '工单类别': '一般', '处理描述': '经查，被举报的经营者属于“乱设摊”，建议举报人向城管反映。因举报人未留任何联系方式，无法告知举报人该情况。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '无照经营', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704782346-722261', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020862, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 43, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【长三角】市民来电咨询:上海医保，2023年12月份在上海上班缴纳医保，社保卡未出来，需要等待2个月。社保卡原来有钱的，', '工单类别': '一般', '处理描述': '转接医疗专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704782385-2768326', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020842, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 44, 27), '诉求地址': '宝山区罗店镇毛家路125弄106号', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述地址是工厂园区，里面有两三家公司，投诉该园区的工厂晚上噪音扰民，园区内有龙门吊作业，每天晚上不规定时间作业，声音很响，严重扰民。诉求：请管理部门核实，规范做业时间，夜间不要扰民。', '工单类别': '一般', '处理描述': '工作人员于2024年1月10日14时先行联系来电市民，2024年1月19日15时回复来电市民：经查，信访人反映的毛家路125弄106号内场地有玻璃堆放。1月2日夜间检查时，厂区内无明显噪声，无明显异味。环保人员已要求厂区负责人夜间不得进行产生噪音的生产作业。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704782321-722237', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109020932, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 44, 41), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其是无锡的哈罗顺风车司机，市民表示哈罗将其账户进行封号，将其钱进行冻结', '工单类别': '一般', '处理描述': '告知市民，司机与平台问题，建议跟平台反映，归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704782392-722310', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109019732, '工号': 3660, '工单生成时间': datetime.datetime(2024, 1, 9, 14, 44, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:', '工单类别': '一般', '处理描述': '依法告知', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '律师服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编