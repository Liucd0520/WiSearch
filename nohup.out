22, '工号': 4352, '工单生成时间': datetime.datetime(2024, 1, 5, 18, 2, 22), '诉求地址': '静安区东宝兴路218号地下2层 健美天地（上海屹励健身有限公司，电话不清楚），近青云路', '诉求区域': '静安区', '内容描述': '市民重复来电：查询办理进度【最近办结的工单编号：20200531014831 工单内容：市民来电反映：其和家人（王雯君）分别在上述地址办理了健身年卡。802839原本在上述地址办理了健身年卡（非一对一私交），现商家把健身房转让给一兆韦德，导致其家无法正常消费。其健身卡卡号：800889，现年卡还剩18个月，折合5300元左右。其家人健身卡卡号：802839，还剩余两年，折合7000元。市民表示上述地址转让前告知一兆韦德会全盘接手，按照原合同履行，但实际其前往消费时被要求加钱。诉求：希望管理部门核实并要求退还剩余月份费用。】', '工单类别': '一般', '处理描述': '按答复要点告知市民，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105030702, '工号': 4292, '工单生成时间': datetime.datetime(2024, 1, 5, 18, 3, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704448896-147637', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105030732, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 5, 18, 8, 20), '诉求地址': '浦东新区康桥镇上南路6555弄天台别韵小区', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民之前反映该小区外的垃圾清运站噪音扰民的问题，相关部门已处理，但目前又恢复。情况好了两个星期，于2024年1月1日开始，工作日05:45开始作业，周末06:00开始作业，噪音非常厉害，严重扰民。诉求：诉求：请管理部门核实协调，让垃圾清运站控制噪音不要扰民。', '工单类别': '一般', '处理描述': '接单后与诉求人先行联系，了解相关情况，后立即通知康南保洁公司，现该小区垃圾清运时间已调整至6点之后进行清运，尽量避免人为产生噪音扰民现象，请理解环卫工作的特殊性，已将反馈信息告知诉求人，其表示认可，先行联系和回复为同一段电话。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704448989-147678', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105030842, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 5, 18, 8, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:菜鸟驿站的件服务态度问题。', '工单类别': '一般', '处理描述': '超出受理范围。', '客户类型': '个人', '一级分类': '公用事业类', 