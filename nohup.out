', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104025802, '工号': 3262, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 14, 8), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '【重新交办，要求：按答复市民要点告知市民，市民表示前件答复市民要点不符，市民称其至今没有接到管理部门电话，其也没有拿到此项电梯补贴款，钱打到加梯负责人张梅账户中也没有进行分款，故对此回复不认可。诉求：请管理部门核实并要求继续处理其反映的电梯补贴款事宜（需回复）。最近办结的工单编号：20231206014228，工单内容：【重新交办，要求：按答复市民要点告知市民，市民表示前件答复市民要点不明确，市民表示其是业主，但10万元的金额市民并未收到，且剩余的18万元金额的情况市民已经向街道居委反馈，但一直没有给到市民同步的情况，要求重新处理。最近办结的工单编号，工单内容：【投诉】...', '工单类别': '一般', '处理描述': '花木街道培花一居委接单后回复：诉求人所说的芳华路53号于2020年小区加装电梯已经完成，现在政府补贴加装电梯28万元诉求人认为还没有到居民账户中，而事实是其中一部分前期钱款10万元已于2023年10月30日在居委和居委主任的见证下打入加梯负责人张梅账户中，就等待如何分配。剩余钱款居委房办正在努力积极申请中。还请居民耐心等待。因此28万补贴没有全部打入居民账户是不属实的，其中一部分已经进入居民账户中。居委已一直和当事人联系告知进展，所以也不存在没有任何部门联系当事人。（先行录音和回复录音为同一录音）', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704355514-801329', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104026322, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 15, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其办理特种设备登记手续。市民称管理部门发回的数字签名无法读取。市民诉求：请管理部门核实后尽快采取措施解决上述问题。', '工单类别': '一般', '处理描述': '已电话告知并解决', '客户类型': '企业', '一级分类': '安全监管类', '二级分类': '质量技术监督', '三级分类': '特种设备监察', '四级分类': '安全监察', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704355790-67692', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104026392, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 15, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 咨询医保问题。', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704355842-801605', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104026462, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 15, 41), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其妻子参保地是上海，在外省市生育的医疗', '工单类别': '一般', '处理描述': '转接医疗成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704355938-67816', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104026602, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 18, 35), '诉求地址': '闵行区莘庄工业区', '诉求区域': '闵行区', '内容描述': '市民来电咨询:咨询外省市丢失身份证是否可以补办', '工单类别': '一般', '处理描述': '根据《闵行区莘庄工业区派出所信息 》,《闵行区莘庄工业区社区事务受理中心 》,《外省市来沪人员申领、换领、补领居民身份证，申领临时居民身份证《窗口服务告知单》 》答复，市民知晓，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '身份证管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356039-801770', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104026582, '工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 21, 28), '诉求地址': '杨浦区五角场街道国顺路117弄垃圾房对面', '诉求区域': '杨浦区', '内容描述': '市民来电反映:上述地址小区内有垃圾房，但是现在小区内的保洁人员将回收来的泡沫、纸板、破旧自行车都堆放在了小区绿化带里，大概有30平，还造成绿化的破坏，有些回收物品还堆放在小区居民楼1楼的围墙边，故市民来电投诉，要求清理回收物品并恢复小区绿化，望管理部门核实处理。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派五角场街道进行处理，据五角场街道回复：先行联系：反映人无联系方式故无法简告。 情况核实：不属实 处置过程及回访：1、经了解，反映人提出的地点是该小区的临时大件垃圾堆放点，工作人员会定期清理。根据小区实际情况考虑堆放在此处。2、经现场查看，投诉人所述国顺路117弄垃圾房对面，该处不存在毁绿行为。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '垃圾清理', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356028-801757', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104026862, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 21, 51), '诉求地址': '徐汇区云锦路183弄', '诉求区域': '徐汇区', '内容描述': '市民来电反映:市民是上述地址小区业主，向物业申请安装充电桩，物业称电容不够，一直不处理，诉求：希望管理部门核实，协调准予安装（需回复）。', '工单类别': '一般', '处理描述': '龙华街道12345热线于2024年01月05日接到市民反映云锦路183弄百汇园一期地下车库物业告知无法安装充电桩的工单，热线工作人于01月05日16：47分致电先行联系市民告知工单已经收到会尽快转相关部门处理并给予回复。经热线工作人员与物业经理现场核实，目前百汇园一期交房至今已经16年多，当时由于无充电汽车，故涉及初期的电容量远远不发满足目前业主电动汽车的充电需求，经过现场核实，一期地库内七八个电表房内的电表箱基本已经空间全部装满已经饱和，且电容量也不够，也曾经发生短路等情况，目前物业已经像电力部门申请进行扩容，等电力扩容后才可能再决定是否满足后续业主安装的需要。该情况热线工作人员已经于...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '徐汇区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356321-2887344', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104026892, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 22, 47), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:浦东新区劳动仲裁部门电话。', '工单类别': '一般', '处理描述': '与市民解释说明，市民认可，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '用工规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356423-2887426', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104026842, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 23, 38), '诉求地址': '浦东新区和炯路601弄9号1905室', '诉求区域': '浦东新区', '内容描述': '【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,其从2022年下半年开始未使用，共计1年半时间。相关情况之前东方有线并未通知其。市民诉求：请管理部门核实后督促对方对此事给予合理解决方案。最近办结的工单编号:20231208024012，工单内容:市民来电反映:其为上述地址居民2年东方有线电视未使用但是产生了费用，对此费用不认可。诉求：希望督促尽快免除费用（需回复）】', '工单类别': '一般', '处理描述': '接报后我司立即联系用户2023年费用协商用户支付4个月，用户不接受，表示只接受支付3个月。告知用户提供电费证明，若确实不居住，其支付3个月。用户不愿提供，我司无法满足', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '文广影视', '三级分类': '广播影视', '四级分类': '东方有线', '主办单位': '东方有线网络有限公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356305-2105369', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027002, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 26, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:港澳台居民如何申领社保卡。', '工单类别': '一般', '处理描述': '根据《香港、澳门、台湾居民如何申领社会保障卡》告知市民，市民认可，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356476-2887467', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027412, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 26, 58), '诉求地址': '普陀区静宁路155弄臻如府', '诉求区域': '普陀区', '内容描述': '市民反映：臻如府的物业于6月8日至6月9日找了第三方机构检查小区的消防情况，第三方机构因小区消防设备等存在问题，出具了整改清单，小区消防安装单位为上海东欣安防工程有限公司。清单上，小区存在消防控制室火灾自动报警系统部分回路没电、部分报警主机传输故障、消防控制室CRT故障和部分设备未定义、部分没有汉字描述等重大问题，以及日常中小区楼栋消防防火门无法保持常闭（楼梯消防门被打开后保安不能及时发现，不能主动关闭）、楼梯消防通道堵塞未清理、消防水管漏水（1月1日左右，6号楼消防水管破裂，水流入电梯导致电梯运行故障）。目前已经超过预计整改的最晚完成日期2023年8月30日，业主们多次询问整改进度，物...', '工单类别': '一般', '处理描述': '2024年1月5日上午，普陀分局石泉路派出所通过电话先行联系伍女士，了解相关情况。根据伍女士所反映的小区消防问题，石泉路派出所民警到静宁路155弄小区开展消防检查，对检查中发现存在问题，要求小区物业限期整改。2024年1月18日11时04分，石泉路派出所民警再次电话联系伍女士，将相关工作情况与其进行了沟通、交流，伍女士对民警工单办理情况及答复内容表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '消防管理', '四级分类': '消防隐患', '主办单位': '市公安局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027012, '工号': 3870, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 27, 2), '诉求地址': '江苏省', '诉求区域': '江苏省', '内容描述': '【长三角】市民来电反映:其家人乘坐从苏州出发的长途汽车至贵州六盘水，有车费纠纷。', '工单类别': '一般', '处理描述': '转接江苏12345成功,归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '外省市受理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356500-68315', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027132, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 30, 40), '诉求地址': '嘉定区曹南路166号新峰哥出行', '诉求区域': '嘉定区', '内容描述': '市民来电反映:1月3日晚上通过上述地址租的电动车，先用后付，支付宝上扣的，有合同的，月租至少一个月，公司之前说是管吃管住，车免费用，存在欺诈行为，1月4日退车需要支付699元才能解约，否则不能解约，诉求：把车退了。', '工单类别': '一般', '处理描述': '双方已协商解决，投诉办结。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356693-802317', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027352, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 31, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:POS机收费高', '工单类别': '一般', '处理描述': '根据《全国金融行业咨询投诉电话》认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356925-2887838', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027402, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 31, 22), '诉求地址': '浦东新区上海盛付通电子商务有限公司', '诉求区域': '浦东新区', '内容描述': '市民反映：其使用上海盛付通电子商务有限公司pos机，其在不知情的情况下被套取高额手续费，刷1000元扣了404.8元手续费  ，属于欺诈。诉求：希望管理部门督促该公司退回高额手续费404.80元。', '工单类别': '一般', '处理描述': '根据《中华人民共和国中国人民银行法》《非金融机构支付服务管理办法》和《非银行支付机构网络支付业务管理办法》等法律法规，支付机构依法接受中国人民银行的监督管理。中国人民银行是国务院组成部门，各省市人民银行分行是其派出机构，履行对辖内有关金融机构的监管职责。建议拨打中国人民银行设立的全国金融消费咨询投诉统一热线“12363”。以上信息由【市地方金融监管局】提供，信息供参考', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104026972, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 33, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民在网上看到针对男性职工除了生育假外可以领取护理津贴咨询是否属实', '工单类别': '一般', '处理描述': '未查询到相关信息，归档', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '人口计生', '四级分类': '再生育政策', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357049-68733', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027592, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 34, 42), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357202-2888035', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027582, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 34, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '为市民转接拼多多专席，转接成功，此单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357179-802707', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027452, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 35, 45), '诉求地址': '闵行区莲花南路1500弄4号105、111室好药师恒华大药房', '诉求区域': '闵行区', '内容描述': '市民来电反映:1月4日12:00分左右去买药，店员问其有没有医保，其表示有医保的，随后拿了很多药开了单子直接刷了医保，其是要买感冒药，金额：475元，工作人员是老太太，和男性，药已经退掉了，诉求：投诉操作不规范，以及开了475元的药。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '此工单为无需回复工单，根据市民反映家人于2024年1月4日12:00持其社保卡在闵行区上海好药师恒华大药房购药，除所需药品以外还配售多款药品并刷卡结算，相关药品费用已进行退款，对药店工作人员购药服务中的操作不满。根据沪医保规（2023）5号文及相关规定，定点零售药店为参保人员提供的医保用药服务包括处方药品外配服务和非处方药品自购服务。定点药店应当根据《处方管理办法》等处方药品外配服务的有关规定，向参保人员提供处方药品的配售服务。对不符合外配处方要求的，将外配处方予以退回，并记录在案。定点药店应当按照行业主管部门对相关药品配售服务规范，在向参保人员提供非处方药品配售服务时，严格执行基本医疗...', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '医疗保险', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357056-802603', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027522, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 37, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:单位有上海牌照的国五的机动车。市民咨询车如转到的其名下，是否能使用额度上牌。', '工单类别': '一般', '处理描述': '转接车管所专席成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357106-2106032', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027682, '工号': 3022, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 39, 34), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多专席。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357489-2888260', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027042, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 39, 56), '诉求地址': '拼多多', '诉求区域': '本市', '内容描述': '市民来电反映:在拼多多购买挂历，12月29日下单，9K定制版，33元，有凭证，1月3日收到，给市民发的很小的日历，没有与市民沟通过，联系平台，只赔偿30多元，市民要求根据消法赔偿500元，诉求：希望管理部门核实赔偿。（需回复）', '工单类别': '一般', '处理描述': '"经拼多多平台协调，已与投诉人协商处理，投诉人已接受，双方协商达成一致。 "', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704356851-802439', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027712, '工号': 1132, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 42, 6), '诉求地址': '嘉定区招贤路133号（中天建设有限公司）', '诉求区域': '嘉定区', '内容描述': '市民来电反映:2023年10月-11月底在建筑工地担任瓦工，工地拖欠8人工资共6万多元。诉求：追讨工资。（需回复）', '工单类别': '一般', '处理描述': '2024年1月5日我单位收到黄先生反映的关于上海市嘉定区嘉定工业区南门社区JDC1-0801单元62-03地块项目（报建编号：2102JD0437）的欠薪问题，1月5日我单位联系信访人，信访人称其在上述工地从事工作，现拖欠其8人共计6万元工资。1月5日我单位联系项目中天建设集团有限公司要求尽快核实诉求人的欠薪情况，经核实，诉求人反映情况属实，此工单即将到期故进行阶段性回复。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '建筑工程欠薪', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357315-68912', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027772, '工号': 3542, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 42, 14), '诉求地址': '虹口区', '诉求区域': '虹口区', '内容描述': '市民来电咨询:德高国际物流（上海）有限公司，1月3日下午14:00左右接到自称消防中心的电话，对方号码：69131652，称要到企业做消防培训。诉求：请管理部门核实是否属实。', '工单类别': '一般', '处理描述': '2024年1月5日，虹口区消防救援支队工作人员通过电话回复信访人，1、经查询，69131652的电话号码非我支队办公电话；2、虹口区消防救援支队没有“消防中心”这个部门；3、消防救援机构组织开展宣传培训活动均为免费培训且严禁贩卖销售任何消防产品；4、如您在参加第三方的消防培训活动中因对方招摇撞骗造成经济损失的，请及时固定证据并向公安机关报案。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '消防管理', '四级分类': '消防宣传', '主办单位': '市消防救援总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357381-2888175', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027982, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 43, 36), '诉求地址': '长宁区', '诉求区域': '长宁区', '内容描述': '市民来电反映:拼多多车垫没有发货联系不上客服', '工单类别': '一般', '处理描述': '转接成功,归档根据《》,《》', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357650-2888374', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027782, '工号': 4160, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 44, 31), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:公司车辆变更联系方式怎么办理？', '工单类别': '一般', '处理描述': '根据《变更机动车联系方式》告知，市民认可', '客户类型': '企业', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357718-2106484', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104027922, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 44, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:生育保险问题，8月份在上海交医保，现在怀孕3个月，在杭州建卡生孩子，以后是否会影响上海的生育保险。', '工单类别': '一般', '处理描述': '转接医保成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '生育保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357624-2106419', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104028322, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 47, 36), '诉求地址': '虹口区东大名路501号上海白玉兰广场9楼B01室', '诉求区域': '虹口区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。微信群名称：VOLVO技术交流群。群主：曹祝华；当晚在现场的知情人: 姜磊、李炎君。诉求：希望管理部门核实转送相关照片至承办部门。【相关工单编号：20231226018292】', '工单类别': '一般', '处理描述': '经核，该工单为重复工单，相关情况已于1月2日答复举报人。 经核，举报人反馈沃尔沃汽车销售（上海）有限公司偷漏税的事宜，因未提供有效材料，根据《税收违法行为检举管理办法》（国家税务总局令第49号）第二十条第三款，检举事项不完整或者内容不清、线索不明的，暂存待查，待检举人将情况补充完整以后，再进行处理。后续如您有相关材料提供，请携带相关证据资料（或邮寄）至嘉定区人民街142号东楼举报中心举报处理。——承办单位：嘉定区税务局', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '税收管理', '四级分类': '偷税漏税', '主办单位': '市税务局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104028202, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 50, 7), '诉求地址': '宝山区杨泰路196号1栋1469E', '诉求区域': '宝山区', '内容描述': '【重复交办，答复要点简单不明确，市民表示：其登陆官网没有看到相应的流程，诉求：告知具体如何退款，在官网上。最近办结的工单编号：20231216010213，工单内容：市民来电反映:其给孩子报名了上述地址企业：掌门一对一的文化课，孩子没有上，但是课时被扣了，绑定的手机号：13805112901，企业的另一个地址：虹口区嘉兴路街道四平路93号，诉求：请管理部门核实处理给予解决方案】', '工单类别': '一般', '处理描述': '您好，关于您投诉上海掌小门教育科技有限公司一案，经调解，无法达成调解协议,我局终止调解,但上海掌小门教育科技有限公司承诺按合同（登陆官网可查询）退款，但由于近期被投诉人处理退费业务量过大，被投诉人正在按照用户申请退费的日期进行排队处理,请确认已按照该公司的退款流程完成操作并耐心等待。[宝山区市场监督管理局]', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '培训市场', '四级分类': '市场监管', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704357979-803200', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104028572, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 51, 23), '诉求地址': '浦东新区康泽路655弄', '诉求区域': '浦东新区', '内容描述': '市民反映：浦东新区康桥镇壹府澜庭小区，康泽路555弄存在大量叠墅私开天窗及平台搭建阳光房，对59号，60号，11号楼等多栋高层造成反光，居民多次投诉，逾期几个月，城管均未执法。而对于高层入户走廊玻璃，城管在5个工作日内就迅速拆除。其认为城管应秉公执法，对壹府澜庭小区内所有违建行为一视同仁，而非选择性执法，让人怀疑其公正性。诉求：投诉康桥镇城管选择性执法、不作为。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '接单后康桥镇环境整治办公室联系诉求人了解相关情况，后派工作人员到现场实地核实，投诉人反映的私开天窗的行为已由物业居委进行排摸，告知业主整改，若业主其不愿意整改的，将由物业统计后上报城管中队，城管中队将予以立案查处。不存在城管不作为的情况。故作不属实件（见附件）。已反馈，未评价。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '城管执法', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104028352, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 4, 16, 53, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要转拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704358118-2888675', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 202