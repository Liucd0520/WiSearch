: None, '服务类型': '综合服务', '通话编号': '1704786592-2561324', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109024892, '工号': 4300, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 51, 4), '诉求地址': '闵行区上海东海职业技术学院', '诉求区域': '闵行区', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民称入职真的很需要这个，很急，希望管理部门尽快办理。【最近派发的工单编号：20240109018475，工单内容：市民来电反映:市民是上述地址学校的学生，其因为考试没过拿到了结业证书，现在重修成功了，市民要更换毕业证书，学校告知需要等到3月，可市民入职急需该毕业证书，故来电（身份证：310226200205063237）。现诉求：望管理部门查，协调尽快为市民更换毕业证书】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240109018475，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '学校管理', '四级分类': '学籍管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786417-2772099', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109024662, '工号': 4260, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 52, 7), '诉求地址': '浦东新区海阳西路101号', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:2022年3月中旬到6月中旬市民在上述地址因为疫情被隔离。诉求：咨询隔离期是否有隔离费用可以申领，以及隔离费用如何办理申领。', '工单类别': '一般', '处理描述': '您好，三林镇防疫办接单后，先行联系已回复您，疫情期间，没有隔离费用可申领的政策。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '疾控防疫', '四级分类': '其他', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786214-2560977', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025072, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 54, 15), '诉求地址': '浦东新区航城路唐黄路', '诉求区域': '浦东新区', '内容描述': '市民来电补充信息。市民补充信息内容为市民表示该问题并未得到解决，现每天都在偷倒，现市民希望管理部门尽快处理。【最近派发的工单编号：20231228027694，工单内容：市民来电反映:上述地址路口12月28日17:06左右有人在非法倾倒渣土，民义村村委可能也参与其中，诉求：希望管理部门核实尽快查处（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231228027694，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '环境垃圾', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786654-726071', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025152, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 54, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:本市户籍未成年人护照换发业务能不能在网上办理', '工单类别': '一般', '处理描述': '转接出入境专席成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（出入境）', '三级分类': '护照办理', '四级分类': '护照办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786742-726145', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109024922, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 54, 51), '诉求地址': '闵行区航华一村二街坊', '诉求区域': '闵行区', '内容描述': '市民来电反映:   市民是上述地址小区租客， 在上述地址小区停车一天停车费封顶是30元，但是物业保安一天里会拆开多次收费，加起来远远超过封顶的30元，收了停车费也没有开具正规发票。市民要求投诉乱收停车费。', '工单类别': '一般', '处理描述': '七宝镇七宝航华部门于1月9日与来电人先行联系，并对诉求信息进行确认。经现场查看，小区大门口使用的是道闸系统，进出由系统记录，临停收费标准为1小时内免费、1小时-4小时5元，4小时-8小时10元，8小时至24小时30元。保安没有拆开收费，诉求人进出一次道闸为一个闭环，重新进入小区会重新计时。此外，物业对进出的临时车辆，开具收费发票。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '乱收停车费', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786498-2561253', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025042, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 56, 7), '诉求地址': '闵行区浦江瑞和城陆街区1509号', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述地址公司拖欠工资。公司名字：逸鸿汇远物流有限公司，拖欠市民2023年11月的工资2500元。市民反映了三个月，但截止到2024年1月9日来电时还未收到工资。梁总信息：16518219555、诉求：请管理部门核实，将拖欠工作给市民。', '工单类别': '一般', '处理描述': '市民您好，您反映的诉求区人社局收悉并办理，办理情况是：我单位于2024年1月10日当天上午9:36与您首次电话沟通，并与您提供的梁电话联系，梁否认您系公司员工，说双方有合同约定的，已将上述情况告知您，民事合同纠纷不属人社局处置范围，建议您诉讼。感谢您的理解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '拖欠工资', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786565-725997', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025332, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 57, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市工商局电话。', '工单类别': '一般', '处理描述': '告知64220000，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786928-2561645', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025322, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 58, 13), '诉求地址': '静安区', '诉求区域': '静安区', '内容描述': '市民来电咨询:市民咨询关于交通队额个人物品行政复议的话邮寄材料地址是哪里，司法局信息查询。', '工单类别': '一般', '处理描述': '根据《上海市各区司法局邮编地址一览表》相关信息告知，市民认可。归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786880-471929', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025392, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 59, 6), '诉求地址': '杨浦区殷行路1388号', '诉求区域': '杨浦区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复。【最近派发的工单编号：20240106017045，工单内容：市民来电反映:2023年12月市民在上述地址盒马APP购买的产品与描述不一致。购买的虫草。市民要购买晒干的虫草，但是上述地址发给市民冻干的虫草。市民表示产品描述中没有写到是冻干的虫草。价格：2100多元，订单号：3701745038544872215。与对方沟通，对方表示有可能是冻干的也有可能不是冻干的。市民表示同样的产品1000多元的，产品信息说明上写了冻干。其认为上述地址存在欺诈消费。诉求：希望管理部门对上述地址欺诈消费进行查处处理。（需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240106017045，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786957-2561669', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109024952, '工号': 4302, '工单生成时间': datetime.datetime(2024, 1, 9, 15, 59, 11), '诉求地址': '闵行区虹桥高铁站', '诉求区域': '闵行区', '内容描述': '市民来电反映:2024年1月9日 15:30在虹桥高铁站出租车上车点打车，告知去江桥万达，司机拒载。因司机开的很快没看清车型，也不知道是哪家出租，车牌号：沪AD73488或沪AD74388，可能是紫色。诉求：需司机电话道歉', '工单类别': '一般', '处理描述': '核查处理结果：1月10日14:45联系市民致歉，司机三不放过教育，诚信记录，认可。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786494-725942', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025522, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 0, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其为外省市户籍在本市就读高职是否可以在本市缴纳医保。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787081-472092', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025222, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 0, 33), '诉求地址': '闵行区莘庄镇莘沥路512弄14号楼', '诉求区域': '闵行区', '内容描述': '市民来电反映:其之前向管理部门反映上述地址居民摩托车轰油门事宜，好了几天又死回复燃，摩托车轰鸣声特别吵，严重扰民，诉求：请相关部门再次与该居民协调。（市民要求信息保密 无需回复）（关联工单：20231214016217）', '工单类别': '一般', '处理描述': '莘庄镇莘松五村居委于1月9日对诉求信息进行确认。经核实，与摩托车主沟通后了解到他的摩托车经过合法改装，并未故意轰油门，只是车子启动时发出的声音，后期物业也会加强巡逻，如发现有故意轰油门的情况发生，立即制止。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '纠纷协调', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786840-2561567', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025412, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 1, 7), '诉求地址': '闵行区浦江万达广场SE理发店', '诉求区域': '闵行区', '内容描述': '市民来电补充信息。市民补充信息内容为：尽快退剩余的168元，尽快处理【最近派发的工单编号：20240109011051，工单内容：市民来电反映:其在上述地址理发店充值现在还有581元费用没有用完，现在离开上海只退413元市民不认可，卡号：无法提供。有凭证，电话：无法提供，诉求：管理部门核实协调全额退款。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240109011051，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786947-2561659', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025172, '工号': 1550, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 1, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:实习工资未给如何维权。', '工单类别': '一般', '处理描述': '转接42679', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '拖欠工资', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787166-2818275', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025302, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 1, 57), '诉求地址': '奉贤区中医院针灸科（靠近南桥路南奉公路）', '诉求区域': '奉贤区', '内容描述': '市民来电反映:市民姓名：张伟，1月9日在上述医院就诊，市民交完费后不小心将医生开的处方遗失了拿不了药，因为医院制度规定医生不能帮其补开处方单，医生给市民写单子办理退费，但收费窗口表示要拿了药后才能办理退费。市民现在既办不了退费也拿不了药，市民认为该医院的制度不合理。诉求：希望管理部门核实解决市民遗失处方无法取药的问题。', '工单类别': '一般', '处理描述': '一、调查核实情况 张伟反映的情况属实。 经核查，市民1月9日到奉贤区中医医院就诊，交完费后不小心处方遗失，没法拿药，市民不认可，希望整改。 二、处理情况 1月12日奉贤区中医医院综合办积极联系市民沟通，感谢市民的建议，加强医患沟通，积极处理问题，会同信息科进一步优化就诊取药程序，择日来院取药，希望市民理解。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医院监管', '四级分类': '医疗纠纷', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704786833-2772460', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025632, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 3, 7), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其北京医保要在上海使用，来电求助', '工单类别': '一般', '处理描述': '建议联系医保归属地，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787220-2561901', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025772, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 3, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787364-2562035', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025552, '工号': 4302, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 4, 8), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:个人消费者转拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787141-472141', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025752, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 4, 15), '诉求地址': '虹口区三门路第四人民医院', '诉求区域': '虹口区', '内容描述': '市民来电咨询办理进度【最近派发的工单编号：20231222017516，工单内容：市民来电反映:其父亲（患者姓名：单绍荣）于2023年6月份在上述医院因新冠拍了一个CT，但是结果显示炎症，可是2023年10月份其父亲体检被通知肺上有个结节，市民就拿着6月份的片子一起去给医生对比看，经过多家医院诊断都说当时6月份就有一个0.8公分左右的结节，市民对此结果表示不认可，诉求：要求医院对于此事给其一个合理说法，并且要求该医院专业的医生再重新看一下片子，到底那个位置是什么东西。（需回复）】', '工单类别': '一般', '处理描述': '已解释归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医院监管', '四级分类': '医疗纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787371-2818480', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025492, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 4, 38), '诉求地址': '青浦区盈港路1755弄', '诉求区域': '青浦区', '内容描述': '市民来电反映:其上述地址的民乐家园（二区）小区仅有的菜场，查询电话，办公室也无人，市民来电反馈始终无法联系。诉求:望管理部门告知电话或者让工作人员联系市民。', '工单类别': '一般', '处理描述': '【此工单诉求内容属实】盈浦街道城运中心于2024年1月9日接单，于当日18时55分与市民先行联系，告知其诉求已收悉，正在盈浦街道进行办理。盈浦街道民佳居委会于2024 年1月10日接单，于2024年1月10日首次通过电话先行联系诉求人，告知诉求已收悉，正在我单位办理。办理情况为：2024年1月10日由民佳居委会对诉求人反映的情况进行了核实，经居委会与菜场管理方沟通，菜场对外电话为69227581，由于电话外线损坏无法使用，需等装修完成后接通，已告知菜场主动联系该诉求者。于2024年1月12日将处置结果告知来电人，经回复，诉求人对此处理结果表示未评价。该问题已经解释说明。经办人：李思文。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '菜场经营', '主办单位': '青浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787036-472060', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025832, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 5), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接美团。', '工单类别': '一般', '处理描述': '转接美团成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787433-726747', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025662, '工号': 2972, '工单生成时间': datetime.datetime(202