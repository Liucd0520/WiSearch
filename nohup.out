类': None}, {'工单编号': 20240107012152, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 48, 25), '诉求地址': '本市豫园到虹桥火车站', '诉求区域': '本市', '内容描述': '市民来电咨询:10号线早班车时间，', '工单类别': '一般', '处理描述': '根据《轨道交通10号线 》告知，市民认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（出入境）', '三级分类': '行政管理', '四级分类': '便民服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704609913-2360110', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012072, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 49, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:浦东新区新都花园（读音），有一户人员于2024年1月7日整天装修扰民。', '工单类别': '一般', '处理描述': '市民表示先联系物业，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704609834-273241', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012002, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 51, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:特种设备检验人员的考试报名结果。', '工单类别': '一般', '处理描述': '根据《本市特种设备检验人员考核发证常见问题》，已解释，市民认可，故归档。', '客户类型': '个人', '一级分类': '安全监管类', '二级分类': '质量技术监督', '三级分类': '特种设备监察', '四级分类': '人员资质', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704610013-273323', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012212, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 53, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:和单位签订劳动合同的，现在公司以搬厂为理由，给工人放3个月假，目前假还没有放完，公司又要开始辞退了。诉求：望管理部门核实告知，其可以如何维权。', '工单类别': '一般', '处理描述': '2024-01-08 09:28:53致电，关于您咨询的问题，经了解，单位搬迁仍在同一个区域，现单位以此解除劳动合同，如何维权。告知您依据中华人民共和国主席令第80号《中华人民共和国劳动争议调解仲裁法》， 第二条 中华人民共和国境内的用人单位与劳动者发生的下列劳动争议，适用本法：（二）因订立、履行、变更、解除和终止劳动合同发生的争议；（五）因劳动报酬、工伤医疗费、经济补偿或者赔偿金等发生的争议； 第五条 发生劳动争议，当事人不愿协商、协商不成或者达成和解协议后不履行的，可以向调解组织申请调解；不愿调解、调解不成或者达成调解协议后不履行的，可以向劳动争议仲裁委员会申请仲裁，您表示了解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '用工规范', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704610062-2360170', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012192, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 57, 58), '诉求地址': '闵行区万源路399号', '诉求区域': '闵行区', '内容描述': '市民来电反映:其2024年1月3日11:08分在复旦大学附属儿科医院的互联网医院配药，收费号是240103100002000064，开的药是德巴金，300ml一瓶，处方开了4瓶，支付金额是285.64元，选择的邮寄的，收货人是钱薏朵，市民告知收货人至今没收到药，系统上也没有任何物流信息。市民表示病人快没药了。诉求：请管理部门尽快核查并寄送药品。', '工单类别': '一般', '处理描述': '因互联网配药，是医药公司直接发货，我院已督促医药公司尽快发药，如家属还未收到药品，可以至我院药房开退单并至门诊收费处退款。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '用药规范', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704610023-3095835', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012482, '工号': 4080, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 58, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多专席。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704610623-3096091', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012552, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 2, 1), '诉求地址': '杨浦区', '诉求区域': '杨浦区', '内容描述': '市民来电反映:通过抖音商城购买的衣服，退回去之后本来有运费险，但是商家不愿意承担运费，订单编号：6924868265122993607、6924885544345998791。诉求：请管理部门帮助其退还运费。', '工单类别': '一般', '处理描述': '经核实，被诉企业抖音处理给予消费者退12元+30元优惠券方案，投诉人接受，经沟通双方达成调解协议。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704610708-273621', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012562, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 2, 17), '诉求地址': '本市', '诉求区域': '本市', '内容描述': ':市民来电要求转接“拼多多”。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704610862-3096183', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012532, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 2, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民重复来电查询进度。最近派发工单号：20240107012333，工单内容：市民来电反映:顺丰快递公司（收件地上海），快递单号：SF1671567357528，该件是代收货款，已支付费用给快递公司，收到时发现物品有问题，要求拒收退回，现在快递公司不处理。诉求：要求邮政局介入让快递公司尽快退代收货款的费用。', '工单类别': '一般', '处理描述': '建议市民耐心等待回复。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704610836-528405', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012772, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 8, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电补充信息。市民补充信息内容为1月7日其又收到机器人电话回复，市民不认可【最近派发的工单编号：20231231016460，工单内容：【重新交办,要求：按答复要点告知市民,市民表示答复要点不符,管理部门从未有人工客服联系市民告知处理结果，都是系统语言电话。必须赔偿路费。并且之前联通内部人员告知，其因2017年一直投诉联通，导致其号码被加入黑名单。市民对此非常不满，表示从12月31号19:24分其，之后其每拨打10010未接通1次，需要赔付市民100元，并且每个月赔付市民50元话费。诉求：请管理部门核实，协调市民，给到合理解决方案。市民要求人工回电。最近办结的工单编号:2023121...', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231231016460，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704611168-2360650', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012632, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 9, 35), '诉求地址': '浦东新区临沂一村27号、31号', '诉求区域': '浦东新区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240105018919，工单内容：市民来电反映:小区要加装电梯，没有依法协商一致，程序完全不合法，还要强制加装外挂电梯，业主是坚决不答应，街道房管办、电梯办不管。建议管理部门对不合规、不合法，强制加装电梯等行为上门核实，确实不合规的工程，需要市级房屋管理部门来处理。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240105018919，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704610950-3096217', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012752, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 10, 25), '诉求地址': '金山区九工路', '诉求区域': '金山区', '内容描述': '【重新交办，要求：答复要点不明确，管理部门应尽快兑现当初金水湖的规划承诺，落实公办幼小中学校教育，提高住在金水湖的居民的幸福指数。诉求：建议管理部门尽快兑现规划承诺。...', '工单类别': '一般', '处理描述': '先行联系时间：2024年1月8日 8时30分 核实认定情况：1月8日8时30分与诉求人刘女士先行联系，进一步了解相关情况，经核实对市民的意见留作参考。 处置过程和结果：接到此工单后，1月8日8时30分与诉求人刘女士先行联系，进一步了解相关情况，告知了办理程序和期限。之后工作人员将诉求转至基础教育科处理。经核实，高新区2035规划尚有教育用地，区教育局将根据该区域实际，结合地理条件功能类型、人口分布和增减趋势，合理布局周边教育资源，制定切实可行的建设规划（包括公立幼儿园）。1月8日14时45分电话反馈诉求人，其表示不评价。 答复市民反馈情况：问题解决 诉求人表示不评价', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '入学入托', '四级分类': '幼托管理', '主办单位': '金山区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012712, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 10, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其通过微信购物（水果）存在烂果问题，申请补换或退款商家答应但实际无人处理，上述地址为发货地址，商家名字市民不清楚。微信号：Aimi57578，金额：198元。', '工单类别': '一般', '处理描述': '市民表示外省市微信私下交易，告知核实后处理，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704611109-3096283', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012912, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 12, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:工地施工噪音扰民', '工单类别': '一般', '处理描述': '根据《 上海市社会生活噪声污染防治办法(沪府令94号) 》解释，市民认可，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704611447-2360798', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012452, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 13, 21), '诉求地址': '黄浦区淮海中路527号7层舒适堡', '诉求区域': '黄浦区', '内容描述': '催单原因：市民来电补充信息实际健身地址静安区愚园路68号5层18室，健身地址在1月1日关门了，希望管理部门尽快处理，企业名称：上海舒适堡健身美容中心有限公司三分公司，希望管理部门协调相应部门联系处理退款。【最近派发的工单编号：20240106005882，工单内容：市民来电反映:没有私教课，当时办卡金额市民不记得了。上述地址健身房关门了。对方没有提前发短信，也没有退款说明，市民有合同。市民不知道办卡时间，到期时间2027年5月21日，客户编号：097437f80，市民表示该公司只剩下5家左右了，准备跑路了。诉求：要求退款。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240106005882，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704610575-2360391', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012872, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 14, 7), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:1月7日其乘坐蓝色联盟出租车，14点左右虹桥机场上车，14:37济阳路下车，司机上车没有打表，到了济阳路司机向市民收取200元加速费，市民拒绝，最终支付120元，但实际应该收费50元，车牌号：沪ADX1102，诉求：投诉司机位违规', '工单类别': '一般', '处理描述': '2024年1月9日致电乘客，该司机已劝退并且微信转账60元退还给乘客，非常抱歉，给您带来不愉快的乘车体验！', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704611351-2360741', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012932, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 16, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': 'c', '工单类别': '一般', '处理描述': '查询中，系统问题，告知没有信息派单，其自行挂机，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '生活保障', '四级分类': '最低生活保障', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704611517-528711', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107012922, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 17, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其在随申办上办理出生一件事，在办理到“办理居民医保受理”去缴费时提示“登入失败，选择国家和地区有误，请重新选择，请实名认证您的市民邮箱或者换一种方式登入”，市民不解此为何意，望管理部门尽快告知相关流程，其该如何下一步操作。（需回复）     ', '工单类别': '一般', '处理描述': '您通过12345反馈的问题我们已收悉，关于居民医保受理服务由税务提供服务，可能是由于网络原因，导致用户使用异常，经测试，目前功能可正常使用，建议您在网络环境较好的情况下先清除手机及市民