咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108024432, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 8, 15, 35, 11), '诉求地址': '复旦大学附属中山医院', '诉求区域': '本市', '内容描述': '市民来电反映: 市民准备带着亲属从外省市来上海的医院就医。拨打中山医院的电话主要询问按照患者的症状应该挂哪个科室。接电人员却一概说不知道，态度还很差，也没有帮其转对应科室询问，让市民感官很不好。市民投诉医院管理，所谓的咨询电话根本解答不了问题。', '工单类别': '一般', '处理描述': '感谢市民致电，您反馈的情况我院已知悉，因接听电话的工作人员属于行政人员，非专职医生，根据您的反馈，影响您亲属后续治疗，无法给出专业的意见。建议您根据您亲属的病情在当地医院进行咨询归属哪个科室后再行就诊。感谢市民对我院医疗管理工作的理解和支持！', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '服务态度', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704698812-394050', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108024802, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 8, 15, 35, 52), '诉求地址': '杨浦区', '诉求区域': '杨浦区', '内容描述': '市民来电咨询:国棉九厂退管会电话', '工单类别': '一般', '处理描述': '根据《上海市退管办及各区退管办联系方式》告 知', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动人事制度', '四级分类': '退休离休', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704699183-394366', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108024862, '工号': 2100, '工单生成时间': datetime.datetime(2024, 1, 8, 15, 39, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:薪酬管理制度要其签字，8点上班1天8个小时，要求提前15分钟到，迟到了7:45没到就扣绩效100元，咨询如果签字是否就有法律效应了。', '工单类别': '一般', '处理描述': '告知法律专席忙线，用工规范问题可以咨询人保，市民表示不需要，提供12348，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '用工规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704699208-2693792', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108024902, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 8, 15, 39, 40), '诉求地址': '奉贤区', '诉求区域': '奉贤区', '内容描述': '【为企服务】市民来电咨询:国家信息公示网站，做公司注销，但是却发现操作不了，询问怎么操作，市民表示之前为企专席让自己去该网站办理的。', '工单类别': '一般', '处理描述': '转接为企成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审