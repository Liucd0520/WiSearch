'工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 7, 11, 52, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其对电子警察抓拍不认可', '工单类别': '一般', '处理描述': '根据《 交通违法处理窗口 》', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704599399-3091382', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007202, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 7, 11, 53, 20), '诉求地址': '松江区乐祥路180弄', '诉求区域': '松江区', '内容描述': '市民来电反映:其2023年1月份向物业公司缴纳了2000多元的垃圾清场费，现其了解到有些居民缴纳的垃圾清场费已退，其找物业公司退垃圾清场费但告知不退。诉求:望管理部门核实，予以退款。（需回复）', '工单类别': '一般', '处理描述': '经永丰街道分管领导签批同意，市民诉求不属实，两种收费方式在业主领取装修证时均告知，由业主自行选择。永丰街道热线办于2024年1月8日先行联系市民，并对工单问题描述进行确认。经核实，辰吉嘉苑为动迁安置房，交付后有集中装修期。物业为了方便管理，提供了两种清运建筑垃圾的收费方式，一是按平方收取（20元/平方米），由物业进行短驳；二是业主将垃圾打包装袋后由物业上门清点并签字确认（按1平方4袋，每袋6元收取），后续再按照总袋数多退少补。两种收费方式在业主领取装修证时均告知，由业主自行选择，该市民选择按平方计算，不安排退款。2024年1月12日电话答复市民，其表示不满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704599308-1002609', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007112, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 7, 11, 53, 22), '诉求地址': '浦东新区张杨路158号汤臣商务中心C栋2218室（商住两用房）', '诉求区域': '浦东新区', '内容描述': '市民来电反映:1月7日9:00上述地址住户的住宅门被拆除后砸掉了大门的墙壁为了更换大门，物业和业委会有规定是不可以私自更改大门的，反映物业及业主未处理，市民怀疑被砸大门的墙壁是承重墙，诉求：请管理部门协调恢复住宅大门原貌。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '您好，潍坊新村街道接单后与您先行联系，您表示此户已更换好大门，不再追究了。感谢您对我们工作的理解与支持。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '房屋结构破坏', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704599109-3091261', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007342, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 7, 11, 54, 28), '诉求地址': '长宁区娄山关路533号2902-2913室上海寻梦信息技术有限公司', '诉求区域': '长宁区', '内容描述': '市民来电反映：个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功，归档。 ', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704599608-1002727', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007422, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 7, 11, 57, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704599814-1002804', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007432, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 0, 29), '诉求地址': '徐汇区武康路280弄', '诉求区域': '徐汇区', '内容描述': '市民来电反映:上述地址小区物业的保安，要市民车子挪位置，但是市民表示有其他位置可以临时停车的，市民不肯挪位置，1月7日值班的保安人员就辱骂市民，非常的难听。诉求：投诉小区保安辱骂业主，要求给予处理结果的回复。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '上海衡复物业有限公司于2024年1月8日10时16分收到区“12345”热线派发的工单，经办人于2024年1月8日10时39分致电来电人。经查，武康路280弄停车由街道委托我公司管理。来电人为27号私房业主，车辆系亲情车，非长停车辆，可错峰停车，当车位饱和时需配合挪车。接件后，小区经理经现场了解，来电人车辆当日于弄内临停，由于弄内车位已饱和，有长停车主开回，故要求其配合挪车，并无辱骂来电人户的情况，属正常履职范围。衡复物业经办人于2024年1月11日15时06分电话答复来电人，告知上述情况，来电人对上述处理情况及结果表示不满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '徐汇区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704599769-269266', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007472, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 2, 59), '诉求地址': '崇明区八一广场二楼206号 以恒母婴店', '诉求区域': '崇明区', '内容描述': '市民来电反映:其之前帮孩子办理了上述儿童乐园的卡，现市民卡内还有398元，该儿童乐园已经搬走，市民之前联系了商家要求退款，现卡已经被商家收走但至今无人联系其处理退款。诉求：希望管理部门核实并协调退款（需回复）', '工单类别': '一般', '处理描述': '经电话向投诉人了解，双方已经自行和解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704599858-1002818', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007522, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 3, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其在老家缴纳社保和医保，目前打算一直在上海缴纳，老家的补缴了，咨询是否能提取老家的社保和医保。', '工单类别': '一般', '处理描述': '建议咨询外省市当地政策，市民认可，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '外省市受理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704600016-2310328', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007842, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 6, 45), '诉求地址': '浦东新区周康二村', '诉求区域': '浦东新区', '内容描述': '市民反映：小区内大量公共绿地被用于种菜，空气里弥漫粪臭味，居委和物业不作为。诉求：请管理部门整治小区公共绿地种菜问题。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '您好！您反映的问题康桥镇周康居委已收悉。关于周康二村绿化内毁绿种菜现象已通知小区物业进行整治。感谢您的理解与支持，祝您生活愉快！', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007662, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 7, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电补充信息。市民补充信息内容为：对方告知本人办理不能退，市民要求提供本人签字的证据，对方无法提供。市民表示再拖着不处理。要求赔偿市民的损失。诉求：取消该合约。【最近派发的工单编号：20240106023539，工单内容：市民来电反映:联通旗下有一个80元套餐免费送一个手机，一共签约三年的合约机，市民现不想要该合约机，并且签的合约市民猜测是业务员擅自签名的，联通电话：13061798072，诉求：请管理部门协调取消该合约。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240106023539，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704600258-2310449', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107008052, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 9, 7), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007682, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 9, 39), '诉求地址': '奉贤区青村镇人民路东方华璟园5号301室', '诉求区域': '奉贤区', '内容描述': '市民来电反映:其是上述地址居民，1月7日12:08其发现家里没有煤气了，诉求：请管理部门核实，尽快派人维修，恢复供气。（需回复）', '工单类别': '次紧急', '处理描述': '1月8日，与投诉人取得联系。接单后，海贤能源公司工作人员与您沟通时，您表示问题已解决。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '燃气', '三级分类': '燃气报修', '四级分类': '管道维修', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704600319-3091767', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007742, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 15, 26), '诉求地址': '静安区乌鲁木齐中路12号，复旦大学附属华山医院 ', '诉求区域': '静安区', '内容描述': '市民来电反映:2024年1月7日7:30-7:40分在该处地址医院里面停车场停车，保安工号YHQ00003或者YQH00003，其表示保安态度差， 辱骂其，诉求：投诉保安服务态度差。', '工单类别': '一般', '处理描述': '来电人反映情况经医院相关工作人员核实后已电话致歉，取得谅解。事发当日车主来院停车，车库管理人员为保障安全，要求出示行驶证查看车辆重量，确保能安全停入机械车位，被告知没有行驶证，随后发生争执，认为管理人员态度差。我院对车管人员进行教育指正、加强服务培训。感谢您的来电。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '其他', '四级分类': '其他', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704600578-524377', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107006432, '工号': 3832, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 16, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704600917-524506', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107007932, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 7, 12, 16, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None,