 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多平台购买的2GU盘，内存数据改了和是假货，数据丢失要赔偿，但没有解决，拼多多不配合，没有显示营业执照，给的地址是错误的，12315无法查到地址。诉求：请管理部门协调给予赔偿。（需回复）', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704459747-150864', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035252, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 23, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接“拼多多”。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704460740-930200', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035162, '工号': 3022, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 25, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其孩子的医保设置了医保共济绑定在市民医保账户下，但是至今还没有扣费。市民姓名：李呈颖、身份证：370481197306184240，孩子姓名：吴昀蓉、身份证：310106200707110020。诉求：望管理部门核实还未扣费的原由，给予解答。（需回复）', '工单类别': '一般', '处理描述': '2024-01-08 16:37:05 联系市民，市民表示工单所述问题已无需了解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '医疗保险', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704460588-3018045', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035312, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 26, 17), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:个人消费者要求转接拼多多客服。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704461040-2236554', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035372, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 32, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:当时孩子学校里统一申请参保2024年城乡居民医保，其当时不小心选择成了不参加，询问现在如何补缴。', '工单类别': '一般', '处理描述': '根据《城乡居民医保缴费热点问答（2024年度）》答复，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '医疗保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704461307-930309', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035402, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 36, 31), '诉求地址': '浦东新区锦安东路北京老门框火锅店', '诉求区域': '浦东新区', '内容描述': '市民来电反映:从2023年12月起每逢18:00分起该处叫号喇叭声噪音扰民，1月5日21:33分还在叫号扰民，现诉求：望管理部门尽快查处制止。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '民警于1月12日至上址实地走访，经了解，上址系排队等号叫号时使用喇叭，民警已对其进行告知，不得使用喇叭叫号以免影响他人，其表示知晓。【市民未留联系方式，故无法予以反馈。】', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704461451-3018217', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035532, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 44, 5), '诉求地址': '闵行区颛桥镇', '诉求区域': '闵行区', '内容描述': '市民来电咨询:附近哪里目前有开着的急诊医院。', '工单类别': '一般', '处理描述': '根据《全市主要医疗机构咨询电话》,告知市民，市民认可，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '卫生信息', '四级分类': '医院医疗信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704461910-930393', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035412, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 44, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是本市退休职工，2024年医保退休职工打入账户里是多少钱，如何查询医保账户信息。', '工单类别': '一般', '处理描述': '根据《 本市职工医保年度的周期 》《 如何查询个人医保信息 》《 如何办理上海医保个人信息查询密码申请及密码的变更 》,《 职工基本医疗保险退休人员的帐户资金如何计入 》告知市民，市民认可，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704461505-930343', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035552, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 48, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民打医疗保险电话打不通。市民办理了共济账户，但孩子医保没有扣成功，市民余额还是那么多，是职工医保。学校要求2024年1月8日前要交成功。诉求：帮助告知原因。', '工单类别': '一般', '处理描述': '2024-01-08 09:52:54 无人接听，2024-01-09 10:50:59 联系市民，市民询问本市在校学生如何缴纳2024年度的城乡居民基本医疗保险参保费。根据沪医保中心（2023）89号文及相关规定，告知市民，符合条件的中小学校在册学生和在园（所）幼儿，由学校和托幼机构统一办理登记手续和代为收取个人缴费。属于集中申报范围，符合本市城乡居保参保条件的人员，2024年度的城乡居民基本医疗保险的参保缴费，可通过“共济缴费”方式，由家庭共济资金支付。共济缴费失败或不满足共济缴费的，由学校和托幼机构代收后按规定汇缴。市民表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704462191-3018334', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035932, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 53, 25), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704462581-930471', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035712, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 57, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是哈啰顺风车风车的乘客，要求退费，询问事发地在哪里？市民告知在河北。', '工单类别': '一般', '处理描述': '根据《关于出租车营运管理相关事项的派单规则》,已解释，市民不认可，挂机，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '外省市受理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704462259-2236745', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105035652, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 5, 21, 57, 41), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2024年1月1日，市民在拼多多购买双枪牌硅胶揉面垫，数量：2个，价格：104元多，先用后付。市民退货已拿走。诉求：帮助告知何时退款。\n', '工单类别': '一般', '处理描述': '经查，我局于2024-01-10与消费者解释沟通，已向消费者解释清楚相关情况，消费者表示知悉了解。故此单投诉办结。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三