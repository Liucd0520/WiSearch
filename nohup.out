投诉人此前反映的事项，承办部门已按规定进行处理。根据投诉人提供的设备购买凭证及经与苹果公司核实，该设备（苹果手表）原始销售地为美国，非苹果电脑贸易（上海）有限公司进行销售。不存在不作为。短信告知', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351445-2101054', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022262, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 2, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多专席。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351630-797926', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022192, '工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 2, 15), '诉求地址': '松江区', '诉求区域': '松江区', '内容描述': '【为企服务】市民来电咨询:企业经营范围变更如何办理。', '工单类别': '一般', '处理描述': '转接松江区市场监督专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704351571-2101160', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022132, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 3, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '补充信息。市民来电反映：管理部门联系市民，电话响三声就挂断了。市民接不到电话。诉求：要求联系市民起码响10下以上。【最近派发的工单编号：20240104013436，工单内容：市民来电反映:市民登录随申办，但随申办无法显示其电子身份证，市民身份证号码：310105195211190434。市民说之前反映过，但没有收到答复，之前工单具体信息不知道。诉求：希望管理部门核实妥善处理随申办不显示其电子身份证的问题。（需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240104013436，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '网站使用', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351505-797827', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021972, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 3, 45), '诉求地址': '宝山区', '诉求区域': '宝山区', '内容描述': '【重新交办，按答复要点告知市民，市民表示答复要点不明确，自己没有进入排队系统，或者管理部门告知什么地方登陆查看排队系统。最近派发的工单编号:20221206014796，工单内容:市民来电反映:市民在掌门一对一交了1万元押金，现在联系不上该企业，诉求：希望管理部门协调尽快退押金。】', '工单类别': '一般', '处理描述': '您好，关于您投诉上海掌小门教育科技有限公司一案，经调解，上海掌小门教育科技有限公司承诺按合同（登陆官网可查询）退款，但由于近期被投诉人处理退费业务量过大，被投诉人正在按照用户申请退费的日期进行排队处理,请确认已按照该公司的退款流程完成操作并耐心等待。[宝山区市场监督管理局]', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '培训市场', '四级分类': '市场监管', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351295-797650', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022222, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 4, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:车已经转到外省市，问如何拿到额度单。', '工单类别': '一般', '处理描述': '根据《 车辆转籍、异地交易后如何领取《机动车额度业务办结凭证》？ 》告知， 转接车管所成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351581-18524', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022312, '工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 7, 3), '诉求地址': '松江区南姚路联营路交界处的工地', '诉求区域': '松江区', '内容描述': '【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,。市民表示先是告知11月份发放，之后又说年底，现在都已经1月份，但工资还是没有发，诉求：管理部门核实处理给到明确核实发工资。最近办结的工单编号:20231203011534，工单内容:重新交办，要求：市民表示水电班组长已经回到上海了，之前答应11月发一部分但是并没有发，对此市民再次来电要求尽快发放工资。诉求：原诉求不变，请管理部门尽快处理。 其表示其在2023年3月到2023年6月在上述地址建筑工地做工，有签署过合同，签署的单位是林伟建筑，其表示现在该单位拖欠了其两万元的工资没有发放。诉求：请管理部门核实帮助市民讨回工资。】', '工单类别': '一般', '处理描述': '经核实，与项目部联系，表示让信访人等找班组长王磊核对工作量，让王磊做工资表给公司，承诺春节前会支付工资，已告知信访人。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '建筑工程欠薪', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351688-2837644', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022492, '工号': 2100, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 7, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351880-798135', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022552, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 10, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:一周前在随申办上帮小朋友拍照上传办理居住证，现在在网上要查询办理记录时还是要去拍照上传，来电询问有没有其之前的申办记录', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351963-798204', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022842, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 10, 52), '诉求地址': '青浦区重固镇章堰村', '诉求区域': '青浦区', '内容描述': '市民反映：重固镇章堰村新建一桥有黑广告。诉求：请村委会尽快派人处理。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '【此工单诉求内容属实】重固镇城运中心于2024年1月6号接单，于2024年1月6号首次通过电话先行联系诉求人，告知诉求已收悉，正在我单位办理。2024年1月11日由我单位对诉求人反映的情况进行了核实，确认该诉求人诉求事项，情况属实。经核实，已联系村委派遣保洁人员前往现场清理，该地址小广告现已清理完毕。已将处置结果告知来电人，诉求人对此处理结果满意。该问题已实际解决，经办人：徐陆强。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '市容市貌', '四级分类': '广告张贴', '主办单位': '青浦区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023062, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 12, 44), '诉求地址': '浦东新区中科路哥白尼路', '诉求区域': '浦东新区', '内容描述': '市民反映：上述地址有乱设摊位现象。诉求：要求取缔无证设摊。', '工单类别': '一般', '处理描述': '接到工单后，张江镇联勤联动站工作人员于1月4日16:14分赶往事发位置核实，发现情况属实。当即对摊贩进行了法律、法规的宣传和告知，当场劝离。因无证设摊可能会有反复性，工作人员将加强该处的巡查力度，落实长效管理。于1月5日14:54分先行回复诉求人，其表示满意。该工单先行与回复为同一段录音。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022322, '工号': 3542, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 13, 25), '诉求地址': '嘉定区裕民南路1747号', '诉求区域': '嘉定区', '内容描述': '市民来电反映:在美吉姆早教中心西云楼商业广场店购买了儿童早教课程（非艺术类），12月22日上午付4210元，24节课，12月31日晚上看到公告因为资金短缺暂停，现在门店关闭了，未参加过课程无处维权。有和店长的微信聊天记录和付款凭证，没有拿到合同协议，汪婷婷13321968159、19301460731，上海金颉文化传播有限公司。诉求：请管理部门解决退款问题。', '工单类别': '一般', '处理描述': '市民关于嘉定区洪德路西云楼美吉姆早教中心关门纠纷的投诉，正在协商处理中，目前还未同意退款的诉求，我局已督促尽快处理。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '培训市场', '四级分类': '市场监管', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351708-2837662', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022952, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 14, 23), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352397-798601', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022902, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 14, 39), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:身份证挂失', '工单类别': '一般', '处理描述': '根据《 居民身份证遗失或被盗后如何挂失？ 》告知市民，此单归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '身份证管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352370-798582', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022792, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 15, 48), '诉求地址': '嘉定区', '诉求区域': '嘉定区', '内容描述': '市民来电咨询:嘉定区商务委和经济委的电话。', '工单类别': '一般', '处理描述': '已根据知识库” 嘉定区经济委员会直属事业单位信息 “”   嘉定区商务委  “告知市民，市民均已认可。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '商务', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352231-798458', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022562, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 16, 54), '诉求地址': '闵行区', '诉求区域': '闵行区', '内容描述': '市民来电反映:闵行5路线路优化，拆分线路，拆分后变成15到20分钟一班，甚至更久，从北桥就变成24路，时间间隔更长，一直等不到车，很多开往银春路方向都是空车，之前也没有征求过周边居民意见，也没出过公示。市民对此表示不满，表示优化的反而不方便。诉求：希望管理部门核实，对此给予市民合理的解释和处理方案（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '接建议，经核实：为改善行车秩序，提升营运效率，保障市民出行。于2023年12月29日起，闵行5路线路优化调整走向及站点，以沪闵路为界缩线处理，沪闵路以西由闵行24路代替营运。线路的调整有多部门统筹决定，企业配合实施。线路调整提前在“今日闵行”和属地街镇都有公示，运营企业也有提前张贴告示。2024年1月11日将核实情况告知反映人，经过沟通其对回复表示知晓了。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '公交巴士', '四级分类': '线路设置', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351982-798216', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023042, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 16, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352513-2101975', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022922, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 17, 27), '诉求地址': '浦东新区川周公路3118号酒店门口', '诉求区域': '浦东新区', '内容描述': '市民来电反映:浦东新区川周公路3118号酒店门口，7-10个左右摊位，摆摊时间每天21：00-5:00，占道扰民，要求彻底取缔。（信息保密，需回复）投诉过多次来看的时候摊位就提前搬走了，其表示有人通风报信的。', '工单类别': '一般', '处理描述': '康桥镇综合行政执法队执法队员接到投诉后于01月07日21:10、23:40、02:30赶到现场未发现无证设摊情况，中队执法队员将加强该处无证设摊的巡查力度及管理力度。于01月08日9：00、11:20、14:40回复未接通。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352360-2883753', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104022802, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 17, 44), '诉求地址': '黄浦区淮海中路622弄8号楼（PAPER广告公司）', '诉求区域': '黄浦区', '内容描述': '市民来电反映:上述地址公司2023年10月底装了很大的铁门，把垃圾桶封掉，居委会也知道此事，随后报道给了城管，表示违规的让对方自行整改，诉求：把铁门拆除。', '工单类别': '一般', '处理描述': '我单位于1月4日接单，并于当日先行联系来电人。告知其问题已经收悉，正在我单位进行办理。1月7日，我单位对来电人反映的情况进行核查，情况如下：接到投诉后，我单位现场查看。经查，该公司在门前安装铁门属实，影响居民正常生活，我单位约谈当事人，责令其限期整改。1月18日，进行现场核实，铁门已拆除，该问题实际解决，已将处置结果告知来电人，来电人表示认可。经办人：王平', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352277-798502', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023242, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 20, 39), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352728-798891', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023222, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 21, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其前往十院咨询治疗使用的药品，被告知让其联系医保局，市民要求医保局帮助查询', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352716-798881', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023512, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 21, 42), '诉求地址': '松江区中山东路163号鲜果蔬', '诉求区域': '松江区', '内容描述': '市民反映：每天早上经过上述地址，店家一直把卖的东西摆到商铺门口外面，前来买东西的人一多经常将人行道大部分都堵住，而且有些蔬菜叶子什么的都乱扔在人行道上。诉求：要求整治跨门经营。', '工单类别': '一般', '处理描述': '经中山街道分管领导签批同意，市民诉求属实。中山街道茸和公司于2024年1月4日先行联系市民，并对工单问题描述进行确认。经核实，市民所述商铺是存在跨门经营现象，经综合管理队员上门告知，商户已将乱摆放的商品搬回了商铺内，后续综合管理队员将针对该现象加大巡查力度。1月8日答复市民，市民未评价。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '跨门经营', '主办单位': '松江区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023232, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 22, 41), '诉求地址': '金山区松金公路德贤路 1663路（往秦望路长浜村）', '诉求区域': '金山区', '内容描述': '市民来电反映重复事项【最近办结的工单编号：20240102020261，工单内容：市民来电反映:1月2日9:00其在松金公路德贤路等公交1663路，其已经等了半个多小时了，结果公交车却到站不停，直接开走了，本来该路公交车间隔时间就要1小时，其也已经等了很长时间了。诉求：投诉该公交。（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '已经解释，工单编号：20240102020261，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '公交巴士', '四级分类': '服务规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352723-798888', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023732, '工号': 1400, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 23, 44), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704351872-18769', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023252, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 24, 1), '诉求地址': '浦东新区航头镇果园村倪桥607号航都南路上面', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址的航都南路上面有一辆僵尸车（不在停车位里面）一直停在那边，交警只贴单子不处理。诉求：请管理部门核实处理僵尸车。', '工单类别': '一般', '处理描述': '上海市公安局浦东分局航头派出所民警于2024年1月5日15时06分与来电市民取得联系，具体答复内容：根据市民反映的情况，经查，我所民警至上述地址开展工作。经现场查看，发现该处道路停有一牌号为“湘J77G11”的车辆，我所民警随即在车辆上张贴“航头镇“僵尸车”清理行动告知书”，至今车辆没挪走。现我所民警已通知镇城运部门开展拖车工作。下一步，我所将在日常巡逻中加强关注，确保道路畅通有序。以上内容我所民警于2024年1月17日11时27分回复市民，其表示满意。【果园村委】', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '僵尸车', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704352996-2884341', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023582, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 25, 59), '诉求地址': '青浦区金泽镇西岑社区西虹街282号10号103室', '诉求区域': '青浦区', '内容描述': '市民来电补充信息。隔壁好几家都已经通电了，但是其家里面还没有通电，请管理部门尽快解决通电问题。【最近派发的工单编号：20231221007846，工单内容：【重新交办，前件办结报告与事实不符，要求，已告知市民答复要点，市民表示和供销社有租赁合同的，现在天气非常冷，家中有老人孩子，希望管理部门核实诉求不变。（需回复）最近办结的工单编号:工单内容:市民来电反映:上述地址目前在协议动迁，但做强制措施，将市民家里断电，断