成时间': datetime.datetime(2024, 1, 4, 10, 10, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民接到拼多多客服电话，按退货退款处理，市民不认可，原因是买的文具盒，在使用中突然损坏，导致其孩子手部受伤后，处理了损坏的文具盒。市民向拼多多客服解释不能退货原因，被拼多多客服拒绝。诉求：请管理部门核实后退回购买文具盒的费用，并给市民电话回复具体处理结果，市民不愿和拼多多客服联系。【最近派发的工单编号：20231229009406，工单内容：市民来电反映:其通过拼多多购买了儿童文具，价格：18.5元，订单号：231215-029706187613370，产品有质量问题，联系拼多多要求仅退款都被驳回，目前距离最终付款时间只有3小时左右，拼多多平台也未进行过回电，...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231229009406，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704333007-2822729', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007312, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 10, 48), '诉求地址': '闵行区南江洲路城方活力社区2号楼204', '诉求区域': '闵行区', '内容描述': '市民反映：9月份报名购买40课时现还剩30课时（详见附件），机构突然关门。诉求：请督促退款。', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，涉及健身培训和体育培训的，根据市培训市场综合治理工作联席会议办公室相关文件及市体育局关于做好体育培训市场治理工作的通知精神，明确对该事项投诉调解的法定职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104006932, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 12, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民需要开通本市社保卡.', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334144-2823807', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007012, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 12, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多，是个人消费者。', '工单类别': '一般', '处理描述': '转接拼多多绿色渠道服务热线成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334226-739024', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007332, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 12, 45), '诉求地址': '嘉定区马陆镇戬浜村戬东村民组', '诉求区域': '嘉定区', '内容描述': '市民反映：1月3日晚上回去发现村民组桥边的侧门进不去，市民称平常都是有刷脸进出的，但1月3日晚上该处屏幕是黑的，导致无法进入，需要绕远路走大门。诉求：希望尽快维修。', '工单类别': '一般', '处理描述': '嘉定区马陆镇：2024年1月4日13:07:29先行联系，未接，已短信联系。经核实：已告知诉求人：戬浜村委已联系门禁系统的工作人员前来维修，目前已修复，联系诉求人表示已修好，目前使用无问题。联系时间1.9上午9点', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '嘉定区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007132, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 13, 9), '诉求地址': '静安区新闸路888弄', '诉求区域': '静安区', '内容描述': '市民来电反映:上述地址为原拆原回小区，因为把围墙拆除之后没有新建围墙，导致武定路63弄19号、20号直接在小区里面，武定路63弄19号、20号私自挂了门牌武定路63弄56号、58号；而且56号是办公用房，但是56号3楼、4楼出租给房客居住，违法改变房屋使用性质；而且56号、58号的居民把垃圾扔在市民小区垃圾房、机动车停在市民小区。诉求：请管理部门尽快加强管理防止非小区居民把垃圾扔在市民小区垃圾房、机动车停在市民小区。', '工单类别': '一般', '处理描述': '【石门二路街道】石二街道城运中心于2024年1月4日10点40分先行联系投诉人。经现场了解，武定路63弄19号20号性质属于商务楼宇，由亚正物业管理。该楼因历史原因目前处于新福康里小区围墙范围内，新福康里居民区则由沙田物业管理。街道曾多次协调，该楼内商户不愿变更物业公司，改由沙田物业统一管理。经核实，该楼内租户保洁自行解决的，租户共有三辆机动车在小区停放，均已支付过停车费，产生的建筑垃圾也向沙田物业缴纳清运费，单位生活垃圾因数量较少原本投放在居民区压缩箱房。为了给居民区垃圾减量，故城运中心和沙田物业沟通后，接下来将对该幢楼宇的单位生活垃圾进行上门收集，下一步将对其产生的单位生活垃圾处理费...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704333250-2565235', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007182, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 16, 3), '诉求地址': '长宁区', '诉求区域': '长宁区', '内容描述': '【为企服务】市民来电反映: 市民的企业营业执照遗失无法网上申请补办，市民咨询如何解决.', '工单类别': '一般', '处理描述': '转接长宁区市场监管局专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704334344-2566325', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007022, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 16, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其通过携程购买了往返机票，临行前一天被告知返程航班取消，于是联系携程退票。返程退了全款，但去程只退了80%，市民不认可。订单号：9624061579。诉求：希望管理部门帮助退全款。', '工单类别': '一般', '处理描述': '经联系，投诉人确认已解决。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '旅游', '三级分类': '服务质量', '四级分类': '旅行社服务', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334270-5091', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007272, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 17, 57), '诉求地址': '静安区柳营路盛源广场3楼', '诉求区域': '静安区', '内容描述': '市民来电反复催单。...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240102011240，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '培训市场', '四级分类': '市场监管', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334437-739251', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104006982, '工号': 4330, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 18, 35), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民为其小孩办了的家庭医疗共济，但去医院看病时，医院回复家庭医疗共济办理未成功，不能使用，经市民同意，转接医疗专席。', '工单类别': '一般', '处理描述': '转接医疗专席成功,归档', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334316-739116', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007572, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 19, 44), '诉求地址': '浦东新区三林路1456号', '诉求区域': '浦东新区', '内容描述': '市民补充信息：相关部门回复“未超出白线“不允许在街面收发快递”，市民表示与实际不符。相关回复也显示“每天有五个时段配送到此”，加上夜间配送及搬运时间，实际上是全天24小时，大多数时间段，该处都有大量快递货品堆放。【最近派发的工单编号：20231229004536，工单内容：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）三林路1456号、1454号占道经营。具体见附件照片。拍摄日期：2023年12月29日早8:00。 (市民要求信息保密，无需回复)诉求：希望管理部门核实转送相关照片至承办部门。】', '工单类别': '一般', '处理描述': '我处会将您补充的信息及时转送，请您耐心等待，专此简复', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '跨门经营', '主办单位': None, '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007472, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 20, 35), '诉求地址': '崇明区', '诉求区域': '崇明区', '内容描述': '市民来电咨询:居家养老怎么办', '工单类别': '一般', '处理描述': '根据《崇明区居家养老服务机构信息一览表》告知市民，市民认可，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '社区家政', '四级分类': '家政服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334610-739429', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007282, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 20, 47), '诉求地址': '上汽大众', '诉求区域': '本市', '内容描述': '市民来电反映:其2023年11月20日通过上汽大众的商城购买了一个商品，当时购买200元可以使用一张减20的优惠券，因为购买后平台一直没有发货，与上汽客服反映，客服表示可以补一份香氛给市民，但是20元的优惠券在订单取消后一直没有退给市民，与客服再次反映，客服让市民提供没有收到券的截图，还质疑市民在诈骗平台，市民要求上汽大众给予市民证明有退劵，并且如果没有退给市民就是平台的问题，为此市民另外提出补偿3张20元的劵，当时客服认可市民的要求，而上汽大众最终只在12月20日给市民退了一张20元的券，为此市民来电反映，上汽大众客服4008201111。诉求：希望有关部门协调让上汽大众给予补发2张2...', '工单类别': '一般', '处理描述': '经了解，商家表示已补发优惠券。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334445-739260', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104006912, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 21, 8), '诉求地址': '青浦区华新镇华志路559弄2号210室，3号153室上海联合国际小商品城有限公司', '诉求区域': '青浦区', '内容描述': '市民来电反映:市民是房东，通过上述地址公司出租商铺，公司老板电话13122669222，现在一直未收到租金，金额7-8万左右，市民联系租客对方表示已经将租金交给上述公司，但是联系公司一直未将租金交给自己，诉求：希望管理部门督促尽快将租金还给市民', '工单类别': '一般', '处理描述': '建议按照合同约定履行和维权。对于中介存在违规的，建议向执法部门举证。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '租赁管理', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334111-2566093', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007122, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 21, 17), '诉求地址': '长宁区天山路市场监督管理所  ', '诉求区域': '长宁区', '内容描述': '【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,其反映后管理联系其，并称反映主体不对。当时对方表示无需市民重复反映，他们能处理，但之后一直未给予答复。市民表示目前相关号码至今依然无法接通。市民诉求：请管理部门核实后对相关事项给予明确解释。最近办结的工单编号:20231205023352，工单内容:市民来电反映:其在12315平台上反映在拼多多购买了假冒伪劣商品后，管理部门办事效率很高，拼多多沟通后返其50元券，全额退款，其没有接受，其认为假货坑骗消费者所以没有同意。后12315工作人员建议其去经营地投诉，其认为拼多多平台也有责任，故11月6日再次12315投诉。天山路市场监...', '工单类别': '一般', '处理描述': '我局天山所于2024年1月5日接单，于1月5日13时42分先行联系诉求人并答复。经核实，根据《市场监督管理投诉举报处理暂行办法》依法处理相关投诉，针对相关投诉内容（购买的海洋之风牙膏是假货，要求假一赔十），因诉求人诉求过高拼多多平台无法满足（平台支持补偿50元，其他诉求无法满足），故终止调解。针对相关举报内容（购买的海洋之风牙膏是假货，要求查处），已作为案件线索移送至商家所在地县级以上市场监管部门调查处理。号码52728103可以正常接听，如遇无法拨通等情况，建议稍后再试或者尝试拨打号码52896372。经办人：天山所。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '诉求未解决', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334283-2823950', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007602, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 21, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:驾驶证被吊销预约了科目四考试，期间身份证换了，是否要办理变更手续', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '驾驶员审验', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334666-739492', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007202, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 23, 6), '诉求地址': '杨浦区莱克大厦2楼', '诉求区域': '杨浦区', '内容描述': '市民来电反映:2020年1月市民在上述地址上海儒群教育投资有限公司报名就读中国医科大学护理学，支付12000元，原定2023年1月毕业，因机构收取其学费后，未交给学校，导致市民无法毕业，机构负责人电话13901952389，诉求：希望管理部门核实，要求机构尽快交学费并协调办理毕业手续（需回复）。', '工单类别': '一般', '处理描述': '经了解投诉人在江苏省宿迁当地报名办理相关手续，投诉人并不能提供收费及合同相关证据，请自行与当地报名点沟通解决。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '培训市场', '四级分类': '市场监管', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334354-739158', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007642, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 23, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:消费者转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334767-2824471', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008082, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 28, 2), '诉求地址': '闵行区繁兴路', '诉求区域': '闵行区', '内容描述': '市民来电反映:闵行区繁兴路土方车很多，扬尘严重，希望管理部门每天可以洒水，解决扬尘问题', '工单类别': '一般', '处理描述': '华漕镇华漕环卫公司于2024年1月5日接单，于1月5日10：55时与诉求人先行联系，对诉求信息进行了确认。于1月5日11时公司道路保洁组核实，办理情况是：由于繁兴路朱建路联友路等道路上有许多土方车出行，装载不规范导致滴落大量土方，道路保洁员发现后会及时处理，且会及时洒水降尘。但因冬季气温有时偏低，根据洒水要求4度以下禁止洒水，防止出现安全隐患，故公司机洒组根据天气情况进行洒水降尘。现阶段早上温度达到4度以上后，都进行了正常洒水作业。（除个别一早低于4度后，等太阳出来气温回升就洒水作业。）该问题已实际解决，', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '道路扬尘', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334881-739714', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007712, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 28, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:在拼多多购买桌子，破损，退货运费很贵，让市民垫付运费，但市民之前遇到过，最后不赔付运费，诉求：希望管理部门由商家或者平台垫付运费。（需回复）', '工单类别': '一般', '处理描述': '经拼多多平台协调，已为投诉人处理，投诉人已接受，双方协商达成一致。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334997-5856', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104005822, '工号': 4290, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 30, 16), '诉求地址': '浦东新区高行镇双桥路937号（鱼乐贝贝春江花悦园店）', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民孩子上述地址游泳中心（门面房，原老板姓名王静，手机号13564952890，18501620325）游泳有一年多，2023年10月市民突然发现换老板了，此前没有征兆或者通知，在群里看到有家长拍摄的照片门口贴有公告（公告显示转让给手机号19121941505，后市民联系此号码，接电人曾自称专业闭店非后续老板，后不再接电，加了微信也未回复）。市民表示知晓此事后查询鱼乐贝贝APP中显示未使用套餐：34次，目前在鱼乐贝贝小程序：13次，剩余套餐数量被恶意减少，有部分课程性质变成了赠送课程。市民曾在2023年6月3日微信转账账户名鱼乐贝贝3288元，2022年7月31日个人支付宝...', '工单类别': '一般', '处理描述': '对于婴幼儿游泳不属于体育领域范畴，根据国务院办公厅《关于促进3岁以下婴幼儿照护服务发展的指导意见》（国办发【2019】15号）以及附件《促进3岁以下婴幼儿照护服务发展工作部门职责分工》的规定，均无体育部门的职责分工，故婴幼儿游泳工单不属于文化执法的受理范围。建议市民：依据《消保法》相关规定，寻求消费者保护协会12315的帮助。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704333108-2565100', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007702, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 30, 44), '诉求地址': '闵行区人民法院', '诉求区域': '闵行区', '内容描述': '市民来电咨询:在网上法院立案问题，拨打12368无人接听', '工单类别': '一般', '处理描述': '根据《闵行区人民法院》告知，建议市民在尝试拨打，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '法院系统', '三级分类': '法院受理', '四级分类': '诉讼立案', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335182-6033', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007172, '工号': 3022, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 30, 46), '诉求地址': '徐汇区喜泰路247弄', '诉求区域': '徐汇区', '内容描述': '市民来电咨询:其小区正在准备动迁，动迁组也和居民们进行约谈，其中有涉及到基数问题，动迁组告知按照1.65来计算。市民表示之前外未动迁前小区也有很多居民去申请经适房，当时是按照1.94的基数来计算的，故很多居民无法满足条件享受经适房。为何现在动迁却按照1.65来计算。诉求：望管理部门核实给予解答该基数标准的由来。（需回复）', '工单类别': '一般', '处理描述': '2024年1月4日10:56区住宅与征收中心先行联系市民。经与市民联系了解情况，其为喜泰路247弄5号310室居民，经查，该处为上中路龙吴路新建绿地项目房屋征收补偿范围内，之前申请经适房的认定标准和现在房屋征收补偿认定的政策是不一样的，之前申请经适房的房屋类型和系数的政策不适用于目前房屋征收补偿，该处房屋建筑面积认定相关标准以区房屋征收部门两清公示为准。2024年1月4日10：58，经办人答复市民，告知了上述情况，市民表示知晓。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '征收管理', '四级分类': '动迁政策', '主办单位': '徐汇区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334942-739774', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104007892, '工号': 4330, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 30, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:收到市场监管局发来的短信，想要咨询法律问题，经同意，转接法律专席。', '工单类别': '一般', '处理描述': '转接法律专席成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '法律援助', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704334972-739802', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008332, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 32, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:上海社保卡，挂失就医功能。', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335360-2567349', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008162, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 33, 25), '诉求地址': '普陀区桃浦路300弄', '诉求区域': '普陀区', '内容描述': '市民来电补充信息。市民补充信息内容为改整改的没有整改，管理部门还泄露市民的个人信息，导致二房东联系市民。诉求：请管理部门针对办事效率差、泄露市民的个人信息给出合理的解释并电话回复市民处理结果。（需要管理部门的电话回复而不是二房东的）【最近派发的工单编号：20231225028413，工单内容：【投诉】市民来电反映:市民反映群租问题， 迟迟没有得到处理，故而投诉管理部门办事效率差。相关工单：20231214023721。（市民要求信息保密，需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231225028413，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '办事效率', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335221-2824901', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008352, '工号': 4330, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 34, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民为个人消费者，经同意，转接拼多多专席。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335389-2825071', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008662, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 36, 42), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多客服', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335685-2825371', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008762, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 37, 18), '诉求地址': '浦东新区南泉路1241弄2号603', '诉求区域': '浦东新区', '内容描述': '市民反映：其是塘桥幼儿园学籍管理老师，为众城商厦学区一事咨询对口中远物业，此女中年经理态度极差，拒不接受任何请教询问，一问三不知。学籍排摸一事无法跟进，置小区里的幼儿2024年入学事宜于不顾。没有责任，态度恶劣。诉求：投诉中远物业女经理态度极差。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '市民您好，您所反映的事项塘桥街道房办表示，联系中远物业，物业表示经了解诉求人反映的的电话为维修电话，当时1月4日上午小区出现漏水情况，所以岗亭物业人员都出去了。物业表示后续查到接电人员会给予批评教育。物业表示目前小区经理已联系诉求人，告知其所知情况。给市民带来误解，还请谅解。目前未发现中远物业经理态度差的情况。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008422, '工号': 1342, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 37, 20), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【长三角】市民来电反映:通过拼多多购物，使用先购物后付款，订单号：231226-025648250410561，是羽绒上衣，价格299元，订单号：231229-602239148970561，是鞋子，价格79.9，申请了退货，但发现分别从其账户扣了5元，平台称是满减活动，市民不认可表示是原件购买并没有参加活动，诉求：退还10元。', '工单类别': '一般', '处理描述': '经拼多多平台协调，已为投诉人处理，投诉人已接受，双方协商达成一致。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335495-6341', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008592, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 37, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电对办理结果不满，移动给其致电，仍然用原回复回复，处理敷衍，没有告知理由，要求核查处理解决。（需回复）【最近派发的工单编号:20240103025911，工单内容:市民来电反映:移动设备号：18616309108，1月2日突然收到移动短信，称其的号码近期存在通讯异常，存在被不法份子盗用的可能，根据反电信网络诈骗法进行停机，需要二次实名认证，市民按要求重新实名认证后，现已经恢复，但联系移动客服，要求告知被停机的具体原因，客服只将短信内容复述了一遍，市民不满，诉求：请核实，要求移动明确告知手机号被停机的原因。】', '工单类别': '一般', '处理描述': '市民对办理结果不满，已电子催单工单编号：20240103025911，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335592-6435', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008302, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 38, 4), '诉求地址': '青浦区徐泾镇泾茉路129弄远洋万和源1号802', '诉求区域': '青浦区', '内容描述': '\n【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,相关事项开发商尚未完成整改，但目前已完成竣工验收，并通知在1月6日交房。市民表示网上能查到相关竣工验收的信息。市民诉求：要求管理部门介入处理，对此事进行整治。最近办结的工单编号:20231214016271，工单内容:市民来电反映:其购买了上述地址房屋，开发商组织在11月28日-12月2日预看房，并提供了封房验收报告，现其到场看房发现房屋内电没有通，电线全都是接错的，空调也未接线无法验收，有向开发商反映过，但一直未得到解决，现市民要求本次预看房不通过。诉求:望管理部门核实，予以处理解决该问题。（需回复）】', '工单类别': '一般', '处理描述': '归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '工程质量', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335345-740158', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008442, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 38, 5), '诉求地址': '浦东新区张杨路3611弄天真蓝照相馆', '诉求区域': '浦东新区', '内容描述': '市民来电反映:1月4日10:05在上述地址照相馆下单预约拍照，金额999元。市民发现预约错时间，取消订单。结果退费时只退了85%。合同上显示1月4日下午13:00前退费都可全额退费。诉求：请管理部门核实，协调处理退费。', '工单类别': '一般', '处理描述': '经双方同意通过浦东新区消调委进行人民调解，根据《市场监督管理投诉举报处理暂行办法》第十五条第（二）项之规定，我局不予受理。正在调解中，请等待调解结果。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335494-6340', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008802, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 41, 18), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:企业登记注册怎么进行待签名操作。', '工单类别': '一般', '处理描述': '电联市民，市民咨询电子签名相关问题，已告知市民具体操作路径，市民表示已知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335984-2825698', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009102, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 44, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 港澳通行中心是否可以不到现场办理', '工单类别': '一般', '处理描述': '转接成功,归档 出入境', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（出入境）', '三级分类': '签证签注', '四级分类': '签证签注', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336110-6946', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104008782, '工号': 3542, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 44, 32), '诉求地址': '闵行区', '诉求区域': '闵行区', '内容描述': '市民来电反映:在疫情以前家附近的龙茗路薇妮护肤造型办了卡，卡号880178，后续门店关闭后转到了龙茗路1314号门店，目前剩余2000多元，近期发现门店关闭了，卡上描述的宝城路296号不知道是否还在营业。诉求：解决退款问题。', '工单类别': '一般', '处理描述': '经组织双方现场调解，美容部分商家现场已退款。美发部分去缪斯护肤造型继续使用剪发由店长亲自剪每次64元，双方达成一致。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704335762-2567762', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009292, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 46, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336284-786638', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009692, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 47, 14), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '更正：女士要求转接拼多多，同\t20240104009618', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336396-7213', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009462, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 48, 14), '诉求地址': '松江区泰晤士小镇三新北路900弄942号、953号、666号', '诉求区域': '松江区', '内容描述': '市民反映：上述地址942号的晓茶晓世，店内无明显禁烟标志，有烟具（详见附件），经营者在店内吸烟。清茶馆茶楼，三新北路900弄953号，对包房内吸烟的顾客不进行劝阻。集贤堂，三新北路900弄666号，杂物缸内看见有烟蒂，包房内经常有人吸烟。诉求：希望管理部门加强监督检查。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '经查，现场未发现有人在三家被举报单位抽烟，未发现烟具，被举报单位店内张贴有禁烟标志，并现场指定专人劝阻客人吸烟，已履行劝烟责任，故不予立案查处。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '禁烟控烟', '四级分类': '禁烟控烟', '主办单位': '市市场监管局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009252, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 48, 41), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电反映: 公司在银行开户的时候显示营业执照正在办理作废。 公司名称：上海共晞信息科技有限公司。注册地址：浦东临港。市民表示企业没有办理营业执照作废。诉求：请管理部门核实告知。', '工单类别': '一般', '处理描述': '多次电话联系市民，市民一直未接电话，经查国家企业信用信息公示系统其企业显示营业执照正在作废声明，现已做报错处理，烦请市民耐心等待。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704336226-2568242', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009722, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 51, 24), '诉求地址': '浦东新区规划和自然资源局', '诉求区域': '浦东新区', '内容描述': '市民建议：新场生活垃圾中转站项目规划依据《上海市浦东新区新场镇16号线核心单元PDS2-0101控制性详细规划》(规1)《上海市浦东新区新场镇郊野单元(村庄)规划(2017-2035年)》(规2)，项目所在地块为环境卫生设施用地。在规1中属于16号线核心单元区域。而在规2中上述地块为东部乡村单元，这两个规划单元划分信息不统一。且《浦东新区新场镇总体规划暨土地利用总体规划(2017-2035)》(规3)中上述地块是东部乡村单元，但第五章东部乡村单元规划中并未明确有垃圾压缩站的规划。根据规3中第五章轨道核心区中包含一座小型垃圾压缩站的规划，如两者不是同一个是否有重复规划的嫌疑。根据《中国人民...', '工单类别': '一般', '处理描述': '经核实新场垃圾分流转运中心新建工程被列入浦东新区重大工程目录，依据《上海市浦东新区新场镇16号线核心单元PDS2-0101控制性详细规划》，《上海市浦东新区新场镇郊野单元村庄规划2017-2035年》，已取得立项批复、工可批复、规划设计方案批复、初步设计批复和农转用批复等文书，2023年9月13日取得环评批复。有致电市民，市民表示理解', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '卫生配套设施', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009372, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 51, 55), '诉求地址': '本市上海电信', '诉求区域': '本市', '内容描述': '市民来电反映:上海电信在市民不知情的情况下私自给市民的上海电信号码13918216969绑定FGTR业务收取高额费用。诉求：请管理部门尽快帮助取消FGTR业务。  ', '工单类别': '一般', '处理描述': '通过', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '其他', '四级分类': '其他', '主办单位': '中国电信上海分公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336414-7226', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009032, '工号': 2100, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 52, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【重新交办，按答复要点告知，市民表示答复要点不明确，市民表示没有针对问题做详细解答，系统里面并没有变更过来。诉求：请管理部门核实，针对问题做具体解答。最近办结的工单编号：20231212004864，工单内容：重新交办,要求：按答复要点告知市民,市民表示确实有未接电话，但是无法回拨。诉求：要求管理部门再次电话联系。（需回复）工单内容:重新交办，要求：答复要点与实际情况不符，市民收到管理部门致电且也未找到该公司商标,管理部门表示需要核实处理, 诉求:...', '工单类别': '一般', '处理描述': '已通过电话告知市民如何处理。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '商标包装管理', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336039-2568057', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009512, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 53, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民的车子于2023年11月18日晚上22:30被交警在没有短信通知的情况下开具违停发单，市民要求撤诉. ', '工单类别': '一般', '处理描述': '根据《对交通违法处罚决定或强制措施有异议怎么提出行政复议或者行政诉讼？ 》告知市民，市民认可，归档.', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336469-7276', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009092, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 53, 52), '诉求地址': '浦东新区五莲路1769弄17号', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址旁的双桥路商铺御医门养生馆将6个空调外机装在了市民17号楼地下室。市民不清楚商铺门牌号。通过居委反映，联系城管后，城管一直没有处理。由于将多个空调外机放一起装在地下室存在严重消防隐患。希望管理部门尽快解决这一消防隐患。诉求：请管理部门核实，尽快处理。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '证大三、四期由上海锐翔上房物业管理有限公司提供物业管理服务。对于来电反映的情况，城建中心联系了物业公司，对方表示已联合城管部门上门和涉事业主进行了沟通，对方表示会配合整改，不存在城管部门一直没有处理的情况。现物业公司回复已整改。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '消防管理', '四级分类': '消防隐患', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336092-786451', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009412, '工号': 4322, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 55, 33), '诉求地址': '金山区金山卫镇钱鑫301号167-U室内', '诉求区域': '金山区', '内容描述': '市民来电反映:杉树地址上海贡享企业管理有限公司注册财务负责人，用市民信息注册财务负责人，341126199004196741 王朝洋，诉求：要求管理部门核实处理尽快变更信息', '工单类别': '一般', '处理描述': '王朝洋（341126199004196741）曾在代理记账公司上班，其在上海贡享企业管理有限公司设立时已经担任该公司财务负责人，登记系统记录的身份证号码、电话号码等个人信息均是王朝洋所有，并非冒用。我局建议王朝阳联系其曾任职公司或者上海贡享企业管理有限公司法定代表人罗政18601780183协调解决。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336419-786763', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009892, '工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 56, 20), '诉求地址': '闵行区富都路55弄21号202室', '诉求区域': '闵行区', '内容描述': '市民来电咨询处理进度。【最近办结工单编号：20231223014873，工单内容：市民来电反映:其是上述地址的业主，小区里的绿化遮挡了其家里的采光。诉求：请管理部门尽快修建绿化。】', '工单类别': '一般', '处理描述': '已告知管理部门正在处理中，建议市民耐心等待，市民认可故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '绿化维护', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336384-7198', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010182, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 56, 29), '诉求地址': '松江区龙马路433弄', '诉求区域': '松江区', '内容描述': '市民反映：因为地产建造的原因，造成合景天悦二期地库灰尘严重，地坪破烂不堪，起砂。已经交房两年，状况越来越差。\n物业也疏于管理，地库长年灰尘不断。诉求：管理部门介入，限时敦促开发商对二期地库地坪进行认真彻底的修复，于年前完成。', '工单类别': '一般', '处理描述': '1、地坪起砂问题，开发商计划1.22前进场维修；2、物业管理问题，请向房管部门反映。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '工程质量', '主办单位': '市住房城乡建设管理委', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009922, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 56, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多客服', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336887-7664', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009982, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 57, 38), '诉求地址': '闵行区宝秀路668号', '诉求区域': '闵行区', '内容描述': '市民反复催单，望管理部门尽快处理。【最近派发的工单编号：20240103026663，工单内容：重新交办，要求：已按办结回复告知市民，市民称管理部门没有回复，要求电话回复。工单内容：重新交办，要求：市民表示不要让古师傅维修，诉求：请安排其他师傅维修。内容：要求：答复要点与实际情况不符，市民表示要求高1.9米的师傅上门维修。诉求：希望管理部门核实更换维修师傅。工单内容：市民来电反映:其是电信宽带，2023年10月17日报修故障，但是一直维修的师傅不来，诉求：要求电信另外安排师傅给其维修。（需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240103026663，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '故障报修', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336669-2826343', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009832, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 57, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 社保卡开通。', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336789-2568773', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104009332, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 4, 10, 57, 57), '诉求地址': '静安区石门二路派出所', '诉求区域': '静安区', '内容描述': '市民来电反映:市民落户地派出所是静安区石门二路派出所，老人投靠落户，查询不到市民落户档案。身份证号码：310106197506012825，诉求：希望管理部门核实帮助查询。（需回复）', '工单类别': '一般', '处理描述': '上海市公安局静安分局石门二路派出所于2024年1月4日14时25分与市民邓女士先行联系，并进行答复。市民表示其母亲因表格资料填错无法办理，现已重新填写表格，并且已办理完成，市民对答复表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '户籍政策咨询', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336334-2826030', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010062, '工号': 3940, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 0, 16), '诉求地址': '闵行区沧源路蘑可可婴童亲子水育馆', '诉求区域': '闵行区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231224008762，工单内容：市民来电反映:市民在上述地址给孩子报了一对一游泳课，商家名称是蘑可可婴童亲子水育馆。（市民无法提供更具体地址，表示该路就一家这个店。）市民表示共向该店充值过两次，8月20日向卡中充了4800元，之前还有大概200元剩余，卡号为05263509。12月1日该店发布歇业声明，有协议签署表示可以全款。诉求：请管理部门核实并督促商家给市民将该卡剩余金额全部退还。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231224008762，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336994-2568986', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010472, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 1, 10), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704337233-2826868', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010482, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 1, 44), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704337269-8028', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010112, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 2, 8), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民随申办右上角专属里教育和工作信息里只有工会信息，姓名：杨书琪，身份证：370982199708194364，诉求：咨询如何才能查询教育和工作信息', '工单类别': '一般', '处理描述': '市民您好，您反馈的在随申办-专属中查询不到教育和工作信息的问题，我们已收悉。1月23日经排查系统，确实未查询到您的招退工和高管的信息，该问题需您联系上海市教育委员会和上海市人力资源和社会保障局处理。谢谢！<br>', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '网站使用', '主办单位': '上海市大数据中心', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704337078-2569070', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010432, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 2, 30), '诉求地址': '松江区龙马路433弄', '诉求区域': '松江区', '内容描述': '市民反映：因为地产建造的原因，造成合景天悦二期地库灰尘严重，地坪破烂不堪，起砂，钢筋裸露。已经交房两年，状况越来越差。物业早已经将方案交给地产，地产因为费用问题不肯维修，物业一直在催，现在仍然没有结果。诉求：希望管理部门敦促开发商年前完成对二期地库地坪彻底修复。', '工单类别': '一般', '处理描述': '地坪起砂问题，开发商计划1.22前进场维修。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '工程质量', '主办单位': '市住房城乡建设管理委', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010022, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 4, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其公司：上海超梯智能科技有限公司，有两个员工：吴杰，身份证：310107198508092137，沈超，身份证：31022719881013401X，社保管理系统有参保信息，但是缴费信息里没有费用产生，显示人员不匹配。诉求：希望税务部门核实，对此给予市民合理的解释和处理方案', '工单类别': '一般', '处理描述': '经核实，该企业新办理两名员工社保登记，已联系来电人沟通指导申报操作及流程，企业已完成缴费。上述事项已于2024年1月5日10时45分告知。以上答复仅供参考，具体以法律法规及相关规定为准。——嘉定区税务第十六税务所 1月9日16:40分回访满意。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336967-2568959', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010362, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 5, 15), '诉求地址': '青浦区盛青银驰', '诉求区域': '青浦区', '内容描述': '市民来电反映:青浦区盛青银驰，我处地图上没有，是在观云路黄泥娄路交叉口，这是一个新的楼盘，前几天刚刚交房，投诉房屋质量不行，建房使用的线路和设备，质量不行，用的是杂牌，诉求：投诉房屋质量问题。', '工单类别': '一般', '处理描述': '1、市民称房屋没有安装燃气表和水表。经查，该项目已取得燃气和供水配套合格证明，小区供水和供电已纳入市政管网。该项目水表井内用短管衔接，户内龙头正常出水；该项目已完成室内燃气管布置，且室内外接管已完成。上述符合【上海市新建住宅交付使用许可规定实施细则（沪房建管[2018]102号）】文件要求。市民向自来水公司申请后，由自来水公司负责挂表供水；市民可向燃气公司申请后，由燃气公司负责挂表供气。2、市民咨询【上海市新建住宅交付使用许可证】审核范围，已告知相关证词依据。我科室于2024年1月18日致电联系市民，对此事进行了说明。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '工程质量', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704337080-2569071', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010512, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 5, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704337410-8143', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010652, '工号': 3022, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 9, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:外省市户籍是否能在本市补办身份证。', '工单类别': '一般', '处理描述': '根据《外省市来沪人员申领、换领、补领居民身份证，申领临时居民身份证《窗口服务告知单》》解答，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '身份证管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704337585-2569518', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104010742, '工号': 3870, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 10, 10), '诉求地址': '杨浦区恒仁路350号1层 上海旗舟文化创意集团有限公司', '诉求区域': '杨浦区', '内容描述': '市民来电反映:其未在上述公司入职过。市民举报该公司有虚列支出，且公司公帐有多项支出存在异常，有偷税漏税的情况，诉求：请管理部门核实查处该公司的违规行为并让该公司与市民联系，需回复。', '工单类别': '一般', '处理描述': '对于涉及偷漏税情况，您可将相关证据线索寄送至杨浦区税务局征管科（杨浦区昆明路572号B区征管科收），待收到检举材料后进一步判断处理。若有情况需进一步反映请拨打12366转区局举报中心。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '税收管理', '四级分类': '偷税漏税', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336904-2826552', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 2024010401