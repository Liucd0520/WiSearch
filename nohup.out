0374，工单内容：重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,目前还是老样子没有改善，当时处理人员比较消极表示无法处理。诉求：请上级管理部门继续介入处理。上述地址每天最早到6:00最晚到18:00有六七个人分别骑三轮车进小区播回收家电家具的录音，噪音扰民。小区门卫也让这些人进入。诉求：要求核实制止噪音扰民。（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '我村委于2024年1月7日收到12345派发对工单后，对于市民反映的问题，村委近期将在大门口张贴禁止收废品车辆出入标志，同时和门卫沟通后不在让其类似人员进出。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '外置扩音装置', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704612140-274227', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107013442, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 29, 32), '诉求地址': '长宁区娄山关路533号2902-2913室上海寻梦信息技术有限公司', '诉求区域': '长宁区', '内容描述': '市民来电反映：个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704612430-2361197', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107013472, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 30, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704612508-3096882', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107013542, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 33, 46), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:市民户口在四川北路街道，能否在上述地址接种带状疱疹的疫苗。', '工单类别': '一般', '处理描述': '根据“ 本市带状疱疹疫苗接种门诊 ”告知市民，市民认可，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '疾控防疫', '四级分类': '其他疫苗', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704612687-2361303', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107013372, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 7, 15, 34, 5), '诉