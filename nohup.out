, '工号': 3262, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 3, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民称其从2021年10月份至2022内6月份是否有举报邮政部门吧个人信息给到企业，及要求对邮政进行处罚查处等举报工单  ', '工单类别': '一般', '处理描述': '告知市民查询到有两个相关工单编号提及到此信息，查到的工单号：20220105006870，20220112027843，市民认可，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '12345热线', '四级分类': '信息咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704512721-3026248', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106009372, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 4, 5), '诉求地址': '杨浦区', '诉求区域': '杨浦区', '内容描述': '催单原因为“市民反复催单”。市民要求尽快处理。【最近派发的工单编号：20231222011649，工单内容：【重新交办，要求：答复要点不明确，告知市民答复要点，其表示：现在同意平台给到的处理结果，但是费用一直没有退款。原诉求不变，要求管理部门再次核实处理，尽快退款。（需回复）最近办结的工单编号：20231207012494，工单内容：市民来电反映：其在抖音商城上购买了阿玛尼鞋子，价格为62.795元。订单号：6924002435368818049。其收到发现不是阿玛尼品牌，也不是商家宣传的真皮鞋子。诉求：希望管理部门核实，要求按照商家承诺赔偿。（需回复）】】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231222011649，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704513653-983741', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106009412, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 6, 6), '诉求地址': '杨浦区江湾城路99号9栋，上海格物致品网络科技有限公司', '诉求区域': '杨浦区', '内容描述': '市民来电反映:投诉抖音商城。市民在抖音商城上买了衣服，衣服本身存在问题，原本平台有给予市民补偿方案。市民在申请退货等手续完成以后，平台就不承认自己所提供补偿方案。订单号：6924737622709310816.诉求：要求抖音商城按照其所提供的补偿方案补偿市民。', '工单类别': '一般', '处理描述': '经核实，被诉企业抖音平台处理给与消费者300元现金方案，投诉人认可，经沟通双方达成调解协议。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704513726-983776', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106008022, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 6, 12, 6, 41), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:城乡医保如何报销。', '工单类别': '一般'