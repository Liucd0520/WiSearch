 None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704626167-2623085', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107019362, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 7, 19, 20, 31), '诉求地址': '浦东新区商城路108弄3号2404室', '诉求区域': '浦东新区', '内容描述': '市民反映：2024年1月7日，打电话给上海移动问每个月收费1元的12593原因。移动客服表示是国际和港澳ip使用费，该功能2013年已经取消，而且没有该功能费也可以拨打12593加上国际或者港澳电话，价格也是一样的，所以该功能费的存在已经没有任何意义。询问为何不通知客户已经取消该业务，移动客服表示其可以自己去看上海移动网站。移动投诉部门回复其表示该部门的权限只能退回一年12个月功能使用费。其移动手机号码：13901947071 诉求：要求退回从2013年开始取消该业务至今的每个月1元的功能使用费。', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '其他', '四级分类': '其他', '主办单位': '上海移动通信公司', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107019242, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 7, 19, 23, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:大宁路667弄33属于哪个居委。', '工单类别': '一般', '处理描述': '根据《静安区大宁路街道所属居委会一览表》，已解释。市民认可，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '社区家政', '四级分类': '社区服务网点', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704626483-2623168', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107019272, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 7, 19, 30, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:个人消费者要求转接拼多多客服。', '工单类别': '一般', '处理描述': '转接拼多多专席未成功，转接过程中电脑死机，19:30电话回拨市民表示无需处理。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704626629-533906', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107019222, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 7, 19, 31, 42), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704626711-2623235', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107019232, '工号': 4292, '工单生成时间': datetime.datetime(2024, 1, 7, 19, 32, 43), '诉求地址': '长宁区娄山关路533号2902-2913室', '诉求区域': '长宁区', '内容描述': '市民来电反映:其在拼多多平台购买了皮草外套及裙子，订单号：231228-484992685513273。7天无理由退货申请退货退款时显示运费保障中，现在运费没有退回，联系不上拼多多平台人工客服及机器人客服，运费：20元。诉求：希望管理部门核实处理平台售后不作为行为并协助退还运费。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704626442-533863', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107019152, '工号': 4282, '工单生成时间': datetime.datetime(2024, 1, 7, 19, 34, 32), '诉求地址': '浦东新区川沙镇新德路735弄明珠小区门口', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述小区门口之前都有安装隔离栏（铁的固定）。但在元旦过后相关部门对隔离栏进行了拆除。拆除之后该小区门口就出现了乱停车现象。各种社会车辆在白天，晚上都会有停靠。严重影响了市民出行安全。诉求：请管理部门核实为什么要拆除隔离栏并希望恢复安装。（需回复）', '工单类别': '一般', '处理描述': '尊敬的市民：您好!新区建交委道路中心二分中心接单后立即联系养护公司,经核实,因小区出入电瓶车转弯时不注意的情况下容易发生碰撞产生人员受伤的情况，存在安全隐患，根据《关于推进城市道路禁车柱、分隔栏杆等分隔设施精细化管理的指导意见》里设置技术要求的规定对该处原先在小区门口转弯处交警部门设置的隔离护栏进行拆除处置，您要求重新进行安装，需要交警部门出具具体的可行性、安装合理性方案以及安全系数情况报告，方可进行实施，故目前并不具备安装隔离护栏的条件,待交警后续协调有关部门进行沟通后，尝试其他方案放置乱停车的情况。感谢您对浦东城市建设的理解和支持。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '道路维护', '四级分类': '设备添置', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704626117-2623066', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107019402, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 7, 19, 35, 20), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民是网约车司机，在高德旗下的网约车平台桔子出行，平台限制了市民的账号，无法接单。平台客服电话是四川的。', '工单类别': '一般', '处理描述': '建议市民联系平台注册地管理部门处理，归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704627047-534016', '工单类型': '求助类', '新一级分类': None, '新二级分类': Non