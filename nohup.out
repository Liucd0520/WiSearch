031062, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 5, 18, 19, 25), '诉求地址': '松江区岳阳街道人民北路久汇大厦停车场', '诉求区域': '松江区', '内容描述': '市民反映：其在附近上班，上述地址停车场是最方便的，但近日起不让进入。经咨询，停车场没有多余名额，也咨询过物业，答复无权限。但其发现实际久汇大厦停车场日常空余车位较多，且会放其他社会车辆进入（详见附件）。诉求：望管理部门协调解决其停车问题。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '松江区12345市民服务热线接单后派岳阳街道，经分管领导签批同意，市民诉求部分属实。岳阳街道于2024年1月8日先行联系市民，并对工单问题描述进行确认。经核实：1、久汇大厦是内部停车场，不对外开放；2、久汇大厦车位有限，内部驻场单位跟停车场管理方签有停车名额分配协议。经了解该来电人是建设银行人员，已告知通过单位自行协商。2024年1月8日电话答复市民，其表示认可。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '经营性停车场', '主办单位': '松江区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105031182, '工号': 3802, '工单生成时间': datetime.datetime(2024, 1, 5, 18, 27, 24), '诉求地址': '松江区泗泾镇高技路江河路', '诉求区域': '松江区', '内容描述': '市民来电反映:以上地址交叉路口，在江河路上每天16:00-2:00左右存在无证设摊的现象，现场有城管协管，但是不处理，诉求：尽快核实取缔此无证设摊现象。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '经泗泾镇分管领导签批同意，市民反映情况部分属实。泗泾镇精细办于1月8日与来电人取得先行联系，并对工单问题描述进行确认。工作人员于1月12日晚到达现场查看，该处存在占用道路设摊经营的情况，工作人员对设摊行为进行取缔，并暂扣经营工具。市民反映的不管的情况不属实，后续将会对该处设摊行为加强巡查管控。泗泾镇精细办于1月12日将办结情况答复来电人，市民已知晓。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704449939-927131', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105031332, '工号': 2890, '工单生成时间': datetime.datetime(2024, 1, 5, 18, 28, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:社保卡找不到了，已经去银行挂失了，咨询电子医保卡是否能正常使用。', '工单类别': '一般', '处理描述': '根据《 社会保障卡挂失补办期间，医保电子凭证能否正常使用？ 》告知市民，认可，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704450356-2233177', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105031712, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 5, 18, 28, 37), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电