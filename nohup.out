修队伍务必文明施工，施工期间应当采取噪声防治措施，避免干扰他人正常生活。经办人于20...', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '徐汇区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704528467-3033687', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106017532, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 6, 16, 13, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704528672-990862', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106017582, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 6, 16, 14, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民在拼多多上购物，退货后，商家不退款。转接拼多多专席。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704528772-990894', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106017522, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 6, 16, 14, 26), '诉求地址': '本市拼多多', '诉求区域': '本市', '内容描述': '市民来电补充信息。市民补充信息内容为要求管理部门联系其，给予答复，不要平台联系其。【最近派发的工单编号：20231227000895，工单内容：市民来电反映:在拼多多购买的商品，订单号：231130-644800879493420,231130-147010426373420，商家发的是空包裹，和平台反映只是退款处理。诉求：投诉平台不作为，要求给予赔偿，要求市场监督管理局给予回复处理。（市民要求信息保密，需要回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231227000895，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704528718-211764', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106017662, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 6, 16, 15, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多上个人消费问题，要求转接拼多多。', '工单类别': '一般', '