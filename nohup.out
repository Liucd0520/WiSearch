'新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108000822, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 9, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:打架是否受理。', '工单类别': '一般', '处理描述': '建议市民报警，市民认可，此单归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '12345热线', '四级分类': '信息咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704672447-2369149', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108001042, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 15, 53), '诉求地址': '长宁区娄山关路533号2902-2913室', '诉求区域': '长宁区', '内容描述': '市民反复催单,希望尽快处理。【最近派发的工单编号:20231230005853，工单内容：市民来电反映:其在拼多多购物，因商品质量有问题，联系拼多多未果，订单号：230723-450536488592456，金额：118元，商品：数码商品，购买日期：7月23日，诉求：要求拼多多给到一个合理解决方案。】', '工单类别': '一般', '处理描述': '已电子催单,工单编号：20231230005853，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704672791-2626191', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108001382, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 17, 24), '诉求地址': '虹口区瑞虹路25弄43号甲', '诉求区域': '虹口区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。市民反映快递服务问题。2024年1月1日，17:27分韵达客服（021) 6022...', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108000902, '工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 17, 58), '诉求地址': '浦东新区浦东（上海）自由贸易试验区浦东大道2123号3层3E-1842室上海盒马网络科技有限公司', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其在上述地址公司的盒马APP上购买了盒马MAX会员，价值258元，市民表示盒马擅自更改会员协议，将原本免运费私自更改为了每天仅一次免运费，市民不认可提出要退出会员，会员号：TD_5756683，要求退款，望管理部门核实处理。', '工单类别': '一般', '处理描述': '经与被诉方沟通反馈，被诉方表示通过会员号：TD_5756683未查询到相关会员信息，分别于1/24 10:59、11:18、1/25 13:33致电消费者均无人接听，故终止调解。建议重新投诉并提供相关会员信息。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704672636-2626158', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108001192, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 18, 21), '诉求地址': '浦东新区上钢七村5号304室', '诉求区域': '浦东新区', '内容描述': '【表扬】市民来电咨询:其上述地址的独居老人，在1月7日晚上因为家中房门无法打开，拨打110以后上钢派出所警员上门联合周家渡消防救援站的工作人员，帮助其打开了门，其表示消防救援站安排了7,8名工作人员上门。诉求：来电予以表扬感谢。', '工单类别': '一般', '处理描述': '2024年1月8日，我大队接此工单后即向周渡消防救援站了解情况，并将此情况上报上级表扬周渡消防救援站为人民服务的精神。群众反馈情况属实。已于2024年1月8日联系群众。有录音为证。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '表扬承办部门', '四级分类': '表扬感谢', '主办单位': '市消防救援总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704672710-536402', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108001452, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 19), '诉求地址': '浦东新区金杨路220弄14号门口', '诉求区域': '浦东新区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。金杨街道1月8日检查，14号门口违搭者提前知道消息，把危棚周围的布先拆了，只留下一把危伞。诉求：希望管理部门核实转送相关照片至承办部门。【相关工单编号：20240102013441】（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '市民您好！您反映的事项，金杨新村街道金杨二居已知晓，经报城管认定核实：您所称的危棚，实际上是小区居民休闲聊天用的简易遮阳棚，不构成违章建筑，目前遮阳伞已经搬离。居委、城管始终尽心尽力为民服务，以事实为依据，以法律为准绳，不存在欺上瞒下的情况。有相关异议可直接拨打金杨城管中队电话：20246175、50339026、50339107或直接前往：灵山路1839号反映，有邻里问题可直接拨打居委电话：50706027或直接前往：金杨路220弄65号进行反映。感谢您对我们工作的支持，祝您生活愉快！因1月8日8时30分、9时、9时30分与诉求人先行联系均无人接听，1月17日15时、15时30分、16...', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '诉求未解决', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108001002, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 19, 11), '诉求地址': '青浦区赵巷镇业辉路399弄99号', '诉求区域': '青浦区', '内容描述': '市民来电反映:其是上述地址小区业主，市民表示给小区物业缴纳物业费，但是物业一直不开具发票，存在偷税漏税。诉求：希望管理部门核实，并对物业存在偷税漏税进行处理', '工单类别': '一般', '处理描述': '关于您反映“青浦区赵巷镇业辉路399弄99号小区物业不开发票”事宜，已要求上海盈嘉物业管理有限公司开具发票，您告知现已收到物业开具的发票。 回复时间：2024年01月10日14时18分，问题情况：已解决，市民表示：满意。 ——国家税务总局上海市闵行区税务局', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '税收管理', '四级分类': '偷税漏税', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704672972-2369263', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108000952, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 20, 14), '诉求地址': '长宁区镇宁路55号（一兆韦德）', '诉求区域': '长宁区', '内容描述': '市民来电反映:3年前办理了上述健身房的终身卡，价格7万左右，现在使用的时候发现商家关门了，希望管理部门协调退款。', '工单类别': '一般', '处理描述': '归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704672835-2369234', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108001202, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 22, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:医保是上海的，人在合肥，显示备案有问题，无法使用。', '工单类别': '一般', '处理描述': '转接医保成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704673234-281885', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108001482, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 22, 46), '诉求地址': '浦东新区邹平路从成山路到上南东校马路西侧人行道', '诉求区域': '浦东新区', '内容描述': '市民反映：上述人行道施工，行人不能行走，邹平路马路西侧停了一排机动车，行人现在只能在马路中间和机动车，自行车，电瓶车一起通行，非常危险。诉求：希望采取措施保障行人，自行车电瓶车的通行。', '工单类别': '一般', '处理描述': '尊敬的吴先生，您好：您反映的情况浦发集团下属临港市政已收悉。经核实，现场已采用垫草包，钢板两侧垫减速条处理，现场已整改完毕，可确保通行。特此答复，感谢您对我们工作的支持与理解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': '道路养护', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108001302, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 8, 8, 24, 48), '诉求地址': '浦东新区张江孙农路87弄', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:市民告知了地址