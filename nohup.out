该情况我所已掌握，将全所通报上述两位民警急人所急、真诚服务为考生解决问题的事迹。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704605668-526246', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010212, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 45, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是知青，在外地退休，询问如何开通医保卡在本市可以直接买药。', '工单类别': '一般', '处理描述': '根据《如何办理国家异地就医备案？ 》告知，市民认可，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704606040-526385', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010042, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 46, 6), '诉求地址': '虹口区四平路777号', '诉求区域': '虹口区', '内容描述': '市民来电反映:2021年在上述地址攀宇体育办理了健身卡，金额:8000元。有效期是四年。2024年1月7日去上述地址健身，工作人员告知无法使用无法履行合同义务，目前该健身房叫圣泊菲体育。诉求：望管理部门核实并且协助市民退费。', '工单类别': '一般', '处理描述': '经总队先行联系,市民表示已解决。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704605723-3093943', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010412, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 50, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电辱骂话务员。', '工单类别': '一般', '处理描述': '工单归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704606519-271816', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010422, '工号': 2890, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 50, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:望江县的事情。', '工单类别': '一般', '处理描述': '外省市的事情，非受理范围，市民自行挂机，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '外省市受理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704606523-271818', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010382, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 50, 35), '诉求地址': '宝山区殷高西路21弄殷高小区45号101室', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述地址业主周末装修扰民。诉求：希望周末不要产生装修噪音扰民。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '宝山公安局高境派出所于于2024年1月8日10时21分与来电市民先行联系,了解情况。针对市民诉求，经调查核实，已告知业主及装修人员按照《上海市社会生活噪声污染防治办法》规定，在装修时间内进行装修作业，装修过程中采取噪声防治措施，避免干扰他人正常生活，午间与双休日装修避免使用易产生噪音的操作，其表示会配合公安工作。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704606436-3094276', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010372, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 51, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:韵达快递公司（上海同城件），快递单号：433657341401579，物流中转慢，中途要求更改地址也未更改。诉求：投诉派件网点不负责任不及时处理异常问题，要求核实及时处理问题。', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704606498-2313019', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010472, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 53, 15), '诉求地址': '宝山区双城路淞宝路东方网点', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述网吧内有大量人员吸烟，且经营者并未劝阻行为。诉求：请管理部门核实，依法处理。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '因市民系匿名，未留联系电话，故无法答复。针对市民反映情况，宝山公安分局海滨新村派出所民警于2024年1月11日、12日下午15时许去现场，针对网吧内有大量人员吸烟，且经营者并未劝阻行为，经核实，海滨所民警已根据相关《中华人民共和国消防法》及相关条例对网吧经营者进行告诫。相关经营表示会配合。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '禁烟控烟', '四级分类': '禁烟控烟', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704606633-2313080', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010452, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 55, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:农业银行，老人的敬老卡是农业经验，想更改预留手机号。', '工单类别': '一般', '处理描述': '转接社保卡成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '养老保障', '四级分类': '老年津贴', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704606669-2313092', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010942, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 56, 55), '诉求地址': '宝山区海江路888弄2号', '诉求区域': '宝山区', '内容描述': '市民反映：该商家不让客户自带食物，按照消费者权益保护法属于违法。诉求：请管理部门处理商家不让自带食物问题。', '工单类别': '一般', '处理描述': '经查，举报事项不予立案。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010582, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 58, 30), '诉求地址': '本市拼多多', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240106019272，工单内容：【投诉】市民来电反映：长宁区市场监管局不作为，懒政，让商家回复市民不处理此事，破坏营商环境，诉求：要求投诉懒政不作为，破坏营商环境，并要长宁区市场监管局写处理情况说明。（市民要求信息保密 需回复）（关联工单号：20240102032452）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240106019272，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704606600-271852', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010652, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 59, 1), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704607009-2313259', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010632, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 7, 13, 59, 24), '诉求地址': '静安区襄阳北路1号', '诉求区域': '静安区', '内容描述': '市民来电反映:上述地址襄阳北路1号，此处都是招聘广告，诉求：要求清理掉此处张贴的小广告。', '工单类别': '一般', '处理描述': '【南京西路街道】情况属实；诉求合理合法；我街道于1月8日15点23分与市民进行先行联系，告知工单收悉，将派给职能部门进行核实处理。南京西路街道城市运行管理中心接报后派员赶到现场，经核实，襄阳北路1号未发现有市民反映的招聘广告，问题已实际解决；经办人：工作人员（62472589），负责人：沈煜（62472589）我街道将上述处理情况已通过电话与市民进行说明，市民表示满意。无其他情况说明。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '市容市貌', '四级分类': '广告张贴', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704606969-272005', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010762, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 0, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:公积金账户。', '工单类别': '一般', '处理描述': '转接公积金专席成功,归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704607148-3094580', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010702, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 0, 51), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:有人在微信上发布其和对方的聊天记录，市民要求投诉微信', '工单类别': '一般', '处理描述': '建议市民向当地反映，市民认可，故归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704607126-272072', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107009002, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 3, 42), '诉求地址': '杨浦区闸殷路91弄', '诉求区域': '杨浦区', '内容描述': '市民来电反映:上述小区外开了很多门店，如废品收购站、钢铁加工厂，开了后出现乱停车现象，堵住进入小区的路，且有辆三轮车存在瞬时违法行为，诉求：告知小区外为何能开这些店，这条路是哪个部门管的，处理该三轮车', '工单类别': '一般', '处理描述': '市民让3个问题都一一派单，在线建议市民涉及违法停车的举报，可以直接转接公安交警。三轮车瞬时违法行为建议向交警部门提交视频证据举报违法行为。市民不认可后挂断。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704605383-271319', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010812, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 4, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:如何查询是否办理过医保共济账户操作。', '工单类别': '一般', '处理描述': '转接医保成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704607330-3094644', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010882, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 5, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704607484-272216', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010802, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 11, 5), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:1月1日，市民的物品在安徽省马鞍山星巴克门店被偷，其和警方反映，店家让市民提供相关复印件材料，1月2日，门店告知已经帮市民调了监控，确实是有人把市民的物品拿走了，但当天警察不上班，等到1月3日，警察前往门店，星巴克又一次于3号又拒绝了市民调监控的诉求，1月4日再次联系官方，承诺帮市民解决，后续也没有帮其调取监控，仍然让市民提供复印件材料，也无法给到具体的处理期限，询问如何处理。', '工单类别': '一般', '处理描述': '非受理范围，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '立案侦查', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704607305-272145', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107011032, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 12, 13), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民补充信息：现顺丰一直联系其告知因证据不足并且其之前没有保价故无法赔偿，市民不认可，希望管理部门尽快处理并回复【最近派发的工单编号：20231228000908，工单内容：市民来电反映:上海寄到天津的顺丰快递：SF1625854692838，寄的是相机，价值：2170元，天津收件方拆箱视频里的东西是坏的，顺丰表示市民没有保价。诉求：要求原价赔偿。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231228000908，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704607723-2313598', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010852, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 12, 34), '诉求地址': '普陀区桃浦祁连山路古浪路附近', '诉求区域': '普陀区', '内容描述': '市民来电咨询:表扬上海市消防救援总队普陀支队桃浦特勤站，1月7日市民的手指突然戒指卡住了，市民打了119告知去就近特勤站。该处工作人人特别细心热心的处理了市民的问题，很多人围着关心市民情况，还用特别的工具处理市民的手指，防止摩擦过烫旁边还有小伙一直浇水，领导也在指导，市民非常认可感激，故此来电表扬。诉求：表扬当时处理的两个小伙以及感谢整体特勤站的工作人员。（市民要求 无需回复）', '工单类别': '一般', '处理描述': '已将相关人员纳入绩效加分，通报表扬。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '其他', '四级分类': '其他', '主办单位': '市消防救援总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704607434-526943', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107010842, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 12, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:单位门卫岗位是做一休一，如何通过人力资源社会保障行政部门申报审批。超过国家规定多少小时后给加班费用。', '工单类别': '一般', '处理描述': '2024-01-08 09:55:22致电，关于您咨询综合计算工时制申请和加班的问题。告知您因工作性质或生产特点的限制，不能实行每日工作8小时、每周工作40小时标准工时制度的，可以实行不定时工作制度或综合计算工时工作制等其他工作和休息办法，须按照规定向人力资源社会保障行政部门申报审批。...', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '用工规范', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704607438-2313450', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107011162, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 15, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，投诉拼多多的商家，同意转接绿色通道。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704608011-272457', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107011412, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 7, 14, 16, 28), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': N