, '新五级分类': None}, {'工单编号': 20240104024192, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 32, 31), '诉求地址': '奉贤区庄行镇吕桥路288弄佳兆业二期', '诉求区域': '奉贤区', '内容描述': '市民反映：其是奉贤庄行吕桥路佳兆业二期的业主，该小区是一个交房才2年多的新小区，当时就是看中了绿化率高。业主公约上清楚写明不得随意改变外立面，2023年40号业主把窗改门了，破坏小区整体，至今未见城管的整改措施（详见附件）。别墅里的花园属全体业主公用绿化，非某一业主私人所有，但现在很多别墅业主都已私自砌围墙，拔绿篱扩大花园用地，绿篱都死一大片，严重影响小区景观，没有有效监督。2023年就电话向庄行镇城管反映过，一直没见效果，存在不作为。诉求：投诉奉贤区房管和城管部门不作为，要求整改。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '庄行镇于1月5日接单，1月5日电话联系投诉人，未接电话。1月5日，执法队员赶赴现场，现场确实有破坏房屋外貌的行为，现场给当事人开具责令改正通知书。并且立案查处，立案号为2024060002。该问题已实际解决。处理人：张佳伟。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '奉贤区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104024042, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 32, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多人工客服。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704353498-65725', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104023632, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 33, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其实货拉拉司机对于对于平台的扣分和加分规定不认可。', '工单类别': '一般', '处理描述': '根据《货拉拉有关工单处理口径》认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704353095-19816', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104024082, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 4, 15, 33, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:社保卡的初始密码是多少。', '工单类别': '一般', '处理描述': '初始社保密码设为“123456”', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '170