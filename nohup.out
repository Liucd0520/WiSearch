号': 20240109028162, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 51, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:邮政快递公司（湖北-上海），快递单号：9873635856985，未经允许私自做拒收退回。诉求：投诉快递公司违规操作不处理异常问题，要求尽快给予合理的处理方案。', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790144-2820616', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028152, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 52, 3), '诉求地址': '普陀区金沙江路华为授权服务中心', '诉求区域': '普陀区', '内容描述': '市民来电反映:其父亲1月5日到上述地址准备手机贴膜，门口宣传礼拜五是华为服务日免费贴膜，结果去了以后收取了399元，其当时就提出质疑，随后对方拿了一个本子表示399元是三次的价格，市民认为引导消费，以免费吸引进店随后开始恶意宣传，诉求：希望管理部门协调退款。', '工单类别': '一般', '处理描述': '经查，被诉方系上海金强通讯设备有限公司普陀第二分公司，现场未发现该公司存在违法行为，我局决定不予立案。关于投诉争议事宜，经调解，投诉双方已协商一致，被诉方同意退款，待后续退款。2024年1月26日电话回复投诉人，其表示投诉双方已协商一致，待后续退款。同意该工单先行办结。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790098-474420', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028132, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 54, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电补充信息。市民补充信息内容为：2024年1月9日16:30左右接到拼多多客服联系，称不能解决，市民不认可答复。市民表示该类商品退货需要官方客服上门将商品取走并退回。市民希望管理部门能与其联系并沟通。请管理部门尽快处理。【最近派发的工单编号：20240106002174，工单内容：市民来电反映:其通过拼多多购买了洗衣机。货不对板，物品损坏，订单编号：23101416672674761694。订单金额：352.8元。目前快递拒绝上门取货退货。诉求：希望管理部门核实后协助进行退货退款或协助进行仅退款。】\n', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240106002174，故归档。\n', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790072-474406', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028252, '工号': 4282, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 56, 37), '诉求地址': '青浦区崧古路33弄昱华苑', '诉求区域': '青浦区', '内容描述': '市民来电咨询:物业公司所开具的物业费和停车费发票是增票还是普票（给到个人的）。（需回复）', '工单类别': '一般', '处理描述': '您好，针对您的问题已电话联系并回复，欢迎您再次提问，您也可以通过“上海税务局”微信公众号“在线模块”、“上海税务”网站“我要咨询”模块进入智能在线咨询系统，或通过12366纳税缴费服务热线获得帮助。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '物业管理收费', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790228-728797', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028582, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 56, 38), '诉求地址': '杨浦区内江路80号', '诉求区域': '杨浦区', '内容描述': '市民反映：东外滩爱国里2023年6月交付，目前开发商桥升公司明确表示即将进行车位销售，销售方案是每户业主只能购买一个车位，剩余车位全部对外销售，销售对象包括非爱国里小区业主的其他人，并且同时公开销售，不分先后，目前方案已在杨浦区房管局审批。该行为和售卖方案严重侵害业主权利，销售时的宣传和大众认知车库建设是为新业主提供的配套，使用车库会用到的公摊面积均由购房业主承担，非业主进出小区停车，对小区安全造成隐患。诉求：要求杨浦区房管局拒绝批复该违法无理销售方案，鉴于存在矛盾冲突，今后针对爱国里小区车位销售方案，房管局应先与业主代表沟通，维护市民合法合理权利。', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派区国资委、区房管局进行处理。据区国资委回复：先行联系：城投于2024年01月09日联系了该来电人。情况核实：经核实，来电人反映不属实。处置过程及回访：经核实，该小区地下停车位未进行销售，暂无销售方案。据区房管局回复：经我局市场科核实，目前企业没有来申请车位销售。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '杨浦区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028362, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 57, 38), '诉求地址': '嘉定区上海汽车创新港嘉定区安拓路56弄 上海蔚来汽车有限公司', '诉求区域': '嘉定区', '内容描述': '【重新交办，答复要点与实际情况不符。充电站有监管义务。诉求：投诉充电站要求赔偿市民损失。最近办结的工单编号：20231226020769。工单内容：市民来电反映:12月15号在沈阳的充电站进行充电，一直到16号凌晨，市民称充电口的插口进雪，和客服反映告知将视频提供给警方，之后便无音讯，对此表示不满，客服电话：02167099903，诉求：要求赔偿。（需回复）】', '工单类别': '一般', '处理描述': '关于您反映治安问题已报警处理，对于其他诉求商家表示无法满足，终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790320-728847', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028272, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 58, 8), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民重复来电反复催单，要求尽快处理答复。【最近派发的工单编号：20240105008152，工单内容：市民来电反映:邮政EMS（兰州-上海），快递单号：1194076901748,2023年12月22日发件的，到达上海后一直未派件，12月27日送到时牛肉已经坏了，至今未处理。诉求：要求责任方全额赔偿。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240105008152，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790576-2564528', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028442, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 0, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790441-2564436', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028542, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 0, 51), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民是派出所人员，其在办案时，手机号被市民举报给反诈中心，后手机被禁了，故来电', '工单类别': '一般', '处理描述': '告知市民无法受理，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '治安维护', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790619-474755', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028482, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 1, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其在拼多多上购买了12罐旺仔牛奶，订单号：240101-521299619503351，至今未发货，联系了拼多多也未得到处理。诉求：请管理部门核实，要求尽快完成订单。', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790513-728978', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028462, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 1, 41), '诉求地址': '宝山区', '诉求区域': '宝山区', '内容描述': '市民来电反映:市民是上述地址的租户，住的是粮油所的房屋，粮油所把房屋承包给了另一家汽车服务有限公司，现该公司让其办理，市民并非通过房产中介租赁的房屋，而是朋友介绍。', '工单类别': '一般', '处理描述': '建议其咨询12348，市民认可，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '租赁管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790486-2564467', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028412, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 2, 12), '诉求地址': '宝山区潘泾路3998号富驰高科厂门口', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述地址的马路两侧有30-40电动车流动摊贩，占领道路200-300米，设摊人员有40个左右，设摊时间：07:00-9:00、15:00-18:00、19:00-22:00，该现象已经持续近一年，之前罗泾镇的城管管理过，市民认为没有很好地管理导致周边环境差且影响道路通行，认为食品安全也存在隐患，诉求：请管理部门核实情况并取缔无证设摊。', '工单类别': '一般', '处理描述': '先联，2024-01-10 10:44，接投诉后，执法队员到现场查看， 在现场确实发现有乱设摊现象，执法队员现场立案处理，因近期夜间乱设摊投诉较多已安排多次整治并加强巡查与管理，近几日巡查已明显改善。执法队员于1月17日回复市民。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790369-2820772', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028532, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 3, 8), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：更正联系电话：18150086861，要求尽快处理答复。【最近派发的工单编号：20240109020166，工单内容：市民来电反映:其于12月份委托圆通快递寄送快递（深圳-上海），快递单号:YT1159537140088、YT1159767320408，第一单号物品损坏，第二个单号收到的物品和寄送的物品不符，联系客服一直没有处理，诉求：管理部门核实情况给予处理方案。（需要回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240109020166，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790604-2564550', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028752, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 4, 58), '诉求地址': '闵行区浦江镇上海恒星机动车驾驶员培训有限公司', '诉求区域': '闵行区', '内容描述': '催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231225027135，工单内容：重新交办,要求：按答复要点告知市民,市民表示答复要点与实际不符，其在11月28日已经填了单子，目前还未收到退款，市民表示银行卡开户行信息可能填错了，不知道是否会影响退款。诉求：请管理部门尽快处理退款。最近办结的工单编号:20231124012231，工单内容:市民来电反映: 2023年2月4日在上述驾校报名学车，地址：不清楚，价格：4080元，教练姓名、车牌号：不清楚，现在驾校不肯帮其做面签，练车也不接送，其要退款，当时收钱的人让其自己找公司，要求管理部门协调退款。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231225027135，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '驾驶培训', '四级分类': '合同履行', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790938-2564756', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028682, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 5, 44), '诉求地址': '浦东新区启帆路张杨北路阳光天地1楼乐旋乒乓', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其之前在上述机构为孩子周梦洁购买课程学习，1月7日左右该门店突然关闭，现市民还剩余73课时，退费金额：11388元。诉求：请管理部门核实，帮助市民退款。', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，涉及健身培训和体育培训的，根据市培训市场综合治理工作联席会议办公室相关文件及市体育局关于做好体育培训市场治理工作的通知精神，明确对该事项投诉调解的法定职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790812-729130', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028712, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 6, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:在微信公众号使用健康云小程序，市民需要号源提醒，就开通了黄金会员。但市民付费开通会员后，设置号源提醒时页面一直显示努力加载中无法设置。市民账号：13661928688。诉求：请管理部门核实告知解决方案。', '工单类别': '一般', '处理描述': '您反馈的诉求已转至健康云核实处理，健康云反馈：已于1月18日与您取得联系，告知重新登录尝试，问题已解决。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '其他', '四级分类': '其他', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790869-729163', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028672, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 9, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民是是外省居民，现在要办理租房网签备案，可再办理时，系统一直提示称市民姓名和身份证不符，市民多次确认是正确的，不知道怎么处理，故来电（身份证：321323199508045179）。现诉求：望管理部门查，协调帮助市民办理网签备案', '工单类别': '一般', '处理描述': '市民您好！于1月22日15：01电联您未接通。经核实，截至2024-01-22&nbsp;，市大数据中心暂未从本市相关部门接收到您的来沪人口登记信息。为避免影响您办理网签业务，建议您携相关材料至居住所在地社区事务受理中心或房地产交易中心线下办理。感谢您对一网通办的支持，祝您生活愉快！', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '租赁管理', '主办单位': '上海市大数据中心', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704790799-2821040', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028942, '工号': 1732, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 10, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:家庭纠纷，是否热线可调解。', '工单类别': '一般', '处理描述': '涉及家庭纠纷，根据《不予受理来电的处理流程》，已建议市民可向居委或街道进行调解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '纠纷协调', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704791235-729348', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109029062, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 11, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:转接美团投诉电话。', '工单类别': '一般', '处理描述': '转接美团专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704791385-475149', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028522, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 12, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704791466-2565049', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109028772, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 9, 17, 13, 5), '诉求地址': '浦东新区康桥路1558弄绿洲康城清水湾玲珑苑', '诉求区域'