, '三级分类': '环境卫生', '四级分类': '卫生配套设施', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008372, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 40, 51), '诉求地址': '宝山区宝山区月浦镇绥化路50弄', '诉求区域': '宝山区', '内容描述': '市民来电咨询: 外省市户籍居民家庭，孩子2024年9月要读小学，在学区房租房，做房屋租赁备案的时候没有登记孩子的信息，只登记了大人的，诉求：现在要添加孩子的备案信息，咨询如何添加，怎么补救。', '工单类别': '一般', '处理描述': '经了解，市民所办理租赁合同网签备案未满6个月，现在要添加其家庭名下的未成年子女作为共同承租人，根据【关于印发[上海市住房租赁合同网签备案操作规定]的通知】（沪房规范[2019]11号）的规定，租赁合同提前解约，租赁双方当事人向租赁中心（区交易中心）申请租赁合同注销网签备案的，提交以下材料：（一）租赁合同网签备案申请书（收取原件，详见附件4）； （二）身份证明（核验原件）； （三）租赁双方提前解约协议（收取原件)。租赁合同新增网签备案：租赁双方当事人向租赁中心（区交易中心）提出网签备案一体化申请的，提交以下材料： 1.租赁合同网签（备案）申请书（收取原件）； 2.身份证明（核验原件）；...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '租赁管理', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162995-2365022', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008102, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 40, 59), '诉求地址': '普陀区', '诉求区域': '普陀区', '内容描述': '市民来电咨询:上海你我贷互联网金融信息服务有限公司，目前是所属哪里管辖，我处表格中为普陀区，诉求：咨询普陀区金融局，隐藏个人合同算不算是涉嫌非法集资？', '工单类别': '一般', '处理描述': '【市场】2024年1月2日，经办人与投诉人先行联系，投诉所述内容与工单基本一致，实为对借贷相关问题的投诉。经查，被诉人系咨询信息服务类平台。经沟通，被诉人表示无法达成一致，终止调解。关于非法集资等问题我局和投诉人沟通后，其表示知晓并会向公安部门及金融部门反映，2024年1月8日，经办人将处理情况告知投诉人，投诉人表示收悉。...', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '金融', '四级分类': '金融资讯', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162754-2364771', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008822, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 41, 38), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008452, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 42, 20), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:自己孩子2023年11月刚出生，2024年城乡居民基本医疗保险如何缴纳', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163110-541711', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008192, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 43, 24), '诉求地址': '浦东新区花木街道芳华路503弄', '诉求区域': '浦东新区', '内容描述': '市民来电反映:2015年开始至今上述地址小区业委会一直未成立。小区内未公示相关费用使用情况。现物业费要涨价。相关情况向居委反映，但事项未得到解决。市民诉求：请管理部门核实后对上述事项给予合理解释。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '花木街道培花二居委接单后回复：本次召开的业主大会，小区居民委员会代行业委会职责符合各项法规流程，现小区物业收费标准无法维持服务项目，物业公司要通过调整收费标准匹配服务项目，本次的业主大会就包含续聘物业，物业费调整的议题。上述小区年度审计报告已经在小区公示栏公示。感谢您对我们工作的支持，祝您生活愉快。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '业委会', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704162844-541441', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008442, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 43, 52), '诉求地址': '松江区', '诉求区域': '松江区', '内容描述': '市民来电咨询:松江区给小朋友办理的医保卡是不是可以去嘉定区领取，是不是一定要线下领取。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163093-541699', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008702, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 44, 30), '诉求地址': '本市拼多多', '诉求区域': '本市', '内容描述': '市民来电咨询:个人消费者要求转接', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163321-2365381', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008862, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 46, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:随申办如何变更手机号。', '工单类别': '一般', '处理描述': '根据《》,《【市民云】如何通过市民云APP变更手机号》答复', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '网站使用', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704163392-331815', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008642, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 47, 44), '诉求地址': '浦东新区唐镇德淳路100弄', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其购买了上述地址华侨城侨盈欣苑买得期房，原来合同告知2023年6月交房，但目前一直无法都未告知交房时间，市民表示无法租房。诉求：要求管理部门协调告知核实可以交房入住。', '工单类别': '一般', '处理描述': '尊敬的市民：您好！关于您反馈的购买了华侨城侨盈欣苑期房，原来合同告知2023年6月交房，但目前一直无法都未告知交房时间，市民表示无法租房。诉求：要求管理部门协调告知核实可以交房入住的问题我委已收悉。并与您进行电话沟通，经核实，按照双方合同约定，交房日期为2024年3月31号，不存在延期交付事宜。且该项目尚未取得新建住宅交付使用许可证。感谢您对浦东建交委工作的理解和支持。我委会将信访工作不断完善，更好的服务广大市民！（联系时间：2024.1.18）', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163216-2365271', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102008462, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 50, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:退休工人有城乡居民医保，如何医保零星报销。', '工单类别': '一般', '处理描述': '转接医疗保障成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163502-542129', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009372, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 52, 43), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:现在几点。', '工单类别': '一般', '处理描述': '已解释，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '12345热线', '四级分类': '信息咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163893-542533', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009242, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 52, 56), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '【为企服务】市民来电咨询:企业注册资金实缴到位的问题。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704163781-542411', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009022, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 53, 14), '诉求地址': '青浦区', '诉求区域': '青浦区', '内容描述': '【为企服务】市民来电咨询:上海企业登记在线，注册公司问题。', '工单类别': '一般', '处理描述': '转接成功,归档。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704163601-2623550', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009072, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 54, 35), '诉求地址': '浦东新区启帆路199弄', '诉求区域': '浦东新区', '内容描述': '市民反映：其是招商璀璨公馆的一名业主，向您反映一个重要问题。该项目于2023年12月22日取得了交付许可证，但开发商一直未能交付。这导致其承受了巨大的房租压力，生活受到影响。其倾尽全力在高行镇置业安家，以实际行动支持高行镇的发展，但目前的情况却让其感到极为愤慨。诉求：1.希望管理部门介入招商璀璨公馆的交付问题，确保开发商尽快交付。2.协助业主与开发商进行沟通，了解具体原因，并推动问题的解决。3.考虑为业主提供临时的租金补贴或其他形式的援助。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '尊敬的市民，您好。您反映的招商璀璨公馆房屋交付事宜，按照你与开发企业所签署的上海市商品房预售合同，合同中第十一条已约定交付时间。经核，该项目已于12月22日取得新建住宅交付使用许可证，按照（上海市新建住宅交付使用许可规定）规定，新建住宅交付使用许可证的颁发意味着建设工程竣工验收合格后，配套设施具备入住的基本条件。感谢您对浦东建交委工作的理解和支持，祝您生活愉快', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '市房屋管理局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009252, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 54, 42), '诉求地址': '青浦区汇金路590号3楼 舒适堡健身美容中心', '诉求区域': '青浦区', '内容描述': '市民来电反映:其在上述地址健身房办理了年卡，有效期到2026年2月26日，签过合同，门店目前关闭无法使用，也联系不到负责人退款。诉求：请管理部门尽快核实协调退款。（需回复）', '工单类别': '一般', '处理描述': '经核查，因该场所已停业，根据《上海市单用途预付消费卡管理实施办法》第二十四条规定，因经营者停业歇业或者经营场所迁移等原因导致单用途卡无法兑付的，由区单用途卡行政执法部门通过内部工作机制移送区行业主管部门牵头处理，本大队将举报线索移交给体育局进行进一步处理，后续由体育局给予答复。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163808-2623754', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009202, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 55, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其2023年12月11日在拼多多平台购买积木，金额117元，订单号：231211-189294263920616。收到后拼装起来只有70多，和网页上图片宣传82不一致。诉求：希望管理部门核实要求部分退款，退还一半费用。', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163765-542397', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009362, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 55, 46), '诉求地址': '静安区南京西路1038号百货公司）', '诉求区域': '静安区', '内容描述': '市民来电反映:上述地址柜台装修，熏的员工眼睛都睁不开，甲醛是有超标。诉求：请管理部门处理超标的问题。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '经区卫健委监督所核实，南京西路1038号为上海梅陇镇有限公司管理的场所，经与上海梅陇镇有限公司管理人员联系，管理人员表示最近无人反映此类问题，也不知道有店铺在装修。市民未留具体地址和联系方式，无法联系其明确具体位置。', '客户类型': '个人', '一级分类': '安全监管类', '二级分类': '安全生产管理', '三级分类': '职业健康', '四级分类': '职业健康', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163861-332285', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009412, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 55, 51), '诉求地址': '青浦区赵巷镇华中苑55弄', '诉求区域': '青浦区', '内容描述': '市民来电反映:青浦区赵巷镇华中苑55弄，其为租客，目前物业不收停车费，称因为业主没有交物业费，所以就不收市民的停车费，诉求：尽快处理缴纳停车费问题。（需回复）', '工单类别': '一般', '处理描述': '【此工单诉求内容部分属实】赵巷镇城运中心于2024年1月2日接单。于2024年1月2日13时20分首次通过电话先行联系诉求人，告知诉求已收悉，正在我单位办理。办理情况为：2024年1月2日由赵巷镇城建中心对诉求人反映的情况进行了核实，确认华中苑55弄停车费缴纳的问题事项，情况部分属实。接报后，本中心工作人员联系小区经理了解到，目前已取消2024年地下车位办理告知中的“办理停车费需缴清往年物业费”此条规定，并于物业工作会议中再次强调。据了解，现诉求人已完成缴费工作，我中心已要求物业加强管理。于2024年1月2日14时30分将处置结果告知来电人，经回复，诉求人对此处理结果未表示。该问题已经实...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '青浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163911-542551', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009232, '工号': 3660, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 56, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:去江南造船厂，被叉车车上胡货物砸到，咨询相关法律问题。', '工单类别': '一般', '处理描述': '依法解答。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '律师服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704163943-2623908', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009602, '工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704164093-2366204', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009622, '工号': 2100, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 59, 38), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上海户口，其名下一直无房产，是否算无房户，其表示不办理任何业务就是问一下。诉求：请管理部门回复解答。', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '房屋产权', '主办单位': '市规划和自然资源局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704164111-2366221', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102009352, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 59, 40), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电咨询:综合津贴卡没有开掉了，现在要补卡，询问到哪里补。', '工单类别': '一般', '处理描述': '告知市民如何补换敬老卡？市民表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '养