8462, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 48, 3), '诉求地址': '奉贤区南桥镇育秀东区1008-1号东侧', '诉求区域': '奉贤区', '内容描述': '【重新交办，要求：答复要点与实际情况不符,该地址乱停车现象已经很久（详见附件），物业不解决问题。诉求：请管理部门整治乱停车，并长效管理。最近办结的工单编号：20231222021757，工单内容：上述地址小区内每天都有车辆违规乱停车（详见附件）。诉求：要求整改乱停车现象。】', '工单类别': '一般', '处理描述': '南桥镇于2024-01-03 14:18:50接单，并首次通过电话先行联系来电人，告知其问题已经收悉，正在南桥镇进行办理。经核实，关于乱停车现象，是由于小区车多位少造成，物业已督促保安加强巡逻，一经发现车主乱停车，立即联系车主将车驶离。已经将处置结果告知来电人。经办人：张艳丽', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '奉贤区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018112, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 48, 5), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:顺丰快递公司（上海-浙江），快递单号：SF1435363988677，收件方未收到件，该件是防伪标志，该件价值5940元，丢件了，申请了理赔，没有满意的处理方案。诉求：要求根据实际情况给予合理的处理方案。', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704260724-2755804', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103017812, '工号': 4272, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 49, 12), '诉求地址': '闵行区虹井路青杉路路口乐虹坊三楼乐旋乒乓连锁', '诉求区域': '闵行区', '内容描述': '市民来电反映:市民在双十一期间在上述地址三楼报乐旋乒乓续费了乒乓课程（非一对一课）现在市民表示该门口突然关门联系不上，市民共计还有约4000元的课程还没有使用。市民表示有支付凭证。诉求：希望管理部门核实处理要求退费。', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，涉及健身培训和体育培训的，根据市培训市场综合治理工作联席会议办公室相关文件及市体育局关于做好体育培训市场治理工作的通知精神，明确对该事项投诉调解的法定职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704260226-672161', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018172, '工号': 3692, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 49, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:随申办如何更换手机号码。', '工单类别': '一般', '处理描述': '根据《如何更换一网通办绑定手机号码？ 》告知市民，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '网站使用', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704260666-2755757', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018262, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 49, 54), '诉求地址': '浦东新区沪南路红星美凯龙负一楼芝华仕', '诉求区域': '浦东新区', '内容描述': '市民来电反映:10月28日在上述地址芝华仕买了沙发，支付6500元，约定12月中旬送货，后续找到商家被告知此处已经撤柜了。当时也找红星美凯龙登记过信息了。现在商家又恢复营业了，销售人员说可以退货，但是需要市民承担费用，对此市民不认可。诉求：要求全额退款。', '工单类别': '一般', '处理描述': '经联系，投诉人表示已与被诉单位自行和解，故不予受理。相关情况已告知投诉人。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商信息', '四级分类': '商品销售信息', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704260668-462645', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018492, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 50, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多运费险问题。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704260971-2498280', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018352, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 51, 43), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其随申办是使用香港居住证注册的，市民的企业营业执照登记使用的是市民的港澳通行证，现在登录企业端一网通办无法匹配个人信息，咨询：其个人账户是否可以改为港澳通行证注册，怎样操作。 ', '工单类别': '一般', '处理描述': '您通过12345热线反馈的问题我们已经收悉。建议您先将原有账户进行账户注销后再使用新的证照类型进行注册。请您在随申办APP中操作。请您进入“我的”频道—设置（点击右上角齿轮状图形）—安全中心—注销账户中提交申请。提交申请后请您退出目前的账户登录并耐心等待1-2个工作日，我们会尽快完成审核。感谢您对随申办APP的支持！', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '网站使用', '主办单位': '上海市大数据中心', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704260813-672607', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103017692, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 52, 15), '诉求地址': '普陀区礼尚路88弄32号', '诉求区域': '普陀区', '内容描述': '市民来电反映:市民在上述地址高尚领域精致萌宠汇宠物店，订购一只美卡宠物狗，支付5000元订金，店主承诺2024年元旦左右把狗寄给市民，2023年12月30日下午店主联系市民，称狗生病了，让市民又加付5000元换狗，实际是把狗卖给别人了，店主宋雨，电话17172198888，诉求：希望管理部门核实，对商家不正当经营进行查处（市民要求信息保密 需回复）。', '工单类别': '一般', '处理描述': '经2024.1.8电话联系，被诉人已退费5000元，另投诉人表示不需要投诉人联系调解，根据《市场监督管理投诉举报处理暂行办法》第二十一条第（三）项规定，我局终止调解。根据目前证据材料，涉及不正当经营未查实，不予立案。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704260125-462211', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018622, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 53, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:建国东路525号的电话。', '工单类别': '一般', '处理描述': '告知市民尝试联系51528500，市民认可，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261135-2756150', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018742, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 54, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261217-672947', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018062, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 56, 20), '诉求地址': '闵行区', '诉求区域': '闵行区', '内容描述': '【为企服务】市民来电咨询:其企业在一网通办上办理营业执照变更，提交后提示已提交成功，评分号XXX，咨询后续还需办理什么手续。', '工单类别': '一般', '处理描述': '转接为企服务专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704261208-2498471', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018812, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 56, 36), '诉求地址': '宝山区聚丰园路  山姆超市', '诉求区域': '宝山区', '内容描述': '市民来电咨询工单信息【最近派发的工单编号：20240102007823，工单内容：市民来电反映: 市民于2023年上半年在上述地址购买了一瓶蚝油,市民于12月31日开瓶的时候瓶口的玻璃断裂导致市民的右手划破被缝了九针,诉求: 希望管理部门核实协调该商家给到市民合理的解决方案.(需回复)】', '工单类别': '一般', '处理描述': '告知情况，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261298-2498533', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018652, '工号': 2890, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 56, 53), '诉求地址': '青浦区（中山医院青浦分院）', '诉求区域': '青浦区', '内容描述': '市民来电反映:2024年1月3日下午其去上述地址看病，医院门诊二楼办公室不让其挂号，不给看病，领导叫顾凤燕，请管理部门核实给个说法。', '工单类别': '一般', '处理描述': '经我委调查核实，该市民反映情况不属实，诉求过高。市民因呼吸道疾病至我院要求就诊，但呼吸科已无现场号源，在门诊预检台吵闹后至门诊办公室要求看病，门办接待工作人员顾凤燕正在接待处理其他患者，市民三番四次要求插队处理，顾凤燕要求市民排队等候处理，无态度差、不予处理等情况，但市民依旧不依不饶，大吵大闹，报警并拨打12345市民热线，后将门诊办公室接待处桌上的东西扔向顾凤燕，后警方出警将市民带至派出所处理。警方询问顾凤燕是否需要市民向其当面道歉，顾凤燕担心市民再次做出过激行为故不要求市民向其当面道歉。 市民对回复未评价。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '排队挂号', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261152-672893', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103016072, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 57, 13), '诉求地址': '奉贤区', '诉求区域': '奉贤区', '内容描述': '市民来电咨询:其（公司名称：上海天禾百茂咨询管理有限公司）在一网通办上使用法人一证通证书登陆办理股权变更手续，但到人脸识别操作时无法弹出人脸识别二维码进行人脸识别操作，已重启系统后还是如此。诉求：要求管理部门核实给予解决方案。', '工单类别': '一般', '处理描述': '已电话联系市民，市民反映问题已解决。', '客户类型': '企业', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '网站使用', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704260997-2756023', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018912, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 59, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:公司和公司之间的服务纠纷需要向哪里反映', '工单类别': '一般', '处理描述': '转接不成功，建议联系12348', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261467-2756435', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019022, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 3, 13, 59, 49), '诉求地址': '浦东新区景雅路135号（上海琢境生态景观设计工程有限公司）', '诉求区域': '浦东新区', '内容描述': '市民来电咨询处理进度。【最近派发的工单编号：20231228032819，工单内容：市民来电反映:上述地址公司拖欠其在浦东新区国展路白莲泾路中电科建筑工地的工资，施工单位：上海琢境生态景观设计工程有限公司，签署劳动合同，拖欠人数：8人，拖欠金额：13万元左右，诉求：管理部门核实帮助讨要欠薪。（需要回复）】\t', '工单类别': '一般', '处理描述': '已解释，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '建筑工程欠薪', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261029-462942', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018772, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 0, 17), '诉求地址': '黄浦区南京东路派出所', '诉求区域': '黄浦区', '内容描述': '市民来电反映:其2024年1月4日在新闸路上行驶，被高空坠物砸到了车辆，之后至南京东路派出所报案处理，警察让其等着，市民一等几个小时，最后称找不到人让市民走单车事故走保险，市民表示不认可，称派出所警察相当不专业，一直让市民等着，也不让其走也不处理，故来电投诉，要求给其一个合理解释。（需回复）', '工单类别': '一般', '处理描述': '经核实，1月4日，陈先生在驾驶车辆时，被石块砸中，其报警，交警到场因无法确认单车事故，建议其至我所备案求助。我所民警朱逸风（警号017944）接待其，帮助市民调阅路面监控，但无法确认是否人为坠物。当天因调阅视频、走访需要时间，也向陈先生进行了解释说明。后经过调查无法确定该石块是否系人为故意抛掷或其他原因造成，故后续由我所民警李智圣（警号015397）为陈先生接报并开具接报回执单，并建议其通过保险理赔。1月18日，我所答复来电市民，告知其调阅路面监控以及走访需要花费较多人力、时间，当日也确实陈先生在所时间较长，但不存在不作为的情况，当日确实需要市民耐心等待。其表示明白，对我所答复表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261266-2756263', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019202, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 1, 41), '诉求地址': '金山区博海路118弄3号楼', '诉求区域': '金山区', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231230007827，工单内容：市民来电反映:上述地址12月30号11:45分前，右边电梯有烟味，市民有跟物业反映，市民表示可以查看监控。诉求:希望管理部门核实整治小区电梯吸烟问题。（市民要求信息保密，需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231230007827，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '禁烟控烟', '四级分类': '禁烟控烟', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261573-2756532', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018852, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 6, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民重复来电反复催单，要求尽快处理答复。【最近派发的工单编号：20231229002082，工单内容：市民来电反映:其于12月份委托顺丰快递寄送快递（收件地：上海），快递单号:SF1658782445385，但一直未送达，联系客服一直没有处理（7天内,不愿意等候），诉求：管理部门核实情况，督促快递公司找到快递并尽快寄送。（需要回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231229002082，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261904-2499059', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019502, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 7, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转拼多多。\t', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261968-2499115', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019462, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 7, 28), '诉求地址': '浦东新区华夏二路400号', '诉求区域': '浦东新区', '内容描述': '市民来电反映:【重新交办,要求：按答复要点告知市民,市民表示答复要点不符，市民称问题并没有解决，而且也没有人电话回复市民，没有按照流程处理，要求电话回复说明。最近办结的工单编号:20231205004293，工单内容:【投诉】市民来电反映: 其说管理部门第一次联系的时候还说会处理该问题的，但是之后又回复不属于职责范围，第二次反映要求明确告知由哪个部门负责也没有告知，认为根本不想处理问题，诉求：投诉管理部门工作不作为，推脱责任，如果不属于职责范围应该告知属于哪个部门监管处理。（市民要求信息保密 需回复）前工单编号：20231106007835】', '工单类别': '一般', '处理描述': '归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '诉求未解决', '主办单位': '无线电管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261932-673494', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103018672, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 7, 32), '诉求地址': '浦东新区曹路镇龚华路396号 禾木理发店', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其在上述理发店充值1000元办了会员卡，随卡附赠一张烫染券，初次使用时，被告知系统问题该券无法录入，先从卡内扣除相关费用，待系统修复后再抵扣返还，但实际后续并未如此操作。第二次，当事人继续到店消费，希望能再用这张券，被告知这张券只能减免部分费用，无法直接兑换服务，其对此十分不满，请管理部门协助维权。', '工单类别': '一般', '处理描述': '经双方同意通过浦东新区消调委进行人民调解，根据《市场监督管理投诉举报处理暂行办法》第十五条第（二）项之规定，我局不予受理。目前投诉正在人民调解中。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261603-673230', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019652, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 8, 40), '诉求地址': '宝山区松兰路507弄', '诉求区域': '宝山区', '内容描述': '市民反映：润杨名邸小区多处高层住户在空调机位安装晾衣架或者搭建围栏违规晾衣，物业对此行为也不管理。诉求：请管理部门整治空调机位乱搭建及乱晾晒问题。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '杨行镇城运中心于2024年1月3日收到区12345热线派遣的工单，派发给润杨名邸。现润杨名邸具体答复如下：2024年1月5日上午8:30，杨行镇润杨名邸居委会（筹）接单，之后居委工作人员与物业联系沟通问清情况.物业负责人表示，在业主入住时都告知入住装修时不准违反几项规定和要求，并且都签字确认。在业主装修验房时，检查外立面装置衣袈，防盗窗，花架。都在验房范围之内。有些业主等退回装修押金后，再进行安装，类似比较多。我们在日常巡查中，如发现有类似。我们立即上门劝导，并要求整改。有些业主还是比较配合，但是有些业主，见我们上门故意门不开。这样情况比较多，对于这样情况我们再做思想工作，继续加大力度整...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '宝山区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019872, '工号': 4390, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 9, 18), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无明确诉求', '工单类别': '一般', '处理描述': '无明确诉求，故归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704260729-462697', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019742, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 11, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:企业社保费管理客服端密码重置需要找哪里。', '工单类别': '一般', '处理描述': '告知市民尝试联系12345-4，市民认可，故归档。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262179-463932', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019552, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 11, 48), '诉求地址': '长宁区愚园路1293弄7号1楼', '诉求区域': '长宁区', '内容描述': '市民来电反映:上述地址市民家厨房水槽下面管道漏水，市民表示是房屋改造时，政府统一安装的水槽，诉求：希望管理部门核实，尽快安排维修（需回复）。', '工单类别': '一般', '处理描述': '华阳路街道于2024年1月3日接单，于1月3日14:38已电话先行联系来电人，告知问题已收悉；华阳社区管理办于2024年1月3日16:06:45接单，1月3日16:08电话联系来电人，来电人表示物业已上门来过，水槽管道修复完毕，表示满意。经办人：唐如骏', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262036-2756923', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103020112, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 11, 58), '诉求地址': '无', '诉求区域': '本市', '内容描述': '重复来电', '工单类别': '一般', '处理描述': '重复来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704261950-463697', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019912, '工号': 2322, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 13, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262319-673832', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103007832, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 13, 22), '诉求地址': '无', '诉求区域': '本市', '内容描述': '疑难人员来电反映疑难问题。', '工单类别': '一般', '处理描述': '归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262328-464080', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019822, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 13, 39), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:本市户籍在外省市就读大学的学生是否可以在本市缴纳医保。', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262261-2499408', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019712, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 13, 51), '诉求地址': '长宁区市场监督管理局', '诉求区域': '长宁区', '内容描述': '【投诉】市民来电反映:投诉长宁区市场监管局不作为，袒护拼多多，纵容平台欺诈消费者，办公电话62308551打不通，态度非常敷衍，不让市民说话，市民已经上传到各大平台，并已经找记者曝光，诉求：望管理部门核实并尽快予以处理。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '我局天山所于2024年1月4日接单，于1月9日14点28分与诉求人先行联系并答复。经核实，在与诉求人沟通过程中，未发现工作人员存在态度不当的情形。关于号码〔62308551〕的问题，已建议错开高峰重新拨打。关于诉求人提出的问题，我局工作人员已经与诉求人进行联系并解释说明。〔相关消费纠纷需其在全国12315平台自行登记投诉或举报〕。 经办单位：天山所。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262158-673702', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019782, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 14), '诉求地址': '浦东新区芳华路713弄1号和8号', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址小区绿化带内长期存在堆放杂物的问题，尤其是1号和8号最为严重，之前物业也处理过，希望管理部门核实处理该问题（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '收到反映后物业与居委工作人员到小区1、8号绿化带查看，并未发现所述堆放杂物情况，经了解，23年年底物业已对小区绿化进行了多次整治，后续还将跟居委进行绿化环境整治，市民称绿化带内长期存在堆放杂物，尤其是1号和8号最为严重情况不属实。（先行1.8 11:23、13:30、14:50未接）', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262240-673766', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019842, '工号': 4300, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 14, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:租房合同问题，转接专席', '工单类别': '一般', '处理描述': '转接法律专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '合同纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262282-2499423', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019962, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 14, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:社保卡遗失，需要挂失新版社保卡', '工单类别': '一般', '处理描述': '转接社保卡中心成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262403-673902', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019562, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 16, 16), '诉求地址': '杨浦区司法局', '诉求区域': '杨浦区', '内容描述': '市民来电对办理结果不满,市民表示接到杨浦区司法局的回复，市民认为是属于临时拼凑的敷衍的没有依法处理的答复。希望管理部门再次核实处理。【最近派发的工单编号:20231229019626，工单内容:市民来电反映:市民表示此前按司法局要求填写投诉律师事宜，受理回执表明9月19日受理(30天期限），11月11日回函告知延期30天，至今没有答复，致电司法局告知受理老师在外开会，年后继续受理。受理通知书：沪杨司律投字2029（49号）；市民对于联系工作人员态度不认可询问工号等拒绝告知。诉求：投诉杨浦区司法局不作为，要求尽快秉公处理给予答复。（需回复）】', '工单类别': '一般', '处理描述': '市民对办理结果不满，已电子催单工单编号：20231229019626，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262060-673605', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019832, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 18), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:全市存在有物业公司是全国各地的物业公司在上海从事物业业务，市民感到不合理。诉求：要求只有上海物业公司可以经营上海物业业务。', '工单类别': '一般', '处理描述': '告知市民超出我处受理服务，建议向全国人大提建议，要求法律上予以约束，此单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262274-2757171', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103020062, '工号': 4080, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 18, 30), '诉求地址': '黄浦区淮海路街道', '诉求区域': '黄浦区', '内容描述': '市民来电咨询: 上述街道是否有“宝宝屋”服务。诉求：请管理部门告知市民。（需回复）\n\n', '工单类别': '一般', '处理描述': '对政策解释不接受。我单位1月3日接单，当日先联后将工单转交服务办处理。目前我街道范围内暂无宝宝屋的服务。已告知来电人可以关注我街道的公众号，如有相关的服务开始，公众号会有第一时间公布。来电人对该解释不接受。经办人：王振宇。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '社区家政', '四级分类': '社区服务网点', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262488-464215', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103020142, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 18, 31), '诉求地址': '松江区', '诉求区域': '松江区', '内容描述': '市民来电咨询:在单位做了五年多了，单位辞退市民，财务表示没有补偿的，故来电询问怎么维权', '工单类别': '一般', '处理描述': '根据：“ 松江区劳动人事争议仲裁院 ”', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '经济补偿', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262572-674059', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103020232, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 19, 33), '诉求地址': '崇明区', '诉求区域': '崇明区', '内容描述': '【为企服务】市民来电咨询:企业工商注销，咨询如何处理', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704262704-2499806', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103020082, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 20, 22), '诉求地址': '浦东新区航头镇航三路', '诉求区域': '浦东新区', '内容描述': '市民来电反映:2023年12月以来，浦东新区航头镇航三路龙华医院航头分院急诊每次只开2个窗口，一个小时只叫6-7个号。相同情况市民碰到了3次。诉求：特此投诉。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '医院接到工单后，相关部门了解情况，已致电市民，目前正值呼吸道疾病高发季节，患者高峰时期急诊内科视情况增加到三个诊室接诊。但目前医院人力资源紧张，增加诊室暂无法做到常态化，后期医院将加大医务人员招募，增派高年资医生进行急诊接诊，缩短急诊就诊等候时间。市民表示理解。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '服务态度', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262572-2757425', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019572, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 22, 10), '诉求地址': '浦东新区自贸区外高桥片区', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:其需要到现场查询企业登记档案信息，想了解相关机构的地址电话及所需材料。', '工单类别': '一般', '处理描述': '告知所需外高桥行政服务中心信息，归档。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262428-2499566', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103020372, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 22, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:办理了大学生医保，现在在中山医院，提示医保无法使用，诉求：查询一下医保状态。', '工单类别': '一般', '处理描述': '转接医保成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262824-464498', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103019792, '工号': 4282, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 23, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:如何按灵活就业参保事宜。', '工单类别': '一般', '处理描述': '根据《哪些人可以按灵活就业参保？以后养老待遇如何？来看解答》，市民认可，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '养老保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704262412-464155', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103020672, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 27, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:上海社保卡如何办理。', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '