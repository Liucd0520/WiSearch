etime(2024, 1, 6, 6, 55, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:咨询江阴市江阴大桥是否通畅', '工单类别': '一般', '处理描述': '告知向当地管理部门咨询，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '限流限行', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704495211-197723', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106000542, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 6, 7, 41, 12), '诉求地址': '松江区明华路1177弄1号102室', '诉求区域': '松江区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，市民表示其房内所有发霉墙面及3平方地板是由于物业的公共部分的排水泵坏了水罐到市民家里导致的，这个理应是由物业承担的，诉求:希望管理部门核实协调维修事宜.最近办结的工单编号:20231226013522,工单内容：重新交办，相关部门答复要点告知，与实际不相符，之前物业承诺让其出材料费500元，所有物业费已经支付好后，仅限维修进门口一个平方的地板，检测是三个平方，客厅门框发霉地方做维修，重新粉刷，其称自己家客厅、房间大面积的发霉，物业让其支付1万费用来维修，对此处理不满。诉求：希望相关部门核实，协调维修事宜。最近办结工单编号，工单内容：市民来电反映:...', '工单类别': '一般', '处理描述': '经物业主管吴女士13761205995 核实反馈，该处雨水倒灌发生于2020年，上海象屿物业管理有限公司于2021年进入该小区，物业与业主协商的是门口1平方地板及门框周围发霉墙面维修材料费500元，但业主现要物业维修房内所有发霉墙面及3平方地板，故材料费用7000-10000元，但业主不肯承担。根据上海市住宅物业管理规定第六十八条规定：物业维修、更新、改造和养护的费用，按照下列规定承担：（1）专有部分的所需费用，由拥有专有部分的业主承担。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704497547-197806', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106000712, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 6, 7, 54, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其需要为孩子办理医疗报销，需要通过随申办查看电子票据，电子病历显示在2022年1月11日找不到发票，目前报销2年内有效其只有4天的时间了，其通过随申办查询医疗票据，需要查询孩子的医疗票据无法查询到，使用其他手机查询提示未满14周岁需要监护人验证，其输入孩子信息以后告知孩子的身份证已有实名账号，但是其不知道孩子的账户信息，姓名：夏牧云，身份证号码：310103201104065019.诉求：希望管理部门帮助核实告知其孩子的随申办账户信息，告知孩子的用户名密码信息，方便其在随申办查询孩子的医疗票据，希望管理部门务必在1月6日上午给予回复。（需回复）', '工单类别': '一般', '处理描述': '您好，您通过12345反馈的问题我们已收悉，经核实，您已实名认证成功，关联手机15221604060，忘记账户请点击登录框下方“忘记密码”字样-其他用户忘记密码入口-手机号码找回进行操作。若无法自行找回，请您发送本人与有效证件合照至客服邮箱eshimin@mail.sh.cn，提交已注册的手机号码及诉求，我们会尽快核实处理（不支持国外手机号码找回），感谢您对随申办APP的支持！<br>', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '网站使用', '主办单位': '上海市大数据中心', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704498066-197835', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106000812, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 6, 7, 59, 12), '诉求地址': '浦东新区航梅路（航三路南面）', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址的航梅路上有大量的无证设摊，大部分都是用三轮车把机动车道占领，数量在10个以上，都是卖早饭、卖其他吃的等等。出现时间6:00-18:00。城管看见都不管。诉求：希望管理部门核实后对该处无证设摊取缔整治。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '接单后，航头城管中队执法人员分别于1月7日08:37、8日10:16、10日14:28到现场查看，都没有在航梅路发现乱设摊现象。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704498842-197904', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106000842, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 0, 7), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:咨询外环外是否能放烟花烟花', '工单类别': '一般', '处理描述': '根据《上海市烟花爆竹安全管理条例 》告知，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '消防管理', '四级分类': '烟花爆竹管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704498934-931526', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001122, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 7, 33), '诉求地址': '静安区北宝兴路10弄11号', '诉求区域': '静安区', '内容描述': '市民反映：上述地址加梯逾期323天，乙方严重违约，业委会没有履行职责。诉求：要求业委会没有履职。', '工单类别': '一般', '处理描述': '【共和新路街道】共和新路街道于2024年1月8日接单，并于1月8日首次通过电话先行联系市民告知问题收悉，正在处理。街道热线将市民诉求告知唐家沙居委会，唐家沙居委会告知诉求人已核实其反映的情况。经了解，业委会只是代加梯楼栋盖章，以及处理后续水管电线移为对公盖章。签订合同的是11号楼三人小组，三人小组按合同约定设立账户，保管资金，按照工期分批支付费用，没有不履职的情况。街道热线于1月15日联系诉求人说明，诉求人表示知晓。处理人：姚磊卿 责任人：陈骋 56388378', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '业委会', '主办单位': '静安区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001152, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 9, 7), '诉求地址': '青浦区重固镇福定路和福泉山路交叉口', '诉求区域': '青浦区', '内容描述': '市民反映：福泉山路和福鼎路交叉口的两个三角地，靠近万科住宅区一期和二期的那一侧，原来有两个三角地种着腊梅，是小区最美的风景，是小区交房的时候开发商种植的，但是在本次福定路路旁换树的同时，莫名其妙就直接移走了，市民表示对此不满（详见附件）。诉求：投诉私自移除腊梅，要求解释原因。', '工单类别': '一般', '处理描述': '【此工单诉求内容不属实】重固镇城运中心于2024年1月6号接单，于2024年1月6号首次通过电话先行联系诉求人，告知诉求已收悉，正在我单位办理。2024年1月12日由我单位对诉求人反映的情况进行了核实，确认该诉求人诉求事项，情况不属实。经核实，该处福定路正在美丽街区项目施工过程中，对枯死及生长歪曲的树木进行移除，按照树木间距制定方案进行树木补种，并将原有梅花树在工程结束前移植回来。已将处置结果告知来电人，诉求人对此处理结果未评价。该问题已解释说明，经办人：吴韵聪。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '绿地绿化', '四级分类': '移植修剪', '主办单位': '青浦区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106000942, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 10, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231225003844，工单内容：重新交办，要求：答复要点与实际情况不符，管理部门依旧没有联系市民。诉求：要求管理部门联系市民给予解释。工单内容：【投诉】市民来电反映:管理部门重来没有联系过其，已经反映多次了，工单编号：20231115002029，不作为，诉求：管理部门为何不打电话给其，不处理。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231225003844，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '诉求未解决', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704499491-3019829', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001422, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 14, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其为小孩申请了社保卡，但卡尚未拿到。市民咨询卡号信息。', '工单类别': '一般', '处理描述': '根据《 持卡人如何获得社会保障卡卡号等信息？ 》告知市民，此单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001402, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 15, 3), '诉求地址': '普陀区旬阳路115弄苏河望', '诉求区域': '普陀区', '内容描述': '市民反映：2021年12月底购买了普陀区旬阳路115弄苏河望新房，在2月与农业银行签订了贷款合同，2月底农业银行发放贷款，3月开始还贷款。但是其购买的5栋楼于2022年8月主体才封顶，农业银行涉嫌违规放款，市民认为原本的贷款合同无效。诉求：要求重新签订贷款合同并按照最新的房贷利率执行。', '工单类别': '一般', '处理描述': '我国金融业实行垂直管理和分业监管体制，银行业保险业由国家金融监督管理总局监管，在上海设有派出机构为国家金融监督管理总局上海监管局，与地方政府没有隶属关系，建议您拨打全国银行保险消费者投诉维权热线12378进行反映，该热线接听时间为工作日9:00—17:00。您也可以通过信件或者上访的形式向国家金融监督管理总局上海监管局反映，地址是浦东新区合欢路35号，邮编200135，信访接待时间为工作日每周一、三、五（上午9:30-11:30、下午13:30-16:30），或拨打国家金融监督管理总局上海监管局信访咨询电话38650160（工作日上午9:30-11:30、下午13:30-16:30）', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '金融', '四级分类': '银行监管', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001182, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 20, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要激活社保卡', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704500370-2238397', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001192, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 23, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:给小孩申请社保卡。', '工单类别': '一般', '处理描述': '热词 社保卡', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704500414-198153', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001272, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 24, 8), '诉求地址': '长宁区娄山关路533号2902-2913室，上海寻梦信息技术有限公司', '诉求区域': '长宁区', '内容描述': '市民来电反映:个人消费问题，要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704500439-2238420', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001282, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 29, 34), '诉求地址': '崇明区安振路88弄90号楼402室', '诉求区域': '崇明区', '内容描述': '市民来电反映:上述地址居民家里正在装修，现2024年1月6日8:00多开始使用电钻，产生严重噪音，影响居民休息。市民表示该问题之前通过12345热线反映过，但现又出现了。诉求：希望管理部门核实制止噪音扰民行为，要求双休日不要装修。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '村建所-经核实，该户简装修早已结束，产生的建筑垃圾也清理完毕。今后物业会加强巡逻管理，把噪音扰民问题尽量减小到最低程度。因市民未留存电话，故无法与其联系。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '崇明区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704500726-198219', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001502, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 33, 40), '诉求地址': '奉贤区金汇镇亚通汇雅苑', '诉求区域': '奉贤区', '内容描述': '市民来电反映:上述地址小区周围有无证设摊，并使用电喇叭吆喝，存在噪音扰民。诉求：希望管理部门核实取缔无证设摊。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '区城管执法局于2024年1月7日接单，诉求人为匿名举报无法先行联系。经调查，大居城管中队安排队员巡查对亚通汇雅苑小区周边，发现有当地老人在卖菜乱设摊，已经及时宣传教育劝离，目前该处乱设摊已经好转，多次巡查过程中未发现有电喇叭吆喝声音，询问周边群众得知，可能是收购废品车经过的声音，中队将继续安排队员加强该处的巡查频次，发现乱设摊问题及时处置。（现场图见附件），办理人：钱萍，朱凯飞 18116480540。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '奉贤区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704500980-2238563', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001792, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 34, 41), '诉求地址': '徐汇区天平路原真丝商厦门口马路', '诉求区域': '徐汇区', '内容描述': '市民反映：1月6日上午8：00，挖掘机对天平路原真丝商厦门口地面开挖，市民居住在真丝商厦对面的老房子内，市民从挖掘机开过来时被压迫地面形成的震动，造成房屋明显晃动而惊醒，挖掘机开挖过程中，房子不停震动，影响房屋稳定。市民表示对于近百年的老房子经不起这样的折腾。市民认为天平路不应随意开挖，走工程车以及其他大型车，重型车。诉求：希望管理部门核实，协调解决施工破坏房屋稳定问题。', '工单类别': '一般', '处理描述': '一、我委于2024年1月8日11点32分先行联系市民，告知已接单，处理后会给与答复。二、经现场核实，该处未进行架空线施工，因道路开挖存在工作井，为便于车辆通行，在地面铺设了钢板，后续待施工许可下发后，继续施工，完成后将撤除钢板。三、我委于2024年1月11日9点54分电话反馈市民，市民表示知晓。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '旧房改造', '四级分类': '房屋老化', '主办单位': '徐汇区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001542, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 36, 16), '诉求地址': '嘉定区裕民路1180弄43号401室 ', '诉求区域': '嘉定区', '内容描述': '市民来电反映: 上述地址居民于1月6日早上8:00开始装修噪音扰民，诉求: 希望管理部门核实协调让其周末不要装修. （市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '嘉定工业区：2024年1月8日16:28先行联系。根据上海市社会生活噪声污染防治办法(沪府令94号)第十二条（装修噪声污染防治）每日18时至次日8时以及法定节假日（不含双休日）全天，不得在已交付使用的住宅楼内进行产生噪声的装修作业。接单后，物业已上门告知该处居民装修规定，该户表示知晓。工业区2024年1月10日—1月14日现场查看，未见违规装修，后续会持续关注。工业区2024年1月16日14:52回访。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704501134-198316', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001772, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 37, 58), '诉求地址': '浦东新区东方体育中心', '诉求区域': '浦东新区', '内容描述': '【投诉】市民反映：前工单管理部门一个电话都没有回，就办结了。经系统查询也是回复得牛头不对马嘴，诉求：投诉管理部门的不作为，敷衍了事。（相关工单编号：20231216012072）', '工单类别': '一般', '处理描述': '2024/1/9 19:02 已联系市民，市民咨询问题已为市民解答。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '投诉批评', '四级分类': '服务态度', '主办单位': '市文化旅游局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001632, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 44, 26), '诉求地址': '长宁区水城路450弄18号', '诉求区域': '长宁区', '内容描述': '市民来电反映:上述地址在加装电梯，1月6日周末7:00就开始施工，已经好几次了，噪音扰民严重。诉求：希望核实并让其整改。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '仙霞新村街道于2024年 1月 6日接单，于当日9点10 15分、9点24分先行联系诉求人，均未接通。仙逸居委接单后先行联系来电人，随后对来电人反映的情况进行核实，经查该案件情况属实，仙逸居委工作人员马上到投诉地址查看并马上对施工人员进行劝阻，然后与加梯施工队负责人进行沟通，希望施工队周末早上不要太早施工，施工队负责人答应周末以后晚点施工，尽可能减少对居民的影响。该问题已解释说明，来电人已知晓。经办人：仙逸居委会。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704501456-3020271', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001852, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 44, 55), '诉求地址': '徐汇区裕德路66弄', '诉求区域': '徐汇区', '内容描述': '市民来电补充信息。市民补充信息内容为实际不是小区里面是小区旁边的那条街施工。诉求：请管理部门尽快处理。【最近派发的工单编号：20240106001285，工单内容：市民来电反映:1月6日上述地址小区早上8点开始进行道路施工，噪音扰民影响居民的休息，诉求：投诉施工噪音扰民（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240106001285，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704501666-198473', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001872, '工号': 2940, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 48, 47), '诉求地址': '长宁区金钟路968号 上海携程国际旅行社有限公司', '诉求区域': '长宁区', '内容描述': '市民来电反映:其在携程APP叫车，订单号：27960856860，27960858959，28225748055，28225749138，下单后秒取消。每次平台都扣其20元。总计80元。诉求：请管理部门退回费用。（需回复）', '工单类别': '一般', '处理描述': '经联系，投诉人确认已解决。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '旅游', '三级分类': '服务质量', '四级分类': '旅行社服务', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704501816-3020394', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106001942, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 50, 49), '诉求地址': '黄浦区仁济医院', '诉求区域': '黄浦区', '内容描述': '市民来电反映:上述地址医院出口和入口在不同地点，距离较远，市民因为腿脚不便如果要去出口需要绕行很长距离，诉求：希望医院针对行动不便人员在入口处可以开放绿色通道方便出行', '工单类别': '一般', '处理描述': '我中心于2024年1月6日与来电人取得联系，市民表示事情已经解决，故此单办结。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '卫生信息', '四级分类': '医院医疗信息', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704501997-3020457', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002072, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 50, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:杨浦区殷行街道社区事务受理中心联系方式。', '工单类别': '一般', '处理描述': '根据《杨浦区殷行街道社区事务受理中心》，认可，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '便民信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502114-198631', '工单类型': '咨询类', '新一级分类': None, '新二级分类': 