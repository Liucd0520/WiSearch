CREATE TABLE `AI_ASK_TEST` (
	`TEMP_CODE` VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '工时项目编号', 
	`PROJECT_NAME` VARCHAR(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '项目名称', 
	`PROJECT_TYPE` VARCHAR(6) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '项目分类', 
	`QPSYJ` VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '前评审编号', 
	`MANAGER_ID` VARCHAR(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '项目经理id', 
	`MAXWORKHOURS` VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '项目最大填写工时', 
	`START_TIME` VARCHAR(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '项目开始日期', 
	`END_TIME` VARCHAR(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '项目结束日期', 
	`DEPT` VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '项目所属部门', 
	`PROJECTWORKHOURS` BIGINT COMMENT '项目总工时', 
	`SRS` BIGINT COMMENT '项目收入', 
	`CBS` BIGINT COMMENT '项目成本', 
	`CCB` BIGINT COMMENT '项目产出比', 
	`MEMBER_ID` VARCHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '人员id', 
	`MEMBER_IN_TIME` DATE COMMENT '人员进入项目时间', 
	`NAME` VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '人员姓名', 
	`STAFF_POST` VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '人员岗位', 
	`PROJECTMEMBERWORKHOURS` BIGINT COMMENT '项目中人员总工时', 
	`MEMBERHOURS` BIGINT COMMENT '人员总工时'
)ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 ROW_FORMAT=DYNAMIC COLLATE utf8mb4_0900_ai_ci

