复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240102011939，工单内容：【投诉】市民来电反映:其是一位上了年纪的老人，市民称其爱人1月2日早上出去之后一直没回来，联系派出所，派出所不管，市民称封浜派出所不作为，之前派出所还殴打市民，楼上进行非法加工，已经长达16年，向封浜派出所反映，也不管不问，市民对此表示不满，诉求：投诉派出所不作为，请管理部门核实处理。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240102011939，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167523-335513', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013412, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 2, 11, 55, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167669-335605', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013042, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 2, 11, 55, 36), '诉求地址': '松江区泖港镇', '诉求区域': '松江区', '内容描述': '【重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符，不符内容：市民需要管理部门再次回复告知市民。诉求：希望管理部门再次处理。最近办结的工单编号：20231126009534，工单内容：市民来电反映:其当时当兵迁出户口，之后退伍后落户了水务局的集体户口，在泖港镇内房屋也是其一个人的名字，户口能否迁回，诉求：希望管理部门告知。】', '工单类别': '一般', '处理描述': '市公安局松江分局泖港派出所于2024年1月3日9时49分许电话联系到张先生。现答复如下：张先生反映其早年当兵退伍后户口落在水务局集体户，在泖港的房子证件上有其名字，询问是否可以迁回。民警与诉求人先行联系时其表述泖港的房子有《城乡宅基地使用证》，且证上的户主姓名是其本人，房屋也没有买卖和抵押。就其所诉情况，民警告知其可持本人的户口簿、身份证和宅基地使用证至派出所户籍窗口申请。诉求人表示知晓，同时表示其咨询的问题无需民警后续再答复。解释答复后，市民表示满意。经征得市民同意，先行联系和答复一并回复市民，后续不再致电市民。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '户籍政策咨询', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167205-2626925', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013272, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 2, 11, 56, 34), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:自己有一辆黄牌货车，现在要把信息添加到12123APP上，问到哪里办理手续。', '工单类别': '一般', '处理描述': '市公安局车辆管理所综合科张逸凡于2024年01月03日15时12分来电市民王磊联系，告知来电人交管12123APP绑定单位名下机动车的，只可绑定非营运性小型客车。工号：17。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167475-591124', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013432, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 2, 11, 57, 18), '诉求地址': '本市', '诉求区域': '本市', '内容描述': ' 市民来电查询进度。【最近派发工单编号：20231222025161，内容：市民来电反映:其于2023年9月30日在上海携程商务有限公司订购去泰国的旅游团。订购的时候系统自动弹出其的护照信息。其的护照其实已经过期但系统没有提醒。12月7日去机场发现其的护照过期导致没有去成。诉求：投诉携程系统没有尽到提醒护照过期的义务。】', '工单类别': '一般', '处理描述': '已解释，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '旅游', '三级分类': '服务质量', '四级分类': '旅行社服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167677-335608', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013472, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 2, 11, 57, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民要办理驾驶证有效期满换证，车管所中午是否对外接待。', '工单类别': '一般', '处理描述': '为市民转接车管所专席，转接成功，此单归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '驾驶员审验', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167701-591273', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013322, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 2, 11, 58, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其孩子非本市户籍人员，居住证积分未满120分，咨询是否可以在本市初中进行中考。诉求：希望管理部门核实，并告知市民是否可以中考', '工单类别': '一般', '处理描述': '同意办结。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '招生考试', '四级分类': '中考', '主办单位': '市教育委员会', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167533-2369226', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013512, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 11, 58, 45), '诉求地址': '奉贤区连城一号', '诉求区域': '奉贤区', '内容描述': '市民来电咨询: 上述地址是公寓性质的，诉求:咨询监管物业的上级管理部门的联系方式。', '工单类别': '一般', '处理描述': '西渡街道于2024年1月3日接单，于2024年1月3日14:26先行联系了反映人，该案件正在我单位进行办理。1月3日15：00由西渡街道城建中心对来电人所反映的情况进行核实。经核实，连城属于商住房，反映人要求空房物业费打七折，目前暂无相关政策，您可向奉巢物业公司协商，也可以拨打电话：61909199转0具体咨询。已经将处置结果告知来电人，经办人：戴伟', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '奉贤区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167757-335668', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013532, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 2, 11, 59, 17), '诉求地址': '本市抖音商城', '诉求区域': '本市', '内容描述': '咨询处理进程【最近派发工单编号：20231215030968，工单内容：市民来电反映：其在抖音商城购买茶叶（订单号：6924042381477353445、6924050847225026533、6923919271364794341、9623886059200255973、6923896854680180709、6923886119605704677、6923888292856993765、6923881721068066789、6923808956305971173、6923808970622769125、6923828708409546725），在茶叶中发现头发，向商家反映，商家不...', '工单类别': '一般', '处理描述': '已解释，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167784-2627359', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013622, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 2, 11, 59, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档 拼多多', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167928-591423', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013572, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 0, 56), '诉求地址': '徐汇区宜州路189号', '诉求区域': '徐汇区', '内容描述': '市民来电咨询:所属派出所信息。', '工单类别': '一般', '处理描述': '根据《 徐汇区虹梅街道派出所 》告知，市民知晓，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '公安信息查询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167872-335727', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013612, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 2, 13), '诉求地址': '杨浦区佳木斯路205弄15号', '诉求区域': '杨浦区', '内容描述': '市民来电反映:上述地址一对安徽籍夫妻开了三桌麻将，没有营业执照，诉求: 请管理部门尽快取缔。（市民要求信息保密 无需回复） ', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派长海路街道、区公安分局进行处理，据长海路街道回复：先行联系：来电人未留电话无法先联 情况核实：部分属实 处置过程及回访：居委会主任和块长立即上门核对情况，只有一个自动麻将桌，现场无人打牌。1月4号居委与民警再次上门，现场没有人在打牌，民警告知不能开家庭棋牌室也不能赌博，违者后果自负。后续居委会跟进。据区公安分局回复：民警实地检查，未发现15号有麻将桌及赌博情况，实际系13号有一个麻将桌。民警走访时无赌博情况，只有租客在。民警已对租客进行了法律告知，之后将不定期对该处进行检查，如发现赌博情况将严肃处理。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '居改非', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167915-2369475', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013742, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 2, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是企业需要公积金汇缴但是一直缴纳不进去，其要咨询是什么问题', '工单类别': '一般', '处理描述': '转接公积金成功,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704168025-2627513', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013592, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 5, 39), '诉求地址': '闵行区莘庄镇 盒马绚荟城店', '诉求区域': '闵行区', '内容描述': '市民来电反映:市民通过盒马下单，发现由盒马绚荟城店配送的，要额外收取１元包装费，是强制消费。据市民向上商家了解，对方的理由说是国家规定的。市民表示商家可提供非一次性袋子，市民收到后退回袋子。诉求：投诉强制消费。（需回复）', '工单类别': '一般', '处理描述': '通过上海盒马网络科技有限公司盒马APP下单，建议举报公司所在地浦东新区塘桥所。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704167870-335726', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102013712, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 12, 5, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民孩子没有缴纳2024年的城乡居民医保，来电咨询目前到医院看病还能否使用医保账户。', 