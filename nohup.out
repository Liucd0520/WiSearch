ne, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106008182, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 36, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:孩子目前因刚刚缴纳城乡居民医保，无法办理实体社保卡，来电咨询如何办理医保电子凭证。', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704511832-3025726', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106008122, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 39, 18), '诉求地址': '闵行区房地产交易中心税务窗口', '诉求区域': '闵行区', '内容描述': '市民来电反映: 市民四年前购房，当时该 窗口并未告知市民可以办理同住人，减少房产税，现在市民发现可以减免一部分税，诉求：要求知道窗口是否有义务告知，需要回复。', '工单类别': '一般', '处理描述': '经核实，该事项不属实。 经向市民电话核实情况，市民到大厅办理房产税缴税，纳税人认为缴税窗口没有尽到告知义务，没有告知纳税人他们可以享受的减免政策，窗口也没有放置政策宣传册之类的,纳税人主张税务机关因退回之前缴纳的税款。针对市民认为出件缴税窗口缺少政策宣传的问题，我们会将反映其意见，也告知纳税人缴税出件窗口不提供咨询服务，建议纳税人以后可以前往专门的咨询室进行咨询，或者在网上查看公开的政策文件。对于纳税人所述的退税要求，按照现行政策无法满足。 回复时间：2024年1月9日9时，市民表示：不满意。 ——国家税务总局上海市闵行区税务局', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '税收政策', '四级分类': '房产交易税', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704512139-937412', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106008542, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 40, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704512365-983061', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106008332, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 40, 54), '诉求地址': '普陀区', '诉求区域': '普陀区', '内容描述': '市民来电咨询:其收到短信居住证有效期自动续签成功，但是居住证卡面信息还没有去更新，其要办理居住证积分续签，是否需要先去变更居住证卡面信息才可以', '工单类别': '一般', '处理描述': '2024-01-07 09:37:56致电，关于您咨询的问题，告知您依据《上海市居住证积分管理办法》（沪府规（2022）21号） 第十九条（积分确认与调整） 在《居住证》签注时，对持证人积分予以确认。 持证人情况发生变化需要调整积分的，应当委托用人单位向注册地区人才服务中心提交相关材料。 持证人积分项目发生变化导致积分下降或出现减分项目的，人力资源社会保障部门对其积分进行扣减，并告知持证人。建议您可在居住证签注后通过单位申请居住证积分确认，您表示了解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '居住证', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704512042-3025842', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106008362, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 42, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:如何开通社保卡。', '工单类别': '一般', '处理描述': '转接社保卡忙线，根据《 社会保障卡领取后如何开通？ 》告知市民，市民认可，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704512109-203790', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106008512, '工号': 3440, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 43, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:德邦物流从石家庄发往大连，物品是红木家具，重量超过50公斤，发生破损，德邦只给1500元维修费，市民不认可，询问能否处理。', '工单类别': '一般', '处理描述': '《涉及邮政、快递、物流、即时配送业务的处理规则》', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704512322-937496', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106008902, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 43, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映：其通过韵达快递2023年11月2日寄送物品从上海到湛江（运单号：312243027301414）快递一直未收到，多次联系韵达公司未果。诉求：要求管理部门核实尽快处理。', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704508659-2242292', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106008692, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 6, 11, 45, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:陆家嘴，农民工干活受伤，老板不管，咨询