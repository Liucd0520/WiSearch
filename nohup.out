3098187', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004832, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 45, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 咨询上海落户，是哈尔滨工业大学研究生毕业，非应届毕业生。咨询居转户和人才引进落户。', '工单类别': '一般', '处理描述': '转接人力资源成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '就业创业', '四级分类': '人才引进', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704159651-2361723', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004612, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 45, 43), '诉求地址': '杨浦区市场监管局', '诉求区域': '杨浦区', '内容描述': '市民来电反映:12月6日办理股东变更，两个股东退出，到1月2日仍未办理成功，市民称去了十多次市场监管局，每次工作人员只告知1到2个问题，未一次性全部告知，导致市民反复办理。市民称1月2日10:30前未收到回复，要带记者去杨浦区市场监管局报道。诉求：投诉杨浦区市场监管不作为，要求1月2日10:30前回复。（需回复）', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派区市场监管局进行处理。据区市场监管局回复：先行联系：接单后，我局于2024年1月2日电话联系来电人。 情况核实：来电人反映的情况不属实。实际情况为市民提交企业变更登记申请，因材料不符合规定，我局工作人员一次性提出修改意见并退回，因市民未准确修改，故被多次退回。 处置过程及回访：我局已电话指导市民准确修改材料，市民已于1月2日重新提交申请并已于当日预审通过。', '客户类型': '企业', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704159408-538336', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005052, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 46, 34), '诉求地址': '奉贤区', '诉求区域': '奉贤区', '内容描述': '【为企服务】市民来电咨询:企业线上申请简易注销，线下需要携带哪些材料办理。', '工单类别': '一般', '处理描述': '转接奉贤区市场监管局成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704159853-2361905', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004562, '工号': 2100, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 49, 16), '诉求地址': '闵行区剑川路2613号', '诉求区域': '闵行区', '内容描述': '市民来电反映:闵行区剑川路2613号进门右手边第一栋里，其为装修工人，做临时工，没有合同，被拖欠11天工资，人数：2人，金额：9900元。诉求：帮助追讨工资。', '工单类别': '一般', '处理描述': '江川路街道管理办于1月2日与来电人先行联系，并对诉求信息进行确认。经核实，工资已发放，江川路街道管理办于1月5日将办结情况向来电人进行答复解释，市民表示满意。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '拖欠工资', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704159933-538759', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004902, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 49, 23), '诉求地址': '闵行区', '诉求区域': '闵行区', '内容描述': '市民来电反映:其身份证被重号，姓名：吴幼峰，身份证：310112196907140054，当其需要人脸识别的时候都无法识别，经核实大数据显示的是一个姓翟的住在北京的人脸。其去过闵行分局，一直没得到解决。诉求：希望管理部门核实，对此给予市民合理的解决方案', '工单类别': '一般', '处理描述': '华坪路派出所于2024年1月3日14:10与来电市民吴幼峰取得联系，具体答复内容如下：诉求人反映其身份证被重号，对此给予市民合理的解决方案。民警获悉该工单后与诉求人取得联系，诉求人无理乱骂要求赔偿损失。经查，2007年分局认定吴幼峰与翟成强属于跨省重号，根据公安部于2006年制定的《关于集中开展纠正公民身份证号码跨省重号工作的通知》（公治【2006】369号），该规定纠正重号的原则实行“谁编码、谁负责、谁纠正”，分为两种情形：“一是重号公民一方常住户口在编码地，另一方已迁往省外（自治区、直辖市）的，可以修改户口在本地的公民身份证号码；二是重号双方均迁往外省的，由原编码地公安机关协商迁入地...', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '身份证管理', '主办单位': '市公安局', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704159734-2361803', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005242, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 50, 51), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:急诊自费的费用如何报销。', '工单类别': '一般', '处理描述': '根据《如何办理医疗费用零星报销 》告知，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160054-328522', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005172, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 51, 27), '诉求地址': '普陀区兰溪路（曹杨路-花溪路）', '诉求区域': '普陀区', '内容描述': '【重复交办，答复要点与实际情况不符，市民来电反映:梅岭北路-曹杨路没有维修，已经有很多年，机动车在道上开车坑坑洼洼，诉求；希望进行修复。最近办结的工单编号：20230615008155，工单内容：市民来电反映:上述地址之前在修马路，修路后路面补的凹凸不平，诉求：希望管理部门核实在暑假期间能够铺平道路。】', '工单类别': '一般', '处理描述': '普陀区架空线入地指挥部于1月2日接单，1月2日15时20分先行联系并答复市民。兰溪路（曹杨路-梅岭北路）架空线入地和合杆整治工程还未正式完工，目前市北电力公司正在办理相关占掘路行政许可手续，计划近期施工。对于居民所反映的非机动车道路面坑洼不平，已通知施工单位加强巡查，发现隐患及时排除，待架空线入地项目管线单位全部施工完成后，道路施工单位会对整体道路进行铣刨加罩及人行道翻建工作。相关情况已与居民电话沟通告知，居民知晓。经办人：倪文52564588，附电话录音及现场照片。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': '道路养护', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160009-2362068', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005322, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 51, 35), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:一家单位，到2023年12月25日合同到期，单位不给其续签，能否有经济补偿。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '经济补偿', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160167-3098849', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005202, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 52, 57), '诉求地址': '浦东新区临港新区', '诉求区域': '浦东新区', '内容描述': '市民来电补充信息。市民补充信息内容为其表示有临港新片区的市场监管联系过市民表示在库里没有查询到该企业的申请，其现在想咨询浦东新区自由贸易区的市场监督管理是否可以取消该企业的迁移申请【最近派发的工单编号：20231227017223，工单内容：市民来电反映:  市民企业已经提交申请办理了注册地址迁移到临港新区。现在需要取消变更申请，希望告知如何操作。企业名称蔚点科技上海有限公司。】\n', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231227017223，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160014-328477', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005572, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 55, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 要求查询抖音客服电话。', '工单类别': '一般', '处理描述': '已告知市民未查询到相关信息，建议市民自行查询，市民认可，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '12345热线', '四级分类': '信息咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160419-3099086', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005222, '工号': 3940, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 55, 34), '诉求地址': '浦东新区南泉北路569号1楼 苏宁易购 ', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其1月份在上述地址购买了戴森空气净化器花费了5890元，5月份使用的，有内外两层滤网，商家表示内部滤网无需更换，外部滤网需要定期更换，但是使用了半年其表示内外滤网有异味，联系了戴森进行维修，但是无法100%去除异味，需要市民自行花费更换内外滤网，市民不认可，最后给到的结果是可以免费更换1次，但是其希望退货退款，因为异味无法彻底清除，联系苏宁表示可以退货，但是需要戴森开具无法维修的证明，但是戴森无法彻底维修好也不给开具。诉求：希望管理部门核实，帮助协调退货退款。', '工单类别': '一般', '处理描述': '未查实当事人存在涉嫌违法的行为，故不予立案；关于投诉，因双方未达成协商一致，本投诉予以终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160035-2362102', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005602, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 56, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:已经投靠转户口，咨询怎么处理居住证 ', '工单类别': '一般', '处理描述': '转接成功，工号0288，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160465-2362502', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005122, '工号': 2940, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 57, 10), '诉求地址': '拼多多', '诉求区域': '本市', '内容描述': '市民来电反映:11月5日在拼多多买西铁城全自动机械手表。订单号：231105-180407540561567。金额：348元。商家提供的资料确认是假货。商家表示要真货就要私下转账过去。其需要按消法55条处理，平台目前处理方案是退货退款。商品在12月17日已经退回，商家在12月19日签收了。后来顺丰给其联系说拒收了。截止目前都没退款。商家说现在发回去的商品不是他们发出的正品。在12315反映退一赔三，回复不予立案，让其找商家索赔。诉求：请管理部门按消法退一赔三处理。（需回复）', '工单类别': '一般', '处理描述': '归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704159958-328430', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005552, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 57, 43), '诉求地址': '长宁区北虹路新渔路', '诉求区域': '长宁区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，市民称管理部门之前承诺2024年1月1日安装，但至今没有安装，故再次来电。诉求：原诉求不变。（需回复）最近办结的工单编号:20231215010788 工单内容：重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符，管理部门之前回复承诺会在12月11日安装隔音板，但是却迟迟未安装。诉求：请管理部门核实并尽快安装。（需回复）】', '工单类别': '一般', '处理描述': '于2024年1月2日13点43分回复当事人，该处屏体拆除后，因新声屏障需要整修制作加工，后根据中环日常封道安排进行屏体安装。后续会加快施工进度，发现问题及时处理，当事人表示理解并满意。回复人，方旭平。联系方式17316399958', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160408-328856', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005782, '工号': 4322, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 59, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:社保卡开通相关问题', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160619-3099261', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005792, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 0, 37), '诉求地址': '黄浦区薛家浜路159弄1号20楼2001', '诉求区域': '黄浦区', '内容描述': '市民来电反映:黄浦区薛家浜路159弄1号20楼2001，家中水小，是减压泵的问题，物业已经上报城投水务，但城投水务一直没有来处理，诉求：尽快让城投水务来处理。', '工单类别': '次紧急', '处理描述': '接报后，我司于一个工作日内先行联系市民，现场核实为减压阀故障所致，后续对故障配件采购更换，用水已好转，1月20日回访市民表示满意。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '供水', '三级分类': '供水报修', '四级分类': '停水水小', '主办单位': '供水热线', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160643-329064', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005772, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 0, 41), '诉求地址': '黄浦区马当路388号C座 行吟信息科技（上海）有限公司', '诉求区域': '黄浦区', '内容描述': '市民来电反映:1月1日在小红书上自己开店铺，需要缴纳600元保证金，其交完以后被告知是蓝V认证的费用，不能退，存在欺骗的行为，诉求：要求退600元保证金。', '工单类别': '一般', '处理描述': '经与平台方核实：投诉事项系投诉人对小红书专业号认证产生争议，根据《小红书专业号服务协议》相关条款，发生纠纷或争议应提交本协议签订地有管辖权的人民法院诉讼解决，平台拒绝退费调解。鉴于投诉事项为平等民事主体间的商业合作，非市场监管部门主管事项，依据《市场监督管理投诉举报处理暂行办法》，依法不予受理，建议投诉人寻求司法途径维权。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160645-2362659', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004422, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 0, 42), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是公安局静安分局工作人员，咨询我处是否可以做麻将桌作弊器的鉴定。', '工单类别': '一般', '处理描述': '告知无相关信息，市民认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '公安信息查询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160554-2362588', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005542, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 0, 53), '诉求地址': '奉贤区正旭路399弄16号601', '诉求区域': '奉贤区', '内容描述': '市民来电反映:其是租客，其表示在随申办中提交房屋租赁备案的时候提交完之后发现承租人的信息填写错误了。其想咨询如何可以进行修改，还是等驳回之后重新填写就可以。请管理部门核实给予回复。', '工单类别': '一般', '处理描述': '。经联系，客户已自行解决。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '租赁管理', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160458-328905', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005612, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 3, 49), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:浦东新区住房保障中心地址联系方式', '工单类别': '一般', '处理描述': '根据知识库：上海市住房保障和房屋管理局各区住房保障中心联系方式，归档 ', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '保障型住房', '四级分类': '经适房', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160746-2362740', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102006042, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 5), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 江苏的市民，有几个挂车在上海参加年审，需要税单，市民在江苏申报了车船税，打印出来没有车牌号，诉求：咨询上海这边怎么做年审。是否认可没有车牌号的税单。', '工单类别': '一般', '处理描述': '接工单后，上海市公安局浦东分局交警支队车管宣传大队于2024年1月4日9时27分与来电市民刘女士取得联系，进行先期沟通。经询，提问人称其所述问题已解决，现无其他问题需咨询。 上述内容，上海市公安局浦东分局交警支队车管宣传大队于2024年1月4日9时27分电话回复来电市民刘女士，其表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '车辆年检', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160878-539556', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005842, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 5, 21), '诉求地址': '杨浦区民主二村273号', '诉求区域': '杨浦区', '内容描述': '市民来电咨询:上述地址房屋已经被拆迁了，想要调取该房屋的档案材料，例如：公房材料一般包含：租赁凭证、房屋来源、更户信息等。诉求：请管理部门尽快核实告知哪里可以查询。（需回复）', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160710-539411', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005852, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 6, 25), '诉求地址': '闵行区大华假日酒店的威尔士健身房七宝店', '诉求区域': '闵行区', '内容描述': '市民来电反映: 2023年办理了健身卡，7月中旬办理了退卡手续，承诺两个星期会处理，但是到现在没有处理，联系客服也没有告知具体的时间，就是走流程，诉求：要求尽快退款，需要回复，有发票合同，不涉及私教课程', '工单类别': '一般', '处理描述': '经执法人员调查，举报人提供的信息闵行区大华假日酒店的威尔士健身房七宝店健身场所经营主体为：威康健身管理咨询（上海）有限公司七莘路分公司。场所负责人表示，将继续跟举报人协商沟通处理退费事宜。 2024年1月9日，工作人员与举报人取得联系，告知举报人，工作人员已与场所方充分沟通，将举报人的诉求向场所方充分说明，场所方表示退费流程由总公司统一处理，具体时间无法告知。举报人表示对方一直在拖延，后续将通过诉讼方式解决双方纠纷。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160974-329376', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005972, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 6, 37), '诉求地址': '长宁区广顺北路到凌空公园门口', '诉求区域': '长宁区', '内容描述': '【重新交办,要求：市民表示有接到长宁区交警的反馈，市民认为这个问题不应该由交警反馈，市民这次特意去看了停车牌上的管理单位为长宁区建设和管理委员会（长宁区交通委员会），为此市民希望得到长宁区建交委的回复，市民开车过来时跑步的，市民6:30过来跑步，希望将停车时间往前移。诉求：希望就该处的停车时间进行更改。最近办结的工单编号:20231107011438，工单内容:市民来电反映:上述地址的停车位，时间是8:00-20:00市民认为停车时间不合理，影响市民跑步，诉求：要求更改停车位时间，需要回复】', '工单类别': '一般', '处理描述': '区交通管理中心于2024年1月3日接单，于2024年1月3日11时首次先行联系来电人，告知其问题已经收悉，正在我单位进行办理。2024年1月4日10时，由我单位工作人员对来电人所反映的情况进行核实，已告知市民根据《上海市道路停车场管理规定》（沪交行规2022 11号）第八条第一款，区公安交通管理部门会同区交通行政管理部门共同提出调整、撤除方案后，报市公安交通管理部门审核，故道路停车的调整审批权限为区交警部门，道路停车标牌上标注的单位仅说明该道路停车场由我中心派停车协管单位管理。市民表示理解。经办人：于嘉德。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '公共停车场', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160801-2362795', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102006022, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 6, 59), '诉求地址': '长宁区娄山关路533号2902-2913室拼多多', '诉求区域': '长宁区', '内容描述': '【重新交办，要求：按照答复要点告知市民，市民来电对办理结果不满,市民告知对于管理部门的答复要点不认可，市民强调该平台一直提示还差0.1元旧成功了有活动信息造假的行为，存在不正当经营。诉求：请管理部门核实并予以处理。【最近派发的工单编号:20231212002306，工单内容:市民来电反映:举报拼多多平台欺骗消费者，市民拼多多账号：378077504770，在12月10日21点39分开始市民开始做平台助力，市民找了好多新用户帮其助力，不显示其好友的助力结果，经常提示差0.1成功，市民认为平台的助力活动信息作假，故市民来电举报拼多多。诉求：希望管理部门整改拼多多不正当经营行为。（需回复）】', '工单类别': '一般', '处理描述': '经查，因未发现被举报人存在违反市场监管部门相关法律法规的行为，故我局对其不予立案。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160858-2362851', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102006342, '工号': 2832, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 11, 8), '诉求地址': '浦东新区规划局', '诉求区域': '浦东新区', '内容描述': '市民反映相同事项。【最近办结的工单编号：20231212010930，工单内容：市民反映：沪浦发改城（2023）1111号文拟在浦东新场镇新建大型垃圾转运站，市民不认可，该拟建的垃圾站距离最近的小区汇锦城三期仅370米，距离附近其它的小区均在800米以内，离石笋实验小学也不足900米。在批复前未对附近居民和村民进行任何形式的公示，未进行任何形式的听证或者居委传达；直到项目批复公示后，居民才有所了解，整个环评过程缺少清晰完整的过程，环评结果至今未有公示，该拟建的垃圾站距离千年文化古镇、院士之乡的新场古镇不足1000米，直接影响2025年新城申遗，诉求：建议重新调整垃圾转运中心建设地址。】', '工单类别': '一般', '处理描述': '市民反映重复事项，工单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '卫生配套设施', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102006412, '工号': 2940, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 12, 13), '诉求地址': '拼多多', '诉求区域': '本市', '内容描述': '市民来电反映:在拼多多买手机，订单号：231228-340084683831716。金额：5748元。因商品有差价，和商家沟通退差，商家表示不退。其表示算了，商家结果在中途让快递公司撤回快递。现在已经退回商家，结果商家以各种理由不退钱。诉求：请管理部门尽快退款。（需回复）', '工单类别': '一般', '处理描述': '经查，拼多多平台表示已与消费者协商处理，我局多次电话联系消费者，电话均未接通，故此单投诉办结。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704161233-2363214', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102006442, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 12, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其在随申办上申请封存满半年提取公积金审批状态已办结，网上申报状态是待预审。诉求：咨询是否审核好了。', '工单类别': '一般', '处理描述': '转接公积金专席成功,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704161287-3099867', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102005462, '工号': 4290, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 12, 36), '诉求地址': '静安区', '诉求区域': '静安区', '内容描述': '市民来电反映:市民是与一家有限责任公司签订劳动合同，但是办公室现场另一家公司。今天早晨发布了调整工位的通知，但是没有市民的工位。市民尝试与两家公司协商都无果，两家公司都无回复，市民认为这是变相裁员。要求转接驻场法律服务专家。', '工单类别': '一般', '处理描述': '转接驻场法律服务专家成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '合同纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704160274-2362321', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102006472, '工号': 3542, '工单生成时间': datetime.datetime(2024, 1, 2, 10, 13, 23), '诉求地址': '嘉定区安亭镇新源路1025弄11号302室', '诉求区域': '嘉定区', '内容描述': '市民来电反映:2023年12月29日在随申办上申请租赁合同网签备案，显示预审通过，至今无法展示备案证明。诉求：请管理部门核实处理进度。', '工单类别': '一般', '处理描述': '。经联系，客户已自行解决。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '租赁管理', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704161308-539918', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102006682, '工号': 3440, '工单生成时间': datetime.d