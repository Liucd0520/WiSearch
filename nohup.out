的停车收费标准没有多收许先生停车费，因此无需退还。许先生表示已知晓。未评价。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704095190-2306487', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101011582, '工号': 4080, '工单生成时间': datetime.datetime(2024, 1, 1, 15, 52, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多专席。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704095487-273749', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101011512, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 1, 15, 54, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704095430-3088757', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101011462, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 1, 15, 55, 30), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:结婚登记是否需要预约，如何预约，外省市户籍人员是否可以需要在指定登记机关办理。', '工单类别': '一般', '处理描述': '根据《上海16区婚姻登记机构最新地址在此，附结婚登记攻略》,《关于本市内地居民婚姻登记跨省通办的相关问答》,告知市民浦东新区电话58828056，市民表示认可，此单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '婚姻管理', '四级分类': '结婚登记', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704095261-529784', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101011502, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 1, 15, 56, 6), '诉求地址': '嘉定区宝龙广场1层外围1-429', '诉求区域': '嘉定区', '内容描述': '市民来电反映:在上述地址机构报名了芭蕾舞培训，2023年7月中旬支付了120节课的费用20400元。机构名称：灰姑娘培训舞蹈机构。公司名称：爱晟（上海）文化传播有限公司。市民表示7月中旬支付费用后机构就跑路了，后续无人处理。之前反映12345也没有回复。（根据市民的手机号未查询到之前的工单，市民要求重新派单。）诉求：请管理部门核实给予解决方案。（需回复）\n', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，对该事项投诉调解的法定职责如下：在行业分类上，文化艺术辅导属于教育大类，行业主管部门是教育部门，行政执法部门是市场监管部门。且根据《教育部等六部门关于加强校外培训机构预收费监管工作的通知》，由教育部、市场监管总局等六部门将学科类和非学科类校外培训机构预收费应全额纳入监管范围，包括通知发布前已收取但未完成培训服务的预收费资金。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。若涉嫌合同纠纷，可向法院起诉。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为...', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704095175-273669', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101011692, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 1, 16, 0, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其在京东购物遇到纠纷', '工单类别': '一般', '处理描述': '建议联系京东12345，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '外省市受理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704095858-2306694', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101011742, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 1, 16, 3, 49), '诉求地址': '杨浦区军工路601号门口', '诉求区域': '杨浦区', '内容描述': '市民来电反映:上述地址在2023年下半年突然多出了停车位，没有竖牌子且也没有人管，只是在地面上划了线，也无公示，其也不清楚停车位是否合法。诉求:望管理部门核实，予以处理。（需回复）', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派区公安分局进行处理。据区公安分局回复：先行联系：2024年1月2日8:40先期联系。 情况核实：因小区美丽家园工程期间小区居民停车难，长白街道向交警支队申请道路临时停车备案。长白街道已制作醒目停车指示牌，且安排人员管理，客观上，来电人反映的“2023年下半年突然多出了停车位，没有竖牌子且也没有人管，只是在地面上划了线,也无公示”情况不属实。...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '公共停车场', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704096008-2306748', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101011802, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 1, 16, 4, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要转拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否