': 3290, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 55, 57), '诉求地址': '嘉定区马陆镇宝安公路2888弄', '诉求区域': '嘉定区', '内容描述': '市民来电反映:上述地址小区内有很多的违建并且建造过程中噪音扰民，希望管理部门核实整治', '工单类别': '一般', '处理描述': '嘉定区马陆镇：2024年1月6日10:43:02先行联系。经包桥村核实：包桥小区为异地动迁小区，无产证。包桥小区装修规定时间为8点至12点，14点至17点，经居委工作人员巡查暂未发现有装修噪音扰民的现象，后续将继续巡查，一旦发现将及时进行劝阻。多次联系来电人均拒接，无法核实具体地址，建议来电人可至居委或村委会提供具体违规地址进行协调。1月11日短信告知您。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502378-198727', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002162, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 6, 8, 58, 56), '诉求地址': '浦东新区昌邑路近桃林路滨江大道', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址有项目周末早上施工，不知道是在修路还是什么。噪音扰民严重。市民不知是什么项目。诉求：希望管理部门核实，加强监管，制止噪音扰民（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '尊敬的市民您好：接单后，立即安排相关人员现场踏勘处置，经核实，该处为桃林路道路维修工程，现该施工方对桃林路（浦东大道—昌邑路）路段恢复人行道板砖，并在该处安装禁车柱将人行道与商铺分开，现已施工完毕，后续不会有噪音扰民的情况，给您带来不便深感歉意。感谢您对城市管理工作的理解与支持。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502486-2239079', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002332, '工号': 2940, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 1, 8), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:就医记录册用完如何更换。', '工单类别': '一般', '处理描述': '根据《 如何办理、使用《就医记录册》》,《杨浦区控江路街道社区事务受理中心 》告知市民，市民认可，工单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502767-198852', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002262, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 1, 50), '诉求地址': '浦东新区浦建路83弄13号', '诉求区域': '浦东新区', '内容描述': '市民来电补充信息。市民补充信息内容为1月6日是非工作日根据规定不能施工，但是小区还是施工。诉求：请管理部门尽快整改规范小区施工。【最近派发的工单编号：20231228007165，工单内容：市民反映：装修时间有明确规定是工作日8：00-12：00，14：00-18：00，现浦建小区翻新改造工程，工作日7:00就开始施工，电钻发出很大噪声，严重影响居民休息。诉求：请管理部门核实整改，规范小区施工。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231228007165，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '旧房改造', '四级分类': '房屋老化', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502573-198776', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002362, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 2, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民在电话中辱骂，自行挂断', '工单类别': '一般', '处理描述': '市民=吴明确诉求。自行挂断，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502843-198878', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002392, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 3, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费问题，要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502878-2239240', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002322, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 4, 9), '诉求地址': '浦东新区张江高科实验小学（藿香校区）', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址校方在周末有安排棒球课活动，但不让家长的车辆进入，只让棒球教练的车进入。市民诉求：请管理部门核实后采取措施解决此事，让家长车辆能正常进入。', '工单类别': '一般', '处理描述': '市民您好，浦东新区教育局：学校停车场非公共停车场，学校停车场开放属学校内部管理，建议家长如有好的意见或建议，也可积极与校方反映沟通，家校合作，共同育人。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '学校管理', '四级分类': '校园设施', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502748-2239175', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002742, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 4, 19), '诉求地址': '浦东新区隆宇大厦二七零一眉里目间', '诉求区域': '浦东新区', '内容描述': '市民反映相同事项。【最近派发的工单编号：20231228034334，工单内容：【商家地址/名称:未提供,时间:2023/07/2821:00:00,涉及金额:50000】纹唇后出现唇炎请求赔偿】', '工单类别': '一般', '处理描述': '市民反映重复事项，工单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002252, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 5, 31), '诉求地址': '普陀区桃浦路300弄69号1路5楼21楼', '诉求区域': '普陀区', '内容描述': '市民来电反映:上述地址有三户人家安装的铁门把消防栓圈进自家的范围，要求管理部门尽快拆除。（信息保密，无需回复）', '工单类别': '一般', '处理描述': '接到工单后，由于来电人信息保密无法联系。经核实，来电人反映问题部分属实。经了解情况如下：社工姜丹丹于1月9日上门查看，69号楼1层、21层有加装铁门，5楼消防栓包进去了，1、桃浦路300弄69号5楼的铁门将消防栓包进去了，处置部门已张贴整改告知单，要求业主自行整改拆除公共区域的铁门。2、1月17日再次上门核实，该户业主已自行将铁门拆除并保持公共区域畅通。3、由于年关将至，1楼和21楼住户均不在家。一户出门旅游，一户回老家了。后续将继续关注。经办人：周海玥 负责人：楼威 电话：52768904 经办人：姜丹丹；科室负责人审核：邹俊；联系电话：52733679 芝川片区 唐艾杰...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502672-932410', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002472, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 6, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其孩子医保卡不能使用，不知是否因为医保没有交导致', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704503091-932568', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002492, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 7, 46), '诉求地址': '浦东新区医保中心', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:上述部门地址', '工单类别': '一般', '处理描述': '根据《浦东新区医疗保险事务中心》告知，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '机关事务管理', '三级分类': '机关事务管理', '四级分类': '机关事务信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704503138-2239348', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002682, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 11, 9), '诉求地址': '宝山区', '诉求区域': '宝山区', '内容描述': '市民来电反映:市民2020年12月22日-至今一直在上海龙东机械模具有限公司上班，单位一直没有给市民交过社保和公积金，目前老板正在办理注销公司。诉求：请管理部门尽快帮助市民补交公积金。', '工单类别': '一般', '处理描述': '2024年1月15日，反馈“12345”热线办。 ', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': '市公积金管理中心', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704502902-2239249', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002562, '工号': 3262, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 11, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:成人的上海开放大学，此大学的学历学位是否认可此学校，是否可以进行居住证积分。诉求：请管理部门核实并告知市民成人开放大学是否可以进行居住证积分（需回复）', '工单类别': '一般', '处理描述': '2024-01-07 11:04:50致电，关于您咨询的问题，告知您依据《上海市居住证积分管理办法实施细则》（沪人社规（2022）41号）（二）除上述积分申请基本材料外，持证人还应当提供与《上海市居住证》积分指标项目对应的材料： 1．持证人按照国家教育行政主管部门规定取得的被国家认可的国内外学历学位证书。以高等教育自学考试、成人高等学历、网络高等学历教育毕业证书申请积分的，需提供毕业生登记表、成绩单等学籍材料，或其他可以证明其教育经历的相关材料。您表示了解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '居住证', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704503265-932630', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002602, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 11, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【 表扬】市民来电咨询: 12月31日咨询居住证 续签问题，话务员态度蛮好的，解决问题，诉求 要求表扬  20231231017396', '工单类别': '一般', '处理描述': '已按照表扬处理流程进行核实处理。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '表扬感谢', '四级分类': '服务态度', '主办单位': '12345热线处理', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704503356-3020987', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240106002372, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 6, 9, 12, 30), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电咨询:询问老年综合津贴是否60岁可以领取，独生子女费是否退休了还能领取，失业金领取年限和属地失业补贴。', '工单类别': '一般', '处理描述': '告知市民老年综合津贴要65岁，退休一次性独生子女费领取后没有其他费用，失业金到社区办理，地方失业补贴无法查看建议确认社区中心是否有此类申请市民表示知晓。', 