编号': 20240105008742, '工号': 4310, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 56, 54), '诉求地址': '闵行区碧江路510弄凤庆小区', '诉求区域': '闵行区', '内容描述': '【投诉】市民来电反映:闵行区碧江路510弄凤庆小区市民2024年1月3日发生机动车碰撞事故报警了，警察告知市民会去派人看监控的，市民明确表示2024年1月3日到2024年1月5日期间根本没派警察来调看监控。诉求：投诉 闵行区公安分局碧江派出所有关人员不作为。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '碧江路派出所于2024年1月11日13时27分许，与来电市民周女士取得联系，具体答复内容如下：经查看执法录像，当日接警民警唐晓亨（警号：042712）已当面告知市民周女士可先自行前往物业查看视频监控，待有结果后，可至我所交通窗口作进一步处理，故不存在不作为的情况。现接到市民来件后，我所综合执法民警叶向阳（警号：042181）已陪同其前往物业再次查看监控，但并未发现肇事车辆。同时，我所交通事故专管民警蒋立民（警号：041543）亦联系到市民，告知其若车辆需进保维修，则可至我所交通窗口开具单车事故单。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704422438-2902857', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105009712, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 57), '诉求地址': '松江区广富林街道', '诉求区域': '松江区', '内容描述': '市民来电咨询:其通过居转户的高级职称方式落户，孩子和其不在同一户口簿上，咨询是否需要将孩子迁到同一户口簿上后再办理随迁。诉求：请管理部门核实并告知。', '工单类别': '一般', '处理描述': '2024-01-08 11:02:55 致电，关于您咨询的问题，您表示问题已解决，工单无需进一步处理。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704423202-863139', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105009432, '工号': 3802, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 57, 19), '诉求地址': '浦东新区周浦镇周东路年家浜路', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民2023年12月在以上地址发生车祸，是交警撞了市民，交警全责，在走保险，保险必须要公安局授权敲章才能理赔，但是交警表示由保险全权处理他们不管，导致市民一直得不到理赔，诉求：要求交警尽快给保险授权敲章。', '工单类别': '一般', '处理描述': '上海市公安局浦东分局周浦派出所于2024年1月17日与市民进行先行联系。收单之后，本单位即刻安排民警开展工作。民警电话联系市民，市民因在周浦派出所门口与警车发生了碰擦，现该起交通事故已处理完毕。民警1月17日15:02分许将上述情况告知市民，市民表示满意。【欣逸居委】', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通事故', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704422993-83684', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105009832, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 57, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【为企服务】市民来电咨询:股权变更咨询。', '工单类别': '一般', '处理描述': '转接税务专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704423309-2949337', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105009622, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 58, 13), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电反映:中通、韵达都是不送件上门，送入菜鸟驿站：浦东新区齐恒路172号店，驿站都不能及时派送，影响市民日常使用。诉求：要求邮政局介入让驿站能够整改，当天件能够当天送达。（信息保密  需回复）', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704423222-2949243', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105010052, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 58, 28), '诉求地址': '浦东新区潍坊路89弄13号', '诉求区域': '浦东新区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。年前反映群租问题，街道回复不是群租。市民表示201室是一室户，并不是2室户，居住面积15平方米。该户室内居住超过4人，根据上海市房屋租赁条例，人均居住面积不得低于5平方米。要求再次核实，答复都是有痕迹有书面记录，请认真处理回复。诉求：希望管理部门核实转送相关照片至承办部门。（相关工单编号：20231226029041）（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '您好，接件后，潍坊街道联勤联动站工作人员再次赶到潍坊路89弄13号201室，目前房屋已空置，租客已搬离，现场未发现有群租的现象，同时要求小区居委物业加强小区内的日常管理。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '群租现象', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105009772, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 59, 8), '诉求地址': '黄浦区金融办', '诉求区域': '黄浦区', '内容描述': '市民来电反映:黄浦区金融办电话33134800打不通，咨询电话', '工单类别': '一般', '处理描述': '根据《黄浦区金融办》告知', '客户类型': '个人', '一级分类': '其他类', '二级分类': '机关事务管理', '三级分类': '机关事务管理', '四级分类': '机关事务信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704423264-2949288', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105009902, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 5, 10, 59, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:在职职工如何将本市医保转移到外省市。诉求：请管理部门核实并告知。', '工单类别': '一般', '处理描述': '2024-01-05 16:42:37 先联 2024-01-10 10:11:39 联系市民，市民询问如何将基本医疗保险关系从本市转往外省市。根据沪医保待（2019）108号、沪医保规（2020）8号文及相关规定，告知市民，本市职保人员流动到外省市就业，参保人员养老保险关系已转出的，凭参保人的身份证、如有委托的，同时需带好被委托人的身份证至区医保中心打印《参保凭证（发函用）》，再至外省市经办机构申请办理医保转入手续，或尝试通过国家医保服务APP线上办理。另外，市民可登录一网通办，首页搜索“医保参保凭证”，尝试在线申请打印；若网上无法打印，也可根据线下办理流程进行线下办理。市民表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704423394-84085', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105009972, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 0, 36), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:上海市地方金融监管局电话的电话。', '工单类别': '一般', '处理描述': '根据《 市地方金融监管局信访部门 》', '客户类型': '个人', '一级分类': '其他类', '二级分类': '机关事务管理', '三级分类': '机关事务管理', '四级分类': '机关事务信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704423482-863410', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105009842, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 1, 54), '诉求地址': '浦东新区和家路18号', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其姓名为张敏，身份证号码为340321198504258631，其在上海由一个骑电瓶车没有带头盔的交通违章，2023年7月20日9:38其到上述地址浦东交警支队五大队责任区事故组处理的，当时支付了30元罚款，但是其在12123APP上看到该违章没有处理，诉求：请管理部门核实，协助解决该问题。', '工单类别': '一般', '处理描述': '接工单以后，上海市公安局浦东分局交警支队五大队民警于2024年1月5日21时14分电话联系提问人，进行先期联系。 经查，属地大队事故组已协调解决。 上海市公安局浦东分局交警支队五大队民警于2024年1月5日21时14分与提问人取得联系，进行答复，其表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704423326-863250', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105010222, '工号': 1110, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 6, 55), '诉求地址': '虹口区水电路1013弄19号304室', '诉求区域': '虹口区', '内容描述': '市民来电对办理结果不满,市民要求区里派人处理，结果居委支部书记来处理，该书记直接不承认之前讲过的话，市民不认可。诉求：要求区里来处理。【最近派发的工单编号:20240103007617，工单内容:市民来电反映:其告知自己老婆脑子有问题，经常将纸板箱堆放在自家过道，市民多次因个人家庭纠纷问题寻找上述地址小区居委做调解，但是该居委书记告知不属于其管理范围，市民不认可。诉求：请管理部门核实该居委书记是否存在不作为，做出投诉。（需要回复）】', '工单类别': '一般', '处理描述': '市民对办理结果不满，已电子催单工单编号：20240103007617，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704423695-2949736', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105010902, '工号': 2890, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 17, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:浦东新区德州路150弄和奉贤区协新村的居委信息。', '工单类别': '一般', '处理描述': '根据《 浦东新区周家渡街道居委一览表 》,《 奉贤区奉城镇所属居委会一览表 》告知市民，认可，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '社区家政', '四级分类': '社区服务网点', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704424331-84970', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105011022, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 18, 13), '诉求地址': '金山区山通路555号上海珏盈装饰工程有限公司', '诉求区域': '金山区', '内容描述': '市民来电反映:12月1日离职，没签劳动合同，被拖欠11月份部分工资1000多元。诉求：请管理部门讨要工资。', '工单类别': '一般', '处理描述': '先行联系时间：2024年1月5日 13时16分 核实认定情况：接到此工单后，1月8日10时与诉求人先行联系。初步掌握诉求人的诉求是 12月1日离职，没签劳动合同，被拖欠11月份部分工资1000多元。 处置过程和结果：进一步了解相关情况：经协调后，目前情况单位已经支付了诉求人的部分工资1452元。 答复市民反馈情况：1月9日9 时25分电话反馈诉求人。诉求人表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '拖欠工资', '主办单位': '金山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704424428-2950456', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105011162, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 5, 11, 18, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其驾驶证满分学习的科目一和科目三通过了是否直接拿着成绩单去车管所拿驾驶证。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户