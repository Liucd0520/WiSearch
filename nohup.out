9092, '工号': 4380, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 6, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:在本市工作了几年总店是在黄浦区签的合同，被调任到了杨浦区，现在被开除了，咨询黄浦区劳动监察大队的电话，并需要哪些材料。', '工单类别': '一般', '处理描述': '根据《劳动人事争议仲裁办案规则》,《全市劳动人事争议调解仲裁机构》,《上海市杨浦区劳动人事争议仲裁委员会》,《上海市杨浦区劳动保障监察大队》，告知市民，市民认可，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704707154-2699260', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108031782, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 13, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:企业减资的问题', '工单类别': '一般', '处理描述': '告知信息，归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704708622-2699883', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108031752, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 13, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其妻子在上海缴纳医保，后在2023年11月在上海生育。市民称其处结婚证是在出生证明之后领取的。现市民被告知上述情况下其处只能领取98天的生育金，后又被告知能领取158天的，故来电专席相关信息。', '工单类别': '一般', '处理描述': '转接医疗保障专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '生育保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704708358-2699781', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108031832, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 16, 14), '诉求地址': '静安区延安中路1228号办公楼三座第8层802室', '诉求区域': '静安区', '内容描述': '市民来电反映:市民在淘宝上购买了上述地址的历峰贸易（上海）有限公司的手链，是给其爱人的礼物，其爱人不喜欢想要退货，但是商家以各种理由拒绝，订单编号市民暂时无法提供。诉求：请管理部门协调帮助其退货退款。', '工单类别': '一般', '处理描述': '吴先生，你好。根据你反映的情况，我局承办人联系历峰贸易（上海）有限公司开展调查调解工作。经核查，退回商品宝石边缘靠近金属存在磕痕，经调解，历峰贸易（上海）有限公司明确表示无法满足你退款诉求，该情况属于《市场监督管理投诉举报处理暂行办法》第二十一条第（四）项规定所指的终止调解情形，根据《市场监督管理投诉举报处理暂行办法》第二十一条规定，我局决定终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704708614-2699881', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032352, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 19, 38), '诉求地址': '松江区新桥镇新南街419-421', '诉求区域': '松江区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。市民反映不作为问题。诉求：希望管理部门核实转送相关照片至承办部门。【相关工单编号：20231229029191】', '工单类别': '一般', '处理描述': '投诉方反映事项此前已办结，同全国工单20231215031708，故终止调解。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108031362, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 20, 17), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:本市垃圾分类定时定点投放政策不合理，投放的垃圾不是在垃圾桶里发酵就是在居民家里发酵。市民表示定时定点投放不如做到按时对垃圾桶进行清理。建议：希望管理部门核实取消本市垃圾分类定时定点投放的规定，改为及时清运垃圾。', '工单类别': '一般', '处理描述': '已告知杨先生，本市各社区原则上实行定时定点分类投放管理，可结合居民实际需求，增设午间投放时段、延长原有投放时段或设置误时投放点（24小时开放的投放点）。为方便市民分类投放，改善投放环境，自《上海市生活垃圾管理条例》施行以来，市级管理部门一直在指导各区升级分类投放点除臭、洗手等装置的硬件配置，确保湿垃圾一日一清，有条件地区一日二清，减少夏令时节湿垃圾在小区的停留时间，并优化分类投放点周边全时段环境卫生质量管理，给市民一个良好的投放环境。对于杨先生提出小区误时投放点位置设置偏远，不方便投放的情况，已对接区管理部门，指导属地街道做好实地调查，如误时投放点设置位置确有不适当，在充分听取居民意见、...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '垃圾分类', '主办单位': '市绿化和市容管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704708850-2699975', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032012, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 20, 36), '诉求地址': '奉贤区贤瑞路29弄6号 煜灵康体馆', '诉求区域': '奉贤区', '内容描述': '市民来电反映:上述地址在向老年人出售保健品，夸大产品效果，涉及虚假宣传，希望管理部门核实处理整治（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '举报事项经核查，不予立案，被举报的保健品夸大虚假宣传行为未查实，故不予立案。', '客户类型': '个人', '一级分类': '安全监管类', '二级分类': '食品药品安全', '三级分类': '安全管理', '四级分类': '保健品管理', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704708973-2700025', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108031992, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 21, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:涉及交通事故，闵行区公安分局行政部门贪污，被闵行区法院法官包庇，法院起诉事宜。', '工单类别': '一般', '处理描述': '根据《 12389专用举报电话的职责受理范围？ 》《  不予受理来电的处理流程 》告知，按流程申请挂机，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '法院系统', '三级分类': '法院受理', '四级分类': '法院判决', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704708888-609401', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032002, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 22, 51), '诉求地址': '浦东新区迪士尼乐园候车点', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:2024年1月8日市民从上述地址叫了一辆黄色的出租车到虹桥站，有打表，市民称司机收取了310元车费，市民担心有绕路现象，公司名称、车牌号和司机服务号市民都不清楚。诉求：希望管理部门告知该收费是否合理。（需回复）', '工单类别': '一般', '处理描述': '经与乘客联系，乘客无法提供车牌等基本信息，只能大致回忆上车时间，但是根据乘客提供的上车时间梳理，疑似多辆出租车，但经过公司后台数据检测，几辆车都未符合行驶情况。提前和乘客解释相关情况，乘客表示了解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704708935-400343', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032092, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 25, 4), '诉求地址': '徐汇区宜山路515号1号楼16层上海慕莱装饰公司', '诉求区域': '徐汇区', '内容描述': '市民来电反映: 市民找的上述地址装修公司装修房屋。 装修合同约定2023年9月18日开工， 约定75天完工。但是现在只完成了三分之一，对方拖着一直不施工。 市民要求装修公司抓紧完成施工。', '工单类别': '一般', '处理描述': '归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '工程质量', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704709142-609492', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032152, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 25, 15), '诉求地址': '浦东新区地铁世纪大道站', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址世纪大道地铁站A厅正在进行改造施工，将该处通道隔绝，只能进站，但无法直接通行。虽然使用大都会APP才能10分钟内免费进出，但隔绝通道的做法不合理。市民表示该处通道等于是世纪大道过马路的通道，现通行受到影响。诉求：希望管理部门核实进行整改，解决过马路通道被隔绝问题。（市民要求信息保密 需回复）', '工单