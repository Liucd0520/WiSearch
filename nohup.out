 None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109031452, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 29, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704796065-2567077', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109031532, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 31), '诉求地址': '嘉定区汇源路55号8幢3层321室上海五纷物联技术有限公司', '诉求区域': '嘉定区', '内容描述': '市民来电反映:上海五纷物联技术有限公司旗下云智充APP里还有94.7元余额。云智充APP注册手机号：18192801488。诉求：请管理部门核实协调尽快退款。', '工单类别': '一般', '处理描述': '您好，我局收到您对上海五纷物联技术有限公司的投诉，经调解，企业反馈已与您取得联系并完成退款，我局决定终止调解。若您仍有疑问可致电企业客服021-61916225或者通过微信小程序12315登记诉求。特此告知。[嘉定区市场监督管理局]', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704796189-731421', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109031512, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 32, 43), '诉求地址': '浦东新区12号线东陆路地铁站3号口', '诉求区域': '浦东新区', '内容描述': '市民来电反映:该处地址是流动摊贩，管理部门去的时候没有看到设摊，现在设摊死灰复燃了，诉求：要求取缔。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '市民，您好。沪东新村街道沪东综合行政执法队接此工单后，非常重视，立即派员前往该处，进行现场核实。经查，3号口附近未发现摆摊人员，因该处曾有过设摊情况，执法队已对当事人做出过处罚决定：当2308041204号，并加强对该区域的巡查力度，一经发现立即处置，该处设摊情况已经得到明显改善。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704796154-731413', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109031682, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 35, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民为个人消费者，要求转接拼多多专席\n', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704796456-2823637', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109031132, '工号': 4310, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 37, 58), '诉求地址': '宝山区月罗路559号W-1018室', '诉求区域': '宝山区', '内容描述': '市民来电反映:2022年3月在上海市杨浦区五角场万达广场 做的防水装修活 ，在上海杨浦区长阳路1687号创谷园区周师兄重庆火锅也是干同样的活，拖欠工资5700元， 没签劳动合同。  公司名称：上海景宅建筑装饰有限公司，地址：上海市宝山区月罗路559号W-1018室。诉求：有请有关部门人员追讨欠薪的问题   ', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派五角场街道、大桥街道进行处理，据五角场街道回复：先行联系：我单位于1月10日先行联系了来电人。 情况核实：经核实，来电人反映情况不属实。 处置过程及回访：经与来电人及上海景宅建筑装饰有限公司联系了解，来电人反映诉求实为其与上海景宅建筑装饰有限公司间的建设工程劳务合同纠纷，非劳资纠纷的小型工地欠薪，建议来电人通过司法途径维护自身权益。据大桥街道回复：来电人反映诉求实为其与上海景宅建筑装饰有限公司间的劳务费纠纷。非劳资纠纷的小型工地欠薪建议来电人通过法律途径维护自身权益。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '拖欠工资', '主办单位': '杨浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704795298-731093', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109031692, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 39, 8), '诉求地址': '杨浦区控江路1500弄1-10号', '诉求区域': '杨浦区', '内容描述': '市民来电反映:上述地址的上海联创设计集团股份有限公司，不仅让员工超时加班，还不给补休和加班费。有时候甚至周六周日都要加班。市民认为不合理。诉求:请管理部门尽快查处。（信息保密 需要回复）', '工单类别': '一般', '处理描述': '根据（沪）人社执法（2024）受字第（01722）号《上海市人力资源社会保障行政执法举报登记表》反映，经初步监察，该单位涉嫌存在未按规定支付加班工资的违法行为。目前该案正在调查取证过程中。2024年1月26日13:43，监察员电话向当事人告知其案件正常查处，请当事人耐心等待，当事人表示已经知晓并感谢，并对工单办理满意。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '用工规范', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704796487-477228', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109030492, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 41, 20), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:自行车是否可以放在公交车上。', '工单类别': '一般', '处理描述': '查询知识库无，告知可以派单咨询，市民要求值班长接电，告知可以回电，市民表示算了，挂断，归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704796629-2567282', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109031642, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 41, 59), '诉求地址': '虹口区车站北路400弄20', '诉求区域': '虹口区', '内容描述': '市民来电反映:上述地址居住的都是老年人，其朋友也是老年人，还是残疾人，出行需要轮椅，但是没有无障碍通道，其朋友出行十分不方便，无法通过轮椅直接出行，市民表示都是楼梯台阶。 其曾经也提出过希望居委会申请建设个斜坡，但是其表示需要楼内居民自费。诉求：请管理部门尽快查证，是否可以建设无障碍通道，在楼栋口建设斜坡，方便其老年人残疾人轮椅出行。（需回复）', '工单类别': '一般', '处理描述': '居委工作人员接到工单后，于1月10日14：55和物业一起到车站北路400弄20号楼栋门口实地查看。经物业工作人员实地考察后指出，该楼栋坡道距离不足，坡度太大，存在安全隐患，不能改建无障碍通道。经居委核实，来电诉求人并非本小区居民。居委对诉求人反映的车站北路400弄20号楼栋残疾人居住情况也进行了摸排。结果发现20号楼栋二楼以上无残疾人，只有一楼有一位残疾人，该居民家中并无轮椅。综上该工单申请不属实件。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '残联', '三级分类': '残联', '四级分类': '无障碍工程', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704796408-2567215', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109031722, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 43, 10), '诉求地址': '长宁区新泾镇华松小区', '诉求区域': '长宁区', '内容描述': '市民来电反映:其为上述地址居民，从2021年4月开始申请报修整个小区的防盗门，但是至今为止一直以各种理由没有维修好，诉求：希望管理部门协调尽快维修防盗门。', '工单类别': '一般', '处理描述': '新泾镇平安办于2024-01-12 08:43分接单，于2024-01-12 10:00分先行联系居民，事实认定属实，诉求合理合法，其问题已收悉，我办于2024-01-12 10:30分去到现场了解情况，经居委、物业反映，该小区目前正处在精品小区改造期间，门禁暂未安装。2024-01-15下午15:00经与居委、物业、精品小区施工方多方讨论并决定，将于2024-01-22日前对小区内业主发放新门禁卡，并于1月底前完成小区所有防盗门的安装。于2024-01-15日 16:20分再次联系居民进行解释工作，居民表示知晓并认可三方讨论结果。以上内容做解释说明，未评价，回复人：钱辰洋', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704796674-2567301', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109031832, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 47, 4), '诉求地址': '崇明区长兴镇先进村222号上海崇明区渝味餐饮店', '诉求区域': '崇明区', '内容描述': '市民来电咨询:社保申报扣费，身份证号：51222519700308023X，咨询个体工商户如何办理社保缴费。', '工单类别': '一般', '处理描述': '尊敬的纳税人，非常感谢您的来电，针对您的提问，回复如下： 反映咨询的诉求管理部门告知如何通过线上方式办理社保费的申报缴费问题。可以下载上海市社保费客户端，同时下载操作手册，按手册进行操作申报缴费。 回复人：艾培景；回复时间：2024年1月15日15时；问题状态：已解决；回复反馈：满意。 欢迎再次通过区局网站或12366热线与我们联系。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704796750-2567331', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109032292, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 52, 23), '诉求地址': '黄浦区南京东路479号U479商城9F忘愁民谣', '诉求区域': '黄浦区', '内容描述': '市民反映：该店里消防没过审核，违规开店营业。诉求：要求责令商家停止营业。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '我支队于2023月12月28收到上述场所上海久中友餐饮管理有限公司非承诺制开业前检查申报，于2024年1月11日审批该场所消防安全检查结果合格。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '审批许可', '四级分类': '审批许可', '主办单位': '市消防救援总队', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109030822, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电补充信息。市民补充信息内容为市民表示抖音有联系其告知赔偿924.5元，现市民对此不认可要求全额退款。【最近派发的工单编号：20240106021331，工单内容：市民来电反映:市民2023年5月2日10.39分在抖音商城购买的保健品（口服深海褐藻糖胶）单价616.33元，6个共计3698元，订单号：6918149664516085656，注册手机号：13967158233，市民表示其是改善乳腺结节的，其在吃之前和之后都有过体检，无明显变化，认为与商家宣传不符，与商家客服自行协商告知退924.5元，市民不认可，诉求：市民要求商家可以全额退款，请管理部门核实处理售后问题。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240106021331，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704797356-477519', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109032192, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 9, 18, 55, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:个人消费者要求转接拼多多客服。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704797672-2567665', '工单类型': '咨询类', '新一