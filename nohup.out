101004812，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704188676-397287', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102031512, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 2, 17, 52, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704189070-2689754', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102031462, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 2, 17, 54, 59), '诉求地址': '普陀区交通路（志丹路-真华路）', '诉求区域': '普陀区', '内容描述': '【重新交办，要求：答复要点不明确，市民表示目前该路段建成已经有一段时间，请管理部门尽快核实路灯何时能开启。最近办结的工单编号：20231102028195，工单内容：市民来电反映:上述地址有很多路灯不亮了，诉求：管理部门核实尽快维修。', '工单类别': '次紧急', '处理描述': '尊敬的市民，您好！您反映的问题已收悉。接到您的报修后，我中心立即派养护单位现场进行处置。经核实，该处路灯设施为新建工程，目前已告知相关单位进行处置，给您带来的不便深感抱歉！', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '电力', '三级分类': '故障报修', '四级分类': '路灯供电', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704189057-2431864', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102031552, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 2, 17, 56, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:如何开具无业或失业证明', '工单类别': '一般', '处理描述': '市民告知要求立刻马上得到回复，只能建议市民向人社咨询。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '用工规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704189184-607340', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102031482, '工号': 3692, '工单生成时间': datetime.datetime(2024, 1, 2, 17, 58, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商