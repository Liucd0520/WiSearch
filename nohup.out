me(2024, 1, 4, 11, 21, 53), '诉求地址': '徐汇区宛平南路725号', '诉求区域': '徐汇区', '内容描述': '市民反映：当天门诊开方后，付完费未取药，考虑需要背药回家太麻烦，随后经咨询处工作人员指引，到退费窗口办理退费后到取药窗口办理，取药窗口电话给同事后表示办理完成，其便离开了，可这几天查询是否退费到账，到目前1月4日11:00为止还未退费成功。想电话咨询的，但龙华医院电话不通畅。（电子票据号码为0887693129）诉求：管理部门核实退费问题。（无需回复）', '工单类别': '一般', '处理描述': '医院接到工单后，相关部门了解情况，经查实，该市民未到窗口进行退费处理，已通知其带好医保卡和退费凭证择日办理。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '卫生信息', '四级分类': '医院医疗信息', '主办单位': '市卫生健康委', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104011562, '工号': 3940, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 23, 36), '诉求地址': '本市抖音商城', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231225026100，工单内容：市民来电反映:其在2023年11月21日通过12345反映抖音商城问题，市民表示反映后问题无法处理，管理部门要市民自行拨打市市场监督管理局信访部门电话及12315.市民2023年12月25日15:50拨打市市场监督管理局信访部门电话（64220000）及12315，电话拨打不通。诉求：希望管理部门对市市场监督管理局信访部门电话（64220000）及12315电话拨打不通进行查处处理，尽快与市民取得联系。（需回复）相关工单编号：2023112102...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231225026100，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704338469-2827923', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104011372, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 24, 10), '诉求地址': '宝山区祥瑞家园二期', '诉求区域': '宝山区', '内容描述': '市民来电反映: 上述小区的前面和周围有一块绿地，原本说2023年7月交付，至今没有完成，买房的时候给了周围绿化的方案，结果现在发现方案完全改变了，本来有很多树和坡度，现在发现二期前面树也没有了。很多地方绿化变成了水泥地。诉求：1.要求施工进度加快，2.市民表示也不接受改方案，不能把所有的绿化方案全部推翻。', '工单类别': '一般', '处理描述': '解释说明', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704338301-2827776', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104011462, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 24, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '重复来电，市民咨询前工单信息。【最近派发的工单编号：20231226021578，工单内容：市民来电反映:临港公交业务部经理：黄辉。把司机当做保洁人员。不以行车安全为首位。古来电投诉临港公交业务部经理：黄辉。请管理部门核实处理（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '告知相关信息，市民知晓，此单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '公交巴士', '四级分类': '线路设置', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704338374-788523', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104011522, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 25, 11), '诉求地址': '闵行区瑞丽路东川路', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述地址正在修路，在路面放置了两块铁板，早晚车辆经过的时候产生很大的噪音，影响周边居民休息，要求管理部门尽快解决噪音问题。', '工单类别': '一般', '处理描述': '接报后，供水热线于1个工作日内先行联系市民，经现场核实述地址为鹤庆路560弄供水管网改造工程施工，接市民反映后，处理人员现场核实因过路车辆行驶造成铺设的钢板移位后有噪音产生，已当天通知市政修复单位把钢板铺平做加固处理，并于1月7日铺设沥青，市民认可，供水热线1月9日回访市民满意', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '供水热线', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704338468-2570314', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104012132, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 27, 3), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704337694-2827244', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104011822, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 27, 20), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704338752-2828144', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104011722, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 27, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 其是上海电信的VIP用户，本来用169元的套餐挺好的，电信自说自话加到177元，且打10000号电话打不通。诉求：要求尽快联系市民处理。', '工单类别': '一般', '处理描述': '通过', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': '中国电信上海分公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704338627-788720', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104011262, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 28, 56), '诉求地址': '静安区共和新路街道社区卫生服务中心', '诉求区域': '静安区', '内容描述': '市民来电反映:2024年1月4日市民查询到不知何时与上述医院的王芳医生，市民表示其居住在宝山区顾村，网上无法解约，市民的身份证号码31010919840109002X，诉求：希望管理部门核实，要求解约（需回复）。', '工单类别': '一般', '处理描述': '区卫健委转请共和新路街道社区卫生服务中心进行核实，经核实市民原住共和新路街道，曾于2018年在中心早孕建卡时与妇科医生签约，现住宝山区，按照市民需求已给予解约。市民知晓。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '卫生信息', '四级分类': '社区卫生服务', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704338167-788340', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104011772, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 30, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:孩子的医保没有缴纳如何处理。', '工单类别': '一般', '处理描述': '告知可以到街道社区补缴，市民认可，此单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704338680-788765', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104012022, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 31, 40), '诉求地址': '长宁区', '诉求区域': '长宁区', '内容描述': '市民来电反映:个人消费，要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档 ', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704339026-789039', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104012152, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 34, 49), '诉求地址': '浦东新区合欢路35号1幢101室', '诉求区域': '浦东新区', '内容描述': '市民反映：2023年12月14日中午11:45左右涉事单位员工于上述时间地点敲开独居85岁老人家门，谎称是免费搞活动清洗油烟机的，并动手清洗，在骗取85岁的老人信任后，哄骗老人购买了大量的清洁剂共7箱，每箱30瓶共210瓶，金额巨大，单价每瓶98.51元，总计金额20688元。POS机消费3笔，总金额13000元，现金2笔，共7688元。售卖产品帝蓝家居多用清洁液，立柚家居多用清洁液。产品厂家徐州佰立茗环保科技有限公司，地址江苏省徐州市睢宁县邱集镇徐宁路南—王原路西。现在已从徐州12345得知所售产品为企业经营异常黑名单的产品，但找不到售卖人，工商登记的信息都是假的，目前受害人仅有POS...', '工单类别': '一般', '处理描述': '我国金融业实行垂直管理和分业监管体制，银行业保险业由国家金融监督管理总局监管，在上海设有派出机构为国家金融监督管理总局上海监管局，与地方政府没有隶属关系，建议您拨打全国银行保险消费者投诉维权热线12378进行反映，该热线接听时间为工作日9:00—17:00。您也可以通过信件或者上访的形式向国家金融监督管理总局上海监管局反映，地址是浦东新区合欢路35号，邮编200135，信访接待时间为工作日每周一、三、五（上午9:30-11:30、下午13:30-16:30），或拨打国家金融监督管理总局上海监管局信访咨询电话38650160（工作日上午9:30-11:30、下午13:30-16:30）', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '金融', '四级分类': '银行监管', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104012372, '工号': 4412, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 35, 25), '诉求地址': '虹口区山阴路310弄', '诉求区域': '虹口区', '内容描述': '市民来电反映：其地址大楼有违章建筑大修期间已拆除部分违章后目前还有部分违章迟迟未拆除。诉求：大修要结束了，希望对未拆除的违章尽快处理。', '工单类别': '一般', '处理描述': '据悉，违章建筑拆除工作一直依规依法稳步进行中。针对小区余下的违章建筑，拆违专班正逐户上门、力求做深做实思想工作，有序推进违章拆除。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704336386-2568384', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104012292, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 37, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:放鹤路2134号非机动车所的电话。', '工单类别': '一般', '处理描述': '根据《上海市公安局各区县非机动车管理所一览表》内容告知，市民认可，此单归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704339260-9785', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104012262, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 41, 7), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电咨询:租车4400元/月，押金也缴纳了，现在对方单方面该称新合同4000元/月，还是业务员自己签