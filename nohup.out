26872, '工号': 3662, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 12, 58), '诉求地址': '松江区九亭镇四小', '诉求区域': '松江区', '内容描述': '市民来电咨询:市民2位孩子，一位本市户籍，一位非本市户籍，在上述地址读书，2024年需要出国，需要保留学籍，现在学校告知要将护照给学校看，诉求：请管理部门核实后告知出国保留学籍，是否需要将护照给学校看。', '工单类别': '一般', '处理描述': '经教育局分管领导签批同意，市民诉求有政策信息。松江教育局办公室于1月4日先行联系市民，并对工单问题描述进行确认。经了解：根据上海市学籍管理办法要求，办理出国休学的，家长需提供孩子的护照及签证页向学籍所在学校提出休学申请，1月4日和市民电话答复，其表示满意。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '学校管理', '四级分类': '学籍管理', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704269337-2505975', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103027362, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 13, 48), '诉求地址': '无', '诉求区域': '本市', '内容描述': '重复来电', '工单类别': '一般', '处理描述': '重复来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704269213-2763614', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103027022, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 15, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民称目前老旧居民住宅加装电梯需要“由专有部分面积占比三分之二以上的业主且人数占比三分之二以上业主参与表决，经参与表决专有部分面积四分之三以上的业主且参与表决人数四分之三以上的业主同意”询问如果刚好等于四分之三，政策对于这个界定是大于等于还是一定要大于四分之三，希望管理部门告知', '工单类别': '一般', '处理描述': '由专有部分面积占比三分之二以上的业主且人数占比三分之二以上业主参与表决，经参与表决专有部分面积四分之三以上的业主且参与表决人数四分之三以上的业主同意,界定为大于', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704269519-2506133', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103027162, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 15, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 外省市医保到上海看病。', '工单类别': '一般', '处理描述': '建议市民咨询当地医保局，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704269625-725783', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103027182, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 15, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:企业拖欠工资员工是否可以申请赔偿政策。', '工单类别': '一般', '处理描述': '转接人力资源成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '用工规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704269662-2506257', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103027312, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 19, 23), '诉求地址': '浦东新区沪南路3217弄 东原印柒雅小区', '诉求区域': '浦东新区', '内容描述': '市民来电对办理结果不满,此处消防来开具了整改通知书，要求立即打开，但是物业不执行。诉求：原诉求不变，尽快解决。【最近派发的工单编号:20231217007640，工单内容:市民来电反映:市民是上述地址的居民，市民来电投诉小区物业在没有经过全体业主同意的情况下私自把地下停车库做了隔断，故来电投诉要求联合消防进行整治拆除，对地下车库进行还原。】', '工单类别': '一般', '处理描述': '张先生，您好！康桥镇房管办接单后立即与澄方物业公司联系，其物业经理表示：该小区1号楼属于商住两用房屋，开发商交付使用时，上述地库的卷帘门已经安装，隔断了商住两用和小区商品房的地下车库，不存在物业私自在地库做卷帘门隔断地库的情况。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '消防管理', '四级分类': '消防隐患', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704269815-2506394', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103027402, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 19, 54), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '【为企服务】市民来电咨询:非临港地区企业办理减资流程', '工单类别': '一般', '处理描述': '告知信息，归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704269891-470678', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103027262, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 3, 16, 20, 31), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:投诉中国移动无故封停市民手机号，后台不受理，一味让市民等待，影响市民出行、工作，家人也联系不上，手机号还连结市民很多信息。封停的市民移动手机号13636033481。诉求：特此投诉。', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '服务