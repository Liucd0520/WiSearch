ne, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787606-726898', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026342, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 9, 14), '诉求地址': '闵行区浦晓路298弄晶寓', '诉求区域': '闵行区', '内容描述': '市民反映：小区内流浪狗，一直有人投食，半夜乱叫扰民，曾经出现过抓伤人的事件，对小孩子和老人的健康造成很多不便和威胁，物业管理公司完全不作为，之前联系过也没有下文。诉求：请管理部门收治流浪犬。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '上海市公安局闵行分局浦锦路派出所民警于2024年1月11日15时55分许与来电市民取得联系，具体答复内容：根据市民反映情况，其实际反映为流浪猫非流浪狗，流浪猫我所民警无法对其进行抓捕，但此前已联系居委组织对该小区流浪猫进行统一绝育，后因经费不足无法持续，待业委会成立后再开展相应整治，现已对小区爱猫人士进行宣讲告知避开群众定点投喂，减少流浪猫扰民现象（诉求过高）。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '犬类管理', '四级分类': '流浪犬收治', '主办单位': '市公安局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026012, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 10, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其房子交给中介出租，市民看到合同上的起始日期是从2024年6月开始算，市民认为合同日期不对，故来电咨询合同有没有问题', '工单类别': '一般', '处理描述': '专席忙线无法接入，建议市民拨打12348咨询律师，市民认可归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '律师服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787639-472585', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109025562, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 12, 10), '诉求地址': '浦东新区荷泽路', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:非机动车交通违法，收到了处罚短信，是由电子警察抓拍的，其有异议。', '工单类别': '一般', '处理描述': '根据《对非机动车电子警察记录的违法行为有异议该如何办理？》,《交通违法处理窗口》答复市民，市民认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787234-472228', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026142, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 12, 17), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【为企服务】市民来电咨询:在办理企业员工就业参保登记时，员工的月收入一栏没有显示，要怎样报社保登记。', '工单类别': '一般', '处理描述': '转接为企服务人保专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704787801-2818858', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026172, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 12, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:如何办理居住证。', '工单类别': '一般', '处理描述': '告知信息，认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787797-2818853', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026332, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 14, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民表示不需要转接拼多多。', '工单类别': '一般', '处理描述': '其表示不需要转接拼多多，认可，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788008-2562610', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026002, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 15, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:1月6日其在抖音商场购买了2件波司登羽绒服，订单号：6925266577938388424、6925260020019303880，价格：863元，收货后发现该产品为假货，联系抖音处理，抖音确认是假货，告知市民按仅退货并补偿200元代金券处理，市民对此不满，要求根据消法退一赔三。诉求：请管理部门核实，帮助市民维权。', '工单类别': '一般', '处理描述': '经核实，被诉企业抖音处理给予消费者200元优惠券方案，投诉人接受，经沟通双方达成调解协议，平台违法事实不成立，建议向商家实际经营地县级以上市场监管部门反映。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '假冒伪劣', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787633-472579', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026112, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 16, 29), '诉求地址': '徐汇区永福路47号', '诉求区域': '徐汇区', '内容描述': '市民来电反映:市民是其老板的秘书，其老板2023年11月27日在上述地址的Y加瑜伽会所，花费1111元购买了11次的1对1私教课程，但是现在商家无法联系上，似乎是闭店跑路了，查看了大众点评的评论发现11月29日就关门了，诉求：请管理部门协调帮助其老板全额退款。', '工单类别': '一般', '处理描述': '2024年1月17日，本机关收到对Y+瑜伽健体（永福路47号）的举报件（编号：总S202402024)。 经核实，该纳玛特健身管理（上海）有限公司永福路分公司（统一社会信用代码:91310000MA1fREPC1A 地址：上海市徐汇区永福路47号2楼和3楼...', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704787783-2562421', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026312, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 17, 2), '诉求地址': '拼多多', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费问题转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788069-2562643', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026422, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 17, 49), '诉求地址': '徐汇区淮海西路55号', '诉求区域': '徐汇区', '内容描述': '市民来电反映:上述地址门口的非机动车停放点都停满共享单车，对正常市民车辆停放带来影响，建议管理部门整治留出让普通市民停放车辆地方。诉求：希望管理部门予以考虑。', '工单类别': '一般', '处理描述': '徐家汇街道城运中心01月09日收到反映非机动车停放点的工单并于16点26分先行联系市民，请处置部门尽快与其电话联系，工单派至管理办处理。管理办于1月12日16点31分答复市民：市民主要反映淮海西路交大地铁口申通商务楼门前经常停满共享单车，耽误大楼的机动车停放，已安排车辆清运并告知单车企业以后这里不要投放。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '共享单车', '主办单位': '徐汇区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788109-2819105', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026572, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 20, 54), '诉求地址': '浦东新区龙阳路2000号3楼乐旋乒乓', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其给孩子报了上述机构的乒乓课，才上了一半的课，机构就关门了。还有4500元的钱要退。诉求：希望管理部门帮助退款。', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，涉及健身培训和体育培训的，根据市培训市场综合治理工作联席会议办公室相关文件及市体育局关于做好体育培训市场治理工作的通知精神，明确对该事项投诉调解的法定职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788270-2819221', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026602, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 21, 13), '诉求地址': '本市上海长城移动网络服务有限公司', '诉求区域': '本市', '内容描述': '重复来电：查询处理进度。【最近办结的工单编号：20231227011405，工单内容：重新交办，要求：按答复要点告知市民，市民表示答复要点与实际情况不符，市民表示使用人与实名入网一致的，没有不一致，另外市民也没退费。诉求：原诉求不变。按答复要点告知市民,市民表示答复要点与实际不符，市民称接到长城移动联系称会让代理商联系其协调，但是后续其根本没接到代理商联系，其次其对答复所述“其中3个号码激活后，使用人与实名入网人不一致”不认可，要求提供不一致的证据，现诉求：投诉长城移动虚假回复，要求尽快给其办理全额退款，并致电答复。工单内容:市民来电反映:其办理了上海长城移动网络服务有限公司的电话卡，其...', '工单类别': '一般', '处理描述': '已解释，归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788292-473112', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026722, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 23, 34), '诉求地址': '嘉定区', '诉求区域': '嘉定区', '内容描述': '市民来电咨询:驾驶证期满换证地址。', '工单类别': '一般', '处理描述': '根据,《车管所和各区交警支队是否有驾驶员体检业务？》,《办理有效期满换证手续》告知，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '驾驶员审验', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788445-473232', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026862, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 25, 7), '诉求地址': '长宁区拼多多', '诉求区域': '长宁区', '内容描述': '市民来电反映:其是消费者，要求转接拼多多专席处理。', '工单类别': '一般', '处理描述': '转接拼多多专席处理成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788588-473349', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026972, '工号': 4080, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 29, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 个人消费者要求转接拼多多专席。', '工单类别': '一般', '处理描述': '2次转接失败，市民拒绝派单，表示后续再来电，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788692-2563135', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027042, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 29, 50), '诉求地址': '金山区张堰镇 ', '诉求区域': '金山区', '内容描述': '市民来电咨询:其是残疾人，住在张堰镇区域，市民想申请公租房，希望管理部门能回电告诉市民公租房的申请渠道。（市民要求回复）', '工单类别': '一般', '处理描述': '先行联系时间：2024年1月10日 9时40分 核实认定情况：其是残疾人，住在张堰镇牡丹区域，市民想申请公租房，希望能回电告诉市民公租房的申请渠道。 处置过程和结果：接到此工单后，镇城运中心于1月10日9点16分与诉求人先行联系，进一步了解相关情况，告知了办理程序和期限，将工单派给了张堰城建中心，城建中心工作人员第一时间联系了诉求人并告知：诉求人可以到张堰社区事务受理服务中心专门窗口进行咨询及受理。 1月10日14时08分反馈告知诉求人，诉求人表示已知晓。 答复市民反馈情况：已知晓', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '保障型住房', '四级分类': '公租房', '主办单位': '金山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788746-727771', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109026852, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 31, 20), '诉求地址': '静安区老沪太路1291弄2号靠近沪太路路口', '诉求区域': '静安区', '内容描述': '市民补充信息：现电信回复其告知杆子上的箱子是移动的，但移动和电信现都不承认杆子是哪个单位插的，市民要求管理部门核实该杆子的归属并进行拆除【最近派发的工单编号：20231224019698，工单内容：市民来电反映:上述地址小区门口插了一根5G信号杠子，距离居民业主家窗口只有十几米，市民表示2021年11月份就有人来装过，然后承诺不装了，现在2023年12月24日他们又来安装了，诉求：望管理部门尽快派人查证制止。（需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231224019698，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '通信基站', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788539-473309', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027272, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 32, 8), '诉求地址': '闵行区虹梅路3219号-3223号1楼C，京世美容美发', '诉求区域': '闵行区', '内容描述': '市民来电要求暂停或撤销投诉。【最近派发的工单编号：20231227010520，工单内容：市民来电反映:其之前在上述商家充值会员卡，没有签订过协议，目前还剩余15600元,因为该商家套路太多其不想继续使用，故和商家协商退款，但是商家告知退卡用过的部分要按照原价扣款，故只能退款9000元，诉求：请管理部门核实，告知是否符合规定并协调全额退款。】', '工单类别': '一般', '处理描述': '告知无法操作，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788981-2819776', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027322, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 33, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其在企业公示系统里看到，公示的企业财务负责人是错的，问怎么改。企业名称：上海恒瑞私募基金管理有限公司', '工单类别': '一般', '处理描述': '2024.0118 15:15 多次拨打， 电话始终无人接听。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704789029-2819821', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027262, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 34, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民重复来电查询进度。最近派发工单号：20240107013819，工单内容：市民来电反映:于2023年12月30日通过”极兔“退货并上门收件，运单号：5245207052529（羽绒服）、5245591334698（裤子），收件地址：不详，寄件地址：闵行区七宝镇新镇路1036弄124号202室。因退货地址不一，故对应取件码不一。取件员上门未核对取件码且着急取走，告知将至仓库重新包装并寄出。现裤子已正确签收，但羽绒服收件方表示，收到为裤子，并正在返回。已向快递方反映多日未果。诉求：望管理部门核实，要求尽快处理。（需回复）', '工单类别': '一般', '处理描述': '建议市民耐心等待回复。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704789164-2819925', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027562, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 37, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704789324-473890', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027252, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 39, 17), '诉求地址': '松江区泰晤士小镇', '诉求区域': '松江区', '内容描述': '市民来电反映:市民是上述地址居民，投诉物业乱收费。市民家里窗户的门把手坏掉，去物业维修部申请修理（市民强调是很老的门把手）。办公室物业随便开了价格90元每个，维修工作人员认为太贵，就帮市民说话说这种把手只要10元每个。物业办公室人员朝着市民与维修工人发火，让市民出20元，剩下的160由维修工人出。诉求：请管理部门核实，告知市民门把手正确的价格。', '工单类别': '一般', '处理描述': '经方松街道分管领导签批同意，市民诉求不属实，业主家的门把手属于老型号，当初进货价是90元一个，维修工并不知情，物业维修收费的都会开具发票，不存在有乱收费的情况。方松街道新桃源物业管理有限公司于2024年1月10日先行联系市民，并对工单问题描述进行确认，由于多次联系市民均未接电话故无法先行联系。经现场查看，市民反映的泰晤士小镇维修乱收费的问题不属实。业主家的门把手属于老型号，当初进货价是90元一个，维修工并不知情，我们维修收费的都会开具发票，不存在有乱收费的情况，回复之前经协调已经修复门把手，感谢市民的理解，2024年1月19日致电市民未接电话，故无法评价。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '物业管理收费', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704788982-2563376', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027672, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 41, 5), '诉求地址': '浦东新区林耀路文腾路永耀路', '诉求区域': '浦东新区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，惠立学校门口，放学时间双边停车严重，导致车辆无法通行。12345平台举报好多次，交警大队光电话形式主义回复，没有任何整改。1月8日交警也到场，口头说1月9日会整改，但1月9日路过依然毫无改正，还是严重拥堵。离其第一次举报已经一个月，反复举报投诉5次，没有任何整改措施（详见附件）。诉求：请管理部门彻底解决违章停车问题。最近办结的工单编号：20231201022162，工单内容：林耀路297弄小区门口，惠灵顿学校放学时间门口乱停车。诉求：建议整改。（市民要求信息保密，需要回复）】（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '接工单以后，上海市公安局浦东分局交警支队五大队民警于2024年1月10日15时10分电话联系提问人，进行先期回复。 经查，因高峰时段车流量激增，受警力有限等限制，属地交警大队将尽可能兼顾提问人所述学校门口的管理，要求家长车辆即停即走，对附近交通正常秩序的影响减低。并在高峰时段加强路面巡逻警力，与大队指挥室积极配合，发现相关情况及时人工干预现场处置。该处学校上放学时间段允许家长车辆临时停靠接送学生，提问人所述的学校在上放学时间段允许家长接送学生车辆临时停靠，但须即停即走，不构成机动车道路违停要件。...', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '市公安局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027692, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 41, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其已经开通异地就医，但无法在上海买药或者特需门诊结算', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704789479-728304', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027652, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 41, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其父亲是来沪，有本市职工医保，父亲有冠心病，现咨询：父亲如何办理门诊慢性病医保报销。  ', '工单类别': '一般', '处理描述': '转接医保老师答复成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704789480-2820146', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027682, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 42, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:已申请大病医保，经所属肿瘤医院推荐在线就诊支付流程，但在线至支付阶段，被提示”大病医保无信息“。', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704789489-2820151', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027472, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 42, 51), '诉求地址': '闵行区北江桐路536弄160号', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述住户把房屋后面的绿化都围进了自家范围，还进行了改建。市民于11月29日向闵行的热线举报过，12月25日城管上门认定该户是违法行为，但后面就没声音了。诉求：希望管理部门核实，责令整改。', '工单类别': '一般', '处理描述': '浦锦街道综合执法队于1月10日接单并对诉求信息进行确认。办理情况是：绿容局上门进行鉴定，结果未出。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704789194-2563574', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109027762, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 9, 16, 44, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民2023年12月做了社保登记，但税务还没有推送系统。咨询：增连时间。', '工单类别': '一般', '处理描述': '转接人力资源专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分