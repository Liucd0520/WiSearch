办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704683229-2377835', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108010652, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 8, 11, 11, 57), '诉求地址': '浦东新区迪斯尼', '诉求区域': '浦东新区', '内容描述': '市民来电反映: 在广告中迪斯尼在宣传中有烟花表演，在跨年，并且当时门票是溢价，800左右，并且没有提前通知就取消了，离烟花表演一小时前才通知取消，市民认为对市民不友好，诉求：要求退全票，需要回复', '工单类别': '一般', '处理描述': '经调解，被投诉方表示无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条第四项之规定，故我局终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '旅游', '三级分类': '旅游信息', '四级分类': '景点投诉', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704683300-2377916', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108010762, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 8, 11, 14, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其乘坐地铁换乘公交，没有享受到换乘优惠。联系了交通卡客服被告知其刷的是虚拟卡，在地铁服务中心扣款，系统不联通，让其找地铁公司。咨询：申通地铁服务热线。', '工单类别': '一般', '处理描述': '已根据知识库“常用电话号码一览表”告知市民，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '地铁客运', '四级分类': '地铁建设', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704683373-335949', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108010932, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 8, 11, 15, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:快手上的消费纠纷，平台广州，需要转接快手并咨询如何维权。', '工单类别': '一般', '处理描述': '建议市民向北京或者广州当地12315反映，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '外省市受理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704683562-2378214', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108011082, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 8, 11, 16, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', 