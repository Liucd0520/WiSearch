ne, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035212, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 16, 49), '诉求地址': '宝山区安汾路299号车辆管理所四分所', '诉求区域': '宝山区', '内容描述': '市民来电咨询:其驾照到期需考科目一合格后恢复驾驶资格，现咨询：1月3日该处是否可以办理。', '工单类别': '一般', '处理描述': '根据《 2024年元旦节期间交警系统服务窗口对外办公时间？ 》,《 机动车驾驶证“逾期未换证”和“注销可恢复”的含义 》,《 办理恢复驾驶资格手续 》信息告知办理。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '驾驶员审验', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704197368-2434922', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035352, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 16, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询处理进度或者市民来电反映相同事项。【最近派发的工单编号：20231227015052，工单内容：市民来电反映:2022年01月30日、02月08日、14日在抖音商城购买了化妆品，共花费：2697多元，订单号：4893947279099453268、48939423012351175252、4897235579072823124、4899516679161745236，参与免单活动，但至今都未收到免单的退款，商家表示已退款到市民账户，但市民并未收到，故市民来电反映，诉求：请核实确认帮助市民处理解决。（需回复）】\n', '工单类别': '一般', '处理描述': '已告知管理部门正在处理中，建议市民耐心等待，市民认可故归档。\n', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704197663-655667', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035412, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 23, 40), '诉求地址': '浦东新区下南路551弄南新四村', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址小区内经常会有使用非机动车或家具等占据停车位的情况，小区居委会和物业一直没有处理，只是和稀泥。市民诉求：投诉小区居委会和物业没有对占据车位的现象进行管理。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '通过沟通，居委会与物业不存在不处理私占私用公共车位的情况。居委会告知居民：首先，保安加强巡逻，劝阻私占私用公共车位的行为。其次，如果发现私占私用公共车位的现象，可以拨打58532690物业保安电话，保安现场处置搬离公共车位上的电瓶车和自行车等物品。再者，如果发现公共车位上私装地桩锁，居委会与物业会上报城管部门依法拆除。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704197958-655743', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035482, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 27, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其没有乘坐过963路公交，1月2日扣的是2023年12月17日，12月18日（5:49分，18:23分，扣了2次)，12月20日，12月21日，一共扣了10元，是微信乘车码，手机号码：13818076272，诉求：告知为何会出现该问题，为何会扣款的问题。', '工单类别': '一般', '处理描述': '2024-01-04 10:08:50 通过电话60755658致电您，经核实上述扣款均为12月份公交乘车延时扣款，已告知您后续可通过微信小程序-乘车码-乘车记录内查询，您表示认可。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '公共交通用卡管理', '四级分类': '交通卡', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704198118-2693000', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035602, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 32, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704198491-655882', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035462, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 33, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其反映拼多多问题，拼多多不接其电话，不要求转接，但是又表示其有情绪病，其不知道该怎样反映。', '工单类别': '一般', '处理描述': '根据”主动挂机流程“挂机，此单归档。 ', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704198270-400430', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035542, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 37, 9), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电反映:咨询2015年注册的外牌私家车第8年是否需要年检，根据《机动车的年检周期是怎么规定的？》告知，市民认可，市民要求派单咨询第八年年检过期且存在未处理的违章该如何申请免检的流程。', '工单类别': '一般', '处理描述': '交警总队车管所于2024年1月3日13时31分与市民联系。宝山公安分局交警支队车管宣传大队于2024年1月4日10时57分与市民联系了解情况：经了解，市民询问车子第八年如何进行上限验车。宝山公安分局交警支队车管宣传大队于2024年1月8日16时26分再次与市民取得联系并答复告知其：经查，市民现已处理好车辆违章并已经验好车辆。市民对答复表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '车辆年检', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704198363-2435173', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035842, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 40, 31), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704199119-400648', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035772, '工号': 3940, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 41, 39), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231222030736，工单内容：市民来电反映:其在拼多多平台上购买了鸡肉粒，金额：13.86元，订单便编号：231118-329258188321900，市民称里面有白色异物。诉求：请管理部门核实要求给市民合理处理方案。、】', '工单类别': '一般', '处理描述': '要求转接拼多多，市民反复催单，已电子催单工单编号：20231222030736，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704199026-400620', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035862, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 43, 55), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其妻子名义购买了一辆新车，妻子名下已经有一辆上着沪牌额度的旧车。现在妻子想要将旧车过户给丈夫，然后大牌在上到新车上，旧车用其的名义上沪C牌照。', '工单类别': '一般', '处理描述': '根据《 办理机动车变更共同财产所有人手续 》《 沪C号牌（汽车）申领条件及上牌办理地址在哪里？ 》告知，市民知晓，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704199189-656081', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035872, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 44, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 2023年12月23日拼多多平台80多元购买奥斯卡无线可视挖耳勺菜耳工具，收到的货与实际不一致，所有的东西都退回，商家拒收和拼多多不作为。诉求:请管理部门协调退款。（需回复）', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704199205-2693289', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035952, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 47, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其是个人消费者，需要转接拼多多服务专席。', '工单类别': '一般', '处理描述': '20:46为其转接拼多多服务专席，工号44212老师受理，转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704199527-2693384', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102035942, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 53, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:兼职收取服务费，不退费。', '工单类别': '一般', '处理描述': '与市民解释说明，市民认可，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704199703-2435518', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102036182, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 2, 20, 57, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231225021568，工单内容：市民来电反映:12月12日拼多多上购买干贝素汤料包，订单号：231211-534716149192967，价格：99元，因商家发货太慢，其申请了退款，平台承诺补偿运费，但后续联系拼多多申请运费补偿，拼多多就一直拖。诉求：要求拼多多赔偿14.5元的运费。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231225021568，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704199969-400832', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102036162, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 2, 21, 8, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民家中在进行装修，装修公司和其说非承重墙都是可以敲的，且拿来了开发商的整个平面图，但准备敲的时候物业却过来指了很多墙不让敲，且物业指的那些墙都不是承重墙。诉求：请管理部门答复市民哪些墙是可以敲的。', '工单类别': '一般', '处理描述': '本单位工作人员于2024年1月10日9:36许，多次拨打电话13917687838，均无法接通。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '城管执法', '主办单位': '市城市管理行政执法局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704200128-2693528', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102036482, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 2, 21, 18, 48), '诉求地址': '长宁区拼多多', '诉求区域': '长宁区', '内容描述': '市民来电反映:其是消费者，要求转接拼多多专席处理。', '工单类别': '一般', '处理描述': '转接拼多多专席处理成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704201414-2435896', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102036382, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 2, 21, 20, 5), '诉求地址': '普陀区骊山路260-262号', '诉求区域': '普陀区', '内容描述': '市民来电反映:市民是上述地址宜川一村的租客，市民想申请该处的停车位，但是物业直接表示要收一条烟才能帮其办理，市民对此不认可，诉求：投诉该处物业，协助市民办理停车位。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '宜川街道1月3日接单，9时许先行联系市民，诉求人反映情况与工单诉求基本一致。经宜川路街道北片区核实，诉求人反映情况部分属实。先行联系，表示事情解决了，不需要再处理了。责任人，刘成荫，经办人，黄慧。电话，56088418。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704201129-401064', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102036602, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 2, 21, 30, 47), '诉求地址': '浦东新区川沙新镇民义村', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:上述地址的农村自建房，宅基地是否可以收停车费。市民表示其是租客，被告知2024年1月10日开始需要缴纳停车费，缴费标准是120元一个月，一年1200元，一天是15元左右，且没有固定停车位，市民认为不合理。诉求：请管理部门回复告知该收费是否合理，是由哪个部门收取的。', '工单类别': '一般', '处理描述': '尊敬的市民您好：按照《物权法》等相关规定，占用村宅村民共有道路或其他场地用于停放汽车的车位，其资产属于村民共有。对村民共有场地设置停车位，应由村民代表大会确定，现我村停车收费实施方案是通过村民代表大会表决，且到会村民代表全部同意通过，属于合法有效，可按规定进行收费。仅限本村户籍村民免费。感谢您理解和支持！回复录音过大，无法上传，已报备', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '乱收停车费', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704201813-401203', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102036642, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 2, 21, 34, 45), '诉求地址': '闵行区春东路 一古森活2楼 新锐摄影', '诉求区域': '闵行区', '内容描述': '市民来电补充信息。信息内容为相关部门告知市民事件处理完毕请市民自行向法院起诉，市民不认可，诉求：请管理部门尽快给予回复。【最近派发的工单编号：20231227000369，工单内容：市民来电反映:其在大众点评上找了一家摄影培训 机构，发现该机构没有资质的新锐摄影。市民支付了6000元，之后上课也非常随意。市民表示属于教育机构。诉求；希望核实，要求全额退款。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231227000369，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '培训市场', '四级分类': '市场监管', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704202037-656660', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102036882, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 2, 21, 51, 17), '诉求地址': '普陀区金鼎路', '诉求区域': '普陀区', '内容描述': '市民来电反映:普陀区金鼎路上，机动车违法停车在非机动车道上。', '工单类别': '一般', '处理描述': '转接普陀交警支队成功,归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704203232-2694057', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102036962, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 2, 22, 5, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其是拼多多的个人消费者，要求转接拼多多客服。\n', '工单类别': '一般', '处理描述': '已告知市民拼多多的在线客服工作时间是8:00-21:30，市民认可，归档。\n', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704204257-656921', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102036982, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 2, 22, 14, 26), '诉求地址': '去哪儿网', '诉求区域': '本市', '内容描述': '市民来电反映:1月2日凌晨其在该处平台买了两人机票，支付了1971元，其没有看清楚时间，错买了1月4日的，其要买1月24日的，市民对该处退费不满。', '工单类别': '一般', '处理描述': '根据《 外省市主流网站名称地址 》告知去哪儿网平台属地在北京市，请市民联系北京市民热线反映，电话：010-12345反映。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '外省市受理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704204419-656934', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102037082, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 2, 22, 21, 24), '诉求地址': '崇明区向化镇春光村阜南678号（阜南6号路到六角港过桥的路口））', '诉求区域': '崇明区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，市民反映合作社冷库确实还是有噪音扰民，彩钢板不是隔音设施，现诉求：望管理部门尽快再查处制止。最近办结的工单编号:20231202000108工单内容：市民来电反映:上述地址有一个合作社的冷库，总是发出不规律的噪音，只要启动就会产生噪音，关闭就没有了，长期存在噪音扰民问题，12月2日凌晨1:00更是夜间扰民，诉求：请管理部门核实并解决噪音扰民问题（市民要求信息保密 需回复）】（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '镇规环办工作人员前往现场查看，经了解，该冷库属于展琦蔬菜专业合作社，近期冷库使用时间多在夜间，经走访距离最近的两户村民，发现并不存在噪音扰民的情况；且为避免影响周边居民的正常休息，冷库负责人已在冷库周围围有彩钢板隔音（详见附件），并不存在噪音扰民情况。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '崇明区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704204895-656983', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102037092, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 2, 22, 26, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2023年12月31日通过德邦快递寄的快递，上海-辽宁，重量在50KG一下，快递单号是DPK202254368647。市民表示其寄的快递只有两双鞋子，实际重量不足3公斤，被收取了86元，快递面单上写着按重量计费，显示为15公斤。市民不认可。市民告知其已经向德邦快递反映过问题，但也没有得到解决。诉求：请管理部门查处并退回剁多收的运费。', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704204953-401570', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102037132, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 2, 22, 27, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民在拼多多平台上购买了衣服，订单号：231222-674737693743254，实际支付了199元，后面其向平台处申请开具发票，但平台一直没给其开，还给其了一个商家的户籍地址。诉求：请管理部门核实处理，协助市民开具发票。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '匿名用户： 2024-01-02 ,您致上海税务网站/12366税务咨询服务热线的来信收悉（编号 沪税电举[2024]00633）。经研究，现答复如下： 税务二所:1、经审核不属实，寻梦无开票义务。上海寻梦信息技术有限公司为电子商务平台经营者，商品销售和运输由电子商务经营者（商户）承责完成，商品的相关票证由电子商务经营者（商户）开具。对举报人的诉求已通过口头的形式对其进行了税法宣传（电话回复时间:1月8日）。若举报人需要发票，可要求销售方提供发票。 2、经核实，现销售方拒绝提供发票，我局已要求平台提供销售方信息，告知举报人通过当地12366进行举报。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '税收管理', '四级分类': '偷税漏税', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704205407-2694272', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102037152, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 2, 22, 38, 21), '诉求地址': '奉贤区市场监管局', '诉求区域': '奉贤区', '内容描述': '【投诉】市民来电反映:其于2023年9月8日在“12315”平台上反映了“上海兮靓化妆品有限公司”销售特殊化妆品，存在没有注册备案号，生产厂家虚假的问题，工单号：1310120002023090841537724，但后面其查询到该工单的状态显示处理完成了，但其并没有收到任何结果，且之前也反映过该问题，也没有得到答复，其要投诉奉贤区市场监管局不作为。诉求：请管理部门核实处理不作为的问题，市民请求上海市奉贤区市场监督管理局局长主管副局长引咎辞职。', '工单类别': '一般', '处理描述': '经查询，市民通过全国12315平台分别于2023年8月5日、2023年9月8日向我局反映与“上海兮靓化妆品有限公司”之间存在消费者权益争议及举报该企业存在违法行为的事项（投诉工单编号1310120002023080546057886、举报工单编号1310120002023090841537724）。经核查，该企业因通过登记的住所无法取得联系，已被列入经营异常名录，故双方消费纠纷我局按规定终止调解；市民反映的违法行为线索，我局已按规定立案，因该企业失联，目前处于案件中止调查状态。我局已按规定通过全国12315平台系统向市民反馈投诉、举报处理结果。以上处置内容均符合《市场监督管理投诉举报处理...', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704205612-2436372', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102037202, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 2, 22, 39, 25), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:希望转接拼多多。', '工单类别': '一般', '处理描述': '根据知识库《  转接承办单位座席流程 》告知市民，市民认可，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704206290-2436417', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102037452, '工号': 3292, '工单生成时间': datetime.datetime(2024, 1, 2, 23, 36, 47), '诉求地址': '宝山区大华三路新沪路', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述路段1月2日23:30还在进行道路施工，已经持续几天晚上进行施工，噪音扰民严重。市民诉求：希望管理部门对于该出夜间道路施工噪音扰民问题进行处理，希望不要在夜间施工。', '工单类别': '一般', '处理描述': '经核实并来哦接情况后，于1月3日中午11:59分电话市民，告知：您反映的新沪路大中修工程，目前已到路面铣刨和路面摊铺沥青工序阶段。夜间施工是根据交通管理部门（公安交警）要求，现场受白天交通流量密集影响，为了避免白天交通阻塞拥挤等情况，故安排在夜间进行。新沪路路大中修工程于上周已全部完工。公路科杨天睿：56847532。（见附件）', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704209613-657321', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103000042, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 3, 0, 46, 59), '诉求地址': '浦东新区东方路儿童医院', '诉求区域': '浦东新区', '内容描述': '市民来电反映: 1月1日其孩子到该处检查为肺炎，1月2日21：00多分因孩子发烧到该处要吊水，该处将孩子分为四级，排队到1月3日0:45分还有20几个号，只有一个诊室就诊，有200-.300个发烧孩子在等待就诊，市民质疑为何看不了这么多孩子会给挂号，医院应安排医生加班就诊，现诉求：望管理部门尽快安排医生到该处就诊。（市民非常急要求于1月2日晚上处理答复）', '工单类别': '次紧急', '处理描述': '经查当班医生全部在岗，当前呼吸道感染者就诊高峰，人力资源短缺，等候时间相对延长。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '疾控防疫', '四级分类': '求医问药', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704213262-2436710', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103000162, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 3, 2, 15), '诉求地址': '浦东新区大同路358号第七人民医院', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民于1月2日22:00多到上述医院挂了一个急诊的号，随后去验了血，等到1月3日0:00多才拿到报告，随后继续排队开单子，但一直等到了2:00多还没有排到。诉求：请管理部门核实处理上述医院急诊排队时间过长的问题。', '工单类别': '一般', '处理描述': '已施行急诊内科医生加班，增设诊室医生坐诊等措施。呼吸道感染患者都需做一些相应检查，故取检查结果返诊都需等候时间。经解释沟通蔡先生表示知晓，满意接受。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '排队挂号', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704219000-402102', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103000212, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 3, 3, 15, 39), '诉求地址': '奉贤区观工路和楚华北路交叉口往东南约200米左右上海司卡图标识制作设计有限公司', '诉求区域': '奉贤区', '内容描述': '市民来电咨询:咨询奉贤区劳动监察大队地址。', '工单类别': '一般', '处理描述': '根据《奉贤区人力资源和社会保障局》告知，市民认可，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '机关事务管理', '三级分类': '机关事务管理', '四级分类': '机关事务信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704221528-2436803', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103000322, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 3, 6, 20, 2), '诉求地址': '闵行区虹桥火车站内的雷锋驿站', '诉求区域': '闵行区', '内容描述': '市民来电反映:市民表示其于1月3日6:00左右要在上述火车站乘坐高铁，由于其感冒了，且周边的药店都没开门，看到上述有个雷锋驿站，故进去想要购买或者讨取一个口罩，但工作人员直接答复说没有，且工作人员自身带着口罩，其表示该处挂着雷锋驿站的名号却不行雷锋之事。诉求：请管理部门核实处理，给到市民一个答复。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': '上海铁路局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704233663-2694825', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103000332, '工号': 4012, '工单生成时间': datetime.datetime(2024, 1, 3, 6, 28, 6), '诉求地址': '本市三鲁公路', '诉求区域': '本市', '内容描述': '市民来电反映:市民表示其购买的商品房里卫生间存在漏水的问题。', '工单类别': '一般', '处理描述': '市民不知具体的地址，建议其查询好后再来电反映，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '工程质量', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704234029-402266', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103000732, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 3, 7, 54, 28), '诉求地址': '大众出行', '诉求区域': '本市', '内容描述': '市民来电反映:其是大众出行的网约车司机，车牌号：沪ABA9894，12月29日4:20市民接了一笔订单，从黄浦区太阳都市花园到浦东机场T1航站楼，在接驾途中乘客取消了订单，订单号：2312296956262164261,平台有规定，乘客取消订单给司机有取消补偿，但是该笔订单没有给市民取消补偿，诉求：希望管理部门核查要求平台尽快给到市民取消补偿。    ', '工单类别': '一般', '处理描述': '核查处理结果：约约工单号：204508150337。补偿条件： 需同时满足如下6大类条件后，才可获得空驶补偿 ： 订单因「？司机责任」取消 ； 司机等级？银及以上 ； 成交率95%及以上 ； 空驶？程1公？以上 ； 主动与乘客沟通：接到订单后，3min内主动与乘客沟通 ； 按照导航规划路线及时接驾，？其他诱导取消、作弊等？为。查看司机接驾轨迹3:33:14轨迹偏航未按导航，未满足条件故无取消费。1月7日11:58联系市民（司机）沟通解释，不接受。保留意见', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704239237-402566', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103001142, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 3, 7, 56, 44), '诉求地址': '无', '诉求区域': '本市', '内容描述': '录音中疑难人员反映疑难问题。', '工单类别': '一般', '处理描述': '归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704220597-2694713', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103000862, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 2, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:做过家庭共济，带小孩子去医院看病没有从帐户扣费。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704239984-2437244', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103000852, '工号': 3662, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 2, 27), '诉求地址': '松江区中山二路125弄小区和岳庙中间', '诉求区域': '松江区', '内容描述': '市民来电反映:之前有反馈上述地址清运垃圾时间过早问题，管理部门后续处理，确实解决，变成9:00多清运，但是现在死灰复燃，不到8:00又来了，诉求：请管理部门核实后对此处置，要求9:00后来清运。', '工单类别': '一般', '处理描述': '12345服务热线接单后派单至松江区绿化市容局。经分管领导签批同意，市民诉求属实。区绿化市容局市容环卫中心于2024年1月3日先行联系市民，并对工单问题描述进行确认。接单后净达公司调查核实，因之前诉求人多次诉求下，公司表示因车队是根据季节性及垃圾量安排行车路线，先确保8点半之后，尽量9点之后。2024年1月8日电话答复市民，其表示满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704239951-2437240', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103000902, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 5, 1), '诉求地址': '浦东新区惠南镇宣黄公路2878弄34号鸿园坊', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民是上述地址居民，投诉物业随意处理垃圾。原来小区的垃圾应该扔在西面一幢楼的转弯处，但物业于2024年1月3日将垃圾放在34号楼口内。市民与物业反映，物业也不愿意调取监控，此类情况已出现多次。诉求：要求管理部门对物业随意处置垃圾的行为进行处理。（市民需要信息保密，无需回复）\n', '工单类别': '一般', '处理描述': '南园居委接报后，立即派员赶赴该楼道核实情况，