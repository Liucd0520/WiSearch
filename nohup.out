类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021142, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 38, 37), '诉求地址': '普陀区真如镇街道真北路2653号天地科技园 光彩公寓', '诉求区域': '普陀区', '内容描述': '市民来电反映:上诉地址为公寓，市民是包月支付停车费，但因为物业没有及时和业主对接，导致市民没有办法线上支付停车费，外出时一定要支付停车费，事发时间为2024年1月3日，诉求：投诉上述公寓的物业。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '真如镇街道真光片区在1月3日接单，于3日先行联系，于5日回复。来电人反映情况不属实。针对来电人12月份停车费用未及时续费，导致1月3日出门时出现缴费的问题，经现场了解，包月停车费为业主在线自主续费完成，不存在物业与业主需要及时对接的事宜，故来电人反映情况不属实。1月3日外出需要支付停车费，主要是因为包月费为未及时在线缴纳所导致，物业方表示因未及时缴纳包月停车费所造成的额外费用，可以予以退还。1月5日，片区工作人员于将情况告知来电人。经办人：谢逸帆；联系电话：:52715973', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263607-465193', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021402, '工号': 2810, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 40, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:本市哪些医疗机构可以给梅毒阳性人员做血透（需要传染病专用设备）', '工单类别': '一般', '处理描述': '建议市民咨询瑞金医院 （地址：瑞金二路197号 电话：64370045）、华山医院（地址：乌鲁木齐中路12号 电话：52889999 门诊服务咨询电话：52889997）、公共卫生临床中心（市区分部）（门诊部地址：上海市水电路56号（近同心路） 电话：021-37990333）、公共卫生中心（金山总部）（住院部地址：金山区漕廊路2901号（近山阳路） 电话：37990333 ）。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '卫生信息', '四级分类': '医院医疗信息', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263879-465435', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021362, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 40, 35), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:咨询医保支付的问题，妈妈是慢性病，配药跑好几个医院，市民发现京东可以买药，想问刷医保卡支付上有何区别。', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263817-2500826', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021282, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 40, 44), '诉求地址': '浦东新区13号线学林路地铁站3号口', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其电动车停在上述地址地铁站门口，12月30日停放在此处，12月31日出地铁站还看到的，后续忙事情去了，1月3日再次发现电动车不见了。市民表示当时上牌安装过定位器的。车牌不记得。身份证：360425199308122031。诉求：望管理部门核实，是否可以根据当时安装的定位器找到电动车。', '工单类别': '一般', '处理描述': '尊敬的市民您好，您所反映的电动车被盗问题，经调查核实，由于您上牌安装定位器的时间为2019年，距今已经数年之久，定位器的电池已没有电量，故无法通过定位器找回您的电动自行车，感谢您对于我们工作的理解。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263734-2500741', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021312, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 41, 18), '诉求地址': '青浦区华新镇星尚湾业委会', '诉求区域': '青浦区', '内容描述': '市民来电反映:其是上述地址业委会人员，市民表示之前想上海市青浦区税务局提交了书面的问询，咨询针对企业的相关问题，但是现收到税务局的书面答复，只是引用了条例，并没有正面回答市民问题，故来电投诉青浦区税务局。诉求：希望管理部门核实，并要求市税务局给其答复', '工单类别': '一般', '处理描述': '经调查，该事项无政策信息。 关于您反馈的政府信息公开书面答复事宜，经核实，青浦区税务局根据市局机关答复规范和要求对您的涉税咨询问题进行答复，向您解释相关情况，您表示不接受。该情况也将进一步请示市局，您表示已知晓。 以上回复内容仅供参考，具体以法律、法规及相关规定为准。 先行联系时间： 2024年1月4日10:00时，回复时间：2024年1月11日15:15时。问题情况：解释说明，纳税表示：不接受。——承办单位：青浦区税务局办公室', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '其他', '四级分类': '其他', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263799-2500807', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021082, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 42), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:浦东新区劳动仲裁的电话以及地址在哪里。', '工单类别': '一般', '处理描述': '根据《全市劳动人事争议调解仲裁机构》答复市民，市民认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '劳动争议', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263586-2758330', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021172, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 42, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:单位有员工的八大员证书有效期到2023年底到期，市民表示向管理部门申请给快到期的八大员执证人员尽快进行配需考试，管理部门回复说八大员证书按规定可以延续到2024年5月。诉求：希望管理部门能告诉市民在哪能查询到八大员证书有效期延续到2024年5月的相关政策规定。', '工单类别': '一般', '处理描述': '市民预留的电话多次拨打始终无法接通，提示一直在通话中无法接通。日前在上海建交人才网通知公告栏中已发布《关于进一步加强上海市住房和城乡建设领域施工现场专业人员培训工作要求的通知》，该通知中明确了施工现场专业人员的初证、继续教育的工作要求及工作流程、证书信息更新、继续教育报名相关事宜，各有关单位应按照要求组织开展工作。由上海市住房和城乡建设管理委员会于2015-2018年期间颁发的八大员证书的继续教育换证工作截止至2024年6月30日。如您收到相关信息仍有疑问可拨打63129648咨询。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '其他', '四级分类': '其他', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263625-465213', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021442, '工号': 2960, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 43, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:在拼多多购买了监控，有充值流量的费用，因为有质量问题，市民将货退回去了，但流量费用没有退，金额499元，订单编号：230801-023079187310604，市民也和市场监管局，2024年1月3日14:42回复市民，说无法调解，诉求：望管理部门核实并尽快退换流量费用。', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263913-465477', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021942, '工号': 2832, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 46, 39), '诉求地址': '浦东新区三彩路52弄8号楼门口', '诉求区域': '浦东新区', '内容描述': '市民反映：上述地址楼下堆放很多木板。诉求：请管理部门清理垃圾。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '您好，这里是士韵二居居委。经居委现场核实后，立即会同物业对现场监控进行抽调，得知为居民搬家，尚未来得及将废弃家具运至建筑垃圾堆。现已将木板清理完毕。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '垃圾清理', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021572, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 47, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民是上海的企业，对2023年12月份税务总局设定开票限额的政策进行投诉，开票系统规定，针对各企业上六个月的营业额，对每个月开票额度进行规定，该规定对市民的企业造成的问题是每个月开票40000元左右。市民认为政策设定不合理，企业之前的营业额不代表以后没有销售额。根据之前的营业额规定以后的开票额，对企业不公平。诉求：要求税务局对开票限额的规定进行整改。（无需回复）', '工单类别': '一般', '处理描述': '您的意见已收悉。感谢您对税收事业的关注和支持，若您有税收事宜咨询，欢迎拨打12366税务热线。', '客户类型': '企业', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '税收政策', '四级分类': '企业征税', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264026-2758733', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021512, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 48, 12), '诉求地址': '嘉定区前杨路118号  上海孟超肿瘤医院', '诉求区域': '嘉定区', '内容描述': '市民来电反映:2年前在上述医院肿瘤科就诊，患者姓名：拒绝提供。在医院做了CART的治疗，但是开具的是健康咨询服务发票，金额：8万元。当时投诉后有医院联系过其，但是碰到上海疫情又不了了之了。诉求：请 管理部门核实该医院是否有做CART治疗的资质，为何不能开具正规的医疗发票', '工单类别': '一般', '处理描述': '嘉定区卫生健康委员会监督所经核实后反馈：上海孟超肿瘤医院CART细胞治疗是一项临床研究项目，有临床研究合作协议，并通过上海孟超肿瘤医院伦理委员会院内审查审批，不收取任何诊疗费用， 8万元是健康档案管理服务、健康检查服务等服务费。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '其他', '四级分类': '其他', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264014-675292', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021562, '工号': 3850, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 48, 57), '诉求地址': '徐汇区龙漕路299号2幢3层南部301室，上海锐赏文化传播有限公司', '诉求区域': '徐汇区', '内容描述': '市民来电反映:其1月3日2:29在上述公司购买780元演唱会门票，下单页面显示若退票只扣服务费，现在票没出，市民申请退票，却要被扣除50%票面费，市民不认可，订单编号24001200376，诉求：只接受下单页面显示若退票只扣服务费的要求，希望协调处理', '工单类别': '一般', '处理描述': '2024-1-6 11:25联系市民，市民表示所反映的事情经协商一致，问题已解决。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264040-2758750', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022002, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 49, 18), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:医保卡缴费问题。', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264438-2501404', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021532, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 49, 32), '诉求地址': '徐汇区徐汇区南丹东路300号9号楼1楼 上海韦德健身管理有限公司', '诉求区域': '徐汇区', '内容描述': '市民来电反映:投诉市文旅局执法总队不作为。市民表示其咨询过浦东法院和徐汇法院，对于一兆韦德的事情法院明确表示不受理。且一兆韦德在工商处未注销，注册资金还扩大到了4500万美元，诉求：投诉市文旅局执法总队不作为。相关联工单编号：20231204005176。', '工单类别': '一般', '处理描述': '2024年1月8日，本机关收到总队下发的对南丹东路300弄的一兆韦德徐汇店的预付费件（编号：总S202400887）。 市民投诉事项不属实。从公开信息看，基层人民法院在持续处置相关涉诉案件。具体涉诉事项请联系司法部门。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263988-675268', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021662, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 49, 56), '诉求地址': '长宁区延安西路1573弄194支弄3号', '诉求区域': '长宁区', '内容描述': '市民来电反映:上述地址在1996年的时候动迁，动迁到昭化路518弄10号602。当时没有办产证，也找不到当时的动迁组了。诉求：希望管理部门帮助，找到动迁组办产证。', '工单类别': '一般', '处理描述': '新长宁于2024年1月4日接单并于11：35电话联系，新长宁装饰公司于2024 年1月4日接单，于当天下午15:05 分通过电话先行与当事人沈某联系。经核实其1996 年动迁 到昭化路518 弄10号602，当时由于其本人原因没有在规定时限内及时办理产证，时隔20多年后想办理产证了。已明确告知居民需要办理产证，需要找到原动迁公司，并提供以下资料(房屋确认单、动迁协议、结账单)后方可维续办理。因时间久远 ，原动迁公司已关闭经营 ，装饰公司会在居民资料准备齐全后帮助办理进户手续。1月8日15：10，再次告知其需要提交的资料，对方表示理解，并对处理结果满意。该问题已解释说明。经办人：新长宁装饰公司。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '征收管理', '四级分类': '拆迁安置', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264145-720941', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022102, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 51, 20), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:未自己目前办理居住证。系统显示制作中，查询制卡进度。', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264529-721284', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022072, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 51, 29), '诉求地址': '青浦区蟠龙路', '诉求区域': '青浦区', '内容描述': '市民来电反映:土方车经过此处，泥土掉在路面产生扬尘。诉求：望管理部门核实即使清理道路泥土。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '【此工单内容属实】徐泾镇城运中心于2024年1月3日接单，因诉求人未留联系方式，故先行联系未果。2024年1月3日，由西虹桥社管中心工作人员，对诉求人反映的情况进行核实。办理情况：经核实，蟠龙路及蟠中路道路渣土，是由于周边工地出土，土方车掉落渣土造成。区域道路保洁已加强冲洗频次及清理频次。同时西虹桥社管中心已将该问题向城运中心反馈。将该事件向城管反映，控制源头，对违规土方车进行查处。因诉求人未留联系方式，故处置回复未果，该问题已解释说明。经办人：李俊', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '道路扬尘', '主办单位': '青浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264521-2501484', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103021552, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 51, 29), '诉求地址': '闵行区申虹路1088弄27号臻颜荟', '诉求区域': '闵行区', '内容描述': '市民来电反映:11月6日市民被医托忽悠称到虹桥医院进行皮肤护理解决皮肤问题，可以享受1200元的内部价，11月8日到达上述机构后市民发现是医美机构，且工作人员未提及内部价问题，而是直接给市民推荐了一个3.9万元的少女肌套餐，市民表示其未带那么多现金，后实际支付21200元，但做完后并未出行皮肤效果改善情况。诉求：请管理部门核实，帮助市民退款。', '工单类别': '一般', '处理描述': '联系臻颜荟医疗美容，了解臻颜荟医疗美容已联系来电人，申请闵行区医患纠纷调解委员会调解，因来电人一直在外地，无法到现场调解，但处理方案已经达成一致。后来电人多次跟医调委申请线上办理调解协议，医调委老师根据她本人的实际情况，将相关资料准备好后，已经在1月15号左右开始对她本人的诉求进行相关的司法流程。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医院监管', '四级分类': '医疗纠纷', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704263986-2500979', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022382, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 52, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民反映：学校组织旅游，这一笔操作不利没有备注，后来又重新付费备注了，所以想申请第一笔退费，商家留的联系方式打不通，老师也没有联系方式已和支付宝客服沟通说对方会联系商家尝试退费，就是不知道最后是否联系的上（详见附件）。诉求：请管理部门协助重复缴费退费。', '工单类别': '一般', '处理描述': '旅行社与金鹤小学联合组织学生2024年1月17-18日安吉研学旅行，1月3日启动家长二维码付款，因李普女士未备注学生信息，又重新二次付款。后联系旅行社400号码无人接听，故致电12315，今天收到投诉后公司特别重视，第一时间和她联系已经退款到位。李女士表示非常理解', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '旅游', '三级分类': '服务质量', '四级分类': '旅行社服务', '主办单位': '市文化旅游局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022042, '工号': 2920, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 54, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264791-466268', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022252, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 54, 18), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其个人名下车辆是2018年注册登记的，市民表示去年车辆年检过了，今年车管所又通知其车辆年检，来电询问原因。', '工单类别': '一般', '处理描述': '转接车管所专席,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '车辆年检', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264696-466194', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022632, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 57, 23), '诉求地址': '浦东新区高桥镇凌桥二村', '诉求区域': '浦东新区', '内容描述': '市民反映：其2024年1月3日去外婆家，楼道里堆物，人都没法走路了。诉求：请管理部门整治楼道堆物。', '工单类别': '一般', '处理描述': '尊敬的市民，您好！高桥镇凌桥居委给您回复： 经核实，上述地址为高桥镇凌桥二村小区，由凌桥居委属地管理，宏途物业提供物业服务。经了解，该小区为1995年建造老小区，对于诉求人反映的问题，居委第一时间到该小区查看，小区个别楼道确实有乱堆物的行为，本周一和周二物业安排保洁员已经对小区全部楼道进行清理，居委也会监督物业之后对小区楼道进行定期清理，对您生活造成的不便敬请谅解，感谢您对凌桥居委工作的理解和支持！', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022342, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 58, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704264861-2759527', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022452, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 3, 14, 58, 35), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。市民确认是公安局负责的。【最近派发的工单编号：20240103020134，工单内容：市民来电反映:市民是律师，1月3日13:30左右在随申办上“保障律师执业一件事”提交了案件信息，去向为看守所，市民姓名：柳向，身份证号：410426198903107043，需要帮助加快审核时间。诉求：请管理部门核实并帮助加快审核。】', '工单类别': '一般', '处理描述': '已代为催单，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '电子政务', '三级分类': '一网通办', '四级分类': '办事流程', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704264923-721655', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022702, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 0, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:青浦区燃气公司的联系方式', '工单类别': '一般', '处理描述': '根据《上海市管道燃气公司服务电话汇总表》告知市民，市民认可，故归档', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '燃气', '三级分类': '燃气服务', '四级分类': '信息咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704265104-2759739', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022652, '工号': 3152, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 0, 59), '诉求地址': '本市拼多多', '诉求区域': '本市', '内容描述': '市民来电补充信息。市民补充信息内容为拼多多要其提供三甲医院的证明，询问客服医院看病的费用谁来出，客服不回答其，市民认为平台故意在刁难其，提供的链接输入个人信息也查询不了商家的营业执照信息。【最近派发的工单编号：20231226011096，工单内容：市民来电反映:其在上述平台购买了一款百消膏，可以治疗牛皮癣，市民使用后发生过敏，查询后发现该药品没有治疗作用，向平台反映一直未得到答复和处理，订单号：231211-235153693581603，消费金额：30元，市民表示平台虚假宣传，要求退一赔三不足500按500计算。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231226011096，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704265064-2759709', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103022742, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 3, 15, 1, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求投