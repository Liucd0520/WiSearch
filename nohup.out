'投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109004242, '工号': 4350, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 40, 15), '诉求地址': '崇明区鼓浪屿路999号和睦家苑', '诉求区域': '崇明区', '内容描述': '市民来电反映:其为上述地址原居民，在2020年和当地签约拆除旧宅集体居住，约定拆除后先支付50%补偿款已经拿到。后续的余款工作人员告知市民需要等到房屋验收后才能领取。市民诉求，希望剩余的50%的款项可以尽快收到，或者有关部门能告知何时能拿到余款', '工单类别': '一般', '处理描述': '我单位于1月9号接单，于1月9号10点30分使用双呼系统先行联系来电人。庙镇政府派单至村建所，现回复如下：2024年1月11日与来电人联系，解释说明，经查，目前2020年无置换农户还未全部拆除，等房屋全部拆除，验收通过后发放剩余款项，预计2024年下半年发放，具体时间等通知。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '征收管理', '四级分类': '拆迁安置', '主办单位': '崇明区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704763866-662394', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109004782, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 42, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其要新车上牌，询问今天是否可以直接到车管所办理', '工单类别': '一般', '处理描述': '转接车管所专席成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764367-2497270', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109004682, '工号': 4282, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 43, 4), '诉求地址': '静安区大宁街道平型关路615弄', '诉求区域': '静安区', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民称管理部门至今未联系市民，请管理部门尽快处理并给到市民答复。【最近派发的工单编号：20240108010159，工单内容：市民来电反映:静安区大宁街道平型关路615弄，物业限制联通，移动线路进入小区，存在宽带垄断现象，诉求：望管理部门核实对于物业公司存在宽带垄断现象进行处理（需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240108010159，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764308-2497238', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109004572, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 43, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民的孩子生僻字解决不了医保问题，市民已多次反馈给医保部门，孩子现在突然不能买医保。因为生僻字导致现在无法交费，学校缴费2次都失败。孩子姓名：李jia（草字头底下嘉）茗，身份证：310108201601231526，今年2024年突然无法交费，之前是可以交费的，市民非常不满，为何社保没问题但是医保有问题。诉求：投诉医保部门，要求解决孩子医保缴费。', '工单类别': '一般', '处理描述': '2024-01-09 17:18:23 先联市民 2024-01-11 15:30:28 联系市民，市民孩子为浦东新区世博家园实验小学一年级学生，目前医保系统内显示第二个字是问号，与实际名字不符无法申请。市民表示出生到现在从未改过名字。近日学校告知由于孩子姓名中有冷僻字，学校上报登记信息后，医保部门反馈：公安库无匹配信息，医保库匹配到，少儿账户正常，姓名带特殊符号，故无法办理2024年居保缴费。来电询问如何解决其孩子2024年居保参保问题。2024-01-25 14:41:12 联系市民，经核实告知其孩子居保账户已开通，市民表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764153-662648', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109004802, '工号': 3750, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:24年开始实行货车通行证新规，市民想了解新规细则和具体申请流程，诉求：请管理部门告知', '工单类别': '一般', '处理描述': '市公安局徐汇公安分局交警支队于2024年1月10日09时30分与市民取得联系，2024年1月10日09时11分支队接收市民的求助单，当事人咨询货运车办理通行证流程，已告知其带好相关证明材料，前往龙吴路2138号可办理。其对回复表示满意。感谢您对公安交通管理工作的支持。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764424-2497322', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109004772, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 46, 11), '诉求地址': '浦东新区', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其表示2022年9月28日前户口是在浦东新区祝桥镇森林村陶家宅32号，但市民没有进行任何变更，却在2023年3月13日户口地址变更为浦东新区川沙镇学北路337弄7号1101室，市民姓名：冯晓阳，身份证：310115199509196629，市民表示影响了市民正常生活。诉求：希望管理部门核实，并帮助市民回到原来的户籍地址', '工单类别': '一般', '处理描述': '接工单后，上海市公安局浦东分局江镇派出所于2024年1月9日11时21分许电话联系市民。经了解， 1月9日上午市民已至派出所综合窗口办理好相关业务。根据市民反映的情况，2024年1月9日15时14分许，民警与市民取得联系，其表示业务已办理完成。1月9日16时18分许，民警联系市民进行回访，其对民警的工作态度、工作效率和工作结果表示满意。【江镇派出所】', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '户籍政策咨询', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764389-2753656', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109005072, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 46, 56), '诉求地址': '徐汇区', '诉求区域': '徐汇区', '内容描述': '市民来电咨询:其需要办理禁行道路通行证，其联系了徐汇区交警支队以后称现在需要找交警总队，但是也不清楚找谁，诉求：希望管理部门协调告知在哪里办理。', '工单类别': '一般', '处理描述': '市公安局徐汇公安分局交警支队于2024年1月10日09时50分与市民取得联系，2024年1月10日09时11分支队接收市民的求助单，当事人咨询货运车办理通行证渠道，已告知其带好相关证明材料，前往龙吴路2138号可办理。其对回复表示满意。感谢您对公安交通管理工作的支持。', '客户类型': '企业', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '限流限行', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764673-2753944', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109004902, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 47, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:中通快递公司（收件地上海），快递单号：78760566649010，未经允许让市民去快递点自提，整个小区都是该现象。诉求：投诉快递公司未经允许不送件上门，要求核实解决问题。', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764572-2753850', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109005032, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 47, 23), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:驾驶证B2，审验有效期2024年1月份，扣过分。诉求：是否需要参加定期审验。', '工单类别': '一般', '处理描述': '根据《 办理机动车驾驶证定期审验手续。 》告知市民，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '驾驶员审验', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764638-408578', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109005482, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 47, 54), '诉求地址': '无', '诉求区域': '本市', '内容描述': '已再次来电，20240109004448\t', '工单类别': '一般', '处理描述': '已再次来电，20240109004448\t', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764187-2497137', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109005272, '工号': 2932, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 48, 57), '诉求地址': '闵行区汇东五组15号', '诉求区域': '闵行区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231229006841，工单内容：重新交办，要求:市民表示该处城管只敲掉了该处墙上的一个角。现诉求：原诉求不变。市民来电反映:上述地址村民在村内公共道路上打了一面围墙，影响邻居的正常通行。诉求：管理部门尽快派人到现场查看，责令拆除围墙。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231229006841，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '土地规划', '三级分类': '非城市建设用地管理', '四级分类': '农村建设用地管理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764721-2497591', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109004822, '工号': 4260, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 49, 8), '诉求地址': '长宁区天山路汇金百货6楼熊猫星厨2期档口', '诉求区域': '长宁区', '内容描述': '市民来电反映:市民是上述地址档口商户，1月9日市民发现熊猫星厨没有消防验收手续，诉求：请管理部门核实并整治。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '我单位收悉情况后经核实该项目于2019年8月开工，但并未在我单位办理施工许可证根据上海市消防局办事指南《办理建设工程消防验收、竣工验收消防备案申报手续》第二条规定，该项目不需办理消防验收。因市民未留联系方式故无法致电告知暂做办结。（答复时间一栏选项只能选择该工单办结时间）经办人：张征', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '审批许可', '四级分类': '审批许可', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764449-408415', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109005112, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 49, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:居住证签注是不是任何一个社区事务中心都可以办理。', '工单类别': '一般', '处理描述': '根据《《上海市居住证》如何办理签注？》', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704764717-2753987', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240109005302, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 9, 9, 49, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【为企服务】市民来电咨询:其企业申请工商变更被退了，市民询问原因', '工单类别': '一般', '处理描述': '转接市场监管局专席成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': 