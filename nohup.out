分类': None, '新五级分类': None}, {'工单编号': 20240102022312, '工号': 4132, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 58, 21), '诉求地址': '长宁区娄山关路533号2902-2913室上海寻梦信息技术有限公司', '诉求区域': '长宁区', '内容描述': '市民补充信息内容为拼多多回电告知让市民自己去维修手机，但没有其他处理方案了，认为不合理【最近派发的工单编号：20231222006557，工单内容：市民来电反映:其通过拼多多买了苹果15手机：金额：8698元，订单号：231122-037858897360811，收到货发现摄像头内有灰尘，与平台反映，对方补了100元，后续商品降价，平台又退了200元，现市民发现摄像头本身有质量问题，拍出来的照片都是绿点，此事与平台反映要退货退款，平台拒绝，现诉求：请管理部门让平台全额退货退款，之前补给市民的300元市民会归还。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231222006557，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '商品质量', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178078-2377692', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102022692, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 58, 25), '诉求地址': '宝山区', '诉求区域': '宝山区', '内容描述': '市民来电咨询:上述区域人社局工伤认定部门电话。', '工单类别': '一般', '处理描述': '根据《工伤认定、劳动能力鉴定、工伤康复受理机构地址》告知市民，市民认可，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '工伤', '四级分类': '工伤认定', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178465-599463', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102022752, '工号': 2410, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 58, 41), '诉求地址': '金山区市场监管局', '诉求区域': '金山区', '内容描述': '市民反复催单。【最近派发的工单编号：20231229010251，工单内容：市民来电咨询:从2023年12月26日起其拨打金山区市场监管局57922211电话一直没有人工接听，每次打进去就排队都是忙音。诉求：请管理部门尽快核给予解释说明为何政府对外公开电话一直没有人接听。（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231229010251，故归档。', '客户类型': '企业', '一级分类': '其他类', '二级分类': '机关事务管理', '三级分类': '机关事务管理', '四级分类': '机关事务工作', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178480-2635993', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102022202, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 2, 14, 59, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:隔壁邻居家安装了一台空调，安装到了其家外墙上，有噪音，影响到其正常休息。其自行找邻居协调，希望可以移机，但是对方需要其承担移机费用。其不认可。诉求：如何可以强制执行。', '工单类别': '一般', '处理描述': '告知市民需要可以为其派单反映协调，但是强制执行如果知晓有什么违规，可以为其派单反映，或者可以咨询12348让其告知市民如何维权，市民表示认可，此单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '纠纷协调', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178010-2377620', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102022622, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 0, 32), '诉求地址': '崇明区市场监督管理局', '诉求区域': '崇明区', '内容描述': '市民来电反映:政务中心给其的崇明区市场监督管理局电话59623213，市民表示该电话号码拨打后总是提示暂无法接听请稍后再拨，市民对管理部门电话打不通表示不满，诉求:希望管理部门能给一个合理解释。', '工单类别': '一般', '处理描述': '工作人员电话联系市民，告知市民尽量避开咨询高峰时间段拨打电话，市民表示通过线下咨询已解决了问题。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '机关事务管理', '三级分类': '机关事务管理', '四级分类': '机关事务信息', '主办单位': '崇明区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178368-2378005', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102022922, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 1, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:投诉交通银行。', '工单类别': '一般', '处理描述': '解释说明。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '金融', '三级分类': '金融', '四级分类': '银行监管', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178720-2636228', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102022802, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 2, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:单位有为其缴纳2023年11月的医保，后因离职，其医保账户被封存。现因要使用靶向药，故其需使用医保。市民联系相关部门后，对方让其致电我处派单反映，故市民来电。市民诉求：请管理部门核实后告知如何才能更快解封其医保账户。', '工单类别': '一般', '处理描述': '2024-01-02 16:55:28 先联 2024-01-05 12:51:54 联系市民，市民询问单位为其缴纳社保后何时可享受医保待遇。根据沪府令8号《上海市职工基本医疗保险办法》、沪医保规（2020）9号、沪医保（2001）113号文，用人单位及其职工按照规定缴纳医疗保险费的，自缴纳医疗保险费的次月15日起，职工可以享受基本医疗保险待遇；未缴纳医疗保险费的，职工不能享受基本医疗保险待遇。市民表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178576-2636088', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102022902, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 4, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2023年12月，使用13213727777，拨打12345转3，反映抖音的问题，上海市场监管局回复时充满了嘲讽以及冷笑市民，称不属于他们管，让市民去起诉，以及市民联系12345转3号键时，老是被挂机，诉求：投诉上海市场监管局。', '工单类别': '一般', '处理描述': '1.16电话回访办结', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '服务质量', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178698-344249', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102022982, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 5, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其网上了解到本市社区医院给备孕的女性免费发放叶酸的服务，希望管理部门告诉市民哪些社区医院有发叶酸的，怎么申领。', '工单类别': '一般', '处理描述': '2024年1月3日与市民联系，根据《增补叶酸预防神经管缺陷项目管理工作规范》免费发放叶酸的服务项目实施对象。准备怀孕的农村生育妇女。如需核实是否符合可前往社区医院确定。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '人口计生', '四级分类': '优生优育', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178758-344303', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102023262, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 8, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231216007209  ，工单内容：市民来电反映: 市民于12月6日，使用13278311104手机号拨打12315，反应拼多多的消费问题，市民多次拨打12315热线无法接通，市民需要了解办理进度。诉求：请管理部门尽快联系市民告知其工单的办理进度。（需回复） 】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231216007209，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704179084-2636605', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102023212, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 9), '诉求地址': '普陀区长寿路800弄', '诉求区域': '普陀区', '内容描述': '市民来电反映:上述小区外面用于业主停车处属于物业管理（非市政道路），原来收费300元一个月，物业表示要涨价到600元一个月。诉求：请管理部门尽快告知市民涨价到600元一个月是否有什么法律规定或者是否违反规定 。', '工单类别': '一般', '处理描述': '长寿路街道于1月5日接单，接单后联系了诉求人。经查，反映情况不属实。经了解，反映地址为苏堤春晓小区南门上街沿停车位，由龙湖物业提供物业服务。据悉，该处为商铺门口处地面车位，分为划线处固定包月和临停两种，包月车位因历史遗留问题，按前物业标准300元/辆/月收费，诉求人以前有一个固定车位，但于2022年卖车后未保留车位，目前重新停车在临停车位，按照小区物业合同约定的临时停车费标准：每小时5元/辆、过夜每次收费20元/辆进行付费，物业为便于业主付费，在缴纳停车费时业主可选择一次性付一个月的费用或是单次付费，因而会产生600元/月的数额。综上所述，并非物业在原基础上涨价到600元的情况，分包月与...', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '物业管理收费', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704179028-599974', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102023322, '工号': 3542, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 9, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:12月8日交295元买城乡居民医疗保险，医保共济支付，1月2日看病仍然显示全额支付，了解报销问题。', '工单类别': '一般', '处理描述': '转接医疗保障成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704179142-2378723', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102023472, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 10, 6), '诉求地址': '长宁区', '诉求区域': '长宁区', '内容描述': '市民来电反映:个人消费，要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档 ', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704179288-2636814', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102023252, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 10, 8), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2024年1月2日15:03市民拨打嘉定区公安分局督查部门电话22172198，询问之前反映问题的处理进度，男性工作人员称已处理，当市民质疑没有处理时，该工作人员直接将电话放在旁边，不回答市民的问题，态度恶劣，市民对此不满，故来电投诉。诉求：希望管理部门核实处理。（需回复）', '工单类别': '一般', '处理描述': '2022年9月2日14时25分许，嘉定公安分局安亭派出所电话答复来电人，详细情况如下：经核实，2022年6月30日7时15分，安亭所接群众报警称：有一名男子即投诉人陶先生持棍砸邻居家屋外的围墙。安亭所民警许剑出警，到场后发现陶文权仍砸墙，故制止其砸墙的违法行为，并告知其因其故意损毁公私财物，口头传唤其至派出所接受调查。但在民警执行公务过程中，陶文权拒不配合，暴力抗法，拉拽民警，故民警在警告无效后，对其喷射辣椒水，并将其控制后带所处理。期间，陶文权的暴力抗法行为造成民警左手中指受伤，左手背和手腕处有明显淤青。后陶文权因涉嫌妨害公务被我局依法监视居住，后转为行政拘留10日。经自查整个执法过程...', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '服务态度', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704179085-600024', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102023272, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 10, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 交社保的时候添加晚了，补缴11月，就业参保申报业务核定表，12月申报登陆社保系统，还是没有这个人。', '工单类别': '一般', '处理描述': '转接人力资源成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704179104-2636626', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102023082, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 10, 24), '诉求地址': '嘉定区博园路7568号安亭国际汽车城 步行街405号 上海飞凡汽车交付中心', '诉求区域': '嘉定区', '内容描述': '市民来电补充信息。市民补充信息内容为：2024年1月2日14:38接到非凡客服热线的回复，电话是021-38831885，客服称市民的车辆不是质量问题，市民不认可客服的说法，要求客服提供证据或检测报告，非凡客服无法提供。请管理部门尽快处理。【最近派发的工单编号：20231231014306，工单内容：市民来电反映:市民12月29日在上述的4S店提车，车型：R7，市民之后停在小区内，准备上牌的时候，发现保险杠内侧塑料板断裂了，调取了小区监控并非人为，因此联系了4S店，但是对方说法态度非常不满意，认为是认为的，市民表示已经有监控证明了，对方还是一直推脱不愿意处理，市民认为是车辆存在质量问题，...', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231231014306，故归档。\n', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '商务', '三级分类': '商务', '四级分类': '汽车销售', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704178912-2636421', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102023422, '工号': 4160, '工单生成时间': datetime.datetime(2024, 1, 2, 15, 13, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:外牌鲁DY363A,李雯，转籍进度？', '工单类别': '一般', '处理描述': '已告知需转达相关部门回复，市民认可。\n', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704179477-2379042', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None,