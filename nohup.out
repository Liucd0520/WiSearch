': None, '服务类型': '综合服务', '通话编号': '1704617826-3099198', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016132, '工号': 4230, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 2, 26), '诉求地址': '浦东新区曹路镇永华苑12号1403', '诉求区域': '浦东新区', '内容描述': '市民要求撤单。【最近派发的工单编号：20231229009345，工单内容：市民来电反映:其住在上述地址的小区，其表示该房子是其阿姨的，其去缴纳物业停车费的时候，小区物业告知其，其的车子不是在其阿姨业主的名下的，所以无法享受业主停车优惠的政策。诉求：请管理部门协助其拿到停车优惠政策。。】', '工单类别': '一般', '处理描述': '按《关于市民要求撤单的处理口径》回复，市民认可，归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704617996-2363548', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016402, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 4, 6), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704618208-2363639', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016122, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 4, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其移动手机号为13621604036，其联系10086要取消套餐，对方告知其该套餐是先付款，必须等服务享受完才能取消，不肯退款，但是其不认可，其认为自己1月份只是用了7天的服务，诉求：要求移动退回剩余未是用的费用。（需回复）', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': '上海移动通信公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704618022-2363558', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016392, '工号': 3782, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 4, 49), '诉求地址': '杨浦区双阳路300弄17号704室', '诉求区域': '杨浦区', '内容描述': '市民反映：每天早上只要有阳光和风，上述地址阳台风车镜子就会旋转，折射光照的人头晕目眩。（详见附件）诉求：请管理部门清除风车镜子。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派大桥街道进行处理。据大桥街道回复：先行联系：接单后，街道工作人员于2024年1月8日先行联系来电人。 情况核实：经核实，来电人反映情况诉求过高。 处置过程及回访：接单后，属地居委及时与704室住户沟通协调，704室住户表示在自家阳台上放置了一个小的风车的是为了防止鸟类停驻，针对风车上的反光膜折射可能影响到了来电人，已经用透明胶将反光膜贴掉了。上述情况于2024年1月16日下午再次电话来电人，其表示会再关注一下。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '光污染', '主办单位': '杨浦区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016232, '工号': 4272, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 6, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电补充信息。市民补充信息内容为市民来电反映:抖音平台官方客服处理说商品不符无法退货退费，要求商家将市民的商品在退还给市民【最近派发的工单编号：20240104036142，工单内容：市民来电反映:投诉抖音商场，市民购买了内衣，市民不喜欢，想要退，快递把地址弄错了，商家要求市民把商品退换，但是费用没有退。平台也不处理。订单号：6925118452720866577.订单超时了。造成双倍损失。金额：287元。诉求：希望管理部门帮助退款，并补偿其他订单的损失。（需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240104036142，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704618147-3099324', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016412, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 13, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:地铁2号线，4号线，6号线，9号线世纪大道站的A厅通道现在堵住了，无法走到12号线，地铁公司表示高峰期间客流量大，所以堵住，其不认可，诉求：建议留出通道出行。', '工单类别': '一般', '处理描述': '已确认。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '地铁客运', '四级分类': '地铁建设', '主办单位': '申通集团', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704618551-2363781', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016482, '工号': 3492, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 13, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要转拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704618762-531673', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016352, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 15, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2022年7月办理了联通合约机，合同内规定每月从市民的支付宝自动扣款，会给予市民同等金额的抵扣券。8月时联通将市民的手机号停机了，2023年4月市民发现电话无法打通了。联系联通表示停机了。市民查询发现2022年8月-23年4月联系没有给予抵扣券，费用还是在正常扣款。市民手机号：15601642855。市民表示既然没有提供服务就不应该收取费用，并表示联通停机也没有通知市民。诉求：投诉联通，要求退回期间产生的费用。（需回复）', '工单类别': '一般', '处理描述': '市民再次来电反映相同问题已为其派单处理，详见工单号：20240117028145，此工单归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': '中国联通上海公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704618455-276826', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016502, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 15, 21), '诉求地址': '青浦区白鹤镇外青松公路白鹤农贸市场', '诉求区域': '青浦区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231226032305，工单内容：市民来电反映:此前向管理部门反映上述地址存在无证设摊情况，反映后好了一段时间，但是现在又死灰复燃，诉求：请管理部门核实要求彻底整治。（需回复）】\n', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231226032305，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704618732-2363862', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016512, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 7, 17, 16, 59), '诉求地址': '闵行区西环路777弄', '诉求区域': '闵行区', '内容描述': '市民来电反映:其是小区业主，但由于没有停车位，其车辆在小区停车按临时车计费，之前是10元/天，而1月7日小区突然将临时车收费涨到30元/天，且无任何公告。诉求：请管理部门核实，要求对此情况给予合理解释。', '工单类别': '一般', '处理描述': '莘庄镇西湖苑居委于1月8日与诉求人先行联系，并对诉求信息进行确认。经核实，2023年11月10日该小区召开业主大会，表决通过了新的《停车管理办法》，2024年1月1日起正式执行；对于临时停车，按照30元/天标准收费。但考虑到业主的权利，经过协商，如果三证合一可以到物业备案，以月租收费标准收费，但车位无法保证。该业主已带好三证去物业进行了备案。已将办结情况向诉求人答复解释，诉求人未评价，该小区按照《停车管理办法》执行，不存在违规收费问题，故无法进一步办理。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '乱收停车费', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704618812-2363885', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107016592