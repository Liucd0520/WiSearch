要求该企业提供产品进口的依据以及和售卖给其的产品是一致的证明。', '工单类别': '一般', '处理描述': '市民诉求为核实企业净水器的滤芯进口凭据，被诉方表示向供货商索要，待收到后发给市民。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704349709-2099449', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020662, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 35, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704349994-17173', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020062, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 35, 51), '诉求地址': '本市市卫生健康委', '诉求区域': '本市', '内容描述': '【投诉】市民来电反映:通过12345向市卫生健康委反映和上海艺星美容医院有限公司眼部整形纠纷后（相应工单编号：20231125004655），管理部门表示门诊部与信访人沟通协商但未达成一致意见，管理部门没有电话告知市民办理结果而且根本没有协商，认为属于推诿。诉求：请管理部门针对没有电话告知市民办理结果、推诿给出合理的解释。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '目前医院与信访人无法达成统一协商，建议信访人可以通过向长宁区医患纠纷人民调解委员会申请人民调解（地址威宁路452号，电话62907006）；长宁区卫生健康委员会医疗事故处理办公室提供出医疗事故鉴定申请（地址云雾山路39号1楼52064225）；向医疗机构所在地人民法院提起民事诉讼。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '办事推诿', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704349580-2835759', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020052, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 36, 40), '诉求地址': '浦东新区航头镇牌楼村17组871号和241号', '诉求区域': '浦东新区', '内容描述': '【重新交办：答复要点与实际不符：市民表示1层半的房子去建了3层，而且都父母都享受过两次优惠政策，父亲的违建房子也没拆，继续出租盈利，市民表示有证据，要求管理部门对此给出合理的解释。最近办结工单编号：20231216006301，工单内容：重新交办,要求：按答复要点告知市民,市民表示对答复要点不认可，18组村民钟胜军父女二人已经享受过了新建房屋待遇。他为了要诈骗国家的动迁款，以假离婚的方式，将户口审批面积是增加至225个平方。市民保留有相关证据。诉求：要求管理部门对隐瞒事实、欺骗组织，该户存在违规操作的情况进行查处。（需回复）工单内容：重新交办，要求：根据答复市民要点告知市民，市民表示答复...', '工单类别': '一般', '处理描述': '接到工单后于2023年1月4日16：30分电话联系诉求人，经了解：1、871号和241号是同一家，农民建房个人申请将材料上交至村里后由村里上交给镇农民建房办审核，竣工期间由第三方验收通过后发放建房许可证。2、农业干部地块查证，该房屋地理位置在18组内，审批面积属于个人信息，不提供他人查看。3、所述‘假离婚、诈骗国家补偿款增加审批面积’由公安、征收等部门判定。先行联系与办结为同一录音不予评价。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '宅基地', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704349418-16642', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021022, '工号': 2582, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 37, 14), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348785-795418', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020742, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 37, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:房东不退押金。怎么办。', '工单类别': '一般', '处理描述': '告知市民咨询12348，市民认可，归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704350100-17256', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020762, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 39, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:查询学生的居住证，孩子要参加中考，诉求：告知居住证的日期。', '工单类别': '一般', '处理描述': '根据《 “上海市民信息服务网”（www.962222.net）注册密码忘记、输错、无法登录怎么办？ 》或者社区事务受理服务中心，市民认可。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '入学入托', '四级分类': '居住证', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704350231-796685', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020262, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 41, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:继承过户机动车并且上市区号牌', '工单类别': '一般', '处理描述': '根据《》,《》,《》,《》,《》,《》,《办理注册登记、转让登记、变更登记和更正登记需要改变号牌号码的选号》,《办理机动车(管辖区域内无需进交易市场)转让手续》,《父亲已过世，名下有辆本市车牌的机动车，询问如何过户？》', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704349616-2835783', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021262, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 42, 30), '诉求地址': '宝山区牡丹江路1569号宝乐汇4层', '诉求区域': '宝山区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。商家地址：宝山区牡丹江路1569号宝乐汇4层，时间：2024年1月4日14:17。诉求：希望管理部门核实转送相关照片至承办部门。（相关工单编号：20240101015929） ', '工单类别': '一般', '处理描述': '经调解，经营者已经将款项退回消费者。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020772, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 42, 31), '诉求地址': '闵行区七莘路2299弄171号302', '诉求区域': '闵行区', '内容描述': '市民来电咨询:咨询上述地址派出所电话', '工单类别': '一般', '处理描述': '根据《闵行区七宝镇居委会一览表(1-31) 》,《闵行区七宝镇派出所信息》按照市民要求发送派出所电话，市民知晓，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704350118-796585', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020702, '工号': 4322, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 42, 32), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电对办理结果不满,市民告知管理部门有联系告知不是管理部门的问题，市民无法接受，要求管理部门尽快再次联系。【最近派发的工单编号:20240104020500，工单内容:【投诉】市民来电反映:2023年11月7日拨打12345反映关于拼多多购买棉鞋问题，管理部门没有核实情况，也没回复，直接办结工单，市民称是举报单不是协调单，诉求：其投诉管理部门没有核实情况，也没回复，直接办结工单，其投诉管理部门不作为，市民要求管理部门明确告知处理人员职位、姓名和编号。（需回复）前工单编号：20231107009444。】', '工单类别': '一般', '处理描述': '市民对办理结果不满，已电子催单工单编号：20240104020500，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '诉求未解决', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704350085-17242', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021492, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 46, 25), '诉求地址': '虹口区曲阳路560号', '诉求区域': '虹口区', '内容描述': '市民反映：家乐福余额无法退，2023年12月去曲阳路的家乐福商场欲购物，发觉已人去楼空，所有家乐福电话都打不通，找了好几个家乐福商场都关门了，市民有家乐福余额169.75元，无法联系家乐福的相关部门。诉求：希望协助退款。', '工单类别': '一般', '处理描述': '经核实，上海家乐福各在营门店已恢复使用预付卡支付购买商品的情况，限购商品标有“福气心选”字样。关于退卡退款的诉求，经调解，由于被诉人明确拒绝调解，根据《市场监督管理投诉举报处理暂行办法》第二十一条的相关规定，我局依法终止调解。截止目前，上海地区家乐福正常经营门店尚有3家，分别是浦东川沙店,长宁古北店,普陀万里店。详情可拨打苏宁易购客服电话：4008365365。特此告知。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021362, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 46, 55), '诉求地址': '长宁区娄山关路533号2902-2913室  上海寻梦信息技术有限公司', '诉求区域': '长宁区', '内容描述': '市民来电咨询处理进度。【最近派发的工单编号：20231230019970，工单内容：市民来电反映:拼多多买了一个柜子。231221-104537845133430，金额761.46元。质量问题要求退款500元。商家同意，退款成功。之后商家找了市民两次，市民认为拼多多平台泄露其隐私。诉求：要求拼多多补偿200无门槛券。】', '工单类别': '一般', '处理描述': '已告知管理部门正在处理中，建议市民耐心等待，市民认可故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704350606-17709', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021482, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 47, 44), '诉求地址': '浦东新区浦东社会保障中心', '诉求区域': '浦东新区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，其因购买的新房铂雅华庭延期（该项目已列为政府保交楼项目），申请公租房过渡延期，被浦东社会保障中心驳回，包含其在内的很多业主都在浦东公租房租房并且需要延期申请，这不是一个个案，是个群体性事件，诉求：请浦东社会保障中心务必重新审核。最近办结的工单编号：20231213011223，工单内容：其想将现在的公租房延期居住时间，因为在上海浦东购买的红星铂雅华庭房子延期交付，没地方居住，但是浦东公租房受理中心不通过其延期过渡申请，让其和开发商商议，据红星铂雅华庭披露，是开发商和政府保交楼项目联合发布的交付延期通知，实在没有办法，诉求：请管理部门协调公租房延期。】', '工单类别': '一般', '处理描述': '浦发集团已于2024-01-04 15:17与市民先行联系，并于先行联系中一次性向市民答复：尊敬的刘先生，您好：您反映的情况浦发集团下属公租房公司已收悉。经核实，根据市筹公租房续租相关规定，公租房租户延长过渡性居住期可至预售合同约定的房屋交付日期之后三个月，经查，您已按政策享受过延期过渡申请，按照要求不得再次享受。特此答复，感谢您对我们工作的支持与理解。申请结案，谢谢。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '保障型住房', '四级分类': '公租房', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021712, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 48, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020712, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 48, 28), '诉求地址': '杨浦区', '诉求区域': '杨浦区', '内容描述': '市民来电反映:其是商铺，因为隔壁商铺被投诉导致其受牵连，也要被迫关店，其不认可。', '工单类别': '一般', '处理描述': '建议法律维权，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704350341-2099997', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021412, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 50, 15), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704350843-797239', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021542, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 51, 35), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:企业的机动车如何办理过户', '工单类别': '一般', '处理描述': '转接车管所成功,归档', '客户类型': '企业', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704350851-797248', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104021582, '工号': 3420, '工单生成时间': datetime.datetime(202