None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032612, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 34, 10), '诉求地址': '浦东新区季景路333弄阳明花园二期18号楼', '诉求区域': '浦东新区', '内容描述': '市民咨询：依据上海市浦东新区规划局《关于不予变更阳明广场二期局部施工图的决定（沪浦规划资源许建变（2019）8号）》中明确批复，规划局已核发的浦规建（2018）FA31011520187257，“18号楼”单体建筑中，包含物业用房、业委会用房、居委会用房、治安联防站、文化活动室等公建配套用房，除此之外为会所。当前，开发商明确表示“18号楼”为开发商自持商业用房。未作为公建进行移交使用。依据沪浦规划资源许建变（2019）8号，规划局明确不予批复上海侨福外高桥置业有限公司有关变更“18号楼”楼施工图纸的申请。因此合理理解，“18号楼”为小区的公建配套用房。当前行政批复未见“18号楼”变更性质...', '工单类别': '一般', '处理描述': '市民，您好，高桥镇规建办给您回复：针对您反映情况，规建办已第一时间进行核实，首先，开发商对18号楼的具体用途暂未明确意向，不存在已变更为自持商业用房的行为。其次，目前，阳明花园小区的治安联防站、文化活动室、服务站、老年康体活动室设置于一期一层，且这些用房均已过户给高桥镇并已取得【房屋不动产权证】；小区的物业管理用房位于9幢19号一层和13幢18号一层，业委会用房位于18幢26号，并均已取得建交委【公益性服务设施房地产认定证明】；另外，依据规资局《关于不予变更阳明广场二期局部施工图的决定（沪浦规划资源许建变（2019）8号）》中提出不能把名称由公建配套变更为商业用房，具体是指名称不能变更，...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '房屋产权', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032472, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 34, 44), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多上买到了问题产品。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704710023-400739', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032502, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 36, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多专席，个人消费类', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704710084-2444061', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108031162, '工号': 2100, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 37), '诉求地址': '嘉定区安亭镇和静路塔山路', '诉求区域': '嘉定区', '内容描述': '市民来电反映:嘉定区安亭镇和静路塔山路路口有无运输证的渣土车还超载，每天从路口开到江苏昆山，到了江苏换假的车牌，携带一个沪牌，一个苏牌，车牌号：后面几位数3573；6175；3811；数量：20几辆，一般是从宝安公路走外青松公路然后再转到昆山绿地大道。诉求：查处车辆违法行为。（市民要求信息保密，需回复）', '工单类别': '一般', '处理描述': '嘉定区安亭镇：接热线后，1月9日先行联系。经安亭镇城管中队核实，城管中队将联合公安共同处理，根据渣土车运输时间和行驶路线，执法人员将在重点时段对和静路塔山路设卡检查，重点查处渣土运输车辆各类违法违规行为。同时诉求人发现违规渣土车可拨打39503698联系处置。城管中队已致电。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': '嘉定区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704709300-609562', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032632, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 40, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多上个人消费问题，要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多绿色渠道服务热线专席成功，此单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704710291-655460', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032662, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 41, 7), '诉求地址': '闵行区浦江镇浦锦路1266号534室', '诉求区域': '闵行区', '内容描述': '市民反复催单，望管理部门尽快处理。【最近派发的工单编号：20231224020016，工单内容：市民来电反映:上述地址的住户于上半年装修，是自行寻找的装修公司。12月24日漏水，该情况以前也发生过，当时维修好后现在又再次发生了漏水，漏到了1楼的104室家中。诉求：请管理部门核实情况并尽快维修漏水。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231224020016，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704710357-2444157', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032762, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 44, 43), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704710649-655574', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032702, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 45, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704710554-2444227', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032852, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 45, 44), '诉求地址': '黄浦区小南门', '诉求区域': '黄浦区', '内容描述': '市民咨询：继承案黄浦法院已经下达了终审判决书，作为继承人需要经过怎样的程序才能得到应有的继承款，法院没有告知具体的操作流程，通过什么途径支付诉讼费，又凭什么证据或证明去征收办领取应得的继承款，这些问题法官应该通过电子通知（判决书就是电子版的）告知每个继承人才是。诉求：希望管理部门告知。', '工单类别': '一般', '处理描述': '根据《上海市“12345”市民服务热线办理试行办法》相关规定，您反映的事项不属于市民服务热线的受理范围，建议直接向法院咨询，专此简复', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '法院系统', '三级分类': '法院受理', '四级分类': '法院判决', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032712, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 46, 9), '诉求地址': '普陀区清峪路真光路公交车站', '诉求区域': '普陀区', '内容描述': '市民来电反映:上述地址公交车站一直有刺鼻的臭味，担心对身体健康会有影响，该情况已经持续了1、2个月。市民表示具体气味原因不清楚，在修路前已经有气味，可能是有管道破裂导致。诉求：希望管理部门核实查找气味原因，解决该问题。', '工单类别': '一般', '处理描述': '普陀区建设中心于1月9日接单，1月9日13时52分先行联系并答复市民。接到工单后已立即派人去现场查看，并督促现场第一时间做好防护措施，以防止安全隐患。经现场核实，清峪路该处井盖已进行处理，已消除道路臭味。市民表示其并未打过投诉电话。经办人：倪文52564588，附电话录音及现场照片。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '空气污染', '主办单位': '普陀区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704710512-2444208', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108032812, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 8, 18, 47, 6), '诉求地址': '本市拼多多', '诉求区域': '本市', '内容描述': '市民来电咨询:个人消费者要求转接', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '