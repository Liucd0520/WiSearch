类': None, '新五级分类': None}, {'工单编号': 20240104013432, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 4, 11, 59, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民要求转接公积金咨询公积金提取', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340690-2829490', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013242, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 0), '诉求地址': '徐汇区', '诉求区域': '徐汇区', '内容描述': '【重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符，市民表示交警队让其找支付宝，市民多次联系支付宝，被告知没有收到过退款，表示管理部门可能退到浦东发展银行了，市民不知道要如何查询，诉求：尽快给予解决方案。最近办结的工单编号：20231218019001，工单内容：市民来电反映:12123有违章，市民11月23日在12123APP处理违章并缴纳300元罚款，第一次缴纳系统卡未交进去，第二次缴纳系统显示退款，实际未收到。徐汇交管所告知已安排退款，让市民等待。现已过去近1个月市民始终未收到退款。车牌号：沪AF73097。诉求：请管理部门核实并告知退款时间，并催促尽...', '工单类别': '一般', '处理描述': '上海市公安局徐汇分局交警支队于2024年1月4日15时22分许与来电市民李先生取得联系，根据李先生的诉求回复如下：经联，支队告知李先生经财政系统查询答复，上述缴款失败，原路返还。罚款最终收缴由财政部门管理，支付宝为第三方缴费方，代缴及收款均非交管部门业务。支队建议李先生向区财政或支付宝进行咨询。支队认为，李先生的诉求过高支队不予采纳。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340497-2571769', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013222, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 0, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其想要查询其父母是否有领取过独生子女一次性奖励费用（毛爱悦 身份证：310108194712011640、黄梦英 身份证：31010819470328161X）希望管理部门核实告知', '工单类别': '一般', '处理描述': '市民于2024年1月4日13时15分致电我中心，已告知市民我中心无法查询市民父母是否领取过领取过独生子女一次性奖励费，同时建议市民咨询其父母户籍地所在的社区事务受理中心能否查到领取记录。市民表示已知晓。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '人口计生', '四级分类': '独生子女补贴', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340473-2829343', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013382, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 1, 24), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反映:淘宝天猫苹果店，苹果手表S9，闪屏系统乱串，退货退款被拒绝，市民查询是北京公司的。', '工单类别': '一般', '处理描述': '建议向属地反映市民认可。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340650-2571856', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013412, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 1, 51), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:快递不送上门的问题，收件地在徐州。', '工单类别': '一般', '处理描述': '建议拨打当地热线，市民认可，归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340799-2829566', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013492, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 2, 19), '诉求地址': '长宁区安顺路181弄安东小区165号602室', '诉求区域': '长宁区', '内容描述': '市民来电反映:长宁区安顺路181弄安东小区165号602室厨房天花板漏水。诉求：请管理部门尽快派人上门维修。（需回复）', '工单类别': '次紧急', '处理描述': '接报后，供水热线于1个工作日内先行联系市民，经查，市民当天已经致电我司热线报修，处理人员到场将漏水修复，再次接到市民来电后，处理人员到场查看，屋顶水箱已经不漏水，市民认可，供水热线于1月14日回访市民满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '供水热线', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340755-790195', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013752, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 3, 39), '诉求地址': '浦东新区生态环境局', '诉求区域': '浦东新区', '内容描述': '市民反映：一、内容不实：报告表表3，本项目与《生活垃圾转运站技术规范》相符性分析选址栏目称：项目周边无大型商场、影剧院、学校、商场、餐饮店等。事实是：距离该工程界最近240米处就是居民区，1000米内有六大密集居民小区，并有新环广场等附近又规划小学和幼儿园个各一所。二、程序违规报告表（公示稿）违反《上海市环境影响评价公众参与办法》“建设单位应当同时采取以下三种公众参与方式征求公众意见规定”，仅在上海市企事业单位生态环境服务平台发布，未在公众易见的环境影响评价范围内，即一个（村）委会、三个居委会同时张贴公告，也未在所在地新场镇政府信息发布平台同时发布信息。故意忽略易被公众知晓的两种信息发布...', '工单类别': '一般', '处理描述': '经核实新场垃圾分流转运中心新建工程被列入浦东新区重大工程目录，依据《上海市浦东新区新场镇16号线核心单元PDS2-0101控制性详细规划》，《上海市浦东新区新场镇郊野单元村庄规划2017-2035年》，已取得立项批复、工可批复、规划设计方案批复、初步设计批复和农转用批复等文书，2023年9月13日取得环评批复。有致电市民，市民表示理解', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '卫生配套设施', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013482, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 5, 15), '诉求地址': '青浦区拆违办', '诉求区域': '青浦区', '内容描述': '市民来电反复催单。催单原因：已经过了12月29日，至今未上门取执行，1月4日162号住户已经入住了，市民希望将问题转到区长办公室。【最近派发的工单编号：20231226005490，工单内容：【投诉】市民来电反映:青浦区盈港路1555号162号佳邸别墅因为管理部门至今没有执法，现在该处越建越大，没有拆除，也没有停工，占用了是消防通道和绿化通道，影响旁边居民的通风采光。青浦拆违办联系其，表示需要看领导意见，如果该业主自己不拆，别人无法强制要求拆除，其认为青浦拆违办存在不作为的情况。诉求：要求查处青浦拆违办不作为的情况，尽快拆除违建。（相关工单编号：20231222001575）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231226005490，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '问题推脱', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340734-790188', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013442, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 6, 29), '诉求地址': '浦东新区浦泽路', '诉求区域': '浦东新区', '内容描述': '市民来电反映:学校有抽烟现象。', '工单类别': '一般', '处理描述': '通话过程中市民信号不好，自行挂机，此单归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '禁烟控烟', '四级分类': '禁烟控烟', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340711-2829501', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013392, '工号': 3262, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 7, 18), '诉求地址': '徐汇区罗秀三村51号501室', '诉求区域': '徐汇区', '内容描述': '市民来电反映:7月份初其在自如平台租赁上述地址房子，租金：6200元/月，付三押一，合同签订一年，房子南房间阳台漏水导致发霉，味道难闻，导致孩子与大人身上起疹子，其有向自如反映，管家也派师傅上门查看，师傅也确认是漏水导致发霉，管家称闻不到味道，只能进行铲除霉斑刷漆维修，但家中有一个2岁孩子与7岁孩子，一旦刷漆严重影响孩子身体，其申请更换更换房子或者退租，管家称学校边上没有房源，安排地方很远，其自己的家就具体学校3-4公里，因为孩子读书方便才租赁房子，现在更换到很远其无法接受，管家称退租需要扣半个月费用，其对此不认可，合同写明房子出现问题威胁到人生健康进行免责退租。诉求：请管理部门核实并要...', '工单类别': '一般', '处理描述': '1月8日联系市民，关于市民反映事项，建议市民双方根据合同约定，友好协商解决，协商不成可通过司法途径解决。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '租赁管理', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340643-2829451', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013872, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 8, 52), '诉求地址': '浦东新区潍坊一村180号楼栋', '诉求区域': '浦东新区', '内容描述': ' 重复来电：反映相同问题。【最近派发的工单编号：20231221006952，工单内容：市民来电反映:浦东新区潍坊一村180号楼栋，6楼，及2楼或3楼的居民在楼道内焚烧纸币，存在消防隐患，诉求：望管理部门核实对于居民在楼道内焚烧纸币进行制止处理（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '已告知管理部门正在处理中，建议市民耐心等待，市民认可，故归档。\n', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（消防）', '三级分类': '消防管理', '四级分类': '消防隐患', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340848-790262', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013782, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 9, 31), '诉求地址': '浦东新区英伦路838号', '诉求区域': '浦东新区', '内容描述': '市民来电反映:干活被欠薪，地方在：浦东新区英伦路838号，项目名称：盟立自动化有限公司，承建单位：不清楚，从事的工作是：小项目的装修，没有签过劳动合同，拖欠总人数：15人，总金额：20多万元，诉求：尽快处理欠薪问题。', '工单类别': '一般', '处理描述': '归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '建筑工程欠薪', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704341132-2572172', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013942, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 10, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:要求转接拼多多，是个人消费者。', '工单类别': '一般', '处理描述': '转接拼多多绿色渠道服务热线成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704341371-11124', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014212, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 11, 48), '诉求地址': '闵行区南江州路125号城方活力社区2号楼204室', '诉求区域': '闵行区', '内容描述': '市民反映：上海江乒乐体育有限公司卷款跑路，尚有课时没用完（详见附件）。诉求：请督促退款。', '工单类别': '一般', '处理描述': '市民您好，您反映的事项为培训机构预收费用消费纠纷，涉及健身培训和体育培训的，根据市培训市场综合治理工作联席会议办公室相关文件及市体育局关于做好体育培训市场治理工作的通知精神，明确对该事项投诉调解的法定职责。建议市民：依据《消保法》相关规定，可登陆微信公众号上海市消保委填写反馈或拨打12315市场监督管理部门处理。依据《校外培训行政处罚暂行办法》第二十二条的规定，校外培训机构收费价格、收费行为、预收费管理等违反法律法规和国务院相关部门有关规定，依据法定职责，市民应向市场监督管理部门进行举报。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013792, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 11, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其和网约车发生，事故认定为全责，对方要求其赔停运费，但市民质疑该网约车驾驶员是资质，认为其不一定有人证车证，可能本身就是不合规的，车牌号：沪AAH7638，姓名：刘华。诉求：希望管理部门核实，该车是否有网约车营运证', '工单类别': '一般', '处理描述': '2024/1/5 11:09 联系反映人，告知相关车辆拥有网约车运输证。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704341133-2829760', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013832, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 12, 7), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电对办理结果不满,平台给其回复是平台没有违法，市民举报到商家当地当地，商家没有营业执照当地也管不了。市民对处理结果不满。【最近派发的工单编号:20240102032093，工单内容:市民来电反映:拼多多买鞋，说是皮的里面羊毛，也不是皮的也没羊毛。平台只肯退货退款，其他的不支持。订单号：231116-571253790320519.商家没有营业执照，怎么入驻平台的。电子商务法第三十九条，平台指导商家存在欺诈不与监管的，平台要与商家承担同等责任。诉求：仅退款。】', '工单类别': '一般', '处理描述': '市民对办理结果不满，已电子催单工单编号：20240102032093，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704341282-2829846', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014012, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 13, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:转接人社局，咨询社保账户的设立，其为自由职业。', '工单类别': '一般', '处理描述': '转接人力资源成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704341530-2830020', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014172, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 16, 55), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:ETC异常，咨询ETC咨询电话。', '工单类别': '一般', '处理描述': '与市民解释说明，市民认可，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': 'ETC使用', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704341727-11325', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014372, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 21, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民需要转接拼多多专席.', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704342040-790938', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014312, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 21, 50), '诉求地址': '杨浦区长阳路910弄32号505室', '诉求区域': '杨浦区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231229028263，工单内容：市民来电反映:其网上购买的中长棉袄由中通快递来配送，快递单号：75750296935789 收件地址：长阳路910弄32号505室，物流信息显示快递于2023年12月24号19:27分到达上海浦西运转中心，后续对方一直没有配送导致其迟迟没有收到，向快递公司反映未果，为此市民来电投诉中通快递并要求对方尽快将东西送到。（需要回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231229028263，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704341854-2572620', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014452, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 26, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其有一个顺丰快递（到付件），从广州到上海，市民已经与商家说好了拒收，但家人却签收并付了货款。联系了快递公司，说要支付货款的3%，市民不认可。单号：SF1519788110393。诉求：希望管理部门督促快递公司退回手续费。', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704342096-790963', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014882, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 30, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询：2024年学生医保如何缴费以及办理手续。诉求：希望管理部门核实告知。', '工单类别': '一般', '处理描述': '2024-01-04 17:31:35 通话中，2024-01-05 12:31:08 联系市民，市民询问本市在校学生如何缴纳2024年度的城乡居民基本医疗保险参保费。根据沪医保中心（2023）89号文及相关规定，告知市民，符合条件的中小学校在册学生和在园（所）幼儿，由学校和托幼机构统一办理登记手续和代为收取个人缴费。属于集中申报范围，符合本市城乡居保参保条件的人员，2024年度的城乡居民基本医疗保险的参保缴费，可通过“共济缴费”方式，由家庭共济资金支付。共济缴费失败或不满足共济缴费的，由学校和托幼机构代收后按规定汇缴。市民表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704340863-790267', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014752, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 31, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民需要转接拼多多专席.', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704342644-11846', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014772, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 33, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 在摩天轮票务上买了演出票，客服说取消了，要市民联系平台退票。12月31日购买的， 订单号23012293138，一张，价格：291元。诉求：要求尽快退票。', '工单类别': '一般', '处理描述': '1/20 8：20已联系， 1.4已致电，买家表示订单要求退款，演出已取消， 已核实卖家确认演出因主办取消，订单已退，买家接受', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '文广影视', '三级分类': '文化产业管理', '四级分类': '文化活动', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704342697-2830732', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014892, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 34, 40), '诉求地址': '长宁区娄山关路533号2902-2913室', '诉求区域': '长宁区', '内容描述': '市民补充信息：拼多多客服未做任何调查及调解，拖拉若干天仅一位态度极度冷漠客服来电重复不能支持任何消费者维权，要求买家退货退款，即支持卖家继续售假。在被拼多多以七拼八凑叠加100元券（买家不认可，未用）处理卖家骚扰行为后，买家继续收到各种防诈电话、短信及快递员上门和快递公司来电，即商家非常无视处罚继续对买家持续骚扰。该商品本身一眼假的外形对比及吊牌作假，为什么拼多多不做任何调查研究及举证而一言堂要求退货退款。该商品页面特有的假一罚十为什么毫无公信力地拒不执行。买家有一一对比证实商品的伪造，申请拼多多执行假一罚十的平台承诺。并对买家遭受商家受所谓平台监管后继续对消费者持续骚扰的行为进行赔偿。...', '工单类别': '一般', '处理描述': '我处会将您补充的信息及时转送，请您耐心等待，专此简复', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': None, '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015112, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 38, 18), '诉求地址': '浦东新区汇腾路95号', '诉求区域': '浦东新区', '内容描述': '市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。无照经营问题。针对蒲萧萧的韵妮东方在2017年，2018年在汇腾路95号进行市场经营的证据。希望管理部门重视因为自己的监管不力导致的后果，进行亡羊补牢。希望对无证无照经营的违法行为认定，和追回其被骗的报名费。诉求：希望管理部门核实转送相关照片至承办部门。【相关工单编号：20240104012596】', '工单类别': '一般', '处理描述': '经查，对于举报事项不予立案，理由：当时人上述违法行为在2018年12月21日终止。根据《中华人民共和国行政处罚法》第三十六条第一款“违法行为在两年内未被发现的，不在给予行政处罚”的规定，应当不予处罚。根据《市场监督管理行政处罚程序规定》第二十条第一款“经核查，有下列情形之一的，可以不予立案：（四）依法可以不予立案的其他情形”的规定，故不予立案。对于投诉事项不予受理，法院已经组织过调解，依据《市场监督管理投诉举报处理暂行办法》第十五条第（二）项的规定，故不予受理。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '无照经营', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014592, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 38, 53), '诉求地址': '浦东新区潍坊街道  ', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民要投诉潍坊街道党工委书记虞刚杰违反了《上海市街道办事处条例》第2条、第3条、第4条，以及虞刚杰领导下的滨江凯旋门居委工作失职，违反了《上海市住宅物业管理规定》第48条。诉求：希望管理部门核实查处潍坊街道党工委书记虞刚杰工作失职问题。', '工单类别': '一般', '处理描述': '潍坊新村街道队伍办接单后经了解，诉求人之前反映的汤臣中心业委会改选相关事宜一直在按照规定流程进行，不存在滨江凯旋门居委工作失职，更不存在街道虞书记潍坊条例规定的情况。约谈，故无电话录音。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '机关事务管理', '三级分类': '机关事务管理', '四级分类': '机关事务工作', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704342403-2830551', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015052, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 40, 57), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多上买到问题产品。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343171-791521', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014942, '工号': 3510, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 42, 6), '诉求地址': '本市携程', '诉求区域': '本市', '内容描述': '【投诉】市民来电反映:其反映了在携程上购买的旅游项目问题，但是管理部门一次都没有联系市民核实情况，市民认为管理部门就是不作为，要求核实告知没有任何电话联系的理由。涉及的工单编号：20231215024463', '工单类别': '一般', '处理描述': '企业已退回 此单合同主体：北京携程国际旅行社有限公司沈阳分公司', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704342942-791414', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014932, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 42, 30), '诉求地址': '浦东新区高东镇龙梢宅14号', '诉求区域': '浦东新区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240101001642，工单内容：市民来电反映:11月18日其晚上网上下单的（上海-河南驻马店），市民告知快递员19日8点取件，其把快递放在小店内，快递被顺丰快递员拿走了，快递类型：化妆品，快递单号不清楚，下单手机号码：18916548561，发货地址是浦东新区高东镇龙梢宅14号，诉求：请管理部门帮助市民找寻快递。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240101001642，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343074-2830928', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015032, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 42, 53), '诉求地址': '本市五里桥派出所', '诉求区域': '本市', '内容描述': '市民来电反映:其去上述地址派出所咨询今天是否是所长接待日，其要求工号016537得值班民警请所长出来，但是该民警全程不搭理她也不开口。诉求：请管理部门处理该民警的恶劣态度和不作为。', '工单类别': '一般', '处理描述': '在2021年4月19日，袁琳及其丈夫到五里桥派出所反映其在2018年我单位民警执法办案队冯叶欣和执法队副队长马强接报其报案，依据其提供的报警材料和报警内容认定为经济纠纷故予以托底流转。对于袁琳反复诉求认为其所报案件为诈骗案，所主要领导认为需要进一步核实情况，故在2021年4月19日对案件重新受理，通过调查处理，在4月26日经过分局审批对袁琳被诈骗案做出了不予立案的决定。之后，袁琳不断投诉。2021年5月12日，在五里桥派出所治安窗口接待室内黄浦分局督查支队、法制办和治安支队到场对袁琳投诉问题当面予以答复。法制办民警告知其如对黄浦分局作出的不予立案决定书可以先上级公安机关提出复议或检察院提...', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343115-791496', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015152, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 43, 31), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多上买到了问题产品。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343322-12188', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015092, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 44, 7), '诉求地址': '普陀区武宁路全季酒店（宜川路店）', '诉求区域': '普陀区', '内容描述': '市民来电补充信息。市民补充信息内容：酒店承认存在多收费情况，市民让酒店方保证以后不会出现此类现象，酒店表示会和总部联系，由总部回复市民，但是一直没有消息，要求尽快处理。【最近派发的工单编号：20231214018038，工单内容：市民来电反映:其于2023年12月12日14:30入住上述酒店支付了383元费用，市民表示这个价格是在其金会员卡身份基础上，经过线上预订、有优惠积分抵扣、提前预订有优惠等一系列福利后的价格，但其后续发现普通非会员入住实际价格也就370元，且这种情况出现过多次，市民表示属于欺骗消费者行为，向市场监管部门反映让其联系市民热线。诉求：请管理部门核实并对于会员及非会员价...', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231214018038，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343263-2573422', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015332, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 44, 27), '诉求地址': '浦东新区（上海）自由贸易试验区加太路39号3幢一层16室', '诉求区域': '浦东新区', '内容描述': '市民反映：2023年12月28日从拼多多平台下单“俊媳妇面条机”，商家承诺该商品为正品，收到货后经验货发现商品做工粗糙、无生产日期、无质量合格证以及无生产厂家，三无产品，甚至没有包装盒。依据《中华人民共和国产品质量法》确认商品为“三无产品”，产品商标为魔术贴粘贴，俊媳妇官方回复品牌没有此产品，商品做工粗糙,三无电器产品,可能存在不符合安全标准,带来很大的安全隐患。2023年12月31日，其向拼多多平台反馈收货商品为三无产品,并依据《中华人民共和国消费者权益保护法》提出诉求，但拼多多平台以无法核实为商家责任为由拒绝了，做出了仅退款的处理方式。2024年1月2日其向拼多多平台主张民事诉讼解决...', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '假冒伪劣', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015192, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 48, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其有一个顺丰快递（5.2KG），从江苏到上海，到上海转运中心还是5.2KG，但快递员派送，收件人收到后发现少了2KG。联系了快递公司，始终没有处理回复。单号：SF1521338409247。诉求：希望管理部门督促快递公司尽快给到处理办法。', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343498-2831151', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104014272, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 51, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343778-12425', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015242, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 53, 14), '诉求地址': '宝山区宝安公路363号', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述地址一家超市存在卖假货的情况，名字：huoxin全球优品折扣仓。市民花费5000元买食物，食物都是过期的。诉求：希望管理部门核实后对该超市售卖过期食品，假货的行为进行取缔整治。', '工单类别': '一般', '处理描述': '经查，经与举报人4次电话沟通要求提供相关证据材料，举报人拒绝提供，依据现有证据尚不能认定当事人有举报人所举报的违法行为，故我局不予立案。', '客户类型': '个人', '一级分类': '安全监管类', '二级分类': '食品药品安全', '三级分类': '安全管理', '四级分类': '食品安全', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343469-791696', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015142, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 53, 34), '诉求地址': '松江区新桥镇明中路万科白马花园', '诉求区域': '松江区', '内容描述': '市民来电反映:上述地址小区附近有政府建设的草坪，但是草坪上和道路上有很多狗的粪便，污染环境。诉求：希望管理部门安排志愿者加强对养犬人的文明宣导和管理。（需回复）', '工单类别': '一般', '处理描述': '松江区12345市民服务热线接单后，派单至新桥镇。事实认定采纳，新桥镇集镇区管委会于1月4日先行联系市民，确认工单内容。辖区工作人员已经前往现场查看，并安排人员定期巡查定期清理，同时对绿地遛狗人士进行文明遛狗的宣传引导。于2024年1月17日电话联系市民确认，市民表示满意。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '其他', '四级分类': '其他', '主办单位': '松江区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343749-791845', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104013132, '工号': 4322, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 53, 55), '诉求地址': '宝山区外环高速', '诉求区域': '宝山区', '内容描述': '市民来电反复催单，表示管理部门除了先行联系外，未在联系过，且市民一再交警除开具子昂管证明，由于管理部门一直未联系处理，故无法办理相关车辆维修等事宜，诉求：要求管理部门尽快联系处理【最近派发的工单编号：20231231008111，工单内容：市民来电反映:12月30日15:00左右市民车辆行驶到外环高速内侧82公里处时车辆压到地面异物，造成市民车辆右侧轮胎爆胎车身损坏，诉求：希望管理部门核实并请联系市民商讨赔偿事宜。】', '工单类别': '一般', '处理描述': '已电子催单工单编号：20231231008111，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': '路状路况', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704343708-2573646', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015662, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 12, 58, 49), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询: 车辆通过瓜子二手车卖了，资讯下家不配合办理过户的话，怎么办。', '工单类别': '一般', '处理描述': '转接车管所成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704344141-792058', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015802, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 2, 33), '诉求地址': '浦东新区高宝路金京路', '诉求区域': '浦东新区', '内容描述': '市民补充信息内容为市民同时被收取了拖车费1500元，而且警察也不开交通事故认定书让市民第2天去候车点。诉求：请管理部门解释为何要扣车、不开交通事故认定书。【最近派发的工单编号：20240104015310，工单内容：市民来电咨询:其今天1月4日中午11:12分发生交通事故，不小心驾驶车辆撞坏了电线杆，后续警察前往处理并在中午12:30分进行扣车，其对于扣车不明白，请管理部门解释为何要扣车。（ 车牌号：沪AAG8906）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240104015310，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通事故', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704344312-12740', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016002, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 3, 52), '诉求地址': '青浦区崧泽大道333号国家会展中心国展文创馆', '诉求区域': '青浦区', '内容描述': '市民反映：2023年第六届进博会期间11月6日于青浦国展中心的文创馆购物，当时购入3个书签，每个书签38元，共计114元（详见附件）。后因款式问题，想申请换货，其购入的商品完好并无拆封，商家的换货流程是先退款，再重新买。11月8日早上到店进行退货，货和发票均已交还，但商家说由于隔了一天的原因，退款无法立即到账。11月9日再次咨询商家，说只能登记市民的情况，进博会过后统一退款，让等一周时间。11月21日依然没有到账，商家说一周内可以。12月又反复确认数次，一直说本周内可以，直至2024年1月4日依旧没有收到退款。诉求：请督促退款。', '工单类别': '一般', '处理描述': '经调解，商家已退款，经办人员于2024年1月16日电话联系投诉人确认，投诉人表示满意。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015932, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 5, 11), '诉求地址': '黄浦区北京东路', '诉求区域': '黄浦区', '内容描述': '市民来电咨询:查询某品牌空调的售后电话。', '工单类别': '一般', '处理描述': '已解释归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '家电维修', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704344597-2831786', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104015852, '工号': 3542, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 5, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:外省市户籍，在上海交社保超过10年，如何确认养老金领取地。', '工单类别': '一般', '处理描述': '怎样申办退休？如何确定退休地？', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '养老保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704344457-12819', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016402, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 16, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:货车申请了通行证，但是道路上有指示表示显示禁止左转，询问交通规定', '工单类别': '一般', '处理描述': '市民自行挂机，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通法规', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704345237-792765', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016492, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 20, 24), '诉求地址': '浦东新区北蔡镇新浦路380弄4号302室', '诉求区域': '浦东新区', '内容描述': '市民来电反映相同事项。按答复市民要点告知市民，答复市民要点清晰（明确）。【最近办结的工单编号：20230831007889，工单内容：重新交办，按照答复要点告知市民，市民表示答复要点与实际情况明显不符，不符的内容：市民表示反映的是新建小区应该经过周边小区居民同意，给到补偿，并没有说是动迁安置小区，其了解到应该是有政策规定的。市民诉求：希望管理部门核实是否有政策规定新建小区要经过周边小区居民同意。最近办结的工单编号:...', '工单类别': '一般', '处理描述': '按答复要点告知市民，答复要点清晰、明确，市民不认可，此单归档。\n', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '施工规范', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704345306-13346', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016922, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 21, 33), '诉求地址': '浦东新区云山路黄山始信苑西门口', '诉求区域': '浦东新区', '内容描述': '市民建议：黄山始信苑小区西门口，云山路靠近博山东路，每天晚上数辆汽车违规停在非机动车道上（详见附件），带来很大安全隐患。诉求：请整治违章停车。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '上海市公安局浦东分局交警支队一大队民警于2024年1月4日16时32分许与来电市民取得联系，具体答复内容：接市民热线工单后，我队至现场实地踏勘，现场未发现有机动车长时间违停情况，偶有机动车临时停靠上下客。上述路段系非黄线路段，允许车辆临时停车上下客。在发生提醒驶离短信后，车辆仍在此处停留超过12分钟，方可认定其违法停车予以处罚。针对提问人反映的情况，支队属地一大队加强巡视管理，我队将结合日常交通管理工作，在日常巡逻中对上述地址加强关注，对市政道路范围内的违法停车严查严处，全力维护辖区道路交通秩序。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '市公安局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016702, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 22, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:一家上海公司经常发东西给市民。', '工单类别': '一般', '处理描述': '已解释，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704345595-2574824', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016412, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 22, 37), '诉求地址': '黄浦区海南西弄靠近普育东路', '诉求区域': '黄浦区', '内容描述': '市民来电反映:上述地址海南西弄是双向单行道。市民称该处道路狭小，故车辆通行困难。此事存在安全隐患，且影响居民出行。市民建议：建议管理部门核实后将上述道路改为单向道。', '工单类别': '一般', '处理描述': '市公安局黄浦公安分局交警支队于2024年1月18日10时12分与来电市民李女士取得联系。具体答复内容：对于来电人反映的问题，分局交警支队已进行实地查看，并进行了耐心细致地回答，海南西弄是非市政道路，其属于物业管理，行政部门不能擅自更改。故对于来电人提出的建议，分局交警支队不予采纳。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通设施', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704345255-2574594', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016742, '工号': 2622, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 24, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是2018年购买的车辆，怎样计算属于6年免检车辆', '工单类别': '一般', '处理描述': '根据《办理核发机动车检验合格标志手续(6年内免检政策)》告知，归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '车辆年检', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704345651-2574856', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016832, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 25, 53), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电咨询:询问自己能缴纳灵活就业社保吗。', '工单类别': '一般', '处理描述': '告知市民外省市可以缴纳市民认可。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '账户信息', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704345788-13682', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016822, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 27, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:2001年年初其处贷款购车，相关车辆是上海牌照的。当时其处有办理车辆抵押手续。现车辆已到报废期限。现其处要办理解除抵押手续，故来电咨询相关信息。', '工单类别': '一般', '处理描述': '转接公安车管所专席成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704345781-793128', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016962, '工号': 4160, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 28, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:新车上牌怎么办理？', '工单类别': '一般', '处理描述': '根据《办理机动车注册登记手续》告知，市民认可。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704346031-793305', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016722, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 33, 7), '诉求地址': '静安区西藏北路和兴大厦3楼（小豹出行）', '诉求区域': '静安区', '内容描述': '市民来电反映相同事项。【最近派发的工单编号：20240104014076，工单内容：市民来电反映:12月16日通过上述企业租借一辆电瓶车跑外卖，使用期间因为电瓶车的电子号牌有问题，就交警扣了，并缴纳5元罚款，之后租车公司为其更换了一辆电瓶车，结果2天后又被扣了，市民表示其等于没有怎么使用电瓶车，要求退还支付的租金700元，但是租车企业只肯退还100元租金，市民不认可，诉求：要求协调企业全额退还租金。】', '工单类别': '一般', '处理描述': '市民来电反映相同事项，已解释，告知耐心等待。工单编号：20240104014076，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704345578-2832465', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104017182, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 34, 34), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民的机动车（苏U591C1）在12123APP上显示转入受理成功，但是车管所表示查不到让市民拨打12345。诉求：请管理部门尽快帮助市民正常转入。', '工单类别': '一般', '处理描述': '市公安局车辆管理所综合科张逸凡于2024年01月05日14时05分来电市民李女士联系，告知来电人根据系统查询，现显示转籍业务预受理成功，现可预约至线下办理转入业务。工号：17。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704346225-13964', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104017832, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 42, 10), '诉求地址': '静安区芮欧百货喜茶店', '诉求区域': '静安区', '内容描述': '市民反映：在喜茶app小程序上点外卖，单号：H948890857682063361833，收取4元包装费，还不能取消，实际上包装只有一个普通袋子，属于强制性消费（详见附件）。诉求：要求退回多收取的费用，对网上强制性包装费收取的行为予以更改。', '工单类别': '一般', '处理描述': '接单后，我所及时进行调查，双方已和解，投诉人表示认可，我局决定终止调解，另外，我局没有发现商家存在价格违法行为，不予立案，办结。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104016992, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 44, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:12月份社保退费问题。', '工单类别': '一般', '处理描述': '与市民解释说明，市民认可，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '养老保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704346914-2833450', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104017492, '工号': 2310, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 45, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2013年夫妻二人共同写过，市民带笔和有市民老公签字，去世后财产归对方一半，市民儿子是认可的，市民老公是过世的，财产归市民。诉求：请管理部门告知房产证的追溯时间如何规定。（需回复）', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '房产信息变更', '主办单位': '市规划和自然资源局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704346825-2833368', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104017782, '工号': 4330, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 46, 9), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:想咨询公积金为什么无法提取，经同意，转接公积金专席。', '工单类别': '一般', '处理描述': '转接公积金成功,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704347006-2833533', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018072, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 46, 20), '诉求地址': '奉贤区柘林镇新北路170号', '诉求区域': '奉贤区', '内容描述': '市民反映：上述地址靠近学校，有一堆垃圾碎石砖块，有一两个月没清了。诉求：希望管理部门安排人员清理。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '柘林镇于2024年1月4日接单，于首次通过电话联系来电人，告知其问题已收悉，正在进行办理。1月5日下午1时，由居委对来电人所反映的情况进行核实，并进行了现场勘查并清理完成，已将处置结果告知来电人，该问题已经实际解决，经办人钱诚。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '环境垃圾', '主办单位': '奉贤区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018062, '工号': 3052, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 46, 52), '诉求地址': '青浦区白鹤镇鹤如路镇中小区西南门至房地苑三期98弄（六栋楼）', '诉求区域': '青浦区', '内容描述': '市民反映：上述地址路边绿化树过于茂盛，枝干遮挡道路监控摄像头及照明路灯，行人夜晚走路光源暗，非机动车道路面不平，绿化树枝干遮挡居民楼采光，距离居民楼阳台过近。诉求：希望管理部门及时修剪。', '工单类别': '一般', '处理描述': '此工单诉求内容属实，白鹤镇城运中心于2024年1月4日接单，于2024年1月4日13:52分首次通过电话先行联系诉求人，告知诉求已收悉，正在我单位办理。办理情况为：收到市民的诉求后，白鹤镇绿化公司第一时间前往现场查看，把遮挡路灯及监控的树枝，以及离居民家阳台的树枝都已完成修剪。【以下内容不建议向诉求人透露：据与绿化公司了解，该区域原定于3月进行统一树木修剪，但因此前收到绿化修剪过多的相关投诉，结合此次修剪，故3月的修剪计划依实际再定，该情况与市民做解释说明。】已将处置结果告知来电人，该问题已经解释说明。经办人：邵华', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '绿地绿化', '四级分类': '移植修剪', '主办单位': '青浦区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104017882, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 47, 29), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:1月4日医院就医发现社保卡被封，社保没有中断过。', '工单类别': '一般', '处理描述': '转接社保卡成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704347071-794070', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104017972, '工号': 3940, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 47, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，要求转接拼多多。\n', '工单类别': '一般', '处理