, 43, 4), '诉求地址': '松江区九亭镇涞坊路与寅西路交叉口', '诉求区域': '松江区', '内容描述': '市民反映：上述地址渣土车在道路违停，导致车辆拥堵，影响交通安全。诉求：建议管理部门整治违章。', '工单类别': '一般', '处理描述': '市公安局松江分局交警支队三大队于2024年1月17日14时57分与来电市民李先生取得联系，具体答复如下：针对市民诉求，大队民警已至市民诉求地址进行违法停车特别是土方车的劝离及查处。因违法停车存在返潮现象，后期大队将持续关注辖区内违停问题，及时发现、及时查处，并制定相关长效机制进行管理。向市民解释说明市民对答复表示满意！', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '市公安局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107001102, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 7, 8, 46, 58), '诉求地址': '黄浦区中山南路1887号金中苑小区', '诉求区域': '黄浦区', '内容描述': '市民来电咨询处理进度。【最近派发的工单编号：20240107000833，工单内容：市民来电反映:上述地址小区内，1月7日8:00就开始 小区绿化改造噪音扰民，诉求：管理部门核实情况后协调减少噪音。（市民要求信息保密，需要回复。）】', '工单类别': '一般', '处理描述': '解释，归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704588249-998143', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107001452, '工号': 4292, '工单生成时间': datetime.datetime(2024, 1, 7, 8, 47, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704588319-2305176', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107001402, '工号': 2820, '工单生成时间': datetime.datetime(2024, 1, 7, 8, 47, 45), '诉求地址': '宝山区长江路中成智谷', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述地址的一个工业园区的在施工（非建筑工地）。早上6:30开始施工噪音扰民严重。诉求：希望核查降低施工噪音。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '检查检查未发现有施工作业扰民的情况，早上6:00点符合相关法律要求，目前针对投诉情况已经将情况反馈给了物业加强宣教避免不必要的扰民', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704588237-998141', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107001482, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 7, 8, 49, 30), '诉求地址': '徐汇区东安路270号复旦大学肿瘤医院', '诉求区域': '徐汇区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240106001511，工单内容：重新交办，要求：答复要点不明确，市民表示当地医院已经确认其为肿瘤，但肿瘤医院不给其就诊。诉求：请管理部门协调上述医院为市民就诊手术。工单内容：重新交办,要求：按答复要点告知市民,市民表示答复要点与实际不符，管理部门没有电话联系市民回复过。诉求：要求管理部门核实并尽快答复。最近办结的工单内容:重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,答复中并未提及是否有淋巴结肿瘤外科，或答复中提及的这些科室是否包含淋巴结肿瘤外科。诉求：希望管理部...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240106001511，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '住院病床', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704588437-264629', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107001432, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 7, 8, 50, 38), '诉求地址': '本市外滩美术馆', '诉求区域': '本市', '内容描述': '市民来电反映:12月20日左右前往上述地址看过展览，市民当时在现场登记了需要开具发票的需求，后续并没有拿到发票，而且也联系不上相关电话，涉及金额80元，要求管理部门对此进行核实并要求对方尽快开具', '工单类别': '一般', '处理描述': '经核实，与市民联系，市民表示相关问题已解决。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '文广影视', '三级分类': '文化产业管理', '四级分类': '文化场所信息', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704588449-264633', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107001472, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 7, 8, 50, 43), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:自己的敬老卡目前刷不了了。后续又表示自行去社区事务受理网点。', '工单类别': '一般', '处理描述': '市民表示前往线下网点，无需派单，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '社区家政', '四级分类': '社区服务网点', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704588363-3086530', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107001632, '工号': 4272, '工单生成时间': datetime.datetime(2024, 1, 7, 8, 52, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:需要开通新版社保卡', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类