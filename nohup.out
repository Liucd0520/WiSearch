4', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103001822, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 41, 35), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:企业一次性扩岗补助 的相关问题', '工单类别': '一般', '处理描述': '告知市民，9点后可以转接人力转系，归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704242347-403296', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103001592, '工号': 1242, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 42, 24), '诉求地址': '普陀区万里城实验学校', '诉求区域': '普陀区', '内容描述': '市民来电补充信息。市民补充信息内容为学校允许家长在学校范围内和线上进行煽动和侮辱，和学校反映了，学校告知成年人无法管理，未成年人可以管理，但是会做提示，现在其没有看到提示，诉求：要求尽快处理。【最近派发的工单编号：20240101005841，工单内容：市民来电反映:其有多次投诉上述学校事宜，但是学校没保护学生隐私，其对一些做法有投诉，目前竟然公开投诉者信息给其他家长，有家长在群里歪曲事实，煽动，威胁，班主任不作为不公正，还只是个体育老师不教其他课程的，学校处理事情不合理甚至违规，公开场合向其他家长泄露投诉人事宜，对学生有变相体罚，给孩子在学校树敌造成恶劣环境，碰到过放学没接到孩子，老师...', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240101005841，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '学校管理', '四级分类': '教育质量', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704242030-2437786', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103001812, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 45, 54), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:中通快递公司（吉林），快递单号：无应答。', '工单类别': '一般', '处理描述': '建议向当地进行申诉。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704242527-403377', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002402, '工号': 3772, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 47, 6), '诉求地址': '徐汇区汇师小学', '诉求区域': '徐汇区', '内容描述': '市民反映：汇师小学给每个班级的每位学生的家长编排值班表，强制要求家长在学生上学和放学时间准时到校门口执勤站岗。如学校保安人手不足，请管理部门聘用有相关技能的专业人员，也能更好地维护学校安全。家长并不是学校的雇员，也不具备技能，大多有自己的工作，这种强制排班的做法加重家长的负担，对学校安全也没太大帮助。如真出现安全事故，责任亦无法认定。诉求：请管理部门制止学校安排家长执勤。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '我局于2024年01月03日09点27分与市民先行联系。经了解，学校从未硬性规定家长执勤。家长均是在家委会的组织和带领下，积极参与，每天与学校领导、老师、社区志愿者共同承担志愿服务工作。如市民遇到特殊困难可以根据实际情况与家委会和班主任老师沟通。我局于2024年01月05日10点38分回复市民。我局工作人员多次解释说明，市民一定要求取消志愿执勤安排，诉求明显不合理，无法满足，故申请不属实。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '其他', '四级分类': '其他', '主办单位': '徐汇区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002222, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 49, 27), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:圆通快递公司（河北），该件收件方一直告知未收到件。', '工单类别': '一般', '处理描述': '建议向当地进行申诉。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704242844-403553', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002242, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 49, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民为个人消费者，要求转接拼多多专席\n', '工单类别': '一般', '处理描述': '转接拼多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704242919-2696185', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002032, '工号': 1680, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 50, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其要办理居住证，但是在随申办上显示我的网签备案已经房屋所属房屋已经登记过了，无法再做登记，询问是什么意思。', '工单类别': '一般', '处理描述': '已解释，根据《962269》告知，市民认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704242696-403466', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002382, '工号': 2632, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 55, 45), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多买了一盒鸡蛋，破损包赔的，拍了开箱视频，里面没有鸡蛋，是空盒子。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704243211-403737', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002682, '工号': 4040, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 57, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映：市民哥哥的敬老卡遗失了，如何补办。银行让市民去社区事务受理中心，社区中心表示只能补两年的钱。根据身份证号查询已正常发放养老津贴。', '工单类别': '一般', '处理描述': '根据《老年综合津贴工作实操问答》告知，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '养老保障', '四级分类': '老年津贴', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002482, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 57, 56), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:行李箱忘在松江七路上了', '工单类别': '一般', '处理描述': '告知信息，归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '出租车', '四级分类': '物品遗失', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704243364-2696413', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002512, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 57, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，需要转接拼多多', '工单类别': '一般', '处理描述': '转接多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704243353-403809', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002322, '工号': 2320, '工单生成时间': datetime.datetime(2024, 1, 3, 8, 59, 58), '诉求地址': '黄浦区南京东路世贸广场', '诉求区域': '黄浦区', '内容描述': '市民来电反映:12月31日前往上述地址8楼看剧（沉浸式剧场），现场为刚装修好的剧场，不知道没有通风系统还是没有开启，进去没有多久就开始头晕，市民要求管理部门对于该剧场装修之后的有害物质超标现象进行核实并整改。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '我单位2024年1月5日接单，于1月15日首次通过电话先行联系来电人，告知其问题已经收悉，正在我单位进行办理。由我单位对来电人所反映的情况进行核实，监督所于1月11日对该场所进行监督检查，经查，该剧场均未办理《营业执照》和《上海市公共场所卫生许可证》，该剧场提供了2024年1月的公共场所卫生检测报告，但检测项目不齐全；该剧场开业至今未开展过集中空调通风系统卫生检测；监督所已告知该剧场负责人，应办理公共场所卫生许可证。对该剧场未按照规定开展集中空调通风系统卫生检测的行为，立案调查；对该剧场公共场所卫生检测报告检测项目不齐全的问题，拟发出责令改正通知书。已于2024年1月16日告知市民，空气...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '空气污染', '主办单位': '黄浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704243129-403697', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002732, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 3, 59), '诉求地址': '闵行区', '诉求区域': '闵行区', '内容描述': '市民来电咨询:市民通过交管12123预约1月3日下午前往二分所，补办登记证书和亲属赠予过户，是否能提前到上午去办理。', '工单类别': '一般', '处理描述': '为市民转接公安车管所专席，转接成功，此单归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704243623-659447', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002582, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 5, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:小朋友是上海户籍，能不能去辖区派出所更改小朋友的籍贯。', '工单类别': '一般', '处理描述': '市公安局人口办户口准入处于2024 年1月4日10时 42分与来电市民盛女士取得联系，具体答复内容如下：经电话联系，来电人咨询工单所述问题，告知市民婴儿原则上应当随父登记籍贯。父亲为外国人或者《出生医学证明》上未记载父亲信息的，随母登记籍贯。申请人要求登记本人祖父的居住地作为籍贯，也可予以登记，所需证明材料原则上为祖父户口簿，其他能证明祖父居住地的材料均予以认可。 关注公安网上户籍平台（“上海公安人口管理”（shgarkb）微信公众号）查看告知单内容。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '户籍政策咨询', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704243466-403863', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240103002972, '工号': 3290, '工单生成时间': datetime.datetime(2024, 1, 3, 9, 9, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询：病假工资发放的问题', '工单类别': '一般', '处理描述': '告知信息，归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动人事制度', '四级分类': '工资奖金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704243884-404148', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类