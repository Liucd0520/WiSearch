, '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是企业，该企业有员工持有的是安全员C证，其要咨询安全员C证如何变更服务单位。请管理部门给予回复。', '工单类别': '一般', '处理描述': '已告知进沪换证流程。', '客户类型': '企业', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '其他', '四级分类': '其他', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704347561-794482', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018522, '工号': 2152, '工单生成时间': datetime.datetime(2024, 1, 4, 13, 59, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其目前是61岁，现在换了一家单位没有帮其交金，还差一年，一个月承担2558元无法承受，咨询：请管理部门告知有没有补贴。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704347770-794642', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018542, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 0, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其社保卡丢失。其在支付宝上申请补办时系统显示姓名信息不一致，故来电咨询原因。', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704347785-794652', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018962, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 1, 38), '诉求地址': '静安区西康路928号静安创展大厦', '诉求区域': '静安区', '内容描述': '市民反映：其是创展大厦313业主，隔壁315客户在公共设施平台上堆放大量物品，该设施平台摆放的都是空调外机，这些物品都是易燃物品，长期堆放存在较大的安全隐患（详见附件）。向物业反映，物业要求客户搬离，客户一直推脱。诉求：希望管理部门予以整治。', '工单类别': '一般', '处理描述': '【江宁路街道】经调查，西康路928号系创展大厦，物业服务企业为上海中企物业管理公司。经与物业经理核实，投诉人所反映的堆物已经清理完毕。鉴于上述情况，我中心督促物业服务企业在接到投诉时及时处理并做好沟通解释工作。专管员桑，联系电话62898071', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '静安区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018452, '工号': 3262, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 1, 40), '诉求地址': '闵行区梅龙镇双柏路1688弄77号402室', '诉求区域': '闵行区', '内容描述': '市民来电反映:其是上述地址居民，楼宇前面有一片绿化带，绿化带内树梢挂八块白布与白色的孩子衣服，已经很长时间，无人清理。诉求：请管理部门核实并要求把上述地址绿化带内树梢上的垃圾尽快清理掉（市民要求无需回复）', '工单类别': '一般', '处理描述': '梅陇镇银泰苑居委于2024年1月4日接单，于2024年1月4日15时进行核实并现场处置（已经有物业保洁工作人员对该处绿化带及树枝上的不明垃圾处置完毕 ），因诉求人未留联系方式，故无法联系，该问题已经实际解决。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '绿化维护', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704347731-794608', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018782, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 2, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电要求转接拼多多', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348048-15458', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018702, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 4, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民需要查询其在本市12月的社保是否缴纳.', '工单类别': '一般', '处理描述': '转接人力资源社会保障专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '养老保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704347991-15407', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018652, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 4, 28), '诉求地址': '崇明区城桥镇明珠花苑33号楼楼下', '诉求区域': '崇明区', '内容描述': '市民来电反映:上述地址（市民不清楚具体名称）有一家卖菜卖肉店卫生情况堪忧。诉求：请管理部门尽快告知市民该商家的营业执照是否可以卖菜卖肉，并尽快检查商家的卫生情况。', '工单类别': '一般', '处理描述': '经查，明珠花苑33号楼下的卖菜卖肉超市具有营业执照及食品经营许可证，名称为上海市崇明区宇冉食品商店，现场未查见违法行为。', '客户类型': '个人', '一级分类': '安全监管类', '二级分类': '食品药品安全', '三级分类': '安全管理', '四级分类': '食品安全', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704347912-2097935', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018772, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 5, 41), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电对办理结果不满，现交通委与其联系称自己只负责查四轮车的额度并未告知摩托车额度找何处查询真伪故其再次来电希望明确告知找哪里查询摩托车额度信息。【最近派发的工单编号：20240104006379，工单内容：市民来电反映:在本市车行买了一辆摩托车，市民不清楚摩托车牌照额度单是否已经生成，身份证号码：310227198002064412，姓名：夏明强，诉求：要求有关部门核实后告知市民摩托车额度是否已经生成。】', '工单类别': '一般', '处理描述': '市民对办理结果不满，已电子催单工单编号：20240104006379，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348050-15463', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018792, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 10, 41), '诉求地址': '本市 ', '诉求区域': '本市', '内容描述': '市民来电反映:其之前投诉中国黄金店铺，承办部门回电要市民提供购买凭证，市民表示有的但目前找不到，来电要求税务部门去查门店账目后交给市场监管部门继续处理。市民要求派单给工商税务处理。', '工单类别': '一般', '处理描述': '在线告诉市民按流程派单，市民诉求超受理范围，市民不认可并自行挂机，此单归档。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348064-2834429', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019032, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 10, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231230000589，工单内容：市民来电反映：其在拼多多上买了一条裤子，订单编号：231125524696963884059，价格：31.9元，表示裤子严重掉色，并且两个裤腿长度不一样，诉求：希望管理部门协助退款。（需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231230000589，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348336-2834639', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019342, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:在拼多多上购买了眼影，使用后发现无法卸妆，并且上色很深，为此认为质量有问题，订单号：231231292731022764059 价格11.9元，平台上无法提出售后申请。诉求：希望有关部门给予核实维权。', '工单类别': '一般', '处理描述': '经查，被投诉人表示投诉人的诉求无法满足，双方无法达成调解协议，依据《市场监督管理投诉举报处理暂行办法》第二十一条规定，现我局决定依法终止调解。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348336-2834639', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019132, '工号': 3262, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 12, 8), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:外省市车牌蓝牌车辆，地面限行时间，翔殷路隧道是否可以走', '工单类别': '一般', '处理描述': '根据《本市地面道路对外省市号牌小客车的限行措施有哪些？》,《黄浦江隧道哪些车辆不能通行？》,《本市城市快速路（高架道路）对外省市号牌小客车以及本市临牌小客车等的限行措施有哪些？》,\n《如何查询本市相关道路限行措施？》', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '限流限行', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348467-2834743', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019142, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 13, 17), '诉求地址': '静安区（不方便告知具体地址）', '诉求区域': '静安区', '内容描述': '市民来电咨询:静安区小区房屋交房后，关于物业服务费的收取规定是怎样的，从何时开始计费支付，标准如何，是否是根据不同物业公司来收取，还是统一的物业标准规定收取。（需回复）', '工单类别': '一般', '处理描述': '【房管局】工作人员于1月4日致电市民并告知：根据《上海市住宅物业管理规定》第四十九条，前期物业服务合同生效之日至出售房屋交付之日的当月发生的物业服务费用，由建设单位承担。出售房屋交付之日的次月至前期物业服务合同终止之日的当月发生的物业服务费用，由物业买受人按照房屋销售合同约定的前期物业服务收费标准承担；房屋销售合同未约定的，由建设单位承担。', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '物业管理收费', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348499-795198', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019372, '工号': 3420, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 15, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其父亲名下有辆机动车要过户给市民，但其父亲去世了，如何办理过户，需要什么材料', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348727-16011', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019512, '工号': 4010, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 16, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:咨询上海社区医疗互助卡是否交费了  ', '工单类别': '一般', '处理描述': '转接成功，工号45270，归档 ', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '医疗保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348802-16073', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019352, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 16, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其在随申办为孩子办理居住证进行提交时提示自动审核5-10分钟，人工审核24小时以内，其点击返回后没有任何信息故来电确认办理情况。', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348716-2098601', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019522, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 17, 53), '诉求地址': '徐汇区襄阳北路108号', '诉求区域': '徐汇区', '内容描述': '【重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符：实际我处口径中就是由文旅执法局处理，为何明明应该处理的却不处理，诉求：请处理。最近办结的工单编号：20231220011819，工单内容：重新交办，要求：按答复要点告知市民，市民表示答复要点与实际情况不符，写清不符的内容：自称是体育局的工作人员致电市民说找不到这个公司，市民表示目前退款问题仍未解决，诉求：原诉求不变。（需回复）最近办结的工单编号：20231031024899，工单内容：市民来电反映:其在威尔士健身房（电话：021-80317547）购买了健身卡，不含私教课，有合同，有效期10年，支付了3万2...', '工单类别': '一般', '处理描述': '2024年1月10日，本机关收到总队转来市民通过“12345市民热线”对襄阳北路108号威尔士嘉华中心的预付费投诉举报（编号：总S202401083）。 2024年1月16日，本机关执法人员收到门店经理谢经理反馈：总部那边就反馈还在客服审批，我所做的只能催促。我的权限就这么点 综上所述，本机关建议市民通过司法立案途径解决退款事项。（加快速度） 目前我市正在积极推进司法职能融入一网通办，市民可以通过在手机端“随申办市民云”APP中搜索“诉讼服务”，再点击“网上立案”，之后上传相关证据。市民还可以到徐汇区人民法院（龙漕路128号）提起诉讼。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市文旅局执法总队', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348855-795482', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019582, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 18, 4), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:含有金融功能的社保卡是否是开通的状态', '工单类别': '一般', '处理描述': '转接社保卡成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348890-2098778', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019282, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 19, 4), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反复催单，市民表示管理部门至今未处理。市民诉求：要求尽快处理并人工回复不要短信回复，同时要求处理之前11月7日投诉的问题。（市民要求需要回复）【最近派发的工单编号：20231226021582，工单内容：【重新交办，要求：按答复要点告知市民，市民表示答复要点不明确，市民表示管理部门没有就其投诉回电人员态度问题进行答复，也没有给市民电话回复。诉求：希望管理部门再次核实处理。（市民要求回复）...', '工单类别': '一般', '处理描述': '要求尽快处理并人工回复不要短信回复，同时要求处理之前11月7日投诉的问题谢谢。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '服务态度', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348586-2098498', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019792, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 20, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:消费者转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704349152-795738', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019652, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 20, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。说可以退款给市民，但是，扣了25%的违约金，总共2280元，只能退1478元。除了这些以外，钱要60天以后才能到账。市民认为不合理。要求尽快处理。【最近派发的工单编号：20231219021631，工单内容：重新交办，要求：答复要点与实际情况不符。市民表示2022年8月时，长城宽带的业务员建议市民续费时间长一点，市民就续费到了2029年，支付2280元。现在市民爱人身体不好，多次住院，市民也已78岁，无力照顾，决定住到养老院去，不再使用宽带。长城宽带告知不能退费，市民不认可，表示其可以适当支付违约金，还是希望可以退费。诉求：希望管理部门核实，协调退费。【最近办结的工单编...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231219021631，故归档。', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '通信', '四级分类': '业务办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348974-795590', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019552, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 22, 39), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240104010296，工单内容：【投诉】市民来电投诉12345市民热线反映的问题不起作用。】', '工单类别': '一般', '处理描述': '已按照投诉处理流程进行核实处理。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '投诉批评', '四级分类': '办事效率', '主办单位': '12345热线处理', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704348865-2835101', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104018252, '工号': 3660, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 24, 31), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:跟租车公司产生的纠纷问题', '工单类别': '一般', '处理描述': '建议先找租车公司沟通解决', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '法律援助', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704347571-2834018', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104019672, '工号': 4330, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 26, 58), '诉求地址': '宝山区大场镇大华路', '诉求区域': '宝山区', '内容描述': '市民来电反映:于2023年10月在随身办APP上申请了宝山区大场镇大华路公租房业务，查看随身办APP，一直未更新，也未受到任何相关回复。由于申请公租房有6月的时效期，市民想知道是否成功申请，还需要等待多久，如申请未成功，能否将原来的申请撤销，以便市民重新申请。诉求：请管理部门核实并向市民回复处理方案。', '工单类别': '一般', '处理描述': '经沟通，相关单位对市民的诉求进行了解答。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '保障型住房', '四级分类': '公租房', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704349018-16285', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104020072, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 4, 14, 27, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民需要查询其社保缴费明细.', '工单类别': '一般', '处理描述': '转接人力资源社会保障专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '