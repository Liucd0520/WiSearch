, 21, 20, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:驾驶证遗失，如何补办。', '工单类别': '一般', '处理描述': '根据《驾驶证损毁或遗失，如何通过交通安全综合服务管理平台办理补证业务？》告知，市民认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '驾驶员审验', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704115147-3093717', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017392, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 1, 21, 25, 48), '诉求地址': '闵行区马桥镇元松路联青路', '诉求区域': '闵行区', '内容描述': '市民来电反映:每逢17:30分到22:30分或24:00分该处有一个无证设摊卖炒饭炒面，现诉求：望管理部门尽快查处取缔。 （市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '马桥镇综合行政执法队于1月2日接单，诉求人匿名无法先行联系。经现场查看，该处确实存在设摊情况，已进行了处置，后续会加强巡查管控，诉求人匿名，无法回复。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704115023-534475', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017562, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 1, 21, 35, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:需要转接拼多多服务专席。', '工单类别': '一般', '处理描述': '根据“转接承办单位座席流程”给予市民解答，市民表示认可，此单归档。 ', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704116003-278449', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017662, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 1, 21, 51, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:掌门一对一的事情，市民表示不需要处理了。', '工单类别': '一般', '处理描述': '市民表示无需反映，归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '培训市场', '四级分类': '市场监管', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704116998-278534', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017692, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 1, 21, 53, 54), '诉求地址': '浦东新区新场镇丝庐雅苑东侧', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址工地节假日施工，对周围市民生活带来影响。诉求：要求管理部门上门整治。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '亲爱的市民，您好，您反映的问题新场城管中队已予以核实。接投诉后，新场中队执法人员前至丝庐雅苑东北侧工地进行检查并了解其在元旦期间的施工情况，该工地负责人承认该工地存在节假日期间施工的情况，中队执法人员要求其严格施工管理，在施工期间降低对周边居民生活的影响，该工地负责人表示积极配合。后续中队将会对该处加强巡查。感谢您对我们工作的支持和理解，祝您生活愉快！因匿名投诉，故无法联系市民。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704117026-2311739', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017572, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 1, 21, 55, 51), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电对办理结果不满：12月31日15:00分左右与晚上其反映拼多多客服，1月1日晚上拼多多短信答复只退费，其它诉求无法满足，市民不认可，市民表示不解决其会投诉市场监管局，现诉求：要求商家赔偿。【最近派发的工单编号:20231222032849，工单内容:市民来电反映:其在拼多多上购买了一个监控探头，使用后发现监控程序内有色情付费广告内容。11月28号开始，市民多次联系平台客服反映，平台给到的最终方案是退货退款赔付100元。市民对于该方案不认可，要求平台赔偿600元，并对商家进行处罚。订单号：777179813953065。诉求：请管理部门核实，协商平台给到合理处理方案。（市民希望短信...', '工单类别': '一般', '处理描述': '市民对办理结果不满，已电子催单工单编号：20231222032849，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704116159-534590', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017722, '工号': 1520, '工单生成时间': datetime.datetime(2024, 1, 1, 21, 59, 11), '诉求地址': '长宁区', '诉求区域': '长宁区', '内容描述': '市民来电咨询办理答复。【最近派发/办结的工单编号20240101004184，工单内容:市民反映：拼多多购买摄像头，商家设置密码不对，应该是用户自己设置密码，平台说是3个工作日解决（详见附件）。诉求：希望尽快解决密码设置问题。】', '工单类别': '一般', '处理描述': '告知已受理处理，请市民等待处理答复。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704116159-534590', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017802, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 1, 22, 5, 58), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:本市户籍未成年人申请护照换发手续。', '工单类别': '一般', '处理描述': '根据《 本市户籍居民及驻地在本市的现役军人办理出入境证件手续 》解释，市民认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（出入境）', '三级分类': '护照办理', '四级分类': '护照办理', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704117706-534715', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017832, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 1, 22, 8, 51), '诉求地址': '浦东新区曹路镇民耀路民建菜市场门口', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址每天菜场收摊后晚上21点后都会发敲打声音，对周围市民生活带来影响。诉求：要求管理部门上门整治。', '工单类别': '一般', '处理描述': '市民您好！这里是曹路镇经济发展办公室。菜场安装消防要求，目前正在安装喷淋设施，可能会有声音。21点后的敲打声音可能由外面回收废品的人引起的，城管工作站今后会加强巡查。感谢您对我们工作的监督与支持。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '污染', '四级分类': '噪音污染', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704117949-2311826', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017852, '工号': 3812, '工单生成时间': datetime.datetime(2024, 1, 1, 22, 12, 12), '诉求地址': '嘉定区德园路1488号门口', '诉求区域': '嘉定区', '内容描述': '市民来电反复催单。催单原因：市民称近两日乱摆放的情况又十分严重，请管理部门尽快处理。【最近派发的工单编号：20231217015473，工单内容：市民来电反映:上述地址门口有共享单车乱停放现象。此事影响居民出行。其之前反映过，管理部门有进行处理，但该情况又死灰复燃。市民诉求：请管理部门核实后对上述现象整治处理。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231217015473，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '停车管理', '四级分类': '共享单车', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704118210-534755', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017902, '工号': 2502, '工单生成时间': datetime.datetime(2024, 1, 1, 22, 22, 9), '诉求地址': '本市货拉拉', '诉求区域': '本市', '内容描述': '市民来电咨询处理进度。【最近派发的工单编号：20231216020763，工单内容：重新交办，告知市民答复要点，答复要点与实际情不符合，德邦物流赔付的是发件人，没有给到其，因为是耽误其的时间，当天没有让厂家补发，耽误了一个多星期，要求给其补偿。（需回复）最近办结的工单编号:20231202011757，工单内容:市民来电反映:德邦快递公司（江门-上海），快递单号：DPK364269952384，丢件了，该件是水槽配件。诉求：要求根据实际情况给予合理的处理方案。】', '工单类别': '一般', '处理描述': '按答复要点告知市民，答复要点清晰、明确，市民不认可，此单归档', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704117935-2311824', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017862, '工号': 4092, '工单生成时间': datetime.datetime(2024, 1, 1, 22, 24, 37), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:孩子3周岁，本市户籍的，有按时缴纳本市的医保，2024年1月1日去看病发现医保卡不能用，孩子的身份证号是310117202009103630，姓名是谢宸煜。诉求：请管理部门核查并回复告知无法使用的原因。', '工单类别': '一般', '处理描述': '2024-01-02 16:08:55 联系市民，市民反映孩子为本市户籍学龄前儿童，2024年1月1日就医时发现无法医保结算，随后通过支付宝线上为支付了295元保费。市民希望核实缴费是否已成功。2024-01-11 16:15:44 联系市民，告知相关规定，以及告知经查，缴费成功。市民表示知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': '市医疗保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704118290-278631', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101017932, '工号': 3830, '工单生成时间': datetime.datetime(2024, 1, 1, 22, 32, 58), '诉求地址': '普陀区真金路577弄', '诉求区域': '普陀区', '内容描述': '市民来电反映:其是上述地址小区地面停车90号固定车位业主，举报中国邮政车辆（车牌号码：沪ABE1029 ）公做自用，诉求：希望管理部门核实回复。', '工单类别': '一般', '处理描述': '同意', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '其他业务', '主办单位': '邮政公司', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704119281-2311922', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240101018082, '工号': 3970, '工单生成时间': datetime.datetime(2024, 1, 1, 23, 0, 40), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多订单编号：231230-777188006523828。市民70元买衣服,24日下单等了5天，物流一直停在28日，快递丢失市民退款后重新下单，商家发货了也揽收了，短信和市民说缺货了说发不了，商家虚假发货。诉求：投诉拼多多监管不力商家虚假发货。', '工单类别': '一般', '处理描述': '经拼多多平台协调，已为投诉人处理，投诉人已接受，双方协商达成一致。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704120956-3094238', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001112, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 0, 25), '诉求地址': '宝山区淞南八村169号楼602', '诉求区域': '宝山区', '内容描述': '市民反映：淞南八村169号602室租客家中养两只狗，两只猫。怀疑都有没有狗证，环境非常脏乱差。每天21：00多主人到家，就开始乱窜，声音非常大，会持续10-15分钟。04:00多也会开始乱窜，睡眠不好的阿姨也会被这个声音吵着睡不着。市民可提供图片。家中还有一个6个月的宝宝，已经严重影响到市民正常生活，前期交涉过，还是没用。诉求：请整治狗叫扰民。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '宝山公安分局淞南派出所于2024年1月2日10时06分许与来电市民先行联系，市民称诉求地了饲养两狗两猫，无狗证，猫狗在家中乱窜声音扰民。针对市民诉求，经民警核查发现，诉求人反映的两条犬均已在淞南镇办理了犬证，系合法养犬。就市民反映猫狗乱窜声音扰民的问题，经民警开展协调，现该处屋内已铺设了软垫子。2024年1月11日19时04分许与来电市民再次取得联系，将上述工作情况向其告知，市民对答复表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '犬类管理', '四级分类': '养犬登记', '主办单位': '市公安局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102000942, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 6, 20), '诉求地址': '青浦区', '诉求区域': '青浦区', '内容描述': '市民来电补充信息。市民补充信息内容为至今仍然未联系，希望管理部门核实处理。【最近派发的工单编号：20231215003726，工单内容：【重新交办,要求：答复要点与实际不符，政府没有权利动小区围墙，围墙是小区业主的财产，应经过业委会同意，市民认为小区改围墙改造未经过相关手续，不合法，诉求：要求禁止围墙开门，希望第三方监察部门来答复，最近办结的工单编号:20231122006637，工单内容:市民来电反映:市民表示其要投诉上海青浦发展集团有限公司，其表示该公司承接青浦环城水系工作，目前要敲青浦区城中北路236号的小区围墙，改成铁质围墙并在围墙上开门，市民表示重新建设围墙其可以接受，但开门其...', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231215003726，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704153793-2312943', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102000832, '工号': 2150, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 6, 40), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民来电反映:社保卡到医院今天突然无法使用显示无效，询问怎么回事。', '工单类别': '一般', '处理描述': '转接医保工号：42881接电。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704153845-279495', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001182, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 10, 4), '诉求地址': '静安区新闸路551弄40号及老闵行后东街53-55号（现浦江花苑小区内）', '诉求区域': '静安区', '内容描述': '市民反映：2019年12月30日，静安政府于勇、陆晓栋区长勾结杜敏仙法官，违法用警，抢夺新闸路551/40号唯一住房及财产，市民无数次信访长期无果（详见附件）。诉求：请管理部门严惩。', '工单类别': '一般', '处理描述': '根据《上海市“12345”市民服务热线办理试行办法》相关规定，您反映的事项不属于市民服务热线的受理范围，涉及对信访答复意见不满意的，建议通过信访流程向给出答复的上一级行政部门申请信访复查复核，专此简复', '客户类型': '个人', '一级分类': '其他类', '二级分类': '信访', '三级分类': '事项办理', '四级分类': '办理结果不满', '主办单位': None, '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102000932, '工号': 3230, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 11, 40), '诉求地址': '浦东新区东大公路南芦公路', '诉求区域': '浦东新区', '内容描述': '市民反复催单，望管理部门尽快处理。【最近派发的工单编号：20231220031164，工单内容：市民来电反映:上述地址交叉口往西10米，上海良盈果蔬专业合作社门口有很多修剪下来的树枝堆放在路边，影响交通。诉求：希望管理部门核实并要求尽快清除。（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231220031164，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '环境垃圾', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704154128-279552', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001412, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 13, 40), '诉求地址': '闵行区龙茗路1597弄', '诉求区域': '闵行区', '内容描述': '市民补充信息：下午请房东找物业证明与沟通，能让我们我的车正常停，但是沟通无果，物业态度强硬，说是什么应该业委会商议决定，并且业主都签过字的决策。但是起并没有看到过业主签字文件，而且房东停车费已经把2024年度的全部缴纳，房子租给了其，其却不能继续使用。晚上着急去办事，出车收费300元，保安执勤也是服从领导安排，这一天都没过完，何来的300元之说。能理解公共车位业主优先，但是物业与业委会成员迟迟不给出合理回复。【最近派发的工单编号：20240101005869，工单内容：市民来电反映:其是上述地址小区的租客，2023年以前市民都是用房东包年租的停车位停车，每月停车费1000多元，市民称20...', '工单类别': '一般', '处理描述': '我处会将您补充的信息及时转送，请您耐心等待，专此简复', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '乱收停车费', '主办单位': None, '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001062, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 17, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其家人的医保卡就医无法用，询问具体情况。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704154510-535738', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001052, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 19, 12), '诉求地址': '静安区场中路2471弄', '诉求区域': '静安区', '内容描述': '市民来电反映:  上述小区，原来停车费付给门卫就可以了，后来说要去物业登记信息，市民特地请假去物业登记了信息，现在又到了新的一年，需要付停车费，但是物业的上班时间也是市民的上班时间，且物业在另外一个小区。市民在物业的上班时间无法去付款。诉求：请管理部门酌情处理，可以让门卫代收费或者提供方便的线上收费途径。', '工单类别': '一般', '处理描述': '【彭浦新村街道】市民反映的情况属实，诉求合理合法；1月2日首次通过电话先行联系市民告知问题收悉，正在办理。经核实，物业已联系诉求人并告知可以周六上午进行付款登记。1月6日通过电话向来电人反馈处理情况；市民对此事处理表示满意；无其他需要说明的情况；经办人：徐文骏（56887632），负责人：施钰（56887632）。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704154514-279655', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001492, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 19, 27), '诉求地址': '静安区康定路710弄', '诉求区域': '静安区', '内容描述': '市民反映相同事项。【最近办结的工单编号：20230624003151，工单内容：康定路710弄门卫一对夫妻，自2021年12月开始，就持续不断的恶意的搞破坏，从2021年12月开始，充电时每次都被拨掉充电器，致充电不足，多次只能低速行驶，不得不增加充电多次，甚至他们一天可以拨掉三次充电器，投诉先说是电线被别人不小心碰到，而且每次充电车尾调到充电口，怎么会轻易被人碰到，又说是充电设备的电流出现问题，接着他们又采取撒灰，划车的举动进行破坏，天天都撒灰，甚至往车座泼水，撒油腻的东西，甚至把泥土抹在手把上。在车座在放脏东西。诉求：望有关部门加强管理。（市民要求信息保密，无需回复）】', '工单类别': '一般', '处理描述': '市民反映重复事项，工单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': None, '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001242, '工号': 2250, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 23, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:崇明到启东的G40高速要避开是什么原因。', '工单类别': '一般', '处理描述': '告知无法查询实时信息，市民认可，此单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704154813-2313193', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001082, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 24, 1), '诉求地址': '浦东新区张杨路2391号威尔士', '诉求区域': '浦东新区', '内容描述': '市民来电反映:其2022年8月购买了上述地址威尔士健身房的60节私教课，在2022年双十一市民又买了60节课，共计120节课，市民表示其年级较大，跟教练反映告知可以一直延续，但在2023年10月又告知让其充值，市民表示还有较多的课程没有使用，暂时不想进行充值，后被告知2023年12月1日剩余48节课大约12000元无法使用，卡号：APP00395615，诉求：希望管理部门核实，并帮助市民协调退款', '工单类别': '一般', '处理描述': '处理完毕', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市体育局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704154596-535757', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001732, '工号': 3990, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 26, 20), '诉求地址': '杨浦区齐齐哈尔路240弄', '诉求区域': '杨浦区', '内容描述': '市民建议：上述地址过年限电梯加强管理维护，组织鉴定。诉求：请管理部门核实并酌情采纳。', '工单类别': '一般', '处理描述': '你单位转来的工单已收悉，我办在接单后立即转派平凉路街道进行处理，据平凉路街道回复：先行联系：1月2日联系来电人简告，转城建中心。 情况核实：部分采纳 处置过程及回访：接单后立即联系物业经理，督促其加强小区电梯的保养及维护（附电梯维保记录）。1月8日下午联系反映人，反映人建议电梯设置门禁，已将反映人的建议转达物业公司，待小区业委会成立后向业主委员会讨论，该建议留作参考。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业维修添置', '主办单位': '杨浦区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001392, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 29, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:医保卡无法使用咨询原因', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704155297-279896', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001532, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 33, 56), '诉求地址': '奉贤区庄行镇三城路455弄', '诉求区域': '奉贤区', '内容描述': '市民来电反映:上述地址小区内路面公用的停车位，物业公司对于租户和也业主收费不一致，业主是每月800元给到固定车位，租户是每月1200元停车费，却没有固定车位，市民询问业委会，业委会工作人员告知其不清楚有此事，故来电。诉求：请管理部门核实，并解释停车收费是否合规。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '庄行丽水湾居委于2024年1月2日接单，于1月2日下午13点42分首次通过电话先行联系来电人，告知问题已收悉。解释如下：小区停车收费标准由城建中心牵头统一制定，庄行各小区都是统一收费标准，根据停车管理收费标准，业主实行“一户一车”规定，首辆车100元/月，1200元/年，在历年物业费缴清的情况下可优惠到800元/年，租客首辆费用1200元其实和业主一样。对车位首先满足本小区业主首辆车停车位需求，有多余车位再满足租客，因目前小区车位有限，后面来交费的就没定到固定车位，针对这点，相关部门会议决定，计划年上来扩充车位。业委会工作人员也是本小区业主，停车管理收费方案公告早在9月份做过公示，说不清...', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '发展改革', '三级分类': '价格调控', '四级分类': '物业管理收费', '主办单位': '奉贤区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704155345-2313349', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001592, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 35, 33), '诉求地址': '奉贤区（贵酿酒业有限公司）', '诉求区域': '奉贤区', '内容描述': '市民来电反映:上述公司断缴社保，之前反映后已经处理，但现在又死灰复燃，诉求：投诉该公司要求督促尽快交社保。（关联工单编号：20231130014287，市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '经调查，举报内容不属实。 经第十六税务所核实，已于2024年1月2日下午16:06时联系来电人，来电人要求企业缴纳11月所属期的社保。贵酿酒业有限公司所属期2023年11月所属期社保费未缴纳，2023年12月25日已电话联系企业，2023年12月25日已制发社会保险费限期缴纳通知书，文书号：沪税奉社〔2023〕160042号。企业因资金困难暂无法缴纳社保费。 回复时间：2024年1月2日，纳税人表示：知晓。 ——奉贤区税务局', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '养老保险', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704155481-279959', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002052, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 35, 37), '诉求地址': '浦东新区鹿滨路17号东北侧墙面上', '诉求区域': '浦东新区', '内容描述': '市民反映：上述地址乱设户外小广告（详见附件），诉求：请及时清除。', '工单类别': '一般', '处理描述': '尊敬的市民您好：经川沙新镇经济园区公司工作人员接报后到达现场处理，经核实,确有乱张贴小广告现象，现工作人员已处理完毕。感谢您的来电！', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '市容市貌', '四级分类': '广告张贴', '主办单位': '浦东新区人民政府', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001702, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 37, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者，需要转接拼多多', '工单类别': '一般', '处理描述': '转接多多成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704155776-3095723', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001942, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 42, 53), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:转接拼多多专席。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156099-536235', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102001352, '工号': 4290, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 43, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:需要查询重复来电事项进展程度。之前来电非本机联系电话，需核实后再来电。', '工单类别': '一般', '处理描述': '市民需核实重复来电联系电话后再来电。故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704155814-2313520', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002322, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 43, 57), '诉求地址': '黄浦区成都北路600号1楼', '诉求区域': '黄浦区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，对于通过邮管与韵达交涉后的赔偿方案表示同意。诉求：请邮管局通知对方。最近办结的工单编号：20231213003267，工单内容：唐芸女士于2023年7月14日在黄浦区成都北路600号1楼寄出两个快递，寄往闵行区季乐路555弄22号701室。快递公司为上海韵达货运有限公司。其中一个快递单号为530116580991的快递显示于2023年7月30日签收，但其并未收到。在快递还未丢失期间，其亲自前往快递站查看，被告知已经停止经营快递业务，但快递公司并未提前10日向社会公告，也没有在快递还未丢失期间帮助积极寻找，更是在快递丢失后虚假签收，造成其财产损失。...', '工单类别': '一般', '处理描述': '确认', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002552, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 47, 59), '诉求地址': '普陀区长风街道中江路388号新城控股大厦B座20整层', '诉求区域': '普陀区', '内容描述': '市民反映：2016年6月27日入职上海新趋势金融信息服务有限公司，后因公司转型变更合同为上海汇正财经顾问有限公司，一直就职到2023年9月5日被公司违法解除。市民发现，公司从2016年6月27日入职到2020年6月份之间存在不足额缴纳公积金问题。诉求：请管理部门核实，要求补缴公积金。', '工单类别': '一般', '处理描述': '2024年1月4日，反馈“12345”热线办。 ', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': '市公积金管理中心', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002092, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 48, 37), '诉求地址': '杨浦区杨浦区殷行路470弄37号602室', '诉求区域': '杨浦区', '内容描述': '市民反映：上述地址是单位分的房屋，公房要购买产权，市民表示其材料都已经提交了，并且钱都已经交了，但房地产交易中心告知要中星公司的委托书，所有一直搁置没有办理。市民表示已经拖了一年了。诉求：管理部门协调中星公司尽快开委托书给其。（需回复）', '工单类别': '一般', '处理描述': '1-4 10:56无法接通；1-4 14:10无法接通；1-6 14:30无法接通。多次拨打市民电话均无法接通，故工单归档，待之后市民致电我处核实该问题再告知热线办指导，建议市民自行联系企业开具相关证明。双方如有异议，建议通过法律途径维权。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '房屋产权', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156269-2313714', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002202, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 52, 2), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:上个星期五市民看病医保系统暂停，市民是自费的，来电咨询如何进行医保报销。', '工单类别': '一般', '处理描述': '转接医保专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156577-280393', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002122, '工号': 4290, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 52, 42), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:公司车辆外地号牌，在外省市发生交通违法是否需要到事发地处理违章。', '工单类别': '一般', '处理描述': '根据《外省市号牌车辆在外省市发生的交通违法，能否在上海处理？》已回复市民，市民认可。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156208-280240', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002252, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 56, 24), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 市民于1月2日早上8:45驾驶非机动车在非机动车道行驶到扬子中学公交站的时候, 被一辆车牌尾号为672D的崇明区陈桥1路公交车强行插到市民前面, 差点撞到市民, 诉求: 市民要投诉该公交车的驾驶员.（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '经核实：反映情况部分属实，经查当班驾驶员陈新民，车号80，经分公司安全员询问当班驾驶员核实，该车并没有拦逼反映人电瓶车。2、处理意见：作辅导，规范操作，文明行车。3、因反映人信息保密故无法把处理意见告知反映人。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '公交巴士', '四级分类': '服务规范', '主办单位': '市交通委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156671-536489', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002282, '工号': 2010, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 56, 35), '诉求地址': '闵行区虹梅南路隧道南向北100米处', '诉求区域': '闵行区', '内容描述': '市民来电反映:上述地址的落差比较大，车辆通行时必须强行减速才能通过，快的话会产生很大的颠簸， 并且在虹梅南路沪闵高架路S20地面道路也比较颠簸，诉求：要求修复，需要回复', '工单类别': '一般', '处理描述': '上海景铭建设发展有限公司于2024年1月5日接单，于1月5日；夏建标与反映人先行联系，1月5日到达投诉现场查看情况，1月5日经与反映人电话联系确认，反映人主要诉求位1.虹梅南路（外环高架-沪闵高架）段路面情况差需要维修，现场核实，我单位养护范围，虹梅南路（淀浦河-外环高架）段，路况良好（淀浦河-沪闵高架）段属于徐汇区养护范围，申请由徐汇区交通部门进行处置。2.虹梅南路（放鹤路朝北100米左右）段高架路面有问题，申请由虹梅南路高架养护单位处理，现申请结案，谢谢。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '道路管理', '四级分类': '路状路况', '主办单位': '闵行区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156759-3096200', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002442, '工号': 3702, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 57, 25), '诉求地址': '普陀区光复西路2077弄75号502', '诉求区域': '普陀区', '内容描述': '市民来电补充信息。市民补充信息内容为：居委说已经通过了业主大会，就这样那个决定了，市民不认可。【最近派发的工单编号：20231225022704，工单内容：市民来电反映: 其是上述地址的租客，业委会出通知说业主停车1800元/年，租客停车800元/月，其称租售应该同权，投诉业委会歧视租客，要求公平收取停车费。】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231225022704，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '业委会', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156884-2359540', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002412, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 57, 26), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:普通住宅多层没有电梯，只有5层如何认定。（需回复）', '工单类别': '一般', '处理描述': '2023.1.9 10：30已告知市民相关信息情况。为了更好满足刚性和改善性住房需求，本市根据当前房地产市场形势，按照因城施策原则，调整优化了本市房地产调控政策。从2023年12月15日起，本市普通住房标准根据（关于调整本市普通住房标准的通知）沪建房管联（2023）676号文要求执行，相关业务部门将根据房屋具体情况核准后办理业务。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '其他', '四级分类': '其他', '主办单位': '市房屋管理局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156850-3096241', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002462, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 2, 8, 59, 32), '诉求地址': '金山区朱泾镇钟楼新村', '诉求区域': '金山区', '内容描述': '市民来电反映:钟楼新村绿化带2022年10月左右刚修好的，小区居民乱停车、停在绿化带，破坏了绿化。有向物业、居委反映过，未果。诉求：请管理部门核实修复绿化带并整治乱停车。（需回复）', '工单类别': '一般', '处理描述': '先行联系时间：2024年1月2日 14时20分 核实认定情况：来电居民反映情况不实，钟楼新村旧改中，经业主大会通过，调整了部分绿化带为停车位。仍为绿化带的部分不存在车辆停放的情况。 处置过程和结果：钟楼新村根据上海市住宅修缮管理办法（沪府办发（2013）69号文）于2021年3月召开业主大会征求旧房改造方案，大会通过了包括调整部分草皮为停车位以缓解小区停车难问题的方案。经过前后三年的施工小区布局调整为目前状态。当前来电居民所说的123号车库南侧区域停车秩序良好，不存在来电人所说的居民乱停车，停在绿化带，破坏了绿化之类的情况。 答复市民反馈情况：办理意见已告知', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '金山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156912-2359559', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002672, '工号': 2560, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 1, 44), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:选车牌时，所有人填错，要怎么办。', '工单类别': '一般', '处理描述': '转接车管所成功,归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157224-3096440', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002682, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 2, 3), '诉求地址': '金山区金石北路6800弄3期2168号', '诉求区域': '金山区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，市民表示同意邀请第三方评估，但是要求告知如果评估结果房屋下沉不是自己造成的，那么评估费用由谁承担。最近办结的工单编号：20231202003686  工单内容：市民来电反映:上述联体别墅房屋下沉40-50公分，院墙倾斜，有倒塌的隐患，诉求：请管理部门尽快核实给出维修方案。（需回复）】', '工单类别': '次紧急', '处理描述': '先行联系时间：2024年01月02日 10时10分 核实认定情况：前件已办理核实，来电市民为二手交易房屋后进行装饰工程导致，12月9日现场已与开发商协调未果。 现来电咨询评估费用。 处置过程和结果：根据《上海市住宅工程施工质量投诉处理暂行规定》，第十二条【鉴定事项及费用】投诉人明确表示需要对被投诉工程结构进行质量鉴定并确认质量问题责任人的，鉴定费用由投诉人支付；经鉴定后存在结构安全问题的，检测费用由相关责任单位承担。 答复市民反馈情况：以上内容已电话告知市民。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '工程管理', '四级分类': '危房', '主办单位': '金山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156529-3096073', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002432, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 2, 23), '诉求地址': '青浦区', '诉求区域': '青浦区', '内容描述': '市民来电咨询:练塘镇人民政府的公务车，大型客车，车牌号沪BG4201，行驶证盖章满了，诉求：希望管理部门核实，尽快告知换领行驶证所需材料及办理流程（需回复）。', '工单类别': '一般', '处理描述': '市公安局青浦分局交警支队车管宣传大队于2024年1月2日11时06分许与来电市民周先生取得联系，认真听取诉求。经了解，其已在分局练塘所换好行驶证。周先生对大队答复表示满意。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704156888-280546', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002732, '工号': 3542, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 3, 25), '诉求地址': '浦东新区金闻路79号', '诉求区域': '浦东新区', '内容描述': '市民来电咨询:其是赫比（上海）家用电器产品有限公司的员工，2017年入职在技术员岗位上工作至今，2023年在肺科医院做体检，发现听力受损，想要做职业病鉴定，单位给员工填写职业病鉴定登记表的时候职业病接触史的起始时间写了2023年开始，与实际情况不符，2017年到现在企业都没有让员工在体检中作噪音检测。目前企业因为市民听力受损要求市民转岗，诉求：请管理部门告知如何处理企业要求其转岗的问题。', '工单类别': '一般', '处理描述': '2024-01-02 15:05...', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动保护', '四级分类': '用工规范', '主办单位': '市人力资源和社会保障局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704155712-536094', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002842, '工号': 3550, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 3, 27), '诉求地址': '宝山区真华路888号一层31号', '诉求区域': '宝山区', '内容描述': '市民反映：2022年在宝山区真华路888号一层31号名为华为授权体验店的商家购买了一部华为手机5699元，其在手机机身和手机盒未发现入网许可标识，存在违法行为。诉求：要求依法查处退一赔三。', '工单类别': '一般', '处理描述': '经核查，举报人反映的涉嫌违法行为不属于市场监管部门职责，该举报中包含的投诉内容，我局已受理该市民投诉。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': '市市场监管局', '是否匿名': '否', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002662, '工号': 3762, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 4, 43), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:开通社保卡，身份证号码：410702196410073021.请管理部门尽快帮其开通社保卡。', '工单类别': '次紧急', '处理描述': '09：07分联系市人口办64952005专席，工号276知晓，工单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157230-280731', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002872, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 6, 11), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157499-3096617', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002752, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 6, 22), '诉求地址': '青浦区青浦区白鹤镇万狮村', '诉求区域': '青浦区', '内容描述': '【重新交办，答复要点简单不明确。市民来电反映: 宅基地的层高太低了，市民表示管理部门答复说是市政府的规定，市民不认可。诉求：建议可以让造到8.6米。最近办结的工单编号：20231213014618，工单内容：市民来电反映:上述地址宅基地用房翻新限定总的层高为7米，而在江苏宅基地用房翻新限定总的层高为8.6米。市民认为7米高度不够，诉求：希望管理部门核实并能借鉴江苏，提高宅基地用房翻新限定总的层高。】', '工单类别': '一般', '处理描述': '此工单诉求内容不属实，白鹤镇城运中心于2024年1月2日接单，于2024年1月1日09:51分首次通过电话先行联系诉求人，告知诉求已收悉，正在我单位办理。办理情况为：白鹤镇规保办于2024年1月2日接单，于2024年1月2日与市民联系，告知问题已收悉，于2024年1月3日办结，办理结果如下：白鹤镇农民建房工作严格按照《上海市农村村民住房建设管理办法》（市府令第16号）、《上海市青浦区农村村民住房建设管理》（青府规发[2019]4号）规定进行审批，市、区两级文件均对建筑面积、建筑高度等相关标准都有明确的规定。已将处置结果告知来电人，该问题已经解释说明。经办人：徐锦凯', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '房屋权属', '四级分类': '宅基地', '主办单位': '青浦区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157362-536849', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002692, '工号': 2282, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 6, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:老年津贴发放日期以及账户发放情况。邓瑞玉，身份证号：310108193511304421。', '工单类别': '一般', '处理描述': '已根据知识库“老年综合津贴工作实操问答”告知市民，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '养老保障', '四级分类': '老年津贴', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157261-280749', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002862, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 7, 53), '诉求地址': '杨浦区江湾城路99号9栋上海格物致品网络科技有限公司', '诉求区域': '杨浦区', '内容描述': '市民来电补充信息。市民补充信息内容为市民称对方直播间宣传称是新鲜肉，但实际给予的是冷冻肉。现平台联系其，但只愿意给予相优惠券。市民要求按规定赔付，但平台不认可。市民诉求：请管理部门核实后尽快处理。【最近派发的工单编号：20231226030296，工单内容：市民来电反映:其在抖音商城抖音小店直播间购买鲜羊肉，商家从山东发货，羊肉生产商是河北，直播间宣传是甘肃的羊，订单号：6925066479150109793，花费：199元。诉求：希望协调退一赔十。（需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231226030296，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157464-2359895', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002722, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 9, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【为企服务】市民来电反映: 市民的企业注册在嘉定区, 市民在一网通办上变更好企业名称后，出现了很多近似的名称, 需要市民上传授权文件,市民咨询上传哪些授权文件.  市民需要提供市场监管局联系方式.', '工单类别': '一般', '处理描述': '根据《市市场监督管理局及各区市场监管局联系方式 》告知市民，市民认可，归档.', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704157309-2359771', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003372, '工号': 3792, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 11, 41), '诉求地址': '浦东新区周浦镇东八灶115弄21号401室', '诉求区域': '浦东新区', '内容描述': '市民反映相同事项。【最近派发的工单编号：20231230002061，工单内容:【投诉】市民来电反映：对于其反映的上述地址违法搭建的问题，管理部门未处理。诉求：投诉管理部门不作为（市民要求信息保密，需要回复）。关联工单编号：20231018005270。】', '工单类别': '一般', '处理描述': '市民反映重复事项，工单归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': None, '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003222, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 13), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:拼多多消费问题。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157893-537194', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002942, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 13, 6), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:江苏泰州申办建设工程行业资质，其中涉及到其的个人业绩真实性需要上海市住房和城乡建设管理委员会核实真伪，11月1日泰州政府方已经向上海市住房和城乡建设管理委员会发了函，但上海方回复称还在调查中，没有告知具体的结果和办结时限，其申报的事项比较紧急，希望可以加急办理回复。公司名称：江苏昱城工程服务有限公司。诉求：请管理部门尽快办结回复。（需回复）', '工单类别': '一般', '处理描述': '市民咨询外省市管理部门发函至我委进行核实的相关问题。已电话回复，告知市民相关流程。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '其他', '四级分类': '其他', '主办单位': '市住房城乡建设管理委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157602-2359978', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003262, '工号': 2612, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 13, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '为市民转接拼多多专席，工号40495受理, 此单归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157930-537217', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003582, '工号': 3842, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 15, 31), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民建议：地铁11号线秀沿路站安检人员看到乘客有大件行李不帮忙过安检。诉求：建议改进安检机器。（市民要求信息保密，需要回复）', '工单类别': '一般', '处理描述': '迪士尼站所承办民警于2024年1月3日11时许通过来电人所留联系电话与其进行先行联系。经了解，11号线秀沿路站进站的乘客为上班族乘客居多，所携带的一般都是常规的包袋，所以秀沿路站还是采用了适用于大部分乘客适用的安检机。改进安检机是上海轨道交通运营单位的相关部门组织实施，非我轨交公安管辖，我所单方面无法决定对安检机进行改造，建议其通过拨打上海轨道交通监督热线反馈诉求。对于安检队员在工作中的不足之处我所会督促保安公司对其加强教育培训，进一步提升安检队员为民服务意识。2024年1月4日至1月10日，承办民警多次拨打来电人电话欲进行沟通解释，来电人始终未接电话或拒接电话，故无法做进一步沟通解释。...', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '交通港口', '三级分类': '地铁客运', '四级分类': '地铁建设', '主办单位': '市公安局', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003302, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 16, 59), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者要求转接拼多多。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157994-2360273', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102002742, '工号': 4322, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 17, 5), '诉求地址': '长宁区威宁路358弄21号402室', '诉求区域': '长宁区', '内容描述': '市民来电反映:上述地址家中老人过世后，市民的大伯伯以保管财产为名把两位老人包括已过时的老人的所有证件以及银行卡全部拿走，天山星城社区居委会出面调节两轮后告知会出调解以及报告，但还未出报告居委会告知非处理范围，诉求：要求管理部门核实相关居委会不作为的问题。', '工单类别': '一般', '处理描述': '同意结案。新泾镇社建办于 2024...', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '长宁区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157249-280743', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003512, '工号': 2940, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 17, 35), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:个人消费者需要转接拼多多。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158189-2360431', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003292, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 17, 38), '诉求地址': '本市拼多多', '诉求区域': '本市', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231227015064，工单内容：市民来电反映:其本人通过拼多多平台购买了散装海带，订单号：231221260398192291247，价格106.47元，其称商家宣传时福建厂家直发，但受到产品后发现是三无产品，无生产日期，厂家和产地，并且发货地还是山东日照，故市民来电投诉。现诉求：希望管理部门核实查处并给出合理解决方案。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231227015064，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '违法经营', '四级分类': '不正当经营', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704157942-281244', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003602, '工号': 3992, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 17, 41), '诉求地址': '嘉定区乐秀路沿途及乐秀路站地铁口', '诉求区域': '嘉定区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，乐秀路地铁站2号口沿途人行道被非机动车占用严重。停车棚启动收费，非机动车占道问题变本加厉（详见附件），包括乐秀路沿途占道问题，已反映多次。诉求：希望管理部门立即整治。（市民要求信息保密，需要回复）最近办结的工单编号：20231208008614，工单内容：市民反映：上述地址非机动车乱停现象严重，占用人行道，占用盲道，影响行走（详见附件）。诉求：请管理部门核实整治。（市民要求信息保密，需要回复）】', '工单类别': '一般', '处理描述': '江桥镇：2024年1月2日15:10尾号1011先行联系。乐秀站是属于轨交14号线附属设施，按政府相关市政规划盖的车棚便于市民停车使用，为了更好管理使用该车棚，根据相关政策收取24小时1元的停车费用，该费用用于停车棚的维修，以及内部设施的维护管理，露天停车点不收取费用，11月已在车棚内公告非机动车停放车辆管理规定，流程符合相关规定。1月1日实施收费管理，车辆停放有反复，车棚工作人员会引导车辆停放到车棚。该处确有非机动车乱停放问题，已进行整治和清理，封浜派出所已与交警总队沟通，向市交通委申请将乐秀路曹安路口隔离栏打通，设置路口，分流部分车辆，减缓地铁口停放压力。已告知相关情况。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '城管执法', '主办单位': '嘉定区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003452, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 18, 38), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:事业单位，男性退休，原本公顷岗位，后续转到专业技术岗位。按照那种退休待遇享受。', '工单类别': '一般', '处理描述': '转接人社专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '劳动人事制度', '四级分类': '退休离休', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158143-281383', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003472, '工号': 3982, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 21, 6), '诉求地址': '虹口区车站北路611弄', '诉求区域': '虹口区', '内容描述': '市民来电反映:上述地址小区居民楼楼下有地下室，其在地下室内有居委和物业配备的非机动车充电桩，供于居民给电瓶车充电，其表示在12月31日下午16:00左右地下室还着火了。诉求：请管理部门核实整治，将充电桩拆除。', '工单类别': '一般', '处理描述': '接到投诉后，街道平安办联系居委，经核实12月30日火灾原因是蓄电池热失控引起火灾，非充电桩的原因。充电桩为便民设施为解决老旧小区居民非机动车充电难问题，物业会对设备进行日常管理。市民要求拆除充电桩诉求过高。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158160-537373', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003842, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 21, 11), '诉求地址': '浦东新区张杨路1647弄', '诉求区域': '浦东新区', '内容描述': '市民建议：人行道装路障（详见附件），不方便行人通行。诉求：希望予以拆除。', '工单类别': '一般', '处理描述': '尊敬的市民您好！该处为防止车辆停上人行道故安装了禁车柱。感谢您对浦东城市管理工作的理解和支持，处置单位：上海浦东工程建设管理有限公司。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通设施', '主办单位': '浦东新区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003902, '工号': 3532, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 25, 16), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:云智冲退费问题。', '工单类别': '一般', '处理描述': '市民表示核实详细信息后再来电，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158570-3097444', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003862, '工号': 4100, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 25, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:限行', '工单类别': '一般', '处理描述': '根据《上海市公安局关于调整本市部分道路交通管理措施的通告（2020年11月2日）》认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '限流限行', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158523-2360722', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003572, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 27, 30), '诉求地址': '嘉定区嘉松北路外青松公路', '诉求区域': '嘉定区', '内容描述': '市民来电反映:上述地址嘉松北路红直行绿灯时间过短，只有十几秒，诉求：希望增加嘉松北路绿灯时间（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '因来电人无联系电话，且不要求回复，现将办结情况汇报如下：经大队核实，来电人所述的上址，该路口东西向和南北向的直行信号灯绿灯时间均为48秒，非10几秒。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通设施', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158277-281491', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003972, '工号': 1650, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 28, 14), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:2023年6月11日退休，当时表示12月份发年终奖。但现在又不发。', '工单类别': '一般', '处理描述': '年终奖发放，企业内部管理问题，并且已退休，我处无法受理，建议向企业内部反映，市民挂机，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158667-537731', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004002, '工号': 3852, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 28, 42), '诉求地址': '宝山区罗和路118弄14号楼', '诉求区域': '宝山区', '内容描述': '市民来电反映:上述地址小区内14号楼的屋顶上有物业在装修，早晨7:50左右就开始装修，装修噪音扰民严重。诉求：希望管理部门核实后让相关物业降低噪音减少扰民，延后施工开始时间。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '对于市民反应的问题，我居委第一时间联系了投诉者本人， 经了解，12月14日物业已在各个楼道内张贴了《关于慧苑小区4、7、8、10、11、14号楼顶防水维修工程告知书》（见图一）；居委当天也在13、14号楼的业主群中发布了此通知，并希望居民给予理解和配合（见图二），此项目为慧苑小区楼顶防水层维修工程，12月15日正式启动，为期60天左右，也联系了施工负责人，要求严格按照规定时间（8:00-12:00 -14:00-18:00）施工。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': '宝山区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158693-281836', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004082, '工号': 1252, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 28, 52), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:宝宝的医保卡，2024年直接报销部分没有了，问下情况。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '医疗医保', '四级分类': '医保报销', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158807-2360980', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003992, '工号': 2172, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 28, 53), '诉求地址': '浦东新区陆家嘴环路95号华能大厦6楼 九转律师事务所', '诉求区域': '浦东新区', '内容描述': '市民来电反映:市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，而普陀区司法局电话打不通，请管理部门尽快处理。【最近派发的工单编号：20231223020505，工单内容：市民来电反映:23年9月在上述地址九转律师事务所聘用主任律师，律师姓名：罗啸，支付律师费30000元，签订合同，期间没有为市民办理如何工作，现该律师被刑拘。耽误市民案件。诉求：请管理部门尽快核实协调退款2万元】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231223020505，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '法律服务', '四级分类': '律师服务', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158689-2360858', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004042, '工号': 3940, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 28, 56), '诉求地址': '青浦区', '诉求区域': '青浦区', '内容描述': '市民来电咨询:其是青浦区的企业，营业执照即将到期。诉求：希望管理部门告知后续续办流程。', '工单类别': '一般', '处理描述': '发送短信：您好！如您需要办理经营期限变更，您可以登入上海市一网通办平台，选择“上海企业登记在线”，进入页面后点击“变更”按钮，查看相关办理要求及方式，如有问题可以拨打59728327咨询。', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704158769-537815', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004052, '工号': 3542, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 29, 17), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:新村路2003弄属于什么区', '工单类别': '一般', '处理描述': '根据《普陀区万里街道所属居委会一览表》', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '民政', '三级分类': '社区家政', '四级分类': '社区服务网点', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158852-537887', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004192, '工号': 3972, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 30, 47), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:咨询工单重复办理时效', '工单类别': '一般', '处理描述': '告知可来电查询前工单处理进度，归档', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '12345热线', '四级分类': '信息咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158928-282022', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003752, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 31, 3), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其有沪C牌照机动车。现其拍到市区牌照额度，故要办理沪C转市区牌照的手续。其丈夫名下有机动车，而其父亲有驾驶证。市民咨询相关手续如何办理。市民诉求：请管理部门核实后告知相关信息。', '工单类别': '一般', '处理描述': '车管所综合科文职2024年1月3日至2024年1月5日车辆管理所多次联系该求诉人其电话始终无法接通。其拍到本市沪牌额度且还未结婚的情况下，将其名下沪C车辆换沪A可通过本市具有资质的二手车交易市场进行办理，需携带的材料有现机动车所有人的身份证明原件；具体办事流程可向本市二手车交易市场进行相关咨询。如来电人已婚且配偶符合本市申请沪C条件的情况下，可前往本市车管所现场办理沪C换市区号牌机动车共同所有人变更手续，需携带的材料有变更前和变更后机动车所有人的身份证明原件；机动车行驶证；机动车登记证书；证明夫妻关系的《结婚证》原件；提供两张符合要求的车辆照片；沪C号牌,办理该业务需夫妻同时到达车管所现...', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '过户上牌', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158608-3097477', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004222, '工号': 2592, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 31, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:买房提取公积金。（已有商贷）', '工单类别': '一般', '处理描述': '转接公积金成功,归档', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '市场交易管理', '四级分类': '住房公积金', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158950-2361115', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102003772, '工号': 4160, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 31, 46), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:市民咨询四分所车辆转入发票有什么规定么？需核实一下', '工单类别': '一般', '处理描述': '已告知需转达相关部门回复，市民认可。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704158895-3097704', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004322, '工号': 3932, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 35, 2), '诉求地址': '奉贤区南桥镇江海南路八一路路口', '诉求区域': '奉贤区', '内容描述': '市民来电反映:上述地址附近有一个垃圾堆, 已经很多天无人清理，诉求:希望管理部门核实派人清理.', '工单类别': '一般', '处理描述': '南桥镇于2024-01-02 10:35:06接单，并首次通过电话先行联系来电人，告知其问题已经收悉，正在南桥镇进行办理。已安排保洁员将该处垃圾清理完毕，已将处置结果告知来电人。经办人：詹夏欢', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '垃圾清理', '主办单位': '奉贤区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704159106-3097885', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004372, '工号': 3032, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 35, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:12345能否进行行政复议。', '工单类别': '一般', '处理描述': '告知不予受理，根据《上海行政复议“掌上复议”小程序相关问答》告知市民，工单归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '12345热线', '四级分类': '信息咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704159155-327753', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004432, '工号': 2940, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 36, 33), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:居住证如何办理。', '工单类别': '一般', '处理描述': '根据《沪住房租赁合同网签备案可“零跑动”在线办理 》,《居住登记、居住证新办可以“不见面办理” 》告知市民，市民认可，工单归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '居住证', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704159215-538175', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240102004332, '工号': 2082, '工单生成时间': datetime.datetime(2024, 1, 2, 9, 37, 10), '诉求地址': '嘉定区', '诉求区域': '嘉定区', '内容描述': '市民来电咨询:其户口在嘉定工业区的社区公共户内。目前其租住在嘉定新城。其已购买南翔镇新房，但要等到2024年6月才交房。小孩在2024年9月要就读初中。市民诉求：请管理部门核实后告知2024年小升初的相关政策信息。', '工单类别': '一般', '处理描述': '嘉定区教育局：2024年1月2日9:50与诉求人联系沟通，了解情况，告知相关政策情况，如有后续疑问可拨打39902054咨询。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '教育', '三级分类': '入学入托', '四级分类': '入学政策', '主