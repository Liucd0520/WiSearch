类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704381024-855050', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104037052, '工号': 2022, '工单生成时间': datetime.datetime(2024, 1, 4, 23, 33, 1), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704382336-75812', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104036782, '工号': 2400, '工单生成时间': datetime.datetime(2024, 1, 4, 23, 47, 12), '诉求地址': '虹口区丰镇路151弄3号101室', '诉求区域': '虹口区', '内容描述': '市民来电反映:上述地址小区隔壁楼栋规划建造电梯，将门口的电线都扒拉下来，不清楚是否为高压线，既影响视线又有安全隐患，已经两三周了，无人监管，诉求：希望管理部门协调恢复原样。', '工单类别': '一般', '处理描述': '江湾镇街道于1月5日接单。区城运于1月5日9时43分首联诉求人告知接单。接单后，江湾镇街道自治办工作人员即刻了解情况。经现场查看，诉求人反馈的投诉地址附近仅有丰镇路151弄5号楼在加装电梯。代建单位已实地查看确实发现弱电线垂下的情况，目前已安排人员处理完毕。江湾镇街道自治办工作人员于1月11日电联诉求人，告知上述处理情况，其表示知晓。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '住房保障', '三级分类': '物业服务管理', '四级分类': '物业安保', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704382778-75830', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104037072, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 4, 23, 51, 57), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民要求转接拼多多\n', '工单类别': '一般', '处理描述': '市民要求转接拼多多\n', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704382090-75801', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240104036792, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 4, 23, 59, 49), '诉求地址': '杨浦区平凉路许昌路', '诉求区域': '杨浦区', '内容描述': '市民来电反映:2024年1月4日去上述地址的吃饭，具体门牌号无法提供，店名:山东饺子馆（对面有一个交通银行），消费了105元，让店员开具发票，但是店员表示无法开具，市民来电投诉。诉求：望管理部门协助市民拿到发票回公司报销。', '工单类别': '一般', '处理描述': '2024年1月16日-1月17日，多次拨打13734823879，了解核实相关情况，均无人接听，暂无法核实具体情况处理。来电人可以将消费凭证等相关资料寄往：上海市杨浦区昆明路572号征管科（收）', '客户类型': '个人', '一级分类': '经济综合类', '二级分类': '税务', '三级分类': '其他', '四级分类': '其他', '主办单位': '市税务局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704383042-2113511', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000202, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 5, 0, 1, 58), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704382869-2895376', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000042, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 5, 0, 28, 57), '诉求地址': '杨浦区政立', '诉求区域': '杨浦区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。受理管理部门每次到最后一个工作日说调解不了，让市民走其他途径。【最近派发的工单编号：20231223014554，工单内容：【重新交办：要求：答复要点不明确，其表示管理部门从来没有给市民打过电话，只有一次打过电话，现在就办结了终止了，其不认可。希望管理部门核实及时处理，回复市民。最近派发的工单编号：20231205034713，工单内容:【投诉】市民来电反映:其反映抖音商城的售后问题，投诉后未接到任何回复，现在收到通知称已经办结。诉求：要求投诉管理部门处理问题流程不合规。前工单编号：202310080283...', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231223014554，故归档。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '“12345”热线', '三级分类': '批评承办部门', '四级分类': '诉求未解决', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704385326-2895444', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000092, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 5, 0, 51, 43), '诉求地址': '静安区陕西北路79号', '诉求区域': '静安区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，该处现每天凌晨的施工噪音很大严重影响周边居民休息，就算该处有夜间施工许可也应该产生这么大的声音扰民，希望管理部门尽快处理解决。最近办结的工单编号：20230717032295，工单内容：市民来电反映:上述地址道路施工吗每天到凌晨5点，对周围市民生活带来影响。诉求：要求管理部门上门整治。（市民要求信息保密，需要回复）】', '工单类别': '一般', '处理描述': '【建管委】市民反映关于静安区陕西北路79号施工扰民的相关事宜，要求查处，1月5日接报后我中心工作人员立即派员现场查。经核查该处为架空线入地施工项目，该项目施工手续、时间依法合规。本中心接报后已联系施工单位，要求合理安排施工组织优化施工方案，做好降噪措施，减少对居民的影响。1月25日电话联系反映人，反映人表示认可。事实认定：部分属实，诉求认定：其他。经办人：秦跃东13601737192、负责人黎先生（联系电话62325137）。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '环境保护', '三级分类': '夜间施工许可', '四级分类': '夜间施工的现象', '主办单位': '静安区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704386646-2113616', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000022, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 5, 1, 10, 42), '诉求地址': '杨浦区中原路60弄4号', '诉求区域': '杨浦区', '内容描述': '市民来电咨询:2020年在上述地址的贝贝幼稚园任职老师，在合同未结束前解除劳动合同，他们幼儿园的院长也承认属于非法解除合同，无诉求。', '工单类别': '一般', '处理描述': '市民表示反应了没有用，表示我们话务员想怎么做就怎么做，无诉求，归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704387449-2895494', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000112, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 5, 2, 52, 38), '诉求地址': '宝山区牡丹江路1761号旁格莱雅酒店', '诉求区域': '宝山区', '内容描述': '市民来电反映:其在携程上订了酒店，1月5日凌晨其到上述酒店支付了押金和房费300多元后发现，其在平台上订的酒店并不是该酒店，市民要求上述酒店退费，但酒店态度强硬只给退押金，房费不给退，市民不认可要求投诉上述酒店。诉求：希望管理部门核实并尽快处理解决（需回复）', '工单类别': '一般', '处理描述': '经了解，企业表示市民走错酒店，错误的那家酒店收取了市民300元的押金，押金里包含了房费，非携程直接预订的，投诉主体错误，建议市民联系收取其费用的酒店处理，市民知晓。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '旅游', '三级分类': '服务质量', '四级分类': '酒店质量', '主办单位': '市文化旅游局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704393864-76077', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000262, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 5, 3, 2, 25), '诉求地址': '徐汇区东泉小区', '诉求区域': '徐汇区', '内容描述': '市民来电反映:市民都没有住的地方。2024年1月4日市民在重庆小面店里吃饭，包忘记在店里了。身份证、钱包、公司公章、U-key都在包里。地址：东泉小区附近。市民是新疆退伍兵，武警。诉求：帮助找回包。', '工单类别': '一般', '处理描述': '根据《徐汇区漕河泾街道派出所》告知市民，向警方报告，市民认可。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会治安', '四级分类': '治安维护', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704393561-76071', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000282, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 5, 3, 43, 3), '诉求地址': '浦东新区张杨北路春晖路', '诉求区域': '浦东新区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。2024年1月5日3：30多还是如此，市民要求管理部门加大监督力度。【最近派发的工单编号：20231229000255，工单内容：【投诉】市民来电反映:其通过12345反映上述地址每天凌晨3:00左右在清运垃圾噪音扰民的问题，多次反映后管理部门答复告知是正常的作业，市民表示不要以正常作业为借口，市民也不是不让作业，而是作业时间及作业期间噪音非常的扰民，故其来电投诉承办单位：慈善街联勤联动站及派单的工作部门，监管督促不力。诉求：要求管理部门对此情况核实查处并督促落实到位。（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231229000255，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '环境卫生', '四级分类': '卫生配套设施', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704396895-2895614', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000322, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 5, 4, 27, 19), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:其在拼多多购买了耳机，订单编号:231224067554590320596，金额:16.53元。购买的商品与实际购买的商品颜色不符，向商家反馈商品颜色不符，商家表示以收到商品实际为准，向拼多多客服反馈至今未处理。诉求:望管理部门协助市民办理退货。', '工单类别': '一般', '处理描述': '经查，我局于2024-01-15与消费者解释沟通，消费者表示知悉了解，故此单投诉办结。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '售后服务', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704399629-855474', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000302, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 5, 5, 4, 33), '诉求地址': '徐汇区梅陇三村68号102室', '诉求区域': '徐汇区', '内容描述': '市民来电补充信息。市民补充信息内容为市民接到管理部门先行联系，说会拆除。市民之前向管理部门了解说要等半年再处理，因为楼下要起诉市民。但此事市民已反映3年，管理部门只当不知道。楼下把市民窗玻璃敲掉了，管理部门修复还要市民出一半的钱，还逼市民签字，市民签字后打派出所电话，说不认可此签字。后派出所来问市民是否认可，市民称不认可。派出所说市民不认可会影响该户籍警奖金。市民称认可户籍警来过，但对工作方式不认可。市民是盲人。城管也来处理过，是存量违法建筑。市民要求有确切处理时间。管理部门也确认会给市民确切时间。居委会还让对方做楼组长。最近市民低血糖还发生了。已告知市民及时就医。【最近派发的工单编号：...', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20240102000269，故归档。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城乡建设', '三级分类': '违法建筑', '四级分类': '违法建筑', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704398626-2895631', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000342, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 5, 5, 9, 5), '诉求地址': '徐汇区梅陇三村68号102室', '诉求区域': '徐汇区', '内容描述': '市民来电咨询:重复来电。【关联工单编号：20240103000298】', '工单类别': '一般', '处理描述': '电话中断。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704398626-2895631', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000632, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 5, 5, 29, 23), '诉求地址': '无', '诉求区域': '本市', '内容描述': '重复来电', '工单类别': '一般', '处理描述': '重复来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704384765-2113566', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000402, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 5, 6, 40, 28), '诉求地址': '崇明区长兴镇渔傲路133弄', '诉求区域': '崇明区', '内容描述': '市民来电反映: 上述地址崇明区长兴镇渔傲路133弄小区内，有6-7只中型流浪狗，黑色、黄色均有。不定时流窜于小区内，且乱吠产生噪音扰民。诉求：望管理部门核实收治。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '上海市公安局崇明分局长兴派出所收到市民来电后，积极开展情况核查。系诉求人反映长兴镇渔傲路133弄小区内，有6-7只中型流浪狗，黑色、黄色均有。不定时流窜于小区内，且乱吠产生噪音扰民，望管理部门核实收治。长兴派出所已联合长兴镇政府持续组织专项力量、人员开展流浪犬整治工作，我所民警已于1月9日在上述地址抓获了5只流浪犬，下一步我所将联合小区居委物业加强开展上址流浪犬收容整治工作和文明养狗督促。现诉求人匿名，故无法告知。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '犬类管理', '四级分类': '流浪犬收治', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704407711-2895723', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000492, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 10, 3), '诉求地址': '徐汇区复旦大学附属肿瘤医院', '诉求区域': '徐汇区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20231230001981，工单内容：市民来电反映:上述医院。 不给市民做淋巴结肿瘤手术。涉及医生：米方方时间： 9月13日下午通知其不能做，也不给其转院到能做的部门。诉求：希望管理部门与医院协商做为市民进行手术。】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20231230001981，故归档。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '其他', '四级分类': '其他', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704409650-2113916', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000502, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 17, 22), '诉求地址': '虹口区大连路277号', '诉求区域': '虹口区', '内容描述': '市民来电反映:其为上述地址虹口区大连路277号”中石化中海船舶燃料供应有限公司上海物资分公司“，于2024年1月3日夜间电力部门在此处施工，疑似不慎将其单位污水管及自来水管挖断，导致小面积积水。所属自来水抄表员告知称，其单位水表异常，现市政部门修复厂区外人行道。诉求：望管理部门核实，要求原电力施工部门，尽快安排至现场查看，是否管道设施有问题。（需回复）', '工单类别': '次紧急', '处理描述': '区城市运行管理服务中心： 区建管委于2024年01月08日17时37分在网上工作平台接收编号为202401081636300160的工单，其内容描述为“反映大连路277号因电力施工疑似将其单位的污水管及自来水管挖断，望尽快处理”。接到工单后，区建管委工作人员于01月08日18时00分联系了李先生（市民），进一步了解该市民的诉求。 处理描述：接单后，区建管委工作人员第一时间联系投诉人，了解该市民的诉求。经了解，该处为电力排管施工，虹口区市政和水务管理中心已通知施工单位与该单位工作人员联系，现场认定事情责任。电话联系市民，表示理解。 虹口区建设和管理委员会 2024年01月17日...', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '供水', '三级分类': '供水报修', '四级分类': '其他报修', '主办单位': '虹口区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704409806-2895782', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000512, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 17, 46), '诉求地址': '黄浦区宝屯路26号（再三和市民确认过））', '诉求区域': '黄浦区', '内容描述': '市民补充信息：居委之前回复过市民表示只能劝阻无法强制处理，现该处早上6点半就开始装修，市民希望管理部门将该问题给到可以有效解决的单位进行处理【最近派发的工单编号：20231223000397，工单内容：市民来电反映:上述地址，市民表示其26号装修7:00就开始，严重噪音扰民。诉求：望管理部门核实让其按照规定时间来装修。（需回复）】', '工单类别': '一般', '处理描述': '市民补充信息，已电子催单工单编号：20231223000397，故归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '社会噪声', '四级分类': '装修噪音', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704410001-2113929', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000542, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 23, 57), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:投诉交警违章处罚问题', '工单类别': '一般', '处理描述': '根据《对交通违法处罚决定或强制措施有异议怎么提出行政复议或者行政诉讼？》告知市民，市民认可，故归档', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704410405-2113955', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000572, '工号': 3520, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 30, 43), '诉求地址': '奉贤区西渡街道沿江路', '诉求区域': '奉贤区', '内容描述': '【重新交办，要求：答复要点与实际情况不符，该处至今有很多机动车违章停车，情况没有改善，希望管理部门尽快处理解决（市民要求信息保密，无需回复）。最近办结的工单编号：20231220000522，工单内容：市民来电反映:上述地址经常有车辆占用机动车道乱停车，一直无人管理。诉求：建议管理部门核实后，对该处违章停车加强管理。（市民要求信息保密 无需回复）】', '工单类别': '一般', '处理描述': '市公安局奉贤分局西渡派出所于2024年1月5日9时08分收到市民的咨询件，由于咨询人信息保密，无法联系，对于咨询人的提问，西渡所的答复是：今年以来，西渡派出所将沿江路作为交通顽疾重点整治路段，持续开展整治，共整治违停车辆达10余辆，下一步将继续加大整治力度，努力净化道路交通环境。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '交通管理', '四级分类': '交通违章', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704410613-2895824', '工单类型': '意见建议类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000582, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 31, 34), '诉求地址': '奉贤区青村镇元通村144号     ', '诉求区域': '奉贤区', '内容描述': '市民来电反映:上述地址村民将宅基地后门的区域拓宽占为己用，诉求：希望管理部门核查处理。（市民要求信息保密 无需回复）', '工单类别': '一般', '处理描述': '青村镇于2024年1月5日接单，由于反映人匿名，故无法先行联系。2024年1月9日13:40时对来电人所反映的情况进行核实，并进行了现场处置，关于来电人所反映的情况，我单位李兵与城管人员第一时间赶往现场查看，现场查看下来并未有拓宽和乱占用现象，该户物品堆放也在自家宅基地上，不是公共的，匿名案件无法告知反映人。该问题已解释说明，经办人 梁艳芳。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '奉贤区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704410739-855696', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000562, '工号': 3662, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 33, 7), '诉求地址': '静安区南京西路常德路', '诉求区域': '静安区', '内容描述': '市民来电反映:2024年1月4日21:28市民在上述地址被上海市公安局静安分局交通警察支队警察执法，市民认可对市民的判罚，拐弯的机动车，未让直行的车辆，但是后面也有几辆车子同样情况，但是都没有处理处罚，表示选择性执法。另外此地没有左转专用红绿灯，交警站在5-8米远距离，没有去疏导交通，反而带有目的性在此地执法，只看到一个编号：310106，不方便提供车牌号，诉求：请管理部门核实后对其选择性执法，不去疏导交通，不作为整治。（市民要求信息保密，需回复）', '工单类别': '一般', '处理描述': '上海市公安局静安分局交警支队一大队于2024年1月5日9:28，16:51，9日9:19分许与来电市民取得联系，具体答复内容为：2024年1月4日21时28分许，反映人途经南京西路常德路时，因转弯车不让直行车或行人的违法行为被我队民警王元（警号028947）发现并予以处理，并开具编号为3101061302772612的处罚决定书。经查看民警执法记录仪，反映人违法事实清晰，民警对其违法事实认定及处理程序无发现有不妥之举，民警一直在路口进行处罚，未发现有选择性执法的情况。经沟通释明有关情况后，来电人表示满意。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '服务态度', '主办单位': '市公安局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704410541-855676', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000692, '工号': 3882, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 39, 51), '诉求地址': '浦东新区唐兴路1000号', '诉求区域': '浦东新区', '内容描述': '市民来电反映:上述地址马路对面人行道，有个方形的窨井盖破损，存在安全隐患。诉求：希望管理部门核实，并对井盖进行维修', '工单类别': '次紧急', '处理描述': '唐镇农村公路管理站接单后核实情况，后经现场查看与了解，情况属实。已安排养护单位对破损井盖进行维修，现已处理完毕。感谢您对唐镇城运工作的理解和支持。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '水务', '三级分类': '排水排污管理', '四级分类': '不明归属井盖', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704411406-76490', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000872, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 41, 10), '诉求地址': '无', '诉求区域': '本市', '内容描述': '无声来电', '工单类别': '一般', '处理描述': '无声来电', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无效来电', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704410528-76397', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000712, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 47, 46), '诉求地址': '汾阳路8号', '诉求区域': '本市', '内容描述': '市民来电反映:2024年1月4日市民在汾阳路8号五官科医院8号楼3层宇科（市民称是这个科）病房医生（姓名、工号不清楚）开药不按市民病情、体质开。市民检查血常规，很多项目减少，病房医生还照样给市民输禁忌的头孢类点滴液。市民找病房医生，还说大家都一样。市民原来是西医，现在是中医，了解情况。可能这个药比较便宜。诉求：给到市民一个说法。', '工单类别': '一般', '处理描述': '与患者电话联系，了解情况，患者目前恢复良好，所质疑的问题，待患者来我院复查时，主刀医生会详细解释。患者明白。', '客户类型': '个人', '一级分类': '科教文卫类', '二级分类': '卫生计生', '三级分类': '医疗服务', '四级分类': '用药规范', '主办单位': '市卫生健康委', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704411492-76502', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105001082, '工号': 1840, '工单生成时间': datetime.datetime(2024, 1, 5, 7, 51, 9), '诉求地址': '无', '诉求区域': '本市', '内容描述': '市民要求人工服务\n', '工单类别': '一般', '处理描述': '市民要求人工服务\n', '客户类型': '个人', '一级分类': '其他类', '二级分类': '其他', '三级分类': '无效电话', '四级分类': '无明确诉求', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704410654-76411', '工单类型': '其他类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000892, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 2, 11), '诉求地址': '杨浦区江湾城路99号9栋（抖音商城）（上海格物致品网络科技有限公司', '诉求区域': '杨浦区', '内容描述': '市民来电反复催单。催单原因：市民称管理部门至今未给予任何回复，请管理部门尽快处理。【最近派发的工单编号：20240101016712，工单内容：市民来电反映:该处平台有许多卖字画与瓷器直播间宣传售卖的几百元商品承诺是真货，有紫光防伪，证书，有政府惠民补贴，可以向大拍卖行高价售卖，有些承诺回收，市民质疑是虚假宣传，具体哪些直播间市民未提供，现诉求：望管理部门尽快查处整治。（市民要求信息保密 需回复）】', '工单类别': '一般', '处理描述': '市民反复催单，已电子催单工单编号：20240101016712，故归档。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '广告监督', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704412559-2114186', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105000922, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 2, 47), '诉求地址': '浦东新区康桥镇康意路御南路', '诉求区域': '浦东新区', '内容描述': '市民来电反映: 上述地址园区门口每天都有10-20家无证设摊的摊贩，5:00多就开始摆摊，中午尤为严重，严重影响通行，诉求：希望管理部门核查取缔。（市民要求信息保密 需回复）', '工单类别': '一般', '处理描述': '您好！康桥镇城管中队接到投诉后于1.6日早上5.10 6.20 11.25赶至现场查看，未发现无证设摊现象，已安排队员固守，中队执法队员将加强该处无证设摊的巡查力度及管理力度，杜绝该处无证设摊现象。已电话联系诉求人，并表示理解。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '绿化市容', '三级分类': '城市管理', '四级分类': '无证设摊', '主办单位': '浦东新区人民政府', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704412736-2896084', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240105001022, '工号': 2972, '工单生成时间': datetime.datetime(2024, 1, 5, 8, 10, 53), '诉求地址': '虹口区汶水东路水电路口由东向西的隔离栏', '诉求区域': '虹口区', '内容描述': '市民来电对办理结果不满,市民告知管理部门回复市民称已经都清理完了，但是市民看到还没有清理，希望管理部门尽快都清理干净。【最近派发的工单编号:20240102001030，工单内容:市民来电反映:上述地址被屡次张贴二手车交易的广告，市民表示上次反映后，刚