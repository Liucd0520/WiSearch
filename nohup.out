e}, {'工单编号': 20240107018342, '工号': 1450, '工单生成时间': datetime.datetime(2024, 1, 7, 18, 40, 28), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:顺丰快递公司（收件地上海），快递单号：SF1521929033821，收到后6天发现该件破损，该件是道具，价值4000元，现在商家提供了发件时该件完好无损，是快递公司没有妥善包装造成，现在快递公司不处理。诉求：要求根据实际情况给予合理的处理方案。', '工单类别': '一般', '处理描述': '市民再次来电反映相同问题已为其派单处理，详见工单号：20240118011949，此工单归档。\t\t\t\n', '客户类型': '个人', '一级分类': '公用事业类', '二级分类': '邮政通信', '三级分类': '邮政服务', '四级分类': '快递服务', '主办单位': '邮政局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704623823-2365462', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107018412, '工号': 2912, '工单生成时间': datetime.datetime(2024, 1, 7, 18, 43, 50), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电要求转接“拼多多”。', '工单类别': '一般', '处理描述': '转接拼多多专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '网上购物', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704624027-278505', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107018632, '工号': 4020, '工单生成时间': datetime.datetime(2024, 1, 7, 18, 54, 30), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:其是空调行业的员工，与公司合作的关系，市民询问如何维权。', '工单类别': '一般', '处理描述': '市民与公司是合作关系，若要维权建议走司法途径维权，市民挂机，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704624586-533376', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107018512, '工号': 4240, '工单生成时间': datetime.datetime(2024, 1, 7, 18, 56, 5), '诉求地址': '黄浦区西藏中路268号来福士广场办公室2902室', '诉求区域': '黄浦区', '内容描述': '市民来电反映:投诉上海姜根酒店管理有限公司，上述地址是该酒店地址。市民于2023年11月29日、30日通过万豪酒店官网用万豪积分兑换中国南方航空里程数，29日市民用3000万豪积分兑换1610里程，30日用60000万豪积分兑换24854南航里程，加上附赠的里程数，应该到账40225里程。实际上只到账24854南航里程数。市民联系万豪客服，被告知万豪更新的系统，不是按照原来的英里数价值进行兑换。对于何时修改系统的问题，万豪没有告知。原先市民能兑换5000元，但目前只能兑换1500元。给市民造成了近4000元经济损失。诉求：要求管理部门补足40225南航里程，如果不能补，要求退还6万万豪积...', '工单类别': '一般', '处理描述': '经核实，万豪国际集团旗下酒店的客诉均由位于广东省广州市天河区林和中路8号的广州星木酒店咨询服务有限公司统一负责处理，根据《市场监督管理投诉举报处理暂行办法》第十五条，我局依法不予受理，已建议投诉人向广州星木酒店咨询服务有限公司的属地监管部门投诉。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '商业服务', '四级分类': '各类服务卡券', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704624152-2365554', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107018582, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 7, 18, 57, 22), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:正常缴纳五险一金。咨询：按规定生育金如何申领。', '工单类别': '一般', '处理描述': '根据《生育保险待遇申领（医保）》告知市民，市民认可。', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社会保险', '四级分类': '生育保险', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704624617-278657', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107018802, '工号': 2462, '工单生成时间': datetime.datetime(2024, 1, 7, 18, 58, 21), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:按规定甘肃新生儿是否可以在上海报甘肃户口。', '工单类别': '一般', '处理描述': '根据《长三角区域新生儿入户跨省（市）通办业务办理规定？》告知市民，市民认可。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '公安（治安、交通）', '三级分类': '户籍管理', '四级分类': '户籍政策咨询', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704624617-278657', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107018742, '工号': 2942, '工单生成时间': datetime.datetime(2024, 1, 7, 19, 0, 10), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:要求核实其妻子社保卡是否开通', '工单类别': '一般', '处理描述': '转接社保卡专席成功,归档', '客户类型': '个人', '一级分类': '社会管理类', '二级分类': '人力保障', '三级分类': '社保信息', '四级分类': '社保卡', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704625080-2622774', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240107018822, '工号': 2562, '工单生成时间': datetime.datetime(2024, 1, 7, 19, 8, 12), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映:网贷，希望能帮助协调分期。', '工单类别': '一般', '处理描述': '超出热线受理范围，如需要咨询可以拨打12348，认可，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名':