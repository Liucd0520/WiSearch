2, '工号': 3790, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 8, 48), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电反映: 因诈骗，银行卡被冻结，市民表示也不知道是哪个派出所冻结的。', '工单类别': '一般', '处理描述': '已解释，归档。', '客户类型': '个人', '一级分类': '公安政法类', '二级分类': '司法行政', '三级分类': '纠纷仲裁', '四级分类': '经济纠纷', '主办单位': None, '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704701031-2695388', '工单类型': '求助类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108026632, '工号': 4242, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 9, 7), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '市民来电咨询:企业年审如何办理，能否在手机上办理。', '工单类别': '一般', '处理描述': '转接成功,归档', '客户类型': '企业', '一级分类': '社会管理类', '二级分类': '工商(消保)', '三级分类': '工商监管', '四级分类': '审验登记', '主办单位': None, '是否匿名': None, '服务类型': '一网通办', '通话编号': '1704701109-395981', '工单类型': '咨询类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108026742, '工号': 2382, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 10, 42), '诉求地址': '本市', '诉求区域': '本市', '内容描述': '【投诉】市民反映:投诉管理部门不作为，敷衍。市民表示要求监管部门督促拼多多去处罚商家要求商家更改标题或是下架商品，管理部门却回复说这与拼多多无关，市民认为商家在拼多多平台怎么会和拼多多无关。诉求：市民投诉管理部门不作为，敷衍。（市民要求回复，相关工单编号：20231213003468）', '工单类别': '一般', '处理描述': '相关投诉举报的处理符合法定程序，依据《市场监督管理投诉举报处理暂行办法》处理。', '客户类型': '个人', '一级分类': '其他类', '二级分类': '纪检监察', '三级分类': '政风行风', '四级分类': '不作为', '主办单位': '市市场监管局', '是否匿名': None, '服务类型': '综合服务', '通话编号': '1704701160-396024', '工单类型': '投诉举报类', '新一级分类': None, '新二级分类': None, '新三级分类': None, '新四级分类': None, '新五级分类': None}, {'工单编号': 20240108027142, '工号': 3172, '工单生成时间': datetime.datetime(2024, 1, 8, 16, 11, 54), '诉求地址': '宝山区逸仙路1321弄通道，近32号附近栅栏', '诉求区域': '宝山区', '内容描述': '市民反映：逸仙路1321弄32号和逸仙路1321弄通道近60号铁门之间有一处铁栅栏，栅栏边上常年有收破烂堆放的大量易燃垃圾，冬天物燥，极易引起火灾，诉求：请管理部门予以整治。（市民要求信息保密，无需回复）', '工单类别': '一般', '处理描述': '我办接单后联系城管中队，中队接投诉赶至现场，经现场核实，为该小区管理垃圾厢房的工作人员将垃圾堆放在小区的垃圾厢房边上，执法人员立即要求该管理人员整改，清除该处垃圾，由于投诉人未留联系方式无法回复。', '客户类型': '个人', '一级分类': '建设交通类', '二级分类': '城管执法', '三级分类': '物业相关执法', '四级分类': '损坏侵占公用设施', '主办单位': '宝山区人民政府', '是否匿名': '是', '服务类型': '综合服务', '通话编号': None, '工单类型': '投诉举报类', '新一级分类': None, '新二级分类':