,方丽萍开发数控加工刀具管理系统,显著提升车间管理效能,并担任竞赛教练,带领团队屡创佳绩。她还培养20余名徒弟,其中5人获技师称号,为航空工业人才培养作出突出贡献。"}, {"编号": 20250311474, "年份": 2020, "区局": "临港产业区", "姓名": "林志鑫", "年龄": 51, "姓名拼音": "Lin2-Zhi4-Xin1", "性别": "男", "工作单位": "上海新昇半导体科技有限公司", "工种或工作头衔": "（半导体硅材料外延工艺）处长", "领域": "集成电路", "行业": "集成电路", "工匠介绍": "林志鑫，曾任上海新昇半导体科技有限公司外延工艺负责人，是我国半导体领域资深专家。他带领团队攻克40nm至28nm工艺节点外延片量产难题，填补国内空白，助力\"中国芯\"自主可控。曾获公司\"五周年长期服务奖\"，累计培养近10名专业技术人才。在职期间申请专利30项，其中发明专利28项，13项已授权，为推动我国半导体产业技术突破作出重要贡献。"}, {"编号": 20250311475, "年份": 2020, "区局": "临港产业区", "姓名": "张家榕", "年龄": 39, "姓名拼音": "Zhang1-Jia1-Rong2", "性别": "男", "工作单位": "上海上飞飞机装备制造有限公司", "工种或工作头衔": "（部件事业部）副部长", "领域": "民用航空", "行业": "航空", "工匠介绍": "张家榕，现任上海上飞飞机装备制造有限公司部件事业部副部长。从业以来，他致力于飞机部件装配领域，带领团队完成了C919飞机首架改装装配和ARJ21-700新支线翼身整流罩等关键项目。2019年，他带领团队实现ARJ21中后机身145至147架连续三架飞机装配零缺陷，推动了上海地区民营飞机大部件生产零突破，并带动长三角地区航空制造产业链发展。他的事迹体现了新时代工匠精神，为我国航空事业发展作出了重要贡献。"}, {"编号": 20250311476, "年份": 2020, "区局": "市公安局", "姓名": "王长亮", "年龄": 46, "姓名拼音": "Wang2-Zhang3-Liang4", "性别": "男", "工作单位": "上海市公安局刑事侦查总队", "工种或工作头衔": "（刑事技术科）科长", "领域": "社会工作", "行业": "公安", "工匠介绍": "王长亮同志,作为公安部刑技青年人才和上海刑侦文检专业人才,长期从事公安刑事技术工作,累计检验鉴定各类案件4000余件,参与侦破重大特大案件近千起,其专业鉴定意见为案件侦破和诉讼提供了重要技术支撑。 he担任中国刑事科学技术协会文检专业委员会委员、文检鉴定公安部重点实验室学术委员会委员（兼任客座研究员），并入选上海市文检司法鉴定专家委员会专家，在疑难笔迹检验、高仿真印章印文鉴别、变造（污损）文件分析及朱墨时序鉴别等领域具有深厚的专业造诣。 王长亮同志创新提出了《朱墨时序鉴别典型特征图谱》和同源性检验理论，并在高仿真印章印文检验鉴定方法上取得重要突破。..."}, {"编号": 20250311477, "年份": 2020, "区局": "插花花艺协会", "姓名": "王志东", "年龄": 56, "姓名拼音": "Wang2-Zhi4-Dong1", "性别": "男", "工作单位": "上海尚雅鲜花礼仪服务有限公司", "工种或工作头衔": "花艺师", "领域": "文化", "行业": "花艺", "工匠介绍": "王志东，中国插花花艺大师、世界杯INTERFLORA花艺大赛国际评委、美国芝加哥花艺学院教授。他从业30余年，师承蔡仲娟，在插花花艺领域屡获殊荣，包括市级大赛4个第一名、国家级大赛11个金奖、中国杯冠亚军，并两次代表中国队参加洲际杯和亚洲杯赛事。他擅长多种花艺表现形式，创新插花技法，将西方色块与东方线条韵律融合，强调插花作品源于自然、高于自然。王志东积极践行插花花艺在空间布置中的创新应用，2018年获上海市劳动五一奖章，2019年在世界园艺博览会上获特等奖和金奖。"}, {"编号": 20250311478, "年份": 2020, "区局": "电力工程协会", "姓名": "钱平", "年龄": 52, "姓名拼音": "Qian2-Ping2", "性别": "男", "工作单位": "中机国能电力工程有限公司", "工种或工作头衔": "（项目管理）中心主任", "领域": "高端装备", "行业": "电力", "工匠介绍": "钱平，汽轮机安装领域的杰出代表。从普通技术工人成长为专业工程师和高级技师，参与国内外20多个大型电厂建设，主导多项重大电力工程。扬州第二发电厂等4个项目获\"中国建筑工程鲁班奖\"，国华徐州发电厂工程获\"国家优质工程金奖\"。主持4项工法，其中1项达国家级，突破2项关键技术，参与3项发明专利，多次参与国家或行业标准编制。获\"江苏省有突出贡献专家\"、\"中国施工企业管理协会科学技术创新先进个人\"、\"镇江市五一劳动奖章\"等荣誉。培养3名骨干徒弟，热心公益，资助贫困学生，回馈社会。"}, {"编号": 20250311479, "年份": 2020, "区局": "电力工程协会", "姓名": "卢海军", "年龄": 53, "姓名拼音": "Lu2-Hai3-Jun1", "性别": "男", "工作单位": "上海东捷建设（集团）有限公司", "工种或工作头衔": "（电力电缆施工）技术负责人", "领域": "高端装备", "行业": "电力", "工匠介绍": "卢海军，高级技师，现就职于上海东捷建设（集团）有限公司电缆分公司。作为回沪知青子女，他于1990年加入电业工人职业生涯，在电力电缆领域潜心钻研，逐步从电缆抢修班班员成长为技术骨干，并参与了世博动迁、长江隧桥等众多市政重点工程。他秉持\"生命的多少用时间计算，生命的价值用贡献计量\"的信念，在技术革新与实践中荣获上海市劳模等多项荣誉。&#10;&#10;卢海军不仅在专业领域取得显著成就，还致力于技术传承与创新。他牵头创立\"卢海军劳模创新工作室\"，通过传帮带培养出众多技术骨干和操作能手，推动浦东电力事业发展。他的努力为电缆行业树立标杆，充分发挥了劳模的辐射效应，为行业发展注入新动力。"}, {"编号": 20250311480, "年份": 2020, "区局": "房屋修建协会", "姓名": "陈建福", "年龄": 61, "姓名拼音": "Chen2-Jian4-Fu2", "性别": "男", "工作单位": "上海新长宁集团建筑装饰实业有限公司", "工种或工作头衔": "董事长", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "陈建福，上海新长宁集团建筑装饰实业有限公司企业负责人，全国劳动模范、上海市五一劳动奖章获得者。他1982年入职，从普通操作工成长为技能人才，带领团队完成多项优质工程。秉持\"做专、做精、做细、做实\"的工匠精神，他将职业敬畏、工作执着和产品负责融入工作，在平凡岗位上创造不平凡价值。他的事迹诠释了踏实工作、立足岗位、创先争优的精神，激励着无数从业者在本职上追求卓越。"}, {"编号": 20250311481, "年份": 2021, "区局": "浦东新区", "姓名": "王华菁", "年龄": 49, "姓名拼音": "Wang2-Hua2-Jing1", "性别": "女", "工作单位": "上海原能细胞医学技术有限公司", "工种或工作头衔": "创新药研发人员", "领域": "生物医药", "行业": "医药卫生", "工匠介绍": "王华菁，肿瘤学专业博士，高级实验师，长期致力于科研工作，主持完成两项国家自然科学基金课题和一项军队“十二五”面上项目，发表SCI论文20篇，授权发明专利十余项。她负责IL-17和PD-L1全人源抗体药物研究，两项技术获2021年发明专利授权，被列入上海市2019年度科技创新行动计划。作为抗体开发技术平台核心成员，她参与研发多种单抗、双抗产品，其中一款创新药物获跨国药企认可并签署独占许可协议。她培养的团队在2020年实验技能大赛中获一等奖，并受邀参与浦东新区“四大品牌”技能大赛纪录片拍摄及采访。"}, {"编号": 20250311482, "年份": 2021, "区局": "浦东新区", "姓名": "禹宝庆", "年龄": 60, "姓名拼音": "Yu3-Bao3-Qing4", "性别": "男", "工作单位": "上海市浦东新区人民医院", "工种或工作头衔": "骨科教授", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "禹宝庆，从事骨科临床及科研工作30余年，擅长复杂关节周围骨折、骨盆髋臼骨折、髋膝关节置换等高难度手术。他在国际上首次提出经腓骨头截骨入路治疗胫骨平台骨折和单切口双钢板治疗胫腓骨远端骨折，在国内率先提出骨盆骨折的微创入路并开展微创髋关节置换手术。他运用\"3D打印\"技术为患者定制个性化治疗方案，设计发明了十余项关节周围骨折内固定器械并投入临床使用，实现产学研一体化。他设计了多款具有完全自主知识产权的国产内固定器械，获得国家专利并实现临床运用，有效降低手术时间和创伤，提高手术治疗效果。他在学术领域主编《现代髓内钉外科学》等专著7部，发表论文200余篇，其中SCI收录70余篇，获国家授权发明专利..."}, {"编号": 20250311483, "年份": 2021, "区局": "浦东新区", "姓名": "孙磊", "年龄": 48, "姓名拼音": "Sun1-Lei3", "性别": "男", "工作单位": "上海乾庾智能科技有限公司", "工种或工作头衔": "技术管理人员", "领域": "智能机器人", "行业": "高端装备", "工匠介绍": "孙磊，上海市首席技师，2004年硕士毕业后进入库卡机器人公司，从事工业机器人技术及项目管理近二十年，积累了丰富的行业经验。他主导并参与了上百个工业机器人及自动化项目，成功完成了福特冲压线、北京奔驰夹具3D设计安装系统等多项重要工程。孙磊在技术创新方面取得显著成果，拥有1项发明专利和16项实用新型专利。他于2015年创立“孙磊机器人工作室”，致力于培养高端人才，2017年被评为浦东工匠，2020年荣获临港工匠称号。多年来，通过组织“康桥杯”工业机器人技能邀请赛和培训，累计培养近千名专业人才。"}, {"编号": 20250311484, "年份": 2021, "区局": "浦东新区", "姓名": "徐祎春", "年龄": 40, "姓名拼音": "Xu2-Yi1-Chun1", "性别": "女", "工作单位": "上海生物芯片有限公司", "工种或工作头衔": "研发人员", "领域": "集成电路", "行业": "集成电路", "工匠介绍": "徐祎春，作为分子诊断应用研究领域的资深专家，一直致力于以市场为导向的技术开发工作。她主持在研省部级及中心项目共10项，获医疗器械注册备案证5项，申请专利6项，授权1项，拥有软件著作权1项。发表SCI论文10篇和中文核心论文2篇。曾荣获“浦东工匠”、“上海市青年启明星”等多项荣誉。&#10;&#10;徐祎春在科研工作中积极推进分子诊断应用研究及产品研发，主持并参与了新冠检测试剂盒等30余项产品的研发工作，成功开发了肿瘤突变基因检测产品、核酸提取试剂盒等。她还着力推进研发与转化功能型平台建设，建立了多个技术平台，为生物医药行业的产品转化作出积极贡献。科研项目涵盖肿瘤生物标志物、中药药理机制、..."}, {"编号": 20250311485, "年份": 2021, "区局": "浦东新区", "姓名": "闫国杰", "年龄": 52, "姓名拼音": "Yan2-Guo2-Jie2", "性别": "男", "工作单位": "上海浦东路桥（集团）有限公司（个人自荐）", "工种或工作头衔": "技术管理", "领域": "土地混合利用", "行业": "交通", "工匠介绍": "闫国杰，博士研究生、正高级工程师，现任上海浦东路桥（集团）有限公司研发总监，是上海市重大工程立功竞赛获得者、2015上海市五一劳动奖章获得者及2018浦东新区工匠。致力于新型路用材料研究及应用推广，主持15项重大科研课题，获9项省部级科学技术奖、42项专利授权及5项规范。其“海绵城市排水路面”与“直投式温拌剂”等成果已应用于多省市，创造近2亿元经济效益。其中，“海绵城市排水路面”降低交通噪音5-8分贝，雨天事故率降40%；“直投式温拌剂”使沥青拌和温度降低25-30℃，烟气排放减少50-70%，节能减排效益显著。两项成果分别获中国公路学会科学技术奖二等奖及上海市公路学会科学技术奖一等奖。"}, {"编号": 20250311486, "年份": 2021, "区局": "徐汇区", "姓名": "张敬谊", "年龄": 50, "姓名拼音": "Zhang1-Jing4-Yi4", "性别": "女", "工作单位": "万达信息股份有限公司", "工种或工作头衔": "计算机信息系统", "领域": "数据安全", "行业": "信息", "工匠介绍": "张敬谊，教授级高工，万达信息股份有限公司副总裁、数据中心总经理，国家级技能大师工作室认定人。长期致力于医疗健康大数据智能化领域核心技术攻关与解决方案设计研究，自主研发的分布式并发网格计算技术获上海市科技进步二等奖，创新研发医疗异构数据融合治理与安全管控技术体系，获国家级科技水平认定。累计获得4项发明专利授权，为上海市重大民生保障工程提供技术支撑，并在全国实现医疗健康智慧服务应用示范，赋能近6亿人口。主导组建国家卫生信息共享技术及应用工程技术研究中心、医疗大数据应用技术国家工程实验室（上海），为医疗健康行业核心能力提升提供国家级平台服务。"}, {"编号": 20250311487, "年份": 2021, "区局": "徐汇区", "姓名": "薛渊", "年龄": 59, "姓名拼音": "Xue1-Yuan1", "性别": "男", "工作单位": "上海生物电子标识股份有限公司", "工种或工作头衔": "技术指导", "领域": "物流自动化", "行业": "信息", "工匠介绍": "薛渊，作为企业技术研发带头人，始终秉持创新精神，带领团队在电子标签技术研发及应用领域取得显著成就。他通过优化加工工艺和调整数据参数，成功提升了产品加工精度和生产效率，使电子标签加工效率提升120%。薛渊带领团队获得上海市科学技术奖一等奖等多项荣誉，并取得三十多项专利、十几项软件著作权。他以\"一丝不苟、追求极致\"的理念，严格把控生产工序，展现了新时代工匠精神的深刻内涵，彰显了中国技术工作者在创新道路上的卓越贡献。"}, {"编号": 20250311488, "年份": 2021, "区局": "长宁区", "姓名": "石向东", "年龄": 55, "姓名拼音": "Shi2-Xiang4-Dong1", "性别": "男", "工作单位": "长宁区华阳街道社区卫生服务中心", "工种或工作头衔": "医生", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "石向东，扎根基层医疗二十余年，致力于中医药技术的传承与创新，尤其在慢性病治疗领域取得显著成效。作为国家级非物质文化遗产朱氏一指禅和陆氏针灸技术的传承人，他将传统中医技法与现代诊疗相结合，形成了以腰椎间盘突出症、颈椎病、失眠等为优势病种的核心诊疗体系。每日门诊量达六十余人次，年门诊量超过1.5万人次。他牵头成立了\"石向东工作室\"，致力于传承海派名老中医的学术经验，创新形成了\"石向东团队工作法\"，年总门诊量达5万人次并逐年增长。他还积极参与抗疫一线工作，创建国家级盲人医疗按摩实训基地，培养专业盲人医生7名，带领团队主持科研课题7项，发表论文9篇，获得专利2项，参编著作4部。腰椎间盘突出症被列..."}, {"编号": 20250311489, "年份": 2021, "区局": "普陀区", "姓名": "吴大治", "年龄": 48, "姓名拼音": "Wu2-Da4-Zhi4", "性别": "男", "工作单位": "上海星耀医学科技发展有限公司", "工种或工作头衔": "研发人员", "领域": "生物医药", "行业": "医药卫生", "工匠介绍": "吴大治，PCR核酸分子诊断领域资深专家，致力于推动我国体外诊断技术创新发展。他成功研发国内首个含内参的荧光PCR产品，攻克临床检测技术难题，获发明专利授权并成为国家药监部门技术审查要求。其开发的新型核酸提取纯化产品获上海市优秀发明金奖，并参与制定行业标准。主持多项国家级课题研究，主导开发10余项三类医疗器械产品，获授权专利10项。在新冠疫情期间，带领团队研发注册新冠病毒PCR试剂盒，产品广泛应用，获显著经济效益。曾获浦东新区科学技术奖二等奖、上海市普陀工匠、上海市劳动模范等荣誉称号，展现了卓越的专业能力和领导素质。"}, {"编号": 20250311490, "年份": 2021, "区局": "普陀区", "姓名": "裘耀明", "年龄": 61, "姓名拼音": "Qiu2-Yao4-Ming2", "性别": "男", "工作单位": "上海瑞斯达防护制品有限公司", "工种或工作头衔": "联合创始人", "领域": "先进材料", "行业": "材料", "工匠介绍": "裘耀明，高级工程师，长期致力于特种高分子塑胶防护技术研发。他主持完成多项自主研发项目，获得上海市科技进步三等奖、上海市纺织科技进步一等奖等荣誉，并发表多篇研究论文。裘耀明同志累计获得30余项专利技术，其中包括国内首创的塑料与丁腈橡胶改性复合新材料，技术水平达到国际先进。他培养了5名优秀徒弟，多人成为PPE行业领军人才。近年来，其成果产品出口至国际高端市场，累计为国家创汇数亿美元。"}, {"编号": 20250311491, "年份": 2021, "区局": "虹口区", "姓名": "秦磊", "年龄": 41, "姓名拼音": "Qin2-Lei3", "性别": "男", "工作单位": "上海三吉电子工程有限公司", "工种或工作头衔": "计算机专业技术", "领域": "人工智能", "行业": "通信", "工匠介绍": "秦磊，作为杰出的大国工匠，在通信技术领域表现卓越，参与多个重大项目并为城市运行安全作出重要贡献。他提出融合通信技术路线，推动前沿技术落地，为上海智慧公安和智慧城市战略提供技术支撑。带领团队完成技术攻关和新产品推广，培养出一支高水平团队。秦磊同志曾荣获上海市科学技术奖二等奖、上海市软件服务明星称号、上海市科技进步奖三等奖及虹口工匠荣誉称号，展现了其专业造诣和社会责任感。"}, {"编号": 20250311492, "年份": 2021, "区局": "杨浦区", "姓名": "许杰", "年龄": 39, "姓名拼音": "Xu3-Jie2", "性别": "男", "工作单位": "上海勘察设计研究院（集团）有限公司", "工种或工作头衔": "岩土工程设计", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "许杰，高级工程师，现任上海勘察设计研究院（集团）有限公司研究院副院长、信息院副院长，长期致力于城市数字化转型及地下空间风险防控领域的研究工作。他主持或参与国家级、省部级及市级重大科研课题8项，牵头研发岩土工程信息模型“标准+建模算法+软件平台”成套技术，制定地方标准1部，编制企业技术导则4部，开发建模软件5项，搭建云服务平台1个，成果应用于20余项重大工程。许杰累计申请专利22项、软件著作权5项，发表学术论文10余篇，参与编写国家、行业及地方标准6项，荣获行业及上海市优秀工程勘察奖8项。其团队获评上海市工人先锋号和上海市青年五四奖章集体称号。"}, {"编号": 20250311493, "年份": 2021, "区局": "黄浦区", "姓名": "洪佳雄", "年龄": 43, "姓名拼音": "Hong2-Jia1-Xiong2", "性别": "男", "工作单位": "上海老凤祥首饰研究所有限公司", "工种或工作头衔": "设计制作", "领域": "文化", "行业": "工艺美术", "工匠介绍": "洪佳雄，现任老凤祥首饰研究所技术副所长，从业23年，精通首饰设计、起版、微镶等技术。其作品四届获\"百花杯\"中国工艺美术精品奖金奖，代表作《青云登一品》融合传统与现代工艺。他研发琥珀专用镶嵌结构，获十项实用新型专利，运用冷镶工艺保护琥珀，为公司创千万元利润。建党百年受邀担任\"光荣在党50年\"勋章技术专家，参与结构技术攻关。洪佳雄担任\"全国首饰标准化技术委员会\"委员，参与起草国家行业标准，获发明专利3项、实用新型专利18项、外观设计专利50余项，培养高级技师2名、技师8名、工艺美术师5名。"}, {"编号": 20250311494, "年份": 2021, "区局": "黄浦区", "姓名": "孙建辉", "年龄": 54, "姓名拼音": "Sun1-Jian4-Hui1", "性别": "女", "工作单位": "上海市商贸旅游学校", "工种或工作头衔": "教师", "领域": "教育", "行业": "教育", "工匠介绍": "孙建辉，从事酒店服务与管理教育工作三十余年，现为上海市\"高星级饭店运营和管理专业\"学科带头人，曾获\"中国服务大师\"\"七星金牌教师\"等荣誉称号。她潜心研究酒文化，创新调酒方法，创作\"紫精灵\"\"花样年华\"等经典鸡尾酒，曾获2007年上海市星光调酒比赛第一名，并总结出\"一贴、二靠、三缓、四兑\"的独特调酒秘诀。在教学中，她注重标准化教学，培养学生的调酒技艺创新能力，指导学生连续14年获得上海市团体冠军。她还担任人社部\"餐饮服务\"国家级裁判员，主编《西餐服务》《会务接待员》等全国教材，并参与编写《酒吧服务》课程标准及专项能力项目建设工作。"}, {"编号": 20250311495, "年份": 2021, "区局": "静安区", "姓名": "马瑞", "年龄": 39, "姓名拼音": "Ma3-Rui4", "性别": "男", "工作单位": "上海云卓文化艺术有限责任公司", "工种或工作头衔": "珠宝设计师", "领域": "文化", "行业": "工艺美术", "工匠介绍": "马瑞，新疆玉雕第三代非遗传承人、上海交大珠宝艺术客座讲师，现任上海云卓文化艺术有限公司总经理兼艺术总监，获“上海市静安工匠”称号，并获评新疆高级工艺美术大师。他独创“阴阳雕刻法”，将中国哲学思想与写意风格融入玉雕创作，开创金镶和田玉雕刻系列，融合中西珠宝设计，作品多次获得国际大奖，如上海玉石雕刻“玉龙奖”大满贯及意大利A DESIGN银奖。其代表作《玉兰花开》金镶玉雕刻项圈曾亮相瑞士巴塞尔国际钟表珠宝展。"}, {"编号": 20250311496, "年份": 2021, "区局": "宝山区", "姓名": "徐宁", "年龄": 45, "姓名拼音": "Xu2-Ning2", "性别": "男", "工作单位": "中国二十冶集团有限公司", "工种或工作头衔": "研究院副院长", "领域": "土地混合利用", "行业": "钢铁冶金", "工匠介绍": "徐宁，作为装配式建筑领域的专家，致力于推动装配式混凝土建筑的设计施工一体化技术创新。他主持或参与了多项国家级科研课题，开发了装配式建筑智能建造成套新技术，提出了\"非等同现浇\"设计理论和\"少规格、多组合\"拆分技术，解决了装配式建筑发展的关键问题，达到国际先进水平。他在全国推广BIM正向设计技术，提升了装配式建筑的施工效率和质量。徐宁获上海市青年拔尖人才、宝山工匠等多项荣誉，发表论文24篇，授权专利22项，主持制定ISO国际标准1项，科研成果累计创造超过2000万经济效益。"}, {"编号": 20250311497, "年份": 2021, "区局": "宝山区", "姓名": "周景纬", "年龄": 44, "姓名拼音": "Zhou1-Jing3-Wei3", "性别": "男", "工作单位": "上海陶院艺术品投资管理有限公司（个人自荐）", "工种或工作头衔": "陶艺", "领域": "文化", "行业": "工艺美术", "工匠介绍": "周景纬，正高级工艺美术师、上海陶瓷科技馆专职艺术家，系陶瓷金彩装饰非物质文化遗产代表性传承人，入选江西省百千万人才工程。他专注于陶瓷釉下金彩新技术研究，获国家专利四项，作品获国家级金奖五项、银奖两项，被国家一级、二级博物馆收藏五件。主持杭州G20峰会《雅韵东方》国宴餐具设计等多项国家大型活动陶瓷礼品制作。创新稻谷壳灰泥料配方及融合型花纸技术，获国家专利。作为上海工艺美术职业学院副院长，投身陶瓷职业教育，指导学生申报专利四项，培养 students多人。荣获上海市民终身学习科普教育体验基地先进集体等荣誉二十余项。"}, {"编号": 20250311498, "年份": 2021, "区局": "闵行区", "姓名": "马博", "年龄": 38, "姓名拼音": "Ma3-Bo2", "性别": "男", "工作单位": "上海宁远精密机械股份有限公司", "工种或工作头衔": "技术工程师", "领域": "生物医药", "行业": "高端装备", "工匠介绍": "马博同志，作为设计研发领域的突出代表，在工作中勇挑重担、勇于创新。他自主研发的鼓式过滤器有效优化了资源利用，国产化三坐标深孔钻机床显著降低了成本并远销多国。在环模机床设计项目中，他通过优化设计降低了成本并提升了销量。自主研发的30轴数控深孔钻机床填补了国内空白，显著提高了加工效率和光洁度。他还为医疗器械精密轴加工提供解决方案，解决了技术难题。作为基层干部，马博同志严于律己，充分发挥了模范带头作用，为基层事业发展做出了积极贡献。"}, {"编号": 20250311499, "年份": 2021, "区局": "闵行区", "姓名": "王国伟", "年龄": 43, "姓名拼音": "Wang2-Guo2-Wei3", "性别": "男", "工作单位": "上海中广核工程科技有限公司", "工种或工作头衔": "型号项目技术负责人", "领域": "高端装备", "行业": "高端装备", "工匠介绍": "王国伟,哈尔滨工业大学硕士、高级工程师,长期致力于核电站管道焊接与隔热技术研发工作,在多个重点科研项目中担任主要负责人,多项创新成果填补行业空白且产生显著效益。他获得第四届军民融合发展高技术装备成果推荐,主持的《上海市核电站高新核材及装备工程技术研发中心项目》《核电主管道自动焊接技术开发应用研究项目》等多项科研课题获国家部委立项支持并顺利通过验收,成果鉴定为国际先进水平,节约工程建设成本近3000万元。"}, {"编号": 20250311500, "年份": 2021, "区局": "闵行区", "姓名": "王顺", "年龄": 39, "姓名拼音": "Wang2-Shun4", "性别": "男", "工作单位": "上海太阳能工程技术研究中心有限公司", "工种或工作头衔": "技术研发", "领域": "新能源", "行业": "高端装备", "工匠介绍": "王顺，专业领域涵盖微能源与可穿戴技术的研究与产品开发。近年来，他主持并参与了多项上海市、科技部及航天八院的重点项目，为推动上海市生态建设、地下空间建设和智能装备发展做出了积极贡献。作为上海市科委\"崇明鸟类保护和可再生能源协调发展\"重大课题负责人，他为上海崇明国际生态岛建设及\"2021上海崇明花博会\"的成功举办提供了科学的大数据支撑。同时，他参与的国家科技部重点项目\"高功率密度微纳振动能量收集器技术及矿井装备智能化应用研究\"，实现了工业环境中微弱振动能量的高效采集与存储。此外，他负责的军民两用\"全光谱智能护目镜\"技术与产品研发工作，成为上海航天八院民参军型谱化建设的亮点项目，并填补了我军单..."}, {"编号": 20250311501, "年份": 2021, "区局": "嘉定区", "姓名": "王勤", "年龄": 53, "姓名拼音": "Wang2-Qin2", "性别": "女", "工作单位": "徐行草编名师工作室", "工种或工作头衔": "草编", "领域": "文化", "行业": "工艺美术", "工匠介绍": "王勤，女，致力于传承和创新草编技艺，出生徐行镇，师从草编传承人计学成。她曾两次参加文化部非遗传承人群研修研习培训，代表上海市妇联参加“中国妇女手工创业创新大赛”，其工作室被命名为“嘉定工匠王勤创新工作室”和“上海市巾帼创新工作室”。王勤突破传统平面设计，创新立体编织和多材料融合，研发新品100余件，亮相上海国际进口博览会，获国内外赞誉，部分作品被上海市档案馆收藏。她积极参与非遗传播，开展公益培训500余次，受训2.5万人次，参与《海派百工》《指尖上的非遗慕课》等教学片录制，为非遗传承与发展做出重要贡献。"}, {"编号": 20250311502, "年份": 2021, "区局": "金山区", "姓名": "卢玉金", "年龄": 56, "姓名拼音": "Lu2-Yu4-Jin1", "性别": "男", "工作单位": "上海施泉葡萄专业合作社", "工种或工作头衔": "葡萄栽培", "领域": "葡萄栽培", "行业": "农业", "工匠介绍": "卢玉金，作为葡萄种植领域的杰出代表，始终致力于科技创新与人才培养。他成功研发\"绿枝嫁接和硬枝嫁接嫩枝\"新技术，有效提升经济效益，获国家农业部丰收奖。其所种植的施泉葡萄屡获全国金奖，荣获上海市创新文化品牌和国家生态原产地保护产品称号，广受市场青睐。卢玉金无偿为徒弟和果农提供技术培训，累计挽回损失超8000万元，积极投身公益事业，结对帮扶贫困学生，支持革命老区教育，展现新时代工匠风采。"}, {"编号": 20250311503, "年份": 2021, "区局": "金山区", "姓名": "蔡祥军", "年龄": 60, "姓名拼音": "Cai4-Xiang2-Jun1", "性别": "男", "工作单位": "上海立得催化剂有限公司", "工种或工作头衔": "精细化工", "领域": "先进材料", "行业": "材料", "工匠介绍": "蔡祥军，聚烯烃行业专家，曾用35年时间从普通技术人员成长为掌握多项技术的行业专家。他带领团队在聚烯烃催化剂领域实现国产化，创造当年建设、投产、应用、盈利的奇迹。至今，他已获得5项国家发明专利，15项实用新型专利，国家科学技术二等奖1项，上海市科学技术奖4项，中国石化科学技术进步奖6项。其团队开发的42种催化剂产品，市场占有率达70%以上，部分产品出口海外，为国内聚烯烃行业节省成本并创造约55亿元经济效益，推动了我国聚烯烃行业的快速发展。"}, {"编号": 20250311504, "年份": 2021, "区局": "松江区", "姓名": "邹波", "年龄": 47, "姓名拼音": "Zou1-Bo1", "性别": "男", "工作单位": "上海筱爷叔品牌管理有限公司", "工种或工作头衔": "餐饮", "领域": "餐饮", "行业": "餐饮", "工匠介绍": "邹波，上海筱爷叔品牌创始人，师承香港名厨吴民宣及上海菜非遗传承人周元昌，主攻粤菜、本帮菜及民间菜。他潜心研发创新，推出近五十款原创美食，将传统民间美食与粤式烹饪手法相结合。邹波在烹饪岗位上培养学徒近千人，带领团队屡获国际级烹饪赛事金奖，并在2010年为国家领导人接待晚宴及奥运冠军庆功宴会提供服务。他创新性提出厨房管理模式，提升厨师收入水平，培养出众多五星级酒店行政总厨及行业精英，为餐饮业输送大量优秀人才。"}, {"编号": 20250311505, "年份": 2021, "区局": "松江区", "姓名": "罗清篮", "年龄": 37, "姓名拼音": "Luo2-Qing1-Lan2", "性别": "男", "工作单位": "上海谋乐网络科技有限公司", "工种或工作头衔": "网络安全与防护", "领域": "人工智能", "行业": "安全", "工匠介绍": "罗清篮，漏洞银行（上海谋乐网络科技有限公司）创始人、董事长，系2019年上海市领军人才、2020年上海市科学技术发明一等奖获得者。自幼展现计算机网络安全天赋，18岁成为四川某安全公司首席技术顾问，后保送至东华大学信息安全专业。在校期间创办网络协会，组建创业团队，积累大量技术与实践经验。其主导研发的科技创新项目多次获省级、国家级奖项，曾受邀与多位政府领导会面，并接受中央电视台等权威媒体专题报道。现专注于信息安全领域科技创新，其创立的\"漏洞银行\"全球漏洞悬赏平台服务上海市上千家重要企事业单位，赢得众多知名企业信赖。"}, {"编号": 20250311506, "年份": 2021, "区局": "松江区", "姓名": "王晶", "年龄": 51, "姓名拼音": "Wang2-Jing1", "性别": "女", "工作单位": "上海聚威新材料股份有限公司", "工种或工作头衔": "改性塑料配方工艺", "领域": "新能源汽车", "行业": "材料", "工匠介绍": "王晶，上海聚威新材料股份有限公司首席技术官，在改性塑料配方及工艺研发领域具有深厚造诣。带领团队成功研发多款进口替代材料及国际首创新材料，包括新能源汽车加电小门用PA66/PPO合金材料等，打破国际垄断。疫情期间，她仅用一周时间研发出符合国家标准的防疫口罩熔喷布专用材料。曾获\"松江工匠\"、全国五一巾帼标兵、科技部创新创业人才等荣誉，并培养出多名优秀人才，其中有1人获评\"松江工匠\"。"}, {"编号": 20250311507, "年份": 2021, "区局": "青浦区", "姓名": "吴利荣", "年龄": 59, "姓名拼音": "Wu2-Li4-Rong2", "性别": "男", "工作单位": "上海市青浦区林业站", "工种或工作头衔": "林业", "领域": "林业", "行业": "林业", "工匠介绍": "吴利荣，作为林业战线的杰出代表，扎根一线36年，秉持“砥砺奋进、担当作为”的理念，带领团队推动青浦林业跨越式发展。他以科学理论为指导，认真落实习近平新时代中国特色社会主义思想，致力于生态文明建设，创新工作理念，精准施策，提升林业实效。在他的努力下，青浦区森林覆盖率从2004年的7.14%提升至2020年的15.16%，构建了“多层次、成网络、功能复合”的生态网络框架体系。他还致力于林下经济、生态保护与修复，助力乡村振兴。吴利荣始终牢记服务为民宗旨，深入基层，服务群众，帮助果农增产增收，推动生态文化村建设，切实增强群众生态获得感。"}, {"编号": 20250311508, "年份": 2021, "区局": "奉贤区", "姓名": "袁飞", "年龄": 49, "姓名拼音": "Yuan2-Fei1", "性别": "女", "工作单位": "上海奉锦环境建设管理有限公司", "工种或工作头衔": "污水处理", "领域": "人工智能", "行业": "环保", "工匠介绍": "袁飞，作为环境工程专业硕士、高级工程师，是中国环保品牌集群、中国水务技术委员会委员专家。她在污水处理领域深耕22年，以精湛技能和严谨态度，成功应对多次水质波动，通过技术改造和创新，确保系统平稳运行并节约成本800余万元。袁飞主持多项课题研究，将人工智能引入污水处理，推动行业进步。 she 指导年轻技术人才培养，所在团队获得国家科技进步二等奖、环境保护科学技术奖一等奖等荣誉。袁飞个人荣获水利工程 Bernard Award 二等奖等称号。"}, {"编号": 20250311509, "年份": 2021, "区局": "崇明区", "姓名": "黄春", "年龄": 57, "姓名拼音": "Huang2-Chun1", "性别": "男", "工作单位": "上海宝岛蟹业有限公司", "工种或工作头衔": "水产养殖", "领域": "水产", "行业": "水产", "工匠介绍": "黄春，中共党员，现任上海宝岛蟹业有限公司董事长、上海市河蟹行业协会会长。他致力于崇明清水蟹养殖技术研究，依托上海海洋大学等高校技术力量，构建了科学完善的清水蟹生态养殖体系。企业以河蟹规模化养殖、标准化加工和品牌销售为核心，开发河蟹文化旅游，推动一二三产业融合。黄春成功破解崇明河蟹养殖\"养不大\"难题，公司产品多次获全国农产品金奖，获绿色食品认证。他创建清水蟹文化基地，探索深加工产业链，助力崇明乡村振兴，带动周边100户农户增收，促进生态与产业协同发展。"}, {"编号": 20250311510, "年份": 2021, "区局": "机电", "姓名": "罗文林", "年龄": 37, "姓名拼音": "Luo2-Wen2-Lin2", "性别": "男", "工作单位": "上海电气集团上海电机厂有限公司", "工种或工作头衔": "车工", "领域": "高端装备", "行业": "机电", "工匠介绍": "罗文林，作为机械加工领域的技术骨干，凭借精湛的专业技能和创新精神，在核电设备和电机制造技术发展方面作出了突出贡献。他成功攻克核主泵电机主轴加工技术难题，打破了国外垄断，推动核电电机国产化进程；并创新工艺方法，解决了900R系列电机超长转轴加工技术难题，圆满完成了产品攻关任务；此外，他在51.2MW高炉风机同步电机项目中，通过自主研发新工艺，攻克了异型转轴加工技术难题，为企业发展和技术创新作出了重要贡献。罗文林以严谨工作态度和勇于创新的精神，在推动行业技术进步方面发挥了重要作用。"}, {"编号": 20250311511, "年份": 2021, "区局": "机电", "姓名": "王勇", "年龄": 45, "姓名拼音": "Wang2-Yong3", "性别": "男", "工作单位": "上海电气电站设备有限公司上海汽轮机厂", "工种或工作头衔": "数控机床工", "领域": "高端装备", "行业": "机电", "工匠介绍": "王勇，上海汽轮机厂燃机车间高级技师，多年来致力于百万火电汽轮机、核电汽轮机和燃气轮机等产品的加工制造及技术服务。他秉持\"创新是第一生产力\"的理念，解决数百项加工难题，优化工艺流程，创造500万元经济效益。申报发明专利1项、实用新型专利2项，完成200余项技术改进项目，发表20篇创新论文，编制1000余份数控加工程序，参与编写2份数控加工作业指导书。&#10;&#10;作为厂数控工作室副室长，王勇通过\"传、帮、带\"培养多名数控能手和工艺骨干，徒弟多人获厂级及集团荣誉，班组获\"全国质量信得过班组\"等多项称号。&#10;&#10;他先后获得上海市首席技师、闵行工匠、上海电气首席技师等荣誉，并受..."}, {"编号": 20250311512, "年份": 2021, "区局": "仪表电子", "姓名": "方逸洲", "年龄": 35, "姓名拼音": "Fang1-Yi4-Zhou1", "性别": "男", "工作单位": "上海仪电（集团）有限公司", "工种或工作头衔": "技术研发", "领域": "人工智能", "行业": "仪表电子", "工匠介绍": "方逸洲，“上海工匠”、仪电工匠，是人工智能与物联网领域的领军人才。作为\"工匠创新工作室\"负责人，他在智慧城市数字化转型和疫情防控中作出突出贡献，自主研发多项具有全国产化自主知识产权的核心技术与产品。他带领团队完成十余项科研项目，获专利授权3项，软件著作权3项，发表论文3篇。同时，他通过\"方逸洲工匠创新工作室\"开展技术培训交流，助力行业人才培养。方逸洲始终致力于推动科技进步和产业发展，是数字化转型的技术先锋。"}, {"编号": 20250311513, "年份": 2021, "区局": "医药", "姓名": "吴光昊", "年龄": 44, "姓名拼音": "Wu2-Guang1-Hao4", "性别": "男", "工作单位": "上海交联药物研发有限公司", "工种或工作头衔": "生物技术制药", "领域": "生物医药", "行业": "医药卫生", "工匠介绍": "吴光昊，中国药科大学微生物与生化药学硕士，现任上海交联药物研发有限公司副总经理。他在生物技术药物领域具有深厚造诣，带领团队攻克多项抗体偶联药物（ADC）生产技术壁垒，推动产品达到国际领先水平。吴光昊成功建立细胞发酵、抗体纯化、质量检验与控制、ADC生产等五大平台，协助集团组建抗体研发及产业化板块，并完成北方生产基地建设。他带领团队完成5个生物药项目临床前研究，获NMPA临床批件，其中3个项目已完成I期临床，2个项目即将开展II/III期试验。吴光昊发表多篇SCI文章，申请多项专利，为技术创新和知识产权保护作出重要贡献。"}, {"编号": 20250311514, "年份": 2021, "区局": "医药", "姓名": "于鸿晶", "年龄": 39, "姓名拼音": "Yu2-Hong2-Jing1", "性别": "女", "工作单位": "上海上药信谊药厂有限公司", "工种或工作头衔": "微生态研发", "领域": "生物医药", "行业": "医药卫生", "工匠介绍": "于鸿晶，致力于肠道菌群相关微生态药物的研发，主持了近20项生物一类新药开发项目，其中包括6项生物创新药研发，完成了国内首次微生态药物国际IND及一期临床研究。她带领的团队获得国家级奖励1项，上海市级奖励3项，发表SCl论文9篇，申报及授权发明专利12项。于鸿晶还承担了国家科技部重点专项、上海市科委项目等重大科研课题，培养了多名业务带头人。她曾荣获2020年度上海市国资委系统青年管理能手、2019年上海市科学技术奖技术发明一等奖等多项荣誉。"}, {"编号": 20250311515, "年份": 2021, "区局": "电力工业", "姓名": "夏杰", "年龄": 45, "姓名拼音": "Xia4-Jie2", "性别": "男", "工作单位": "上海送变电工程有限公司", "工种或工作头衔": "输变电", "领域": "高端装备", "行业": "电力", "工匠介绍": "夏杰，作为上海送变电工程有限公司的资深工程师，长期深耕电力工程领域，参与并负责了20余个大型变电工程项目，为上海电力工程建设做出了突出贡献。他主持了练塘特高压交流变电站、奉贤特高压直流换流站等多个标志性项目，其中练塘站输电能力可满足上海四分之一的用电需求，减排效应显著。夏杰在技术难题攻关和创新成果形成方面表现卓越，推动了软母线精确测量技术、GIS设备安装质量控制技术等关键技术的突破，并主持开发了电力施工工艺卡系统等数字化工具，其中施工机械物联感知系统已被国网公司纳入推广计划。他主持的多个工程荣获国家优质工程金质奖、鲁班奖等重要奖项，个人也曾获上海市总工会\"工人先锋号\"称号，并创建上海电力..."}, {"编号": 20250311516, "年份": 2021, "区局": "宝武", "姓名": "李斌", "年龄": 56, "姓名拼音": "Li3-Bin1", "性别": "男", "工作单位": "宝钢资源控股有限公司马迹山港分公司", "工种或工作头衔": "港口机械设备点检", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "李斌，是宝钢马迹山港的一名高级机械技师，在大型港机设备及输送机组维护方面做出了突出贡献。他带领团队攻克200余项生产难题，创造经济效益超过1.8亿元。李斌创新研发的多极磁辊消磁技术和钢丝输送带无损翻身技术，解决了行业难题，获冶金部科技进步一等奖、法国巴黎国际发明展金奖等荣誉。他拥有国家专利83项，培养了包括全国劳模在内的36名技能人才。李斌先后荣获宝钢工人发明家、上海市劳模等称号。"}, {"编号": 20250311517, "年份": 2021, "区局": "宝武", "姓名": "缪伟良", "年龄": 62, "姓名拼音": "Mou2-Wei3-Liang2", "性别": "男", "工作单位": "宝山钢铁股份有限公司炼铁厂", "工种或工作头衔": "炉体维护", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "缪伟良,高级技师,现任宝钢股份炼铁厂高炉炉体维护技能大师。他扎根高炉维护一线,潜心钻研技术,开发了高炉炉缸热电偶系列修复检测技术,解决行业难题。缪伟良拥有17项发明专利和21项实用新型专利,带领团队完成12项集团技术支撑项目。他培养徒弟36名,其中3名成为技能大师、2名获评工匠称号。缪伟良创新工作室获上海市先进操作法创新奖,并被评为宝武集团“示范型”创新工作室。他个人先后荣获上海市科技进步三等奖、上海市“五一”劳动奖章、巴黎国际发明展奖金奖,并享受国务院政府津贴。缪伟良致力于技术传承与创新,为冶金行业绿色低碳发展做出积极贡献。"}, {"编号": 20250311518, "年份": 2021, "区局": "宝冶集团", "姓名": "路兴隆", "年龄": 40, "姓名拼音": "Lu4-Xing1-Long2", "性别": "男", "工作单位": "上海宝冶集团有限公司国际工程公司", "工种或工作头衔": "土木工程", "领域": "土地混合利用", "行业": "钢铁冶金", "工匠介绍": "路兴隆，作为高端主题乐园建设领域的杰出代表，致力于推动中国主题公园技术的创新发展。他成功参与了上海世博会、上海迪士尼和北京环球影城等标志性项目的建设工作。在\"创极速光轮\"和\"变形金刚\"主题园区建设中，他攻克了多项技术难题，实现了全球最快、最高、最长复杂游艺设备安装技术以及超平地面和游乐设施精准安装关键技术的突破。在国内首次将BIM正向深化设计方法应用于主题乐园建设，并创新性地完成了一次性设计工作。在上海迪士尼乐园，他成功应用建筑外露钢结构涂装技术，在北京环球影城项目中实现了GFRC板高光泽度汽车漆效果的创新突破，显著节约工期和成本。凭借精湛技艺和匠心品质，其主导的迪士尼主题乐园项目荣获鲁..."}, {"编号": 20250311519, "年份": 2021, "区局": "宝冶集团", "姓名": "张平", "年龄": 42, "姓名拼音": "Zhang1-Ping2", "性别": "男", "工作单位": "上海宝冶集团有限公司工业工程公司", "工种或工作头衔": "电工", "领域": "人工智能", "行业": "钢铁冶金", "工匠介绍": "张平，电气设备调试师，全国技术能手，中国设备管理协会冶金行业分会副会长。参与国家\"一带一路\"越南河静炼钢项目，突破技术限制，一周完成11000余个PLC接口和1500多条动力电源线路连接。解决宝钢、邯钢等项目电气故障，为公司挽回经济损失1050余万元。主导《人工智能与虚拟现实技术在供配电领域的研究和应用》等科技项目，创新供配电运维模式，实现无人值守可视化管理。主编两项企业标准，完成三项工法及专利发明。其钢厂绿色搬迁设备再利用技术为钢厂节省资金507万元，宝钢湛江GIS扩容试验节省203万元，取得显著经济效益。"}, {"编号": 20250311520, "年份": 2021, "区局": "航天局", "姓名": "龚雄", "年龄": 54, "姓名拼音": "Gong1-Xiong2", "性别": "男", "工作单位": "上海航天设备制造总厂有限公司", "工种或工作头衔": "飞机钣金工", "领域": "空间信息", "行业": "航天", "工匠介绍": "龚雄，中国航天科技集团公司特级技师、航天八院首席技师、上海市技能大师工作室带头人、钣金领军人才。在31年的职业生涯中，他参与多项运载火箭及飞行器钣金产品研发，攻克薄壁精确塑性成形、框环精确拉弯成形等关键技术难题。作为技能大师工作室带头人，他带领团队研发创新型压弯成形模具，解决贮箱高筋网格壁板成形易开裂难题，创新提出\"合理布局余量区加强筋+液压校正辅助成形\"工艺方法，有效解决薄壁防晃板类零件淬火变形问题。同时，他积极参与技能人才培养工作，编写岗位培训教材，开展专业技能培训。龚雄先后获得中国航天科技集团公司航天技术能手、上海市技术能手、上海市首席技师千人资助计划及上海市闵行当代工匠等多项荣誉。"}, {"编号": 20250311521, "年份": 2021, "区局": "航天局", "姓名": "陆鸣伟", "年龄": 47, "姓名拼音": "Lu4-Ming2-Wei3", "性别": "男", "工作单位": "上海飞奥燃气设备有限公司", "工种或工作头衔": "燃气装备设计", "领域": "空间信息", "行业": "航天", "工匠介绍": "陆鸣伟，作为天然气输配系统领域的专家，深耕行业19年，从基层岗位成长为总工程师，主导开发了多项填补国内技术空白的核心产品，如智能化远距离调控燃气项目、应急燃气调压设备等。他攻克了燃气调压器多项行业难题，获4项专利授权，其中1项获上海市优秀发明专利奖。主持研发的RX/S2智能燃气调压站获中燃协\"匠心奖\"。在\"一带一路\"中俄天然气装备项目中，完成1.6亿合同额的国际市场订单。他参与编制了4项国家和行业标准，培养智慧工匠1名、高级工程师2名，并创建了上海市\"郭越创新工作室\"。"}, {"编号": 20250311522, "年份": 2021, "区局": "航天局", "姓名": "吴毓颖", "年龄": 42, "姓名拼音": "Wu2-Yu4-Ying3", "性别": "女", "工作单位": "上海航天电子技术研究所", "工种或工作头衔": "微组装", "领域": "空间信息", "行业": "航天", "工匠介绍": "吴毓颖，作为微组装技术领域的专家，主持编制了《系统级封装结构与互连设计规范》《热超声楔焊工艺规范》等工艺文件，并在有源相控阵雷达收发组件研制工作中攻克多项工艺难题。作为上海市职工（巾帼）创新工作室领衔人，她培养了多名微组装技术专业人才，带领团队获得全国优秀质量管理小组、航天金牌班组等38项荣誉。曾获中国航天科技集团优秀共产党员、上海航天局青年岗位能手及三八红旗手标兵等多项荣誉称号。"}, {"编号": 20250311523, "年份": 2021, "区局": "船舶", "姓名": "王忠平", "年龄": 56, "姓名拼音": "Wang2-Zhong1-Ping2", "性别": "男", "工作单位": "沪东中华造船（集团）有限公司", "工种或工作头衔": "船舶电焊", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "王忠平，焊接专家，从事焊接工作34年，参与了多型船舶及重大工程的焊接任务，攻克多项技术难题。他创新CO2焊单面衬垫焊技术，提升焊接质量，编写《船舶电焊工》教材并开展培训，技术论文多次获奖。王忠平获多项荣誉，包括上海市技术能手、全国技术能手、国务院特殊津贴等，并主持船舶焊接质量攻关工作，为船舶工业发展作出突出贡献。"}, {"编号": 20250311524, "年份": 2021, "区局": "船舶", "姓名": "任永辉", "年龄": 38, "姓名拼音": "Ren4-Yong3-Hui1", "性别": "男", "工作单位": "上海外高桥造船有限公司", "工种或工作头衔": "船舶管系", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "任永辉,上海外高桥造船有限公司高级技师,从技校生成长为船舶管系工专家。他多次荣获\"全国技术能手\"\"上海市五一劳动奖章\"\"上海市劳模\"等称号,并享受国务院特殊津贴。他创新工艺标准,编制《作业标准书》和《工艺手册》,研发\"靠模弯头数据参照表\"等工具,提升工作效率。同时,他热心传技,担任船舶管系专业教师,培养技能人才。任永辉表示将继续提升技能,为企业高质量发展做贡献。"}, {"编号": 20250311525, "年份": 2021, "区局": "汽车", "姓名": "沈睿君", "年龄": 43, "姓名拼音": "Shen3-Rui4-Jun1", "性别": "男", "工作单位": "上海汽车工业销售有限公司", "工种或工作头衔": "汽车维修", "领域": "汽修服务", "行业": "汽车", "工匠介绍": "沈睿君，现任上汽销售（荣威）技术总监，拥有二十二年汽车维修经验，是高级技师、检测工程师和职业技能高级考评员。他主编新能源诊断流程与案例，首创初步诊断六步法，解决了多项疑难问题，并获国家发明专利。沈睿君参与上海市汽车技能大赛新能源题库开发，多次代表上海市技师协会汽车专业委员会开展对口援疆项目，送教上门。他带领团队成立上汽销售创新工作室，致力于新能源车辆维修技术工人梯队建设，组织开展上汽销新能源练兵比武、师徒带教等活动，其工作室被评为上汽第88个创新工作室，并荣获2018年上汽工匠称号，团队于2020年获得上汽优秀售后技术团队和上海市五一劳动奖状集体。沈睿君荣获“国家交通运输部全国交通技术能..."}, {"编号": 20250311526, "年份": 2021, "区局": "汽车", "姓名": "薛峰", "年龄": 53, "姓名拼音": "Xue1-Feng1", "性别": "男", "工作单位": "上汽通用汽车有限公司", "工种或工作头衔": "汽车维修", "领域": "汽车", "行业": "汽车", "工匠介绍": "薛峰，上汽通用汽车销售有限公司售后现场技术经理，中国汽车维修行业协会技术标准化委员会副主任委员，全国技术能手，高级技师，注册工程师。从事汽车维修工作以来，他潜心钻研技术，精通传统和新能源汽车动力总成、车身电器、维修编程，并改进维修编程远程支持方案。2005年获全国首届汽车装调工职业技能大赛第一名，2006年荣获全国技术能手称号。他还参与编制职业技能考核大纲和试题库，2020年参与开发教育部汽车装调工1+X等级证书。2013－2019年间多次担任全国中职汽车运用与维修大赛、全国交通行业职业技能大赛命题专家和裁判长，获高度认可。"}, {"编号": 20250311527, "年份": 2021, "区局": "华虹", "姓名": "李冰寒", "年龄": 49, "姓名拼音": "Li3-Bing1-Han2", "性别": "男", "工作单位": "上海华虹宏力半导体制造有限公司", "工种或工作头衔": "闪存产品研发", "领域": "集成电路", "行业": "集成电路", "工匠介绍": "李冰寒,作为华虹宏力技术骨干，长期专注于非易失性存储器工艺研发与创新。他主导开发了0.25微米至55纳米嵌入式闪存和标准闪存工艺平台，累计实现晶圆出货超200万片，芯片出货突破100亿颗。其研发的产品广泛应用于消费电子、工业控制及汽车电子领域，并远销欧美。&#10;&#10;李冰寒主导开发的0.13微米、0.18微米嵌入式闪存工艺分别获上海市科技进步奖一等奖和二等奖，0.11微米嵌入式闪存在物联网、汽车电子等领域广泛应用，90纳米嵌入式闪存平台采用自主知识产权NORD闪存单元技术，成为全球最小闪存单元。他主持国家02专项及上海市国资委、工信部等重点科技任务，培养大批专业人才，并创造显著经..."}, {"编号": 20250311528, "年份": 2021, "区局": "华虹", "姓名": "魏峥颖", "年龄": 46, "姓名拼音": "Wei4-Zheng1-Ying3", "性别": "男", "工作单位": "华虹集团上海华力微电子有限公司", "工种或工作头衔": "芯片制造", "领域": "集成电路", "行业": "集成电路", "工匠介绍": "魏峥颖，作为华虹集团副总裁、五厂厂长，在集成电路领域取得卓越成就。他主导55纳米工艺开发及产业化，推动国内集成电路产业链发展，积极推广国产机台和材料。作为智能制造引领者，他主持华虹五厂大数据系统建设，自主研发智能管理平台。华虹五厂现年产45万片，达国际一流水平，获2015~2019年度上海市劳模集体称号。魏峥颖荣获多项荣誉：2013年上海市重大工程立功竞赛\"优秀建设者\"，2015年55纳米核心技术获上海市优秀发明金奖，2017年上海市智慧城市建设\"领军先锋\"，2019年带领团队获上海市工人先锋号。"}, {"编号": 20250311529, "年份": 2021, "区局": "化学工业区", "姓名": "侯秋实", "年龄": 54, "姓名拼音": "Hou2-Qiu1-Shi2", "性别": "男", "工作单位": "上海寰球工程有限公司", "工种或工作头衔": "研发人员", "领域": "先进材料", "行业": "化工", "工匠介绍": "侯秋实，作为煤化工、氟化工、高分子及碳一化工领域的专家，长期致力于化学科研与化工工程的研发，凭借扎实的计算机模拟能力、卓越的科研开发能力和丰富的装置设计经验，不断推动企业技术进步与创新发展。他主持完成大飞机特种上浆剂、聚丙烯催化剂、混合芳烃项目等多项重大科研课题，编制多项工艺包并荣获\"先进科技工作者\"\"岗位能手\"\"劳动模范\"等称号。作为国家注册一级石油化工专业建造师，他不仅在专业领域具有权威地位，还拥有二十余项专业论著与发明专利。"}, {"编号": 20250311530, "年份": 2021, "区局": "铁路局", "姓名": "沈杰", "年龄": 47, "姓名拼音": "Shen3-Jie2", "性别": "男", "工作单位": "中国铁路上海局集团有限公司上海机车检修段", "工种或工作头衔": "电力机车钳工", "领域": "轨道交通", "行业": "铁路", "工匠介绍": "沈杰，现任国铁集团上海局“上铁工匠”，是电力机车检修领域的技术骨干和技能传承者。他带领团队攻克了5项技术难题，其中《DSA-200型受电弓气囊分解组装工艺研究》项目为单位节省检修成本170余万元，自主研发的旋风式除尘单元免拆复位专用工具累计节省成本105万元。沈杰主导的《HXD1系电力机车旋风式除尘单元免拆复位专用工具》等7项工装获国家专利，并参与多项科研项目。在人才培养方面，他累计授课1682课时，编制多部培训教材，培养出11名全路技术能手、4名技师（高级技师）和18名高级技术骨干。"}, {"编号": 20250311531, "年份": 2021, "区局": "港务", "姓名": "李惠卿", "年龄": 43, "姓名拼音": "Li3-Hui4-Qing1", "性别": "男", "工作单位": "上港集团宜东分公司", "工种或工作头衔": "设备维修", "领域": "港口", "行业": "港务", "工匠介绍": "李惠卿，自2001年起在上港集团工作，从设备维修工逐步成长为工程技术部副经理，积累了丰富的集装箱码头装卸机械维修管理经验。他两次荣获上港集团技能大赛电气修理项目第一名，被评为上海市杰出技术能手，并于2019年获得国务院政府特殊津贴。李惠卿创新性地将锂电池组混合动力系统应用于轮胎吊，实现节油率64%，填补了上海港该领域空白。作为“李惠卿首席技师工作室”负责人，他带领团队完成30余项创新项目，主持制定企业标准，获得多项专利，其中两项创新分别获中国（上海）国际发明创新展览会金奖和中国港口协会科技进步奖。他编写《维修作业手册》并培养了16名高级技师、56名高级工。"}, {"编号": 20250311532, "年份": 2021, "区局": "运输", "姓名": "顾云峰", "年龄": 40, "姓名拼音": "Gu4-Yun2-Feng1", "性别": "男", "工作单位": "上海交运集团股份有限公司汽车零部件制造分公司", "工种或工作头衔": "模具", "领域": "汽修服务", "行业": "汽车", "工匠介绍": "顾云峰，模具专业毕业，自2000年起在交运公司从事模具研发工作，16年间凭借专业技能取得显著成就。2006年参与GF6自动离合器项目，2014年在GFX项目中创新采用模具滚压成形技术，获得实用新型专利，为公司节省600余万元开发费用。2016年成功攻克离合器钢片精冲模具国产化难题，为企业节省150万元模具费用。2017年在三管项目中带领团队突破内高压成形管技术，节省模具采购费用334万元。"}, {"编号": 20250311533, "年份": 2021, "区局": "移动通信", "姓名": "鲍伟华", "年龄": 43, "姓名拼音": "Bao4-Wei3-Hua2", "性别": "男", "工作单位": "中国移动通信集团上海有限公司", "工种或工作头衔": "通信工程师", "领域": "人工智能", "行业": "通信", "工匠介绍": "鲍伟华，作为公司首批3G和4G移动通信网专家，技术功底深厚，科研攻关能力强，在信令风暴管控和VoLTE核心网容灾等核心技术领域取得突破性进展，授权2件国内发明专利，并获得公司科技进步奖。他主持开发了3个网络故障和客户投诉自动化处理系统，使工作效率较人工处理提升95%以上，同时发表了5篇论文。&#10;&#10;在5G行业应用领域，