2025-05-15 07:48:37,441 ChatBI->     INFO     websocket发送的数据为：{"data_detail": [{"编号": 20250311001, "年份": 2016, "区局": "浦东新区", "姓名": "蒋国兴", "年龄": 60, "姓名拼音": "Jiang3-Guo2-Xing1", "性别": "男", "工作单位": "上海供春陶业有限公司", "工种或工作头衔": "陶艺师", "领域": "文化", "行业": "工艺美术", "工匠介绍": "蒋国兴，全国劳动模范、全国五一劳动奖章获得者，享受国务院政府特殊津贴专家。他荣获“民进全国社会服务工作先进个人”“上海市十大职工科技创新英才”“上海市首席技师”等称号，其工作室被命名为“上海市技能大师工作室”并获“全国工人先锋号”。在彩陶技艺领域，他突破多项传统工艺难题，开创具有海派特色的“沪上彩陶”技艺，并发明陶瓷壁挂，被联合国教科文组织国际陶艺学会命名为“蒋国兴”。其作品应用于上海东方艺术中心、上海世博园等重要建筑，获国家专利45项。他还将彩陶技艺用于古建筑修复，解决世界性难题。此外，他热衷技艺传承，培养多名徒弟，参与国际展览和学术研究，出版专著并撰写多篇论文，为陶瓷文化发展作出突出贡献。"}, {"编号": 20250311002, "年份": 2016, "区局": "浦东新区", "姓名": "朱海鸿", "年龄": 52, "姓名拼音": "Zhu1-Hai3-Hong2", "性别": "男", "工作单位": "上海优爱宝机器人技术有限公司", "工种或工作头衔": "机器人研发设计", "领域": "智能机器人", "行业": "高端装备", "工匠介绍": "朱海鸿，国内机器人领域杰出代表，拥有国际领先的机器人设计理念和技术。他曾在国内外知名机构从事机器人研发工作十余年，专注机器人控制理论与技术方法研究，参与完成多项大型项目，拥有国际国内发明专利9项，发表学术报告及文章11篇。2005年赴美创立Sentrinsic有限责任公司，后回国创办上海优爱宝智能机器人科技股份有限公司，带领团队开发出SCARA和Delta工业机器人、浮球矩阵等产品，赢得业界广泛关注。作为技术总监，朱海鸿博士以身作则，坚持学习，善于分享，致力于解决核心技术难题，将领先技术与管理经验带回祖国，在优爱宝平台上实现理想。"}, {"编号": 20250311003, "年份": 2016, "区局": "浦东新区", "姓名": "高金明", "年龄": 60, "姓名拼音": "Gao1-Jin1-Ming2", "性别": "男", "工作单位": "玛戈隆特骨瓷(上海)有限公司", "工种或工作头衔": "造型研发", "领域": "文化", "行业": "工艺美术", "工匠介绍": "高金明，毕业于河北唐山陶瓷技校，后进入唐山第一瓷厂工作，历任多项职务，长期致力于陶瓷工艺技术改造和管理。他曾主持新建年产300万件高级骨质瓷生产线，并参与新产品研发，设计开发数百个新产品。在G20产品赶制期间，他坚守一线，解决技术难题，全身心投入工作。他的努力为玛戈隆特骨瓷和国家争光，获得高度评价。"}, {"编号": 20250311004, "年份": 2016, "区局": "浦东新区", "姓名": "杨震", "年龄": 55, "姓名拼音": "Yang2-Zhen4", "性别": "男", "工作单位": "上海高桥捷派克石化工程建设有限公司", "工种或工作头衔": "维修钳工", "领域": "高端装备", "行业": "高端装备", "工匠介绍": "杨震，上海高桥捷派克石化工程建设有限公司维修钳工，是设备修理、技术创新和团队培养领域的杰出代表。他成功修复了多台复杂设备，自制多种专用工具，并通过技术改造为公司节省大量成本。杨震培养了多名优秀技能人才，带领团队荣获“工人先锋号”称号。他以“铁人”般的工作作风和强烈责任感，获得全国五一劳动奖章和全国技术能手等多项荣誉，是新时代工匠精神的典范。"}, {"编号": 20250311005, "年份": 2016, "区局": "徐汇区", "姓名": "徐培成", "年龄": 68, "姓名拼音": "Xu2-Pei2-Cheng2", "性别": "男", "工作单位": "上海市徐汇区牙病防治所", "工种或工作头衔": "医生", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "徐培成，上海市徐汇区牙病防治所所长，主任医师，享受国务院特殊津贴专家。他是中华口腔医学会多个专业委员会常委或委员，主编多部医学专著，并发表科研论文20余篇。他荣获上海医学科技三等奖、上海市科技进步三等奖等多项奖项，主编的科普著作和科教片广受好评。作为医院管理者，他将全院纳入ISO管理，并筹建高水平口腔专科医院。他先后获得上海市十大工人发明家、上海市劳动模范、全国五一劳动奖章、全国劳动模范等荣誉称号，2008年任北京奥运火炬手。徐培成在医学专业、学科建设和医院管理方面均取得了卓越成就。"}, {"编号": 20250311006, "年份": 2016, "区局": "徐汇区", "姓名": "王海斌", "年龄": 53, "姓名拼音": "Wang2-Hai3-Bin1", "性别": "男", "工作单位": "上海徐房房屋维急修中心", "工种或工作头衔": "水电", "领域": "居民服务", "行业": "物业", "工匠介绍": "王海斌，现任上海徐房房屋维急修中心党支部书记、主任，并兼任徐汇区劳模协会会长。作为资深工匠，他从基层水电维修工做起，成长为行业领军人才，并入选上海首批房管行业领军人才培养计划。他带领团队承担徐汇区3040万平方米居住物业的应急维修任务，2010年被授予\"全国劳动模范\"称号。他依托\"王海斌劳模创新工作室\"，研究房屋水电设备疑难杂症，总结\"判、听、看、探、定\"五步工作法，荣获\"上海市职工先进操作法优秀成果奖\"。他还创新节水型屋顶水箱清洗操作方法，获上海市物业管理行业\"金点子\"创新成果入围奖，并推动\"互联网+\"技术应用，研发\"宅维修\"APP，提升维修效率75%。他培养了1名上海市劳动模范、2名..."}, {"编号": 20250311007, "年份": 2016, "区局": "徐汇区", "姓名": "吴颖健", "年龄": 50, "姓名拼音": "Wu2-Ying3-Jian4", "性别": "男", "工作单位": "万达信息股份有限公司", "工种或工作头衔": "系统集成", "领域": "系统建设", "行业": "信息", "工匠介绍": "吴颖健，教授级高级工程师，工信部高级项目经理，长期专注于城市信息化集成领域。他主持完成了数十个大型信息化系统项目，尤其擅长异构系统集成设计。作为主要设计者，他完成了上海市医保系统项目，首次采用三层架构，实现医疗费用实时结算，覆盖全部参保人群，项目荣获上海市科学技术进步奖一等奖两次。他精通各类软硬件产品应用，在民生信息系统运行保障方面表现突出，多次解决系统疑难问题，确保民生工程稳定运行。吴颖健拥有五项授权发明专利，其中三项应用于上海医保三期工程，成果达国内首创、国际先进水平，获上海科技情报研究所查新检索确认。他担任公司总工程师，培养中高级技术人员数十人，多次获得企业表彰。"}, {"编号": 20250311008, "年份": 2016, "区局": "长宁区", "姓名": "陶巍", "年龄": 70, "姓名拼音": "Tao2-Wei1", "性别": "男", "工作单位": "上海幼狮汽车销售服务有限公司", "工种或工作头衔": "汽车修理师", "领域": "汽修服务", "行业": "汽车", "工匠介绍": "陶巍，长期致力于汽车维修技术理论的研究与应用，积极推广国际化汽车维修理念，开拓现代汽车维修领域的技术创新，倡导汽车运用性文化工程，填补了多项维修技术空白，为改善中国进口汽车维修难题做出了突出贡献。他先后获得\"中外名人、世界优秀人才证书\"，享受国务院特殊津贴、上海市政府特殊津贴，并荣获上海市优秀技师、优秀高级考评员、国家级汽车维修技能大师、上海市汽车维修首席大师、上海市劳模、新长征突击手、技术能手等荣誉称号。2013年被授予全国消费维权楷模称号，2013—2014年度及2015年度均荣获\"最美消费维权人物\"称号。他还作为总统座车的紧急修理值班技师，成功排除了克林顿总统专车故障，修复过日本天..."}, {"编号": 20250311009, "年份": 2016, "区局": "普陀区", "姓名": "刘根敏", "年龄": 56, "姓名拼音": "Liu2-Gen1-Min3", "性别": "男", "工作单位": "上海英雄金笔厂", "工种或工作头衔": "技工", "领域": "金笔制作", "行业": "工艺美术", "工匠介绍": "刘根敏,作为模具工艺领域的技术骨干,凭借勤学苦练和踏实工作,掌握了设备维修、模具调试与修理等核心技能,并总结出独特的工作方法。他所在的部门负责钢笔笔尖的第一道工序,其造型及质量直接影响整个钢笔笔尖的品质。在厂部和车间领导的支持下,他对部分设备零部件进行了优化改进,使操作更加便捷,有效提升了产品品质和生产效率。&#10;&#10;在加工高精度笔尖时,误差要求严格控制在几丝之内,尤其是金笔尖的加工难度更大。1997年,在香港回归纪念金笔尖的生产过程中,他遇到了商标打制偏差的问题。经过反复改进,他设计出多功能模板,成功将商标打制误差降至最低。&#10;&#10;在香港回归金笔尖试制阶段,笔尖腰..."}, {"编号": 20250311010, "年份": 2016, "区局": "普陀区", "姓名": "黄卫国", "年龄": 66, "姓名拼音": "Huang2-Wei4-Guo2", "性别": "男", "工作单位": "普陀区房屋维修应急中心", "工种或工作头衔": "水电工", "领域": "居民服务", "行业": "物业", "工匠介绍": "黄卫国，市劳动模范，资深水电工。从业三十余年，秉持\"把平凡的事做好就不平凡\"的理念，在水电维修领域深耕细作。他通过结对拜师学艺活动，将丰富实践经验传授给年轻员工，发挥劳模示范引领作用。在工作中，他善于解决实际问题，展现精湛技术。例如，他用其他材料制作销子成功修复老式虹吸水箱，解决装修施工遗留问题，保障业主利益。他定期组织技术培训，培养技能过硬的维修队伍，传承徐虎精神，为企业培养大批技术骨干。黄卫国以实际行动诠释劳模责任，用精湛技术和无私奉献赢得广泛认可。"}, {"编号": 20250311011, "年份": 2016, "区局": "杨浦区", "姓名": "施泽凇", "年龄": 53, "姓名拼音": "Shi1-Ze2-Song1", "性别": "男", "工作单位": "上海尤埃建筑设计有限公司", "工种或工作头衔": "建筑设计师", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "施泽凇，国家一级注册建筑师，高级建筑师，拥有20余年从业经历，参与并负责多个复杂、大体量建筑项目的设计与管理。作为核心成员，他参与设计的上海翡丽云邸项目获\"上海绿色建筑贡献（项目）奖\"，虹桥世界中心项目获中国地产设计大奖优秀奖，绿地黄埔滨江项目获国际房地产高层商办建筑项目奖项。施泽凇以卓越的设计理念、创新思维和专业实践在建筑领域享有盛誉。"}, {"编号": 20250311012, "年份": 2016, "区局": "黄浦区", "姓名": "陆亚明", "年龄": 57, "姓名拼音": "Lu4-Ya4-Ming2", "性别": "男", "工作单位": "上海豫园旅游商城股份有限公司绿波廊酒楼", "工种或工作头衔": "中式面点", "领域": "餐饮", "行业": "餐饮", "工匠介绍": "陆亚明，扎根中式面点技艺三十余年，探索出\"融汇贯通、创新面团、馅要多味、营养健康、形要活脱\"的核心理念。他改良传统寿桃制作工艺，创新象形模具，使点心造型更加生动。同时，开发出麻辣、菜肉等新口味蟹粉小笼，并研制二十款创新点心。为传承技艺，他在绿波廊创立\"陆亚明国宴点心工作室\"，培养出多名技术骨干。2014年亚信峰会期间，他指导弟子设计制作的\"事事如意\"点心宴获好评。多年来，陆亚明与团队圆满完成了多项重要接待任务，为推广中华美食文化做出突出贡献。"}, {"编号": 20250311013, "年份": 2016, "区局": "黄浦区", "姓名": "沈国兴", "年龄": 57, "姓名拼音": "Shen3-Guo2-Xing1", "性别": "男", "工作单位": "上海老凤祥有限公司", "工种或工作头衔": "金银细工传承人", "领域": "文化", "行业": "工艺美术", "工匠介绍": "沈国兴，百年老字号企业老凤祥的高级技师，中国非物质文化遗产\"金银细工\"制作技艺的第六代传承人。他以深厚功力、创新才能和中坚作用，成为传统工艺的杰出代表。沈国兴设计制作了众多顶尖工艺精品，包括12公斤的观音金佛像、《静安寺法僧三宝印》、《八仙神葫》等，其中《八仙神葫》获\"天工艺苑百花杯\"金奖。他修复了多件国家二级文物珍宝，并培养了五位制作高手，为传统技艺的传承和发展作出了重要贡献。"}, {"编号": 20250311014, "年份": 2016, "区局": "黄浦区", "姓名": "陈林兴", "年龄": 67, "姓名拼音": "Chen2-Lin2-Xing1", "性别": "男", "工作单位": "上海新人民摄影有限公司", "工种或工作头衔": "摄影", "领域": "文化", "行业": "工艺美术", "工匠介绍": "陈林兴，人像整修师。在工作中勤恳敬业、一丝不苟，凭借对专业的热爱与执着追求，多次在行业技术比武中荣获第一名，并于1995年考评为国家级高级技师。他在长期实践中秉持专业、精湛的服务理念，成功修复了多张具有重要历史意义的老照片，其中最具代表性的是为毛主席随身摄影师钱嗣杰老先生修复的历史旧照，这些照片被录入《毛主席回忆录》出版。他还修复了浦东王阿姨珍藏的一张严重损坏的全家福，此事经媒体报道后广受关注。2015年，其传统人像修片工艺被上视纪实频道《上海100》纪实片拍摄并多次播放。他还通过言传身教培养了大批优秀徒弟和学生，为摄影、人像修片行业输送了大量人才。"}, {"编号": 20250311015, "年份": 2016, "区局": "黄浦区", "姓名": "陆耔豪", "年龄": 46, "姓名拼音": "Lu4-Zi3-Hao2", "性别": "男", "工作单位": "上海正章实业有限公司（个人自荐）", "工种或工作头衔": "洗衣师", "领域": "文化", "行业": "洗涤", "工匠介绍": "陆籽豪, 上海正章实业有限公司高级技术主管、织补绝技传承人。他1999年加入老字号企业正章, 坚持传承织补这一濒临失传的传统技艺, 并将其发展为精细化标准工艺, 在约一平方厘米的破洞上可织补120-180根经纬丝, 修复的衣物、文物、地毯及古字画在业内享有盛名。2012年, 他在正章淮海路总店成立首席技师工作室, 从事面料织补和皮革无痕修复新工艺研发, 并编写《织补技法》作为行业培训教材。陆籽豪曾荣获2011年全国银奖、2012年\"上海商业优质服务先进个人\"、2014年\"上海商业技术能手\"、2015年全国金奖及\"全国技术能手\"称号, 为传统技艺的传承与发展做出了突出贡献。"}, {"编号": 20250311016, "年份": 2016, "区局": "静安区", "姓名": "吴德昇", "年龄": 63, "姓名拼音": "Wu2-De2-Sheng1", "性别": "男", "工作单位": "上海现代钟表珠宝商会吴德昇工作室", "工种或工作头衔": "玉石雕刻", "领域": "文化", "行业": "工艺美术", "工匠介绍": "吴德昇，中国工艺美术大师、中国玉石雕刻大师。从事玉雕四十余年，融合中西雕塑技法，专长立体雕，尤以玉雕人体艺术见长。作品屡获“天工奖”“百花奖”等国内外顶级奖项。积极参与中外文化交流，主持《首届中国玉文化世界巡展》等国际展览，助推中国传统文化“走出去”。同时注重传承，培养多名国家级玉雕人才，为行业发展作出重要贡献。"}, {"编号": 20250311017, "年份": 2016, "区局": "静安区", "姓名": "肖文浩", "年龄": 68, "姓名拼音": "Xiao4-Wen2-Hao4", "性别": "男", "工作单位": "上海亨生西服有限公司", "工种或工作头衔": "服装裁剪制作", "领域": "文化", "行业": "纺织服装", "工匠介绍": "肖文浩，国家级非物质文化遗产项目奉帮裁缝技艺代表性传承人，上海市非物质文化遗产项目亨生奉帮裁缝技艺代表性传承人，上海市商业系统技术能手。他一生致力于奉帮裁缝技艺的传承与创新，师从著名设计师林瑞祥，精通\"四功\"技艺，主持设计的中西合璧男式披肩为行业典范。近年来，肖文浩积极投身非遗传承人才培养，担任特聘教师并参与纪录片拍摄，为培养新一代非遗传承人作出重要贡献。"}, {"编号": 20250311018, "年份": 2016, "区局": "宝山区", "姓名": "朱臻原", "年龄": 55, "姓名拼音": "Zhu1-Zhen1-Yuan2", "性别": "男", "工作单位": "上海二十冶建设有限公司", "工种或工作头衔": "电气调试", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "朱臻原，长期从事电气调试工作，参与了宝钢制氧工程、硅钢轧机机组、益昌薄板厂酸洗线等多个重大项目的建设。他在工作中展现出了卓越的专业技能和创新能力，通过技术革新大幅提升工作效率。在解决电动机绕线模具设计、电焊机修复工艺优化等技术难题中表现突出，获破格提拔为班长并晋级。作为制氧工程试车副总指挥，他成功指挥从单体试车到产品产出的全过程，展现了出色的组织协调能力。在硅钢工程和益昌薄板酸洗线项目中，他攻克多项技术难关，获得日方和甲方的高度评价。凭借对新技术的持续探索和大胆创新，他在电气调试领域成为技术能手，为企业赢得多项荣誉。"}, {"编号": 20250311019, "年份": 2016, "区局": "闵行区", "姓名": "胡振球", "年龄": 40, "姓名拼音": "Hu2-Zhen4-Qiu2", "性别": "男", "工作单位": "上海神舟汽车节能环保股份有限公司", "工种或工作头衔": "电焊工", "领域": "绿色低碳", "行业": "汽车", "工匠介绍": "胡振球，长期从事机械设计加工及钣金工等工作，专业能力突出，技术成果丰硕。他取得高级技师职称，并多次荣获上海市农民工先进个人、闵行区工人发明家、全国劳动模范等称号。胡振球在技术革新方面表现卓越，完成技术革新50余项，获得发明专利14项，其中\"吸尘车整车预装工装\"改进使装配工期缩短至1天，整车装配合格率达98%以上，每年为企业节约成本560多万元。他研发的纯吸式道路吸尘车大幅提升了清洁效率，首创的\"卸料抑尘装置技术\"和\"吸尘车树叶粉碎技术\"解决二次扬尘及树叶处理难题。其创新成果在环保、节能及资源循环利用方面取得显著社会效益。胡振球同志屡获殊荣，包括第七届国际发明展览会\"金奖\"、闵行区五一劳动..."}, {"编号": 20250311020, "年份": 2016, "区局": "闵行区", "姓名": "曹荣", "年龄": 44, "姓名拼音": "Cao2-Rong2", "性别": "男", "工作单位": "上海民族乐器一厂有限公司", "工种或工作头衔": "拉弦乐器制作工", "领域": "文化", "行业": "乐器", "工匠介绍": "曹荣，作为国家高级二胡制作师和共产党员，秉持严谨态度，钻研乐器制作，创新工艺技术，推动行业发展。他成功改良二胡音色，年创效益200余万元，开发多款高端产品，获市场认可。2015年，他带领团队完成巨型\"革胡\"制作并参展国际乐器展。2014年，曹荣荣获上海市技术能手称号，2016年入选上海市杰出技术能手候选人，为民族器乐文化传承作出重要贡献。"}, {"编号": 20250311021, "年份": 2016, "区局": "嘉定区", "姓名": "王梅", "年龄": 43, "姓名拼音": "Wang2-Mei2", "性别": "女", "工作单位": "上海连成(集团)有限公司", "工种或工作头衔": "技术", "领域": "高端装备", "行业": "高端装备", "工匠介绍": "王梅，现任上海连成（集团）有限公司设计中心水泵项目经理，是公司水泵设计领域的技术骨干。她带领团队成功开发高效双吸泵，水泵效率提升5-10%，助力国家\"节能减排\"战略。尽管文化程度不高，她凭借勤奋好学，申报实用新型专利13项，培养10多名技术人才，创造经济效益1400万元。她主持完成了山西夹马口等多个大型泵站设计，创新开发SLOW系列中开泵。近年来，她带领团队开发多型中开泵，助力公司在双吸泵市场占据较高份额。"}, {"编号": 20250311022, "年份": 2016, "区局": "金山区", "姓名": "李林根", "年龄": 67, "姓名拼音": "Li3-Lin2-Gen1", "性别": "男", "工作单位": "金山区枫泾镇中国农民画丹青1号", "工种或工作头衔": "技工", "领域": "文化", "行业": "工艺美术", "工匠介绍": "李林根，中国农民画村书画装裱、修补古字画专业技师，被称为\"古画手术师\"。40余年来，他专注精研和传承1700年历史的书画装裱艺术及古字画修复技艺，成功修复了董其昌书法、徐悲鸿《奔马图》、朱屹瞻《苍鹰图》等众多名家艺术作品。他修复技术精湛，曾将几乎破碎的光绪年间画作修复如新，展现了高超的技艺。作为上海顶级古字画修复师之一，他以执着和敬畏之心守护并传承着这项古老技艺。"}, {"编号": 20250311023, "年份": 2016, "区局": "金山区", "姓名": "蔡蕴敏", "年龄": 55, "姓名拼音": "Cai4-Yun4-Min3", "性别": "女", "工作单位": "复旦大学附属金山医院", "工种或工作头衔": "护理", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "蔡蕴敏，在伤口造口治疗领域总结出独特的\"望-闻-评-判-断\"五步法工艺专长，并构建全院伤口造口护理网络，提升压疮和疑难伤口护理水平，获同行专家认可。她累计培训实习生及进修人员300余名，为40余家医院提供继续教育授课。牵头研发《家庭压疮护理手册》，创新压疮家庭管理模式，获患者高度评价。积极推动专科化护理服务体系建设，推动区域伤口护理资源整合。与多家社区卫生服务中心及福利机构建立结对共建关系，构建三级医院与基层医疗机构协同发展的护理服务机制。其团队创新实践显著提升金山医院伤口护理专业品牌效应及社会影响力，为全国专科化护理服务体系建设提供有益借鉴。"}, {"编号": 20250311024, "年份": 2016, "区局": "金山区", "姓名": "程美华", "年龄": 70, "姓名拼音": "Cheng2-Mei3-Hua2", "性别": "女", "工作单位": "上海市金山丝毯厂", "工种或工作头衔": "丝毯工艺美术师", "领域": "文化", "行业": "工艺美术", "工匠介绍": "程美华，中国传统手工艺丝毯传承与发展者，42年致力于将传统技艺推向新高度。她创新性地将金山农民画移植为艺术挂毯，研发新工艺片剪技术，突破了丝毯平面模式，创造出软雕塑效果，并开创性地使用北方榨蚕丝提升作品质感。其作品曾在美国国家艺术中心、联合国儿童基金会、上海世博会联合国馆等重要机构展出收藏。程美华荣获全国劳动模范、中国工艺美术大师等称号，为传统丝毯工艺走向世界搭建了桥梁。"}, {"编号": 20250311025, "年份": 2016, "区局": "松江区", "姓名": "翁永平", "年龄": 60, "姓名拼音": "Weng1-Yong3-Ping2", "性别": "男", "工作单位": "上海耀江实业有限公司", "工种或工作头衔": "技术", "领域": "绿色低碳", "行业": "环保", "工匠介绍": "翁永平，作为上海耀江实业有限公司技术中心主任，带领团队取得1项发明专利和36项实用新型专利，多个项目获区级及以上奖项。他主导研发的\"风光互补太阳能路灯\"获松江区科技成果三等奖，\"电动中空百叶玻璃\"项目列入上海市建筑建材遮阳推广技术目录，\"光电幕墙\"等获松江区创新资金支持。参与制定的\"门窗生产规范流程\"和\"隔热涂膜玻璃操作技术规范\"列为上海市地方标准。\"电动中空百叶\"项目获上海市建筑建材行业技术革新奖。他推动企业转型，成为松江区首家专业光伏电站建设企业，为多家单位和个人提供光伏发电系统服务。其所带领团队被设为松江区名师带徒工作点。"}, {"编号": 20250311026, "年份": 2016, "区局": "青浦区", "姓名": "李西岳", "年龄": 59, "姓名拼音": "Li3-Xi1-Yue4", "性别": "男", "工作单位": "上海浦宇铜艺装饰制品有限公司", "工种或工作头衔": "铸造", "领域": "文化", "行业": "工艺美术", "工匠介绍": "李西岳，高级铸造工程师、工艺美术师、环境艺术师，兼任西安工业大学教授。他是中国雕塑家协会等多家协会委员及副会长，获青浦区拔尖人才称号。其作品涵盖大型城市雕塑、铜艺术品及铜装饰，曾参与近百个国家重点工程设计。代表作包括沧州铁狮、上海世博会“生命之树”等，其中沧州铁狮被吉尼斯世界纪录认定为一次性整体浇铸最大铁狮子，并获多项金奖。其作品《第二自然》被中国工业博物馆收藏。他还担任多家机构的艺术总监及总工艺师，在铜装饰工程领域亦有卓越贡献，参与设计人民大会堂、洛阳隋唐遗址公园等多个重要项目。李西岳已申请专利57项，授权47项，涉及铸造工艺创新，达到国内领先水平。"}, {"编号": 20250311027, "年份": 2016, "区局": "青浦区", "姓名": "王本洪", "年龄": 49, "姓名拼音": "Wang2-Ben3-Hong2", "性别": "男", "工作单位": "上海正伟印刷有限公司（个人自荐）", "工种或工作头衔": "包装印刷-柔印版印刷", "领域": "文化", "行业": "高端装备", "工匠介绍": "王本洪，国内仅有的6名柔性版印刷技师之一，曾获上海市印刷行业职业技能竞赛二等奖、上海市印刷技术能手等多项荣誉，并于2012-2013年度被评为上海市优秀农民工。他作为正伟公司环保柔性版印刷的开创者，主导了多项关键技术的研发，为公司带来了显著的经济价值。王本洪在印刷领域屡获佳绩，发表了12篇权威论文并荣获全国征文大赛二等奖，同时拥有10项专利。他通过创新技术，实现了环保与成本的双重优化，2012至2013年间节省油墨成本近100万元。其主导的创新材料及防伪印刷技术，创造了总计270万、900万、1100万的经济价值。"}, {"编号": 20250311028, "年份": 2016, "区局": "奉贤区", "姓名": "顾德先", "年龄": 64, "姓名拼音": "Gu4-De2-Xian1", "性别": "男", "工作单位": "上海真静古典家具有限公司", "工种或工作头衔": "木工、研发", "领域": "文化", "行业": "工艺美术", "工匠介绍": "顾德先，是一位技艺精湛的传统木工艺术家，专注于明式家具制作和传统榫卯结构工艺的传承。上世纪70年代初，他拜师学习木工技艺，后寻得一位名师深造，掌握了明清家具制作中的关键技艺。他曾在上海从事中国传统古典家具的复原、传承及重制工作二十多年，现为上海木研社专业技术人员。他制作的明式经典家具作品在上海嘉泰拍卖行、上海展览中心等专业场所展出并被收藏，获得业内专家高度评价。顾德先致力于恢复我国经典明式家具传统工艺，为传承这一宝贵的文化遗产贡献自己的力量。"}, {"编号": 20250311029, "年份": 2016, "区局": "奉贤区", "姓名": "王红梅", "年龄": 53, "姓名拼音": "Wang2-Hong2-Mei2", "性别": "女", "工作单位": "上海玖开电线电缆有限公司", "工种或工作头衔": "技术", "领域": "新能源", "行业": "电力", "工匠介绍": "王红梅，作为上海玖开电线电缆有限公司的质量管控负责人，她在电线电缆行业深耕近二十年，从基层员工逐步成长为技术设计研发领域的专家。在质量管理、新产品研发及成果转化方面成绩显著。&#10;&#10;她主持完成了多项技术改进，其中包括同轴电缆屏蔽效果优化，获得实用新型专利（证书号：ZL201120324940.8），并被认定为高新技术成果转化项目（证书号：201402127），当年实现销售收入增长30%，新增利润约100万元。&#10;&#10;此外，她带领团队进行了新能源光伏电缆的技术改进，使生产成本降低20%，节约资金约110万元。同时，主持完成了电梯用同轴电缆的技术开发，成功将使用寿命从..."}, {"编号": 20250311030, "年份": 2016, "区局": "崇明区", "姓名": "黄成超", "年龄": 64, "姓名拼音": "Huang2-Cheng2-Chao1", "性别": "男", "工作单位": "上海崇明花菜研发中心", "工种或工作头衔": "高级农艺师", "领域": "花菜栽培", "行业": "农业", "工匠介绍": "黄成超，长期从事花菜种子研发工作，成功研发花菜杂交制种技术并实现外来品种本土化培育，有效满足崇明地区花菜种植需求。他主持完成多项科研项目，选育出\"崇花\"系列杂交新品种并填补崇明花菜杂交良种空白，创新研发群体授粉机械去雄技术并申请国家发明专利。黄成超积极推广新技术，解决菜农种植难题并提升防效，推动\"崇花\"系列品种在多地广泛应用。在他的努力下，中兴镇花菜种植面积达2.5万亩，并荣获\"中国花菜之乡\"等称号。曾获农业部丰收二等奖两项、上海市科技进步三等奖、国务院特殊津贴，被评为市农业科技创新带头人、\"最美崇明人\"等。"}, {"编号": 20250311031, "年份": 2016, "区局": "机电", "姓名": "李斌", "年龄": 65, "姓名拼音": "Li3-Bin1", "性别": "男", "工作单位": "上海电气液压气动有限公司", "工种或工作头衔": "高级机械技师", "领域": "高端装备", "行业": "机电", "工匠介绍": "李斌系上海电气液压气动有限公司液压泵厂数控工段高级技师、高级工程师。作为共产党员，他从技校生成长为专家型技术工人，主持完成\"高压轴向柱塞泵/马达国产化关键技术\"攻关项目，获19项发明专利和21项实用新型专利，荣获\"2009年度中国机械工业科学技术一等奖\"、国家科技进步二等奖等多项荣誉。其研发产品广泛应用并替代进口，创经济效益超2亿元，为军工产品提供技术支撑。作为全国工班长，他培养优秀职工队伍，带领班组获\"全国工人先锋号\"等多项称号，培养出三位上海市劳动模范，以精湛技艺和高尚师德诠释工匠精神。"}, {"编号": 20250311032, "年份": 2016, "区局": "机电", "姓名": "俞建民", "年龄": 68, "姓名拼音": "Yu2-Jian4-Min2", "性别": "男", "工作单位": "上海三菱电梯有限公司", "工种或工作头衔": "电梯安装调试工", "领域": "高端装备", "行业": "机电", "工匠介绍": "俞建民，上海三菱电梯有限公司安装人员，从事电梯安装工作42年。他主持或参与完成了上海中心、金茂大厦等多地超高层建筑与重点工程的电梯安装工作。在电梯安装领域不断钻研，创新多项超高速电梯及大跨度扶梯安装工艺，主持编制国内首个超高层建筑电梯无脚手架安装工艺，解决技术难题并填补领域空白。作为公司安装部重大项目主管，带领团队攻克技术难关，提升项目推进效率。2014年被评为首席技师并成立工作室，同年获\"上海市工人先锋号\"称号，2016年获上海市五一劳动奖章。"}, {"编号": 20250311033, "年份": 2016, "区局": "仪表电子", "姓名": "朱健儿", "年龄": 64, "姓名拼音": "Zhu1-Jian4-Er2", "性别": "男", "工作单位": "上海美多通信设备有限公司", "工种或工作头衔": "仪表通信", "领域": "空间信息", "行业": "仪表电子", "工匠介绍": "朱健儿，是上海美多通信设备有限公司军品车间的首席高级技师，拥有三十六年无线通信设备调试修理经验。他发明的\"控制单元检测操作法\"入选\"上海仪电创新活动素质工程工作集锦\"，并参与第19期高技能人才研修班学习。他主导解决了缅甸铁路超高频无线三级转发链接难题，开创该国铁路通信史 precedent。在海军装备建设中，他研发激励源单元突破舰船接收机阻塞瓶颈，使设备抗干扰性能达国际领先水平。他参与的XXXX设备填补海军通信技术空白，获国防科技进步一等奖。朱健儿编撰《调频无线电话机讲义》等教材，培养5名技师和15名高级工，获\"青年良师益友\"称号。"}, {"编号": 20250311034, "年份": 2016, "区局": "轻工", "姓名": "楼宇峰", "年龄": 65, "姓名拼音": "Lou2-Yu3-Feng1", "性别": "男", "工作单位": "上海造币有限公司", "工种或工作头衔": "模具手工雕刻", "领域": "货币", "行业": "工艺美术", "工匠介绍": "楼宇峰，现任上海造币有限公司设计制模部模具手工雕刻技师、上海市非物质文化遗产代表性项目代表性传承人。他长期从事钱币、纪念章模具手工雕刻工作，在《北京奥运会1盎司银币模具研制》项目中获二等奖，在《化学法制作硬币精细图纹模具工艺研究》项目中获银行科技发展三等奖，在《RFID技术在造币上的应用研究》项目中获银行科技发展二等奖。他培养了三名徒弟，其中一名成为技师，另一名成为高级工，第五代传人王峻松也被评为非遗传承人。他还多次参与非遗宣传活动，2015年作为代表参加了上海东方卫视纪录片《上海工匠》的录制。"}, {"编号": 20250311035, "年份": 2016, "区局": "轻工", "姓名": "刘忠荣", "年龄": 67, "姓名拼音": "Liu2-Zhong1-Rong2", "性别": "男", "工作单位": "上海忠荣玉典艺术品工作室", "工种或工作头衔": "玉石雕刻", "领域": "文化", "行业": "工艺美术", "工匠介绍": "刘忠荣，中国玉石雕刻大师、中国工艺美术大师，是上海市非物质文化遗产项目\"海派玉雕\"的代表性传承人，同时也是上海市领军人才。他师从多位玉雕名家，创作的\"翡翠百佛炉\"\"青玉兽面壶\"等作品被评定为国家文物等级珍品，\"黑白玉调色器\"获中国工艺美术首届百花奖银奖。他先后获得\"上海十大青年技术精英\"\"上海市劳动模范\"\"优秀共产党员\"等荣誉称号。1987年被破格提升为高级技师，并受到时任国务院总理李鹏的接见。在创办上海忠荣玉典艺术品工作室后，他设立首席技师工作室，培养了一批优秀玉雕人才，并开创性地为所有原创作品登记著作权，申请专利，其中\"六面围雕\"技术获得发明专利。他以身作则，在企业中担任大师原创工作..."}, {"编号": 20250311036, "年份": 2016, "区局": "纺织", "姓名": "龚杜弟", "年龄": 59, "姓名拼音": "Gong1-Du4-Di4", "性别": "男", "工作单位": "上海汽车地毯总厂有限公司", "工种或工作头衔": "高级技术", "领域": "文化", "行业": "纺织服装", "工匠介绍": "龚杜弟，上海汽车地毯总厂有限公司总工程师、教授级高工，全国五一劳动奖章获得者、上海市劳动模范。他主持研发的轿车行李箱地毯聚氨酯喷涂设备流水线填补国内空白，SFS填充成型隔音垫生产线设计为公司节约数千万元引进费用。带领团队成功开发宝马5系脚垫，创新多项工艺，获五项国家发明专利和两项实用新型专利，并获2016年上海市优秀发明奖金奖。其宝马轿车衣帽架全球首创侧向双弧冲切封边结构垄断产品技术，获德国专家好评。"}, {"编号": 20250311037, "年份": 2016, "区局": "医药", "姓名": "张雄毅", "年龄": 62, "姓名拼音": "Zhang1-Xiong2-Yi4", "性别": "男", "工作单位": "上海雷允上药业有限公司", "工种或工作头衔": "制丸", "领域": "生物医药", "行业": "医药卫生", "工匠介绍": "张雄毅，系雷允上药业集团有限公司资深药师，中药泛丸高级技师，并为上海市非物质文化遗产项目六神丸制作技艺代表性传承人，曾荣获第七届上海市技术能手称号。精通六神丸传统手工制作技艺，该工艺系国家保密配方，以手工泛丸为核心。张雄毅通过数十年潜心钻研，掌握全套制作技艺，其微丸制作达行业领先水平，误差率控制在1%以内。作为传承人，他通过\"师带徒\"方式培养青年员工，培养出多名技术骨干，并在行业竞赛中屡获佳绩。"}, {"编号": 20250311038, "年份": 2016, "区局": "电力工业", "姓名": "杨庆华", "年龄": 65, "姓名拼音": "Yang2-Qing4-Hua2", "性别": "男", "工作单位": "国网上海市电力公司检修公司", "工种或工作头衔": "输电线路", "领域": "高端装备", "行业": "电力", "工匠介绍": "杨庆华，国网上海市电力公司检修公司输电运检中心专业工程师、高级技师，享受国务院政府特殊津贴。他长期从事输电线路工作，带领团队出色完成了抗冰抢险、奥运保电、世博工程等重大工程，在400天内完成400基铁塔改造，攻克多项交直流特高压带电作业难题。他设计的高空防坠落装置等创新设备获国家专利并广泛应用。由他领衔的\"输电技术创新工作室\"攻克多项技术难关，累计创造经济效益超10亿元。该工作室于2014年被授予\"全国示范性劳模创新工作室\"称号。"}, {"编号": 20250311039, "年份": 2016, "区局": "电力工业", "姓名": "钱忠", "年龄": 56, "姓名拼音": "Qian2-Zhong1", "性别": "男", "工作单位": "国网上海嘉定供电公司", "工种或工作头衔": "配电线路", "领域": "高端装备", "行业": "电力", "工匠介绍": "钱忠，国网上海市电力公司带电作业班首批员工之一，1986年参加工作。他与团队自主研发多项工具和工艺，推动带电作业发展，使带电作业化率达74.6%。带领团队完成10余项科技项目，获33项国家专利，在核心期刊发表11篇专业论文。2014年成立劳模创新工作室，年均完成带电作业1467次，多供电量794.5万千瓦时，创造经济效益约2929.44万元，供电可靠性提升0.17%。他坚守一线30年，秉持\"不停电就是对客户最好的服务\"理念，为电力事业发展做出重要贡献。"}, {"编号": 20250311040, "年份": 2016, "区局": "电力建设", "姓名": "张新军", "年龄": 53, "姓名拼音": "Zhang1-Xin1-Jun1", "性别": "男", "工作单位": "上海电力安装第二工程公司", "工种或工作头衔": "锅炉受热面安装", "领域": "高端装备", "行业": "电力", "工匠介绍": "张新军，锅炉施工专家。他创新研发了螺旋式水冷壁安装标高控制技术、锅炉受热面大件吊装策划等关键技术，解决了多种锅炉类型安装难题。在上海外高桥三期、神头\"上大压小\"等项目中，他攻克多项技术难关，大幅提高施工效率。他发明的\"鳍片切割机\"专利显著降低了施工成本，并在万州项目中优化锅炉管排设备方案，为机组节约成本百万元。张新军还致力于技术传承，在上海电建成立\"张新军创新工作室\"，培养青年梯队。他先后获得上海电力建设有限公司劳模先进示范基地锅炉本体安装专家等多项荣誉，用实践诠释了大国工匠的责任与担当。"}, {"编号": 20250311041, "年份": 2016, "区局": "宝武", "姓名": "孔利明", "年龄": 73, "姓名拼音": "Kong3-Li4-Ming2", "性别": "男", "工作单位": "原上海宝山钢铁股份有限公司", "工种或工作头衔": "高级技师", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "孔利明，自幼受\"人有艺走天下\"家训影响，立志成为技艺精湛的手艺人。他精通木匠、焊接、电工、电子等多种技能，并将所学应用于实践，解决了诸多农机难题。进入宝钢后，他确立了\"当好工人同样受人尊重\"的职业信念，系统学习机械构造、电子电气、计算机等专业知识，并不断创新。他成功研发了《倒车请注意》《汽车电路短路定位检测仪》等多项实用技术，其中《废钢卸船防坠增效工艺》突破技术瓶颈，实现作业安全率100％、效率提升45％。近十年来，他带领团队完成《铁矿石带式运输金属物检测和去除技术系统》项目，获中港科技进步一、二、三等奖，上海市科技进步二等奖及巴黎国际金奖。作为宝钢技能专家和全国示范型劳模工作室负责人，..."}, {"编号": 20250311042, "年份": 2016, "区局": "宝武", "姓名": "王康健", "年龄": 69, "姓名拼音": "Wang2-Kang1-Jian4", "性别": "男", "工作单位": "宝钢股份冷轧厂", "工种或工作头衔": "冷轧技能专家", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "王康健，是我国轧钢领域的高级技师与技能专家，宝钢第一代主操作工。他从宝钢冷轧一期建设起，参与了各期发展，成长为分厂副厂长并担任多家机构要职。他享有国务院特殊津贴，曾获全国\"五一\"劳动奖章、中华技能大奖等多项荣誉。扎根一线40余年，他解决设备疑难杂症350余项，改进操作工艺150余项，主导科研项目25项，拥有121项专利，并多次获得国家科技进步奖等重要奖项。以他命名的技能大师工作室在推动创新方面发挥了重要作用，培养了多名优秀人才，为宝钢冷轧领域达到行业领先地位作出重要贡献。"}, {"编号": 20250311043, "年份": 2016, "区局": "宝武", "姓名": "王军", "年龄": 59, "姓名拼音": "Wang2-Jun1", "性别": "男", "工作单位": "宝钢股份冷轧厂", "工种或工作头衔": "钳工高级技师", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "王军，宝钢技能专家，享受国务院特殊津贴，兼任宝钢人才开发院兼职教授、上海市劳模讲师团成员等职。荣获国家科技进步二等奖、上海市科技进步二等奖等多项荣誉，拥有国家专利及申请208项、PCT国际专利申请12项。主持国家级技能大师工作室工作，在高强度全密封精整矫直机支承辊技术、高成材率节能环保热轧层流冷却成套装备技术等领域取得突破。带领团队实现创新效益14亿元，所在热轧车间连续十二年位居宝钢创新排行榜榜首。"}, {"编号": 20250311044, "年份": 2016, "区局": "宝冶集团", "姓名": "毛琪钦", "年龄": 49, "姓名拼音": "Mao2-Qi2-Qin1", "性别": "男", "工作单位": "上海宝冶工程技术有限公司", "工种或工作头衔": "电焊", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "毛琪钦，全国技术能手、第九届\"上海市工人创新技术能手\"，在焊接领域屡创佳绩。他先后在全国冶金建设行业第六届焊工技术比赛和全国工程建设系统第七届焊工技术比赛中获个人总分第一名，并入选《上海技师的高招绝活》。毛琪钦不仅掌握多种焊接技术，还获得焊工职业培训师资格和国际焊接技师资质，并取得上海交通大学材料科学与工程专业本科学历。他主持了多项科研项目，培养的学员在全国比赛中屡获佳绩。2011年，作为第41届世界技能大赛焊接项目中国技术指导专家，他指导的选手裴先锋获银奖。"}, {"编号": 20250311045, "年份": 2016, "区局": "石化股份", "姓名": "陆定良", "年龄": 56, "姓名拼音": "Lu4-Ding4-Liang2", "性别": "男", "工作单位": "上海石油化工股份有限公司", "工种或工作头衔": "新材料研发", "领域": "先进材料", "行业": "石化", "工匠介绍": "陆定良，作为与上海石化共同成长的技术工人，扎根生产一线，以\"勇猛精进，志愿无偿\"的工匠精神在平凡岗位上书写不凡人生。从普通操作工成长为高级技师、主任技师，他带领陆定良技师工作室解决多套装置技术难题，主持完成数十项技术改进项目，培养出多名优秀徒弟。他主编的M800E产品生产优化操作法被评为上海石化2013年度优秀先进操作法，徒弟中多人获得中石化集团技能比武铜奖和上海石化\"技术能手\"称号。"}, {"编号": 20250311046, "年份": 2016, "区局": "航天局", "姓名": "王曙群", "年龄": 54, "姓名拼音": "Wang2-Shu3-Qun2", "性别": "男", "工作单位": "上海航天设备制造总厂有限公司", "工种或工作头衔": "设备总装", "领域": "空间信息", "行业": "航天", "工匠介绍": "王曙群，上海航天设备制造总厂特级技师，航天八院首席技师，是我国航天领域对接机构装配的领军人才。他参与了神舟八号与天宫一号对接机构的装调工作，实现了我国\"太空之吻\"技术突破，推动我国成为世界上第二个掌握此技术的国家。王曙群曾获\"上海市技术能手\"、航天科技集团\"航天技能大奖\"、\"中国载人航天突出贡献者\"等多项荣誉，并于2015年入选\"上海工匠\"。他带领团队完成了月球车、锥杆式对接机构等高技术项目，培养了大量航天高技能人才，为我国航天事业发展作出了重要贡献。"}, {"编号": 20250311047, "年份": 2016, "区局": "航天局", "姓名": "苗俭", "年龄": 48, "姓名拼音": "Miao2-Jian3", "性别": "女", "工作单位": "上海航天控制技术研究所", "工种或工作头衔": "数控", "领域": "空间信息", "行业": "航天", "工匠介绍": "苗俭，上海航天控制技术研究所精密加工中心双工种高级技师，中共党员。从事数控加工中心编程及操作工作21年，参与运载火箭、战术武器和飞船等关键零部件研制生产。作为航天首席技师和苗俭国家级技能大师工作室负责人，她攻克多项技术难关，成功完成本科专业学习。&#10;&#10;苗俭获得多项荣誉：2007年事迹被央视《劳动者之歌》报道，2009年作为全国青年职工代表在纪念五四运动90周年大会上发言。她精通多种CAD/CAM软件，创新编程手段，为航天事业培养大量青年技能人才，在各类竞赛中屡获佳绩。苗俭是航天系统高技能人才杰出代表，展现了刻苦学习、创新进取、拼搏奉献和爱岗敬业的精神。"}, {"编号": 20250311048, "年份": 2016, "区局": "船舶", "姓名": "张翼飞", "年龄": 68, "姓名拼音": "Zhang1-Yi4-Fei1", "性别": "男", "工作单位": "沪东中华造船（集团）有限公司", "工种或工作头衔": "船舶电焊", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "张翼飞，沪东中华造船（集团）有限公司首席技师、集团公司首席技师，全国技术能手称号获得者，\"张翼飞劳模创新工作室\"创始人。他培养了5名全国技术能手和4名省部级劳动模范，带领团队攻克多项焊接技术难题，成功研发双相不锈钢焊接工艺、单电源双丝自动埋弧焊等多项关键技术。他主持制定了泵塔氩弧焊/CO2混合焊工艺标准，推动了焊接机器人的应用。张翼飞还主编了《船厂焊工操作手册》并发表了多篇专业论文，其中两项成果获上海市专利发明。他获得\"中华技能大奖\"\"全国五一劳动奖章\"等多项荣誉，为船舶工业发展作出了突出贡献。"}, {"编号": 20250311049, "年份": 2016, "区局": "船舶", "姓名": "陈志农", "年龄": 67, "姓名拼音": "Chen2-Zhi4-Nong2", "性别": "男", "工作单位": "江南造船（集团）有限责任公司", "工种或工作头衔": "船舶钳工", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "陈志农，是江南造船集团总装部的一名船舶钳工高级技师，从事船舶轮机安装及设备调试工作已有38年。他荣获了中国船舶公司劳动模范、上海市劳动模范、全国技术能手、上海市首席技师、上海市十大工人发明家等多项荣誉称号。近十年来，他以\"努力奉献，不断创新\"为座右铭，在创新和发明方面取得了显著成就，先后获得10项国家专利，填补了多项国内技术空白，并撰写了多篇中国海军科技报告。2012年，以他名字命名的国家级技能大师工作室正式成立，为培养更多优秀技术人才做出了贡献。"}, {"编号": 20250311050, "年份": 2016, "区局": "船舶", "姓名": "秦毅", "年龄": 45, "姓名拼音": "Qin2-Yi4", "性别": "男", "工作单位": "沪东中华造船（集团）有限公司", "工种或工作头衔": "电焊工", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "秦毅，系沪东中华造船公司首席技师，被誉为中国LNG船殷瓦焊接G证第一人。他累计培养合格殷瓦焊工360余名，其中多人获评全国技术能手、高级技师等称号。秦毅先后发表专业论文多篇，主编《LNG船焊接实用手册》，获国家发明专利2项、实用新型专利1项，发明的扭动施焊法使LNG船液货舱焊接实现零漏点。他积极参与焊接设备国产化研制，为公司节省费用200多万元。秦毅曾获全国技术能手、中央企业劳动模范等称号，并享受国务院政府特殊津贴。"}, {"编号": 20250311051, "年份": 2016, "区局": "汽车", "姓名": "徐小平", "年龄": 64, "姓名拼音": "Xu2-Xiao3-Ping2", "性别": "男", "工作单位": "上汽集团大众汽车有限公司", "工种或工作头衔": "高级工程师", "领域": "汽车", "行业": "汽车", "工匠介绍": "徐小平，现任上汽大众汽车有限公司发动机厂维修部门高级经理、党支部书记，是杰出的产业工人代表。他荣获“上海市劳动模范”、“上海市十大工人发明家”、“全国五一劳动奖章”、“中国机械工业技能大师”等称号，并连续三届获得“全国劳动模范”称号，同时是“全国创先争优优秀共产党员”。徐小平以其勤奋好学、善于思考、敬业钻研和勇于创新的精神，带领团队突破技术垄断，推动设备精细化自主维修，创造数以亿计的经济效益，并为企业贡献十几项发明专利。作为新时代产业工人的杰出代表，他在平凡岗位上创造了不凡业绩，为企业发展和社会进步作出重要贡献。"}, {"编号": 20250311052, "年份": 2016, "区局": "汽车", "姓名": "张生春", "年龄": 56, "姓名拼音": "Zhang1-Sheng1-Chun1", "性别": "男", "工作单位": "上海赛科利汽车模具技术应用有限公司", "工种或工作头衔": "工具钳工", "领域": "汽车", "行业": "汽车", "工匠介绍": "张生春，上海赛科利汽车模具技术应用有限公司工具钳工，模具制造领域的杰出代表。他以精湛的技术和严谨的态度，在模具调试与创新方面屡创佳绩。2012年，带领团队仅用4个月完成上汽通用昂科拉侧围项目模具交付，荣获“精模奖”，并总结出“张氏蹭光法”，显著提升模具表面质量。他注重团队建设，培养大批骨干力量，并成立“张生春首席技师工作室”，制作45个基础操作视频教程，推动新员工标准化培训。张生春攻克多项技术难题，其调试方法纳入企业经验数据库，大幅提升模具制造速度和质量。他以精益求精的态度，推动企业不断进步，诠释了专业、专注和创新的匠心精神。"}, {"编号": 20250311053, "年份": 2016, "区局": "汽车", "姓名": "任建新", "年龄": 53, "姓名拼音": "Ren4-Jian4-Xin1", "性别": "男", "工作单位": "上海柴油机股份有限公司", "工种或工作头衔": "铣工", "领域": "汽车", "行业": "汽车", "工匠介绍": "任建新，作为资深技术专家，自1987年起投身工作，师从全国劳模陈祖权后，技术水平显著提升，成长为高级技师。他累计完成25项技术攻关和创新，其中11项获国家专利，创造1200多万元经济效益。2011年入选上海市首批\"首席技师\"，2014年荣获\"上海市技能大师\"称号。他精通车、铣、刨、磨、数控设备操作，擅长工装刀具设计与制造工艺制定，在进口刀具国产化、工装优化等领域成果显著。齿形组合拉刀研制尤其突出，解决了±0.007mm公差难题，获上海市优秀发明选拔赛金奖。他推广技术成果，总结三项先进操作方法，论文荣获机械工业高技能人才优秀论文二等奖。培养3名徒弟晋升技师、2名晋升高级技师，任上海市技师协..."}, {"编号": 20250311054, "年份": 2016, "区局": "铁路局", "姓名": "张华", "年龄": 47, "姓名拼音": "Zhang1-Hua2", "性别": "男", "工作单位": "中国铁路上海局集团有限公司上海动车段", "工种或工作头衔": "动车组机械师", "领域": "轨道交通", "行业": "铁路", "工匠介绍": "张华，中共党员，高级技师，现任上海动车段电气调试班工长，兼任段诊断工程师、局兼职教师及动车技术-劳模工作室领衔人。他长期致力于动车组高级修电气调试工作，年均处理重难点电气故障百余起。通过优化2型动车组电气调试项目作业顺序，将调试时间缩短30%以上，显著提升产能并降低能耗。他还主编完成《CRH2型动车组故障排查处理指南》，参与开发动车组高压系统实训间，并积极响应节能降耗号召，组织实施修旧利废工作。&#10;&#10;在技能竞赛中，张华在上海铁路局动车组机械师、“四方杯”动车组诊断工程师及全国铁路动车组机械师职业技能竞赛中均获个人第一名。他参与的《CRH2型动车组三级修调试作业优化》QC项目..."}, {"编号": 20250311055, "年份": 2016, "区局": "港务", "姓名": "张彦", "年龄": 41, "姓名拼音": "Zhang1-Yan4", "性别": "男", "工作单位": "上港集团盛东国际集装箱码头有限公司", "工种或工作头衔": "电动装卸机械司机", "领域": "交通运输", "行业": "港务", "工匠介绍": "张彦，作为一名共产党员和集装箱桥吊操作者，凭借精湛技术和团队协作，七次刷新桥吊单机和船时量作业效率的世界纪录。他创造的每小时196.64自然箱的单机效率至今未被超越。张彦带领团队攻克12项技术难题，其中“新型桥吊节能操作方法”每年为公司节省128万元能源消耗。他总结经验形成“张彦操作法”，并培养了150余名优秀司机。作为上海市劳模创新工作室带头人，张彦在“双吊具边卸边装”新工艺推广中做出重要贡献，提升效率49.25%，显著减少资源投入。他荣获上海市劳动模范、全国五一劳动奖章等多项荣誉，为洋山深水港建设做出突出贡献。"}, {"编号": 20250311056, "年份": 2016, "区局": "移动通信", "姓名": "水湧", "年龄": 54, "姓名拼音": "Shui3-Yong3", "性别": "男", "工作单位": "中国移动通信集团上海有限公司", "工种或工作头衔": "线务员", "领域": "空间信息", "行业": "通信", "工匠介绍": "水湧，现任上海移动网维中心线路维护部工程抢修班班长，2015年被评为全国劳动模范。自2002年入职以来，他始终秉持预警维护理念，带领团队为上海移动一级干线光缆实现连续1000余天无阻断作出重要贡献。他建立光缆安全隐患预警机制，创新总结出\"三快、三慢；两多两少；一心一意\"的工作法，并在维护条线推广。在他的带领下，部门故障抢修及时率稳定在95%以上。水湧不仅个人技术过硬，还注重班组建设，每年修订完善规章制度，培养出一支技术精湛、作风过硬的抢修队伍。"}, {"编号": 20250311057, "年份": 2016, "区局": "电信", "姓名": "徐珺", "年龄": 46, "姓名拼音": "Xu2-Jun4", "性别": "男", "工作单位": "中国电信股份有限公司上海西区电信局", "工种或工作头衔": "光纤布线工程师", "领域": "空间信息", "行业": "通信", "工匠介绍": "徐珺,作为中国电信上海公司西区电信局客户终端服务工程师,是全国劳动模范、上海市十大工人发明家、上海市杰出技术能手。他专注于通信末梢线路接入技术,发明暗管入户四小工具,推广暗线入户操作法,使上海公司暗线穿通率显著提升。他还研究隐形光缆布放改进工艺,成为该光缆国家标准起草人之一,已获得4项专利。他参与装维师资培养,近5年培训达三万人次。作为全国劳模创新工作室负责人,培养了4名骨干技师。他创建\"线务员之家\"网站,助力通信线务技术发展。此外,他帮助培养世界技能大赛中国选手,助力中国选手在国际舞台上取得佳绩。"}, {"编号": 20250311058, "年份": 2016, "区局": "上海海事", "姓名": "吴志华", "年龄": 58, "姓名拼音": "Wu2-Zhi4-Hua2", "性别": "男", "工作单位": "东海航海保障中心上海航标处", "工种或工作头衔": "无线电航标", "领域": "安全保障", "行业": "海事", "工匠介绍": "吴志华，东海航海保障中心上海航标处高级工程师，从事航标设备维修和创新攻关近30年。他研发《航标维护四步法》，完成20多个项目研究，实现30余项技术转化，为国家节约资金超千万。其中“防盗航标灯”项目成功解决偏远海域航标难题。他参与上海世博会、广州亚运会航标设置等20余项重大工程，荣获首批上海国际航运中心建设十大先进个人称号。他建立“吴志华劳模工作室”，培养了一批技能型人才。"}, {"编号": 20250311059, "年份": 2016, "区局": "建设交通", "姓名": "李增红", "年龄": 52, "姓名拼音": "Li3-Zeng1-Hong2", "性别": "男", "工作单位": "中铁上海工程局集团市政工程有限公司", "工种或工作头衔": "电工", "领域": "高端装备", "行业": "建设交通", "工匠介绍": "李增红，作为集团公司最年轻的高级技师，凭借卓越的专业能力和丰富的实践经验，带领\"李增红技能大师工作室\"攻克多项技术难题，推动了国内顶管施工技术的智能化发展。他成功研发\"升压-输电-降压-用电\"供电方案，创新电缆设计，并自主研发测量装置和自动注浆系统，显著提升施工效率。截至目前，李增红参与完成15项技术改进项目，获得4项国家级发明专利和7项国家实用性专利，为企业创造超过3000万元经济效益。2015年，他作为中铁上海局重点学习对象，在劳模表彰会上作专题报告，掀起全公司\"向李增红同志学习\"热潮。"}, {"编号": 20250311060, "年份": 2016, "区局": "建设交通", "姓名": "石长江", "年龄": 52, "姓名拼音": "Shi2-Chang2-Jiang1", "性别": "男", "工作单位": "中铁二十四局集团有限公司", "工种或工作头衔": "钢筋工", "领域": "轨道交通", "行业": "建设交通", "工匠介绍": "石长江，作为一位资深钢筋工，从业26年来始终致力于技术创新与实践探索。他主持并参与了多项铁路施工项目，包括\"中取华东\"等大会战，均获高度评价。2005年，他被聘为\"钢筋工技师\"，2007年荣获中央企业职工技能大赛钢筋工决赛金奖，同年获得\"全国技术能手\"称号。2008年，他被授予福建省劳动模范称号，2012年获得国务院政府特殊津贴专家称号。同时，他积极承担\"导师带徒\"工作，培养多名技术骨干，为企业发展做出重要贡献。"}, {"编号": 20250311061, "年份": 2016, "区局": "建工", "姓名": "陆凯忠", "年龄": 52, "姓名拼音": "Lu4-Kai3-Zhong1", "性别": "男", "工作单位": "上海市基础工程集团有限公司", "工种或工作头衔": "电工", "领域": "土地混合利用", "行业": "建工", "工匠介绍": "陆凯忠，上海市基础工程集团有限公司高级技师，陆凯忠工作室负责人。他长期投身轨道交通建设，参与上海多条地铁线路及外省市重点工程，主持完成多项科研课题并取得专利。凭借突出贡献，他荣获全国劳动模范、全国\"五一\"劳动奖章、全国优秀技术能手、上海市工人发明家等多项荣誉称号。"}, {"编号": 20250311062, "年份": 2016, "区局": "建工", "姓名": "王斌", "年龄": 49, "姓名拼音": "Wang2-Bin1", "性别": "男", "工作单位": "上海市机械施工集团有限公司", "工种或工作头衔": "工程测量", "领域": "土地混合利用", "行业": "建工", "工匠介绍": "王斌，工程测量领域的杰出代表，参与了近20条地铁线路及100多公里隧道的施工测量，误差控制在10mm以内，测量精度达\"毫米级\"。他拥有6项专利，获得国家测绘局技术金奖、上海市职工先进操作法等多项荣誉，出版2部国家培训教材，并被授予\"上海市十大工人发明家\"\"上海市劳模\"称号，当选上海市第十四届人大代表。&#10;&#10;王斌创新研发矩形盾构自动测量系统，提升地下空间开发技术；参与迪士尼工程测量，将埋件定位精度提升至±2mm；参与上海中心大厦测量方案探讨，贡献重要技术参考。他成立\"王斌工程测量技术创新工作室\"，培养30余名测量工匠，获\"上海市劳模创新工作室\"等称号，完成多项重大工程测量任务..."}, {"编号": 20250311063, "年份": 2016, "区局": "建工", "姓名": "李杰", "年龄": 39, "姓名拼音": "Li3-Jie2", "性别": "男", "工作单位": "上海市机械施工集团有限公司", "工种或工作头衔": "塔吊司机", "领域": "土地混合利用", "行业": "建工", "工匠介绍": "李杰，作为超高层建筑起重塔吊操作机长，参与了包括上海环球金融大厦、上海中心大厦等在内的多个顶级地标工程项目。他掌握了STL380型、M900D型、M1280D型等多种塔吊操作技术，曾操作起重量达2450吨米的进口M1280D型塔吊，成功完成塔吊从地面到650米高空的顶升操作。他首创使用高空悬挂重型设备施工方法，掌握构件重量、尺寸和起吊方式的精确判断能力，练就云雾天气精准定位技能，能将吊钩与作业点偏差控制在1米以内。在上海中心大厦建设中，完成高难度高空爬升、移位和解体拆卸作业，荣获‘上海中心大厦工程建设立功竞赛先进个人’称号。"}, {"编号": 20250311064, "年份": 2016, "区局": "中建八局", "姓名": "黄德彪", "年龄": 56, "姓名拼音": "Huang2-De2-Biao1", "性别": "男", "工作单位": "中建八局上海矗鑫建筑工程有限公司", "工种或工作头衔": "钢筋工", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "黄德彪，中建八局耀华地区16-1地块公共租赁住房项目普通工人。他26年前离川来沪，从普通农民工成长为优秀务工者。工作中，他虚心好学，追求施工零误差，多次获用人单位褒奖。2015年起，他担任上海矗鑫建筑工程有限公司耀华16-1项目工会主席及中建八局耀华路项目工会联合会副主席，积极维护工友权益，通过多种途径倾听一线工友诉求，为工友提供全面工会服务。他秉持\"为员工办实事\"的理念，努力保障工友基本权益，深受工友爱戴。"}, {"编号": 20250311065, "年份": 2016, "区局": "科技", "姓名": "陈忠明", "年龄": 56, "姓名拼音": "Chen2-Zhong1-Ming2", "性别": "男", "工作单位": "中国科学院上海硅酸盐研究所", "工种或工作头衔": "材料研究", "领域": "碳化物陶瓷", "行业": "科技", "工匠介绍": "陈忠明，正高级工程师，长期从事先进碳化物陶瓷材料研究。他从普通技术员成长为课题组主要负责人，在碳化物陶瓷成型和烧结技术领域有深厚造诣。参与多个国家级科研项目，在解决关键技术难题中发挥重要作用。带领团队研制成功国际最大1.5米常压烧结碳化硅光学部件，完成天宫、嫦娥等14个型号碳化硅光学部件研制任务，产品实现成功在轨运行。累计科研经费数亿元，显著提升我国高分辨对地观测技术水平，确立上海硅酸盐研究所在空间遥感技术领域的领先地位。"}, {"编号": 20250311066, "年份": 2016, "区局": "科技", "姓名": "陈勤泉", "年龄": 57, "姓名拼音": "Chen2-Qin2-Quan2", "性别": "男", "工作单位": "上海光机所恒益公司", "工种或工作头衔": "光学刻、磨工", "领域": "光学粗磨", "行业": "科技", "工匠介绍": "陈勤泉，自1999年入职以来一直从事光学粗磨工作，2009年被抽调至环抛加工组，参与了神光Ⅱ升级、神光Ⅲ原型及主机钕玻璃加工等重大科研项目。他在大口径平面光学元件环抛精加工方面具有丰富经验，擅长控制2.4/2.8m环抛机的面形和疵病，为环抛交叉修复工艺的成熟及精加工效率提升作出了重要贡献。他在面形控制和疵病控制方面创新运用抛光盘面形的交叉组合，使钕玻璃单面疵病合格率提高30%。2009年至2013年，他完成神光Ⅱ升级装置及神光Ⅲ原型钕玻璃加工任务的70%，并带领环抛组将产能提升至50片/月，加工量占神光Ⅲ项目已供货总量的60%以上。他还积极参与\"高师带徒\"活动，培养青年人才。2013年度..."}, {"编号": 20250311067, "年份": 2016, "区局": "医务", "姓名": "许迅", "年龄": 65, "姓名拼音": "Xu3-Xun4", "性别": "男", "工作单位": "上海市第一人民医院", "工种或工作头衔": "医务人员", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "许迅教授是国内眼科领域的杰出代表，长期致力于糖尿病视网膜病变等重大致盲性眼病的研究与防治工作。他主持国家十二五科技重大专项等十余项国家级课题，在国内外权威期刊发表SCI论文87篇。许迅教授曾荣获2007年、2013年上海市科技进步一等奖，2008年国家科技进步二等奖以及2011年华夏医学科技一等奖等多项重要奖项。他带领团队在代谢记忆机制、新干预靶点等方面取得重要突破，建立了中国首个眼科临床研究评价中心，并推动眼科新药研发，为领域发展作出了重要贡献。许迅教授在学术界享有崇高声誉，参编多部眼科学专著，并担任国际权威期刊编委。"}, {"编号": 20250311068, "年份": 2016, "区局": "文广影视局", "姓名": "马如高", "年龄": 60, "姓名拼音": "Ma3-Ru2-Gao1", "性别": "男", "工作单位": "上海博物馆（个人自荐）", "工种或工作头衔": "漆木器文物修复", "领域": "文化", "行业": "文物", "工匠介绍": "马如高，我国著名文物修复专家，擅长漆木器修复。自1994年加入上海博物馆以来，他主持修复馆藏文物300余件，并为广东博物馆、上海历史博物馆等机构修复文物100余件。其中最具代表性的成果是对一件\"紫檀雕莲叶龙纹宝座\"的抢救性修复，该文物由200余块散件重组，修复完成后被 experts鉴定为同类宝座中孤品，具有极高研究价值，市场估价7千万元。他始终致力于文化遗产保护，强调文物修复不仅是技艺传承，更是文化内涵的呈现。"}, {"编号": 20250311069, "年份": 2016, "区局": "经济信息化", "姓名": "蒋跃年", "年龄": 67, "姓名拼音": "Jiang3-Yue4-Nian2", "性别": "男", "工作单位": "上海长江企业发展合作公司", "工种或工作头衔": "篆刻", "领域": "文化", "行业": "经信", "工匠介绍": "蒋跃年，高级工艺美术师，现任上海长江企业发展合作公司集云阁首席工艺美术师，师承沈受觉、刘友石及杨明华先生。他以深厚书法造诣为基础，擅长正、草、隶、篆等多种书体，尤其以秦小篆书法闻名，风格刚柔并济、严整端庄。蒋跃年作品屡获全国行业金银奖，并受邀为国内外领导人定制国礼篆刻作品。作为《印章艺术雕刻》非遗项目第三代传承人，他积极开展传承工作，培养后继人才。"}, {"编号": 20250311070, "年份": 2016, "区局": "民政", "姓名": "王刚", "年龄": 48, "姓名拼音": "Wang2-Gang1", "性别": "男", "工作单位": "上海市龙华殡仪馆", "工种或工作头衔": "遗体整容师", "领域": "社会工作", "行业": "殡葬", "工匠介绍": "王刚，现任上海市龙华殡仪馆业务科副科长、高级遗体整容技师，致力于遗体整容化妆工作二十余年。他成功创建全国首个专业遗体修复工作室——民政部劳模王刚工作室，运用三维立体激光扫描等先进技术，推动行业发展。2016年，他参与3D打印技术遗体修复攻关项目，修复相似度达95%以上。王刚同志多次代表上海参与重大社会突发事件处理，展现了上海遗体修复技术的先进水平，获家属高度认可。"}, {"编号": 20250311071, "年份": 2016, "区局": "锦江国际", "姓名": "郭予文", "年龄": 61, "姓名拼音": "Guo1-Yu3-Wen2", "性别": "男", "工作单位": "上海锦江饭店", "工种或工作头衔": "厨师", "领域": "餐饮", "行业": "餐饮", "工匠介绍": "郭予文，锦江饭店资深厨师，从事餐饮工作30余年，擅长食品雕刻。他荣获“全国金奖”，并被命名为“上海市职工岗位绝技绝招”。上海市总工会以他的名字设立了首批劳模创新工作室。他曾参与多次重要宴请和中外首脑接待工作，其作品深受客人喜爱。1993年，他在第三届全国烹饪大赛中获食品雕刻个人金牌；2001年，在APEC峰会接待工作中表现出色，获得集团表彰；2010年，上海世博会期间，他设计制作了带有世博会标志的西瓜花，获组委会高度评价。此外，他还在第九届上海国际烹饪艺术比赛中荣获金牌，作品多次被各国首脑收藏。"}, {"编号": 20250311072, "年份": 2016, "区局": "锦江国际", "姓名": "严惠琴", "年龄": 70, "姓名拼音": "Yan2-Hui4-Qin2", "性别": "女", "工作单位": "上海新锦江大酒店", "工种或工作头衔": "中式烹饪", "领域": "餐饮", "行业": "餐饮", "工匠介绍": "严惠琴，中国烹饪大师、中国名厨专业委员会副主席、上海烹饪协会副会长等职，被誉为海派国宴菜的创造者和领军人物。师承中国烹饪界一代宗师萧良初先生，并得到多位名师亲授。她潜心钻研四十余年，精通广菜、潮菜、川菜等菜系，并将海派菜与西方时尚完美融合。曾参与接待500余次国宾宴请，服务300多位国家元首和政府首脑，并多次担任国内外重大活动主厨。严惠琴著有《浅析潮州菜的\"味\"》等专业论著，并提出\"中菜西做、西菜中做、粗菜精做、野菜细做\"原则，为中华餐饮文化发展做出重要贡献。她曾获全国劳动模范、全国\"五一\"劳动奖章、国务院特殊津贴、中国十大名厨等荣誉称号。"}, {"编号": 20250311073, "年份": 2016, "区局": "东湖", "姓名": "孙志湧", "年龄": 62, "姓名拼音": "Sun1-Zhi4-Yong3", "性别": "男", "工作单位": "上海东郊宾馆", "工种或工作头衔": "厨师", "领域": "文化", "行业": "餐饮", "工匠介绍": "孙志湧，上海东郊宾馆行政总厨，全国五一劳动奖获得者、上海市劳动模范、中国烹饪大师。他擅长将民间菜提升为国宴佳肴，让中华美食走向世界舞台。在外交场合，他用精湛厨艺展现中国文化，获得多国领导人的高度评价。世博会期间，他制作的国宴受到朱镕基等领导人的赞扬，亚信峰会期间更是在26分钟内完成60人国宴，获习主席和普京称赞。他积极推动美食平民化，举办江鲜美食节等系列 culinary活动，让百姓品尝国宴名品。同时，他带教武警士兵食堂，提升其服务水平。"}, {"编号": 20250311074, "年份": 2016, "区局": "百联集团", "姓名": "蓝金康", "年龄": 70, "姓名拼音": "Lan2-Jin1-Kang1", "性别": "男", "工作单位": "上海三联（集团）有限公司茂昌眼镜公司", "工种或工作头衔": "验光师", "领域": "文化", "行业": "商业", "工匠介绍": "蓝金康，国家级高级验光技师，任\"茂昌眼镜公司\"验光技师三十余年。他研发的\"多焦镜验光三点位法\"使渐进多焦点验配成功率接近100%，获上海市科技进步三等奖；与团队发明的\"去毛复新\"技术获国家发明专利。2005年带领团队开发新型耐磨树脂镜片膜层，耐磨性能优于部分国际品牌；2006年主持研发新型内渐进多焦镜镜片。擅长复杂病例验光，获眼科专家认可。2013年，上海市总工会在其所在公司设立\"蓝金康验配眼镜技术创新工作室\"，用于技术研究与产品创新。"}, {"编号": 20250311075, "年份": 2016, "区局": "申通集团", "姓名": "李鹃伟", "年龄": 64, "姓名拼音": "Li3-Juan1-Wei3", "性别": "男", "工作单位": "上海地铁维护保障有限公司车辆分公司", "工种或工作头衔": "城轨电动列车检修工", "领域": "轨道交通", "行业": "交通", "工匠介绍": "李鹃伟，现任上海地铁维护保障有限公司车辆分公司钳工、高级技师、大修厂制动班组长，是全国技能大师工作室带头人。他秉持\"干一行、爱一行\"的精神，在列车制动系统研究领域不断创新突破，为企业创造显著效益。李鹃伟先后获得上海市劳动模范称号、国务院津贴等多项荣誉，其工作室被评为全国技能大师工作室。他主导的两项先进操作法和八项技术专利累计为企业节约维修成本2248万元，其中\"多车型空气弹簧试验设备操作法\"被评为上海市先进操作法。李鹃伟始终活跃在车辆检修一线，致力于提升列车行驶安全性和平稳性，展现了新时代工匠的使命担当。"}, {"编号": 20250311076, "年份": 2016, "区局": "申通集团", "姓名": "严如珏", "年龄": 54, "姓名拼音": "Yan2-Ru2-Jue2", "性别": "女", "工作单位": "上海地铁第一运营有限公司", "工种或工作头衔": "维修电工", "领域": "轨道交通", "行业": "交通", "工匠介绍": "严如珏同志，现任上海地铁第一运营有限公司设施部技术主管，长期致力于车站综合监控系统设备的技术管理及创新工作。她主持完成多项技术革新和科研项目，其中《一种综合后备盘授权保护器》等3项成果获国家专利，技术革新课题《上海轨道交通1号线车站机电设备的智能节能控制研究》等成果显著，获集团嘉奖及上海市工程建设优秀QC成果一等奖等多项荣誉。参与编写《上海轨道交通新线运营设施设备接管验收规范》等技术规程，主编城市轨道交通专业培训教材，培养高技能人才8名，为轨道交通智能化发展作出突出贡献。"}, {"编号": 20250311077, "年份": 2016, "区局": "城投集团", "姓名": "宣建岚", "年龄": 65, "姓名拼音": "Xuan1-Jian4-Lan2", "性别": "男", "工作单位": "上海城投污水处理有限公司石洞口污水处理厂", "工种或工作头衔": "污泥处理工", "领域": "土地混合利用", "行业": "环保", "工匠介绍": "宣建岚，现任石洞口污水处理厂污泥干化焚烧车间主任，上海城投（集团）有限公司首席技师。他领衔的工作室荣获“上海市技能大师工作室”等多项称号。作为污泥干化焚烧技术专家，他完成了50多项设备及零配件国产化工作，将装置运行时间提升50%，并填补了我国污泥处理工种教材和相关技术标准的空白。他带领团队完成技术革新30多项，创造经济效益2967万元，获国家专利10项，培养出技师和高级工16名，为行业发展输送了专业人才。"}, {"编号": 20250311078, "年份": 2016, "区局": "城投集团", "姓名": "魏顶峰", "年龄": 48, "姓名拼音": "Wei4-Ding3-Feng1", "性别": "男", "工作单位": "上海辰山植物园", "工种或工作头衔": "绿化工", "领域": "植物引种", "行业": "环保", "工匠介绍": "魏顶峰，自加入上海辰山植物园以来，以饱满的工作热情和忘我的奉献精神投身于植物引种和栽培养护管理工作中，解决了一系列专业技术难题。在华东植物引种工作中，他通过深入分析上海地区气候和土壤特点，成功将引种栽培成活率从23%提升至90%以上，引种栽培植物达4800种，并摸索出一套成熟的温室大型植物移栽关键技术。在多肉植物研究方面，他通过叶插、根插、横切和竖切繁殖技术，成功繁育了一批濒危物种，并在嫁接实验和环境控制领域取得突破。他还带领团队成功栽培成活十几株仙人掌科巨人柱，成活率达到95%以上，为植物引种保育和创新栽培奠定了坚实基础。魏顶峰共培育出12种多肉植物变异品种和6种适合温室栽培的花灌木，..."}, {"编号": 20250311079, "年份": 2016, "区局": "隧道股份", "姓名": "李建伟", "年龄": 68, "姓名拼音": "Li3-Jian4-Wei3", "性别": "男", "工作单位": "上海隧道工程有限公司机械制造分公司", "工种或工作头衔": "钳工", "领域": "土地混合利用", "行业": "隧道", "工匠介绍": "李建伟，现任上海隧道机械制造分公司总装车间主任、高级技师，长期从事地下隧道施工设备研发工作。在40余年职业生涯中，他参与了上海、南京、宁波、武汉等50多个重大工程及新加坡、印度、香港等海外项目建设，带领团队首创以盾构系统为单元的国产盾构生产线生产方法，研发出超大直径盾构驱动内圆立车设备。他参与制造的产品获国家级重点新产品、中国工业博览会金奖、上海市科技进步一等奖等多项荣誉，个人获评上海首席技师、“上海隧道工匠”等称号。他还成立“隧道股份工匠李建伟工作室”，培养出高级技师8名、高级工32名，为企业输送大批高技能人才。"}, {"编号": 20250311080, "年份": 2016, "区局": "隧道股份", "姓名": "张亮", "年龄": 62, "姓名拼音": "Zhang1-Liang4", "性别": "男", "工作单位": "上海隧道工程有限公司盾构分公司", "工种或工作头衔": "管涵顶进工", "领域": "土地混合利用", "行业": "隧道", "工匠介绍": "张亮，现任上海隧道工程有限公司盾构工程分公司副经理，是我国盾构隧道施工领域的顶尖技术专家。他参与了上海地铁一号线、M8线工程、新加坡地铁703标等多项重大工程，在技术攻关方面取得了卓越成就。作为\"技术领先\"战略的主要践行者，他设计出了\"隧道管片吊具\"，创新了\"水中进洞\"和\"沼气插管释放\"工法，解决了承压水和沼气两大世界级施工难题。他的止水钢板设计现已成为上海地铁施工的标准要求，在M8线工程中更是为企业节省了860万元的拔桩费用。凭借这些突出贡献，张亮荣获了\"上海市杰出技术能手\"、\"学习型技术工人\"、\"上海市重点工程建设功臣\"和\"全国技术能手\"等多项殊荣。"}, {"编号": 20250311081, "年份": 2016, "区局": "电力股份", "姓名": "严琳", "年龄": 42, "姓名拼音": "Yan2-Lin2", "性别": "女", "工作单位": "上海上电电力运营有限公司", "工种或工作头衔": "化学", "领域": "高端装备", "行业": "电力", "工匠介绍": "严琳，女，是上海电力股份有限公司的高级工程师。她2005年进入杨树浦发电厂工作，凭借优异表现迅速成长为化学运行主值。2009年起，她先后参与上电漕泾发电厂百万千瓦机组建设及调试工作，并在2013年担任化学专工，获业主高度评价。她曾获上海电力股份公司“青年五四奖章”、先进个人等荣誉称号，2012年获“上海市第十二届青年岗位技术能手”称号。&#10;&#10;严琳在专业领域表现出色，在中电投集团第一届燃料采制化竞赛中获得化验个人第一名及团体第三名。2014年，她担任上海电力股份有限公司“采制化技能带头人”，并作为教练带领团队在第二届技能竞赛中取得优异成绩。她还致力于人才培养和技术创新，主持开..."}, {"编号": 20250311082, "年份": 2016, "区局": "商用飞机", "姓名": "胡双钱", "年龄": 64, "姓名拼音": "Hu2-Shuang1-Qian2", "性别": "男", "工作单位": "中国商飞上海飞机制造有限公司", "工种或工作头衔": "飞机钣金工", "领域": "民用航空", "行业": "航空", "工匠介绍": "胡双钱作为中国航空制造领域的大国工匠，凭借\"一次做好、缺陷为零\"的质量理念，在36年的职业生涯中完成了数万件飞机零件的加工，始终保持零失误。他参与了运10飞机的研制并见证了其首飞，现为C919大型客机和ARJ21新支线飞机项目的关键技术攻关成员。胡双钱总结出\"对比检查法\"等质量控制方法，强调青年员工必须严格遵守加工标准，不擅自更改工序。作为\"大国工匠\"劳模创新工作室的领军人，他致力于培养\"一岗多能\"的复合型人才，为中国大飞机事业打造具备创新精神和攻坚能力的团队。其事迹曾被中央电视台\"大国工匠\"栏目报道，堪称中国工匠精神的杰出代表。"}, {"编号": 20250311083, "年份": 2016, "区局": "上影集团", "姓名": "张振晖", "年龄": 50, "姓名拼音": "Zhang1-Zhen4-Hui1", "性别": "男", "工作单位": "上海美术电影制片厂有限公司", "工种或工作头衔": "影视动画创作", "领域": "文化", "行业": "工艺美术", "工匠介绍": "张振晖，二级美术设计师，中国电影家协会动画电影工作委员会会员、上海电影家协会会员、上海电视艺术家协会会员，并在上海美术电影专修学校担任分镜设计教师。自1992年入职上海美术电影制片厂以来，张振晖先后担任动画员、动作总监、原画设计师，现主要负责执行导演、人物造型设计及剧组副导演工作。在其职业生涯中，张振晖参与了多部重要作品的制作，其中包括《犹太女孩在上海第一部》（副导演、人物设计）、修复版《邋遢大王奇遇记》（副导演）以及《犹太女孩在上海第二部项链密码》（副导演、人物设计）。"}, {"编号": 20250311084, "年份": 2016, "区局": "宝玉石协会", "姓名": "洪新华", "年龄": 65, "姓名拼音": "Hong2-Xin1-Hua2", "性别": "男", "工作单位": " 弘艺轩玉器工作室", "工种或工作头衔": "玉石雕刻", "领域": "文化", "行业": "工艺美术", "工匠介绍": "洪新华，海派玉雕大师，从艺四十余年，擅长人物雕刻，作品如“弥勒”“刘海”“罗汉”等成为“海派”玉雕标志。他突破传统程式化手法，注重刻画人物神情姿态，使作品生动传神，深受海内外藏家赞誉。洪新华以“新奇特绝”理念创新传统题材，赋予经典作品时代魅力。他培养的弟子已成为“海派”玉雕新生代重要力量。洪新华以琢玉为乐，致力于传承与发展海派玉雕，为中国玉石文化贡献力量。"}, {"编号": 20250311085, "年份": 2016, "区局": "插花花艺协会", "姓名": "朱道义", "年龄": 53, "姓名拼音": "Zhu1-Dao4-Yi4", "性别": "男", "工作单位": "上海静安园林绿化发展有限公司", "工种或工作头衔": "绿化工", "领域": "文化", "行业": "花艺", "工匠介绍": "朱道义，师承插花花艺大师梁胜芳，深耕插花领域二十余年，擅长将自然与艺术结合，创作主题鲜明的作品。他立足传统，研究插花六大法则与空间布局，融合东西方技法，形成独特风格。他曾参与APEC会议、上海静安区花街设计及北京奥运会礼仪用花创作，荣获两项银奖。近期，他被授予全国五一劳动奖章，以表彰其在插花花艺领域的卓越贡献。"}, {"编号": 20250311086, "年份": 2016, "区局": "电力工程协会", "姓名": "陈国庆", "年龄": 65, "姓名拼音": "Chen2-Guo2-Qing4", "性别": "男", "工作单位": "上海电力高压实业有限公司", "工种或工作头衔": "变电检修", "领域": "高端装备", "行业": "电力", "工匠介绍": "陈国庆，作为从事变电检修30余年的资深电力工人，长期参与上海电网建设的基建、技改及变电站定期检修大修工作。近年来，他参与了20千伏会文站35KVGIS设备损坏事故等多次重大抢修任务，作为专业带头人，凭借高超技术和丰富经验，为设备恢复送电赢得宝贵时间。在高压实业公司承接的老旧变电站改造工程中，他提出\"微创式\"外科手术方案，确保了改造期间上海主电网平稳运行。陈国庆还参与制订了大量变电典型设备安装、检修作业指导书和工艺流程，并主编撰写了《LW6型系列液压操动机构特殊故障处理》等论文和技术文件，已成为行业标准。作为电力公司级兼职培训师，他致力于培养变电专业人才，临近退休仍继续为行业贡献毕生所学。"}, {"编号": 20250311087, "年份": 2016, "区局": "焊接协会", "姓名": "卢长春", "年龄": 54, "姓名拼音": "Lu2-Chang2-Chun1", "性别": "男", "工作单位": "中冶宝钢技术服务有限公司第二分公司（中冶宝钢）", "工种或工作头衔": "焊工", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "卢长春，作为杰出的大国工匠，在焊接领域取得了卓越成就。他多次在全国冶金系统焊工比赛中荣获佳绩，并获得\"全国冶金建设行业高级技能专家\"、\"全国冶金建设行业技术能手\"等称号。他发明的管道带水焊接工艺和氩弧焊焊接铅板技术填补了国内空白，参与国家重点项目建设，攻克多项焊接技术难题，创造显著经济效益。他还培养了众多技术骨干，带领团队在全国性比赛中屡获佳绩。卢长春以其精湛技艺和创新精神，为行业发展做出了重要贡献。"}, {"编号": 20250311088, "年份": 2016, "区局": "装饰装修协会", "姓名": "樊成辉", "年龄": 63, "姓名拼音": "Fan2-Cheng2-Hui1", "性别": "男", "工作单位": "上海住总集团建设发展有限公司（浦东新区）", "工种或工作头衔": "泥工匠", "领域": "土地混合利用", "行业": "装饰装修", "工匠介绍": "樊成辉，现任上海住总集团建设发展有限公司项目施工员，专注近现代保护建筑修缮工作。他凭借泥水匠专业背景，参与了\"圣三一堂\"、中山东一路33号外滩源及新天安堂等重要建筑的修缮工程。在修缮过程中，他创新运用测绘放样技术，精准复原建筑历史风貌，获得业内高度认可。中科院院士郑时龄多次现场指导并对其工作给予肯定。樊成辉在文物保护修缮领域积累了丰富经验，掌握多项专业技术，展现了卓越的专业能力，在业界和社会中享有良好声誉。"}, {"编号": 20250311089, "年份": 2017, "区局": "浦东新区", "姓名": "魏钧", "年龄": 46, "姓名拼音": "Wei4-Jun1", "性别": "男", "工作单位": "上海振华重工（集团）股份有限公司长兴分公司", "工种或工作头衔": "焊工", "领域": "港口", "行业": "高端装备", "工匠介绍": "魏钧，焊接技术专家，自2007年加入振华重工以来，凭借精湛技艺和不懈努力，先后取得焊工技师资格及中国CCS6GR、英国6GR、美国ASME等国际权威认证。他在2013年乌克兰BENARDOS杯国际焊工大赛中荣获\"最佳焊件优秀选手\"称号及唯一国际焊工证书。作为公司唯一精通氩弧焊、手工焊和CO2气体保护焊三项技能的电焊工，魏钧带领团队出色完成美国钢桥、港珠澳大桥等多项重大项目焊接任务，焊接检测合格率达100%。他每年为公司创造效益超300万美元，并通过\"魏钧劳模工作室\"和兼职讲师身份培养高技能人才，为中国制造2025战略贡献力量。"}, {"编号": 20250311090, "年份": 2017, "区局": "浦东新区", "姓名": "朱邦范", "年龄": 55, "姓名拼音": "Zhu1-Bang1-Fan4", "性别": "男", "工作单位": "上海浦东建筑设计研究院有限公司", "工种或工作头衔": "建筑设计", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "朱邦范，国家一级注册建筑师、教授级高级工程师，1992年毕业于东南大学建筑学专业。长期担任项目负责人，完成百余项大中型工程，获国家及省部级奖项15项，拥有实用新型专利2项，发表论文12篇。主编行业首部《工程设计技术手册》，推动装配式建筑技术创新与成果转化，主持编制国家及地方规程4部，完成图集5册，参与多项国家级课题研究，取得显著成果。作为住建委特邀讲师，多次开展规范宣贯和专业培训，积极推广技术成果，发挥建筑产业化领域技术支撑作用，促进行业创新发展。"}, {"编号": 20250311091, "年份": 2017, "区局": "浦东新区", "姓名": "侯晓磊", "年龄": 42, "姓名拼音": "Hou2-Xiao3-Lei3", "性别": "男", "工作单位": "上海赛飞航空线缆制造有限公司", "工种或工作头衔": "线束安装", "领域": "民用航空", "行业": "航空", "工匠介绍": "侯晓磊，现任上海赛飞航空线缆制造有限公司高级线束安装设计工程师，是全国技术能手、上海市首席技师、首届大国工匠等荣誉称号的获得者。他主要从事C919大飞机线束安装设计工作，在舱门区域线缆设计上提出创新解决方案，成功解决了线束干涉问题。作为航空线束安装设计领域的领军人才，他还承担起培养青年设计人才的重任，为该领域输送了大量专业人才。侯晓磊以其精湛的技术和不懈的努力，为国产大飞机项目的成功作出了重要贡献。"}, {"编号": 20250311092, "年份": 2017, "区局": "浦东新区", "姓名": "洪程栋", "年龄": 43, "姓名拼音": "Hong2-Cheng2-Dong4", "性别": "男", "工作单位": "上海立悦旅游汽车服务有限公司", "工种或工作头衔": "汽车维修工", "领域": "汽修服务", "行业": "汽车", "工匠介绍": "洪程栋，上海市汽车维修高级技师、首席技师，现任上海立悦旅游汽车服务有限公司技术总监。他精通汽车疑难故障诊断与改装，在2015年中国职业技能大赛中获汽车维修工项目第一名。通过改装国产变速箱成功修复进口客车故障，为公司节省费用10万元以上。他创新优化车辆配置，每百公里柴油消耗节省3.8升，大幅降低污染物排放。洪程栋积极推广绿色维修理念，多次受邀担任汽车职业学校讲师，培养专业人才，为行业转型升级作出积极贡献。他荣获全国技术能手、感动上海年度人物等称号，是上海汽车维修行业的杰出代表。"}, {"编号": 20250311093, "年份": 2017, "区局": "浦东新区", "姓名": "杨致俭", "年龄": 50, "姓名拼音": "Yang2-Zhi4-Jian3", "性别": "男", "工作单位": "幽簧里古琴艺术中心", "工种或工作头衔": "古琴制作", "领域": "文化", "行业": "乐器", "工匠介绍": "杨致俭，上海市非物质文化遗产项目“古琴斫制技艺”代表性传承人，兼任上海七弦古琴文化发展基金会理事长、天下古琴传习中心创始人等职。他秉承传统斫琴工艺，结合现代科技，注重细节与创新，每张琴斫制周期长达2至5年。杨先生深入研究传世古琴，以科学量化方法优化制琴工艺，致力于传承传统技艺并融入时代特色，作品兼具传统底蕴与现代科技创新。他坚守“传承传统源头，补充当代支流”的使命，追求“质言古意，文变今情”的艺术境界，为古琴制作领域作出重要贡献。"}, {"编号": 20250311094, "年份": 2017, "区局": "徐汇区", "姓名": "钱文昊", "年龄": 50, "姓名拼音": "Qian2-Wen2-Hao4", "性别": "男", "工作单位": "上海市徐汇区牙病防治所", "工种或工作头衔": "医生", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "钱文昊，作为徐汇区优秀共产党员，长期致力于口腔医学领域，累计获得上海市先进工作者、上海市五一劳动奖章等三十余项荣誉称号。他首创显微根管诊疗技术，填补国内空白，并牵头完成四项技术创新，使疑难病例治愈率提升至95.2%。科研方面，他联合中科院开展研究，以第一作者身份发表高影响因子论文，并获上海市科技进步二等奖等多项荣誉。钱文昊主持上海市自然科学基金等课题，主编专著3本，担任中华口腔医学会委员等职务。其创新技术为患者节省医疗费用超5000万元，获院士联名表扬。"}, {"编号": 20250311095, "年份": 2017, "区局": "徐汇区", "姓名": "童庆", "年龄": 47, "姓名拼音": "Tong2-Qing4", "性别": "男", "工作单位": "万达信息股份有限公司", "工种或工作头衔": "系统研发", "领域": "系统建设", "行业": "信息", "工匠介绍": "童庆，高级工程师，现任万达信息股份有限公司云计算中心项目总监，长期深耕城市信息化领域，带领团队荣获上海市文明班组称号。他参与国家及上海市科研项目15项，拥有一项发明专利，发表论文15篇，出版专著，受聘复旦大学兼职导师。主持多个重大投资项目，推动智慧城市建设。童庆获上海市科技系统优秀共产党员、优秀技术带头人、软件行业标兵等荣誉称号，其团队创新产品屡获国家和省部级奖项。"}, {"编号": 20250311096, "年份": 2017, "区局": "长宁区", "姓名": "何东仪", "年龄": 57, "姓名拼音": "He2-Dong1-Yi2", "性别": "男", "工作单位": "上海市光华中西医结合医院", "工种或工作头衔": "医师", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "何东仪，现任上海市光华中西医结合医院副院长、关节内科主任及上海市中医药大学博士生导师。作为全国第四批名老中医师承班优秀继承人，他长期致力于中西医结合治疗风湿性疾病的研究。在他的带领下，关节内科学组成为国家中医药管理局\"十一五、十二五\"风湿病重点专科，并挂牌为多个上海市级关节病诊疗基地。该专科专注于中医药防治尪痹、大偻和痛风的研究，研发并注册了7种院内制剂，其中消痹膏获国家发明专利。专科规模及就诊人次在上海乃至华东地区名列前茅。何东仪主持国家自然科学基金等课题十余项，累计获经费资助1000余万元，多次荣获上海市中西医结合科技奖。他还在国内外期刊发表论文100余篇，其中2篇在Nature..."}, {"编号": 20250311097, "年份": 2017, "区局": "普陀区", "姓名": "颜桂明", "年龄": 62, "姓名拼音": "Yan2-Gui4-Ming2", "性别": "男", "工作单位": "上海联合拍卖有限公司", "工种或工作头衔": "玉石雕刻", "领域": "文化", "行业": "工艺美术", "工匠介绍": "颜桂明,上海非物质文化遗产项目\"海派玉雕\"代表性传承人,专业从事玉石雕刻40余年。他曾荣获高级工艺美术师、上海工艺美术大师、中国玉石雕刻大师、上海特级大师、上海海派特级大师等称号,并被聘为中国工艺美术馆定制的国家级珍品大型水晶雕刻作品《地藏王菩萨》创作艺术委员会成员。其作品如和田白玉\"瑞兽印章\"、新疆仔料\"莲年有余\"及白玉籽料《济公与伏虎罗汉》均被中国工艺美术馆收藏。2013年,他成功申报上海市传统工艺美术技艺《翡翠巧雕技艺》,2008年获\"百花玉缘杯\"中国玉石雕精品奖金奖,论文《翡翠鼻烟瓶的创新技艺和出位之思》已出版。颜桂明还积极参与慈善公益活动,担任中国工艺美术协会玉石艺术专业委员会..."}, {"编号": 20250311098, "年份": 2017, "区局": "虹口区", "姓名": "夏银桂", "年龄": 61, "姓名拼音": "Xia4-Yin2-Gui4", "性别": "男", "工作单位": "上海埃波激光仪器有限公司", "工种或工作头衔": "灯工制造师", "领域": "高端装备", "行业": "高端装备", "工匠介绍": "夏银桂，男，1983年进入上海玻璃仪器一厂，师从灯工师傅提前满师，后考入上海立信会计专科学校夜大学。1993年加入中国共产党，1995年被选派至激光军工车间，从事激光管、侧滑仪等产品研发生产。2003年参与公司申请实用新型专利，2009年参与国防专利研发，2014年修订国军标《飞机用玻璃侧滑仪规范》，主持制订《飞机用圆型玻璃水准泡规范》。夏银桂长期致力于军工产品研发，在侧滑仪和水准泡领域掌握核心技术，实现国产替代，为国防建设作出重要贡献，展现卓越技术能力和责任感。"}, {"编号": 20250311099, "年份": 2017, "区局": "杨浦区", "姓名": "毛蔚瀛", "年龄": 47, "姓名拼音": "Mao2-Wei4-Ying2", "性别": "男", "工作单位": "上海易城工程顾问股份有限公司", "工种或工作头衔": "设计师", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "毛蔚瀛，我国城市规划领域的杰出代表，曾在上海同济大学攻读硕士学位并获优秀党员、优秀学生干部称号。他创立上海易城工程顾问有限公司，主持多个国际城市规划项目并屡获大奖，包括锡东新城国际竞标第一名、哥本哈根Nordhavnen北港项目优秀奖及长兴岛郊野公园规划第一名等。毛蔚瀛积极推动国内城镇化发展，发起并筹建中国城镇化促进会城镇规划专业委员会，编制《大规划：城市与产业》等专著，为行业提供理论支持。他还响应国家战略，在江西南昌建设\"中德工业4.0产业园\"，推动制造业转型升级。毛蔚瀛及其团队积极履行社会责任，连续多年参与公益捐助，并向同济大学捐赠1000万元支持创新创业。"}, {"编号": 20250311100, "年份": 2017, "区局": "黄浦区", "姓名": "陈林声", "年龄": 60, "姓名拼音": "Chen2-Lin2-Sheng1", "性别": "男", "工作单位": "上海陈林声美容美发有限公司", "工种或工作头衔": "美发\t", "领域": "文化", "行业": "美容美发", "工匠介绍": "陈林声，国家级美发大师，职业生涯中创作发表了\"春燕归来\"、\"梦之魅\"等20余款经典发型作品，获国内外20多项大奖。1995年获第20届亚洲美发大赛中国赛区\"晚宴发型\"冠军，次年获评上海市劳动模范。他总结出独特的\"林声发型设计六法\"，培养出80余名技师和50余名高级技师，主编国家职业资格培训教程。2014年入选上海市首席技师资助计划，2015年获上海技能大师工作室称号，2016年任世界技能大赛上海赛区美发项目总教练。他还连续担任第7届至第18届上海国际美发美容美甲邀请赛执行主席，为推动行业发展做出重要贡献。"}, {"编号": 20250311101, "年份": 2017, "区局": "静安区", "姓名": "吴公保", "年龄": 65, "姓名拼音": "Wu2-Gong1-Bao3", "性别": "男", "工作单位": "上海静安建筑装饰实业股份有限公司", "工种或工作头衔": "建筑修缮", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "吴公保，1979年参加工作，19岁进入静安区房地局系统成为一名房屋修缮工人，视木工技术为工匠精神的修行，40余年从木工成长为历史建筑保护事业部领头羊。他参与了上海外滩海关钟楼、中共二大会址纪念馆等国家重点文物及优秀历史建筑修缮，项目获上海市建设工程“红花杯”优质工程奖、QC奖。他创建的“吴公保工匠工作室”通过师徒传承培养接班人，致力于传统技艺的传承发展。"}, {"编号": 20250311102, "年份": 2017, "区局": "静安区", "姓名": "吴昊", "年龄": 37, "姓名拼音": "Wu2-Hao4", "性别": "女", "工作单位": "上海雷允上药业西区有限公司", "工种或工作头衔": "中药调剂员", "领域": "文化", "行业": "医药卫生", "工匠介绍": "吴昊，上海雷允上药业西区有限公司中药调剂员，执业药师。她以“精益求精，追求卓越”的态度，练就了“一抓准”、“蒙眼识药”、“万帖无差错”的技能，先后获得全国中药行业职工特有技能竞赛二等奖、上海市技术能手、静安工匠等多项荣誉。她不仅热诚服务顾客，还积极发挥传帮带作用，培养出优秀青年团队，为中医药文化发展做出了突出贡献。"}, {"编号": 20250311103, "年份": 2017, "区局": "静安区", "姓名": "陈健", "年龄": 65, "姓名拼音": "Chen2-Jian4", "性别": "男", "工作单位": "上海鸿翔制衣有限公司", "工种或工作头衔": "服装裁剪", "领域": "文化", "行业": "纺织服装", "工匠介绍": "陈健，上海鸿翔制衣有限公司技术总监，获评“静安工匠”。他虽无专业学历，却凭借极高悟性，擅长通过照片精准裁剪制作复杂服装，深受客户好评。曾参与上海APEC会议各国领导人服装定制工作，凭借精湛技艺圆满完成任务。从业40年，始终坚守一线，致力于传授传统制作技艺，严格把控质量，确保品牌声誉。面对质量问题，他坚持返工并指导年轻技工，彰显工匠精神。"}, {"编号": 20250311104, "年份": 2017, "区局": "宝山区", "姓名": "杨前", "年龄": 59, "姓名拼音": "Yang2-Qian2", "性别": "男", "工作单位": "中国二十冶集团有限公司建筑分公司", "工种或工作头衔": "技术管理", "领域": "土地混合利用", "行业": "钢铁冶金", "工匠介绍": "杨前，1982年参加工作，1990年起从事工程技术管理及现场实施工作，长期致力于深基坑及降水领域的施工与技术管理工作。在职期间，他完成了机械制造及经济管理专业的选修学习，分别于1990年和2004年获得机械专业中专学历和经济管理专业大专学历。&#10;&#10;在技术领域，杨前取得了显著成就：主持完成省部级科技成果鉴定项目13项，其中多项达到国际先进或国内领先水平；获国家知识产权局发明专利授权19项、实用新型专利授权57项。他荣获中冶集团科学技术奖2项，其中包括技术发明一等奖1项、冶金科学技术一等奖1项；上海市技术发明二等奖1项、优秀发明奖及职工技术创新成果铜奖7项、银奖2项、金奖1项；..."}, {"编号": 20250311105, "年份": 2017, "区局": "宝山区", "姓名": "周建华", "年龄": 56, "姓名拼音": "Zhou1-Jian4-Hua2", "性别": "男", "工作单位": "上海宝隆宾馆有限公司宝隆宾馆", "工种或工作头衔": "烹饪", "领域": "餐饮", "行业": "餐饮", "工匠介绍": "周建华，现任上海宝隆宾馆有限公司行政副总厨，是注册中国烹饪大师和“上海工匠”。他精通各类菜系制作和厨房管理，曾代表上海赴新加坡、香港参与上海菜推广活动，并获“金牛奖”“状元杯”优秀人才、迎世博国际美食艺术大赛特金奖等多项荣誉。作为宝隆宾馆技师工作室首席技师，他带领团队创办的“周建华技能大师工作室”获上海市人社局认定。他秉持“深耕细作重匠心·身体力行传帮带”理念，为提升宝隆餐饮品牌、弘扬中国饮食文化做出突出贡献。"}, {"编号": 20250311106, "年份": 2017, "区局": "宝山区", "姓名": "顾惠明", "年龄": 66, "姓名拼音": "Gu4-Hui4-Ming2", "性别": "男", "工作单位": "上海济光职业技术学院建筑工程学院", "工种或工作头衔": "木工", "领域": "文化", "行业": "建筑", "工匠介绍": "顾惠明,作为明恒建筑装潢有限公司的高级技师,在木工领域享有盛誉。他曾参加市级技能竞赛并荣获名次,创办了多期高级木工班,培养了数十名技师和高级技师。多年来,他担任木工考评组副组长、首席考评员及市竞赛副裁判长,参与部颁标准编写及教学片编导,成为行业领军人物。在木工生涯中,他解决了多项技术难题,如螺旋形旋转楼梯的计算方法、古建筑格扇快速划线法等。他致力于传统文化传承,租用场地收藏研究明清家具,为技艺传承作出重要贡献。"}, {"编号": 20250311107, "年份": 2017, "区局": "闵行区", "姓名": "陆忠明", "年龄": 59, "姓名拼音": "Lu4-Zhong1-Ming2", "性别": "男", "工作单位": "大金空调（上海）有限公司", "工种或工作头衔": "钳工", "领域": "高端装备", "行业": "高端装备", "工匠介绍": "陆忠明，大金空调（上海）有限公司首席技师、国家级技能大师工作室领头人。从业二十余年，他主持完成多项技术革新与设备改造，累计为企业节约经费千余万元。作为设备维护领域专家，他成功攻克多项技术难题，实现多项进口设备部件的国产化替代。在生产效率提升与节能改造方面，他主导完成了多项技术改善，年均节约经费百余万元。作为技能大师工作室负责人，他培养了大批高技能人才，多人荣获省市技术能手称号。他还兼任上海开放大学兼职讲师，为社会技能人才培养作出积极贡献。"}, {"编号": 20250311108, "年份": 2017, "区局": "闵行区", "姓名": "翟念卫", "年龄": 63, "姓名拼音": "Di2-Nian4-Wei4", "性别": "男", "工作单位": "上海翟倚卫文化发展有限公司", "工种或工作头衔": "玉雕", "领域": "文化", "行业": "工艺美术", "工匠介绍": "翟念卫，中国玉雕大师，上海市工艺美术大师，国家级非物质文化遗产海派玉雕代表性传承人。其艺术成就丰硕，多次获\"天工奖\"\"神工奖\"\"百花奖\"\"玉龙奖\"等金奖，并于2010年成为海派玉雕非遗传承人，2012年获中国国家艺术大师称号。作品《云台清曲》《云带钟声》随中国探月工程遨游太空并成功返回，开创玉雕艺术品太空之旅先河。他曾受邀参加上海世博会、中国嘉德讲台等重要活动，并在美国洛杉矶、西班牙马德里、阿联酋迪拜等多个国际场合展示作品。其创作的《别寻方外去》被大英博物馆收藏，艺术影响力遍及海内外。2016年，他荣膺\"中国国匠\"称号及\"闵行当代工匠\"称号，同年担任《华人艺术家》杂志艺术总监，在工艺美术..."}, {"编号": 20250311109, "年份": 2017, "区局": "闵行区", "姓名": "巩洪亮", "年龄": 44, "姓名拼音": "Gong3-Hong2-Liang4", "性别": "男", "工作单位": "上海紫丹食品包装印刷有限公司", "工种或工作头衔": "印刷", "领域": "文化", "行业": "高端装备", "工匠介绍": "巩洪亮，内蒙古轻工业职业学院印刷技术专业毕业，2002年加入紫丹印务公司，现为制造部经理。他从普通柔印机长成长为行业专家，提出百余项设备改进方案，将柔印生产效率从3万米/班提升至9万米/班。他整合复杂生产流程，建成国内最高效印刷涂蜡生产线，节省操作人员26人，年成本节约近200万元。他曾在上海印刷行业技能竞赛中获得第一名，作为唯一能在无辅助设备情况下完成老设备柔性模版粘贴的选手，展现了高超技术。他多次荣获\"优秀员工\"\"利润贡献大奖\"等荣誉，并连续六届（2012-2018年）获得紫江集团\"金点子奖\"及\"金点子特别贡献奖\"。"}, {"编号": 20250311110, "年份": 2017, "区局": "闵行区", "姓名": "李强涛", "年龄": 38, "姓名拼音": "Li3-Qiang2-Tao1", "性别": "男", "工作单位": "深圳中广核工程设计公司上海分公司", "工种或工作头衔": "工艺系统设计", "领域": "高端装备", "行业": "高端装备", "工匠介绍": "李强涛，毕业于四川大学核工程与核技术专业，长期投身于核能领域的工程技术研发与系统调试工作。他提出了9项合理化建议，其中5项涉及节能减排，为公司创造经济效益2588.6万元，并总结出12项先进操作法。此外，他拥有3项国家发明专利和5项实用新型专利，参与了9项科研课题，并发表8篇科技创新论文，其中1篇在第26届太平洋地区核能大会上宣读，另有2篇发表于核心期刊。&#10;&#10;李强涛先后获得上海市闵行区李强涛劳模（职工）创新工作室、首届中国（上海）国际发明创新博览会铜奖、闵行区职工科技创新英才及闵行区职工科技创新英才项目二等奖等多项荣誉。其QC成果分别获得国家工程建设优秀QC成果一等奖和二..."}, {"编号": 20250311111, "年份": 2017, "区局": "嘉定区", "姓名": "李建钢", "年龄": 67, "姓名拼音": "Li3-Jian4-Gang1", "性别": "男", "工作单位": "上海古猗园小笼食品有限公司", "工种或工作头衔": "厨师", "领域": "餐饮", "行业": "餐饮", "工匠介绍": "李建钢，国家级中式烹调技师、国家级中式面点高级技师、南翔小笼第六代传人。作为百年企业上海古猗园小笼食品有限公司董事长，他带领企业营业额从1997年的300万元增长至2015年的3000万元。他创办的大师工作室注重技艺传承与人才培养，为行业输送了多名优秀厨师。他曾荣获弘扬中华饮食文化成就奖、传统名点誉满申城奖、全国餐饮业十大名厨等多项殊荣，致力于将南翔小笼文化传承发扬光大。"}, {"编号": 20250311112, "年份": 2017, "区局": "金山区", "姓名": "曹秀文", "年龄": 69, "姓名拼音": "Cao2-Xiu4-Wen2", "性别": "女", "工作单位": "中国农民画村", "工种或工作头衔": "画师", "领域": "文化", "行业": "工艺美术", "工匠介绍": "曹秀文，一位杰出的农民画艺术家，自1975年起潜心创作农民画，累计创作作品300余件，其中20余幅作品在全国及上海市各类评比中获奖。她的代表作《采药姑娘》《硕果》《放风筝》分别荣获上海市农民画一等奖、上海国际科学与艺术展一等奖、中国农民画金奖。她的作品《春意》和《渔家乐》曾在2010年上海世博会主题馆展出。曹秀文致力于农民画的传承与发展，培养了20多位本地农民画创作者，并为少年学生提供了近千人次的艺术培训，多次参与国际文化交流。她先后荣获全国\"三八\"红旗手、上海市政协委员、上海市非物质文化遗产项目代表性传承人、全国\"十大\"优秀农民画家等荣誉称号。"}, {"编号": 20250311113, "年份": 2017, "区局": "松江区", "姓名": "常延沛", "年龄": 44, "姓名拼音": "Chang2-Yan2-Pei4", "性别": "男", "工作单位": "上海中联重科桩工机械有限公司", "工种或工作头衔": "专业技术人员", "领域": "旋挖钻机", "行业": "高端装备", "工匠介绍": "常延沛，中联重科资深技术专家，长期致力于旋挖钻机产品研发、生产和市场推广，主持开发ZR280至ZR600等七款大型旋挖钻机，填补型号空白，推动企业技术进步。其个人拥有的47项专利中，包含16项发明专利，并成功攻克旋挖钻机在微风化岩层施工的技术难题，推动ZR420项目被认定为上海市高新技术成果转化项目。作为技术带头人，他培养了一支结构完整、技术过硬的研发团队，并带领团队实现近3年旋挖钻机新增销售超400台，产值20亿元以上，利税突破3亿元。通过持续创新和市场推广，显著提升中联重科旋挖钻机国内市场占有率，使其成为行业主导力量。"}, {"编号": 20250311114, "年份": 2017, "区局": "松江区", "姓名": "黄拥军", "年龄": 54, "姓名拼音": "Huang2-Yong1-Jun1", "性别": "男", "工作单位": "上海江河幕墙系统工程有限公司", "工种或工作头衔": "建筑幕墙", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "黄拥军，现任上海江河幕墙系统工程有限公司总工程师，主持并参与了沙特国王塔、武汉绿地中心、上海中心大厦等多个标志性建筑幕墙工程项目。他积极推动节能设计理念与新技术应用，使江河集团跃升为行业领军企业。参与起草《建筑幕墙抗震性能振动台试验方法》等多部行业标准，并主编出版《金属与石材幕墙工程实用技术》。主持完成穿条式隔热铝合金明框幕墙等多项专利研发，在幕墙技术领域成果斐然。他还培养了一批优秀技术人才，为行业输送了重要力量。"}, {"编号": 20250311115, "年份": 2017, "区局": "松江区", "姓名": "钱月芳", "年龄": 70, "姓名拼音": "Qian2-Yue4-Fang1", "性别": "女", "工作单位": "上海松江顾绣研究所", "工种或工作头衔": "刺绣艺术大师", "领域": "文化", "行业": "工艺美术", "工匠介绍": "钱月芳，作为非物质文化遗产顾绣的代表性传承人，多年来致力于技艺传承与创新。她在上海松江大江职校授课，培养的学生均已成为工艺美术师，并在重要展会中展出作品获得好评。钱月芳本人创作了20多幅顾绣作品，多次参展并荣获13项金奖、4项银奖等殊荣。其中，2016年更是一举斩获三项大奖。她的代表作《菊花图》和《春水凫鷖图》在2015年米兰世博会上分别获得世博金奖和传统精品金奖，彰显了顾绣文化的国际影响力。钱月芳的事迹还被多家报刊杂志报道，成为顾绣艺术传承的重要力量。"}, {"编号": 20250311116, "年份": 2017, "区局": "崇明区", "姓名": "施克松", "年龄": 69, "姓名拼音": "Shi1-Ke4-Song1", "性别": "男", "工作单位": "上海崇明百叶水仙花专业合作社", "工种或工作头衔": "农艺工", "领域": "水仙栽培", "行业": "农业", "工匠介绍": "施克松，作为崇明水仙百年世家——施家花厢的传承人，长期以来致力于传统技艺的传承与创新，以精湛的技术推动了当地水仙产业的发展，并在实践中贡献突出。在水仙培育方面，施克松突破传统技术局限，成功改良了水仙球茎的培育技术，使产品规格大幅提升，不仅显著增强了市场竞争力，也为当地农民增收提供了有力支撑。同时，他积极拓展产业链，通过建立合作社、开展技术培训等方式，带动更多农户参与水仙种植与销售，促进了当地经济的可持续发展。施克松凭借其卓越的贡献，先后获得“全国劳模”“大国工匠”等多项荣誉称号，充分展现了我国传统工艺传承人精益求精的工匠精神与责任担当。"}, {"编号": 20250311117, "年份": 2017, "区局": "机电", "姓名": "华建国", "年龄": 65, "姓名拼音": "Hua2-Jian4-Guo2", "性别": "男", "工作单位": "上海电气核电设备有限公司", "工种或工作头衔": "钳工", "领域": "高端装备", "行业": "机电", "工匠介绍": "华建国同志，自1980年起在上锅厂工作，后转入上核公司，长期从事精密加工工作，擅长工夹具设计制造、机加工疑难问题解决等。他在国内率先采用加工中心进行反应堆压力容器主接管车铣加工，完成了国内首根船用曲轴最终机加工，成功实现世界首台AP1000堆芯补水箱机加工等多项创新成果。在核电领域，他参与了全国90%以上核电发电机组的制造与现场抢修及技术指导工作，特别是在三代EPR、AP1000堆型等关键部件的修缮中，创新性地研发了领先的修复技术，被同行誉为\"金属雕刻家\"。他主持完成了多项重要课题，并致力于关键紧缺岗位人员培养，为大型机床操作人员的成长做出了积极贡献。"}, {"编号": 20250311118, "年份": 2017, "区局": "机电", "姓名": "赵黎明", "年龄": 62, "姓名拼音": "Zhao4-Li2-Ming2", "性别": "男", "工作单位": "上海锅炉厂有限公司", "工种或工作头衔": "电焊工", "领域": "高端装备", "行业": "机电", "工匠介绍": "赵黎明，上海锅炉厂有限公司首席技师，国家级\"赵黎明技能大师焊接技术工作室\"负责人。从业三十余年，主持完成\"HRSG余热锅炉T91材料管座全氩焊接\"等十多项焊接技术攻关，获多项国家专利授权与技术成果奖。发表多篇技术论文，其中7篇入选《技术工人先进操作法选编》。推广\"左右手氩弧焊\"等绝技，显著提升焊接质量。培养高级技师4名，焊接高技能人才100余名，指导学员多次在全国焊接比赛中获奖，并组织多项先进操作法推广活动。"}, {"编号": 20250311119, "年份": 2017, "区局": "机电", "姓名": "原金疆", "年龄": 47, "姓名拼音": "Yuan2-Jin1-Jiang1", "性别": "男", "工作单位": "上海汽轮机厂", "工种或工作头衔": "钳工", "领域": "高端装备", "行业": "机电", "工匠介绍": "原金疆，上海汽轮机厂高级技师，1983年技校毕业后进入上海汽轮机厂工作。2005年调入燃气轮机车间，负责重型燃气轮机精总装工作，期间三次赴德国西门子柏林工厂学习燃气轮机装配技术，回国后参与了厂内几乎所有重型燃气轮机的装配工作。他带领团队攻克燃气轮机装配技术难题，发明多种专用工装设备，参与《E级燃气轮机压气机叶片冲铆技术攻关》《F级燃气轮机转子一次落缸技术》等重点项目，推动燃气轮机装配制造水平和效率显著提升。目前E级、F级燃气轮机全面实现100%国产化装配。近年来，他带领团队开展燃气轮机售后服务，为机组稳定高效运行提供技术保障，推动我国燃气轮机事业发展。"}, {"编号": 20250311120, "年份": 2017, "区局": "轻工", "姓名": "朱熙华", "年龄": 43, "姓名拼音": "Zhu1-Xi1-Hua2", "性别": "男", "工作单位": "上海造币有限公司", "工种或工作头衔": "钱币设计", "领域": "货币", "行业": "工艺美术", "工匠介绍": "朱熙华先生，出生于上海，毕业于上海戏剧学院舞美系舞台设计专业，现为上海造币有限公司工艺美术师，兼任中国币章专业委员会委员等职。他被誉为中国钱币设计领域的“标王”，已完成超过100个面的纪念币设计雕刻工作。作品涵盖中国抗日战争胜利70周年、熊猫币发行35周年等重大题材。2010年，其设计作品获两项国家外观设计专利。国际上，他连续四年获“克劳斯世界硬币大赛”最佳金银币奖提名，并多次获得中国印钞造币总公司设计大奖。朱熙华先生曾荣获“中国印钞造币行业劳动模范”、上海“轻工工匠”等荣誉称号，被誉为中国钱币设计领域的领军人物和行业楷模。"}, {"编号": 20250311121, "年份": 2017, "区局": "纺织", "姓名": "冯忠耀", "年龄": 59, "姓名拼音": "Feng2-Zhong1-Yao4", "性别": "男", "工作单位": "上海德福伦化纤有限公司", "工种或工作头衔": "技术", "领域": "先进材料", "行业": "纺织服装", "工匠介绍": "冯忠耀，多年来致力于功能性纤维领域研究，主持承担20余项国家及市级科研项目，开发功能性纤维产品六大系列100多个品种，拥有数十项自主知识产权。他主导制订1项国家标准、牵头制定6项行业标准，正在制定3项行业标准，同时制订22项企业标准。冯忠耀发表论文5篇，申请专利45项，其中发明专利11项、实用新型专利12项。他曾获2014年国家重点新产品证书、上海市科技进步二等奖、三等奖等多项荣誉，先后被评为上海市企业技术创新先进工作者、金山区科技工作先进个人、上海市劳动模范、金山区领军人才等，并连续获得上海纺织集团科技带头人称号。他主持的“生物质功能化凉爽型聚酯纤维技术创新与成果转化”项目获981万元..."}, {"编号": 20250311122, "年份": 2017, "区局": "纺织", "姓名": "雍飞", "年龄": 38, "姓名拼音": "Yong1-Fei1", "性别": "男", "工作单位": "上海纺织时尚定制服饰有限公司", "工种或工作头衔": "服装设计制版", "领域": "文化", "行业": "纺织服装", "工匠介绍": "雍飞，现任PROLIVON（普洛利文）公司生产部副经理，是一位在服装制版领域具有突出贡献的大国工匠。他入职以来，每年完成制版工作超500件，并创新研发了200多个品牌经典畅销版型。他带领团队与意大利设计团队合作，改良袖型设计，使版型更立体，实现了服装合体修身与舒适性的统一。他还成立\"成衣版型设计\"技师创新工作室，培养7名年轻版师，推动技术传承与创新。&#10;&#10;雍飞荣获多项荣誉，包括\"全国十佳服装制版师\"第一名、全国财贸轻纺烟草行业技术标兵、全国纺织工业劳动模范等称号，并以他的名字命名创新工作室。在他的引领下，普洛利文品牌连续三届受邀参加中国国际服装服饰博览会。"}, {"编号": 20250311123, "年份": 2017, "区局": "医药", "姓名": "毕琳丽", "年龄": 51, "姓名拼音": "Bi4-Lin2-Li4", "性别": "女", "工作单位": "上海上药华宇药业有限公司", "工种或工作头衔": "中药饮片质量员", "领域": "生物医药", "行业": "医药卫生", "工匠介绍": "毕琳丽，系上海上药华宇药业有限公司高级中药质检师、执业药师。她凭借丰富的专业知识和实践经验，成功阻止多种伪品入库，保障用药安全。2013年成立首席技师工作室，专注提升技能水平和促进企业发展，先后获得4个科研项目立项，累计获政府资助840万元。其中\"沪产西红花引种栽培\"项目获上海市中医药科技二等奖，并参与国家标准制定工作。2015年获上药集团劳模创新工作室和\"毕琳丽上海市技能大师工作室\"两项称号，2017年被授予上海市劳模工作室。她积极参与\"高师带徒\"活动，培养多名骨干人才。以精湛技能、严谨态度和无私奉献精神，荣获全国五一劳动奖章等多项荣誉。"}, {"编号": 20250311124, "年份": 2017, "区局": "电力工业", "姓名": "谢邦鹏", "年龄": 43, "姓名拼音": "Xie4-Bang1-Peng2", "性别": "男", "工作单位": "国网上海市电力公司浦东供电公司", "工种或工作头衔": "继电保护", "领域": "高端装备", "行业": "电力", "工匠介绍": "谢邦鹏，清华大学博士毕业，现任国网上海浦东供电公司配电运检室副主任，长期扎根基层生产一线。在世博保电、核心区世界一流配电网建设、迪士尼保供电等重大任务中表现突出，获\"全国五一劳动奖章\"\"上海市劳动模范\"\"国家电网公司劳动模范\"等多项荣誉。&#10;&#10;谢邦鹏在继电保护和配电自动化领域具有深厚技术功底，主持参与了线损管理、无功补偿等十余项创新性科技项目研究，获上海市科技进步三等奖等多项荣誉。他独立研发的\"大电流试验万用组合短接工具\"等创新成果获多项专利授权并推广应用。同时，他带领团队发表中英文科技论文十余篇，获得发明专利授权9项、实用新型专利授权32项。&#10;&#10;作为劳模宣..."}, {"编号": 20250311125, "年份": 2017, "区局": "电力工业", "姓名": "王和杰", "年龄": 48, "姓名拼音": "Wang2-He2-Jie2", "性别": "男", "工作单位": "国网上海市电力公司检修公司", "工种或工作头衔": "变电运行", "领域": "高端装备", "行业": "电力", "工匠介绍": "王和杰，国网上海检修公司特高压交直流运检中心副主任，高级技师，拥有20余年电力系统工作经历，荣获上海市首席技师、央企先进职工、上海市劳动模范、全国电力行业技术能手、全国青年岗位能手标兵等多项称号，并于2015年被授予\"全国劳动模范\"称号。他在500千伏世博地下站工程等重大项目中表现突出，带领团队攻克多项生产难题。2012年，他牵头成立\"王和杰直流技术创新工作室\"，现有成员32人，致力于特高压运维、交直流运行等领域的技术攻关。工作室已完成科技项目6项，在学术期刊发表论文近90篇，申请专利48项（含发明专利31项），授权15项，创造间接经济效益700万元。2015年，该工作室被命名为\"上海市..."}, {"编号": 20250311126, "年份": 2017, "区局": "宝武", "姓名": "洪华", "年龄": 52, "姓名拼音": "Hong2-Hua2", "性别": "女", "工作单位": "宝山钢铁股份有限公司电厂", "工种或工作头衔": "仪表", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "洪华，是宝钢电厂仪表控制专业的女性技术工人，也是宝钢唯一的女性工人发明家和技能专家。她创立了上海市首批“五一巾帼创新工作室”，并以“精准检测与校整”技术填补了电厂设备精准管理空白，近三年创造效益1.52亿元。洪华拥有企业核心技术秘密40项，授权专利36项（含发明专利18项），获国际发明展银奖、铜奖及全国发明展银奖等奖项。她先后获得宝钢十大杰出青年、曾乐创新奖、巾帼奖、敬业奖、工人发明家和“上海市巾帼建功标兵”等多项荣誉。作为技师协会理事和宝钢创新协会秘书长，洪华积极推动职工成长，并为青年员工开展技术培训，培养了50余名技术骨干。她表示将继续为钢铁强国梦贡献力量。"}, {"编号": 20250311127, "年份": 2017, "区局": "宝武", "姓名": "杨磊", "年龄": 57, "姓名拼音": "Yang2-Lei3", "性别": "男", "工作单位": "宝武特冶锻造厂", "工种或工作头衔": "特种冶金高级技师", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "杨磊，高级技师，现任宝钢特钢有限公司特材事业部锻造首席操作、技能专家。从事锻造工作三十余年，掌握\"一锤定音\"绝技。他研发镦粗工具和装置，大幅提高生产效率并取得多项专利，填补国内空白。主持《大型高温合金铸锭和锻件工艺研究》获上海市科技进步二等奖，参与多项国防及航空航天项目。培养高技能人才，主编培训教材，制定岗位规程，累计创造经济效益8,646万元。获得发明专利3项、实用新型专利12项、先进操作法38项及国际发明展奖项等。"}, {"编号": 20250311128, "年份": 2017, "区局": "宝武", "姓名": "季益龙", "年龄": 51, "姓名拼音": "Ji4-Yi4-Long2", "性别": "男", "工作单位": "上海梅山钢铁股份有限公司炼铁厂", "工种或工作头衔": "电气点检", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "季益龙，高级工程师，从食品专业大专生成长为梅钢电气点检首席专家、宝钢工人发明家，荣获上海市终身学习白玉兰奖。他主持完成梅钢高炉、新焦炉等十多个核心系统工艺模块的软件开发，打破设计院技术封锁，实现高炉电气设备故障连续两年为零，焦炉自动率提升至97.5%，环保设备开动率达100%。主持科研项目25项，发表科技论文2篇，创造经济效益超2000万元，拥有发明专利等创新成果153项，16项获奖，8项填补国内技术空白。其\"实现焦炉高环保、高效率的控制应用技术\"获2016年上海市科技进步三等奖。创立的季益龙创新工作室累计取得创新成果320项，培养\"全国技术能手\"等优秀人才。"}, {"编号": 20250311129, "年份": 2017, "区局": "宝冶集团", "姓名": "钱国", "年龄": 55, "姓名拼音": "Qian2-Guo2", "性别": "男", "工作单位": "宝冶集团有限公司高炉工程事业部", "工种或工作头衔": "电工", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "钱国，中共党员，大专学历，电气和计算机专业，现任上海宝冶高炉事业部电气技术负责人。从事电气设备安装28年，参与宝钢、湛钢等多座高炉的建设和大修，创国内最短工期纪录并达国际领先水平，获央视\"高炉传奇\"称号。带领团队获发明专利1项，2项专利申请中，实用新型专利3项，创新技术节成本千万元。自主研发电气电缆信息管理软件，带领团队多次获全国冶金行业QC活动奖励。参建9座高炉获申安杯奖和优质奖，电气安装调试工法被评为冶金行业部级工法。"}, {"编号": 20250311130, "年份": 2017, "区局": "高桥石化", "姓名": "张华", "年龄": 57, "姓名拼音": "Zhang1-Hua2", "性别": "男", "工作单位": "中国石化上海高桥石化有限公司", "工种或工作头衔": "高级技师", "领域": "高端装备", "行业": "石化", "工匠介绍": "张华，高桥石化首席技师，从事催化裂化装置操作31年，为公司安全运行、处理突发事故等方面做出重要贡献。成功处置多起装置事故，发表《烟机结垢预判断》等分析报告。提出200余条技改方案，编制《催化装置开工不放火炬操作法》等实用操作法。所管理机组获\"公司最佳机组\"称号。开发《炼化巡检》等经典课件，参与\"公司内联网炼化题库\"等项目，协助制定教学标准。"}, {"编号": 20250311131, "年份": 2017, "区局": "航天局", "姓名": "徐俊", "年龄": 59, "姓名拼音": "Xu2-Jun4", "性别": "男", "工作单位": "上海航天动力技术研究所", "工种或工作头衔": "钳工", "领域": "空间信息", "行业": "航天", "工匠介绍": "徐俊，航天钳工高级技师、航天首席技师，现为上海航天技师协会理事成员。扎根生产一线，精通车、钳、刨等多种技术技能，擅长解决机械加工中的技术难点及质量问题。在非标设备、工装模具设计及特种材料螺纹加工领域具有突出专长。自2013年起，领衔组建八院\"首席技师工作室\"，带领团队完成10项工艺装备设计、4项产品攻关及20项技术革新。其中\"'发动机壳体端面盲孔攻丝技术改进'项目显著提升生产效率及合格率，节约成本180万元。\"已培养5名徒弟并编写钳工培训教材。2015年，工作室被授予\"上海市首批技师创新工作室\"称号；2016年，命名为中国航天科技集团公司\"徐俊技能大师工作室\"。"}, {"编号": 20250311132, "年份": 2017, "区局": "航天局", "姓名": "周恩杰", "年龄": 45, "姓名拼音": "Zhou1-En1-Jie2", "性别": "男", "工作单位": "上海卫星装备研究所", "工种或工作头衔": "卫星总装", "领域": "空间信息", "行业": "航天", "工匠介绍": "周恩杰，现任上海航天局上海卫星装备研究所卫星总装主岗，航天科技集团公司金牌班组卫星总装组班组长，上海航天局卫星精度测量技能大师工作室首席技师。作为航天领域的资深专家，他在卫星总装工作中表现出色，技术精湛，特别是在卫星精度测量方面具有卓越表现。&#10;&#10;周恩杰独立开发了精度测量软件，成功实现了某卫星测量数据的自动化采集，填补了国内空白。他负责的国内最大双载荷卫星平台装配工作，实现了双载荷安装精度误差控制在发丝直径的一半以内，达到国内领先水平。他在\"卫星太阳翼水平展开技术攻关\"项目中取得突破，该技术在国内首创、国际领先。&#10;&#10;周在多颗国家重点型号卫星的总装工作中担任重..."}, {"编号": 20250311133, "年份": 2017, "区局": "航天局", "姓名": "朱云飞", "年龄": 58, "姓名拼音": "Zhu1-Yun2-Fei1", "性别": "男", "工作单位": "上海航天精密机械研究所", "工种或工作头衔": "钳工", "领域": "空间信息", "行业": "航天", "工匠介绍": "朱云飞，自1993年加入航天事业以来，长期从事长征型号运载火箭和导弹等产品的加工工作，从一名普通工人逐步成长为航天特级技师。在型号研制和工艺攻关中表现突出，创新形成多项先进操作法，解决诸多关键装配难题，每年为企业节省成本700余万元。他成功推动中国武器型号产品走向国际市场，申报专利3项，撰写技术论文6篇，总结形成先进操作法10余项。朱云飞荣获\"全国技术能手\"称号，享受国务院特殊津贴，领衔的工作室被批准为上海市技师创新工作室。他还致力于技术传承，培养19名科研生产骨干，带领班组成员为祖国航天事业贡献力量。"}, {"编号": 20250311134, "年份": 2017, "区局": "船舶", "姓名": "俞洪昌", "年龄": 62, "姓名拼音": "Yu2-Hong2-Chang1", "性别": "男", "工作单位": "沪东中华造船（集团）有限公司", "工种或工作头衔": "船体火工", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "俞洪昌，沪东中华造船（集团）有限公司总装三部加工车间火工班班长，是一名船体火工高级技师。他长期坚守生产一线，潜心钻研技术，在船舶制造领域取得了显著成果。他创新推广了多项新工艺，如\"水火加工不间断连体烧法与背烧法的组合使用\"、\"跳跃式点烧法\"等，显著提升了生产效率。他担任公司培训中心兼职教师，编写出版了《火工》专业教材，并通过\"师带徒\"培养了一批技术骨干。他主持完成了多项课题攻关，荣获多项专利和奖项。他先后获得第六届上海市技术能手、中国船舶工业集团劳动模范、全国技术能手等称号，并入选上海市首席技师千人计划。由他牵头成立的\"俞洪昌劳模创新工作室\"被命名为先进集体，为船舶制造领域培养了一大批优..."}, {"编号": 20250311135, "年份": 2017, "区局": "船舶", "姓名": "陈景毅", "年龄": 54, "姓名拼音": "Chen2-Jing3-Yi4", "性别": "男", "工作单位": "江南造船（集团）有限责任公司", "工种或工作头衔": "船舶电焊工", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "陈景毅，江南造船（集团）有限公司船舶电焊工高级技师，上海市焊接首席技师，“陈景毅国家技能大师工作室”领衔技师。从业二十余年，凭借突出技能和表现，先后获评“全国技术能手”“中国船舶工业总公司技术能手”“中船集团公司技术能手”“全国青年岗位能手”等称号，并入选《国防“511”人才库》，享受国务院津贴。工作中，他成功攻克多项技术难题，如异种材质对接焊接和低温钢焊接裂纹问题，在船舶焊接领域作出重要贡献。他还创新焊接技术，研发多项高效焊接方法和实用装置，推动焊接工艺升级，为船舶工业发展作出突出贡献。"}, {"编号": 20250311136, "年份": 2017, "区局": "烟草", "姓名": "丁钺宗", "年龄": 66, "姓名拼音": "Ding1-Yue4-Zong1", "性别": "男", "工作单位": "上海烟草上海卷烟厂", "工种或工作头衔": "维修", "领域": "烟草", "行业": "烟草", "工匠介绍": "丁钺宗，上海烟草制丝领域首席技师，以其精湛技艺和创新精神在制丝行业取得卓越成就。他撰写了19篇专业论文，主持20余项质量改进项目，获得6项发明专利和7项实用新型专利。作为技术专家，他负责多个重大技术改造项目，项目资金达数十亿元，涵盖英美制丝设备到SDEVO系统，保障\"中华\"品牌高端品质。&#10;&#10;在人才培养方面，他主编了制丝各等级培训教材，完成全国100%制丝高级技师和80%技师的专业理论培训，培养出众多优秀技术人才，在全国烟机技能竞赛中取得优异成绩。丁钺宗以\"匠心\"精神，推动行业发展，为行业技术进步做出重要贡献。"}, {"编号": 20250311137, "年份": 2017, "区局": "汽车", "姓名": "陆恩斌", "年龄": 59, "姓名拼音": "Lu4-En1-Bin1", "性别": "男", "工作单位": "上海汽车制动系统有限公司", "工种或工作头衔": "维修电工", "领域": "汽车", "行业": "汽车", "工匠介绍": "陆恩斌，现任汽车制动系统有限公司工业工程部机修组高级电气技师，系上海市劳动模范、国务院特殊津贴专家。从事电气维修工作30余年，培养十多名技术人才，完成多项技术攻关与创新改造项目，编写多部维修手册。主持完成6项专利研发，其中两项专利已应用于生产一线。他积极适应工业4.0发展要求，参与机器人程序编写及培训工作，推动企业技术升级。作为劳模创新工作室带头人，他学习先进经验，以\"技术为魂、服务为本\"的工匠精神，为企业高质量发展作出突出贡献。"}, {"编号": 20250311138, "年份": 2017, "区局": "汽车", "姓名": "熊俊", "年龄": 47, "姓名拼音": "Xiong2-Jun4", "性别": "男", "工作单位": "上海汽车集团乘用车分公司", "工种或工作头衔": "油泥模型", "领域": "汽车", "行业": "汽车", "工匠介绍": "熊俊,上汽集团乘用车公司油泥主模型师。作为中国汽车行业首位将雕塑美学融入油泥模型制作的技术专家,他从2001年起在上汽大众工作,后加入自主品牌团队,成为\"邵景峰劳模创新工作室\"核心成员。熊俊创新性地将雕塑美学理念与油泥模型技术结合,形成了独特的制作方法,并提出\"全比例模型调整工作法\"。他成功研发出汽车油泥内饰\"涂料仿皮纹印制法\",使上汽乘用车模型仿真度达到国际水平。熊俊不仅技艺精湛,还注重人才培养,培养出多名技术骨干,徒弟方荣泷在上海市职工数控技能大赛中获铜奖。作为汽车造型领域的\"演奏家\",他用\"工匠精神\"推动了中国汽车工业的发展。"}, {"编号": 20250311139, "年份": 2017, "区局": "铁路局", "姓名": "朱东鹰", "年龄": 56, "姓名拼音": "Zhu1-Dong1-Ying1", "性别": "男", "工作单位": "上海铁路局上海电务段", "工种或工作头衔": "信号工", "领域": "轨道交通", "行业": "铁路", "工匠介绍": "朱东鹰，现任上海铁路局上海电务段虹桥高铁车间高级技师，是上海铁路局首席技师和上海市\"朱东鹰技能大师工作室\"创始人。他曾荣获上海市五一劳动奖章、多次被评为上海铁路局先进生产者。他长期坚守在信号设备维修一线，总结提炼出\"朱氏道岔调整法\"等维修方法，在电务信号维修领域广泛应用。作为技能大师工作室负责人，他致力于青年人才培养和创新技术攻关，多项科技成果获上海市优秀认定。他积极参与科技攻关，提出的《研制便携式现场数据记录仪》获上海市职工合理化建议优秀成果奖。"}, {"编号": 20250311140, "年份": 2017, "区局": "港务", "姓名": "刘树", "年龄": 48, "姓名拼音": "Liu2-Shu4", "性别": "男", "工作单位": "冠东国际集装箱码头有限公司", "工种或工作头衔": "电动机械驾驶", "领域": "港口", "行业": "港务", "工匠介绍": "刘树，作为杰出的大国工匠，凭借专业的技能和卓越的贡献，先后荣获2011年上港集团先进标兵个人、2012年上海市“技术能手”、2014年上港集团“劳动功臣”、2015年上海市“劳动模范”和全国交通系统“劳动模范”等多项荣誉称号。他于2011年成立“刘树首席技师工作室”，2016年升级为上海市“刘树技能大师工作室”，并总结出《张勇桥吊高效操作法》等实用方法，显著提升作业效率，荣获2014年度上海市职工先进操作法优秀成果奖。他还主导编写《超限箱装卸工艺操作规程》《岸边集装箱桥式起重机规范操作法》等，并制作成视频材料，推广行业应用。此外，他培养了大批高技能人才，以工匠精神为行业输送了大量专业人才。"}, {"编号": 20250311141, "年份": 2017, "区局": "运输", "姓名": "李军", "年龄": 49, "姓名拼音": "Li3-Jun1", "性别": "男", "工作单位": "交运汽车零部件制造分公司", "工种或工作头衔": "模具", "领域": "汽车", "行业": "汽车", "工匠介绍": "李军，作为交运汽车零部件制造分公司模具中心主任，长期致力于技术创新与工艺改进。他成功研发了L850发动机连杆总成传感轮模具，将动平衡误差控制在0.3毫克以内，达到国际领先水平，获上海通用汽车高度评价。在GFX项目中，他带领团队攻克技术难题，制定模具滚轧方案，大幅提升生产效率，节约成本超千万元，并使7633型模具获得发明专利授权。此外，他培养了多名优秀模具工，为公司输送了大批技术骨干。"}, {"编号": 20250311142, "年份": 2017, "区局": "电信", "姓名": "周纪东", "年龄": 48, "姓名拼音": "Zhou1-Ji4-Dong1", "性别": "男", "工作单位": "中国电信股份有限公司上海分公司", "工种或工作头衔": "线务员", "领域": "空间信息", "行业": "通信", "工匠介绍": "周纪东，荣获全国“五·一”劳动奖章、上海市劳动模范等荣誉。他带领创新团队，运用“互联网+”及IT技术，推动企业高质量发展。主持《SC快速连接器断纤原因分析与光纤接续操作法》等项目，获中国电信员工岗位创新成果优秀奖等。发明《蝶形光缆热熔弓型取纤架》，解决光纤熔接难题，已申请专利。自主研发“一箱十线管控平台”等，提升工作效率并被推广。作为装维技术劳模创新工作室带头人，培训千余人次，推动宽带业务、光纤熔接及智慧家庭技术发展。"}, {"编号": 20250311143, "年份": 2017, "区局": "电信", "姓名": "周学明", "年龄": 43, "姓名拼音": "Zhou1-Xue2-Ming2", "性别": "男", "工作单位": "中国电信股份有限公司上海分公司", "工种或工作头衔": "网络管理员", "领域": "空间信息", "行业": "通信", "工匠介绍": "周学明，作为企业技术骨干，长期致力于网络维护与创新开发工作。他在技术改造方面提出多项创新解决方案，自主研发的故障诊断系统在实际应用中发挥了重要作用，并总结提炼出《学明操作法》，有效提升了网络维护效率和质量。他带领团队开展技术攻关，致力于开发新一代SDN架构设备。作为学明维护班负责人，他注重班组建设，带领团队在网络工程建设、用户故障处理、网络优化等工作中表现优异，培养两名技术骨干。他还担任公司内训师，每年承担超过110课时的公开培训任务，开展多方面培训工作，取得了良好效果和广泛认可。"}, {"编号": 20250311144, "年份": 2017, "区局": "东方航空", "姓名": "吴震东", "年龄": 64, "姓名拼音": "Wu2-Zhen4-Dong1", "性别": "男", "工作单位": "东航技术有限公司", "工种或工作头衔": "飞机维修", "领域": "民用航空", "行业": "航空", "工匠介绍": "吴震东，长期从事飞机起落架系统维修工作并担任管理工作，凭借丰富的专业知识和经验，在起落架系统维修领域解决了多项疑难问题，包括福克-100前起落架滑行转弯异响、MD-82前起落架连杆更换等复杂难题。他还曾发现外单位漏装B737NG前起落架附件问题，并妥善处理A330主起落架异常导致的返航事件。在起落架维修技术方面，吴震东创新性地设计加工专用工具并优化修理工艺，大幅缩短了飞机停场时间，提升了维修效率和安全性。其专业能力和创新精神在飞机维修与适航领域获得广泛认可。"}, {"编号": 20250311145, "年份": 2017, "区局": "建设交通", "姓名": "徐万鹏", "年龄": 57, "姓名拼音": "Xu2-Wan4-Peng2", "性别": "男", "工作单位": "中铁十五局集团有限公司", "工种或工作头衔": "测绘", "领域": "轨道交通", "行业": "建设交通", "工匠介绍": "徐万鹏，现任中铁十五局计量测试中心主任，长期致力于高铁精密测量技术研究与攻关。在京沪高铁建设中，他提出了\"高速铁路精密测量基准\"理论体系，创新研发\"三维平差数学模型\"，解决了高铁测量核心技术难题。他还成功研发\"通用强制对中装置\"，首创\"通过调轨间接调板\"轨道板精调技术，打破了国外垄断，推动了高铁测量技术的飞跃发展。凭借这些创新成果，中铁十五局在京沪高铁建设中创造了多项第一。徐万鹏先后荣获中铁建青年科技拔尖人才、詹天佑铁道科学技术奖、全国五一劳动奖章等多项重大荣誉，是我国高铁测量技术领域的杰出代表。"}, {"编号": 20250311146, "年份": 2017, "区局": "建设交通", "姓名": "胡建平", "年龄": 68, "姓名拼音": "Hu2-Jian4-Ping2", "性别": "男", "工作单位": "中交第三航务工程勘察设计院有限公司", "工种或工作头衔": "计算机设计", "领域": "港口", "行业": "建设交通", "工匠介绍": "胡建平，从事工程地质勘察工作42年，现任\"上海市胡建平技师创新工作室\"领衔人。他主持完成了30余项技术革新，填补了我国海洋地质工程勘察领域的多项空白。其发明的海上升降勘探平台综合系统、船载嵌入双勘察平台设计和新颖海洋原状采样器等多项成果，在洋山深水港和港珠澳大桥等重大工程中广泛应用。胡建平拥有国家授权专利16项（含发明专利10项），荣获中国优秀专利奖、部科技进步一等奖、上海市优秀发明选拔赛金奖等多项荣誉。他培养了一批企业骨干，带领团队在海外工程国际竞标中取得显著优势。胡建平曾获第二十八届、第二十九届上海市优秀发明选拔赛优秀发明金奖，第十届\"上海市职工技术创新能手\"称号等荣誉。"}, {"编号": 20250311147, "年份": 2017, "区局": "建工", "姓名": "王恒栋", "年龄": 58, "姓名拼音": "Wang2-Heng2-Dong4", "性别": "男", "工作单位": "上海市政工程设计研究总院", "工种或工作头衔": "设计咨询", "领域": "土地混合利用", "行业": "建工", "工匠介绍": "王恒栋，我国城市地下综合管廊领域的杰出代表，长期致力于城市基础设施建设与规划研究。他主导参与了多项国家级重点工程，在行业内享有盛誉。&#10;&#10;王恒栋和其团队专注于地下综合管廊的设计规划，将电力、通信、广播电视、给水、排水、热力、燃气等各类市政管线实现集约化建设和管理，确保城市基础设施的安全高效运行。在工程实践中，王恒栋带领团队成功打造了多项标志性工程：安亭新镇综合管廊作为我国第一条具备网络化服务功能的城市地下综合管廊，开创性地体现了超前性、综合性、合理性和实用性；广州大学城综合管廊在非典特殊时期建成投用，成为国内一流大学园区的重要基础设施；上海世博会地下管廊则创新采用了预制拼装..."}, {"编号": 20250311148, "年份": 2017, "区局": "建工", "姓名": "顾军", "年龄": 62, "姓名拼音": "Gu4-Jun1", "性别": "男", "工作单位": "上海市园林工程有限公司", "工种或工作头衔": "木工", "领域": "土地混合利用", "行业": "建工", "工匠介绍": "顾军，上海建工旗下上海市园林工程有限公司资深专家，古建筑领域杰出工匠。从业四十余年，从普