": "普通", "收单时间": "2024-08-15 14:05:04", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "丰镇居委", "派遣时间": "2024-08-15 14:15:57", "案件期限": 7, "处置计时": "1天1小时28分钟5秒", "案件整体计时": "1天18小时38分钟56秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408158339000080, "原编号": 20240815019568, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-15 13:49", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共设施设备的新增或维修", "事项标签": null, "案件描述/内容描述": "市民来电反映:6层小区的电梯前几年才加装，去年开始启用，8月14日晚上电梯故障影响居民上下楼，有联系物业， 物业表示不管，让找电梯维护单位，联系了电梯公司，表示配件坏了让等，为此市民等不及。诉求：希望帮忙督促催促电梯公司尽快来维修。（市民要求信息保密 无需回复）", "上报地址": "虹口区吴家湾路52弄217号", "实际地址": "吴家湾路52弄217号", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": "江湾镇街道于8月15日接单。接单后，经了解，该电梯在质保期内，应由代建单位联系维保单位进行维修。江湾镇街道工作人员迅速对相关代建单位进行了核实，并进行了约谈，要求其尽快进行维修工作，确保居民能够及时使用电梯。经核实：维保单位8月23日对该电梯完成了修复，修复好后已交付居民使用。", "结案时间": "2024-08-26 16:19:50", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-15 13:56:54", "紧急程度": "一般", "所属片区": "第六片区", "所属居委": "纪念居委", "派遣时间": "2024-08-15 14:15:12", "案件期限": 7, "处置计时": "6天19小时57分钟44秒", "案件整体计时": "7天2小时30分钟31秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408158548500079, "原编号": 20240814029816, "案件来源/信息来源": "12345热线", "工单类型": "意见建议类", "发现时间": "2024-08-14 16:34", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "隔离护栏", "事项标签": null, "案件描述/内容描述": "市民来电反映:97路的新市南路车站南路站（南向北），车站上的栅栏，影响乘客上下车，诉求：建议拆除。（市民要求信息保密 需回复）", "上报地址": "虹口区新市南路车站南路", "实际地址": "新市南路车站南路", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "\n经现场查看，反映情况属实，区建管委已通知养护单位进行处理，现已将该处栏杆拆除。电话联系市民，表示理解。\n", "结案时间": "2024-08-20 09:51:00", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-15 15:02:16", "紧急程度": "一般", "所属片区": "第六片区", "所属居委": "车南居委", "派遣时间": "2024-08-15 16:18:32", "案件期限": 7, "处置计时": "1天23小时55分钟14秒", "案件整体计时": "2天20小时