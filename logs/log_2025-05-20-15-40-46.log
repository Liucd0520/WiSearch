08109627700022, "原编号": 20240810003050, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-10 09:09", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "天桥", "事项标签": null, "案件描述/内容描述": "市民来电反映:在上述路口的天桥东南角的电梯已经坏了近一个月没有人维修。诉求：请管理部门核实，要求尽快修复该电梯。", "上报地址": "虹口区吴淞路海宁路", "实际地址": "吴淞路海宁路", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "经了解，市民反映的电梯为吴淞路海宁路天桥东南角电梯，该处电梯外墙玻璃存在碎裂的情况，有较大安全隐患。为保障行人通行安全，我委市政部门采取应急措施暂停了该电梯使用，于8月17上午进行了更换玻璃维修工作，现电梯已正常开放运行。电话联系市民，表示理解。\n ", "结案时间": "2024-08-21 08:57:04", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-10 11:02:56", "紧急程度": "一般", "所属片区": "西片区", "所属居委": "昆山居委", "派遣时间": "2024-08-10 11:03:31", "案件期限": 7, "处置计时": "5天15小时29分钟47秒", "案件整体计时": "7天8小时57分钟4秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408101180100021, "原编号": 20240810002841, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-10 09:05", "状态": "已结案", "事项类别": "公共服务", "事项大类": "民生服务", "事项小类": "养老保障", "事项名称": "居家养老", "事项标签": null, "案件描述/内容描述": "市民来电反映:其74岁，走路拄拐杖，最近又做了胆囊切除手术，申请长护险第一次被驳回，第二次交了200元又没批，对评估结果不认可，身份证号码：31010919510212322X，诉求：希望能给其长护险的照顾，3天也可以。", "上报地址": "虹口区江杨南路55弄32号504室", "实际地址": "江杨南路55弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "虹口区医疗保障局", "协同部门": "虹口区卫生健康委员会", "主处置部门": "虹口区医疗保障局/医疗保险事务中心", "协同处置部门": "虹口区卫生健康委员会/公共卫生管理科", "办理描述": "我局于8月13日9：20电话联系何长妹女士。何女士表示，对评估结果有异议，要求给予其长护险服务。何女士分别于2023年11月、2024年1月完成期末评估和复核评估，评估等级均为1级，不享受长护险待遇。根据评估流程，评估对象对复核评估结论仍有异议的，可在收到复核评估结论告知书之日的起7个工作日内，通过原受理渠道提出终核申请，当前已超过申请时限。考虑到何女士的诉求，我局联系相关街道社区事务受理中心，以个案形式受理其状态评估申请。何女士表示同意。", "结案时间": "2024-08-15 14:03:57", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-11 11:05:48", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "场中居委", "派遣时间": "2024-08-11 11:06:31", "案件期限": 7, "处置计时": "2天15小时32分钟51秒", "案件整体计时": "3天14小时3分钟57秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408101082100020, "原编号": 20240810003055, 