: null, "结案时间": null, "结案期限(是否超时)": "超时", "市紧急程度": "普通", "收单时间": "2024-08-09 14:06:08", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "上农二居委", "派遣时间": "2024-08-09 14:07:23", "案件期限": 7, "处置计时": "16天1小时43分钟51秒", "案件整体计时": "16天3小时37分钟43秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访": null}, {"案件编号": 202408096283500065, "原编号": 20240809014826, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-09 12:11", "状态": "已结案", "事项类别": "公共管理", "事项大类": "公共交通", "事项小类": "设施场地管理", "事项名称": "公共停车场", "事项标签": null, "案件描述/内容描述": "市民来电反映:8月9日~8月11日在虹口足球场开蔡依林演唱会，被告知开演唱会期间社会车辆不能停进虹口足球场的停车场，对此表示不满，不能因为某个艺人的演唱会而影响到市民的日常生活。诉求：希望管理部门核实给予解释，尽快恢复开放停车场，让社会车辆停放。（市民要求信息保密 需回复）", "上报地址": "虹口区虹口足球场", "实际地址": "虹口足球场", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "长远文化（集团）有限公司", "协同部门": null, "主处置部门": "长远文化（集团）有限公司/处置部门", "协同处置部门": null, "办理描述": "虹口足球场管理公司员工王佳亮于8月12日收到12345市民热线联系单，现答复如下：\n虹口足球场工作人员已致电市民并向市民解释为何社会车辆不能进场停放的原因：\n1、8月9-11日虹口足球场举办大型活动期间应公安要求，根据《大型群众性活动治安管理条例》，公安负责场内、周边区域的安全工作，即时依据活动现场具体情况，对场内、周边道路、人流疏散通道等进行相应管控，确保公共区域安全。\n2、大型活动当天，因场内停车位紧张，且为确保大型活动期间场内均为实名登记人员，故应公安要求只允许活动相关工作车辆进场，社会车辆无法进场。\n3、市民可以关注上海交警微发布及虹口足球场微信公众号提前获知演唱会期间的观演指南...", "结案时间": "2024-08-21 09:02:04", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-09 14:14:26", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "模范居委", "派遣时间": "2024-08-09 16:12:32", "案件期限": 10, "处置计时": "7天0小时35分钟5秒", "案件整体计时": "7天20小时50分钟36秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408092703400064, "原编号": 20240809014786, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-09 12:07", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "维修服务", "事项标签": null, "案件描述/内容描述": "市民来电反映:其上述地址水管爆裂，房子造好没有多久。诉求：希望管理部门 核实查实原因。（需回复）", "上报地址": "虹口区宝定路118弄10号，11号", "实际地址": "保定路118弄", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "北外滩街道办事处", "协同部门": null, "主处置部门": "北外滩街道办事处/东片区（热线）", "协同处置部门": null, "办理描述": "区首联08-10 08:36，8/13 15:20电联答复投诉人，经查，该处为弘久新弘北外滩小区，由凡享资产进行日常管理。经向区建管委核实，该小区已于2024年1月25日完成竣工验收备案，房办向物业了解