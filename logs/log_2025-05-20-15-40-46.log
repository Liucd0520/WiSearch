, "事项大类": "科教文卫体", "事项小类": "教育", "事项名称": "办理转学", "事项标签": null, "案件描述/内容描述": "市民来电反映:其居住在上述地址， 小孩从黄浦转到了虹口上学。现在收到通知让其8月30日去飞虹口320号小学报道。市民表示没有分配到家门口学校，离家较远接送小孩不方便，小孩姓名：王梓阳。诉求：希望管理部门协调处理，让其小孩转到离家近的学校。", "上报地址": "虹口区海高苑", "实际地址": "临平北路5弄", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "虹口区教育局", "协同部门": null, "主处置部门": "虹口区教育局/小教科", "协同处置部门": null, "办理描述": "8月29日致电该市民，获悉其孩户籍在黄浦区，以人户分离居住地入学的方式转入我区就读小学。向市民解释：1.转学（户籍地、居住地）均以相对就近统筹安排为原则。2.告知市民后续如有需求，可致电我局65758751沟通。市民表示已知悉。", "结案时间": "2024-08-29 13:58:52", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-29 09:44:45", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "海鸥居委", "派遣时间": "2024-08-29 09:48:30", "案件期限": 7, "处置计时": "0天0小时32分钟57秒", "案件整体计时": "0天4小时35分钟52秒", "事实认定": "属实", "诉求认定": "诉求过高", "是否解决区回访": "诉求过高", "是否满意区回访": "满意"}, {"案件编号": 202408291683700021, "原编号": 20240829004347, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-29 09:22", "状态": "待接单处置", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "违法建筑", "事项标签": null, "案件描述/内容描述": "【重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符，市民表示其反映的问题至今违章搭建都没有拆除。诉求：请管理部门核实后尽快进行后续拆除，并表示城管部门来联系市民后后续其在进行回拨号码一致打不通，要去尽快处理。最近办结的工单编号：20240812029325，工单内容：市民来电反映:虹口区昆山路136弄6号4室丙，将空调的零部件堆满了整个共用天井，还搭建了一个棚子。诉求：请管理部门核实清理空调零部件，拆除棚子。】", "上报地址": "虹口区昆山路136弄6号4室丙", "实际地址": "昆山路136弄", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "北外滩街道办事处", "协同部门": null, "主处置部门": "北外滩街道办事处/西片区（热线）", "协同处置部门": null, "办理描述": null, "结案时间": null, "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-29 09:39:13", "紧急程度": "一般", "所属片区": "西片区", "所属居委": "昆山居委", "派遣时间": "2024-08-29 10:09:47", "案件期限": 7, "处置计时": "2天5小时40分钟34秒", "案件整体计时": "2天6小时29分钟25秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访": null}, {"案件编号": 202408299962500019, "原编号": 20240829004343, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-29 09:16", "状态": "已结案", "事项类别": "公共管理", "事项大类": "公共交通", "事项小类": "非机动车管理", "事项名称": "共享单车停放管理", "事项标签": null, "案件描述/内容描述": "市民反映：死灰复燃。共享单车摆放占用人行道，之前投诉过，好了两天又开始占用。诉求：希望再次整治共享单车乱停放现象。", "上报地址": "虹口区大柏树地