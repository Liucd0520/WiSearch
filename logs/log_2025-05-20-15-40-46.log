。诉求：请管理部门帮助申请。", "上报地址": "虹口区大连西路201弄10号103", "实际地址": "大连西路201弄10号103", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "欧阳路街道办事处", "协同部门": null, "主处置部门": "欧阳路街道办事处/社区服务办公室", "协同处置部门": null, "办理描述": "2024年8月26日10点39分，街道残联工作人员电话联系市民，了解市民情况。\n根据《上海市残疾人居家养护实施方案》沪残联〔2009〕39号规定：具有本市户籍，持有中华人民共和国残疾人证，有居家养护需求的未享受机构养护或日间照料服务补贴的重残无业人员可自愿申请居家养护服务。\n市民目前的条件不符合申请居家养护服务，无法为其申请。市民表示已知晓政策，对工作人员答复满意。", "结案时间": "2024-08-29 09:48:21", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-23 16:51:43", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "大三居委", "派遣时间": "2024-08-23 17:08:54", "案件期限": 7, "处置计时": "1天21小时8分钟4秒", "案件整体计时": "3天22小时31分钟14秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408233928500057, "原编号": 20240823012694, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-23 11:14", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "光污染", "事项名称": "广告灯箱", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述社区事务中心外部景观灯非常亮，夜间存在光污染现象，之前反映过此事，现又死灰复燃。诉求：要求调整灯光亮度。  ", "上报地址": "虹口区凉城路465弄41号甲（虹口区凉城新村街道社区事务受理中心）", "实际地址": "凉城路465弄41甲号 ", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "凉城新村街道办事处", "协同部门": null, "主处置部门": "凉城新村街道办事处/社区服务办公室", "协同处置部门": null, "办理描述": "经核实，来电人投诉的社区事务中心外部景观灯为社区事务受理服务中心24小时自助办理点，去年在接到来电人对灯光亮度提出建议后，中心当时已与设计方对接安装灯光调节器，优化夜晚灯光效果。目前在每晚9点以后灯光亮度会自动调节至最暗，且该处也有夜班保安负责巡查，晚间灯光明亮度并不会影响周边居民休息产生光污染。因该处受理服务中心24小时自助办理点位功能需要，投诉人要求关闭该处灯光诉求过高。现考虑到该市民多次反映灯光亮度的问题，中心负责人已和夜间保安人员对接，每晚8点将该灯光关闭。", "结案时间": "2024-09-02 09:45:45", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-23 15:26:20", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "秀苑居委", "派遣时间": "2024-08-23 16:14:03", "案件期限": 10, "处置计时": "4天23小时22分钟53秒", "案件整体计时": "5天22小时30分钟39秒", "事实认定": "部分属实", "诉求认定": "诉求过高", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408236147000056, "原编号": 20240823012056, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-23 11:08", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "擅自占用道路堆物、施工", "事项标签": null, "案件描述/内容描述": "市民来电反映:虹口区万安路沽源路路口，工地建造大楼把人行道围合入工地