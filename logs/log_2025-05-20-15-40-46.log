间": "2024-08-15 14:29:10", "案件期限": 7, "处置计时": "2天19小时59分钟37秒", "案件整体计时": "3天0小时32分钟8秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408157214400042, "原编号": 20240815007906, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-15 10:10", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "停车管理", "事项标签": "小区停车管理", "案件描述/内容描述": "市民反映：小区里开始了新的停车规则，好几个月了。提了很多要求，停车门槛上来了，可是不见车少，空车位很难找。诉求：希望管理部门加强停车管理。", "上报地址": "虹口区凉城华一小区", "实际地址": "凉城路847弄", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "凉城新村街道办事处", "协同部门": null, "主处置部门": "凉城新村街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "接单后，已联系诉求人就小区停车规则以及新规公布后车辆清退情况进行解释说明。同时，已要求属地物业加强对该小区的停车管理，做好停车引导。处置情况已反馈诉求人，诉求人表示理解。\n", "结案时间": "2024-08-20 10:42:55", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-15 10:38:52", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "华一居委", "派遣时间": "2024-08-15 14:23:00", "案件期限": 7, "处置计时": "2天19小时45分钟17秒", "案件整体计时": "3天0小时31分钟34秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408152743500041, "原编号": 20240815007423, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-15 10:06", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共设施设备的新增或维修", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址的小区的车库不完全属于物业，百联的产权，物业监管权，小区地面的车库没有监控设备。很没有安全感。现在物业和百联相互推。诉求：应该安装监控探头。（需要回复）", "上报地址": "虹口区广中路366弄", "实际地址": "广中路366弄", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "接到诉求后，经了解，该小区地面有一处停车场权属百联公司，目前委托小区物业在具体管理。今年美丽家园改造工程，考虑到车库的实际情况，已经在车库内增设了监控探头且已经启用。2024.8.19.14：02分电话联系来电人告知上述情况其表示感谢工作人员来电告知。", "结案时间": "2024-08-21 09:14:26", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-15 10:29:30", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "金属居委", "派遣时间": "2024-08-15 14:13:47", "案件期限": 7, "处置计时": "2天20小时41分钟25秒", "案件整体计时": "3天23小时9分钟8秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408153494800040, "原编号": 20240815007342, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-15 10:04", "状态": "已结案", "事项类别": "公共服务", "事项大类": "科教文卫体", "事项小类": "文化旅游", "事项名称": "文化场所信息", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址有一个图书馆，图书馆首先不开空调，并且内部的厕所环境很差，地面湿滑，上次就有一个老人进入因地板有水滑到。诉求：希望有关部门督促加强管理。（市民要求信息保密 无需回复）", "上报地址": "虹口区和平书院综合楼 （和平公园5号门边上）", "实际地址": "和平书院", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "虹口区文化和旅游局", "协同部门": null, "主处置部门": "虹口区文化和旅游局/公共文化科", "协同处置部门": null, "办理描述": "和平书院对市民所反映的情况进行了调查和处理。首先关于空调问题：和平书院空调在开馆期间每天都正常开启，市民反映的问题主要是因高温天气空调外机出力受限，导致室内温度过高。为解决该问题和平书院已在空调外机安装了导流罩，并且监控空调的温度，目前室内温度控制在人体舒适温度的范围。关于厕所问题：书院调查后并未发现有人摔倒事件，同时书院专门对保洁工作进行了检查，保洁人员可做到每天定期用干拖把将地板拖干，防止有人摔倒；今后书院将进一步加强包括厕所在内的保洁工作的管理和监督，确保为读者提供更加优良的阅读环境。", "结案时间": "2024-08-21 17:02:32", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-15 13:50:33", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "和平居委", "派遣时间": "2024-08-15 14:18:14", "案件期限": 7, "处置计时": "3天20小时13分钟36秒", "案件整体计时": "4天6小时59分钟2秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408153832700039, "原编号": 20240815007549, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-15 10:03", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "生活娱乐扰民", "事项标签": null, "案件描述/内容描述": "市民反映：这家老人早上6：。。开始听京剧声音太响了，影响市民休息。诉求：协调解决扰民事宜。", "上报地址": "虹口区广灵四路365弄2号501", "实际地址": "广灵四路365弄  ", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "凉城新村街道办事处", "协同部门": null, "主处置部门": "凉城新村街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "接单后，街道已安排工作人员联合属地居委与该听京剧的居民进行沟通。经沟通，目前该居民承诺将减轻音量、延后时间，避免影响周边居民休息。处置情况已反馈诉求人，诉求人表示接受。\n", "结案时间": "2024-08-21 09:10:37", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-15 14:01:56", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "广凉居委", "派遣时间": "2024-08-15 14:15:57", "案件期限": 7, "处置计时": "2天19小时53分钟5秒", "案件整体计时": "3天23小时7分钟15秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408153446700038, "原编号": 20240815007296, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-15 10:02", "状态": "已结案",