，针对工地持续夜间施工扰民，对周边小区居民的影响较为严重，执法队已将该情况通报各相关职能部门，于8月15日依据条例第三次从严对工地违规夜间施工的行为立案查处，立案编号为沪（虹）嘉办立字【2024】第020247号。此案件目前正在办理程序中，后续诉件将并案处理。同时执法队已加大每日夜间对工地周边区域的巡查，发现违规行为及时制止。", "结案时间": "2024-08-21 08:32:52", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 11:19:46", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "梧州居委", "派遣时间": "2024-08-14 11:22:17", "案件期限": 7, "处置计时": "3天22小时54分钟27秒", "案件整体计时": "5天0小时19分钟32秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未解决", "是否满意区回访": "满意"}, {"案件编号": 202408143701300007, "原编号": 20240814001437, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-14 08:07", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "生活娱乐扰民", "事项标签": null, "案件描述/内容描述": "市民反映：上述地址每天早上7：40左右就有人开很大声的音乐做广播体操，严重影响居民休息睡眠。诉求：请制止噪音扰民。（市民要求信息保密，无需回复）", "上报地址": "虹口区凉城路车站南路派出所旁边小公园", "实际地址": "凉城路车站南路派出所旁边小公园", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "公安局虹口分局", "协同部门": null, "主处置部门": "公安局虹口分局/凉城新村派出所", "协同处置部门": null, "办理描述": "根据相关噪音防治法规，22时至次日6时，在毗邻噪音敏感建筑物的公园、公共绿地、广场、道路等公共场所开展健身、娱乐等活动的不得使用带有外置扩音装置的音响器材。8月15、16日早，凉城所民警到场查看，有居民锻炼，但未发现健身居民使用外置扩音设备。民警进行噪音防治法制宣传。", "结案时间": "2024-08-21 08:27:39", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 10:06:56", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "锦二居委", "派遣时间": "2024-08-14 10:08:02", "案件期限": 7, "处置计时": "4天5小时17分钟47秒", "案件整体计时": "5天0小时20分钟18秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408142181300006, "原编号": 20240814001091, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-14 07:55", "状态": "已结案", "事项类别": "公共服务", "事项大类": "社区共治", "事项小类": "居委会", "事项名称": "不文明养宠", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址居民养狗，狗在早上5-6点叫，影响自己休息，报警后警察只是让狗带口套，自己不认可。诉求：请核实让其居民文明养狗。（需回复）", "上报地址": "虹口区广中路554号101室", "实际地址": "广中路554号 ", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "公安局虹口分局", "协同部门": null, "主处置部门": "公安局虹口分局/广中路派出所", "协同处置部门": null, "办理描述": "广中所社区民在收到工单后高度重视，8月15日前往上址查看具体情况。经查，101室确实饲养了一条黑色雪纳瑞，已办理狗证，电子标识号：156000100158001，登记证号：0004008431。广中所已走访周边居民，居民称犬只已饲养多年，日常生活中未发现存在犬只吠叫噪音扰民的情况，同时民警已对犬主人法律告知和文明养犬宣传，犬主人称会积极遵守《上海市养犬管理规定》，在日常饲养犬只的过程中不对周边邻居造成影响。", "结案时间": "2024-08-22 14:27:29", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 14:29:52", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "金属居委", "派遣时间": "2024-08-14 16:03:56", "案件期限": 7, "处置计时": "3天16小时48分钟13秒", "案件整体计时": "6天6小时32分钟9秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408144524900005, "原编号": 20240814001035, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-14 07:51", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "停车管理", "事项标签": "小区停车管理", "案件描述/内容描述": "市民来电反映:上述地址小区保安不负责任，放了外来车辆进入小区，任由该车乱停，现在堵住了其他车辆。诉求：希望管理部门核实并要求投诉物业，进行改善。", "上报地址": "虹口区西宝兴路949弄", "实际地址": "西宝兴路949弄", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "经查，西宝兴路949弄1-7号，19-38号为半敞开式售后房小区（动迁回搬基地）。经了解，2020年7月召开业主大会征询公兴桥小区全体业主672户，结果整个小区居民404票同意支付物业管理费0.18元，按照《上海市售后小区物业服务收费标准》规定小区居民楼的保洁费和保安费因征询未通过。 街道为了维护该小区秩序，要求广同物业托底聘请第三方保安公司，主要负责小区主干道的秩序管理。由于托底管理，保安1人1岗不能随意脱岗，非投诉人所述不负责任。\n经了解，14日上午37号底楼装修居民在门口临时借用车道卸货，未造成混乱，当天下午就驶离小区。\n        故综上以上情况，作不属实。", "结案时间": "2024-08-23 15:49:42", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 14:18:11", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "黄山居委", "派遣时间": "2024-08-14 14:19:09", "案件期限": 7, "处置计时": "6天23小时51分钟12秒", "案件整体计时": "7天7小时58分钟23秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408144159600004, "原编号": 20240814000874, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-14 07:41", "状态": "已结案", "事项类别": "公共安全", "事项大类": "消防安全", "事项小类": "消防隐患", "事项名称": "公共场所消防安全隐患", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址小区电瓶车是在小区地下车库充电的，地下车库有3层，停放的车辆也很多，若充电期间出现火情的话消防车也是无法进入地下车库的，存在安全隐患。诉求：请承办部门核实并给到一个合理的处理方案。", "上报地址": "虹口区虹湾路313弄", "实际地址": "虹湾路313弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "江湾镇街道于8月14日接单。接单后，江湾镇街道城运中