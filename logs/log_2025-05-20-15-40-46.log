事项标签": null, "案件描述/内容描述": "市民反映：场汇中路吉买盛广场开了一家新健身房-NSK纽绍客健身，销售人员在逸仙小区北门以及地铁口都有立牌，拦人推广，并在小区每幢楼内张贴广告，广告撕下后墙壁仍留有胶印（详见附件）。诉求：核查乱张贴。", "上报地址": "虹口区场中路4弄逸仙小区", "实际地址": "场中路4弄 逸仙小区", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/江湾镇街道综合行政执法队", "协同处置部门": null, "办理描述": "江湾镇街道已于8月14日接单。接单后，城管江湾中队即派执法人员于2024年8月15日9时前往现场核实。经查，逸仙路580号新开的健身房存在乱张贴小广告的情况，执法人员已责令当事店方立即整改并立案查处，案号：沪（虹）江办立字[2024]第100275号。由于当事人拒绝接听电话，执法人员于2024年8月19日下午通过短信联系来电人，反馈其处理情况。", "结案时间": "2024-08-23 08:31:20", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 15:41:55", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "逸仙居委", "派遣时间": "2024-08-14 15:46:13", "案件期限": 7, "处置计时": "3天19小时17分钟29秒", "案件整体计时": "7天10小时59分钟58秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408137421800186, "原编号": 20240813040243, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-13 21:10", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共区域维护", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述小区美丽家园刚改造完，然后在居委会旁边刚搭起来四根铁管子，类似雨棚之类的，现诉求：要求核实并予以拆除。（市民要求信息保密，需要回复", "上报地址": "虹口区车站北路732弄", "实际地址": "车站北路732弄", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "凉城新村街道办事处", "协同部门": null, "主处置部门": "凉城新村街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": "经了解，为响应小区广大居民需求，文苑一居委于近日在车站北路732弄小区居委会旁边的水泥空地上安排搭建了一个遮阳棚，在棚下放了两把长椅，提供于小区居民临时歇息用。 8月15日居委干部电话联系诉求人，向其耐心解释了居委会在该处搭建遮阳棚的便民用途，诉求人了解情况后表示理解和认可。", "结案时间": "2024-08-21 08:26:49", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 15:36:16", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "文苑一居委", "派遣时间": "2024-08-14 15:37:16", "案件期限": 7, "处置计时": "3天17小时29分钟47秒", "案件整体计时": "5天11小时17分钟27秒", "事实认定": "属实", "诉求认定": "诉求过高", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408138566300185, "原编号": 20240813040255, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-13 20:52", "状态": "已结案", "事项类别": "公共安全", "事项大类": "消防安全", "事项小类": "消防隐患", "事项名称": "非机动车安全隐患", "事项标签": null, "案件描述/内容描述": "【安全隐患】【重新交办，要求：答复要点与实际不符，市民反映：该现象依然存在，电瓶车违规停放在楼道（详见附件）。诉求：予以整治。（市民要求信息保密，无需回复）最近办结的工单编号：20240802003345，工单内容：市民反映：虹湾路55弄43号1楼住户电瓶车违规停放在楼道，有火灾风险，已经规劝多次无效。诉求：请管理部门整治电瓶车入楼充电问题。（市民要求信息保密，无需回复）】", "上报地址": "虹口区虹湾路55弄43号1楼", "实际地址": "虹湾路55弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/江湾镇街道综合行政执法队", "协同处置部门": null, "办理描述": "江湾镇街道已于8月14日接单。接单后，城管江湾中队执法人员联系虹湾路55弄物业，43号1楼曾发现电瓶车违规停放在楼道飞线充电，物业工作人员已告诫当事人不得将电瓶车推进楼道。执法人员于2024年8月14日15时，8月17日10时，8月19日20时多次前往现场核实，均未发现虹湾路55弄43号103室有将电瓶车违规停放在楼道的情况。执法人员已要求物业加强监管，若当事人拒不整改，上报城管部门联合整治并处罚。来电人未留有联系方式，无法反馈其处理情况。", "结案时间": "2024-08-21 08:28:38", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 10:16:59", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "虹纺居委", "派遣时间": "2024-08-14 10:17:56", "案件期限": 7, "处置计时": "4天0小时39分钟39秒", "案件整体计时": "5天11小时37分钟16秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408131839500184, "原编号": 20240813039434, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-13 20:36", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "暴露垃圾", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述小区征询过业主确定垃圾堆放点在1号2号车位，现没有做过任何征询就放在道闸口，导致3幢楼的垃圾都有堆放在此，要求立即整改，此处堆放点建生活垃圾和建筑垃圾房都不符合相关规定  诉求：小区任何改造都要事先征询业主意见，做到公开 公正，透明，望管理部门核实整改（市民要求信息保密 无需回复）", "上报地址": "虹口区大连西路玉四花苑 包涵180号 190号 200号", "实际地址": "大连西路200号", "联系人": null, "联系电话": null, "所属街道": "曲阳路街道", "主责部门": "曲阳路街道办事处", "协同部门": null, "主处置部门": "曲阳路街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": "8月15日，社工办12345工作人员方国华到达现场了解到，大连西路180、190、200号是三幢高层小区，原先征询准备在1—2号旁建设建筑垃圾堆点，但实际测算存在车辆转弯角度过小，清运车辆无法驶入的情况，故无法实施。目前无新的建设建筑垃圾堆放点的方案。市民反映的3号楼处有垃圾堆放的情况，实际是为配合小区进行美丽家园建设，临时堆放建筑垃圾。已要求施工单位及时清运，用绿网覆盖，避免影响居民生活。对于后续是否重新选址建造固定的建筑垃圾堆放点，小区三驾马车需再进行讨论，目前无明确计划。如有计划，也将通过业主大会再进行征询。信息保密，无需回复。", "结案时间": "2024-08-21 14:11:53", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 08:32:53", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "玉四居委", "派遣时间": "2024-08-14 09:18:11", "案件期限": 7, "处置计时": "5天1小时55分钟15秒", "案件整体计时": "5天17小时34分钟31秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408131353300183, "原编号": 20240813039503, "案件来源/信息来源": "12345热线", "工单类型": "咨询类", "发现时间": "2024-08-13 20:24", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共设施设备的新增或维修", "事项标签": null, "案件描述/内容描述": "【重新交办,要求：按答复要点告知市民,市民表示答复要点与实际不符，市民表示楼组长群和党员群没有通知过，楼组长也没有上门来征询过意见，现在电瓶车充电桩距离市民家里2米，电瓶车安放后距离房屋墙壁只有1米，管理部门说的距离房屋很远是怎么定义的，市民要求区政府工作人员直接联系市民解释，不要街道工作人员处理。最近办结的工单编号:20240805031562，工单内容:市民来电咨询:上述位置新造了敞开式非机动车车棚统一充电。离住宅楼过于接近且阻塞消防车通道。诉求：咨询其位置是否合理。（市民要求信息保密 需回复）】", "上报地址": "虹口区友谊二村15号后门", "实际地址": "友谊二村15号", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "接到诉求后，城运中心工作人员到现场查看，来电人反映的友谊二村15号对面安装了一排充电桩，是安装在了对面二十三所的院墙上，并没有占用友谊二村的公共部位，不需要征询。经向相关部门咨询，目前没有文件约定安装充电桩与建筑物之间的距离要求规定。8月16日11:50电话联系来电人告知上述情况，来电人对此解释不接受。", "结案时间": "2024-08-23 09:16:43", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 09:52:09", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "友谊居委", "派遣时间": "2024-08-14 10:00:21", "案件期限": 8, "处置计时": "6天4小时40分钟59秒", "案件整体计时": "7天12小时53分钟21秒", "事实认定": "对政策解释不接受", "诉求认定": null, "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408137229500182, "原编号": 20240813039217, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-13 20:15", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "旧改征收", "事项名称": "动迁矛盾", "事项标签": null, "案件描述/内容描述": "市民来电补充信息。市民补充信息内容为：其表示电信网线被他们拔断了，导致报修后电信的人无法进来修网线，现要求尽快把砖头拆了，让电信的人进去修网线，市民要求加急处理。【最近派发的工单编号：20240813037886，工单内容：市民来电反映:上述地址小区房屋正在进行动迁，目前该动迁组将出入口用砖石封住，影响市民正常生活。诉求：希望相关部门核实处理，市民要求拆除砖石。（需要回复）】", "上报地址": "虹口区嘉兴路街道瑞虹路25弄18号", "实际地址": "瑞虹路25弄18号  ", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "虹口区旧区改造和房屋征收工作指挥部", "协同部门": null, "主处置部门": "虹口区旧区改造和房屋征收工作指挥部/信访室", "协同处置部门": null, "办理描述": "工程部,徐晓杰核实,一是市民反映地址属于143街坊，正处于大规模搬迁、封门过程中。来电人属于已签约尚未搬迁的居民，经实地查看，征收部门仅对已搬迁居民户进行门窗封堵，正常出现通道并无封堵，来电人日常通行并不收到影响。二是网线问题，经查，该户使用移动盒子，目前损坏并非征收部门导致，且维修与搬迁居民户封门、砖头并不影响。另经与该处区域维修移动网络人员沟通，该户使用移动网络，为个人申请，损坏报修应由移动负责。目前负责该区域网络人员已上门勘察。我部认为，搬迁居民户进行封堵，并不影响该户网络维修问题。且征收部门封堵为无人居住房屋，便于看管。其的日常通行并不受影响。", "结案时间": "2024-08-15 17:01:40", "结案期限(是否超时)": "正常", "市紧急程度": "次紧急", "收单时间": "2024-08-14 08:39:03", "紧急程度": "次紧急", "所属片区": "第二片区", "所属居委": "岳州居委", "派遣时间": "2024-08-14 08:42:40", "案件期限": 7, "处置计时": "1天0小时16分钟9秒", "案件整体计时": "1天20小时40分钟18秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408134519800180, "原编号": 20240813039227, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-13 20:09", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "维修服务", "事项标签": null, "案件描述/内容描述": "市民反映：5月底密三小区美丽家园项目结束，正巧小区内2号504的房屋3月份刚装修完毕，提出更换阳台雨棚。本来是一件好事，可是雨棚更换好以后6月的黄梅天连续大雨家中阳台开始渗水漏水。 因为没有美丽家园的直接联系方式，找到物业缺告知不管（详见附件）。诉求：望美丽家园施工方与其联系维修。", "上报地址": "虹口区赤峰路365弄2号504", "实际地址": "玉田支路21号", "联系人": null, "联系电话": null, "所属街道": "曲阳路街道", "主责部门": "曲阳路街道办事处", "协同部门": null, "主处置部门": "曲阳路街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "经房办与物业现场勘查，居民反映情况属实。物业已经上报美丽家园维保单位，美丽家园已经上门对漏水的部位进行了维修。房办已经通过电话将处理结果告知居民，居民表示知晓。", "结案时间": "2024-08-23 09:12:56", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 09:52:34", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "密三居委", "派遣时间": "2024-08-14 15:18:59", "案件期限": 7, "处置计时": "5天23小时36分钟49秒", "案件整体计时": "7天13小时3分钟34秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408134166500179, "原编号": 20240813038765, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-13 19:56", "状态": "已退单", "事项类别": "公共安全", "事项大类": "消防安全", "事项小类": "消防隐患", "事项名称": "群租", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址公寓存在群租，市民称造成大面积漏水，诉求：请管理部门核实取缔群租。（市民表示不需要回复）", "上报地址": "虹口区四平路118号 （哈弗公寓）", "实际地址": "四平路118号 ", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "嘉兴路街道办事处", "协同部门": null, "主处置部门": null, "协同处置部门": null, "办理描述": null, "结案时间": null, "结案期限(是否超时)": "超时", "市紧急程度": "普通", "收单时间": "2024-08-14 09:31:31", "紧急程度": "一般", "所属片区": "第五片区", "所属居委": "天水居委", "派遣时间": "2024-08-14 09:34:54", "案件期限": 7, "处置计时": "13天6小时16分钟8秒", "案件整体计时": "13天19小时53分钟40秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访":