遵守文明施工的相关规定，做好降噪措施，减少对周边小区居民的影响。", "结案时间": "2024-08-27 10:11:08", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-16 16:54:56", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "瑞鑫居委", "派遣时间": "2024-08-20 08:37:56", "案件期限": 7, "处置计时": "3天23小时42分钟18秒", "案件整体计时": "6天18小时23分钟48秒", "事实认定": "属实", "诉求认定": "其他", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408161896500095, "原编号": 20240816026060, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-16 15:45", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "旧改征收", "事项名称": "动迁需求", "事项标签": "迁出奖励咨询", "案件描述/内容描述": "市民来电反映:该户一共有6户人家，都签好了动迁协议。现在5户人家都搬走了，剩最后1户要做钉子户。目前打算进行司法强拆，但这样对已经搬走的人来说不公平，因为强拆将取消掉户口迁移奖励费。诉求：希望能通过其他部门再与该钉子户沟通，或者强拆后不要损害到已经搬走人的利益。 ", "上报地址": "虹口区瑞虹路25弄75号", "实际地址": "瑞虹路25弄", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "虹口区旧区改造和房屋征收工作指挥部", "协同部门": null, "主处置部门": "虹口区旧区改造和房屋征收工作指挥部/信访室", "协同处置部门": null, "办理描述": "上海市虹口第二房屋征收服务事务所有限公司,李哲威,来电人金先生为在册户籍人员。根据《上海市国有土地上房屋征收补偿实施细则》等相关法律法规，征收部门按照有效的土地证、房地产权证等有效权属证明来计算补偿安置款，即将整套房屋的征收利益视为一个整体，该户为共有产，实际矛盾为家庭内部分配问题，已签订协议尚未全部履行搬迁义务。征收部门按照节点进行补偿决定制作等流程操作，并无不妥。我部认为，该户实际矛盾为家庭内部分配问题，征收部门并不参与分配事宜，需通过该户自行协商或司法途径解决。\n", "结案时间": "2024-08-22 15:23:35", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-16 16:22:09", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "岳州居委", "派遣时间": "2024-08-16 16:24:52", "案件期限": 7, "处置计时": "3天22小时18分钟7秒", "案件整体计时": "3天23小时38分钟18秒", "事实认定": "不属实", "诉求认定": "诉求过高", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408165250600094, "原编号": 20240816026186, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-16 15:42", "状态": "已结案", "事项类别": "公共管理", "事项大类": "城管执法", "事项小类": "物业相关执法", "事项名称": "破坏房屋结构", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址居民违规在阳台搭建飘窗，阳台外扩窗户外延，破坏房屋结构，诉求：要求尽快对破坏房屋结构的问题进行核实处理。（市民要求信息保密 需回复）", "上报地址": "虹口区天宝西路5弄21号301室", "实际地址": "天宝西路5弄21号", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "欧阳路街道办事处", "协同部门": null, "主处置部门": "欧阳路街道办事处/欧阳路街道综合行政执法队", "协同处置部门": null, "办理描述": "现场查看，确在搭建飘窗，但不存在破坏房屋结构的情况。联系市民，其表示居民矛盾已自行协商调解，无需城管介入处理。", "结案时间": "202