弄66号502室", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/江湾镇街道综合行政执法队", "协同处置部门": null, "办理描述": "江湾镇街道已于8月26日接单。接单后，城管江湾中队即派执法人员于2024年8月27日15时前往现场核实。经查，吴家湾路101弄66号502室正在装修，敲毁部分墙体，执法人员已和第三方机构上门鉴定，待1个月后收到鉴定报告，根据报告内容进一步处置。来电人未留有联系方式，无法反馈其处理情况。", "结案时间": "2024-09-02 09:00:25", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-26 10:20:17", "紧急程度": "一般", "所属片区": "第六片区", "所属居委": "纪念居委", "派遣时间": "2024-08-26 13:58:03", "案件期限": 7, "处置计时": "4天1小时31分钟31秒", "案件整体计时": "4天22小时41分钟16秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408266929200047, "原编号": 20240826007748, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-26 10:17", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "停车管理", "事项标签": "小区内违规停车", "案件描述/内容描述": "市民反映：虹口区江杨南路55弄小区公共车位，未经全体业主同意，就被个别人私设无障碍标志，并用残疾车长期占为己有（详见附件）。多次向物业反映无效果，现严重侵害其他业主权益。诉求：望管理部门核实处理私设无障碍残疾标志占车位事宜。（市民要求信息保密，无需回复）", "上报地址": "虹口区江杨南路55弄", "实际地址": "江杨南路55弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "江湾镇街道已于8月26日接单。接单前，江湾镇街道工作人员与爱仁物业联系，经了解，26号和27号有两残疾车居民，其残疾车停放在机动车位上，车位旁设残疾车专有牌子为区残联几年前定制，非残疾人私设无障碍标志，且未有私占车位，无障碍标志是目的是方便小区居民照顾残疾人士停车，未有车位固定化，不存在残疾车占车位情况。江湾镇街道工作人员督促物业公司加强小区管理，积极化解业主矛盾，加大巡查力度，发现问题立即处置并加强小区内部规范管理，严控外来车辆，引导机动车有序停放，积极化解居民矛盾，为业主营造良好的生活环境。", "结案时间": "2024-08-30 09:14:51", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-26 15:23:10", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "场中居委", "派遣时间": "2024-08-26 16:09:17", "案件期限": 7, "处置计时": "2天0小时20分钟3秒", "案件整体计时": "3天22小时57分钟47秒", "事实认定": "部分属实", "诉求认定": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408267861900046, "原编号": 20240826007671, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-26 10:14", "状态": "已结案", "事项类别": "公共服务", "事项大类": "民生服务", "事项小类": "人力保障", "事项名称": "拖欠工资", "事项标签": "无合同欠薪", "案件描述/内容描述": "市民来电反映:其2024年7月份给上述地址公司做实习，实习一个月，本来2024年8月12日发工资的，但是该公司迟迟不发，没有签署劳动合同，拖欠其500元，望管理