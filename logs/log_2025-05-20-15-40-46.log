"2天18小时50分钟29秒", "案件整体计时": "3天3小时49分钟19秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408223220100048, "原编号": 20240822011041, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-22 10:55", "状态": "已结案", "事项类别": "公共服务", "事项大类": "科教文卫体", "事项小类": "体育", "事项名称": "场地设施", "事项标签": null, "案件描述/内容描述": "市民反映：虹口足球场里面的铁马绊脚。诉求：请尽快移走。（市民要求信息保密，需回复）", "上报地址": "虹口区东江湾路444号虹口足球场", "实际地址": "东江湾路444号", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "长远文化（集团）有限公司", "协同部门": null, "主处置部门": "长远文化（集团）有限公司/处置部门", "协同处置部门": null, "办理描述": "虹口足球场管理公司员工王佳亮于8月22日收到12345市民热线联系单，现答复如下：\n虹口足球场管理方已通知安保工作人员今后要合理安放设置铁马，避免对过路行人及非机动车造成通行影响。", "结案时间": "2024-08-26 15:04:07", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-22 16:03:53", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "模范居委", "派遣时间": "2024-08-22 16:50:25", "案件期限": 7, "处置计时": "1天21小时32分钟54秒", "案件整体计时": "2天4小时8分钟53秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408226798700049, "原编号": 20240822011238, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-22 10:55", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "装修噪音扰民", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址居民装修噪音扰民严重，影响周边居民休息。诉求：希望管理部门核实加装噪音放置措施。", "上报地址": "虹口区邮电新村62号601室", "实际地址": "四平路621弄62号601室", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "欧阳路街道办事处", "协同部门": null, "主处置部门": "欧阳路街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "1、物业企业已上门告知业主及施工单位依据《上海市社会生活噪声污染防治办法》有关规定，每日18时至次日8时以及法定节假日全天，不得在已交付使用的住宅楼内进行产生噪声的装饰装修作业。在其他时间进行装饰装修作业的，应当采取噪声防治措施，避免干扰他人正常生活。2、物业服务企业已安排工作人员针对室内装修加强巡查频次，发现噪音扰民的及时进行劝阻、制止，避免发生扰民情况。2024年08月27日上午10:30分街道城运中心工作人员已联系来电人，告知相关情况，来电人已知晓。", "结案时间": "2024-08-30 10:18:53", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-22 14:12:07", "紧急程度": "一般", "所属片区": "第五片区", "所属居委": "邮电居委", "派遣时间": "2024-08-22 14:19:32", "案件期限": 7, "处置计时": "4天18小时18分钟19秒", "案件整体计时": "5天23小时23分钟38秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408225742900047, "原编号": 20240822010580, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-22 10:53", "状态": "已结案", "事项类别": "公共管理", "事项大类": "公共交通", "事项小类": "机动车管理", "事项名称": "机动车停放管理", "事项标签": null, "案件描述/内容描述": "市民来电反映:家长在上述地址上下学接送小孩，小区里面不让家长停车，就停在外面新市北路两侧，都是可以停的，很短的一条路，但从9月1日后交警不允许在幼儿园对面的新市北路另一侧停车，市民表示该设置不合理，家长就停半小时接孩子就开走了，周边还有小学，没有开学就已经停满了，诉求：望管理部门核实协调让16：00-16:40左右能都停车。", "上报地址": "虹口区新市北路152弄上海市白玉兰幼儿园", "实际地址": "新市北路1525弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "公安局虹口分局", "协同部门": null, "主处置部门": "公安局虹口分局/交通警察支队", "协同处置部门": null, "办理描述": "根据《中华人民共和国道路交通安全法》第56条：“机动车应当在规定地点停放。禁止在人行道上停放机动车；但是依照本法第33条规定施划的停车泊位除外。在道路上临时停车的，不得妨碍其他车辆和行人通行”。因此上述地址停车属于违法停车，同时新市北路白玉兰幼儿园及红旗小学分校均向交警部门申请新市北路单边东侧上放学临时停车，并不是道路两边都可以停车，目前新市北路单边东侧停车是审核通过并且允许的。如需增加临时停车位置需由学校征求大部分家长意见后向交警部门提交申请，报交警总队审批通过后才能实施，同时学校上放学时间段需派遣专人共同管理停车点的停车秩序，做到即停即走。", "结案时间": "2024-08-30 10:11:56", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-22 14:06:25", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "新北居委", "派遣时间": "2024-08-22 15:56:13", "案件期限": 13, "处置计时": "5天1小时21分钟0秒", "案件整体计时": "5天23小时18分钟46秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408226785000046, "原编号": 20240822010463, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-22 10:50", "状态": "待接单处置", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共区域维护", "事项标签": null, "案件描述/内容描述": "市民来电反映:龙街26号浦西公寓内有六部电梯，其中1号、2号、3号、6号的电梯在近两个月出现异味情况（类似抽烟味、垃圾味），之前物业表示会叫人前来处理，但两周前有人前来只是看看电梯就离开，目前居民群内对异味抱怨较多，希望管理部门尽快核实并解决电梯异味情况。（市民要求信息保密 需回复） ", "上报地址": "虹口区蟠龙街26号浦西公寓1号、2号、3号、6号", "实际地址": "蟠龙街 26号  ", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "北外滩街道办事处", "协同部门": null, "主处置部门": "北外滩街道办事处/西片区（热线）", "协同处置部门": null, "办理描述": null, "结案时间": null, "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-22 14:41:00", "紧急程度": "一般", "所属片区": "西片区", "所属居委": "海宁居委", "派遣时间": "2024-08-22 15:51:22", "案件期限": 7, "处置计时": "6天23小时59分钟18秒", "案件整体计时": "7天4小时59分钟31秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访": null}, {"案件编号": 202408228026800045, "原编号": 20240822010246, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-22 10:49", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "文明施工措施不落实", "事项标签": null, "案件描述/内容描述": "市民来电反映：谭家桥新村在进行拆除工程，拆除工程截止时间8月24日，上周搭了脚手架，但迟迟未动工，脚手架影响四平路421弄小区7-8个停车位，也影响居民通行，诉求：请核实尽快完成拆除工程或是先把脚手架拆除。（市民要求信息保密 无需回复）", "上报地址": "虹口区欧阳街道谭家桥新村", "实际地址": "四平路421弄", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "虹房集团", "协同部门": null, "主处置部门": "虹房集团/处置部门1", "协同处置部门": null, "办理描述": "经查，四平路421弄小区现场拆除工程实际于8月28日开始。为确保施工过程中的安全，因现场施工场地有限，虹建公司只能临时借用小区内部分停车位场地搭设脚手架。考虑到此举会暂时影响部分居民的停车需求、日常通行，为尽最大努力减少对居民生活的影响，虹建公司事先已同小区居委会沟通达成共识，并承诺在工程结束后立即恢复停车位使用。居委会也已通过公告形式向全体居民告知了现况，以确保信息透明与公开。目前，拆除工程正在有序进行中，预计整个拆除工程的总工期为14天。工程结束后，虹建公司将立即着手恢复被占用的停车位使用，并对施工区域进行彻底清理和修复工作。期间，虹建公司将加强与小区居委会及居民的沟通与联系，共同维...", "结案时间": "2024-08-29 09:37:07", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-22 14:04:50", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "祥德居委", "派遣时间": "2024-08-22 15:33:57", "案件期限": 7, "处置计时": "4天3小时12分钟9秒", "案件整体计时": "4天22小时47分钟54秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408221006800044, "原编号": 20240822009654, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-22 10:38", "状态": "已结案", "事项类别": "公共服务", "事项大类": "社区共治", "事项小类": "居委会", "事项名称": "两“室”建设", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址老年活动室弄的很好，但街道给跳舞的人钥匙，将音乐放的很响，和看电视、休闲的老人一个活动室，噪音扰民，反映居委表示街道给的没办法。钥匙不能给居民，希望给跳舞的安排其他房间，诉求：请管理部门协调合理解决。（市民要求信息保密，无需回复）", "上报地址": "虹口区嘉兴街道大连居委会三河路老年活动室", "实际地址": "大连居委会三河路老年活动室", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "嘉兴路街道办事处", "协同部门": null, "主处置部门": "嘉兴路街道办事处/社会工作办公室", "协同处置部门": null, "办理描述": "经核实，诉求中提到的舞蹈队为该社区居民自行组建的社区团体，平时会经常在活动室进行排练，因该社区只有一个活动室，考虑到居民使用的不同需求，接来电反映后，居委干部已和舞蹈队沟通，将排练音量尽量调低，避免对其他居民使用活动室造成较大影响。", "结案时间": "2024-08-30 09:51:03", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-22 10:42:53", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "大连居委", "派遣时间": "2024-08-22 15:40:36", "案件期限": 7, "处置计时": "5天17小时15分钟40秒", "案件整体计时": "5天23小时11分钟55秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408223648000043, "原编号": 20240822009944, "案件来源/信息来源": "12345热线", "工单类型": "咨询类", "发现时间": "2024-08-22 10:38", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "旧改征收", "事项名称": "动迁需求", "事项标签": "迁出奖励咨询", "案件描述/内容描述": "市民来电咨询:其原本是上述地址居民，大约2013年左右从该处动迁，当时户口迁移之后，还有一笔费用没有领取，目前动迁安置合同找不到了，想要找该处动迁指挥部。诉求：希望管理部门核实告知，目前应至何处领取相关费用。", "上报地址": "虹口区四川北路961弄", "实际地址": "四川北路961弄", "联系人": null, "联系电话": null, "所属街道": "四川北路街道", "主责部门": "虹口区旧区改造和房屋征收工作指挥部", "协同部门": null, "主处置部门": "虹口区旧区改造和房屋征收工作指挥部/信访室", "协同处置部门": null, "办理描述": "虹口第一房屋征收事务所，经办人徐斐，电话解释说明。陈玉麟为朱玮，四川北路961弄36号401室户口在内人员。其需要调取征收补偿协议及办理户口迁移手续等手续。协议调取请其本人带好身份证至虹口第一房屋征收事务所有限公司，物华路58号7F，登记调取（工作时间：早上9：00-11：30-下午13：30-16：30），咨询电话：65376600。户口迁移手续请联系经办人徐斐13262505279，电话已于2024年8月23日12时25分联系来电人告知办理手续。\n", "结案时间": "2024-08-28 08:39:50", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-22 15:59:15", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "中州居委", "派遣时间": "2024-08-22 16:01:01", "案件期限": 7, "处置计时": "3天0小时3分钟45秒", "案件整体计时": "3天22小时2分钟36秒", "事实认定": "有政策依据", "诉求认定": null, "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408229647100042, "原编号": 20240822009217, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-22 10:37", "状态": "已结案", "事项类别": "公共管理", "事项大类": "城管执法", "事项小类": "街面秩序执法", "事项名称": "其它", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述商家多次破坏店旁边人行道上的绿化，并且将玻璃堆放在绿化上。城管找过其都没用。诉求：请管理部门核实制止。（市民要求信息保密 无需回复）", "上报地址": "虹口区广粤路561号 永鑫门窗", "实际地址": "广粤路561号上海永鑫门窗组装部", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "凉城新村街道办事处", "协同部门": null, "主处置部门": "凉城新村街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "经现场查看，诉求人反映情况属实，绿化带中垃圾已清理，并已警告隔壁商家，禁止将一切物品放置绿化带。", "结案时间": "2024-08-28 16:41:20", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-22 10:36:33", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "文苑三居委", "派遣时间": "2024-08-22 15:31:51", "案件期限": 7, "处置计时": "4天0小时3分钟48秒", "案件整体计时": "4天6小时4分钟7秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408226223800041, "原编号": 20240822009642, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-22 10:34", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "美丽家园", "事项标签": "美丽家园改造需求", "案件描述/内容描述": "市民来电反映:上述地址小区通道地面坑坑洼洼，居民通行容易崴脚，房屋外墙面陈旧，诉求：希望管理部门核实，安排进行美丽家园改造（需回复）。", "上报地址": "虹口区江湾镇街道华严路98弄万峰小区", "实际地址": "华严路98弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "虹口区住房保障和房屋管理局", "协同部门": null, "主处置部门": "虹口区住房保障和房屋管理局/案件审理科", "协同处置部门": null, "办理描述": "经查询上海市物业管理监管与服务平台，华严路98弄万峰小区一期，建筑面积28850.43平方米，为1997年竣工的商品房小区。\n目前，根据我区整体规划等实际情况，全区“美丽家园”项目改造范围主要针对售后房小区，故商品房小区暂不在改造范围内。后续我局将根据全区旧住房修缮情况及区级财力，适时将商品房小区纳入改造范围。", "结案时间": "2024-08-28 15:29:09", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-22 10:33:55", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "宝鸿居委", "派遣时间": "2024-08-22 15:31:00", "案件期限": 8, "处置计时": "3天17小时41分钟20秒", "案件整体计时": "4天4小时53分钟57秒", "事实认定": "不属实", "诉求认定": "诉求过高", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408226011000040, "原编号": 20240822009661, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-22 10:34", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "美丽家园", "事项标签": null, "案件描述/内容描述": "市民来电反映：小区正在进行美丽家园改造，其1楼防盗门门口拆除了4根吊顶支撑的柱子，现在没有安装回去，存在巨大安全隐患。诉求：请管理部门核实要求尽快安装回去。", "上报地址": "虹口区水电路191弄3号", "实际地址": "水电路191弄3号", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "经核实，来电人反映的四根柱子为防盗门两侧的柱子，未修缮前无两侧柱子，且施工未改变原始顶的结构（附图），不存在安全隐患。来电人诉求内容不存在，故认定不属实。", "结案时间": "2024-08-29 10:52:48", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-22 14:32:54", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "何家宅居委", "派遣时间": "2024-08-22 16:01:43", "案件期限": 7, "处置计时": "4天17小时1分钟11秒", "案件整体计时": "5天0小时17分钟40秒", "事实认定": "不属实", "诉求认定": "诉求过高", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408223256300039, "原编号": 20240822008500, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-22 10:32", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋管理", "事项名称": "房屋产权", "事项标签": null, "案件描述/内容