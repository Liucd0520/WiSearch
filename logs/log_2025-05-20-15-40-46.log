0, "处置计时": "9天2小时46分钟34秒", "案件整体计时": "10天9小时41分钟33秒", "事实认定": "部分属实", "诉求认定": "诉求过高", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408183835500043, "原编号": 20240818010484, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-18 12:52", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "路状路况", "事项标签": null, "案件描述/内容描述": "市民来电反映:其上述地址门口人行道道路路面过高比商铺高，8月18日雨水倒灌进入商铺。诉求：要求尽快前来整修处理。(要求回复)", "上报地址": "虹口区广灵四路112号豪享来", "实际地址": "广灵四路112号豪享来", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "\n经了解，该处为广灵四路道路中修工程范围，区建管委已通知施工单位进行处理，目前施工单位负责人正在与市民商讨解决方案。电话联系市民，表示理解。\n", "结案时间": "2024-08-21 08:59:36", "结案期限(是否超时)": "正常", "市紧急程度": "次紧急", "收单时间": "2024-08-18 14:18:58", "紧急程度": "次紧急", "所属片区": "第一片区", "所属居委": "广灵居委", "派遣时间": "2024-08-18 15:07:48", "案件期限": 7, "处置计时": "1天16小时30分钟36秒", "案件整体计时": "2天8小时59分钟36秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408181584400044, "原编号": 20240818010578, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-18 12:54", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "路状路况", "事项标签": null, "案件描述/内容描述": "市民来电反映:8月18日12：50分下了暴雨，虹口区江湾镇新市北路丰镇路处有严重的积水，市民是此处的商铺，现商铺都进水了，之前也有积过水，还没有得到解决现又积水了，现诉求：请管理部门尽快落实解决积水问题。", "上报地址": "虹口区江湾镇新市北路丰镇路", "实际地址": "新市北路丰镇路", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "江湾镇街道已于8月20日接单。虹口区城运中心已于8月18日15:14首联市民。接单后，江湾镇街道工作人员与该区域小区所属朕华物业联系，经了解，该处商铺属华夏物业管理，8月20日，市政、街道、华夏物业工作人员现场核实了解情况，发现截流井处有商铺安装阀门。雨水较大时阀门关闭导致雨水倒灌，该处阀门已于8月28日拆除。工作人员8月28日电话联系市民，按上述内容答复，市民表示满意。 ", "结案时间": "2024-08-29 08:40:14", "结案期限(是否超时)": "过半", "市紧急程度": "次紧急", "收单时间": "2024-08-18 14:28:08", "紧急程度": "次紧急", "所属片区": "第二片区", "所属居委": "镇北居委", "派遣时间": "2024-08-20 08:35:22", "案件期限": 7, "处置计时": "6天8小时0分钟45秒", "案件整体计时": "8天8小时40分钟14秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408183194400042, "原编号": 20240818010315, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-18 12:50", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "垃圾桶/厢房", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址小区现在规定定时定点投放，上午和下午各一个时间段，很不合理，如果早上没有及时丢掉湿垃圾，等到晚上就都是虫了，很不合理，市民希望能够延长投放时间或者取消这个规定，诉求：望管理部门尽快派人查证处理并告知市民为什么设置定时定点的原因。（需回复）", "上报地址": "虹口区四川北路1727弄", "实际地址": "四川北路1727弄", "联系人": null, "联系电话": null, "所属街道": "四川北路街道", "主责部门": "四川北路街道办事处", "协同部门": null, "主处置部门": "四川北路街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": "经了解，由于该小区建设时并没有生活垃圾集中投放厢房，故根据垃圾分类投放要求，自2019年至今只能使用采取定时定点放置分类垃圾桶模式，以满足居民分类投放需求。关于市民提及“希望能延长时间”，由于不同居民对于投放时间的诉求不一样，同时考虑尽量减少定时定点垃圾桶对周边环境影响，因此自2019年起，现有定时定点模式一直维持至今。此外，2024年该小区在每月虹口区垃圾分类实效测评中成绩皆为达标。综上所述，该小区目前仍然采用原定时定点垃圾分类投放模式。同时，街道房办也已督促小区物业，加强对该处的保洁管理与巡查工作。相关情况已向来电人说明。", "结案时间": "2024-08-29 16:02:08", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-19 09:22:52", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "新乡居委", "派遣时间": "2024-08-19 09:56:06", "案件期限": 10, "处置计时": "8天5小时37分钟51秒", "案件整体计时": "8天16小时2分钟8秒", "事实认定": "部分属实", "诉求认定": "诉求过高", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408185045300041, "原编号": 20240818010115, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-18 12:43", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "美丽家园", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址小区近期在进行美丽家园改造，重新使用柏油铺设了地面并且更换了新款的路灯，刚铺设的柏油气味严重由于直接就在居民楼底严重影响市民正常开窗通风，新款式的路灯也华而不实亮度完全不足以在夜间照亮道路。诉求：请承办部门核实考虑实际小区内部使用需要对改造项目进行调整改善。", "上报地址": "虹口区广中路广灵一路 广中二村", "实际地址": "广中二村", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "经由工作人员实地查看，一、现场未发现铺设的柏油路影响居民开窗通风，质量符合相关规定；二、小区内照明设施简约实用，亮度不影响底楼住户休息并且也符合小区夜间通行需要（附图），来电人所述内容不存在，故认定不属实。", "结案时间": "2024-08-26 09:47:55", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-19 08:44:20", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "同心居委", "派遣时间": "2024-08-19 17:02:30", "案件期限": 7, "处置计时": "4天16小时35分钟59秒", "案件整体计时": "5天9小时47分钟55秒", "事实认定": "不属实", "诉求认定": "诉求过高", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408181013800040, "原编号": 20240818009958, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-18 12:37", "状态": "已结案", "事项类别": "公共安全", "事项大类": "消防安全", "事项小类": "消防隐患", "事项名称": "群租", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址群租很吵，住了14个人15个人左右，是单位宿舍，两个房间有三个上下铺，客厅也有三个上下铺。诉求：请管理部门核实整治群租。（市民要求信息保密 需回复）\n", "上报地址": "虹口区金枫里小区42号楼15楼1502室", "实际地址": "虹湾路55弄42号1502室", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/江湾镇街道综合行政执法队", "协同处置部门": null, "办理描述": "江湾镇街道已于8月19日接单。接单后，城管江湾中队即派执法人员于2024年8月20日10时前往现场核实。经查，虹湾路55弄42号1502室为两室一厅，厨房卫生间正常使用，客厅无隔断，各个房间均有多张高低铺，客厅住6人，主卧住4人，次卧住2人。执法人员已责令二房东于9月10日前自行整改，若逾期不整改的，将上报街道平安办并立案查处。执法人员于2024年8月20日下午电话联系来电人，反馈其处理情况，来电人表示满意。", "结案时间": "2024-08-27 09:08:20", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-19 09:36:04", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "虹彩居委", "派遣时间": "2024-08-19 09:37:55", "案件期限": 7, "处置计时": "3天23小时44分钟30秒", "案件整体计时": "6天9小时8分钟20秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408189828600039, "原编号": 20240818009628, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-18 12:23", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "非居住用房", "事项名称": "园区", "事项标签": null, "案件描述/内容描述": "市民来电反映:市民告知自己家有块地在上述地址厂房内，8月18日上午去上坟扫墓，但是工作人员却不让自己进去，市民诉求：管理部门核实并尽快给予说法。（需回复）", "上报地址": "虹口区粤秀路351号", "实际地址": "粤秀路351号", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "虹口区国有资产监督管理委员会", "协同部门": null, "主处置部门": "虹口区国有资产监督管理委员会/党群工作科", "协同处置部门": null, "办理描述": "由于联系人韩女士电话一直在通话中未能取得联系，通过场地原业主方上海手术器械厂与韩女士的亲戚韩小培女士取得了联系，请其代为转述给了韩女士进入园区的方式：提前告知上海手术器械厂，由上海手术器械厂通知园区登记后即可进出园区。", "结案时间": "2024-08-27 17:01:54", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-19 13:56:14", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "馨苑居委", "派遣时间": "2024-08-20 09:33:35", "案件期限": 7, "处置计时": "3天4小时50分钟49秒", "案件整体计时": "6天17小时1分钟54秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408187255300038, "原编号": 20240818009177, "案件来源/信息来源": "12345热线", "工单类型": "意见建议类", "发现时间": "2024-08-18 12:14", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "道路改建", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址经过改造后通道被取消，行人需要绕道走，不方便。诉求：请重新开放该处通道。 ", "上报地址": "虹口区广粤路跨铁路和丰镇路有个通道", "实际地址": "广粤路跨铁路和丰镇路有个通道", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "经了解，市民反映的“通道”为江杨南路跨线桥桥下空间原菜场内部通道，现该处已被改造成为市民健身场地。关于市民要求增设通道的建议，考虑到市民可通过距离不远的丰镇路跨越江杨南路桥，现阶段没有必要调整市民健身场地单独开辟通道，故暂不采纳市民建议。\n         ", "结案时间": "2024-08-21 14:52:29", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-19 10:59:44", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "胜利居委", "派遣时间": "2024-08-19 15:01:37", "案件期限": 7, "处置计时": "1天1小时31分钟41秒", "案件整体计时": "2天14小时52分钟29秒", "事实认定": "不采纳", "诉求认定": null, "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408184036600037, "原编号": 20240818009067, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-18 12:08", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "美丽家园", "事项标签": "美丽家园改造需求", "案件描述/内容描述": "【重新交办，要求：答复要点与实际情况不符。小区美丽家园项目公示方案时，公开图显示585弄40号通往717弄1号为无障碍通道并且没有路障，现在未经过业主大会征询擅自设置路障，迫使585弄非机动出行业主和坐轮椅车、推婴儿车业主从机动车通道绕道，存在安全隐患，以后发生安全事故请问找哪个部门负责。诉求：请再次处理。（市民要求信息保密，需要回复）最近办结的工单编号：20240729036046，工单内容：重新交办，要求：答复要点与实际情况不符。锦苑小区美丽家园项目在未经过业主大会表决征询的情况下，擅自加装路障，目前小区物业保洁工都因为路障而不再进紫藤花架处清扫，也不再有巡逻保安经此巡逻，电瓶车肆意...", "上报地址": "虹口区凉城新村街道锦苑小区585弄40号西侧", "实际地址": "凉城路585弄40号", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "凉城新村街道办事处", "协同部门": null, "主处置部门": "凉城新村街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "经了解，诉求人反映路障栏杆位于锦苑小区汶水东路717弄和凉城路585弄之间的小花园出入口。该小花园在美丽家园工程改造前原本设有栏杆，用于防止电瓶车进入，保障在其中休憩居民的人身安全，避免地砖被压坏。美丽家园项目征询包含小花园改造，应周边绝大多数居民需求对栏杆进行换新，不存在擅自加装情况。小花园道路为步行道，禁止机动车非机动车通行，婴儿车、轮椅车可以从指定出入口出行。针对原先存在非机动车出入现象，已树立标识标牌，禁止非机动车车出入。小区内部通行不分机动车道与非机动车道，改造未对内部通道动向造成影响。", "结案时间": "2024-08-23 16:20:19", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-19 09:14:04", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "锦一居