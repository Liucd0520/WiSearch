0072, "原编号": 20240823015410, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-23 12:02", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "文明施工措施不落实", "事项标签": null, "案件描述/内容描述": "【重新交办，要求：按答复市民要点告知市民，市民表示答复市民要点与实际情况明显不符，回复是招商云玺承认的施工事故，与市民反映的事情根本不是同一件事件，诉求：要求虹口区人民政府哪个部门哪个人回复的，为什么要定性市民为反复信访人员，拿出市民反复信访的证据。反复信访是错误的吗？最近办结的工单编号：20240809035658，工单内容：市民来电反映:市民从2023年3月多次投诉欧洲花园北侧招商云玺在建工地发生生产安全事故，导致欧洲花园北侧围墙倒塌，主管部门至今没有进行施工事故调查，也没有公布事故调查报告，诉求：要求对于这件事进行事故调查，并公布事故调查报告，要求电话告知市民过去一年多为何不调查的...", "上报地址": "虹口区临平北路89弄", "实际地址": "临平北路89弄", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "嘉兴路街道办事处", "协同部门": null, "主处置部门": "嘉兴路街道办事处/社区平安办公室", "协同处置部门": null, "办理描述": "市民反映诉求涉及规划天虹路上历史遗留构筑物处置矛盾（欧洲花园与招商云玺小区相邻权群体纠纷）。2023年3月30日上午，欧洲花园个别居民找到施工队，自行作业违法新建墙体。城管及时完成取证。当晚双方居民之间发生争执，欧洲花园小区内有聚集情况，有居民拨打110报警。一居民受伤送医，后自行返家、情况稳定。街道赶赴现场较快疏散。公安立案处理，调查发现系抛砖误自伤。该矛盾系2023年第二批主题教育中街道党工委认领问题。街道落实上级要求，条块联动完成整改。市民于2023年4月至8月8次通过网信形式重复信访。", "结案时间": "2024-08-30 10:37:13", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-23 16:40:43", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "海鸥居委", "派遣时间": "2024-08-23 16:56:04", "案件期限": 7, "处置计时": "4天16小时58分钟35秒", "案件整体计时": "4天22小时35分钟58秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408234222900071, "原编号": 20240823015243, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-23 12:00", "状态": "已退单", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "夜间施工扰民", "事项标签": "道路夜间施工扰民", "案件描述/内容描述": "市民来电反映:虹口区中山北一路和西宝兴路交界处高架下面以及殡仪馆对面存在道路施工噪音扰民现象。时间：每天晚上23:00以后。已经持续一段时间了。诉求：望管理部门核实并要求不要施工噪音扰民", "上报地址": "虹口区中山北一路和西宝兴路交界处高架下面以及殡仪馆对面", "实际地址": "中山北一路和西宝兴路交界处高架下面以及殡仪馆对面", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": null, "协同处置部门": null, "办理描述": null, "结案时间": null, "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-23 15:28:50", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "恒业居委", "派遣时间": "2024-08-23 16:07:46", "案件期限": 7, "处置计时": "5天23小时42分钟51秒", "案件整体计时": "6天3小时49分钟23秒", "事实认定": null