, "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408138357300077, "原编号": 20240813012739, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-13 11:10", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "生活娱乐扰民", "事项标签": null, "案件描述/内容描述": "市民反映：每天园内，一帮老人高分贝引吭高歌，破坏公园宁静休憩的环境氛围。诉求：查处扰民事宜。", "上报地址": "虹口区虹口公园", "实际地址": "虹口公园", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "虹口区绿化和市容管理局", "协同部门": null, "主处置部门": "虹口区绿化和市容管理局/绿化管理事务中心", "协同处置部门": null, "办理描述": "市民反映的情况不属实，合唱团未使用大功率音响，仅是清唱。园方安保手持分贝记录仪均显示在70分贝以下，不存在扰民情况。\n", "结案时间": "2024-08-22 14:56:08", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-13 14:55:58", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "建设居委", "派遣时间": "2024-08-13 14:56:57", "案件期限": 7, "处置计时": "4天18小时30分钟42秒", "案件整体计时": "7天3小时46分钟45秒", "事实认定": "不属实", "诉求认定": "诉求合理", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408136110700076, "原编号": 20240813012022, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-13 11:04", "状态": "已结案", "事项类别": "公共服务", "事项大类": "民生服务", "事项小类": "人力保障", "事项名称": "拖欠工资", "事项标签": "无合同欠薪", "案件描述/内容描述": "市民来电反映:其2024年5月1日至5月4日在上述地址上海愉悦微来医疗美容医院工作，工作了4天，拖欠工资不发。具体金额不清楚，人数为1人，未签署劳动合同。诉求：希望管理部门核实为其讨回被拖欠的工资。", "上报地址": "虹口区四平路776号", "实际地址": "四平路776号  ", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "虹口区人力资源和社会保障局", "协同部门": null, "主处置部门": "虹口区人力资源和社会保障局/监察仲裁管理科", "协同处置部门": null, "办理描述": "经联，上海愉悦薇莱医疗美容医院有限公司已是失信被执行人，账户被法院冻结，无法支付工资，已建议反映人尽快通过劳动仲裁途径维权，其表示接受。", "结案时间": "2024-08-21 16:14:30", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-13 17:07:08", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "和平居委", "派遣时间": "2024-08-13 17:08:30", "案件期限": 7, "处置计时": "5天17小时25分钟15秒", "案件整体计时": "6天5小时10分钟45秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408134145400075, "原编号": 20240813010777, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-13 10:45", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "生活娱乐扰民", "事项标签": null, "案件描述/内容描述": "【重复交办，要求：答复要点不明确，市民表示原处理答复称并