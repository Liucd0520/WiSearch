": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408099769000151, "原编号": 20240809038940, "案件来源/信息来源": "12345热线", "工单类型": "意见建议类", "发现时间": "2024-08-09 21:58", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "道路交通设施", "事项标签": null, "案件描述/内容描述": "市民建议：东沙虹港路123弄瑞虹臻庭大堂，即行人出入口位于东沙虹港路，近日，管理部门在大堂门口设置了道路隔离栏，使得小区居民无法在大堂门口上下车，只能在车库出入口上下车，即影响了车辆出入车库，也给上下车的居民带来较大安全隐患。诉求：建议管理部门拆除大堂门口护栏，并设置相应临时停车点让居民上、下车。", "上报地址": "虹口区东沙虹港路123弄，瑞虹臻庭大堂门口", "实际地址": "东沙虹港路123弄，瑞虹臻庭大堂门口", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "公安局虹口分局", "协同部门": null, "主处置部门": "公安局虹口分局/交通警察支队", "协同处置部门": null, "办理描述": "接到工单后民警立即和来电人取得联系，经核实来电人表示希望拆除上述地址门口的隔离栏，民警现场核实后决定拆除上述地址虹臻庭大堂门口的一节隔离栏，同时将实现改划为虚线。民警将处理情况告知来电人，来电人对民警的办理表示满意。", "结案时间": "2024-08-16 08:51:49", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-10 09:51:26", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "张桥居委", "派遣时间": "2024-08-10 09:52:51", "案件期限": 7, "处置计时": "3天14小时31分钟14秒", "案件整体计时": "4天10小时52分钟20秒", "事实认定": "采纳", "诉求认定": null, "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408097438900150, "原编号": 20240809038742, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-09 21:45", "状态": "已退单", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "夜间施工扰民", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述小区边上靠近周家嘴路和安国路口的工地（施工单位：上海建工）每天施工到凌晨2：00以后，噪音严重扰民，诉求：希望管理核实，并协调调整施工时间，做好降噪处理。（市民要求信息保密 需回复）", "上报地址": "虹口区安国路280号", "实际地址": "安国路280号", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "北外滩街道办事处", "协同部门": null, "主处置部门": null, "协同处置部门": null, "办理描述": null, "结案时间": null, "结案期限(是否超时)": "超时", "市紧急程度": "普通", "收单时间": "2024-08-10 10:40:47", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "禄寿居委", "派遣时间": "2024-08-10 10:47:48", "案件期限": 7, "处置计时": "15天15小时51分钟13秒", "案件整体计时": "15天18小时5分钟45秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访": null}, {"案件编号": 202408096901200149, "原编号": 20240809038644, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-09 21:29", "状态": "已结案", "事项类别": "公共服务", "事项大类": "民生服务", "事项小类": "人力保障", "事项名称": 