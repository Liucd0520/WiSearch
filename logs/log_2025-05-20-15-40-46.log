": null, "案件整体计时": "14天4小时25分钟40秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访": null}, {"案件编号": 202408133416300083, "原编号": 20240813013373, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-13 11:20", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "停车管理", "事项标签": "小区停车管理", "案件描述/内容描述": "市民反映：8月13日10:30，虹口区四川北路街道吉祥居委欧阳路118弄明杨豪苑小区绿化带乱停车（详见附件），导致绿化被破坏，全是轮胎印，此事已经发生了不止一次，物业从不作为，也未采取措施，甚至大白天在有车位的情况下默认这种行为发生，对于小区环境造成很大影响，绿化带也未能及时修复。希望街道居委也能看到此事。诉求：请整治小区乱停车。", "上报地址": "虹口区欧阳路118弄明杨豪苑", "实际地址": "欧阳路218弄", "联系人": null, "联系电话": null, "所属街道": "四川北路街道", "主责部门": "四川北路街道办事处", "协同部门": null, "主处置部门": "四川北路街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "经了解，来电人反映绿化区域有乱停车的情况属实，物业对相关业主已进行劝阻，告知其不要在此停车。中心已要求明杨小区物业及时制止乱停车的情况；物业已设置物理隔离设施制止乱停车行为；对损毁的绿化进行修复和补种。 上述情况已答复告知市民，其表示知晓并表示对处置结果满意。\n", "结案时间": "2024-08-22 17:20:37", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-13 15:22:40", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "吉祥居委", "派遣时间": "2024-08-13 15:35:13", "案件期限": 7, "处置计时": "6天19小时6分钟34秒", "案件整体计时": "7天5小时59分钟13秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408139364000082, "原编号": 20240813013448, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-13 11:20", "状态": "已结案", "事项类别": "公共管理", "事项大类": "公共交通", "事项小类": "非机动车管理", "事项名称": "共享单车停放管理", "事项标签": null, "案件描述/内容描述": "市民反映：虹湾路288弄墨翠里小区共享单车骑入小区时门口保安还是不管不问，小区内存在共享单车的现象还是普遍存在，没有从根本上解决问题，诉求：请切实加强出入口管理，切实解决问题并落到实处。（市民要求信息保密，无需回复）", "上报地址": "虹口区虹湾路288弄墨翠里", "实际地址": "虹湾路288弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "江湾镇街道于2024年8月13日接单，接单后，江湾镇街道工作人员与小区所属佳灵杰物业联系，经了解，物业安保人员在日常执勤时发现共享单车进小区现象均会进行劝阻，但部分居民强行闯入或在保安引导车辆时进入，不存在门口保安不管情况。为避免矛盾激化，物业除在大门口进行劝阻的同时，对遗漏未发现以及强行进入小区的共享单车采取巡查清理机制进行处理。物业已经在8月14日日常巡查小区中发现并对小区内共享单车进行清理，目前暂未发现小区内有共享单车。物业表示：保安及日常巡查时发现共享单车进小区后，将第一时间进行劝离或搬离，切实保障业主的停车权益。江湾镇街道督促物业公司加强保安巡查力度，继续积极引导非机动车有序停...", "结案时间": "2024-08-15 08:39:06", "结案期限(是否超时)": "正常", "市紧急