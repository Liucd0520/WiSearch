: 202408216857200139, "原编号": 20240821038410, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-21 20:03", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "路状路况", "事项标签": null, "案件描述/内容描述": "【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,管理部门回复说再会联系市民协商，之后就再没有回复了。诉求：市民希望管理部门重新处理和市民联系协商解决。（需回复）最近办结的工单编号:20240805029280，工单内容:市民来电反映:7月31日早晨，骑电瓶车经过上述地址，路面在施工，施工单位不清楚，道路坑洼，没有任何警示标志，导致其骑车摔倒，没有报警记录，现在腿部积液，诉求：要求施工队与其联系。】", "上报地址": "虹口区唐山路大连路", "实际地址": "唐山路大连路", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "\n经了解，市民反映的为摔伤后市民将材料发送给工作人员，至今未有下文。管理部门工作人员联系相关人员得知，工作人员已将市民的材料递交至保险公司，目前正在等待回复，工作人员已告知市民该情况，市民表示理解。\n", "结案时间": "2024-08-26 10:06:01", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-22 08:56:21", "紧急程度": "一般", "所属片区": "东片区", "所属居委": "源福居委", "派遣时间": "2024-08-22 11:06:33", "案件期限": 7, "处置计时": "1天0小时26分钟35秒", "案件整体计时": "2天14小时2分钟51秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408213245500138, "原编号": 20240821038457, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-21 20:02", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "加装电梯", "事项标签": "加梯工程不文明施工", "案件描述/内容描述": "市民反映：家住三门路750弄14号601。8月21日是老房子外装电梯的第一天，本来这是政府为民办实事的好事情，也期盼已久。谁知道第一天施工就把其家底楼的信箱锁撬掉了，事先不通知，事后不解释，一问三不知，诉求：投诉野蛮施工撬掉信箱锁，要求修复。 ", "上报地址": "虹口区三门路750弄14号", "实际地址": "三门路 750弄14号  ", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": " 江湾镇街道已于8月22日接单。虹口区城运中心已于8月22日9时27分首联市民告知已接单。接单后，江湾镇街道工作人员迅速向相关代建单位进行核实。据查证，代建单位在8月21日施工前已张贴告示进行通知，对损坏诉求人底楼信箱的行为表示了歉意。针对此事件，街道已与代建单位进行了沟通，要求其尽快修复受损设施，并向受影响的居民致以歉意。8月23日下午，街道工作人员已将相关情况通报给居民。经了解，该处信箱锁已修复。工作人员8月27日电话回访市民，市民表示满意。", "结案时间": "2024-08-28 09:50:20", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-22 09:25:19", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "三门居委", "派遣时间": "2024-08-22 09:27:01", "案件期限": 7, "处置计时": "3天7小时32分钟5秒", "案件整体计时": "4天13小时47分钟11秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408212540400137, "原编号": 20240821038409, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-21 20:02", "状态": "已结案", "事项类别": "公共管理", "事项大类": "公共交通", "事项小类": "非机动车管理", "事项名称": "非机动车停放管理", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址的小区内的所有电动车充电装置，只能投币使用，不能线上支付，且现有的设备都是损坏，无法正常使用。诉求：请管理部门尽快维修设备，并尽快开通线上支付功能。", "上报地址": "虹口区凉城路1201弄", "实际地址": "凉城路1201弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": " 江湾镇街道已于8月22日接单。虹口区城运中心已于8月22日15:55首联市民告知已接单。接单后，江湾镇街道工作人员与小区所属百特物业取得联系，反馈了市民的问题和诉求。物业表示因网络支付先前存在支付后无法充电的情况，故小区充电装置尚不支持线上支付，目前充电有投币和充卡两种方式。已将损坏的充电设备进行了报修，工作人员督促物业耐心与居民沟通，服务好小区居民。工作人员于8月27日与反映人取得联系，按上述内容答复。工作人员8月28日电话回访，市民表示认可。", "结案时间": "2024-08-29 08:51:38", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-22 13:57:36", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "镇西居委", "派遣时间": "2024-08-22 15:55:08", "案件期限": 7, "处置计时": "4天0小时53分钟59秒", "案件整体计时": "5天12小时50分钟29秒", "事实认定": "部分属实", "诉求认定": "诉求过高", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408217484700136, "原编号": 20240821036631, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-21 19:09", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "物业收费", "事项标签": null, "案件描述/内容描述": "市民来电反映:其居住在上述小区，有两栋楼电费支付给物业的。物业按照1.2元一度收取，非机动车充电1元两小时，拖线充电就被告知违法充电，当地人可以充。市民表示物业存在乱收费。诉求：故来电投诉物业乱收电费。（市民要求信息保密，无需回复）", "上报地址": "虹口区广灵一路74弄", "实际地址": "广灵一路74弄 ", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "接到诉求后，经城运中心工作人员了解，来电人反映的广灵一路74弄海虹小区，非机动车充电为1元两小时，但没有物业收取居民楼电费的情况，居民用电都是电力公司发账单给到居民，由居民自行缴纳的。小区充电桩是敞开式的，只要有空余位置，包括当地人在内的任何人都可以随到随充，机器识别充电，不分当地人与否。", "结案时间": "2024-08-27 08:54:37", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-22 08:44:51", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "新虹居委", "派遣时间": "2024-08-22 08:46:57", "案件期限": 7, "处置计时": "2天5小时45分钟56秒", "案件整