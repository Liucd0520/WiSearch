 null, "办理描述": "\"经查，奎照路4弄为新工房，属于虹口区334街坊，未列入334街坊征收范围。\n经办人于2024年8月22日14:04电话告知联系人上述地址不符合旧区改造条件，无旧区改造计划，对方表示理解。\n", "结案时间": "2024-08-27 10:00:08", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-18 10:12:20", "紧急程度": "一般", "所属片区": "第五片区", "所属居委": "车站居委", "派遣时间": "2024-08-18 10:12:41", "案件期限": 7, "处置计时": "5天9小时6分钟10秒", "案件整体计时": "6天10小时0分钟8秒", "事实认定": "不采纳", "诉求认定": null, "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408189475100018, "原编号": 20240818002256, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-18 08:58", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "美丽家园", "事项标签": "施工噪音扰民", "案件描述/内容描述": "市民来电反映:8月17日8点：00开始，美丽家园施工电钻噪音扰民。之前市民有向12345反应过噪音扰民现象，现在又死灰复燃。诉求：请管理部门核实让施工队不要在周末施工，并在施工时降低施工噪音。", "上报地址": "虹口区东江湾路580弄1号楼", "实际地址": "东江湾路580弄", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "虹口区住房保障和房屋管理局", "协同部门": null, "主处置部门": "虹口区住房保障和房屋管理局/案件审理科", "协同处置部门": null, "办理描述": "经了解，该居民投诉地址:虹口区 2022 年模一、东江等小区美丽家园(屋面及相关设施改造)工程，接到投诉单后，项目部安排专人到现场查看，该居民所住的金江公寓美丽家园施工已经完成，居民投诉的噪音扰民不是美丽家园施工造成的。后与物业沟通了解，是电梯抢修施工所产生的噪音，该情况已告知当地居委。", "结案时间": "2024-08-30 15:11:12", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-18 09:22:52", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "模范居委", "派遣时间": "2024-08-18 09:23:16", "案件期限": 10, "处置计时": "9天14小时53分钟7秒", "案件整体计时": "9天15小时11分钟12秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408186264100017, "原编号": 20240818002063, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-18 08:50", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "装修噪音扰民", "事项标签": "高分贝装修噪音扰民", "案件描述/内容描述": "市民来电反映:上述地址（具体门牌号市民表示不清楚）近几日从8:00开始就开始装修，电钻敲打声，严重影响休息。诉求：请管理部门核实要求文明施工，降低噪音扰民。（市民要求信息保密 无需回复）", "上报地址": "虹口区福德路与吴淞路 福德商务楼5楼", "实际地址": "福德商务楼5楼", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "北外滩街道办事处", "协同部门": null, "主处置部门": "北外滩街道办事处/西片区（热线）", "协同处置部门": null, "办理描述": "8/19接单，接单后街道相关工作人员至现场查看，经现场查看未发现装修施工情况。工作人员与经营方负责人沟通，如涉及装修施工行为必须按照文明施工要求落实各项管控措施。", "结案时间": "2024-08-27 09:14:34", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-18 08:49:43", "紧急程度": "一般", "所属片区": "西片区", "所属居委": "大名路第二居委", "派遣时间": "2024-08-18 08:50:11", "案件期限": 7, "处置计时": "4天14小时23分钟51秒", "案件整体计时": "6天9小时14分钟34秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408182175300016, "原编号": 20240818001893, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-18 08:41", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共区域维护", "事项标签": null, "案件描述/内容描述": "市民反映：虹口区车站北路732弄36号后是上海然生物业管理的小区，其在2024年8月17日突然发现一夜之间车站北路732弄小区的广粤路入口的围墙上多了特易充的电机动车（新能源汽车）的好几个充电桩。其对于充电桩是否公用，安装是否有手续存在疑问，这些特易充的充电桩安装应要征求小区业主意见，但问遍小区业主，业主们都摇头说不知道，市民表示已问过然生物业公司，对方答复物业不知情，市民表示小区业主不同意在围墙上安装充电桩。诉求：请管理部门处理充电桩事宜。（市民要求信息保密，无需回复）", "上报地址": "虹口区车站北路732弄36号后", "实际地址": "车站北路732弄36号后", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "凉城新村街道办事处", "协同部门": null, "主处置部门": "凉城新村街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": "经了解，车站北路732弄小区购置新能源汽车的居民人数增多，新能源车充电成为业主面临的难题，部分业主私自飞线充电，不仅给小区安全埋下了极大的隐患，还容易引发邻里矛盾。为响应居民新能源车充电需求，解决飞线充电的安全隐患，居民区组织楼组长召开了相关议事会议，在征集居民意见的基础后，联合物业共同商讨，研究决定选址、建设方案等工作，经过居民区两委班子会议讨论决定，在不动用小区维修资金以及不改变原公共停车区域面积的情况下，联系新能源汽车充电桩第三方公司按照流程进行充电桩安装、测试。目前已在小区36号-39号楼对墙上为居民安装了一排充电桩，解决了居民群众新能源车充电难的问题。", "结案时间": "2024-08-27 14:43:06", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-18 08:38:22", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "文苑一居委", "派遣时间": "2024-08-18 08:39:22", "案件期限": 7, "处置计时": "6天9小时35分钟58秒", "案件整体计时": "6天14小时43分钟6秒", "事实认定": "属实", "诉求认定": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408183127300015, "原编号": 20240818001741, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-18 08:37", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "经营噪声扰民", "事项标签": null, "案件描述/内容描述": "【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,夏天开市更早，6:00就开始剁猪肉，引起楼房共振，市民表示之前缓解过一段时间，最近又开始噪音扰民。诉求：请管理部门核实协调剁肉噪音扰民的问题。最近办结的工单编号:20240311018591，工单内容:市民来电反映:虹口区海伦路216号壹号土猪商铺，每天早上7:00不到就开始剁肉，噪音扰民，双休日也是那么早的，向居委反映一年多都没有改善，诉求：要求商铺改变剁肉的位置或者延迟剁肉时间。（市民要求信息保密 需回复）】", "上