 "是否满意区回访": "未评价"}, {"案件编号": 202408121041300008, "原编号": 20240812001413, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-12 08:06", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "装修噪音扰民", "事项标签": "超时限装修噪音扰民", "案件描述/内容描述": "市民来电反映:上述居民周末装修，8:00不到就开始了。诉求：希望管理部门解决装修噪音。（需回复）", "上报地址": "虹口区三门路719弄3号1102", "实际地址": "三门支路719弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "江湾镇街道已于8月12日接单。虹口区城运中心已于8月12日14时25分首联市民。接单后，经与三门路719弄3号小区所属物业公司联系，经物业核实，未发现1102室有过早装修扰民的情况。工作人员已督促物业公司与虹口区三门路719弄3号1102室的施工人员沟通，合理安排装修时间，晚间6时至次日上午8时和节假日，不得从事敲、凿、锯、钻等产生严重噪声的施工。施工期间应采取有效措施防止灰尘扩散，减轻或避免施工过程中对相邻业主日常生活造成的影响。经与市民沟通，其表示情况有所好转。", "结案时间": "2024-08-21 09:37:28", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-12 14:24:14", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "镇北居委", "派遣时间": "2024-08-12 14:25:12", "案件期限": 7, "处置计时": "6天2小时16分钟0秒", "案件整体计时": "7天1小时30分钟5秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408124821700007, "原编号": 20240812001298, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-12 08:06", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "夜间施工扰民", "事项标签": "道路夜间施工扰民", "案件描述/内容描述": "市民来电反映:上述道路夜间施工，持续到凌晨一点。诉求：希望管理部门解决夜间施工噪音。（需回复）", "上报地址": "虹口区三门路719弄", "实际地址": "三门路719弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "经了解，该处为三门路三门支路下水管道修复工程，交警要求夜间施工，已申请办理夜间施工备案。区建管委已通知施工单位做好文明施工安排，要求施工单位在23:00后严禁破路等高噪音施工，且要求施工单位在破路施工时，必须采取相应降噪措施，减少噪音污染。电话联系市民，表示理解。", "结案时间": "2024-08-20 08:07:32", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-12 14:22:08", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "镇北居委", "派遣时间": "2024-08-12 14:23:05", "案件期限": 7, "处置计时": "0天18小时40分钟33秒", "案件整体计时": "6天0小时2分钟8秒", "事实认定": "属实", "诉求认定": "诉求过高", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408123864300006, "原编号": 20240812001252, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-12 08:05", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "天桥", "事项标签": null, "案件描述/内容描述": "【重新交办，答复要点不明确，目前每次经过都还是看到没有维修好，老人走楼梯非常不方便，影响正常出行，对其表示不认可，诉求：希望管理部门核实后，能够让其尽快维修处理（信息保密，无需回复）最近办结的工单编号：20240729001139，工单内容：市民来电反映:上述地址的电梯已维修3周还未修理好，市民表示看到周边老人走楼梯不是很方便。诉求：请管理部门核实，尽快维修好电梯。（市民要求信息保密 无需回复）】", "上报地址": "虹口区海宁路吴淞路天桥上的电梯", "实际地址": "海宁路吴淞路天桥上的电梯", "联系人": null, "联系电话": null, "所属街道": "四川北路街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "经了解，市民反映的电梯为吴淞路海宁路天桥东南角电梯，该处电梯外墙玻璃存在碎裂的情况，有较大安全隐患，为保障行人通行安全，我委市政部门采取应急措施暂停了该电梯使用，同时进行了更换玻璃维修工作。因该处玻璃定制需一定时间，故暂时尚未维修。我委市政部门正要求玻璃供货商加快进度，待到货及时进行玻璃更换，尽快恢复电梯正常运行。反映人信息保密，无需回复。\n", "结案时间": "2024-08-13 10:46:27", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-12 09:35:02", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "南克俭居委", "派遣时间": "2024-08-12 09:36:10", "案件期限": 7, "处置计时": "0天5小时51分钟14秒", "案件整体计时": "1天2小时41分钟4秒", "事实认定": "属实", "诉求认定": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408122874900003, "原编号": 20240812000858, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-12 07:37", "状态": "已结案", "事项类别": "公共管理", "事项大类": "公共交通", "事项小类": "非机动车管理", "事项名称": "共享单车停放管理", "事项标签": null, "案件描述/内容描述": "市民来电反映:8月12日06:38看到，身穿嘉兴路街道的工作人员在搬运上址的共享单车，不让市民骑行，市民认为上址本来就可以停非机动车，全收走不合理，对出行不便。诉求：请管理部门核实不要收走共享单车，从而解决最后一公里的问题。（市民要求信息保密 需回复）", "上报地址": "虹口区四平路780弄门口", "实际地址": "四平路780弄门口", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "嘉兴路街道办事处", "协同部门": null, "主处置部门": "嘉兴路街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "接单后第一时间联系投诉人了解情况。四平路780弄是小区出口与沿街商铺及商务楼宇出口交汇处，日常非机动车量就很大，为了确保早晚高峰的通畅，让市容定时短驳拉走单车，以便于道路出口畅通，投诉人表示自己出门，没有共享单车出行不方便。与多方协调后市容队员短驳共享单车的时候给投诉人留5-10量单车，方便投诉人出行，投诉人对此表示满意。", "结案时间": "2024-08-19 14:18:03", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-12 10:25:15", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "和平居委", "派遣时间": "2024-08-12 10:26:10", "案件期限": 7, "处置计时": "4天22小时33分钟15秒", "案件整体计时": "5天6小时40分钟34秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区