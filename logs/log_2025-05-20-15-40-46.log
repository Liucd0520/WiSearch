交车站，后续会将收运共享单车的机动车位置前移与公交车站错开，尽量不影响交通，确保安全的前提下进行清运。目前单车已经有序停放。", "结案时间": "2024-08-21 10:18:16", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-18 09:13:02", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "东五居委", "派遣时间": "2024-08-18 09:13:30", "案件期限": 7, "处置计时": "1天16小时9分钟48秒", "案件整体计时": "2天10小时18分钟16秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408185949800007, "原编号": 20240818000989, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-18 07:47", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共区域维护", "事项标签": null, "案件描述/内容描述": "【安全隐患案件】市民来电反映:市民路过时上述小区门口人行道处，有居民大量的烧纸，火非常大，存在较大的安全隐患。诉求：请相关部门排查隐患。（市民要求信息保密 无需回复）", "上报地址": "虹口区下海庙对面（昆明路海门路）", "实际地址": "下海庙对面（昆明路海门路）", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "北外滩街道办事处", "协同部门": null, "主处置部门": "北外滩街道办事处/东片区（热线）", "协同处置部门": null, "办理描述": "8月19日北外滩街道接单。市民电话0。片区执法人员于8月18日至海门路昆明路沿街香烛店店铺开展检查，现场有露天焚烧行为，执法人员责令整改并立案处罚，同时对沿街的香烛店店员及店长进行教育提醒，要求香烛店不得提供焚烧设施让顾客进行露天焚烧，避免产生空气污染。后续，执法队安排社服人员对海门路昆明路周边区域加强巡查，发现违规行为第一时间进行劝阻。", "结案时间": "2024-08-20 15:18:28", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-18 08:53:40", "紧急程度": "一般", "所属片区": "中片区", "所属居委": "提篮桥居委", "派遣时间": "2024-08-18 08:54:52", "案件期限": 7, "处置计时": "1天12小时43分钟43秒", "案件整体计时": "1天15小时18分钟28秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408186853400006, "原编号": 20240818000770, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-18 07:21", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "美丽家园", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址小区内正在施工改造，然后双休日早上也是6点多开始施工，声音很吵，严重扰民，诉求：望管理部门尽快派人查证督促施工方双休日不要施工。（市民要求信息保密 无需回复）", "上报地址": "虹口区水电路花园路的何家宅191弄", "实际地址": "水电路191弄", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "虹口区住房保障和房屋管理局", "协同部门": null, "主处置部门": "虹口区住房保障和房屋管理局/案件审理科", "协同处置部门": null, "办理描述": "虹口区房管局于 2024年8月 18 日接到“ 12345”热线居民投诉,该居民反映:8月18日7点21，小区正在美丽家园施工，址小区内正在施工改造，然后双休日早上也是6点多开始施工，声音很吵，严重扰民，针对此投诉，相关经办同志收到投诉单后第一时间督促施工单位于(8月18日)进行调查并进行处理