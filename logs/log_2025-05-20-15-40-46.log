请不属实。江湾镇街道工作人员在2024年8月13日和投诉人进行联系，投诉人表示已经打通电话，且有物业工作人员接听。", "结案时间": "2024-08-21 17:05:40", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-12 16:19:17", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "虹纺居委", "派遣时间": "2024-08-12 16:21:45", "案件期限": 7, "处置计时": "6天23小时47分钟5秒", "案件整体计时": "7天3小时38分钟12秒", "事实认定": "不属实", "诉求认定": "诉求过高", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408128617900116, "原编号": 20240812018686, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-12 13:26", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "物业安保", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述小区内新物业公司擅自放老物业公司的人进入大楼随意在市民的家贴条子。市民表示新物业公司在每栋楼都安装了门禁，要求录入人脸或指纹或者专门的钥匙开门，但是对老物业公司的人擅自进入楼栋贴条子却放任不管。诉求：投诉新物业公司的行为。（市民要求信息保密 无需回复）", "上报地址": "虹口区 瑞虹新城一期", "实际地址": "瑞虹新城一期", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "嘉兴路街道办事处", "协同部门": null, "主处置部门": "嘉兴路街道办事处/嘉兴路街道城运中心", "协同处置部门": null, "办理描述": "经了解，小区现万科物业并未授权原物业工作人员进入小区进行催缴物业费活动。催缴人员以小区外来人员身份进入小区，擅自进入楼栋进行张贴催缴物业费通知书。物业公司表示将加强小区流动人员的管理，维护小区的秩序。同时，街道城运中心（小区治理办）要求原物业服务企业采取合法、合理的方式，催缴物业费，并尊重业主的合法权益。", "结案时间": "2024-08-16 16:54:10", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-12 15:55:46", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "安丘居委", "派遣时间": "2024-08-12 15:57:03", "案件期限": 7, "处置计时": "3天22小时46分钟6秒", "案件整体计时": "4天3小时26分钟43秒", "事实认定": "部分属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408122145500115, "原编号": 20240812018510, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-12 13:24", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "环卫", "事项名称": "污水冒溢", "事项标签": null, "案件描述/内容描述": "市民来电反映:其为上述地址商铺，商铺后小区、将污水往马路上排放，但排水阀没有开启导致污水全部溢到商铺1楼。诉求：请管理部门核实，尽快疏通排污。", "上报地址": "虹口区江湾镇丰镇路3号", "实际地址": "丰镇路3号", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "\n经现场查看了解，市民反映的问题为8月12日下午强降雨时，管道堵塞问题，且堵塞的管道属于物业管养范围，区建管委本着为市民排忧解难的原则，跨前一步对此处管道进行了疏通，目前已经解决市民的诉求。工作人员已再次联系市民，告知市民其所认定的阀门非市政安装属于物业设施，现场已无积水无堵塞情况。电话联系市民，表示理解。\n", "