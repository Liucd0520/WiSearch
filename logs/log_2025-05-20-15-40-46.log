报地址": "虹口区东宝兴路宝山路", "实际地址": "东宝兴路宝山路", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "经现场查看，反映情况属实，区建管委已通知养护单位进行处理，现已将路面坑塘修复，同时工作人员正在与市民协商赔偿事宜。电话联系市民，表示理解。\n", "结案时间": "2024-08-20 15:46:06", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-16 14:35:21", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "华昌居委", "派遣时间": "2024-08-16 15:43:29", "案件期限": 7, "处置计时": "1天0小时26分钟38秒", "案件整体计时": "2天1小时50分钟44秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408164590100080, "原编号": 20240816018395, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-16 13:49", "状态": "已结案", "事项类别": "公共服务", "事项大类": "卫生计生", "事项小类": "医疗服务", "事项名称": "社区卫生服务", "事项标签": null, "案件描述/内容描述": "市民来电反映:市民之前脚抽筋，前往上述地段医院综合科室诊治，给市民开了维生素D2。市民每天两粒吃了大半年。近期又去配药，上述地段医院没有，市民就去了凉城地段医院配药，对方医师告知市民维生素D一个星期最多只能吃两粒，市民服用了这么长时间肯定已经中毒了，建议市民去三甲医院检查。市民表示在春满园地段医院前后看过三个医生，都没有告知维生素D2不能多吃，导致市民错误服药。诉求：投诉上述地段医院医生没有告知市民药物正确的用法用量，不符合用药规范，请管理部门核实并整治。防止再有其他市民错误用药。", "上报地址": "虹口区新同心路283号广中路街道社区卫生服务中心（春满园站点）", "实际地址": "新同心路283号广中路街道社区卫生服务中心（春满园站点）", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "虹口区卫生健康委员会", "协同部门": null, "主处置部门": "虹口区卫生健康委员会/公共卫生管理科", "协同处置部门": null, "办理描述": "8月21日上午联系市民陈女士。告知市民骨质疏松根据诊疗指南推荐，建议市民每日口服一粒D2软胶囊，定期检测25（OH）维生素D浓度，若浓度仍较低，建议市民继续口服。市民表示理解，愿意前往春满园站点就诊并检测。", "结案时间": "2024-08-26 16:19:15", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-16 16:55:12", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "广中居委", "派遣时间": "2024-08-16 16:56:56", "案件期限": 7, "处置计时": "2天21小时31分钟25秒", "案件整体计时": "6天2小时29分钟58秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408163967200079, "原编号": 20240816018847, "案件来源/信息来源": "12345热线", "工单类型": "咨询类", "发现时间": "2024-08-16 13:44", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "旧改征收", "事项名称": "动迁需求", "事项标签": null, "案件描述/内容描述": "市民来电咨询:市民来电反映上述地址是老房子属于203街坊，市民想了解近期是否有动迁的计划。诉求：请管理部门核实并告知。（需回复）", "上报地址": "虹口区山阴路145弄28号-29号", "实际地址": "山阴路145弄", "联系