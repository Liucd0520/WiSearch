 "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "老旧小区改造", "事项标签": null, "案件描述/内容描述": "【重新交办要求，答复要点与实际情况不符，之前答复说会提供1年前给小区房屋做的安全监测报告，但到现在都没拿到这份报告，请尽快提供。需回复最近办结的工单编号20240725030558，内容市民来电咨询:该小区是五十年代的房子，之前一直在反映旧房改造的问题。现想了解一下旧房改造的进度。】", "上报地址": "虹口区新港路榆兰新村", "实际地址": "榆兰新村", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "虹口区住房保障和房屋管理局", "协同部门": null, "主处置部门": null, "协同处置部门": null, "办理描述": null, "结案时间": null, "结案期限(是否超时)": "超时", "市紧急程度": "普通", "收单时间": "2024-08-12 15:16:38", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "榆兰居委", "派遣时间": "2024-08-12 15:46:14", "案件期限": 7, "处置计时": "15天0小时4分钟54秒", "案件整体计时": "15天2小时53分钟43秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访": null}, {"案件编号": 202408124499100088, "原编号": 20240812017213, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-12 12:52", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "房屋漏水", "事项标签": null, "案件描述/内容描述": "市民来电反映:现正在下暴雨，市民告知由于当时的美丽家园建设没有完善，导致无法抽水，现市民家中出现进水，积水现象。诉求：希望管理部门核实，并针对房屋内积水进行处理", "上报地址": "虹口区柳营路45弄35号", "实际地址": "柳营路45弄", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "经现场核实，来电人为柳营路45弄拆迁遗留户李煜。8月11日10时左右突降暴雨，防汛预警出现第一时间，街道即安排相关人员到达现场进行了处置，并告知该户至安全处暂避风雨。8月11日下午2点现场核实，小区美丽家园工程后，排水顺畅，排水管道无堵塞，来电人所诉房屋内屋外均已无积水。\n来电人在柳营路45弄小区内有三套房屋，来电人所诉房屋为虹房集团拆迁地块被占应拆未拆的旧房，无产权，为非法占用，占用事宜已由区政府领导批示进行拆除。故房屋出现积水并非来电人所诉美丽家园建设没有完善，也非小区物业管辖及维修范围，所有损害应由占据使用人自行修复，上诉情况已多次上门告知。", "结案时间": "2024-08-20 16:40:34", "结案期限(是否超时)": "过半", "市紧急程度": "次紧急", "收单时间": "2024-08-12 14:19:20", "紧急程度": "次紧急", "所属片区": "第四片区", "所属居委": "柳营居委", "派遣时间": "2024-08-12 14:20:01", "案件期限": 7, "处置计时": "4天20小时50分钟32秒", "案件整体计时": "6天3小时45分钟10秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408127714400087, "原编号": 20240812017099, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-12 12:53", "状态": "已退单", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "夜间施工扰民", "事项标签": null, "案件描述/内容描述": "市民来电反映:市民家住虹口区衡水路89弄，近一周多以来， 小区外四平路吴淞路附近一直有道路施工，具体是何工程不知，每天22：00左右开工，一直要持续到次日3：00左右，施工噪音严重扰民，无施工铭牌，不知工期， 也不知是否有夜间施工许可，诉求：请管理部门核实对方是否有夜间施工许可，如有要求施工方降低施工噪音，并告知工期，如没有，要求禁止夜间施工。（市民要求信息保密 无需回复）", "上报地址": "虹口区衡水路89弄", "实际地址": "衡水路89弄", "联系人": null, "联系电话": null, "所属街道": "四川北路街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": null, "协同处置部门": null, "办理描述": null, "结案时间": null, "结案期限(是否超时)": "超时", "市紧急程度": "普通", "收单时间": "2024-08-12 14:42:20", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "四川居委", "派遣时间": "2024-08-12 14:43:04", "案件期限": 7, "处置计时": "15天1小时8分钟4秒", "案件整体计时": "15天2小时57分钟45秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访": null}, {"案件编号": 202408123436800086, "原编号": 20240812017031, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-12 12:51", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "房屋漏水", "事项标签": null, "案件描述/内容描述": "市民来电反映:其是上述地址居民，其表示现在2024年8月12日由于下大雨其现在家中有水都漫到家中了，表示联系不到物业居委希望管理部门能够尽快给其进行抢修处理房屋内漫水的情况。诉求：请管理部门核实处理其家中现在漫水的情况。（市民要求信息保密 需要回复）", "上报地址": "虹口区西江湾路264弄9号1楼", "实际地址": "西江湾路264弄9号1楼", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "接到诉求后，城建中心立即让264弄新昌物业上门查看，经维修工检修下水道并未堵塞。12日12时37分上海市气象台中午已发布暴雨橙色预警，雨量达80毫米以上的短时强降雨。西江湾路264弄为老式小区，排水系统老旧，雨量太大，没有办法及时完全排出。居委与物业工作人员接到诉求已第一时间用防汛沙袋将一楼进口堵住，阻止水势蔓延。8月13日10：25已告知来电人以上内容。", "结案时间": "2024-08-13 16:09:50", "结案期限(是否超时)": "正常", "市紧急程度": "次紧急", "收单时间": "2024-08-12 14:04:17", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "同心居委", "派遣时间": "2024-08-12 14:04:49", "案件期限": 7, "处置计时": "1天1小时25分钟7秒", "案件整体计时": "1天3小时18分钟24秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "一般"}, {"案件编号": 202408127322500085, "原编号": 20240812017110, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-12 12:50", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "路状路况", "事项标签": "人行道路面积水影响通行", "案件描述/内容描述": "市民来电反映:上述地址的甘河路上的下水管道被堵塞了，目前在往外冒水，市民称有积水淹没脚的高度，导致小区内水位很高，整条甘河路整个被淹掉了，诉求：请管理部门核实情况，尽快安排疏通。", "上报地址": "虹口区甘河路110号", "实际地址": "甘河路110号", 