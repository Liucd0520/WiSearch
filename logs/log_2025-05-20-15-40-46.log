 "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "\n经现场查看，反映情况属实，区建管委已通知养护单位进行处理，现已修复完毕。电话联系市民，表示理解。\n", "结案时间": "2024-08-20 16:04:46", "结案期限(是否超时)": "正常", "市紧急程度": "次紧急", "收单时间": "2024-08-16 08:55:58", "紧急程度": "次紧急", "所属片区": "第一片区", "所属居委": "广二居委", "派遣时间": "2024-08-16 08:57:22", "案件期限": 1, "处置计时": "0天6小时13分钟8秒", "案件整体计时": "2天7小时9分钟28秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408165525100014, "原编号": 20240816002913, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-16 08:52", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "装修噪音扰民", "事项标签": "超时限装修噪音扰民", "案件描述/内容描述": "市民反映：上述地址住户工作日早上7:00就开始用电钻装修，噪音扰民。诉求：督促整改。(市民要求信息保密，需要回复）", "上报地址": "虹口区新一小区13号601", "实际地址": "新市南路560弄13号601室", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "公安局虹口分局", "协同部门": null, "主处置部门": "公安局虹口分局/江湾派出所", "协同处置部门": null, "办理描述": "接此工单后，江湾所与诉求人取得联系，解释沟通相关情况。经核，其反映的点位为出租房，在其投诉当日进行了地板的维修，目前已结束维修，我所民警已电联该处房东进行法律告知，要求其不得在违规时间段装修噪音扰民，该房东表示知晓，后续我所会加强相关点位的关注。", "结案时间": "2024-08-23 10:45:00", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-16 09:31:32", "紧急程度": "一般", "所属片区": "第六片区", "所属居委": "新南居委", "派遣时间": "2024-08-16 10:06:21", "案件期限": 7, "处置计时": "3天22小时31分钟38秒", "案件整体计时": "5天1小时51分钟44秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408164797300013, "原编号": 20240816002637, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-16 08:50", "状态": "已结案", "事项类别": "公共服务", "事项大类": "社区共治", "事项小类": "居委会", "事项名称": "高空抛物", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址小区存在严重的高空抛物现象，小区内也没有安装高空抛物摄像头，其诉求：望管理部门核实查处并整改。（市民要求信息保密 需回复）", "上报地址": "虹口区赤峰路590号", "实际地址": "赤峰路600弄", "联系人": null, "联系电话": null, "所属街道": "曲阳路街道", "主责部门": "曲阳路街道办事处", "协同部门": null, "主处置部门": "曲阳路街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": "8月16日，社工办工作人员方国华现场了解到，赤峰路590号属于鸿雁家委会辖区，8月16日居委工作人员上门2306室告知、提醒不要随意高空抛物，影响小区公共环境，但2306室否认之前有高空抛物现象。对于市民反映的小区高层有高空抛物的现象，家委会继续加强宣传，引导居民杜绝不文明行为。在随后回访中了解到，16日晚间又发生抛物。居委会对楼上四户业主进行问询排摸，2305、2405目前无人居住，2406、2306表示未高空抛物，由于缺少直接证据，故无法进行处置。对此居委会表示将持续关注该现象。对于更换对高空摄像头问题，由于更换设备金额较大，涉及到使用小区维修资金，故实施难度较大。相关提议将通过居委...", "结案时间": "2024-08-26 09:06:35", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-16 09:36:43", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "鸿雁居委", "派遣时间": "2024-08-16 10:03:19", "案件期限": 8, "处置计时": "5天0小时23分钟14秒", "案件整体计时": "6天0小时15分钟17秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408163977900012, "原编号": 20240816002719, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-16 08:48", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共设施设备的新增或维修", "事项标签": null, "案件描述/内容描述": "市民来电反映:其居住在上述地址2楼，市民称整个2楼都是其的，目前下雨天漏水，导致了楼道内被雨水弄得很脏很臭，无法正常生活，市民称其身体很差，无法处理，诉求：请管理部门核实情况，市民请求街道帮助清理楼梯。", "上报地址": "虹口区四川北路1906弄35号2楼", "实际地址": "四川北路1906弄35号", "联系人": null, "联系电话": null, "所属街道": "四川北路街道", "主责部门": "四川北路街道办事处", "协同部门": null, "主处置部门": "四川北路街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": "接单后，我办立即前往现场了解情况，据了解，来电人反映是因房屋漏水导致家中的私有部位楼梯过道脏乱，我办联系佳灵杰，佳灵杰表示该脏乱部位并非公共部位，清理为有偿服务。但可以帮助其免费清理一次，如后续还需清理服务，请支付相应费用。目前已清理完毕。关于漏水相关问题，已由虹房集团川北物业上门与市民沟通，并给予相应维修方案。", "结案时间": "2024-08-29 15:44:53", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-16 09:21:08", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "余庆坊居委", "派遣时间": "2024-08-16 10:05:17", "案件期限": 10, "处置计时": "9天5小时30分钟9秒", "案件整体计时": "9天6小时55分钟30秒", "事实认定": "部分属实", "诉求认定": "诉求过高", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408163899700011, "原编号": 20240815040482, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-15 21:54", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "商业物业", "事项标签": null, "案件描述/内容描述": "市民来电反映:虹口区虹口龙之梦内的男女厕所都太脏了，每个楼层的厕所走进去都有臭味。市民质疑为何能获得上海公共卫生厕所许可证，认为商场工作未做到位。诉求：希望管理部门核实并要求整改。", "上报地址": "虹口区虹口龙之梦", "实际地址": "虹口龙之梦", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/营商环境办公室", "协同处置部门": null, "办理描述": "在接到相关投诉后，工作人员第一时间赶赴现场，实地走访，了解情况。目前，商场已根据投诉人反映的情况进行了整改。后续，商场也会继续加强对公厕的环境保洁工作，为顾客提供一个良好的购物环境。8/16工作人员已将相关处理情况告知了投诉人。", "结案时间": "2024-08-20 16:04:13", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-16 08:55:51", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "同心居委", "派遣时间": "2024-08-16 10:01:42", "案件期限": 7, "处置计时": "1天4小时2分钟42秒", "案件整体计时": "2天7小时28分钟54秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "基本满意"}, {"案件编号": 202408164557000010, "原编号": 20240816001938, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-16 08:32", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共区域维护", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述小区上述楼栋，8月15日，物业公司将保洁使用的水龙头封掉了，导致保洁和本栋楼居民用水困难。诉求：市民希望居委和业委会加强对于物业公司的监管，并尽快恢复该水龙头的供水。（市民要求信息保密 无需回复）", "上报地址": "虹口区凉城路539弄33号", "实际地址": "广灵四路572弄", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "凉城新村街道办事处", "协同部门": null, "主处置部门": "凉城新村街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "秀苑小区共对生活垃圾投放点设置有8个洗水设备，经8月23日实际现场查看，秀苑小区各生活垃圾投放点洗手设备用水情况，洗手设备均可正常使用。\n前期对凉城路539弄区域因水龙头损坏，故暂停用水，进行更换维修工作，非诉求人所述“物业公司将保洁使用的水龙头封掉了”的情况。", "结案时间": "2024-08-28 16:40:45", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-16 10:15:47", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "秀苑居委", "派遣时间": "2024-08-16 14:01:15", "案件期限": 13, "处置计时": "8天2小时18分钟11秒", "案件整体计时": "8天8小时7分钟27秒", "事实认定": "部分属实", "诉求认定": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408164954900009, "原编号": 20240816001934, "案件来源/信息来源": "12345热线", "工单类型": "咨询类", "发现时间": "2024-08-16 08:28", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "停车管理", "事项标签": null, "案件描述/内容描述": "市民反映：上述地址外墙修复施工，搭建脚手架导致占用内部部分停车位。市民听说属地政府向有关部门报备，将大楼外部黄山路道路报备了6个停车位，并且是6辆指定车牌号。咨询：1，上述内容是否属实。2，缴纳小区停车费的市民，因施工导致车辆无法停入小区，目前属地是怎么处理协调。诉求：请管理部门核实后告知相关信息。", "上报地址": "虹口区黄山路12号", "实际地址": "黄山路12号", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "2024年8月22日，街道城运中心电话联系投诉人，告知黄山路12号急修工程，因需要施工通道，故将靠大楼这边的所有车辆暂时性停在黄山路马路上，此事已和业务主管部门申报同意。这些车辆虽然停在马路上，还是按照小区包月车缴纳停车费直到工程结束。至于是否还影响其它车辆在院子里停车的，待施工方把脚手架搭起来后再做调整。投诉人还有疑问建议向属地居委书记提出（该书记是黄山路12号急修工程协调专班成员）。投诉人表示认可。", "结案时间": "2024-08-26 09:05:55", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-16 10:10:31", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "黄山居委", "派遣时间": "2024-08-20 15:05:18", "案件期限": 7, "处置计时": "3天1小时0分钟6秒", "案件整体计时": "6天0小时36分钟38秒", "事实认定": "对政策解释不接受", "诉求认定": null, "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408161962800008, "原编号": 20240816001611, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-16 08:18", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "夜间施工扰民", "事项标签": null, "案件描述/内容描述": "市民反映：近一月来虹口区实验学校（巴林路60弄8号）半夜持续施工搬运，8月16日0：50照片（详见附件），且清晨5：30左右开始持续抛物大音量噪音，严重影响居民日常作息，已造成却工作时间心率不齐、自主神经紊乱等症状。诉求：投诉噪音扰民。（市民要求信息保密，需要回复）", "上报地址": "虹口区巴林路60弄8号", "实际地址": "辉河路65号", "联系人": null, "联系电话": null, "所属街道": "曲阳路街道", "主责部门": "虹口区教育局", "协同部门": null, "主处置部门": "虹口区教育局/事务中心", "协同处置部门": null, "办理描述": "8月16日致电该市民，告知其学校利用暑期修缮校舍，由于当日从外地进施工材料，白天进不来，只有在晚上进来后才能卸材料，跟施工单位沟通后，后续尽量调整施工安排，减少扰民现象。", "结案时间": "2024-08-21 09:38:22", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-16 09:36:44", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "运三居委", "派遣时间": "2024-08-16 10:37:30", "案件期限": 7, "处置计时": "0天23小时48分钟16秒", "案件整体计时": "3天1小时19分钟5秒", "事实认定": "属实", "诉求认定": "诉求过高", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408166374500007, "原编号": 20240816001387, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-16 08:09", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "擅自占用道路堆物、施工", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址是快递站，把快递堆放在人行道上，影响通行，请整顿处理。（市民要求信息保密 需回复）", "上报地址": "虹口区玉田路500号", "实际地址": "玉田路500号", "联系人": null, "联系电话": null, "所属街道": "曲阳路街道", "主责部门": "曲阳路街道办事处", "协同部门": null, "主处置部门": "曲阳路街道办事处/曲阳路街道综合行政执法队", "协同处置部门": null, "办理描述": "执法队员于2024年8月19日上午赴实地查看，确认玉田路500号门前安装有丰巢快递柜，部分快递堆放在快递柜区域，未发现占用人行道的行为。调查了解，因玉田路500号为中科院上海技术物理研究所（涉密单位），故该单位门卫处只接受中国邮政EMS件。其余快递及相关快递人员均无法入内，故现有的丰巢快递柜无法承载该单位快递量，导致部分分拣后的快递堆积在丰巢快递柜区域，个别快递人员在分拣过程中偶尔会出现占道行为。下一步，中队将加强对该处的巡查管理，规范快递人员分拣行为，确保人行道畅通。", "结案时间": "2024-08-23 1