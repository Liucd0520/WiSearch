": "2024-08-20 08:59:49", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "虹仪居委", "派遣时间": "2024-08-20 10:37:13", "案件期限": 10, "处置计时": "8天4小时37分钟0秒", "案件整体计时": "9天14小时3分钟14秒", "事实认定": "部分属实", "诉求认定": "其他", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408194454900162, "原编号": 20240819036573, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-19 18:45", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "装修噪音扰民", "事项标签": null, "案件描述/内容描述": "市民来电反映:其8月19日18:25拨打上述地址小区所属华昌居委电话：56629892反映小区内存在业主装修扰民问题，一位女性工作人员接听。对方告知可以装修到19点，19点之后如果还存在，让市民找对方业主协商，协商无法解决，让市民拨打110。市民询问到19点结束是根据哪条规定，对方无法提供。诉求：市民投诉居委工作人员不专业、处理方式不对存在推诿，希望管理部门核实进行查处。（市民要求信息保密 无需回复）", "上报地址": "虹口区东宝兴路465号", "实际地址": "东宝兴路465号  ", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": "经2024年8月19日华昌居委值班老师核实，当天值班是有接到一位女士投诉双宝大厦装修扰民的电话，居委老师询问扰民的门牌号以便上门跟进，诉求人告知是双宝大厦后就挂断电话。居委老师联系物业后一起上门解决。电话中居委老师并未提及可以装修到19点以及让诉求人拨打110的情况，不存在居委工作人员不专业，处理方式存在推诿。鉴于以上情况，该案申请不属实。", "结案时间": "2024-08-27 15:46:20", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-20 08:29:06", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "华昌居委", "派遣时间": "2024-08-20 09:10:58", "案件期限": 7, "处置计时": "5天1小时44分钟37秒", "案件整体计时": "5天21小时1分钟8秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408197744700161, "原编号": 20240819036262, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-19 18:36", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区绿化", "事项标签": null, "案件描述/内容描述": "【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,市民表示答复不符合事实，其咨询过绿化部门，区绿化部门明确告知夏季是不适宜对树木进行移栽的，并且市民对于树木根系被破坏有确切的照片证据。最近办结的工单编号:20240731011363，工单内容:市民反映：7月25日玖利物业张贴了移树许可证，7月27日几位邻居一起就此事与物业经理交流，告知现在高温不适合移树，并询问何时安排移树，经理回复不清楚。7月29日业主发现物业私下移除585弄门口香樟树，未按《上海市绿化管理条例》的标准操作，把树杆全部锯掉，未保留二级枝条，几乎将所有的树根拉断、锯断，伤口参差不齐，没有土球，没有防腐剂。几乎...", "上报地址": "虹口区凉城路585弄1号门口", "实际地址": "凉城路585弄1号", "联系人": null, "联系电话": null, "所属街道": "凉城新村街道", "主责部门": "凉城新村街道办事处", "协同部门": null, "主处置部门": "凉城新村街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "经核实，该处树木原始生长歪曲且影响美丽家园门头施工，经区绿化中心审批通过小区移树申请并公示后，由专业队伍开展移树，不存在私下移树的情况。\n由现场照片可见，该树木原始生长歪曲且因有倾倒情况已进行临时固定。为确保其移栽后能够成活，故对枝条修剪后再进行移栽。由于移栽地点在同一小区且其树木根系在移栽前已不完整，故不适宜用土球。完成移栽后，已浇灌有机水溶肥料对树木进行保护。该树木目前已顺利移至小区其它区域且成活。关于移树的季节并无明确限制,移树整体流程符合相关规定不存在违规操作。\n综上所述，诉求人反映的情况不属实，本工单申请不属实件。", "结案时间": "2024-08-29 08:31:23", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-20 08:55:39", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "锦一居委", "派遣时间": "2024-08-20 10:43:41", "案件期限": 7, "处置计时": "6天6小时22分钟57秒", "案件整体计时": "7天13小时54分钟11秒", "事实认定": "不属实", "诉求认定": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408192220900160, "原编号": 20240819036370, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-19 18:32", "状态": "已退单", "事项类别": null, "事项大类": null, "事项小类": null, "事项名称": null, "事项标签": null, "案件描述/内容描述": "市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。诉求：希望管理部门核实转送相关照片至承办部门。【相关工单编号：20240819036139】", "上报地址": "虹口区水电路583弄9号405室", "实际地址": "虹口区水电路583弄9号405室", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": null, "协同处置部门": null, "办理描述": null, "结案时间": null, "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": null, "紧急程度": null, "所属片区": "第一片区", "所属居委": "新虹居委", "派遣时间": null, "案件期限": 15, "处置计时": null, "案件整体计时": "9天21小时19分钟35秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访": null}, {"案件编号": 202408195151400159, "原编号": 20240819036107, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-19 18:29", "状态": "已结案", "事项类别": "公共服务", "事项大类": "社区共治", "事项小类": "居委会", "事项名称": "楼道堆物", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址居民在楼道内堆放了很多老旧家电，很多使用过又不清理的家电，导致周边环境脏乱差蟑螂很多，有消防隐患。诉求：市民来电投诉，要求尽快清理。（市民要求信息保密 需回复）", "上报地址": "虹口区汶水东路510弄7号楼403室(正对楼梯口)", "实际地址": "汶水东路510弄7号", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "城运中心工作人员2024年8月21日15点已经安排物业对汶水东路510弄7号楼每层都张贴了楼道禁止堆放杂物告知书，也对楼内居民告知在8月26日内尽快清理干净，对规定时间内未清理的，会有保洁整治清理。截止2024年8月26日10点，汶水东路510弄7号楼楼道内老旧家电已经清理干净，来电人已知晓，表示满意。", "结案时间": "202