 "工单类型": "投诉举报类", "发现时间": "2024-08-13 16:42", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "基础设施", "事项名称": "市政井盖", "事项标签": null, "案件描述/内容描述": "市民来电反映:2024年8月12日14：50，上述地址由北向南左转弯进入东大名路时，由于道理上一个井盖被无故挪开。导致失眠车辆压过井盖后爆胎。故市民来电投诉虹口区路政部门，诉求：希望管理部门核实，介入处理，协调给予解决方案。", "上报地址": "虹口区新建路东大名路", "实际地址": "新建路东大名路", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "经现场查看，该处井盖目前已经盖好，区建管委已通知养护单位与市民联系，协商赔偿事宜。电话联系市民，表示理解。\n     ", "结案时间": "2024-08-16 16:10:01", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-13 16:54:09", "紧急程度": "一般", "所属片区": "中片区", "所属居委": "西安居委", "派遣时间": "2024-08-13 16:54:57", "案件期限": 7, "处置计时": "2天22小时13分钟14秒", "案件整体计时": "2天23小时28分钟37秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408131450700153, "原编号": 20240813031172, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-13 16:41", "状态": "已结案", "事项类别": "公共安全", "事项大类": "社会治安", "事项小类": "治安管控", "事项名称": "强讨恶要", "事项标签": null, "案件描述/内容描述": "市民来电反映:其在上述公司借款，因为资金周转不开，暂时无力还款，该公司拨打其家人电话进行催收，市民认为该公司违规，诉求：请管理部门核实，要求不要再联系其家人进行催款。", "上报地址": "虹口区海宁路137号7层(集中登记地)，豆豆钱数据科技（上海）有限公司", "实际地址": "海宁路137号7层豆豆钱数据科技（上海）有限公司", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "公安局虹口分局", "协同部门": null, "主处置部门": "公安局虹口分局/北外滩派出所", "协同处置部门": null, "办理描述": "市公安局虹口分局北外滩派出所于2024年8月20日拨打诉求人电话，其始终关机。经调查，负责催收的第三方公司在外地。维信公司仅开展中介平台业务，对外贷款业务资金来源合法，所有放款、还款资金均不在公司形成资金池，借款利息也未高于法律规定，而因其催讨的债务属于合法债务，也并无证据表明有对诉求人采取上门暴力催收及在电话催讨中有威胁、谩骂等行为，故暂无法认定其存在暴力催收等违法犯罪行为。", "结案时间": "2024-08-22 14:19:50", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-14 10:30:56", "紧急程度": "一般", "所属片区": "西片区", "所属居委": "久耕居委", "派遣时间": "2024-08-14 10:31:54", "案件期限": 7, "处置计时": "4天4小时52分钟58秒", "案件整体计时": "6天21小时38分钟28秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "诉求过高", "是否满意区回访": "未评价"}, {"案件编号": 202408131515800152, "原编号": 20240813030458, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-13 16:38", "状态": "已结案", "事项类别": "公共服务", "事项大类": "行政服务", "