240810014131, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-10 14:16", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "停车管理", "事项标签": "小区停车管理", "案件描述/内容描述": "市民来电反映:上述地址小区有500多户，但是物业告知只有90多个名额可以包月停车，剩余400多户停车是100元一天，物业告知是业委会开会通过的决定，市民觉得非常不合理，诉求：希望管理部门可以核实该收费是否合理并要求整改临时停车费并公示上述业委会投票关于临时停车费投票明细。（市民要求信息保密 需回复）", "上报地址": "虹口区新市南路560弄", "实际地址": "新市南路560弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "江湾镇街道于8月10日接单。接单后，江湾镇街道工作人员与小区所属江湾物业取得联系，针对反映人的问题和诉求，小区停车方案于2024年4月8日新一小区业主大会表决通过，自2024年6月1日起施行。对于临时车收费说明：“1、初停车30分钟(含)免费，停车超过30分钟不足1小时，按1小时收费；2、停车按小时收费，不足1小时的按1小时计算；3、同一车辆，连续停放24小时以内最高收费 100 元，超过 24 小时重新计费。”物业按照小区征询通过的停车方案进行收费，反映人要求整改不符合实际情况，申请不属实。工作人员已督促物业服务好小区居民，耐心与居民沟通，做好解释工作。", "结案时间": "2024-08-21 10:22:58", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-11 09:08:14", "紧急程度": "一般", "所属片区": "第六片区", "所属居委": "新南居委", "派遣时间": "2024-08-11 09:09:47", "案件期限": 7, "处置计时": "6天16小时31分钟37秒", "案件整体计时": "7天10小时22分钟58秒", "事实认定": "不属实", "诉求认定": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408102199400066, "原编号": 20240810014485, "案件来源/信息来源": "12345热线", "工单类型": "咨询类", "发现时间": "2024-08-10 14:18", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "物业安保", "事项标签": null, "案件描述/内容描述": "市民来电咨询:上述地址所属物业电话", "上报地址": "虹口区赤峰路商业二村7号", "实际地址": "商业二村7号", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "城运中心工作人员2024年8月12日16点00分电话联系来电人，得知来电人是律师，需要帮居民买卖房屋，需要咨询物业相关事宜。现工作人员已将广同物业座机给到来电人，来电人表示感谢。", "结案时间": "2024-08-15 13:58:05", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-11 08:44:01", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "商洛居委", "派遣时间": "2024-08-11 08:50:37", "案件期限": 7, "处置计时": "1天14小时42分钟24秒", "案件整体计时": "3天13小时58分钟5秒", "事实认定": "有政策依据", "诉求认定": null, "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408106369000065, "原编号": 20240810014158, "案件来源/信息来源": "123