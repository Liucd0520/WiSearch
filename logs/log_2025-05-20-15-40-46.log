道哪些区域是部分禁止或全程禁止共享单车的。诉求：请管理部门告知相关规定。", "上报地址": "虹口区公平路渡口旁边骑行道", "实际地址": "公平路渡口旁边骑行道", "联系人": null, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "北外滩（集团）有限公司", "协同部门": null, "主处置部门": "北外滩（集团）有限公司/北外滩集团滨江管理服务有限公司", "协同处置部门": null, "办理描述": "电话联系市民吴荻，跟其解释根据虹口滨江公共空间《游览守则》第七条规定，共享单车不得进入滨江公共空间区域。主要是因为虹口滨江2.5公里区域中只有秦皇岛路码头一处与市政道路连通，滨江公共空间区域全部处于商务楼的包围之中，且部分骑行道分别与产权主体的金茂集团国航段、上港集团国客段的大物业区域相互借用，并且国航段、国客段的大物业区域为确保商务楼品质形象，他们要求禁止共享单车进入。为防止市民骑共享单车进入大物业区域被要求折返走回头路，故规定共享单车不得进入滨江公共空间区域。请理解配合。", "结案时间": "2024-08-29 09:01:05", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-22 15:02:05", "紧急程度": "一般", "所属片区": "中片区", "所属居委": "北外滩居委", "派遣时间": "2024-08-23 15:45:31", "案件期限": 7, "处置计时": "2天23小时49分钟37秒", "案件整体计时": "4天21小时5分钟58秒", "事实认定": "对政策解释不接受", "诉求认定": null, "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408229509700057, "原编号": 20240822014556, "案件来源/信息来源": "12345热线", "工单类型": "咨询类", "发现时间": "2024-08-22 11:49", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "垃圾清运", "事项标签": null, "案件描述/内容描述": "市民来电咨询:其要进行垃圾丢弃，不清楚床和沙发是否算建筑垃圾，不清楚该垃圾回收是否收费。未和物业咨询过。诉求：希望核查告知其该小区垃圾回收是否收费有无标准。\n", "上报地址": "虹口区凯虹家园", "实际地址": "梧州路299弄", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "嘉兴路街道办事处", "协同部门": null, "主处置部门": "嘉兴路街道办事处/嘉兴路街道城运中心", "协同处置部门": null, "办理描述": "经与反映人联系，其表示其为房东，代租客咨询该情况，城运中心已告知反映人，不同行政规划区内小区可能存在不同规定，目前凯虹家园内的床与沙发按照垃圾分类的要求，此类大件物品在本小区内收费。反映人表示不认可，自己处理。", "结案时间": "2024-08-30 09:51:58", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-22 14:11:06", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "梧州居委", "派遣时间": "2024-08-22 15:56:35", "案件期限": 7, "处置计时": "5天0小时20分钟31秒", "案件整体计时": "5天22小时2分钟50秒", "事实认定": "对政策解释不接受", "诉求认定": null, "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408225621300056, "原编号": 20240822013909, "案件来源/信息来源": "12345热线", "工单类型": "咨询类", "发现时间": "2024-08-22 11:38", "状态": "已结案", "事项类别": "公共服务", "事项大类": "科教文卫体", "事项小类": "教育", "事项名称": "办理转学", "事项标签": null, "案件描述/内容描述": "市民来电咨询:其小孩（10月份左右可以落户上海）在宝山读小学一年级，现在市民因为工作调动，在虹口买了房子，对口学校是上述学校，市民称准备让小孩在上述学校继续读一年级，询问需要哪些条件（市民称马上要9月1日