 17:13:37", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-19 10:53:55", "紧急程度": "一般", "所属片区": "第六片区", "所属居委": "纪念居委", "派遣时间": "2024-08-19 14:47:33", "案件期限": 7, "处置计时": "3天1小时29分钟29秒", "案件整体计时": "3天7小时32分钟21秒", "事实认定": "留作参考", "诉求认定": null, "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408194807800034, "原编号": 20240819005500, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-19 09:41", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "美丽家园", "事项标签": "工程方案不满意", "案件描述/内容描述": "【重新交办，市民称答复不符，并没按照当时约定安装，导致市民现在还是没有办法开窗，市民认为如果燃气泄露无法打开有安全隐患，要求：要求按照市民的要求安装。最近办结的工单编号：20240731013026，工单内容：市民来电反映:上述地址小区有美丽家园建设工程。市民表示工程队安装一楼防盗窗的时候并没有按照全小区统一尺寸安装，导致市民家里不能开窗通风。诉求：请管理部门核实安装35寸并且可以开窗的防盗窗。】", "上报地址": "虹口区广中路194弄6号101室", "实际地址": "广中路194弄6号101室", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "经查，2023年6月，商业一村物业公司根据物业条例第五十九条：物业服务企业发现业主、使用人在物业使用、装饰装修过程中有违反国家和本市有关规定以及临时管理规约、管理规约行为的，应当依据有关规定或者临时管理规约、管理规约予以劝阻、制止；劝阻、制止无效的，应当在二十四小时内报告业主委员会和有关行政部门。为及时排除安全隐患，提升小区整体面貌，对一楼过大、过宽、过旧的防盗窗进行更换。经协商，将对原有防盗窗再次改进。管理部门于8月21日答复来电人，其表示认可。", "结案时间": "2024-08-26 14:18:00", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-19 11:06:50", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "商一居委", "派遣时间": "2024-08-19 11:09:55", "案件期限": 7, "处置计时": "4天22小时33分钟42秒", "案件整体计时": "5天4小时36分钟46秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408199131400033, "原编号": 20240819005056, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-19 09:30", "状态": "待核查", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "房屋修缮", "事项名称": "加装电梯", "事项标签": "催促加梯安装进度", "案件描述/内容描述": "市民反映：上述地址绿华新苑小区加装电梯从2023年5月所有业主交了第一笔费用后，到现在过了15个月一直没有下文，其这栋楼的老年人特别多，都希望快点安装。虹口区的办事效率低，老百姓迫切希望做的事情真就不被重视，这事已经反映多次，一直得不到解决，一直找各种借口。诉求：要求尽快加装电梯。", "上报地址": "虹口区华严路58弄绿华新苑小区", "实际地址": "华严路58弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": null, "结案时间": null