", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "虹口区旧区改造和房屋征收工作指挥部", "协同部门": null, "主处置部门": "虹口区旧区改造和房屋征收工作指挥部/信访室", "协同处置部门": null, "办理描述": "广中一村系新工房，不在零星旧里改造地块计划内，暂无改造征收计划。经了解联系人系产权房的产权人，根据《上海市国有土地上房屋征收与补偿实施细则》(上海市人民政府令第71号)第二十三条第一款、第四十四条规定,房屋征收补偿协议应当由房屋征收部门与被征收人、公有房屋承租人签订。征收居住房屋的，被征收人取得货币补偿款、产权调换房屋后，应当负责安置房屋使用人，如对征收补偿所得分配有异议的，建议其可以通过家庭内部协商、人民调解或司法途径解决征收补偿所得分配问题。综上所述若该地址征收，将与房屋产权人签约，至于是否人户分离与签约无关。\n征收部门工作人员于2024年8月13日14时10分，电话告知来电人上述情况", "结案时间": "2024-08-16 15:51:15", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-12 09:32:39", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "广二居委", "派遣时间": "2024-08-12 09:36:21", "案件期限": 7, "处置计时": "3天23小时25分钟9秒", "案件整体计时": "4天6小时15分钟52秒", "事实认定": "无政策依据", "诉求认定": null, "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408122221600031, "原编号": 20240812005136, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-12 09:32", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "跨门营业", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址门口堆放了很多东西，影响行人通行，诉求：希望管理部门核实依法整治。（市民要求信息保密 需回复）", "上报地址": "虹口区四达路25号", "实际地址": "四达路25号  ", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "欧阳路街道办事处", "协同部门": null, "主处置部门": "欧阳路街道办事处/社区管理办公室", "协同处置部门": null, "办理描述": "接件后，工作人员立即至现场查看发现,情况属实。在现场立即进行了整治，堆物的东西已清理干净，避免影响通行，并会派第三方巡查人员加强日常巡查，若有反复会继续处理。\n\n", "结案时间": "2024-08-14 14:03:58", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-12 10:33:06", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "欧二居委", "派遣时间": "2024-08-12 10:33:41", "案件期限": 7, "处置计时": "1天21小时51分钟52秒", "案件整体计时": "2天4小时30分钟51秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408125261500030, "原编号": 20240812004098, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-12 09:23", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "旧改征收", "事项名称": "动迁需求", "事项标签": null, "案件描述/内容描述": "市民来电反映: 虹口区万安路1129弄是母亲的房产，名字：郭阿暖，2020年左右动迁，但是市民没有收到任何的通知。诉求：请管理部门核实给市民合理的解释。\n\n", "上报地址": "虹口区万安路1129弄", "实际地址": "万安路1129弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "虹口区旧区改造和房屋征收工作指挥部", "协同部门": "江湾镇街道办事处", "主处置部门": "虹口区旧区改造和房屋征收工作指挥部/信访室", "协同处置部门": "江湾镇街道办事处/社区管理办公室", "办理描述": "来电人所反映2020年左右动迁。根据来电人所提供地址，经查询2012年至今所有作出征收决定，启动的征收地块中，并无该地址。另其所提供的产权人：郭阿暖，也并无此产权人在启动地块内。且经街道核实，江湾所述区域并无该地址，且郭阿暖同样查无此人。来电人表述与事实不符。通过沟通联系，来电人只记得万安路1129弄，并不掌握其他信息。我部会同街道，对该地址及人名进行核实均无相关信息。故无相关解释告知。\n", "结案时间": "2024-08-21 14:16:25", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-13 09:17:27", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "万西居委", "派遣时间": "2024-08-13 09:18:34", "案件期限": 10, "处置计时": "5天7小时7分钟54秒", "案件整体计时": "7天4小时53分钟0秒", "事实认定": "不属实", "诉求认定": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408128095300029, "原编号": 20240812004372, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-12 09:22", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "文明施工措施不落实", "事项标签": null, "案件描述/内容描述": "市民反映：8月11日下午，车牌沪EEM235的工程车（上海新虹口市政建设有限公司），在安汾路商铺门口未经商户同意，私自接电排线，市民询问一位没有工作证件的人员施工内容，对方不理不睬，城管询问后，才不耐烦的说是街道要求，态度恶劣。街道表示没有这回事，最后产生冲突差点动手。诉求：投诉上海新虹口市政建设有限公司违法施工。（市民要求信息保密，无需回复）", "上报地址": "虹口区四平路421弄3号", "实际地址": "安汾路", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "虹口区绿化和市容管理局", "协同部门": null, "主处置部门": "虹口区绿化和市容管理局/景观建设管理所", "协同处置部门": null, "办理描述": "接件后，景观所派相关工作人员现场踏勘，目前该点位正在进行美丽街区店招店牌维护工作，就投诉人反应的情况，已联系相关施工单位负责人，现场就投诉情况进行了解释，并对涉事工人进行了批评教育。", "结案时间": "2024-08-14 15:09:02", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-12 10:27:02", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "三门二居委", "派遣时间": "2024-08-13 09:03:39", "案件期限": 7, "处置计时": "1天1小时34分钟52秒", "案件整体计时": "2天5小时45分钟39秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408127763600028, "原编号": 20240812004389, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-12 09:21", "状态": "已结案", "事项类别": "公共服务", "事项大类": "社区共治", "事项小类": "居委会", "事项名称": "楼道堆物", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述位置存在占道堆物，影响通行，堆放的是装有东西的袋子，不清楚具体里面装了什么东西，放置已经有几天无人处理，现诉求希望管理部门尽快核实整治。（市民要求信息保密 需回复）", "上报地址": "虹口区欧阳路507号", "实际地址": "欧阳路507号", "联系人": null, "联系电话": null, "所属街道": "