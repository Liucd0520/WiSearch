", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-20 10:38:20", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "秀苑居委", "派遣时间": "2024-08-20 10:42:01", "案件期限": 10, "处置计时": "8天22小时13分钟41秒", "案件整体计时": "9天1小时7分钟8秒", "事实认定": "部分属实", "诉求认定": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408209555300036, "原编号": 20240820004377, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-20 09:33", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "物业安保", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述地址底楼大门在美丽家园改建的时候将75公分的大门装错成70公分，导致冰箱等一些家具无法搬运出楼房，之前联系物业姓吴的工作人员，告知提前半个月联系，带人将铁门拆除让自己搬运家具电器，现在联系物业让其拆铁门被物业其他工作人员拒绝并表示让自己找人拆，自己不认可，承诺给拆的工作人员也被调走。诉求：要求物业遵守承诺给自己临时拆除大门搬运家具电器。(需回复）", "上报地址": "虹口区辉河路43弄1号1301室", "实际地址": "辉河路43弄", "联系人": null, "联系电话": null, "所属街道": "曲阳路街道", "主责部门": "曲阳路街道办事处", "协同部门": null, "主处置部门": "曲阳路街道办事处/城市建设管理服务中心", "协同处置部门": null, "办理描述": "2024年8月21日房办接到来电人反映拆除大门工单，接件后，房办与物业公司联系告知来电人反映情况，8月22日物业公司已将该门临时拆除，待来电人装修结束后进行重新安装。", "结案时间": "2024-08-23 16:00:32", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-20 10:15:44", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "运三居委", "派遣时间": "2024-08-20 10:50:01", "案件期限": 7, "处置计时": "2天23小时44分钟23秒", "案件整体计时": "3天6小时27分钟14秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408209207300035, "原编号": 20240820005125, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-20 09:33", "状态": "已退单", "事项类别": null, "事项大类": null, "事项小类": null, "事项名称": null, "事项标签": null, "案件描述/内容描述": "市民反映：已通过市民热线反映事项，现要求补充图片作为证据（详见附件）。诉求：希望管理部门核实转送相关照片至承办部门。【相关工单编号：20240820000273】", "上报地址": "虹口区东沙虹港路123弄15栋2503", "实际地址": "虹口区东沙虹港路123弄15栋2503", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "嘉兴路街道办事处", "协同部门": null, "主处置部门": null, "协同处置部门": null, "办理描述": null, "结案时间": null, "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": null, "紧急程度": null, "所属片区": "第三片区", "所属居委": "张桥居委", "派遣时间": null, "案件期限": 15, "处置计时": null, "案件整体计时": "9天6小时17分钟29秒", "事实认定": null, "诉求认定": null, "是否解决区回访": null, "是否满意区回访": null}, {"案件编号": 2024082097