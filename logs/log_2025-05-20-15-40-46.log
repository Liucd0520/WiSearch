, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-25 08:58", "状态": "已结案", "事项类别": "公共服务", "事项大类": "民生服务", "事项小类": "帮困救助", "事项名称": "助残服务", "事项标签": null, "案件描述/内容描述": "【重新交办,要求：按答复要点告知市民,市民表示答复要点不明确,8月25日来电告知现在联系友康又无法联系上了。诉求：要求友康尽快联系市民。最近办结的工单编号:20240617030740，工单内容:市民来电反映:其父亲是盲人，原本虹口区残联有个居家无忧的服务，现在虹口区将这个服务交给友康科技平台管理了。市民表示其在2024年6月16日，预约了6月18日9:00的陪诊的服务，至今没有任何的回复和消息，其联系该平台，工作人员称上报给残联了，在等批复。市民告知，其父亲6月18日早上需要人陪诊看病，迟迟没有消息，其担心会耽误就诊。诉求：请管理部门尽快回复并告知进度。】", "上报地址": "虹口区", "实际地址": "虹口区  ", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "虹口区残疾人联合会", "协同部门": null, "主处置部门": "虹口区残疾人联合会/康复科（群工科）", "协同处置部门": null, "办理描述": "8月26日，已电话联系市民，市民表示已在8月25日联系上“居家无忧”服务商，并完成陪医送药预约。后续区残联将督促第三方服务商加强管理，提高热线接听效率。市民对答复表示满意。", "结案时间": "2024-08-26 10:17:42", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-25 16:12:02", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "梧州居委", "派遣时间": "2024-08-25 16:13:37", "案件期限": 7, "处置计时": "0天8小时49分钟6秒", "案件整体计时": "0天10小时17分钟42秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408256742900016, "原编号": 20240825001997, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-25 08:35", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "夜间施工扰民", "事项标签": "道路夜间施工扰民", "案件描述/内容描述": "【重新交办，要求：答复要点与实际情况不符，2024年8月24日23:11，广灵四路新市路路口。有施工单位进行大分贝的项目施工，之前也有投诉过，依然屡教不改，严重扰民。诉求：投诉夜间施工扰民。最近办结的工单编号：20240623001770，工单内容：市民反映：22:34马路上还在施工，噪音扰民。诉求：请管理部门处理施工扰民事宜。】", "上报地址": "虹口区广灵四路新市路路口", "实际地址": "广灵四路新市路路口", "联系人": null, "联系电话": null, "所属街道": "曲阳路街道", "主责部门": "虹口区建设和管理委员会", "协同部门": null, "主处置部门": "虹口区建设和管理委员会/市政和水务管理中心5", "协同处置部门": null, "办理描述": "经了解，该处为广灵四路道路中修内自来水管道改造工程，此处道路由于交通流量限制交警要求夜间施工作业，已申请办理夜间施工备案。区建管委已通知施工单位做好文明施工安排，要求施工单位在23:00后严禁破路等高噪音施工，且要求施工单位在破路施工时，必须采取相应降噪措施，减少噪音污染。电话联系市民，望市民谅解。\n", "结案时间": "2024-08-29 10:14:52", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-25 14:42:20", "紧急程度": "一般", "所属片区": "第一片区", "所属居委": "上农二居委", "派遣时间": "2024-08-25 14:55:19", "案件期限": 7, "处置计时": "2天9小时6分钟31秒", "案件整体计时": "3天10小时14分钟52秒", "事实认定": "属实", "诉求认定": "诉求过高", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408259589400015, "原编号": 20240825001726, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-25 08:31", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "违规饲养禽类\n（鸡、鸭、鸽子）", "事项标签": null, "案件描述/内容描述": "【重新交办，要求：答复要点不明确，市民表示城管态度很好，说要去处理掉的，但是该住户态度嚣张说城管没有权利管，鸽棚都没有拆，还威胁说要去用胶水堵住投诉人的门锁。诉求：希望管理部门核实并尽快清理鸽棚和鸽子。（市民要求信息保密 需回复）最近办结的工单编号：20240616004512，工单内容：市民来电反映:上述地址有居民在8楼楼顶养鸽子，严重影响居民正常生活，不确定是否参加了信鸽协会，且确定不是8楼的住户。有居民向居委会反映过，但居委会不进行协调，要求向虹口区城管或12345热线反映。诉求：要求管理部门尽快核实处理，不要让鸽子扰民。（市民要求信息保密 需回复）】", "上报地址": "虹口区三门路747弄8号", "实际地址": "三门路747弄", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/江湾镇街道综合行政执法队", "协同处置部门": null, "办理描述": "江湾镇街道已于8月26日接单。虹口区城运中心已于8月25日17时32分首联市民告知已接单。接单后，城管江湾中队即派执法人员于2024年8月30日9时前往现场核实。经查，三门路747弄8号海尚逸苑8楼平台发现摆放有数个鸽笼，执法人员找到当事人，其为信鸽协会会员，但会员证上显示注册地为杨浦。执法人员已责令当事人进行整改并立案查处，案号：沪（虹）江办立字[2024]第100286号。执法人员于2024年8月30日下午电话联系来电人，反馈其处理情况，来电人表示满意。", "结案时间": "2024-08-30 17:05:17", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-25 17:32:26", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "三门二居委", "派遣时间": "2024-08-25 17:32:57", "案件期限": 7, "处置计时": "4天15小时25分钟57秒", "案件整体计时": "4天17小时5分钟17秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "满意"}, {"案件编号": 202408258780400014, "原编号": 20240825001798, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-25 08:27", "状态": "已结案", "事项类别": "公共管理", "事项大类": "环境保护", "事项小类": "噪声污染", "事项名称": "夜间施工扰民", "事项标签": "建筑工地夜间施工扰民", "案件描述/内容描述": "【重新交办，要求：答复要点与实际不符，市民反映：该工地周末清晨6:00进行高噪音施工（钻地机作业），居民无法正常休息。该工地之前已经多次发生噪音超标扰民和违法夜间施工等，经投诉后也只是短暂停止（详见附件）。诉求：督促整改。最近办结的工单编号：20240806002243，工单内容：市民反映：梧州路289号二建公司22:00后无证施工，多次发生（详见附件），2024年7月26日夜间曾报警，但未得到任何回复，2024年8月5日深夜又施工持续至次日24:00后。诉求：请管理部门依法叫停和处罚夜间施工行为。】", "上报地址": "虹口区梧州路289号二建工地", "实际地址": "梧州路289号二建工地", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "嘉兴路街道办事处", "协同部门": null, "主处置部门": "嘉兴路街道办事处/嘉兴路街道行政综合执法队", "协同处置部门": null, "办理描述": "接件后，嘉兴路街道综合行政执法队即派队员赴现场查看，该处在建工地为梧州路289号基地房屋修缮和场地设施翻新项目。根据相关规定工地正常施工时间为早上6时至晚上22时无国定节假日及双休日之分，早上6时属于工地合法施工时间。电话沟通市民向其解释，其表示希望双休日施工时间能有所延迟，队员已协调工地方合理安排施工计划，要求其严格遵守文明施工规定，做好降噪措施，减少对周边小区居民的影响。", "结案时间": "2024-08-30 10:38:27", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-25 10:58:42", "紧急程度": "一般", "所属片区": "第四片区", "所属居委": "梧州居委", "派遣时间": "2024-08-25 10:59:42", "案件期限": 7, "处置计时": "4天8小时34分钟40秒", "案件整体计时": "4天10小时38分钟27秒", "事实认定": "属实", "诉求认定": "其他", "是否解决区回访": "解释说明", "是否满意区回访": "一般"}, {"案件编号": 202408254939800013, "原编号": 20240825001796, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-25 08:26", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "市容环境", "事项名称": "虫鼠害防治", "事项标签": null, "案件描述/内容描述": "市民反映：祥德路450弄3号3楼出现老鼠，在308室出入，308室是97岁的独居老人，无力应对。诉求：请政府部门帮忙清除鼠患。（市民要求信息保密，无需回复）", "上报地址": "虹口区祥德路450弄3号308室", "实际地址": "祥德路450弄3号308室", "联系人": null, "联系电话": null, "所属街道": "欧阳路街道", "主责部门": "欧阳路街道办事处", "协同部门": null, "主处置部门": "欧阳路街道办事处/社区自治办公室", "协同处置部门": null, "办理描述": "接到反映后，居委工作人员上门进行了查看，针对308室独居老人的情况，居委带去了粘鼠板并帮忙进行了放置。", "结案时间": "2024-08-29 09:22:36", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-25 08:46:53", "紧急程度": "一般", "所属片区": "第五片区", "所属居委": "大二居委", "派遣时间": "2024-08-25 08:49:39", "案件期限": 7, "处置计时": "2天16小时8分钟1秒", "案件整体计时": "3天9小时22分钟36秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408256364100012, "原编号": 20240825001480, "案件来源/信息来源": "12345热线", "工单类型": "意见建议类", "发现时间": "2024-08-25 08:16", "状态": "已结案", "事项类别": "公共管理", "事项大类": "市政建设", "事项小类": "市政道路", "事项名称": "道路交通设施", "事项标签": null, "案件描述/内容描述": "市民建议：北横通道不造，周家嘴路没这么堵、一通车后每个匝道出入口，以及地面道路都非常拥堵。举例：北横通道新建路出入口以海伦路为交界，出入口笔直对应，试问出口车辆要进入辅道，向右边道，地面车辆要进入通道向左变道，交叉了就是拥堵的原因，以及地面道路的交通指示标线，及其不合理。随着汽车的保有量越来越大，很多地面交通标线、都不能用以前来了，这样只会加剧道路拥堵，以及红绿灯的时间过长，等一轮红绿灯需要等待3分钟，甚至更长。诉求：建议优化交通标志", "上报地址": "虹口区周家嘴路新建路", "实际地址": "周家嘴路新建路", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "公安局虹口分局", "协同部门": null, "主处置部门": "公安局虹口分局/交通警察支队", "协同处置部门": null, "办理描述": "经查：因北横通道启用后，车流量增多，目前交警部门已根据北横通道的车流量和车辆通行方向将通道内的道路标线重新漆画，已适