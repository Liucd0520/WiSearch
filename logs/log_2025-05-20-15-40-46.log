意"}, {"案件编号": 202408159284100005, "原编号": 20240815001056, "案件来源/信息来源": "12345热线", "工单类型": "求助类", "发现时间": "2024-08-15 07:53", "状态": "已结案", "事项类别": "公共管理", "事项大类": "绿化市容", "事项小类": "绿地绿化", "事项名称": "移植修剪", "事项标签": null, "案件描述/内容描述": "市民来电反映:表示楼下的两棵树很高，差不多有十多米，存在遮挡窗户 ，影响通风的情况，要求处理部门尽快核实修剪。", "上报地址": "虹口区同心路232弄57号201室", "实际地址": "同心路232弄57号201室", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "虹口区绿化和市容管理局", "协同部门": null, "主处置部门": "虹口区绿化和市容管理局/绿化管理事务中心", "协同处置部门": null, "办理描述": "现场核实情况后，修剪了绿地内树木，把对周边居民的影响降到最低，市民已在现场确认过，对处理结果表示满意。\n监督电话已留给市民，后续由关于绿化问题，会直接与我们联系。", "结案时间": "2024-08-21 09:44:01", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-15 09:14:37", "紧急程度": "一般", "所属片区": "第二片区", "所属居委": "同济居委", "派遣时间": "2024-08-15 10:16:23", "案件期限": 7, "处置计时": "3天23小时1分钟53秒", "案件整体计时": "4天1小时50分钟43秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "实际解决", "是否满意区回访": "基本满意"}, {"案件编号": 202408159660300004, "原编号": 20240815000467, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-15 06:31", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区绿化", "事项标签": null, "案件描述/内容描述": "市民来电反映:上述小区大批的绿化被毁坏，要求物业拿出养护记录。诉求：望管理部门核实，要相关部门尽快反馈，进行追责。（市民要求信息保密 需回复）", "上报地址": "虹口区 广联路29弄", "实际地址": "广联路29弄", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "今年入夏后天气异常，不是暴雨就是高温，虽然百特物业小区管理处采取了措施，但是极端天气，还是猝不及防，小区草坪枯萎。经查，目前小区物业已及时补种了麦冬并加强浇水等措施，草坪存活率很低。加上近期天气连续高温不宜开展补种，容易枯死。待凉爽的时候再实施补种工作。物业有手写巡查养护记录,可去物业了解。投诉人表示知晓", "结案时间": "2024-08-26 16:11:58", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-15 09:40:58", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "黄山居委", "派遣时间": "2024-08-15 10:09:36", "案件期限": 8, "处置计时": "7天5小时30分钟54秒", "案件整体计时": "7天9小时40分钟40秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408154265000003, "原编号": 20240815000351, "案件来源/信息来源": "12345热线", "工单类型": "咨询类", "发现时间": "2024-08-15 04:53", "状态": "已退单", "事项类别": null, "事项大类": null, "事项小类": null, "事项名称": null, "事项标签":