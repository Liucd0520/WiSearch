ll, "联系电话": null, "所属街道": "北外滩街道", "主责部门": "北外滩街道办事处", "协同部门": null, "主处置部门": "北外滩街道办事处/东片区（热线）", "协同处置部门": null, "办理描述": "区首联08-10 10:15，8/13 15:35电联答复来电人，经查，该处为弘久新弘北外滩小区，由凡享资产进行日常管理。接诉后房办向物业了解情况，物业安排消防设施设备的安装单位对消防管道进行维保，过程中因操作有误造成漏水情况，影响个别住户及电梯使用。事发后物业立即应急响应，安排保洁进行清扫处理，客服联系相关住户告知情况。同时，物业紧急联系电梯维修单位，对2台电梯进行抢修，目前一台基本能正常运行，另一部电梯等三菱配件到货后进行更换。物业积极采取措施，尽量减小对居民生活的影响。不存在物业不处理，工作态度差的情况。综上所述，投诉人反映的情况不属实。", "结案时间": "2024-08-20 15:56:25", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-10 10:14:46", "紧急程度": "一般", "所属片区": "东片区", "所属居委": "明华坊居委", "派遣时间": "2024-08-10 10:15:57", "案件期限": 7, "处置计时": "6天12小时39分钟44秒", "案件整体计时": "6天20小时6分钟57秒", "事实认定": "不属实", "诉求认定": "其他", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408092943700139, "原编号": 20240809036071, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-09 19:43", "状态": "已结案", "事项类别": "公共安全", "事项大类": "消防安全", "事项小类": "消防隐患", "事项名称": "群租", "事项标签": null, "案件描述/内容描述": "【重新交办，要求：答复要点与实际情况不符，8月8日，其发现该室非但没有积极整改，还在继续搞群租。有人拉着行李箱说：去一号楼的29楼，那里房间很便宜。另外，1号楼27楼也有群租现象。诉求：请再次核实整改。最近办结的工单编号：20240729015153，工单内容：上述地址有严重的群租现象，2室1厅内有40多个床位。群租人员流动性很大，人员素质参差不齐，影响卫生环境，存在重大安全隐患。（详见附件）诉求：请管理部门核实整治群租现象。】", "上报地址": "虹口区汶水东路181弄1号楼2907室和2705室", "实际地址": "汶水东路181弄1号楼2907室和2705室", "联系人": null, "联系电话": null, "所属街道": "江湾镇街道", "主责部门": "江湾镇街道办事处", "协同部门": null, "主处置部门": "江湾镇街道办事处/江湾镇街道综合行政执法队", "协同处置部门": null, "办理描述": "江湾镇街道已于8月12日接单。虹口区城运中心已于8月10日9时34分首联市民告知已接单。接单后，城管江湾中队即派执法人员于2024年8月12日15时前往现场核实。经查，汶水东路181弄1号2907，2705室两室都有群租情况。汶水东路181弄1号2907室中队已立案查处，案号：沪（虹）江办立字[2024]第100206号，执法人员已责令当事人于8月20日自行整改完毕。汶水东路181弄1号2705室每个房间有多张上下铺，已整改完毕。执法人员于2024年8月13日下午电话联系来电人，反馈其处理情况，来电人表示知晓。\n     ", "结案时间": "2024-08-15 14:15:55", "结案期限(是否超时)": "正常", "市紧急程度": "普通", "收单时间": "2024-08-10 09:34:15", "紧急程度": "一般", "所属片区": "第六片区", "所属居委": "纪念居委", "派遣时间": "2024-08-10 09:34:51", "案件期限": 7, "处置计时": "3天11小时11分钟44秒", "案件整体计时": "3天18小时32分钟27秒", "事实认定": "属实", "诉求认定": "诉求合理", "是否解决区回访": "解释说明", "是否满意区回访": "满意"}, {"案件编号": 202408095593400138, "原编号": 20240809035786, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-09 19:33", "状态": "已结案", "事项类别": "公共服务", "事项大类": "社区共治", "事项小类": "业委会", "事项名称": "业委会改选组建", "事项标签": null, "案件描述/内容描述": "【重新交办,按答复要点告知市民,市民表示答复要点不符，市民表示管理部门没有联系告知处理结果。诉求：请管理部门联系告知处理结果。最近办结的工单编号:20240621027274，工单内容:市民来电反映:6月21日，海鸥居委会在下班前张贴公告，针对设施老化和维护成本增高要改选业委会的通知，市民不认可，表示欧洲花园设施日趋老化，不是欧洲花园是否需要换届的原因，海鸥居委书记玩弄文字游戏，表示要听取所有业主的意见，无期限拖延该项工作。嘉兴路街道户籍警缪洁，明确表示启动业委会改选是嘉兴路街道城运中心的职责，居委会无权张贴公告，综上，这份告知书是海鸥居委对欧洲花园业主的欺骗，诉求：要求嘉兴路城运中心立...", "上报地址": "虹口区临平北路89弄", "实际地址": "临平路 89弄", "联系人": null, "联系电话": null, "所属街道": "嘉兴路街道", "主责部门": "嘉兴路街道办事处", "协同部门": null, "主处置部门": "嘉兴路街道办事处/嘉兴路街道城运中心", "协同处置部门": null, "办理描述": "上一件热线工单编号：20240621027274，2024年6月25日19时25分，工作人员通过电话沟通方式主动联系市民，将答复信息告知过市民。市民表示管理部门没有联系告知处理结果不属实。该小区本届业委会任期于2024年5月19日到期。2024年2月28日，街道组织第三方咨询公司、居委、居民在小区召开党组织引领业委会换届改选工作宣讲会。也组织了多场居民接待会，听取居民意见和建议。7月31日，已张贴了业委会换届工作的公告。", "结案时间": "2024-08-20 15:54:49", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-10 10:05:10", "紧急程度": "一般", "所属片区": "第三片区", "所属居委": "海鸥居委", "派遣时间": "2024-08-10 10:07:13", "案件期限": 7, "处置计时": "5天15小时45分钟34秒", "案件整体计时": "6天20小时21分钟15秒", "事实认定": "不属实", "诉求认定": "诉求过高", "是否解决区回访": "未评价", "是否满意区回访": "未评价"}, {"案件编号": 202408093360500137, "原编号": 20240809035476, "案件来源/信息来源": "12345热线", "工单类型": "投诉举报类", "发现时间": "2024-08-09 19:32", "状态": "已结案", "事项类别": "公共管理", "事项大类": "房屋保障", "事项小类": "物业服务", "事项名称": "小区公共区域维护", "事项标签": null, "案件描述/内容描述": "【重新交办，要求：答复要点和实际情况不符。反映至今清扫问题没有改善，楼道每天一次的清扫都扫不了，并且物业最近还请了一个80多岁的老人，对方在垃圾箱房旁边不知道干嘛。诉求：要求解决反映的问题。最近办结的工单编号:20240726030095 ,工单内容：市民来电反映:小区楼道没人清扫，清扫频率不够，楼道脏，物业不作为不管理，故来电投诉，要求提高楼道清扫频率，否则居民就拒付物业费。（市民要求信息保密 需回复）】", "上报地址": "虹口区广中支路商业一村", "实际地址": "广中支路商业一村", "联系人": null, "联系电话": null, "所属街道": "广中路街道", "主责部门": "广中路街道办事处", "协同部门": null, "主处置部门": "广中路街道办事处/城市建设管理服务中心\t", "协同处置部门": null, "办理描述": "该小区由广同物业负责小区管理。小区物业收费标准为0.8元/平方米，其中分为：管理费0.18,保洁费0.26,保安费0.36。按照《上海市住宅物业服务分等收费标准》，楼道内部地面每天打扫一次，小区路面为循环打扫，不存在无人打扫的情况。物业公司也不存在聘用80多岁的老人去打扫垃圾房的情况。", "结案时间": "2024-08-20 15:57:30", "结案期限(是否超时)": "过半", "市紧急程度": "普通", "收单时间": "2024-08-1