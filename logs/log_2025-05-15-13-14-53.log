2025-05-15 13:31:34,420 ChatBI->     INFO     websocket发送的数据为：{"data_detail": [{"编号": 20250311001, "年份": 2016, "区局": "浦东新区", "姓名": "蒋国兴", "年龄": 60, "姓名拼音": "Jiang3-Guo2-Xing1", "性别": "男", "工作单位": "上海供春陶业有限公司", "工种或工作头衔": "陶艺师", "领域": "文化", "行业": "工艺美术", "工匠介绍": "蒋国兴，全国劳动模范、全国五一劳动奖章获得者，享受国务院政府特殊津贴专家。他荣获“民进全国社会服务工作先进个人”“上海市十大职工科技创新英才”“上海市首席技师”等称号，其工作室被命名为“上海市技能大师工作室”并获“全国工人先锋号”。在彩陶技艺领域，他突破多项传统工艺难题，开创具有海派特色的“沪上彩陶”技艺，并发明陶瓷壁挂，被联合国教科文组织国际陶艺学会命名为“蒋国兴”。其作品应用于上海东方艺术中心、上海世博园等重要建筑，获国家专利45项。他还将彩陶技艺用于古建筑修复，解决世界性难题。此外，他热衷技艺传承，培养多名徒弟，参与国际展览和学术研究，出版专著并撰写多篇论文，为陶瓷文化发展作出突出贡献。"}, {"编号": 20250311002, "年份": 2016, "区局": "浦东新区", "姓名": "朱海鸿", "年龄": 52, "姓名拼音": "Zhu1-Hai3-Hong2", "性别": "男", "工作单位": "上海优爱宝机器人技术有限公司", "工种或工作头衔": "机器人研发设计", "领域": "智能机器人", "行业": "高端装备", "工匠介绍": "朱海鸿，国内机器人领域杰出代表，拥有国际领先的机器人设计理念和技术。他曾在国内外知名机构从事机器人研发工作十余年，专注机器人控制理论与技术方法研究，参与完成多项大型项目，拥有国际国内发明专利9项，发表学术报告及文章11篇。2005年赴美创立Sentrinsic有限责任公司，后回国创办上海优爱宝智能机器人科技股份有限公司，带领团队开发出SCARA和Delta工业机器人、浮球矩阵等产品，赢得业界广泛关注。作为技术总监，朱海鸿博士以身作则，坚持学习，善于分享，致力于解决核心技术难题，将领先技术与管理经验带回祖国，在优爱宝平台上实现理想。"}, {"编号": 20250311003, "年份": 2016, "区局": "浦东新区", "姓名": "高金明", "年龄": 60, "姓名拼音": "Gao1-Jin1-Ming2", "性别": "男", "工作单位": "玛戈隆特骨瓷(上海)有限公司", "工种或工作头衔": "造型研发", "领域": "文化", "行业": "工艺美术", "工匠介绍": "高金明，毕业于河北唐山陶瓷技校，后进入唐山第一瓷厂工作，历任多项职务，长期致力于陶瓷工艺技术改造和管理。他曾主持新建年产300万件高级骨质瓷生产线，并参与新产品研发，设计开发数百个新产品。在G20产品赶制期间，他坚守一线，解决技术难题，全身心投入工作。他的努力为玛戈隆特骨瓷和国家争光，获得高度评价。"}, {"编号": 20250311004, "年份": 2016, "区局": "浦东新区", "姓名": "杨震", "年龄": 55, "姓名拼音": "Yang2-Zhen4", "性别": "男", "工作单位": "上海高桥捷派克石化工程建设有限公司", "工种或工作头衔": "维修钳工", "领域": "高端装备", "行业": "高端装备", "工匠介绍": "杨震，上海高桥捷派克石化工程建设有限公司维修钳工，是设备修理、技术创新和团队培养领域的杰出代表。他成功修复了多台复杂设备，自制多种专用工具，并通过技术改造为公司节省大量成本。杨震培养了多名优秀技能人才，带领团队荣获“工人先锋号”称号。他以“铁人”般的工作作风和强烈责任感，获得全国五一劳动奖章和全国技术能手等多项荣誉，是新时代工匠精神的典范。"}, {"编号": 20250311005, "年份": 2016, "区局": "徐汇区", "姓名": "徐培成", "年龄": 68, "姓名拼音": "Xu2-Pei2-Cheng2", "性别": "男", "工作单位": "上海市徐汇区牙病防治所", "工种或工作头衔": "医生", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "徐培成，上海市徐汇区牙病防治所所长，主任医师，享受国务院特殊津贴专家。他是中华口腔医学会多个专业委员会常委或委员，主编多部医学专著，并发表科研论文20余篇。他荣获上海医学科技三等奖、上海市科技进步三等奖等多项奖项，主编的科普著作和科教片广受好评。作为医院管理者，他将全院纳入ISO管理，并筹建高水平口腔专科医院。他先后获得上海市十大工人发明家、上海市劳动模范、全国五一劳动奖章、全国劳动模范等荣誉称号，2008年任北京奥运火炬手。徐培成在医学专业、学科建设和医院管理方面均取得了卓越成就。"}, {"编号": 20250311006, "年份": 2016, "区局": "徐汇区", "姓名": "王海斌", "年龄": 53, "姓名拼音": "Wang2-Hai3-Bin1", "性别": "男", "工作单位": "上海徐房房屋维急修中心", "工种或工作头衔": "水电", "领域": "居民服务", "行业": "物业", "工匠介绍": "王海斌，现任上海徐房房屋维急修中心党支部书记、主任，并兼任徐汇区劳模协会会长。作为资深工匠，他从基层水电维修工做起，成长为行业领军人才，并入选上海首批房管行业领军人才培养计划。他带领团队承担徐汇区3040万平方米居住物业的应急维修任务，2010年被授予\"全国劳动模范\"称号。他依托\"王海斌劳模创新工作室\"，研究房屋水电设备疑难杂症，总结\"判、听、看、探、定\"五步工作法，荣获\"上海市职工先进操作法优秀成果奖\"。他还创新节水型屋顶水箱清洗操作方法，获上海市物业管理行业\"金点子\"创新成果入围奖，并推动\"互联网+\"技术应用，研发\"宅维修\"APP，提升维修效率75%。他培养了1名上海市劳动模范、2名..."}, {"编号": 20250311007, "年份": 2016, "区局": "徐汇区", "姓名": "吴颖健", "年龄": 50, "姓名拼音": "Wu2-Ying3-Jian4", "性别": "男", "工作单位": "万达信息股份有限公司", "工种或工作头衔": "系统集成", "领域": "系统建设", "行业": "信息", "工匠介绍": "吴颖健，教授级高级工程师，工信部高级项目经理，长期专注于城市信息化集成领域。他主持完成了数十个大型信息化系统项目，尤其擅长异构系统集成设计。作为主要设计者，他完成了上海市医保系统项目，首次采用三层架构，实现医疗费用实时结算，覆盖全部参保人群，项目荣获上海市科学技术进步奖一等奖两次。他精通各类软硬件产品应用，在民生信息系统运行保障方面表现突出，多次解决系统疑难问题，确保民生工程稳定运行。吴颖健拥有五项授权发明专利，其中三项应用于上海医保三期工程，成果达国内首创、国际先进水平，获上海科技情报研究所查新检索确认。他担任公司总工程师，培养中高级技术人员数十人，多次获得企业表彰。"}, {"编号": 20250311008, "年份": 2016, "区局": "长宁区", "姓名": "陶巍", "年龄": 70, "姓名拼音": "Tao2-Wei1", "性别": "男", "工作单位": "上海幼狮汽车销售服务有限公司", "工种或工作头衔": "汽车修理师", "领域": "汽修服务", "行业": "汽车", "工匠介绍": "陶巍，长期致力于汽车维修技术理论的研究与应用，积极推广国际化汽车维修理念，开拓现代汽车维修领域的技术创新，倡导汽车运用性文化工程，填补了多项维修技术空白，为改善中国进口汽车维修难题做出了突出贡献。他先后获得\"中外名人、世界优秀人才证书\"，享受国务院特殊津贴、上海市政府特殊津贴，并荣获上海市优秀技师、优秀高级考评员、国家级汽车维修技能大师、上海市汽车维修首席大师、上海市劳模、新长征突击手、技术能手等荣誉称号。2013年被授予全国消费维权楷模称号，2013—2014年度及2015年度均荣获\"最美消费维权人物\"称号。他还作为总统座车的紧急修理值班技师，成功排除了克林顿总统专车故障，修复过日本天..."}, {"编号": 20250311009, "年份": 2016, "区局": "普陀区", "姓名": "刘根敏", "年龄": 56, "姓名拼音": "Liu2-Gen1-Min3", "性别": "男", "工作单位": "上海英雄金笔厂", "工种或工作头衔": "技工", "领域": "金笔制作", "行业": "工艺美术", "工匠介绍": "刘根敏,作为模具工艺领域的技术骨干,凭借勤学苦练和踏实工作,掌握了设备维修、模具调试与修理等核心技能,并总结出独特的工作方法。他所在的部门负责钢笔笔尖的第一道工序,其造型及质量直接影响整个钢笔笔尖的品质。在厂部和车间领导的支持下,他对部分设备零部件进行了优化改进,使操作更加便捷,有效提升了产品品质和生产效率。&#10;&#10;在加工高精度笔尖时,误差要求严格控制在几丝之内,尤其是金笔尖的加工难度更大。1997年,在香港回归纪念金笔尖的生产过程中,他遇到了商标打制偏差的问题。经过反复改进,他设计出多功能模板,成功将商标打制误差降至最低。&#10;&#10;在香港回归金笔尖试制阶段,笔尖腰..."}, {"编号": 20250311010, "年份": 2016, "区局": "普陀区", "姓名": "黄卫国", "年龄": 66, "姓名拼音": "Huang2-Wei4-Guo2", "性别": "男", "工作单位": "普陀区房屋维修应急中心", "工种或工作头衔": "水电工", "领域": "居民服务", "行业": "物业", "工匠介绍": "黄卫国，市劳动模范，资深水电工。从业三十余年，秉持\"把平凡的事做好就不平凡\"的理念，在水电维修领域深耕细作。他通过结对拜师学艺活动，将丰富实践经验传授给年轻员工，发挥劳模示范引领作用。在工作中，他善于解决实际问题，展现精湛技术。例如，他用其他材料制作销子成功修复老式虹吸水箱，解决装修施工遗留问题，保障业主利益。他定期组织技术培训，培养技能过硬的维修队伍，传承徐虎精神，为企业培养大批技术骨干。黄卫国以实际行动诠释劳模责任，用精湛技术和无私奉献赢得广泛认可。"}, {"编号": 20250311011, "年份": 2016, "区局": "杨浦区", "姓名": "施泽凇", "年龄": 53, "姓名拼音": "Shi1-Ze2-Song1", "性别": "男", "工作单位": "上海尤埃建筑设计有限公司", "工种或工作头衔": "建筑设计师", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "施泽凇，国家一级注册建筑师，高级建筑师，拥有20余年从业经历，参与并负责多个复杂、大体量建筑项目的设计与管理。作为核心成员，他参与设计的上海翡丽云邸项目获\"上海绿色建筑贡献（项目）奖\"，虹桥世界中心项目获中国地产设计大奖优秀奖，绿地黄埔滨江项目获国际房地产高层商办建筑项目奖项。施泽凇以卓越的设计理念、创新思维和专业实践在建筑领域享有盛誉。"}, {"编号": 20250311012, "年份": 2016, "区局": "黄浦区", "姓名": "陆亚明", "年龄": 57, "姓名拼音": "Lu4-Ya4-Ming2", "性别": "男", "工作单位": "上海豫园旅游商城股份有限公司绿波廊酒楼", "工种或工作头衔": "中式面点", "领域": "餐饮", "行业": "餐饮", "工匠介绍": "陆亚明，扎根中式面点技艺三十余年，探索出\"融汇贯通、创新面团、馅要多味、营养健康、形要活脱\"的核心理念。他改良传统寿桃制作工艺，创新象形模具，使点心造型更加生动。同时，开发出麻辣、菜肉等新口味蟹粉小笼，并研制二十款创新点心。为传承技艺，他在绿波廊创立\"陆亚明国宴点心工作室\"，培养出多名技术骨干。2014年亚信峰会期间，他指导弟子设计制作的\"事事如意\"点心宴获好评。多年来，陆亚明与团队圆满完成了多项重要接待任务，为推广中华美食文化做出突出贡献。"}, {"编号": 20250311013, "年份": 2016, "区局": "黄浦区", "姓名": "沈国兴", "年龄": 57, "姓名拼音": "Shen3-Guo2-Xing1", "性别": "男", "工作单位": "上海老凤祥有限公司", "工种或工作头衔": "金银细工传承人", "领域": "文化", "行业": "工艺美术", "工匠介绍": "沈国兴，百年老字号企业老凤祥的高级技师，中国非物质文化遗产\"金银细工\"制作技艺的第六代传承人。他以深厚功力、创新才能和中坚作用，成为传统工艺的杰出代表。沈国兴设计制作了众多顶尖工艺精品，包括12公斤的观音金佛像、《静安寺法僧三宝印》、《八仙神葫》等，其中《八仙神葫》获\"天工艺苑百花杯\"金奖。他修复了多件国家二级文物珍宝，并培养了五位制作高手，为传统技艺的传承和发展作出了重要贡献。"}, {"编号": 20250311014, "年份": 2016, "区局": "黄浦区", "姓名": "陈林兴", "年龄": 67, "姓名拼音": "Chen2-Lin2-Xing1", "性别": "男", "工作单位": "上海新人民摄影有限公司", "工种或工作头衔": "摄影", "领域": "文化", "行业": "工艺美术", "工匠介绍": "陈林兴，人像整修师。在工作中勤恳敬业、一丝不苟，凭借对专业的热爱与执着追求，多次在行业技术比武中荣获第一名，并于1995年考评为国家级高级技师。他在长期实践中秉持专业、精湛的服务理念，成功修复了多张具有重要历史意义的老照片，其中最具代表性的是为毛主席随身摄影师钱嗣杰老先生修复的历史旧照，这些照片被录入《毛主席回忆录》出版。他还修复了浦东王阿姨珍藏的一张严重损坏的全家福，此事经媒体报道后广受关注。2015年，其传统人像修片工艺被上视纪实频道《上海100》纪实片拍摄并多次播放。他还通过言传身教培养了大批优秀徒弟和学生，为摄影、人像修片行业输送了大量人才。"}, {"编号": 20250311015, "年份": 2016, "区局": "黄浦区", "姓名": "陆耔豪", "年龄": 46, "姓名拼音": "Lu4-Zi3-Hao2", "性别": "男", "工作单位": "上海正章实业有限公司（个人自荐）", "工种或工作头衔": "洗衣师", "领域": "文化", "行业": "洗涤", "工匠介绍": "陆籽豪, 上海正章实业有限公司高级技术主管、织补绝技传承人。他1999年加入老字号企业正章, 坚持传承织补这一濒临失传的传统技艺, 并将其发展为精细化标准工艺, 在约一平方厘米的破洞上可织补120-180根经纬丝, 修复的衣物、文物、地毯及古字画在业内享有盛名。2012年, 他在正章淮海路总店成立首席技师工作室, 从事面料织补和皮革无痕修复新工艺研发, 并编写《织补技法》作为行业培训教材。陆籽豪曾荣获2011年全国银奖、2012年\"上海商业优质服务先进个人\"、2014年\"上海商业技术能手\"、2015年全国金奖及\"全国技术能手\"称号, 为传统技艺的传承与发展做出了突出贡献。"}, {"编号": 20250311016, "年份": 2016, "区局": "静安区", "姓名": "吴德昇", "年龄": 63, "姓名拼音": "Wu2-De2-Sheng1", "性别": "男", "工作单位": "上海现代钟表珠宝商会吴德昇工作室", "工种或工作头衔": "玉石雕刻", "领域": "文化", "行业": "工艺美术", "工匠介绍": "吴德昇，中国工艺美术大师、中国玉石雕刻大师。从事玉雕四十余年，融合中西雕塑技法，专长立体雕，尤以玉雕人体艺术见长。作品屡获“天工奖”“百花奖”等国内外顶级奖项。积极参与中外文化交流，主持《首届中国玉文化世界巡展》等国际展览，助推中国传统文化“走出去”。同时注重传承，培养多名国家级玉雕人才，为行业发展作出重要贡献。"}, {"编号": 20250311017, "年份": 2016, "区局": "静安区", "姓名": "肖文浩", "年龄": 68, "姓名拼音": "Xiao4-Wen2-Hao4", "性别": "男", "工作单位": "上海亨生西服有限公司", "工种或工作头衔": "服装裁剪制作", "领域": "文化", "行业": "纺织服装", "工匠介绍": "肖文浩，国家级非物质文化遗产项目奉帮裁缝技艺代表性传承人，上海市非物质文化遗产项目亨生奉帮裁缝技艺代表性传承人，上海市商业系统技术能手。他一生致力于奉帮裁缝技艺的传承与创新，师从著名设计师林瑞祥，精通\"四功\"技艺，主持设计的中西合璧男式披肩为行业典范。近年来，肖文浩积极投身非遗传承人才培养，担任特聘教师并参与纪录片拍摄，为培养新一代非遗传承人作出重要贡献。"}, {"编号": 20250311018, "年份": 2016, "区局": "宝山区", "姓名": "朱臻原", "年龄": 55, "姓名拼音": "Zhu1-Zhen1-Yuan2", "性别": "男", "工作单位": "上海二十冶建设有限公司", "工种或工作头衔": "电气调试", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "朱臻原，长期从事电气调试工作，参与了宝钢制氧工程、硅钢轧机机组、益昌薄板厂酸洗线等多个重大项目的建设。他在工作中展现出了卓越的专业技能和创新能力，通过技术革新大幅提升工作效率。在解决电动机绕线模具设计、电焊机修复工艺优化等技术难题中表现突出，获破格提拔为班长并晋级。作为制氧工程试车副总指挥，他成功指挥从单体试车到产品产出的全过程，展现了出色的组织协调能力。在硅钢工程和益昌薄板酸洗线项目中，他攻克多项技术难关，获得日方和甲方的高度评价。凭借对新技术的持续探索和大胆创新，他在电气调试领域成为技术能手，为企业赢得多项荣誉。"}, {"编号": 20250311019, "年份": 2016, "区局": "闵行区", "姓名": "胡振球", "年龄": 40, "姓名拼音": "Hu2-Zhen4-Qiu2", "性别": "男", "工作单位": "上海神舟汽车节能环保股份有限公司", "工种或工作头衔": "电焊工", "领域": "绿色低碳", "行业": "汽车", "工匠介绍": "胡振球，长期从事机械设计加工及钣金工等工作，专业能力突出，技术成果丰硕。他取得高级技师职称，并多次荣获上海市农民工先进个人、闵行区工人发明家、全国劳动模范等称号。胡振球在技术革新方面表现卓越，完成技术革新50余项，获得发明专利14项，其中\"吸尘车整车预装工装\"改进使装配工期缩短至1天，整车装配合格率达98%以上，每年为企业节约成本560多万元。他研发的纯吸式道路吸尘车大幅提升了清洁效率，首创的\"卸料抑尘装置技术\"和\"吸尘车树叶粉碎技术\"解决二次扬尘及树叶处理难题。其创新成果在环保、节能及资源循环利用方面取得显著社会效益。胡振球同志屡获殊荣，包括第七届国际发明展览会\"金奖\"、闵行区五一劳动..."}, {"编号": 20250311020, "年份": 2016, "区局": "闵行区", "姓名": "曹荣", "年龄": 44, "姓名拼音": "Cao2-Rong2", "性别": "男", "工作单位": "上海民族乐器一厂有限公司", "工种或工作头衔": "拉弦乐器制作工", "领域": "文化", "行业": "乐器", "工匠介绍": "曹荣，作为国家高级二胡制作师和共产党员，秉持严谨态度，钻研乐器制作，创新工艺技术，推动行业发展。他成功改良二胡音色，年创效益200余万元，开发多款高端产品，获市场认可。2015年，他带领团队完成巨型\"革胡\"制作并参展国际乐器展。2014年，曹荣荣获上海市技术能手称号，2016年入选上海市杰出技术能手候选人，为民族器乐文化传承作出重要贡献。"}, {"编号": 20250311021, "年份": 2016, "区局": "嘉定区", "姓名": "王梅", "年龄": 43, "姓名拼音": "Wang2-Mei2", "性别": "女", "工作单位": "上海连成(集团)有限公司", "工种或工作头衔": "技术", "领域": "高端装备", "行业": "高端装备", "工匠介绍": "王梅，现任上海连成（集团）有限公司设计中心水泵项目经理，是公司水泵设计领域的技术骨干。她带领团队成功开发高效双吸泵，水泵效率提升5-10%，助力国家\"节能减排\"战略。尽管文化程度不高，她凭借勤奋好学，申报实用新型专利13项，培养10多名技术人才，创造经济效益1400万元。她主持完成了山西夹马口等多个大型泵站设计，创新开发SLOW系列中开泵。近年来，她带领团队开发多型中开泵，助力公司在双吸泵市场占据较高份额。"}, {"编号": 20250311022, "年份": 2016, "区局": "金山区", "姓名": "李林根", "年龄": 67, "姓名拼音": "Li3-Lin2-Gen1", "性别": "男", "工作单位": "金山区枫泾镇中国农民画丹青1号", "工种或工作头衔": "技工", "领域": "文化", "行业": "工艺美术", "工匠介绍": "李林根，中国农民画村书画装裱、修补古字画专业技师，被称为\"古画手术师\"。40余年来，他专注精研和传承1700年历史的书画装裱艺术及古字画修复技艺，成功修复了董其昌书法、徐悲鸿《奔马图》、朱屹瞻《苍鹰图》等众多名家艺术作品。他修复技术精湛，曾将几乎破碎的光绪年间画作修复如新，展现了高超的技艺。作为上海顶级古字画修复师之一，他以执着和敬畏之心守护并传承着这项古老技艺。"}, {"编号": 20250311023, "年份": 2016, "区局": "金山区", "姓名": "蔡蕴敏", "年龄": 55, "姓名拼音": "Cai4-Yun4-Min3", "性别": "女", "工作单位": "复旦大学附属金山医院", "工种或工作头衔": "护理", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "蔡蕴敏，在伤口造口治疗领域总结出独特的\"望-闻-评-判-断\"五步法工艺专长，并构建全院伤口造口护理网络，提升压疮和疑难伤口护理水平，获同行专家认可。她累计培训实习生及进修人员300余名，为40余家医院提供继续教育授课。牵头研发《家庭压疮护理手册》，创新压疮家庭管理模式，获患者高度评价。积极推动专科化护理服务体系建设，推动区域伤口护理资源整合。与多家社区卫生服务中心及福利机构建立结对共建关系，构建三级医院与基层医疗机构协同发展的护理服务机制。其团队创新实践显著提升金山医院伤口护理专业品牌效应及社会影响力，为全国专科化护理服务体系建设提供有益借鉴。"}, {"编号": 20250311024, "年份": 2016, "区局": "金山区", "姓名": "程美华", "年龄": 70, "姓名拼音": "Cheng2-Mei3-Hua2", "性别": "女", "工作单位": "上海市金山丝毯厂", "工种或工作头衔": "丝毯工艺美术师", "领域": "文化", "行业": "工艺美术", "工匠介绍": "程美华，中国传统手工艺丝毯传承与发展者，42年致力于将传统技艺推向新高度。她创新性地将金山农民画移植为艺术挂毯，研发新工艺片剪技术，突破了丝毯平面模式，创造出软雕塑效果，并开创性地使用北方榨蚕丝提升作品质感。其作品曾在美国国家艺术中心、联合国儿童基金会、上海世博会联合国馆等重要机构展出收藏。程美华荣获全国劳动模范、中国工艺美术大师等称号，为传统丝毯工艺走向世界搭建了桥梁。"}, {"编号": 20250311025, "年份": 2016, "区局": "松江区", "姓名": "翁永平", "年龄": 60, "姓名拼音": "Weng1-Yong3-Ping2", "性别": "男", "工作单位": "上海耀江实业有限公司", "工种或工作头衔": "技术", "领域": "绿色低碳", "行业": "环保", "工匠介绍": "翁永平，作为上海耀江实业有限公司技术中心主任，带领团队取得1项发明专利和36项实用新型专利，多个项目获区级及以上奖项。他主导研发的\"风光互补太阳能路灯\"获松江区科技成果三等奖，\"电动中空百叶玻璃\"项目列入上海市建筑建材遮阳推广技术目录，\"光电幕墙\"等获松江区创新资金支持。参与制定的\"门窗生产规范流程\"和\"隔热涂膜玻璃操作技术规范\"列为上海市地方标准。\"电动中空百叶\"项目获上海市建筑建材行业技术革新奖。他推动企业转型，成为松江区首家专业光伏电站建设企业，为多家单位和个人提供光伏发电系统服务。其所带领团队被设为松江区名师带徒工作点。"}, {"编号": 20250311026, "年份": 2016, "区局": "青浦区", "姓名": "李西岳", "年龄": 59, "姓名拼音": "Li3-Xi1-Yue4", "性别": "男", "工作单位": "上海浦宇铜艺装饰制品有限公司", "工种或工作头衔": "铸造", "领域": "文化", "行业": "工艺美术", "工匠介绍": "李西岳，高级铸造工程师、工艺美术师、环境艺术师，兼任西安工业大学教授。他是中国雕塑家协会等多家协会委员及副会长，获青浦区拔尖人才称号。其作品涵盖大型城市雕塑、铜艺术品及铜装饰，曾参与近百个国家重点工程设计。代表作包括沧州铁狮、上海世博会“生命之树”等，其中沧州铁狮被吉尼斯世界纪录认定为一次性整体浇铸最大铁狮子，并获多项金奖。其作品《第二自然》被中国工业博物馆收藏。他还担任多家机构的艺术总监及总工艺师，在铜装饰工程领域亦有卓越贡献，参与设计人民大会堂、洛阳隋唐遗址公园等多个重要项目。李西岳已申请专利57项，授权47项，涉及铸造工艺创新，达到国内领先水平。"}, {"编号": 20250311027, "年份": 2016, "区局": "青浦区", "姓名": "王本洪", "年龄": 49, "姓名拼音": "Wang2-Ben3-Hong2", "性别": "男", "工作单位": "上海正伟印刷有限公司（个人自荐）", "工种或工作头衔": "包装印刷-柔印版印刷", "领域": "文化", "行业": "高端装备", "工匠介绍": "王本洪，国内仅有的6名柔性版印刷技师之一，曾获上海市印刷行业职业技能竞赛二等奖、上海市印刷技术能手等多项荣誉，并于2012-2013年度被评为上海市优秀农民工。他作为正伟公司环保柔性版印刷的开创者，主导了多项关键技术的研发，为公司带来了显著的经济价值。王本洪在印刷领域屡获佳绩，发表了12篇权威论文并荣获全国征文大赛二等奖，同时拥有10项专利。他通过创新技术，实现了环保与成本的双重优化，2012至2013年间节省油墨成本近100万元。其主导的创新材料及防伪印刷技术，创造了总计270万、900万、1100万的经济价值。"}, {"编号": 20250311028, "年份": 2016, "区局": "奉贤区", "姓名": "顾德先", "年龄": 64, "姓名拼音": "Gu4-De2-Xian1", "性别": "男", "工作单位": "上海真静古典家具有限公司", "工种或工作头衔": "木工、研发", "领域": "文化", "行业": "工艺美术", "工匠介绍": "顾德先，是一位技艺精湛的传统木工艺术家，专注于明式家具制作和传统榫卯结构工艺的传承。上世纪70年代初，他拜师学习木工技艺，后寻得一位名师深造，掌握了明清家具制作中的关键技艺。他曾在上海从事中国传统古典家具的复原、传承及重制工作二十多年，现为上海木研社专业技术人员。他制作的明式经典家具作品在上海嘉泰拍卖行、上海展览中心等专业场所展出并被收藏，获得业内专家高度评价。顾德先致力于恢复我国经典明式家具传统工艺，为传承这一宝贵的文化遗产贡献自己的力量。"}, {"编号": 20250311029, "年份": 2016, "区局": "奉贤区", "姓名": "王红梅", "年龄": 53, "姓名拼音": "Wang2-Hong2-Mei2", "性别": "女", "工作单位": "上海玖开电线电缆有限公司", "工种或工作头衔": "技术", "领域": "新能源", "行业": "电力", "工匠介绍": "王红梅，作为上海玖开电线电缆有限公司的质量管控负责人，她在电线电缆行业深耕近二十年，从基层员工逐步成长为技术设计研发领域的专家。在质量管理、新产品研发及成果转化方面成绩显著。&#10;&#10;她主持完成了多项技术改进，其中包括同轴电缆屏蔽效果优化，获得实用新型专利（证书号：ZL201120324940.8），并被认定为高新技术成果转化项目（证书号：201402127），当年实现销售收入增长30%，新增利润约100万元。&#10;&#10;此外，她带领团队进行了新能源光伏电缆的技术改进，使生产成本降低20%，节约资金约110万元。同时，主持完成了电梯用同轴电缆的技术开发，成功将使用寿命从..."}, {"编号": 20250311030, "年份": 2016, "区局": "崇明区", "姓名": "黄成超", "年龄": 64, "姓名拼音": "Huang2-Cheng2-Chao1", "性别": "男", "工作单位": "上海崇明花菜研发中心", "工种或工作头衔": "高级农艺师", "领域": "花菜栽培", "行业": "农业", "工匠介绍": "黄成超，长期从事花菜种子研发工作，成功研发花菜杂交制种技术并实现外来品种本土化培育，有效满足崇明地区花菜种植需求。他主持完成多项科研项目，选育出\"崇花\"系列杂交新品种并填补崇明花菜杂交良种空白，创新研发群体授粉机械去雄技术并申请国家发明专利。黄成超积极推广新技术，解决菜农种植难题并提升防效，推动\"崇花\"系列品种在多地广泛应用。在他的努力下，中兴镇花菜种植面积达2.5万亩，并荣获\"中国花菜之乡\"等称号。曾获农业部丰收二等奖两项、上海市科技进步三等奖、国务院特殊津贴，被评为市农业科技创新带头人、\"最美崇明人\"等。"}, {"编号": 20250311031, "年份": 2016, "区局": "机电", "姓名": "李斌", "年龄": 65, "姓名拼音": "Li3-Bin1", "性别": "男", "工作单位": "上海电气液压气动有限公司", "工种或工作头衔": "高级机械技师", "领域": "高端装备", "行业": "机电", "工匠介绍": "李斌系上海电气液压气动有限公司液压泵厂数控工段高级技师、高级工程师。作为共产党员，他从技校生成长为专家型技术工人，主持完成\"高压轴向柱塞泵/马达国产化关键技术\"攻关项目，获19项发明专利和21项实用新型专利，荣获\"2009年度中国机械工业科学技术一等奖\"、国家科技进步二等奖等多项荣誉。其研发产品广泛应用并替代进口，创经济效益超2亿元，为军工产品提供技术支撑。作为全国工班长，他培养优秀职工队伍，带领班组获\"全国工人先锋号\"等多项称号，培养出三位上海市劳动模范，以精湛技艺和高尚师德诠释工匠精神。"}, {"编号": 20250311032, "年份": 2016, "区局": "机电", "姓名": "俞建民", "年龄": 68, "姓名拼音": "Yu2-Jian4-Min2", "性别": "男", "工作单位": "上海三菱电梯有限公司", "工种或工作头衔": "电梯安装调试工", "领域": "高端装备", "行业": "机电", "工匠介绍": "俞建民，上海三菱电梯有限公司安装人员，从事电梯安装工作42年。他主持或参与完成了上海中心、金茂大厦等多地超高层建筑与重点工程的电梯安装工作。在电梯安装领域不断钻研，创新多项超高速电梯及大跨度扶梯安装工艺，主持编制国内首个超高层建筑电梯无脚手架安装工艺，解决技术难题并填补领域空白。作为公司安装部重大项目主管，带领团队攻克技术难关，提升项目推进效率。2014年被评为首席技师并成立工作室，同年获\"上海市工人先锋号\"称号，2016年获上海市五一劳动奖章。"}, {"编号": 20250311033, "年份": 2016, "区局": "仪表电子", "姓名": "朱健儿", "年龄": 64, "姓名拼音": "Zhu1-Jian4-Er2", "性别": "男", "工作单位": "上海美多通信设备有限公司", "工种或工作头衔": "仪表通信", "领域": "空间信息", "行业": "仪表电子", "工匠介绍": "朱健儿，是上海美多通信设备有限公司军品车间的首席高级技师，拥有三十六年无线通信设备调试修理经验。他发明的\"控制单元检测操作法\"入选\"上海仪电创新活动素质工程工作集锦\"，并参与第19期高技能人才研修班学习。他主导解决了缅甸铁路超高频无线三级转发链接难题，开创该国铁路通信史 precedent。在海军装备建设中，他研发激励源单元突破舰船接收机阻塞瓶颈，使设备抗干扰性能达国际领先水平。他参与的XXXX设备填补海军通信技术空白，获国防科技进步一等奖。朱健儿编撰《调频无线电话机讲义》等教材，培养5名技师和15名高级工，获\"青年良师益友\"称号。"}, {"编号": 20250311034, "年份": 2016, "区局": "轻工", "姓名": "楼宇峰", "年龄": 65, "姓名拼音": "Lou2-Yu3-Feng1", "性别": "男", "工作单位": "上海造币有限公司", "工种或工作头衔": "模具手工雕刻", "领域": "货币", "行业": "工艺美术", "工匠介绍": "楼宇峰，现任上海造币有限公司设计制模部模具手工雕刻技师、上海市非物质文化遗产代表性项目代表性传承人。他长期从事钱币、纪念章模具手工雕刻工作，在《北京奥运会1盎司银币模具研制》项目中获二等奖，在《化学法制作硬币精细图纹模具工艺研究》项目中获银行科技发展三等奖，在《RFID技术在造币上的应用研究》项目中获银行科技发展二等奖。他培养了三名徒弟，其中一名成为技师，另一名成为高级工，第五代传人王峻松也被评为非遗传承人。他还多次参与非遗宣传活动，2015年作为代表参加了上海东方卫视纪录片《上海工匠》的录制。"}, {"编号": 20250311035, "年份": 2016, "区局": "轻工", "姓名": "刘忠荣", "年龄": 67, "姓名拼音": "Liu2-Zhong1-Rong2", "性别": "男", "工作单位": "上海忠荣玉典艺术品工作室", "工种或工作头衔": "玉石雕刻", "领域": "文化", "行业": "工艺美术", "工匠介绍": "刘忠荣，中国玉石雕刻大师、中国工艺美术大师，是上海市非物质文化遗产项目\"海派玉雕\"的代表性传承人，同时也是上海市领军人才。他师从多位玉雕名家，创作的\"翡翠百佛炉\"\"青玉兽面壶\"等作品被评定为国家文物等级珍品，\"黑白玉调色器\"获中国工艺美术首届百花奖银奖。他先后获得\"上海十大青年技术精英\"\"上海市劳动模范\"\"优秀共产党员\"等荣誉称号。1987年被破格提升为高级技师，并受到时任国务院总理李鹏的接见。在创办上海忠荣玉典艺术品工作室后，他设立首席技师工作室，培养了一批优秀玉雕人才，并开创性地为所有原创作品登记著作权，申请专利，其中\"六面围雕\"技术获得发明专利。他以身作则，在企业中担任大师原创工作..."}, {"编号": 20250311036, "年份": 2016, "区局": "纺织", "姓名": "龚杜弟", "年龄": 59, "姓名拼音": "Gong1-Du4-Di4", "性别": "男", "工作单位": "上海汽车地毯总厂有限公司", "工种或工作头衔": "高级技术", "领域": "文化", "行业": "纺织服装", "工匠介绍": "龚杜弟，上海汽车地毯总厂有限公司总工程师、教授级高工，全国五一劳动奖章获得者、上海市劳动模范。他主持研发的轿车行李箱地毯聚氨酯喷涂设备流水线填补国内空白，SFS填充成型隔音垫生产线设计为公司节约数千万元引进费用。带领团队成功开发宝马5系脚垫，创新多项工艺，获五项国家发明专利和两项实用新型专利，并获2016年上海市优秀发明奖金奖。其宝马轿车衣帽架全球首创侧向双弧冲切封边结构垄断产品技术，获德国专家好评。"}, {"编号": 20250311037, "年份": 2016, "区局": "医药", "姓名": "张雄毅", "年龄": 62, "姓名拼音": "Zhang1-Xiong2-Yi4", "性别": "男", "工作单位": "上海雷允上药业有限公司", "工种或工作头衔": "制丸", "领域": "生物医药", "行业": "医药卫生", "工匠介绍": "张雄毅，系雷允上药业集团有限公司资深药师，中药泛丸高级技师，并为上海市非物质文化遗产项目六神丸制作技艺代表性传承人，曾荣获第七届上海市技术能手称号。精通六神丸传统手工制作技艺，该工艺系国家保密配方，以手工泛丸为核心。张雄毅通过数十年潜心钻研，掌握全套制作技艺，其微丸制作达行业领先水平，误差率控制在1%以内。作为传承人，他通过\"师带徒\"方式培养青年员工，培养出多名技术骨干，并在行业竞赛中屡获佳绩。"}, {"编号": 20250311038, "年份": 2016, "区局": "电力工业", "姓名": "杨庆华", "年龄": 65, "姓名拼音": "Yang2-Qing4-Hua2", "性别": "男", "工作单位": "国网上海市电力公司检修公司", "工种或工作头衔": "输电线路", "领域": "高端装备", "行业": "电力", "工匠介绍": "杨庆华，国网上海市电力公司检修公司输电运检中心专业工程师、高级技师，享受国务院政府特殊津贴。他长期从事输电线路工作，带领团队出色完成了抗冰抢险、奥运保电、世博工程等重大工程，在400天内完成400基铁塔改造，攻克多项交直流特高压带电作业难题。他设计的高空防坠落装置等创新设备获国家专利并广泛应用。由他领衔的\"输电技术创新工作室\"攻克多项技术难关，累计创造经济效益超10亿元。该工作室于2014年被授予\"全国示范性劳模创新工作室\"称号。"}, {"编号": 20250311039, "年份": 2016, "区局": "电力工业", "姓名": "钱忠", "年龄": 56, "姓名拼音": "Qian2-Zhong1", "性别": "男", "工作单位": "国网上海嘉定供电公司", "工种或工作头衔": "配电线路", "领域": "高端装备", "行业": "电力", "工匠介绍": "钱忠，国网上海市电力公司带电作业班首批员工之一，1986年参加工作。他与团队自主研发多项工具和工艺，推动带电作业发展，使带电作业化率达74.6%。带领团队完成10余项科技项目，获33项国家专利，在核心期刊发表11篇专业论文。2014年成立劳模创新工作室，年均完成带电作业1467次，多供电量794.5万千瓦时，创造经济效益约2929.44万元，供电可靠性提升0.17%。他坚守一线30年，秉持\"不停电就是对客户最好的服务\"理念，为电力事业发展做出重要贡献。"}, {"编号": 20250311040, "年份": 2016, "区局": "电力建设", "姓名": "张新军", "年龄": 53, "姓名拼音": "Zhang1-Xin1-Jun1", "性别": "男", "工作单位": "上海电力安装第二工程公司", "工种或工作头衔": "锅炉受热面安装", "领域": "高端装备", "行业": "电力", "工匠介绍": "张新军，锅炉施工专家。他创新研发了螺旋式水冷壁安装标高控制技术、锅炉受热面大件吊装策划等关键技术，解决了多种锅炉类型安装难题。在上海外高桥三期、神头\"上大压小\"等项目中，他攻克多项技术难关，大幅提高施工效率。他发明的\"鳍片切割机\"专利显著降低了施工成本，并在万州项目中优化锅炉管排设备方案，为机组节约成本百万元。张新军还致力于技术传承，在上海电建成立\"张新军创新工作室\"，培养青年梯队。他先后获得上海电力建设有限公司劳模先进示范基地锅炉本体安装专家等多项荣誉，用实践诠释了大国工匠的责任与担当。"}, {"编号": 20250311041, "年份": 2016, "区局": "宝武", "姓名": "孔利明", "年龄": 73, "姓名拼音": "Kong3-Li4-Ming2", "性别": "男", "工作单位": "原上海宝山钢铁股份有限公司", "工种或工作头衔": "高级技师", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "孔利明，自幼受\"人有艺走天下\"家训影响，立志成为技艺精湛的手艺人。他精通木匠、焊接、电工、电子等多种技能，并将所学应用于实践，解决了诸多农机难题。进入宝钢后，他确立了\"当好工人同样受人尊重\"的职业信念，系统学习机械构造、电子电气、计算机等专业知识，并不断创新。他成功研发了《倒车请注意》《汽车电路短路定位检测仪》等多项实用技术，其中《废钢卸船防坠增效工艺》突破技术瓶颈，实现作业安全率100％、效率提升45％。近十年来，他带领团队完成《铁矿石带式运输金属物检测和去除技术系统》项目，获中港科技进步一、二、三等奖，上海市科技进步二等奖及巴黎国际金奖。作为宝钢技能专家和全国示范型劳模工作室负责人，..."}, {"编号": 20250311042, "年份": 2016, "区局": "宝武", "姓名": "王康健", "年龄": 69, "姓名拼音": "Wang2-Kang1-Jian4", "性别": "男", "工作单位": "宝钢股份冷轧厂", "工种或工作头衔": "冷轧技能专家", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "王康健，是我国轧钢领域的高级技师与技能专家，宝钢第一代主操作工。他从宝钢冷轧一期建设起，参与了各期发展，成长为分厂副厂长并担任多家机构要职。他享有国务院特殊津贴，曾获全国\"五一\"劳动奖章、中华技能大奖等多项荣誉。扎根一线40余年，他解决设备疑难杂症350余项，改进操作工艺150余项，主导科研项目25项，拥有121项专利，并多次获得国家科技进步奖等重要奖项。以他命名的技能大师工作室在推动创新方面发挥了重要作用，培养了多名优秀人才，为宝钢冷轧领域达到行业领先地位作出重要贡献。"}, {"编号": 20250311043, "年份": 2016, "区局": "宝武", "姓名": "王军", "年龄": 59, "姓名拼音": "Wang2-Jun1", "性别": "男", "工作单位": "宝钢股份冷轧厂", "工种或工作头衔": "钳工高级技师", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "王军，宝钢技能专家，享受国务院特殊津贴，兼任宝钢人才开发院兼职教授、上海市劳模讲师团成员等职。荣获国家科技进步二等奖、上海市科技进步二等奖等多项荣誉，拥有国家专利及申请208项、PCT国际专利申请12项。主持国家级技能大师工作室工作，在高强度全密封精整矫直机支承辊技术、高成材率节能环保热轧层流冷却成套装备技术等领域取得突破。带领团队实现创新效益14亿元，所在热轧车间连续十二年位居宝钢创新排行榜榜首。"}, {"编号": 20250311044, "年份": 2016, "区局": "宝冶集团", "姓名": "毛琪钦", "年龄": 49, "姓名拼音": "Mao2-Qi2-Qin1", "性别": "男", "工作单位": "上海宝冶工程技术有限公司", "工种或工作头衔": "电焊", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "毛琪钦，全国技术能手、第九届\"上海市工人创新技术能手\"，在焊接领域屡创佳绩。他先后在全国冶金建设行业第六届焊工技术比赛和全国工程建设系统第七届焊工技术比赛中获个人总分第一名，并入选《上海技师的高招绝活》。毛琪钦不仅掌握多种焊接技术，还获得焊工职业培训师资格和国际焊接技师资质，并取得上海交通大学材料科学与工程专业本科学历。他主持了多项科研项目，培养的学员在全国比赛中屡获佳绩。2011年，作为第41届世界技能大赛焊接项目中国技术指导专家，他指导的选手裴先锋获银奖。"}, {"编号": 20250311045, "年份": 2016, "区局": "石化股份", "姓名": "陆定良", "年龄": 56, "姓名拼音": "Lu4-Ding4-Liang2", "性别": "男", "工作单位": "上海石油化工股份有限公司", "工种或工作头衔": "新材料研发", "领域": "先进材料", "行业": "石化", "工匠介绍": "陆定良，作为与上海石化共同成长的技术工人，扎根生产一线，以\"勇猛精进，志愿无偿\"的工匠精神在平凡岗位上书写不凡人生。从普通操作工成长为高级技师、主任技师，他带领陆定良技师工作室解决多套装置技术难题，主持完成数十项技术改进项目，培养出多名优秀徒弟。他主编的M800E产品生产优化操作法被评为上海石化2013年度优秀先进操作法，徒弟中多人获得中石化集团技能比武铜奖和上海石化\"技术能手\"称号。"}, {"编号": 20250311046, "年份": 2016, "区局": "航天局", "姓名": "王曙群", "年龄": 54, "姓名拼音": "Wang2-Shu3-Qun2", "性别": "男", "工作单位": "上海航天设备制造总厂有限公司", "工种或工作头衔": "设备总装", "领域": "空间信息", "行业": "航天", "工匠介绍": "王曙群，上海航天设备制造总厂特级技师，航天八院首席技师，是我国航天领域对接机构装配的领军人才。他参与了神舟八号与天宫一号对接机构的装调工作，实现了我国\"太空之吻\"技术突破，推动我国成为世界上第二个掌握此技术的国家。王曙群曾获\"上海市技术能手\"、航天科技集团\"航天技能大奖\"、\"中国载人航天突出贡献者\"等多项荣誉，并于2015年入选\"上海工匠\"。他带领团队完成了月球车、锥杆式对接机构等高技术项目，培养了大量航天高技能人才，为我国航天事业发展作出了重要贡献。"}, {"编号": 20250311047, "年份": 2016, "区局": "航天局", "姓名": "苗俭", "年龄": 48, "姓名拼音": "Miao2-Jian3", "性别": "女", "工作单位": "上海航天控制技术研究所", "工种或工作头衔": "数控", "领域": "空间信息", "行业": "航天", "工匠介绍": "苗俭，上海航天控制技术研究所精密加工中心双工种高级技师，中共党员。从事数控加工中心编程及操作工作21年，参与运载火箭、战术武器和飞船等关键零部件研制生产。作为航天首席技师和苗俭国家级技能大师工作室负责人，她攻克多项技术难关，成功完成本科专业学习。&#10;&#10;苗俭获得多项荣誉：2007年事迹被央视《劳动者之歌》报道，2009年作为全国青年职工代表在纪念五四运动90周年大会上发言。她精通多种CAD/CAM软件，创新编程手段，为航天事业培养大量青年技能人才，在各类竞赛中屡获佳绩。苗俭是航天系统高技能人才杰出代表，展现了刻苦学习、创新进取、拼搏奉献和爱岗敬业的精神。"}, {"编号": 20250311048, "年份": 2016, "区局": "船舶", "姓名": "张翼飞", "年龄": 68, "姓名拼音": "Zhang1-Yi4-Fei1", "性别": "男", "工作单位": "沪东中华造船（集团）有限公司", "工种或工作头衔": "船舶电焊", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "张翼飞，沪东中华造船（集团）有限公司首席技师、集团公司首席技师，全国技术能手称号获得者，\"张翼飞劳模创新工作室\"创始人。他培养了5名全国技术能手和4名省部级劳动模范，带领团队攻克多项焊接技术难题，成功研发双相不锈钢焊接工艺、单电源双丝自动埋弧焊等多项关键技术。他主持制定了泵塔氩弧焊/CO2混合焊工艺标准，推动了焊接机器人的应用。张翼飞还主编了《船厂焊工操作手册》并发表了多篇专业论文，其中两项成果获上海市专利发明。他获得\"中华技能大奖\"\"全国五一劳动奖章\"等多项荣誉，为船舶工业发展作出了突出贡献。"}, {"编号": 20250311049, "年份": 2016, "区局": "船舶", "姓名": "陈志农", "年龄": 67, "姓名拼音": "Chen2-Zhi4-Nong2", "性别": "男", "工作单位": "江南造船（集团）有限责任公司", "工种或工作头衔": "船舶钳工", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "陈志农，是江南造船集团总装部的一名船舶钳工高级技师，从事船舶轮机安装及设备调试工作已有38年。他荣获了中国船舶公司劳动模范、上海市劳动模范、全国技术能手、上海市首席技师、上海市十大工人发明家等多项荣誉称号。近十年来，他以\"努力奉献，不断创新\"为座右铭，在创新和发明方面取得了显著成就，先后获得10项国家专利，填补了多项国内技术空白，并撰写了多篇中国海军科技报告。2012年，以他名字命名的国家级技能大师工作室正式成立，为培养更多优秀技术人才做出了贡献。"}, {"编号": 20250311050, "年份": 2016, "区局": "船舶", "姓名": "秦毅", "年龄": 45, "姓名拼音": "Qin2-Yi4", "性别": "男", "工作单位": "沪东中华造船（集团）有限公司", "工种或工作头衔": "电焊工", "领域": "船舶建造", "行业": "船舶", "工匠介绍": "秦毅，系沪东中华造船公司首席技师，被誉为中国LNG船殷瓦焊接G证第一人。他累计培养合格殷瓦焊工360余名，其中多人获评全国技术能手、高级技师等称号。秦毅先后发表专业论文多篇，主编《LNG船焊接实用手册》，获国家发明专利2项、实用新型专利1项，发明的扭动施焊法使LNG船液货舱焊接实现零漏点。他积极参与焊接设备国产化研制，为公司节省费用200多万元。秦毅曾获全国技术能手、中央企业劳动模范等称号，并享受国务院政府特殊津贴。"}, {"编号": 20250311051, "年份": 2016, "区局": "汽车", "姓名": "徐小平", "年龄": 64, "姓名拼音": "Xu2-Xiao3-Ping2", "性别": "男", "工作单位": "上汽集团大众汽车有限公司", "工种或工作头衔": "高级工程师", "领域": "汽车", "行业": "汽车", "工匠介绍": "徐小平，现任上汽大众汽车有限公司发动机厂维修部门高级经理、党支部书记，是杰出的产业工人代表。他荣获“上海市劳动模范”、“上海市十大工人发明家”、“全国五一劳动奖章”、“中国机械工业技能大师”等称号，并连续三届获得“全国劳动模范”称号，同时是“全国创先争优优秀共产党员”。徐小平以其勤奋好学、善于思考、敬业钻研和勇于创新的精神，带领团队突破技术垄断，推动设备精细化自主维修，创造数以亿计的经济效益，并为企业贡献十几项发明专利。作为新时代产业工人的杰出代表，他在平凡岗位上创造了不凡业绩，为企业发展和社会进步作出重要贡献。"}, {"编号": 20250311052, "年份": 2016, "区局": "汽车", "姓名": "张生春", "年龄": 56, "姓名拼音": "Zhang1-Sheng1-Chun1", "性别": "男", "工作单位": "上海赛科利汽车模具技术应用有限公司", "工种或工作头衔": "工具钳工", "领域": "汽车", "行业": "汽车", "工匠介绍": "张生春，上海赛科利汽车模具技术应用有限公司工具钳工，模具制造领域的杰出代表。他以精湛的技术和严谨的态度，在模具调试与创新方面屡创佳绩。2012年，带领团队仅用4个月完成上汽通用昂科拉侧围项目模具交付，荣获“精模奖”，并总结出“张氏蹭光法”，显著提升模具表面质量。他注重团队建设，培养大批骨干力量，并成立“张生春首席技师工作室”，制作45个基础操作视频教程，推动新员工标准化培训。张生春攻克多项技术难题，其调试方法纳入企业经验数据库，大幅提升模具制造速度和质量。他以精益求精的态度，推动企业不断进步，诠释了专业、专注和创新的匠心精神。"}, {"编号": 20250311053, "年份": 2016, "区局": "汽车", "姓名": "任建新", "年龄": 53, "姓名拼音": "Ren4-Jian4-Xin1", "性别": "男", "工作单位": "上海柴油机股份有限公司", "工种或工作头衔": "铣工", "领域": "汽车", "行业": "汽车", "工匠介绍": "任建新，作为资深技术专家，自1987年起投身工作，师从全国劳模陈祖权后，技术水平显著提升，成长为高级技师。他累计完成25项技术攻关和创新，其中11项获国家专利，创造1200多万元经济效益。2011年入选上海市首批\"首席技师\"，2014年荣获\"上海市技能大师\"称号。他精通车、铣、刨、磨、数控设备操作，擅长工装刀具设计与制造工艺制定，在进口刀具国产化、工装优化等领域成果显著。齿形组合拉刀研制尤其突出，解决了±0.007mm公差难题，获上海市优秀发明选拔赛金奖。他推广技术成果，总结三项先进操作方法，论文荣获机械工业高技能人才优秀论文二等奖。培养3名徒弟晋升技师、2名晋升高级技师，任上海市技师协..."}, {"编号": 20250311054, "年份": 2016, "区局": "铁路局", "姓名": "张华", "年龄": 47, "姓名拼音": "Zhang1-Hua2", "性别": "男", "工作单位": "中国铁路上海局集团有限公司上海动车段", "工种或工作头衔": "动车组机械师", "领域": "轨道交通", "行业": "铁路", "工匠介绍": "张华，中共党员，高级技师，现任上海动车段电气调试班工长，兼任段诊断工程师、局兼职教师及动车技术-劳模工作室领衔人。他长期致力于动车组高级修电气调试工作，年均处理重难点电气故障百余起。通过优化2型动车组电气调试项目作业顺序，将调试时间缩短30%以上，显著提升产能并降低能耗。他还主编完成《CRH2型动车组故障排查处理指南》，参与开发动车组高压系统实训间，并积极响应节能降耗号召，组织实施修旧利废工作。&#10;&#10;在技能竞赛中，张华在上海铁路局动车组机械师、“四方杯”动车组诊断工程师及全国铁路动车组机械师职业技能竞赛中均获个人第一名。他参与的《CRH2型动车组三级修调试作业优化》QC项目..."}, {"编号": 20250311055, "年份": 2016, "区局": "港务", "姓名": "张彦", "年龄": 41, "姓名拼音": "Zhang1-Yan4", "性别": "男", "工作单位": "上港集团盛东国际集装箱码头有限公司", "工种或工作头衔": "电动装卸机械司机", "领域": "交通运输", "行业": "港务", "工匠介绍": "张彦，作为一名共产党员和集装箱桥吊操作者，凭借精湛技术和团队协作，七次刷新桥吊单机和船时量作业效率的世界纪录。他创造的每小时196.64自然箱的单机效率至今未被超越。张彦带领团队攻克12项技术难题，其中“新型桥吊节能操作方法”每年为公司节省128万元能源消耗。他总结经验形成“张彦操作法”，并培养了150余名优秀司机。作为上海市劳模创新工作室带头人，张彦在“双吊具边卸边装”新工艺推广中做出重要贡献，提升效率49.25%，显著减少资源投入。他荣获上海市劳动模范、全国五一劳动奖章等多项荣誉，为洋山深水港建设做出突出贡献。"}, {"编号": 20250311056, "年份": 2016, "区局": "移动通信", "姓名": "水湧", "年龄": 54, "姓名拼音": "Shui3-Yong3", "性别": "男", "工作单位": "中国移动通信集团上海有限公司", "工种或工作头衔": "线务员", "领域": "空间信息", "行业": "通信", "工匠介绍": "水湧，现任上海移动网维中心线路维护部工程抢修班班长，2015年被评为全国劳动模范。自2002年入职以来，他始终秉持预警维护理念，带领团队为上海移动一级干线光缆实现连续1000余天无阻断作出重要贡献。他建立光缆安全隐患预警机制，创新总结出\"三快、三慢；两多两少；一心一意\"的工作法，并在维护条线推广。在他的带领下，部门故障抢修及时率稳定在95%以上。水湧不仅个人技术过硬，还注重班组建设，每年修订完善规章制度，培养出一支技术精湛、作风过硬的抢修队伍。"}, {"编号": 20250311057, "年份": 2016, "区局": "电信", "姓名": "徐珺", "年龄": 46, "姓名拼音": "Xu2-Jun4", "性别": "男", "工作单位": "中国电信股份有限公司上海西区电信局", "工种或工作头衔": "光纤布线工程师", "领域": "空间信息", "行业": "通信", "工匠介绍": "徐珺,作为中国电信上海公司西区电信局客户终端服务工程师,是全国劳动模范、上海市十大工人发明家、上海市杰出技术能手。他专注于通信末梢线路接入技术,发明暗管入户四小工具,推广暗线入户操作法,使上海公司暗线穿通率显著提升。他还研究隐形光缆布放改进工艺,成为该光缆国家标准起草人之一,已获得4项专利。他参与装维师资培养,近5年培训达三万人次。作为全国劳模创新工作室负责人,培养了4名骨干技师。他创建\"线务员之家\"网站,助力通信线务技术发展。此外,他帮助培养世界技能大赛中国选手,助力中国选手在国际舞台上取得佳绩。"}, {"编号": 20250311058, "年份": 2016, "区局": "上海海事", "姓名": "吴志华", "年龄": 58, "姓名拼音": "Wu2-Zhi4-Hua2", "性别": "男", "工作单位": "东海航海保障中心上海航标处", "工种或工作头衔": "无线电航标", "领域": "安全保障", "行业": "海事", "工匠介绍": "吴志华，东海航海保障中心上海航标处高级工程师，从事航标设备维修和创新攻关近30年。他研发《航标维护四步法》，完成20多个项目研究，实现30余项技术转化，为国家节约资金超千万。其中“防盗航标灯”项目成功解决偏远海域航标难题。他参与上海世博会、广州亚运会航标设置等20余项重大工程，荣获首批上海国际航运中心建设十大先进个人称号。他建立“吴志华劳模工作室”，培养了一批技能型人才。"}, {"编号": 20250311059, "年份": 2016, "区局": "建设交通", "姓名": "李增红", "年龄": 52, "姓名拼音": "Li3-Zeng1-Hong2", "性别": "男", "工作单位": "中铁上海工程局集团市政工程有限公司", "工种或工作头衔": "电工", "领域": "高端装备", "行业": "建设交通", "工匠介绍": "李增红，作为集团公司最年轻的高级技师，凭借卓越的专业能力和丰富的实践经验，带领\"李增红技能大师工作室\"攻克多项技术难题，推动了国内顶管施工技术的智能化发展。他成功研发\"升压-输电-降压-用电\"供电方案，创新电缆设计，并自主研发测量装置和自动注浆系统，显著提升施工效率。截至目前，李增红参与完成15项技术改进项目，获得4项国家级发明专利和7项国家实用性专利，为企业创造超过3000万元经济效益。2015年，他作为中铁上海局重点学习对象，在劳模表彰会上作专题报告，掀起全公司\"向李增红同志学习\"热潮。"}, {"编号": 20250311060, "年份": 2016, "区局": "建设交通", "姓名": "石长江", "年龄": 52, "姓名拼音": "Shi2-Chang2-Jiang1", "性别": "男", "工作单位": "中铁二十四局集团有限公司", "工种或工作头衔": "钢筋工", "领域": "轨道交通", "行业": "建设交通", "工匠介绍": "石长江，作为一位资深钢筋工，从业26年来始终致力于技术创新与实践探索。他主持并参与了多项铁路施工项目，包括\"中取华东\"等大会战，均获高度评价。2005年，他被聘为\"钢筋工技师\"，2007年荣获中央企业职工技能大赛钢筋工决赛金奖，同年获得\"全国技术能手\"称号。2008年，他被授予福建省劳动模范称号，2012年获得国务院政府特殊津贴专家称号。同时，他积极承担\"导师带徒\"工作，培养多名技术骨干，为企业发展做出重要贡献。"}, {"编号": 20250311061, "年份": 2016, "区局": "建工", "姓名": "陆凯忠", "年龄": 52, "姓名拼音": "Lu4-Kai3-Zhong1", "性别": "男", "工作单位": "上海市基础工程集团有限公司", "工种或工作头衔": "电工", "领域": "土地混合利用", "行业": "建工", "工匠介绍": "陆凯忠，上海市基础工程集团有限公司高级技师，陆凯忠工作室负责人。他长期投身轨道交通建设，参与上海多条地铁线路及外省市重点工程，主持完成多项科研课题并取得专利。凭借突出贡献，他荣获全国劳动模范、全国\"五一\"劳动奖章、全国优秀技术能手、上海市工人发明家等多项荣誉称号。"}, {"编号": 20250311062, "年份": 2016, "区局": "建工", "姓名": "王斌", "年龄": 49, "姓名拼音": "Wang2-Bin1", "性别": "男", "工作单位": "上海市机械施工集团有限公司", "工种或工作头衔": "工程测量", "领域": "土地混合利用", "行业": "建工", "工匠介绍": "王斌，工程测量领域的杰出代表，参与了近20条地铁线路及100多公里隧道的施工测量，误差控制在10mm以内，测量精度达\"毫米级\"。他拥有6项专利，获得国家测绘局技术金奖、上海市职工先进操作法等多项荣誉，出版2部国家培训教材，并被授予\"上海市十大工人发明家\"\"上海市劳模\"称号，当选上海市第十四届人大代表。&#10;&#10;王斌创新研发矩形盾构自动测量系统，提升地下空间开发技术；参与迪士尼工程测量，将埋件定位精度提升至±2mm；参与上海中心大厦测量方案探讨，贡献重要技术参考。他成立\"王斌工程测量技术创新工作室\"，培养30余名测量工匠，获\"上海市劳模创新工作室\"等称号，完成多项重大工程测量任务..."}, {"编号": 20250311063, "年份": 2016, "区局": "建工", "姓名": "李杰", "年龄": 39, "姓名拼音": "Li3-Jie2", "性别": "男", "工作单位": "上海市机械施工集团有限公司", "工种或工作头衔": "塔吊司机", "领域": "土地混合利用", "行业": "建工", "工匠介绍": "李杰，作为超高层建筑起重塔吊操作机长，参与了包括上海环球金融大厦、上海中心大厦等在内的多个顶级地标工程项目。他掌握了STL380型、M900D型、M1280D型等多种塔吊操作技术，曾操作起重量达2450吨米的进口M1280D型塔吊，成功完成塔吊从地面到650米高空的顶升操作。他首创使用高空悬挂重型设备施工方法，掌握构件重量、尺寸和起吊方式的精确判断能力，练就云雾天气精准定位技能，能将吊钩与作业点偏差控制在1米以内。在上海中心大厦建设中，完成高难度高空爬升、移位和解体拆卸作业，荣获‘上海中心大厦工程建设立功竞赛先进个人’称号。"}, {"编号": 20250311064, "年份": 2016, "区局": "中建八局", "姓名": "黄德彪", "年龄": 56, "姓名拼音": "Huang2-De2-Biao1", "性别": "男", "工作单位": "中建八局上海矗鑫建筑工程有限公司", "工种或工作头衔": "钢筋工", "领域": "土地混合利用", "行业": "建筑", "工匠介绍": "黄德彪，中建八局耀华地区16-1地块公共租赁住房项目普通工人。他26年前离川来沪，从普通农民工成长为优秀务工者。工作中，他虚心好学，追求施工零误差，多次获用人单位褒奖。2015年起，他担任上海矗鑫建筑工程有限公司耀华16-1项目工会主席及中建八局耀华路项目工会联合会副主席，积极维护工友权益，通过多种途径倾听一线工友诉求，为工友提供全面工会服务。他秉持\"为员工办实事\"的理念，努力保障工友基本权益，深受工友爱戴。"}, {"编号": 20250311065, "年份": 2016, "区局": "科技", "姓名": "陈忠明", "年龄": 56, "姓名拼音": "Chen2-Zhong1-Ming2", "性别": "男", "工作单位": "中国科学院上海硅酸盐研究所", "工种或工作头衔": "材料研究", "领域": "碳化物陶瓷", "行业": "科技", "工匠介绍": "陈忠明，正高级工程师，长期从事先进碳化物陶瓷材料研究。他从普通技术员成长为课题组主要负责人，在碳化物陶瓷成型和烧结技术领域有深厚造诣。参与多个国家级科研项目，在解决关键技术难题中发挥重要作用。带领团队研制成功国际最大1.5米常压烧结碳化硅光学部件，完成天宫、嫦娥等14个型号碳化硅光学部件研制任务，产品实现成功在轨运行。累计科研经费数亿元，显著提升我国高分辨对地观测技术水平，确立上海硅酸盐研究所在空间遥感技术领域的领先地位。"}, {"编号": 20250311066, "年份": 2016, "区局": "科技", "姓名": "陈勤泉", "年龄": 57, "姓名拼音": "Chen2-Qin2-Quan2", "性别": "男", "工作单位": "上海光机所恒益公司", "工种或工作头衔": "光学刻、磨工", "领域": "光学粗磨", "行业": "科技", "工匠介绍": "陈勤泉，自1999年入职以来一直从事光学粗磨工作，2009年被抽调至环抛加工组，参与了神光Ⅱ升级、神光Ⅲ原型及主机钕玻璃加工等重大科研项目。他在大口径平面光学元件环抛精加工方面具有丰富经验，擅长控制2.4/2.8m环抛机的面形和疵病，为环抛交叉修复工艺的成熟及精加工效率提升作出了重要贡献。他在面形控制和疵病控制方面创新运用抛光盘面形的交叉组合，使钕玻璃单面疵病合格率提高30%。2009年至2013年，他完成神光Ⅱ升级装置及神光Ⅲ原型钕玻璃加工任务的70%，并带领环抛组将产能提升至50片/月，加工量占神光Ⅲ项目已供货总量的60%以上。他还积极参与\"高师带徒\"活动，培养青年人才。2013年度..."}, {"编号": 20250311067, "年份": 2016, "区局": "医务", "姓名": "许迅", "年龄": 65, "姓名拼音": "Xu3-Xun4", "性别": "男", "工作单位": "上海市第一人民医院", "工种或工作头衔": "医务人员", "领域": "卫生", "行业": "医药卫生", "工匠介绍": "许迅教授是国内眼科领域的杰出代表，长期致力于糖尿病视网膜病变等重大致盲性眼病的研究与防治工作。他主持国家十二五科技重大专项等十余项国家级课题，在国内外权威期刊发表SCI论文87篇。许迅教授曾荣获2007年、2013年上海市科技进步一等奖，2008年国家科技进步二等奖以及2011年华夏医学科技一等奖等多项重要奖项。他带领团队在代谢记忆机制、新干预靶点等方面取得重要突破，建立了中国首个眼科临床研究评价中心，并推动眼科新药研发，为领域发展作出了重要贡献。许迅教授在学术界享有崇高声誉，参编多部眼科学专著，并担任国际权威期刊编委。"}, {"编号": 20250311068, "年份": 2016, "区局": "文广影视局", "姓名": "马如高", "年龄": 60, "姓名拼音": "Ma3-Ru2-Gao1", "性别": "男", "工作单位": "上海博物馆（个人自荐）", "工种或工作头衔": "漆木器文物修复", "领域": "文化", "行业": "文物", "工匠介绍": "马如高，我国著名文物修复专家，擅长漆木器修复。自1994年加入上海博物馆以来，他主持修复馆藏文物300余件，并为广东博物馆、上海历史博物馆等机构修复文物100余件。其中最具代表性的成果是对一件\"紫檀雕莲叶龙纹宝座\"的抢救性修复，该文物由200余块散件重组，修复完成后被 experts鉴定为同类宝座中孤品，具有极高研究价值，市场估价7千万元。他始终致力于文化遗产保护，强调文物修复不仅是技艺传承，更是文化内涵的呈现。"}, {"编号": 20250311069, "年份": 2016, "区局": "经济信息化", "姓名": "蒋跃年", "年龄": 67, "姓名拼音": "Jiang3-Yue4-Nian2", "性别": "男", "工作单位": "上海长江企业发展合作公司", "工种或工作头衔": "篆刻", "领域": "文化", "行业": "经信", "工匠介绍": "蒋跃年，高级工艺美术师，现任上海长江企业发展合作公司集云阁首席工艺美术师，师承沈受觉、刘友石及杨明华先生。他以深厚书法造诣为基础，擅长正、草、隶、篆等多种书体，尤其以秦小篆书法闻名，风格刚柔并济、严整端庄。蒋跃年作品屡获全国行业金银奖，并受邀为国内外领导人定制国礼篆刻作品。作为《印章艺术雕刻》非遗项目第三代传承人，他积极开展传承工作，培养后继人才。"}, {"编号": 20250311070, "年份": 2016, "区局": "民政", "姓名": "王刚", "年龄": 48, "姓名拼音": "Wang2-Gang1", "性别": "男", "工作单位": "上海市龙华殡仪馆", "工种或工作头衔": "遗体整容师", "领域": "社会工作", "行业": "殡葬", "工匠介绍": "王刚，现任上海市龙华殡仪馆业务科副科长、高级遗体整容技师，致力于遗体整容化妆工作二十余年。他成功创建全国首个专业遗体修复工作室——民政部劳模王刚工作室，运用三维立体激光扫描等先进技术，推动行业发展。2016年，他参与3D打印技术遗体修复攻关项目，修复相似度达95%以上。王刚同志多次代表上海参与重大社会突发事件处理，展现了上海遗体修复技术的先进水平，获家属高度认可。"}, {"编号": 20250311071, "年份": 2016, "区局": "锦江国际", "姓名": "郭予文", "年龄": 61, "姓名拼音": "Guo1-Yu3-Wen2", "性别": "男", "工作单位": "上海锦江饭店", "工种或工作头衔": "厨师", "领域": "餐饮", "行业": "餐饮", "工匠介绍": "郭予文，锦江饭店资深厨师，从事餐饮工作30余年，擅长食品雕刻。他荣获“全国金奖”，并被命名为“上海市职工岗位绝技绝招”。上海市总工会以他的名字设立了首批劳模创新工作室。他曾参与多次重要宴请和中外首脑接待工作，其作品深受客人喜爱。1993年，他在第三届全国烹饪大赛中获食品雕刻个人金牌；2001年，在APEC峰会接待工作中表现出色，获得集团表彰；2010年，上海世博会期间，他设计制作了带有世博会标志的西瓜花，获组委会高度评价。此外，他还在第九届上海国际烹饪艺术比赛中荣获金牌，作品多次被各国首脑收藏。"}, {"编号": 20250311072, "年份": 2016, "区局": "锦江国际", "姓名": "严惠琴", "年龄": 70, "姓名拼音": "Yan2-Hui4-Qin2", "性别": "女", "工作单位": "上海新锦江大酒店", "工种或工作头衔": "中式烹饪", "领域": "餐饮", "行业": "餐饮", "工匠介绍": "严惠琴，中国烹饪大师、中国名厨专业委员会副主席、上海烹饪协会副会长等职，被誉为海派国宴菜的创造者和领军人物。师承中国烹饪界一代宗师萧良初先生，并得到多位名师亲授。她潜心钻研四十余年，精通广菜、潮菜、川菜等菜系，并将海派菜与西方时尚完美融合。曾参与接待500余次国宾宴请，服务300多位国家元首和政府首脑，并多次担任国内外重大活动主厨。严惠琴著有《浅析潮州菜的\"味\"》等专业论著，并提出\"中菜西做、西菜中做、粗菜精做、野菜细做\"原则，为中华餐饮文化发展做出重要贡献。她曾获全国劳动模范、全国\"五一\"劳动奖章、国务院特殊津贴、中国十大名厨等荣誉称号。"}, {"编号": 20250311073, "年份": 2016, "区局": "东湖", "姓名": "孙志湧", "年龄": 62, "姓名拼音": "Sun1-Zhi4-Yong3", "性别": "男", "工作单位": "上海东郊宾馆", "工种或工作头衔": "厨师", "领域": "文化", "行业": "餐饮", "工匠介绍": "孙志湧，上海东郊宾馆行政总厨，全国五一劳动奖获得者、上海市劳动模范、中国烹饪大师。他擅长将民间菜提升为国宴佳肴，让中华美食走向世界舞台。在外交场合，他用精湛厨艺展现中国文化，获得多国领导人的高度评价。世博会期间，他制作的国宴受到朱镕基等领导人的赞扬，亚信峰会期间更是在26分钟内完成60人国宴，获习主席和普京称赞。他积极推动美食平民化，举办江鲜美食节等系列 culinary活动，让百姓品尝国宴名品。同时，他带教武警士兵食堂，提升其服务水平。"}, {"编号": 20250311074, "年份": 2016, "区局": "百联集团", "姓名": "蓝金康", "年龄": 70, "姓名拼音": "Lan2-Jin1-Kang1", "性别": "男", "工作单位": "上海三联（集团）有限公司茂昌眼镜公司", "工种或工作头衔": "验光师", "领域": "文化", "行业": "商业", "工匠介绍": "蓝金康，国家级高级验光技师，任\"茂昌眼镜公司\"验光技师三十余年。他研发的\"多焦镜验光三点位法\"使渐进多焦点验配成功率接近100%，获上海市科技进步三等奖；与团队发明的\"去毛复新\"技术获国家发明专利。2005年带领团队开发新型耐磨树脂镜片膜层，耐磨性能优于部分国际品牌；2006年主持研发新型内渐进多焦镜镜片。擅长复杂病例验光，获眼科专家认可。2013年，上海市总工会在其所在公司设立\"蓝金康验配眼镜技术创新工作室\"，用于技术研究与产品创新。"}, {"编号": 20250311075, "年份": 2016, "区局": "申通集团", "姓名": "李鹃伟", "年龄": 64, "姓名拼音": "Li3-Juan1-Wei3", "性别": "男", "工作单位": "上海地铁维护保障有限公司车辆分公司", "工种或工作头衔": "城轨电动列车检修工", "领域": "轨道交通", "行业": "交通", "工匠介绍": "李鹃伟，现任上海地铁维护保障有限公司车辆分公司钳工、高级技师、大修厂制动班组长，是全国技能大师工作室带头人。他秉持\"干一行、爱一行\"的精神，在列车制动系统研究领域不断创新突破，为企业创造显著效益。李鹃伟先后获得上海市劳动模范称号、国务院津贴等多项荣誉，其工作室被评为全国技能大师工作室。他主导的两项先进操作法和八项技术专利累计为企业节约维修成本2248万元，其中\"多车型空气弹簧试验设备操作法\"被评为上海市先进操作法。李鹃伟始终活跃在车辆检修一线，致力于提升列车行驶安全性和平稳性，展现了新时代工匠的使命担当。"}, {"编号": 20250311076, "年份": 2016, "区局": "申通集团", "姓名": "严如珏", "年龄": 54, "姓名拼音": "Yan2-Ru2-Jue2", "性别": "女", "工作单位": "上海地铁第一运营有限公司", "工种或工作头衔": "维修电工", "领域": "轨道交通", "行业": "交通", "工匠介绍": "严如珏同志，现任上海地铁第一运营有限公司设施部技术主管，长期致力于车站综合监控系统设备的技术管理及创新工作。她主持完成多项技术革新和科研项目，其中《一种综合后备盘授权保护器》等3项成果获国家专利，技术革新课题《上海轨道交通1号线车站机电设备的智能节能控制研究》等成果显著，获集团嘉奖及上海市工程建设优秀QC成果一等奖等多项荣誉。参与编写《上海轨道交通新线运营设施设备接管验收规范》等技术规程，主编城市轨道交通专业培训教材，培养高技能人才8名，为轨道交通智能化发展作出突出贡献。"}, {"编号": 20250311077, "年份": 2016, "区局": "城投集团", "姓名": "宣建岚", "年龄": 65, "姓名拼音": "Xuan1-Jian4-Lan2", "性别": "男", "工作单位": "上海城投污水处理有限公司石洞口污水处理厂", "工种或工作头衔": "污泥处理工", "领域": "土地混合利用", "行业": "环保", "工匠介绍": "宣建岚，现任石洞口污水处理厂污泥干化焚烧车间主任，上海城投（集团）有限公司首席技师。他领衔的工作室荣获“上海市技能大师工作室”等多项称号。作为污泥干化焚烧技术专家，他完成了50多项设备及零配件国产化工作，将装置运行时间提升50%，并填补了我国污泥处理工种教材和相关技术标准的空白。他带领团队完成技术革新30多项，创造经济效益2967万元，获国家专利10项，培养出技师和高级工16名，为行业发展输送了专业人才。"}, {"编号": 20250311078, "年份": 2016, "区局": "城投集团", "姓名": "魏顶峰", "年龄": 48, "姓名拼音": "Wei4-Ding3-Feng1", "性别": "男", "工作单位": "上海辰山植物园", "工种或工作头衔": "绿化工", "领域": "植物引种", "行业": "环保", "工匠介绍": "魏顶峰，自加入上海辰山植物园以来，以饱满的工作热情和忘我的奉献精神投身于植物引种和栽培养护管理工作中，解决了一系列专业技术难题。在华东植物引种工作中，他通过深入分析上海地区气候和土壤特点，成功将引种栽培成活率从23%提升至90%以上，引种栽培植物达4800种，并摸索出一套成熟的温室大型植物移栽关键技术。在多肉植物研究方面，他通过叶插、根插、横切和竖切繁殖技术，成功繁育了一批濒危物种，并在嫁接实验和环境控制领域取得突破。他还带领团队成功栽培成活十几株仙人掌科巨人柱，成活率达到95%以上，为植物引种保育和创新栽培奠定了坚实基础。魏顶峰共培育出12种多肉植物变异品种和6种适合温室栽培的花灌木，..."}, {"编号": 20250311079, "年份": 2016, "区局": "隧道股份", "姓名": "李建伟", "年龄": 68, "姓名拼音": "Li3-Jian4-Wei3", "性别": "男", "工作单位": "上海隧道工程有限公司机械制造分公司", "工种或工作头衔": "钳工", "领域": "土地混合利用", "行业": "隧道", "工匠介绍": "李建伟，现任上海隧道机械制造分公司总装车间主任、高级技师，长期从事地下隧道施工设备研发工作。在40余年职业生涯中，他参与了上海、南京、宁波、武汉等50多个重大工程及新加坡、印度、香港等海外项目建设，带领团队首创以盾构系统为单元的国产盾构生产线生产方法，研发出超大直径盾构驱动内圆立车设备。他参与制造的产品获国家级重点新产品、中国工业博览会金奖、上海市科技进步一等奖等多项荣誉，个人获评上海首席技师、“上海隧道工匠”等称号。他还成立“隧道股份工匠李建伟工作室”，培养出高级技师8名、高级工32名，为企业输送大批高技能人才。"}, {"编号": 20250311080, "年份": 2016, "区局": "隧道股份", "姓名": "张亮", "年龄": 62, "姓名拼音": "Zhang1-Liang4", "性别": "男", "工作单位": "上海隧道工程有限公司盾构分公司", "工种或工作头衔": "管涵顶进工", "领域": "土地混合利用", "行业": "隧道", "工匠介绍": "张亮，现任上海隧道工程有限公司盾构工程分公司副经理，是我国盾构隧道施工领域的顶尖技术专家。他参与了上海地铁一号线、M8线工程、新加坡地铁703标等多项重大工程，在技术攻关方面取得了卓越成就。作为\"技术领先\"战略的主要践行者，他设计出了\"隧道管片吊具\"，创新了\"水中进洞\"和\"沼气插管释放\"工法，解决了承压水和沼气两大世界级施工难题。他的止水钢板设计现已成为上海地铁施工的标准要求，在M8线工程中更是为企业节省了860万元的拔桩费用。凭借这些突出贡献，张亮荣获了\"上海市杰出技术能手\"、\"学习型技术工人\"、\"上海市重点工程建设功臣\"和\"全国技术能手\"等多项殊荣。"}, {"编号": 20250311081, "年份": 2016, "区局": "电力股份", "姓名": "严琳", "年龄": 42, "姓名拼音": "Yan2-Lin2", "性别": "女", "工作单位": "上海上电电力运营有限公司", "工种或工作头衔": "化学", "领域": "高端装备", "行业": "电力", "工匠介绍": "严琳，女，是上海电力股份有限公司的高级工程师。她2005年进入杨树浦发电厂工作，凭借优异表现迅速成长为化学运行主值。2009年起，她先后参与上电漕泾发电厂百万千瓦机组建设及调试工作，并在2013年担任化学专工，获业主高度评价。她曾获上海电力股份公司“青年五四奖章”、先进个人等荣誉称号，2012年获“上海市第十二届青年岗位技术能手”称号。&#10;&#10;严琳在专业领域表现出色，在中电投集团第一届燃料采制化竞赛中获得化验个人第一名及团体第三名。2014年，她担任上海电力股份有限公司“采制化技能带头人”，并作为教练带领团队在第二届技能竞赛中取得优异成绩。她还致力于人才培养和技术创新，主持开..."}, {"编号": 20250311082, "年份": 2016, "区局": "商用飞机", "姓名": "胡双钱", "年龄": 64, "姓名拼音": "Hu2-Shuang1-Qian2", "性别": "男", "工作单位": "中国商飞上海飞机制造有限公司", "工种或工作头衔": "飞机钣金工", "领域": "民用航空", "行业": "航空", "工匠介绍": "胡双钱作为中国航空制造领域的大国工匠，凭借\"一次做好、缺陷为零\"的质量理念，在36年的职业生涯中完成了数万件飞机零件的加工，始终保持零失误。他参与了运10飞机的研制并见证了其首飞，现为C919大型客机和ARJ21新支线飞机项目的关键技术攻关成员。胡双钱总结出\"对比检查法\"等质量控制方法，强调青年员工必须严格遵守加工标准，不擅自更改工序。作为\"大国工匠\"劳模创新工作室的领军人，他致力于培养\"一岗多能\"的复合型人才，为中国大飞机事业打造具备创新精神和攻坚能力的团队。其事迹曾被中央电视台\"大国工匠\"栏目报道，堪称中国工匠精神的杰出代表。"}, {"编号": 20250311083, "年份": 2016, "区局": "上影集团", "姓名": "张振晖", "年龄": 50, "姓名拼音": "Zhang1-Zhen4-Hui1", "性别": "男", "工作单位": "上海美术电影制片厂有限公司", "工种或工作头衔": "影视动画创作", "领域": "文化", "行业": "工艺美术", "工匠介绍": "张振晖，二级美术设计师，中国电影家协会动画电影工作委员会会员、上海电影家协会会员、上海电视艺术家协会会员，并在上海美术电影专修学校担任分镜设计教师。自1992年入职上海美术电影制片厂以来，张振晖先后担任动画员、动作总监、原画设计师，现主要负责执行导演、人物造型设计及剧组副导演工作。在其职业生涯中，张振晖参与了多部重要作品的制作，其中包括《犹太女孩在上海第一部》（副导演、人物设计）、修复版《邋遢大王奇遇记》（副导演）以及《犹太女孩在上海第二部项链密码》（副导演、人物设计）。"}, {"编号": 20250311084, "年份": 2016, "区局": "宝玉石协会", "姓名": "洪新华", "年龄": 65, "姓名拼音": "Hong2-Xin1-Hua2", "性别": "男", "工作单位": " 弘艺轩玉器工作室", "工种或工作头衔": "玉石雕刻", "领域": "文化", "行业": "工艺美术", "工匠介绍": "洪新华，海派玉雕大师，从艺四十余年，擅长人物雕刻，作品如“弥勒”“刘海”“罗汉”等成为“海派”玉雕标志。他突破传统程式化手法，注重刻画人物神情姿态，使作品生动传神，深受海内外藏家赞誉。洪新华以“新奇特绝”理念创新传统题材，赋予经典作品时代魅力。他培养的弟子已成为“海派”玉雕新生代重要力量。洪新华以琢玉为乐，致力于传承与发展海派玉雕，为中国玉石文化贡献力量。"}, {"编号": 20250311085, "年份": 2016, "区局": "插花花艺协会", "姓名": "朱道义", "年龄": 53, "姓名拼音": "Zhu1-Dao4-Yi4", "性别": "男", "工作单位": "上海静安园林绿化发展有限公司", "工种或工作头衔": "绿化工", "领域": "文化", "行业": "花艺", "工匠介绍": "朱道义，师承插花花艺大师梁胜芳，深耕插花领域二十余年，擅长将自然与艺术结合，创作主题鲜明的作品。他立足传统，研究插花六大法则与空间布局，融合东西方技法，形成独特风格。他曾参与APEC会议、上海静安区花街设计及北京奥运会礼仪用花创作，荣获两项银奖。近期，他被授予全国五一劳动奖章，以表彰其在插花花艺领域的卓越贡献。"}, {"编号": 20250311086, "年份": 2016, "区局": "电力工程协会", "姓名": "陈国庆", "年龄": 65, "姓名拼音": "Chen2-Guo2-Qing4", "性别": "男", "工作单位": "上海电力高压实业有限公司", "工种或工作头衔": "变电检修", "领域": "高端装备", "行业": "电力", "工匠介绍": "陈国庆，作为从事变电检修30余年的资深电力工人，长期参与上海电网建设的基建、技改及变电站定期检修大修工作。近年来，他参与了20千伏会文站35KVGIS设备损坏事故等多次重大抢修任务，作为专业带头人，凭借高超技术和丰富经验，为设备恢复送电赢得宝贵时间。在高压实业公司承接的老旧变电站改造工程中，他提出\"微创式\"外科手术方案，确保了改造期间上海主电网平稳运行。陈国庆还参与制订了大量变电典型设备安装、检修作业指导书和工艺流程，并主编撰写了《LW6型系列液压操动机构特殊故障处理》等论文和技术文件，已成为行业标准。作为电力公司级兼职培训师，他致力于培养变电专业人才，临近退休仍继续为行业贡献毕生所学。"}, {"编号": 20250311087, "年份": 2016, "区局": "焊接协会", "姓名": "卢长春", "年龄": 54, "姓名拼音": "Lu2-Chang2-Chun1", "性别": "男", "工作单位": "中冶宝钢技术服务有限公司第二分公司（中冶宝钢）", "工种或工作头衔": "焊工", "领域": "高端装备", "行业": "钢铁冶金", "工匠介绍": "卢长春，作为杰出的大国工匠，在焊接领域取得了卓越成就。他多次在全国冶金系统焊工比赛中荣获佳绩，并获得\"全国冶金建设行业高级技能专家\"、\"全国冶金建设行业技术能手\"等称号。他发明的管道带水焊接工艺和氩弧焊焊接铅板技术填补了国内空白，参与国家重点项目建设，攻克多项焊接技术难题，创造显著经济效益。他还培养了众多技术骨干，带领团队在全国性比赛中屡获佳绩。卢长春以其精湛技艺和创新精神，为行业发展做出了重要贡献。"}, {"编号": 20250311088, "年份": 2016, "区局": "装饰装修协会", "姓名": "樊成辉", "年龄": 63, "姓名拼音": "Fan2-Cheng2-Hui1", "性别": "男", "工作单位": "上海住总集团建设发展有限公司（浦东新区）", "工种或工作头衔": "泥工匠", "领域": "土地混合利用", "行业": "装饰装修", "工匠介绍": "樊成辉，现任上海住总集团建设发展有限公司项目施工员，专注近现代保护建筑修缮工作。他凭借泥水匠专业背景，参与了\"圣三一堂\"、中山东一路33号外滩源及新天安堂等重要建筑的修缮工程。在修缮过程中，他创新运用测绘放样技术，精准复原建筑历史风貌，获得业内高度认可。中科院院士郑时龄多次现场指导并对其工作给予肯定。樊成辉在文物保护修缮领域积累了丰富经验，掌握多项专业技术，展现了卓越的专业能力，在业界和社会中享有良好声誉。"}]}
