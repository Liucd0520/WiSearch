CREATE TABLE `HongKouDemo` (
	`案件编号` BIGINT COMMENT '案件的编号xxx', 
	`原编号` BIGINT, 
	`案件来源/信息来源` TEXT; 含义: 表示工单的来源渠道。; 枚举值: "12345热线"
	`工单类型` TEXT; 含义: 表示工单的类型。; 枚举值: "其他类", "咨询类", "意见建议类", "投诉举报类", "求助类"
	`发现时间` TEXT; 含义: 表示工单被发现的时间。; 示例值: "2024-08-31 22:20"
