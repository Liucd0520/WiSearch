CREATE TABLE znrpt_cuv_summary_gd_extend (
	id BIGINT NOT NULL COMMENT '主键ID' AUTO_INCREMENT, 
	section_id VARCHAR(40) COMMENT '业务小结(id)', 
	cuv_customer_name VARCHAR(50) COMMENT '客户名称', 
	cuv_session_id VARCHAR(100) COMMENT '会话ID', 
	cuv_replay_account VARCHAR(50) COMMENT '来电号码', 
	cuv_qes_desc TEXT COMMENT '咨询内容', 
	cuv_deal_scheme VARCHAR(200) COMMENT '处理主题', 
	cuv_channel VARCHAR(20) COMMENT '渠道', 
	cuv_channel_cn VARCHAR(20) COMMENT '渠道中文含义', 
	cuv_customer_id VARCHAR(40) COMMENT '客户ID', 
	cuv_start_time DATETIME NOT NULL COMMENT '来电时间', 
	cuv_biztype1 VARCHAR(200) COMMENT '一级保险类型', 
	cuv_biztype2 VARCHAR(200) COMMENT '二级保险类型', 
	cuv_biztype3 VARCHAR(200) COMMENT '三级保险类型', 
	cuv_biztype4 VARCHAR(200) COMMENT '四级保险类型', 
	cuv_biztype5 VARCHAR(200) COMMENT '五级保险类型', 
	cuv_biztype6 VARCHAR(200) COMMENT '六级保险类型', 
	cuv_biztype7 VARCHAR(200) COMMENT '七级保险类型', 
	cuv_biztype1_cn VARCHAR(1000) COMMENT '一级保险类型中文含义', 
	cuv_biztype2_cn VARCHAR(1000) COMMENT '二级保险类型中文含义', 
	cuv_biztype3_cn VARCHAR(1000) COMMENT '三级保险类型中文含义', 
	cuv_biztype4_cn VARCHAR(1000) COMMENT '四级保险类型中文含义', 
	cuv_biztype5_cn VARCHAR(1000) COMMENT '五级保险类型中文含义', 
	cuv_biztype6_cn VARCHAR(1000) COMMENT '六级保险类型中文含义', 
	cuv_biztype7_cn VARCHAR(1000) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci COMMENT '七级保险类型中文含义', 
	cuv_summary_type VARCHAR(10) COMMENT '小结类型：0社保1医保', 
	cuv_summary_type_cn VARCHAR(100) COMMENT '小结类型中文含义', 
	cuv_call_type VARCHAR(10) COMMENT '来电类型', 
	cuv_call_type_cn VARCHAR(100) COMMENT '来电类型中文含义', 
	cuv_identity VARCHAR(20) COMMENT '人员身份', 
	cuv_identity_cn VARCHAR(100) COMMENT '人员身份中文含义', 
	cuv_customer_type VARCHAR(10) COMMENT '人员分类', 
	cuv_customer_type_cn VARCHAR(100) COMMENT '人员分类中文含义', 
	cuv_district VARCHAR(20) COMMENT '区县信息，徐汇、黄埔、静安、虹口、杨浦、闵行、宝山、嘉定、浦东、南汇、奉贤、松江、金山、青浦、崇明、长宁、医保、鉴定中心、外就办', 
	cuv_district_cn VARCHAR(100) COMMENT '区县信息中文含义', 
	cuv_contact_tel VARCHAR(50) COMMENT '联系方式', 
	cuv_solved VARCHAR(2) COMMENT '是否解决', 
	cuv_solved_cn VARCHAR(100) COMMENT '是否解决中文含义', 
	gd_order_id VARCHAR(16) COMMENT '工单编号', 
	gd_call_id VARCHAR(16) COMMENT '录音流水号', 
	gd_session_id VARCHAR(128) COMMENT '坐席会话id', 
	gd_work_no VARCHAR(10) COMMENT '坐席工号', 
	gd_call_no VARCHAR(50) COMMENT '来电号码', 
	gd_call_time DATETIME COMMENT '来电时间', 
	gd_contact_name VARCHAR(60) COMMENT '联系人姓名', 
	gd_contact_sex VARCHAR(1) COMMENT '联系人性别(0未知,1男,2女)', 
	gd_contact_sex_cn VARCHAR(10) COMMENT '联系人性别中文含义', 
	gd_contact_address VARCHAR(300) COMMENT '联系人地址(投诉、举报人基本情况-联系地址)', 
	gd_order_type VARCHAR(2) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci COMMENT '工单分类：1疑难问题件;2库调整件;3协调件;4交互平台件;5劳动监察件;6政风行风件;7公示反馈件;8社会保险举报投诉件;9意见建议件;10其他件;11信息反馈件;12表扬件;13投诉件;14纠错件;15急件;', 
	gd_order_type_cn VARCHAR(100) COMMENT '工单分类中文含义', 
	gd_order_content TEXT COMMENT '工单内容', 
	gd_create_time DATETIME COMMENT '工单生成时间', 
	gd_order_status VARCHAR(20) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci COMMENT '工单状态：0未提交;1已提交;2已领取;3待监理初审;4待运控部审核;5待质监部审核;6待监理复审;7工单归档;8待组长审核;9待推送;10待咨询科处理;', 
	gd_order_status_cn VARCHAR(100) COMMENT '工单状态中文含义', 
	gd_back_flag VARCHAR(1) COMMENT '退单标志(1:是，0:否)', 
	gd_back_flag_cn VARCHAR(10) COMMENT '退单标志中文含义', 
	gd_order_index VARCHAR(2) COMMENT '工单级别(1:一般,2:急件)', 
	gd_order_index_cn VARCHAR(10) COMMENT '工单级别中文含义', 
	gd_order_source VARCHAR(1) COMMENT '工单来源', 
	gd_order_source_cn VARCHAR(100) COMMENT '工单来源中文含义', 
	gd_wx_order_type VARCHAR(1) COMMENT '自建工单退单标志(1:是，0:否)', 
	gd_wx_order_type_cn VARCHAR(10) COMMENT '自建工单退单标志中文含义', 
	gd_service_level1 VARCHAR(8) COMMENT '业务分类--一级分类', 
	gd_service_level2 VARCHAR(8) COMMENT '业务分类--二级分类', 
	gd_service_level3 VARCHAR(8) COMMENT '业务分类--三级分类', 
	gd_service_level4 VARCHAR(8) COMMENT '业务分类--四级分类', 
	gd_service_level1_cn VARCHAR(200) COMMENT '业务分类--一级分类中文含义', 
	gd_service_level2_cn VARCHAR(200) COMMENT '业务分类--二级分类中文含义', 
	gd_service_level3_cn VARCHAR(200) COMMENT '业务分类--三级分类中文含义', 
	gd_service_level4_cn VARCHAR(200) COMMENT '业务分类--四级分类中文含义', 
	gd_call_type VARCHAR(1) COMMENT '来电类型 1个人 2企业', 
	gd_call_type_cn VARCHAR(10) COMMENT '来电类型中文含义', 
	gd_channel_typeid VARCHAR(4) COMMENT '工单来源(电话、微信、微博、留言、网上信访、回访)', 
	gd_channel_typeid_cn VARCHAR(100) COMMENT '工单来源中文含义', 
	gd_order_class VARCHAR(1) COMMENT '工单类别：1咨询类;2求助类;3举报投诉类;4意见建议类;', 
	gd_order_class_cn VARCHAR(100) COMMENT '工单类别中文含义', 
	extend_call_matter VARCHAR(1) COMMENT '来电原因：1表扬 2投诉 3撤诉', 
	extend_call_matter_cn VARCHAR(50) COMMENT '来电原因中文含义', 
	extend_commend_category VARCHAR(1) COMMENT '表扬类别', 
	extend_commend_category_cn VARCHAR(100) COMMENT '表扬类别中文含义', 
	content TEXT COMMENT '大模型传参content内容，对数据内容进行整合', 
	PRIMARY KEY (id, cuv_start_time)
)PARTITION_DEFINITIONS=PARTITION p_month_197001 VALUES LESS THAN (719528) ENGINE = InnoDB, PARTITION p_month_202404 VALUES LESS THAN (739372) ENGINE = InnoDB, PARTITION p_month_202405 VALUES LESS THAN (739403) ENGINE = InnoDB, PARTITION p_month_202406 VALUES LESS THAN (739433) ENGINE = InnoDB, PARTITION p_month_202407 VALUES LESS THAN (739464) ENGINE = InnoDB, PARTITION p_month_202408 VALUES LESS THAN (739495) ENGINE = InnoDB, PARTITION p_month_202409 VALUES LESS THAN (739525) ENGINE = InnoDB, PARTITION p_month_202410 VALUES LESS THAN (739556) ENGINE = InnoDB, PARTITION p_month_202411 VALUES LESS THAN (739586) ENGINE = InnoDB, PARTITION p_month_202412 VALUES LESS THAN (739617) ENGINE = InnoDB, PARTITION p_month_202501 VALUES LESS THAN (739648) ENGINE = InnoDB, PARTITION p_month_202502 VALUES LESS THAN (739676) ENGINE = InnoDB, PARTITION p_month_202503 VALUES LESS THAN (739707) ENGINE = InnoDB COMMENT='带分区：话单小结工单扩展表' ROW_FORMAT=DYNAMIC DEFAULT CHARSET=utf8mb3 ENGINE=InnoDB PARTITION BY RANGE (to_days(`cuv_start_time`))

