 CREATE TABLE hongkou (
	`案件编号` BIGINT; 含义: 表示工单的唯一编号。; 示例值: 202408317745200116
	`原编号` BIGINT; 含义: 表示工单的原始编号。; 示例值: 20240831030597
	`案件来源/信息来源` TEXT; 含义: 表示工单的来源或信息来源。; 枚举值: "12345热线"
	`工单类型` TEXT CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci COMMENT '工单类型，包含求助类、投诉举报类、咨询类、意见建议类、其他类'; 含义: 表示工单的类型。; 枚举值: "其他类", "咨询类", "意见建议类", "投诉举报类", "求助类"
	`发现时间` TEXT; 含义: 表示工单被发现的时间。; 示例值: "2024-08-31 22:20"
	`状态` TEXT; 含义: 表示工单的当前状态。; 枚举值: "已结案", "已退单", "待区核查", "待接单处置", "待核查", "待结案归档"
	`事项类别` TEXT; 含义: 表示工单所属的最高级别的分类。; 枚举值: "公共安全", "公共服务", "公共管理", "经济发展"
	`事项大类` TEXT; 含义: 在事项类别之下，更具体的分类。; 枚举值: "公共交通", "卫生计生", "发展改革", "商务", "国资", "城管执法", "安全生产", "市场监管", "市政建设", "应急救援", "房屋保障", "民生服务", "水务工作", "消防安全", "环境保护", "社会治安", "社区共治", "科教文卫体", "绿化市容", "行政服务", "规划管理", "金融"
	`事项小类` TEXT; 含义: 在事项大类之下，更加具体的分类。; 示例值: "交通秩序", "教育"
	`事项名称` TEXT; 含义: 对工单所涉及的具体事项的命名。;  示例值: "交通信号灯故障", "垃圾乱倒", "噪音扰民"
	`事项标签` TEXT; 含义: 对工单进行额外标注，用于标记特定属性或特征。; 示例值: "动迁需求", "垃圾清运", "加装电梯"
	`案件描述/内容描述` TEXT; 含义: 对工单所涉及的具体问题的详细描述。;  示例值: "某路口交通信号灯故障，导致交通拥堵，需要尽快修复。"
	`上报地址` TEXT; 含义: 表示工单报告人提供的更详细的地址信息。;  示例值: "朝阳区幸福路123号幸福小区"
	`实际地址` TEXT; 含义: 表示工单所涉及的具体地点的实际详细地址。;示例值: "幸福路123号幸福小区"
	`联系人` DOUBLE; 含义: 表示工单报告人的联系人信息。; 示例值: 12345678901
	`联系电话` DOUBLE; 含义: 表示工单报告人的联系电话。; 示例值: 12345678901
	`所属街道` TEXT; 含义: 表示工单所涉及的具体地点所属的街道。; 枚举值: "凉城新村街道", "北外滩街道", "嘉兴路街道", "四川北路街道", "广中路街道", "曲阳路街道", "欧阳路街道", "江湾镇街道"
	`主责部门` TEXT; 含义: 表示工单的主要负责部门。; 示例值: "虹口区建设和管理委员会"
	`协同部门` TEXT; 含义: 表示工单的协同负责部门。; 枚举值: "公安局虹口分局", "公安局虹口分局,虹口区市场监督管理局", "北外滩街道办事处", "嘉兴路街道办事处", "四川北路街道办事处", "曲阳路街道办事处", "江湾镇街道办事处", "虹口区住房保障和房屋管理局", "虹口区卫生健康委员会", "虹口区市场监督管理局", "虹口区建设和管理委员会", "虹口区生态环境局,虹口区市场监督管理局", "虹口区绿化和市容管理局", "虹口区规划和自然资源局", "虹房集团"
	`主处置部门` TEXT; 含义: 表示工单的主要处置部门。; 示例值: "虹口区建设和管理委员会/市政和水务管理中心5"
	`协同处置部门` TEXT; 含义: 表示工单的协同处置部门。; 示例值: "虹口区建设和管理委员会/市政和水务管理中心5"
	`办理描述` TEXT; 含义: 表示工单的办理描述。; 示例值: "市民来电反映:上述小区附近，每天22:00后会有人修路，不是2、3天，已经修了1个月了，并且越修越响，工人直接将管子砸在地上，凌晨2：00还没停，影响居民休息。诉求：要求马上停止施工并给市民说法。（需"
	`结案时间` TEXT; 含义: 表示工单的结案时间。; 示例值: "2024-09-01 11:12:36"
	`结案期限(是否超时)` TEXT; 含义: 表示工单的结案期限是否超时。; 枚举值: "正常", "超时", "过半"
	`市紧急程度` TEXT; 含义: 表示工单的市紧急程度。; 枚举值: "普通", "次紧急"
	`收单时间` TEXT; 含义: 表示工单的收单时间。; 示例值: "2024-09-01 11:12:36"
	`紧急程度` TEXT; 含义: 表示工单的紧急程度。; 枚举值: "一般", "次紧急"
	`所属片区` TEXT; 含义: 表示工单所属的片区。; 枚举值: "东片区", "中片区", "第一片区", "第三片区", "第二片区", "第五片区", "第六片区", "第四片区", "西片区", "？"
	`所属居委` TEXT; 含义: 表示工单所涉及的具体地点所属的居委会。;  示例值: "幸福社区居委会", "和谐社区居委会"
	`派遣时间` TEXT; 含义: 表示工单的派遣时间。; 示例值: "2024-09-01 11:53:06"
	`案件期限` BIGINT; 含义: 表示工单的案件期限。; 枚举值: 1, 3, 4, 7, 8, 9, 10, 11, 12, 13, 14, 15
	`处置计时` TEXT; 含义: 表示工单的处置计时。; 示例值: "0天15小时50分钟14秒"
	`案件整体计时` TEXT; 含义: 表示工单的案件整体计时。; 示例值: "0天15小时50分钟14秒"
	`事实认定` TEXT; 含义: 表示工单的事实认定。; 枚举值: "不属实", "不采纳", "对政策解释不接受", "属实", "无政策依据", "有政策依据", "留作参考", "部分属实", "部分采纳", "采纳"
	`诉求认定` TEXT; 含义: 表示工单的诉求认定。; 枚举值: "其他", "无政策依据", "诉求合理", "诉求过高"
	`是否解决区回访` TEXT; 含义: 表示工单是否解决并进行区回访。; 枚举值: "实际解决", "未解决", "未评价", "解释说明", "诉求过高"
	`是否满意区回访` TEXT; 含义: 表示工单是否满意并进行区回访。; 枚举值: "一般", "不满意", "基本满意", "未评价", "满意"
)ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE utf8mb4_0900_ai_ci
